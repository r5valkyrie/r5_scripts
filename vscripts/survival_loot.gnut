BinOrSpawnPoint function CreateBinOrSpawnPoint( vector origin, entity bin = null )
{
	BinOrSpawnPoint bs
	bs.pos = origin
	bs.bin = bin
	//bs.bin_isSecret = bin_isSecret
	return bs
}


vector function GetSafeLocation( vector origin )
{
	vector spawnOrigin = NavMesh_GetClosestPoint( origin )
	// [ R5DEV-361133 ] Use a more reliable NavMesh function instead of the less-reliable trace.
	return GetGroundPosition( spawnOrigin, spawnOrigin - <0, 0, 5000> ).endPos
}


void function DeleteRandomLootBins()
{
	array<entity> bins = GetAllLootBins()
	array<entity> binsToRemove

	for ( int i = bins.len() - 1; i >= 0; i-- )
	{
		if ( CoinFlip() )
		{
			entity bin = bins[i]
			bins.remove( i )
			binsToRemove.append( bin )
		}
	}

	RemoveBinsFromSpawnPointsList( binsToRemove )

	foreach ( bin in binsToRemove )
		bin.Destroy()
}


void function RemoveBinsFromSpawnPointsList( array <entity> bins )
{
	for ( int i = 0; i < file.lootZones.len(); i++ )
	{
		for ( int j = file.lootZones[i].spawnPoints.len() - 1; j >= 0; j-- )
		{
			BinOrSpawnPoint bs = file.lootZones[i].spawnPoints[j]
			if ( IsValid( bs.bin ) && bins.contains( bs.bin ) )
			{
				file.lootZones[i].spawnPoints.remove( j )
			}
		}
	}
}


