void function SURVIVAL_Loot_InitServer()
{
	if ( GetCurrentPlaylistVarInt( "loot_lock_random_seed_number", -1 ) != -1 )
	{
		//option to lock the loot to be the same every match
		int randomSeedInt = GetCurrentPlaylistVarInt( "loot_lock_random_seed_number", -1 ).tointeger()
		SetRandomSeedForLoot( CreateRandomSeed( randomSeedInt ) )
	}

	//if ( !IsTestMap() )
	//	Loot_SetExtraSpawnCountInDefaultZoneForLootType( "armor_pickup_lv1_evolving", 6 )

	PrecacheScriptString( THROWN_OBJECT_PHYSICS_ENT_SCRIPTNAME )
	PrecacheScriptString( SURVIVAL_LOOT_MOVER_SCRIPTNAME )

	RegisterSignal( "PickedUpAmmo" )
	RegisterSignal( "RodeoOfferingEnded" )
	RegisterSignal( "RodeoOfferingResponseKeyPressed" )
	RegisterSignal( "OnPickup" )
	RegisterSignal( "ThrowItem" )
	RegisterSignal( "PlayerCarryLoot" )
	RegisterSignal( "SwitchToOrdnance" )
	RegisterSignal( "SwapToNextOrdnance" )
	RegisterSignal( "OnFirstCollision" )

	FlagInit( "PopulateSpecialZonesDone" )
	FlagInit( "Survival_LootSpawned" )
	FlagInit( "DisableLootDrops" )

	if ( !ShouldPreprocessData() && IsPVEMode())
	{
		BlockMapEntityParseCreationOf( "script_ref", "", "info_survival_weapon_location" )        // 3000
		BlockMapEntityParseCreationOf( "script_ref", "", "info_survival_loot_zone" )            // 90
	}

                        
                         
       

	AddSpawnCallbackEditorClass( "script_ref", "info_survival_circle_end_location", SURVIVAL_AddCircleEndLocation )
	AddSpawnCallbackEditorClass( "script_ref", "info_survival_weapon_location", SURVIVAL_AddWeaponLocation )
	AddSpawnCallbackEditorClass( "script_ref", "info_survival_loot_zone", SURVIVAL_AddLootZone )
	AddSpawnCallbackEditorClass( "script_ref", "info_survival_loot_hotzone", SURVIVAL_AddLootHotZone )
	AddSpawnCallbackEditorClass( "script_ref", "info_survival_invalid_end_zone", SURVIVAL_AddInvalidEndZone )
	AddScriptInvalidEndZones()
	AddPlaylistInvalidEndZones()

	#if DEVELOPER
		AddClientCommandCallback( "dev_survival_cycle_main_weapon", bool function( entity player, array<string> args ) { ClientCommand_dev_survival_cycle_main_weapon( player, args ); return true } ) // dev
	#endif

	AddCallback_OnPlayerAddWeaponMod( OnPlayerAddWeaponMod )
	AddCallback_OnPlayerRemoveWeaponMod( OnPlayerRemoveWeaponMod )

	AddCallback_OnCodeDoorBroken( HandleDeathboxOnDoorInteraction )

	SURVIVAL_AddCallback_OnHealingItemCountChanged( ChooseBestHealthPickup )
	Survival_AddCallback_OnPlayerHealingEnded( OnHealingEnded )
	AddCallback_OnClientConnected( SurvivalLoot_OnConnected )
	AddCallback_OnPlayerRespawned( SurvivalLoot_OnPlayerRespawned )
	AddCallback_OnSurvivalDeathFieldStageChanged( SurvivalDeathFieldStageChanged )

	// TODO: move these into sh_survival_loot_types.gnut
	file.specialCaseCountFunctions[ eLootType.AMMO ] <- AmmoPickUp_Count
	file.specialCaseDecrementFunctions[ eLootType.AMMO ] <- AmmoPickUp_Decrement

	                      
		file.specialCaseRefDecrementFunctions[ "data_knife" ] <- VaultKey_Decrement
       
	                  
		file.specialCaseRefDecrementFunctions[ "ship_keycard" ] <- VaultKey_Decrement
       

	InitLootGroups()

	LootZone world
	world.origin = <0, 0, 0>
	world.radius = 0.0
	world.zoneClass = file.defaultLevelZone
	world.priority = 9999
	file.worldLootZone = world
	file.lootZones.append( world )
	file.numZones += 1

	if ( IsLootRoundBased()	)
	{
		// Round based mode loot backup
		LootZoneBackupData backupData
		backupData.zone.origin = world.origin
		backupData.zone.radius = world.radius
		backupData.zone.zoneClass = world.zoneClass
		backupData.zone.priority = world.priority
		backupData.bins = []
		file.lootZonesBackup.append( backupData )
	}

	AddCallback_OnPlayerUsedOffhandWeapon( SURVIVAL_RemoveOffhandFromInventory )

	AddCallback_OnPassiveChanged( ePassives.PAS_REDUCED_COOLDOWN_TAC, Survival_ArmorPassiveChanged )
	AddCallback_OnPassiveChanged( ePassives.PAS_REDUCED_COOLDOWN_ULT, Survival_ArmorPassiveChanged )
	AddCallback_OnPassiveChanged( ePassives.PAS_REDUCED_COOLDOWNS_TAC_ULT, Survival_ArmorPassiveChanged )
	AddCallback_OnPassiveChanged( ePassives.PAS_STARTER_PACK, Survival_StarterPackChanged )

	// survival_loot_enabled set to 0 prevents lootbins from being populated with loot but they still spawn in the world.
	// Using this playlist var we block the creation of the Loot Bin Marker to stop loot bins from spawning ( where they have been placed in Level Ed)
	// The loot bin creation is blocked further in SURVIVALPreProcess_CreateLootBinAndLocations
	if ( GetCurrentPlaylistVarBool( "survival_block_lootbin_creation", false ) )
	{
		printt("Survival Loot: Blocking Creation of Loot Bins due to survival_block_lootbin_creation playlist var setting")
		BlockMapEntityParseCreationOf( "prop_dynamic", LOOT_BIN_MARKER_SCRIPTNAME, "" )
	}
}


void function InitLootGroups()
{
	// Stage 1 -- Read group definitions
	ReadDatatableLootGroups()
	ReadPlaylistLootGroups()

	// Stage 2 -- Process groups
	array<LootGroup> visitedStack = []
	foreach ( string groupRef, LootGroup group in file.lootGroups )
	{
		FinalizeLootGroupRecursive( visitedStack, group )
	}
	ReadGroupRemappingsFromPlaylist()

	// Delete empty groups
	foreach ( string groupRef, LootGroup group in clone file.lootGroups )
	{
		bool groupWasKept = (group.entries.len() > 0)
		if ( !groupWasKept )
		{
			printf( "Loot group %s is empty -- deleting", groupRef )
			delete file.lootGroups[groupRef]
		}
	}
}


bool function FinalizeLootGroupRecursive( array<LootGroup> visitedStack, LootGroup group )
{
	if ( group.finalized )
	{
		bool groupWasKept = (group.entries.len() > 0)
		return groupWasKept
	}

	visitedStack.push( group )

	bool keepGroup = true

	//
	if ( group.tier < 0 || group.tier > 3 )
	{
		Assert( false, format( "Loot group '%s' (%s) has bad tier '%d' (must be between 0 and 3)", group.ref, group.DEV_definitionSource, group.tier ) )
		group.tier = 3
	}

	// Used by SURVIVAL_ChooseLootLocations
	file.groupedSpawnpoints[ group.ref ] <- []

	// Read playlist loot group distribution overrides
	string playlistEntryOverrideString = GetCurrentPlaylistVarString( "loot_distribution_override_" + group.ref, "" )

	/*%if HAS_UPGRADE_CORE
	if( UpgradeCore_IsEnabled() )
	{
		string upgradeCoreDistributionStr = GetCurrentPlaylistVarString( "upgrade_core_dist_overrides", "care_package_1_L|mp_pickup_xp_cache_dynamic:3 care_package_1_L|top_tier_health:0 care_package_2_L|mp_pickup_xp_cache_dynamic:3 care_package_2_L|top_tier_health:0 care_package_3_L|mp_pickup_xp_cache_dynamic:3 care_package_3_L|top_tier_health:0 data_knife_vault|mp_pickup_xp_cache_dynamic:5 data_knife_vault|top_tier_health:0" )
		array<string> distributionKeyValueStrs = GetTrimmedSplitString( upgradeCoreDistributionStr, " " )
		foreach( kvp in distributionKeyValueStrs )
		{
			array<string> kvpArr = GetTrimmedSplitString( kvp, "|" )
			if( kvpArr.len() < 2 )
				continue
			string key = kvpArr[0].tolower()
			if( key != group.ref.tolower() )
				continue
			string val = kvpArr[1]
			playlistEntryOverrideString += ( " " + val )
			break
		}
	}
	%endif*/

	foreach ( string pair in GetTrimmedSplitLoweredString( playlistEntryOverrideString, " " ) )
	{
		array<string> splitPair = GetTrimmedSplitString( pair, ":" )
		Assert( splitPair.len() == 2 )
		string entryRef                 = splitPair[0]
		float entryOverrideDistribution = float( splitPair[1] )

		float ornull entryExistingDistributionOrNull = null
		if ( entryRef in group.entries )
			entryExistingDistributionOrNull = group.entries[entryRef]

		printf( "loot_distribution_override_%s: %s %s -> %f", group.ref, entryRef, string(entryExistingDistributionOrNull), entryOverrideDistribution )

		group.entries[entryRef] <- entryOverrideDistribution
	}

	// Process items and other groups included by this group
	foreach ( string entryRef, float entryDistribution in clone group.entries )
	{
		bool keepEntry = true
		if ( entryRef in file.lootGroups )
		{
			// entry refers to a different group
			LootGroup referencedGroup = file.lootGroups[entryRef]

			// Detect cycles and assert (or ignore entry if they happen in retail)
			if ( visitedStack.contains( referencedGroup ) )
			{
				array<string> errorMsg = ["Loot group cycle detected:"]
				foreach ( int visitedGroupIdx, LootGroup visitedGroup in visitedStack )
				{
					LootGroup otherGroup = visitedStack[modint( visitedGroupIdx + 1, visitedStack.len() )]
					errorMsg.append( format( "  - %s (%s) refers to %s (%s)", visitedGroup.ref, visitedGroup.DEV_definitionSource, otherGroup.ref, otherGroup.DEV_definitionSource ) )
				}
				#if DEVELOPER
					Assert( false, DEV_ArrayConcat( errorMsg, "\n" ) )
				#endif
				keepEntry = false
			}
			else
			{
				keepEntry = FinalizeLootGroupRecursive( visitedStack, referencedGroup )
			}
		}
		else if ( SURVIVAL_Loot_IsRefValid( entryRef ) )
		{
			// entry refers to an item
			if ( SURVIVAL_Loot_IsReforBaseWeaponDisabled( entryRef ) || Crafting_IsLootRemovedFromPool( entryRef ) )
				keepEntry = false // item is disabled
		}
		else
		{
 			Assert( false, format( "Loot group '%s' (%s) refers to unknown group/item '%s'", group.ref, group.DEV_definitionSource, entryRef ) )
			keepEntry = false
		}

		if ( entryRef == "blank" && GetCurrentPlaylistVarBool( "sur_dev_disable_blank_loot", false ) )
			entryDistribution = 0.0

		if ( entryDistribution <= 0.0 )
			keepEntry = false

		if ( keepEntry )
		{
			group.totalDistribution += entryDistribution
		}
		else
		{
			delete group.entries[entryRef]
		}
	}

	if ( group.entries.len() > 0 )
	{
		Assert( group.totalDistribution > 0.0 )
	}
	else
	{
		Assert( group.totalDistribution == 0.0 )
		keepGroup = false
	}

	group.finalized = true
	visitedStack.pop()

	return keepGroup
}


void function ReadDatatableLootGroups()
{
	var dt                    = GetDataTable( $"datatable/survival_loot_groups_new.rpak" )
	int rowCount              = GetDataTableRowCount( dt )
	int col_groupRef          = GetDataTableColumnByName( dt, "groupRef" )
	int col_entryRef          = GetDataTableColumnByName( dt, "entryRef" )
	int col_entryDistribution = GetDataTableColumnByName( dt, "entryDistribution" )
	int col_groupTier         = GetDataTableColumnByName( dt, "groupTier" )
	int col_priority          = GetDataTableColumnByName( dt, "priority" )


	LootGroup ornull currentGroup
	for ( int rowIdx = 0; rowIdx < rowCount; rowIdx++ )
	{
		string groupRef         = strip( GetDataTableString( dt, rowIdx, col_groupRef ) ).tolower()
		string entryRef         = strip( GetDataTableString( dt, rowIdx, col_entryRef ) ).tolower()
		float entryDistribution = GetDataTableFloat( dt, rowIdx, col_entryDistribution )
		int groupTier           = GetDataTableInt( dt, rowIdx, col_groupTier )
		int priority            = GetDataTableInt( dt, rowIdx, col_priority )

		if ( groupRef == "" && entryRef == "" && entryDistribution == 0.0 && groupTier == 0 && priority == 0 )
		{
			currentGroup = null
			continue
		}

		if ( groupRef != "" )
		{
			Assert( entryRef == "" && entryDistribution == 0.0, format( "In survival_loot_groups_new.csv, line %d has both groupRef (%s) along with entryRef (%s) and/or entryDistribution (%f) set. This is invalid.", rowIdx + 3, groupRef, entryRef, entryDistribution ) )
			Assert( currentGroup == null, format( "In survival_loot_groups_new.csv, group '%s' starts on line %d without a blank row. There must be a blank row between groups!", groupRef, rowIdx + 3 ) )
			Assert( !SURVIVAL_Loot_IsRefValid( groupRef ), format( "In survival_loot_groups_new.csv, line %d defines a group called '%s' which conflicts with an item in survival_loot.csv by the same name.", rowIdx + 3, groupRef ) )
			LootGroup group
			group.ref = groupRef
			group.tier = groupTier
			group.priority = priority
			group.entries = {}
			group.totalDistribution = 0.0
			group.DEV_definitionSource = format( "survival_loot_groups_new.csv line %d", rowIdx + 3 )

			currentGroup = group
			file.lootGroups[group.ref] <- group
		}
		else if ( entryRef != "" )
		{
			Assert( groupTier == 0, format( "In survival_loot_groups_new.csv, line %d has both entryRef (%s) and groupTier (%d) set. This is invalid.", rowIdx + 3, entryRef, groupTier ) )
			Assert( priority == 0, format( "In survival_loot_groups_new.csv, line %d has both entryRef (%s) and priority (%d) set. This is invalid.", rowIdx + 3, entryRef, priority ) )
			Assert( currentGroup != null, format( "In survival_loot_groups_new.csv, line %d defines an entry (%s) that's not in a group.", rowIdx + 3, entryRef ) )
			expect LootGroup( currentGroup )
			Assert( entryDistribution >= 0.0, format( "In survival_loot_groups_new.csv, line %d defines entry '%s' with negative distribution: %f", rowIdx + 3, entryRef, entryDistribution ) )
			Assert( !(entryRef in currentGroup.entries), format( "In survival_loot_groups_new.csv, line %d defines entry '%s' that is already defined in group '%s'.", rowIdx + 3, entryRef, currentGroup.ref ) )
			currentGroup.entries[entryRef] <- entryDistribution
		}
		else Assert( false, format( "In survival_loot_groups_new.csv, line %d is weird.", rowIdx + 3 ) )
	}
}


void function ReadPlaylistLootGroups()
{
	string playlistLootGroupRefsString = GetCurrentPlaylistVarString( "dlg_names", "" )
	foreach ( string groupRef in GetTrimmedSplitLoweredString( playlistLootGroupRefsString, " " ) )
	{
		if ( SURVIVAL_Loot_IsRefValid( groupRef ) )
		{
			Assert( false, format( "Playlist var dlg_names defines a group called '%s' which conflicts with an item in survival_loot.csv by the same name.", groupRef ) )
			continue
		}
		if ( groupRef in file.lootGroups )
		{
			Assert( false, format( "Playlist var dlg_names defines a group called '%s' which conflicts with a group defined at %s", groupRef, file.lootGroups[groupRef].DEV_definitionSource ) )
			continue
		}
		string playlistVarName = "dlg_def__" + groupRef

		LootGroup group
		group.ref = groupRef
		group.tier = GetCurrentPlaylistVarInt( "dlg_tier__" + groupRef, 1 )
		group.entries = {}
		group.totalDistribution = 0.0
		group.DEV_definitionSource = format( "playlist var %s", playlistVarName )
		file.lootGroups[ group.ref ] <- group

		string entriesString = GetCurrentPlaylistVarString( playlistVarName, "" )
		foreach ( string pair in GetTrimmedSplitLoweredString( entriesString, " " ) )
		{
			array<string> splitPair = GetTrimmedSplitString( pair, ":" )
			Assert ( splitPair.len() == 2 )
			string entryRef         = splitPair[0]
			float entryDistribution = float( splitPair[1] )

			if ( entryDistribution < 0.0 )
			{
				Assert( false, format( "Playlist var %s defines entry '%s' with negative distribution: %f", playlistVarName, entryRef, entryDistribution ) )
				continue
			}

			Assert( !(entryRef in group.entries), format( "Playlist var %s defines entry '%s' that is already defined.", playlistVarName, entryRef ) )
			group.entries[entryRef] <- entryDistribution
		}
	}
}


void function ReadGroupRemappingsFromPlaylist()
{
	string playlistString       = GetCurrentPlaylistVarString( "loot_group_overrides", "" )
	array<string> overridePairs = split( playlistString, WHITESPACE_CHARACTERS )
	foreach ( pair in overridePairs )
	{
		array<string> splitPair = split( pair, ":" )
		Assert ( splitPair.len() == 2 )
		SURVIVAL_AddLootGroupRemapping( splitPair[0].tolower(), splitPair[1].tolower() )
	}
}


bool function LootTypeHasAnyChanceToSpawn( string lootName )
{
	foreach ( string lgName, LootGroup lg in file.lootGroups )
	{
		if ( lootName in lg.entries )
		{
			float distribution = lg.entries[lootName]
			if ( distribution > 0.0 )
				return true
		}
	}

	return false
}


void function _AddLootLocation( vector origin, float radius = 1.0 )
{
	FlagWait( "EntitiesDidLoad" ) // wait for bad end zones to all load

	if ( SURVIVAL_IsValidCircleLocation( origin ) )
		file.validCircleEndLocations[ origin ] <- radius
	file.lootLocations.append( origin )
}

void function SURVIVAL_AddLootZone( entity zone )
{
	LootZone data
	data.origin = zone.GetOrigin()
	data.radius = float( zone.kv.script_radius )

	if ( zone.HasKey( "script_height" ) )
		data.height = float( zone.kv.script_height )

	if ( zone.HasKey( "limit_height" ) )
		data.useHeight = (zone.kv.limit_height == "1")

	data.zoneClass = string( zone.kv.zone_class ).tolower()

	if ( zone.HasKey( "zone_priority" ) )
		data.priority = float( zone.kv.zone_priority )

	if ( data.priority == 0 && data.zoneClass in file.lootGroups )
		data.priority = float( file.lootGroups[ data.zoneClass ].priority )

	if ( GetSurvivalDebugMode() != eSurvivalDebugType.NONE )
	{
		//DebugDrawCircle( data.origin, <0, 0, 0>, data.radius, <255, 255, 255>, true, 100.0 )
		DebugDrawText( data.origin, data.zoneClass, false, 100.0 )
	}

	if ( !ShouldProcessSpecialZones() )
	{
		file.numZones += 1
		zone.Destroy()
		return
	}

		if ( data.zoneClass == "data_knife_vault" && !LootVault_Enabled() )
		{
			zone.Destroy()
			return
		}

	file.lootZones.append( data )

	zone.Destroy()
}


void function SURVIVAL_AddLootHotZone( entity zone )
{
	LootZone data
	data.origin = zone.GetOrigin()
	data.radius = float( zone.kv.script_radius )
	data.zoneClass = string( zone.kv.zone_class ).tolower()

	file.lootHotZones.append( data )
}


void function SURVIVAL_AddInvalidEndZone( entity zone )
{
	if( IsInvalidEndZoneAllowed( zone ) )
		CreateInvalidEndZone( zone.GetOrigin(), float( zone.kv.script_radius ) )
	zone.Destroy()
}


void function AddScriptInvalidEndZones()
{
	//Needed for hotfixing bad spots - should get baked into the level and removed later.
	if ( GetMapName() == "mp_rr_canyonlands_64k_x_64k" )
	{
		CreateInvalidEndZone( <33296.1, -8803.86, 3544.32>, 1000 )
		CreateInvalidEndZone( <32144.1, -9571.86, 3544.32>, 1000 )
		CreateInvalidEndZone( <30928.1, -9059.86, 3544.32>, 1000 )
	}
	else if ( GetMapName() == "mp_rr_canyonlands_mu1" )
	{
		CreateInvalidEndZone( <27344, 4648, 3952>, 512 )
		CreateInvalidEndZone( <27360, 5576, 3952>, 512 )
		CreateInvalidEndZone( <27376, 6192, 3952>, 1024 )
		CreateInvalidEndZone( <28384, 6144, 3952>, 768 )
		CreateInvalidEndZone( <27336, 7640, 3952>, 768 )
	}
	else if ( GetMapName() == "mp_rr_canyonlands_mu3" )
	{
		CreateInvalidEndZone( <-10590, -20109.9, 3623.94>, 3000 )
		CreateInvalidEndZone( <-16347, 15346, 5810>, 3200 )
	}
	else if ( GetMapName() == "mp_rr_divided_moon" )
	{
		CreateInvalidEndZone( <30888, -3696, 4432>, 1700 )
		CreateInvalidEndZone( <32760, -3232, 4432>, 1700 )
	}
	else if ( GetMapName() == "mp_rr_desertlands_mu4" )
	{
		CreateInvalidEndZone( <-26776, -528, -4680>, 1700 )
		CreateInvalidEndZone( <-28464, 328, -4680>, 1700 )
	}
	else if ( GetMapName() == "mp_rr_tropic_island_mu1" )
	{
		CreateInvalidEndZone( <30888, -27376, -464>, 1700 )
		CreateInvalidEndZone( <29000, -27888, -464>, 1700 )
	}
}

void function AddPlaylistInvalidEndZones()
{
	// sample format:
	// InvalidEndZones "< 1, 2, 3 > 100 : < 4, 5, 6 > 200 : < 7, 8, 9 > 300"
	string endZonesString = GetCurrentPlaylistVarString( "InvalidEndZones", "" )
	array< string > endZoneStringArray = GetTrimmedSplitString( endZonesString, ":")
	foreach( circleString in endZoneStringArray )
	{
		array< float > circleArray = GamemodeUtility_ParseCircleString( circleString )
		Assert( circleArray.len() == EXPECTED_PARSED_CIRCLE_VALUE_COUNT, "Malformed playlist string: PlaylistVarName = InvalidEndZones \nOriginal String = " + endZonesString + "\nFailed Section = " + circleString )
		if ( circleArray.len() == EXPECTED_PARSED_CIRCLE_VALUE_COUNT )
		{
			vector circlePos   = < circleArray[ 0 ], circleArray[ 1 ], circleArray[ 2 ] >
			float circleRadius = circleArray[ 3 ]

			printt( "PlaylistCreateInvalidEndZone: Pos = " + circlePos + ", Radius = " + circleRadius )
			CreateInvalidEndZone( circlePos, circleRadius )
		}
	}
}

bool function IsInvalidEndZoneAllowed( entity zone )
{
	string key = "gamemode_" + GameRules_GetGameMode()
	if( zone.HasKey( key ) )
		return zone.GetValueForKey( key ) == "1"

	return true
}

Cylinder function CreateInvalidEndZone( vector origin, float radius )
{
	Cylinder data
	data.origin = origin
	data.radius = radius

	//DebugDrawCircle( origin, <0,0,0>, radius, <255, 255, 255>, true, 9999.0 )

	file.badEndZones.append( data )
	return data
}


void function SURVIVAL_AddLootBin( entity bin, array<entity> parentLinkEnts )
{
	file.numLoot += 1

	bool onMovingGeo = SURVIVAL_ShouldBinOrSpawnPointMoveWithGeo( bin )

	if ( !ShouldProcessSpecialZones() )
	{
		if ( onMovingGeo )
			file.numMovingLoot += 1

		if ( parentLinkEnts.len() > 0 )
			file.binOriginParentLinkEntsGroups[ RoundVectorInLocalSpace( bin.GetOrigin(), 1.0, <0, 0, 0>, <0, 0, 0> ) ] <- parentLinkEnts

		bin.Destroy()
		return
	}

	int numRegularSlots = RandomIntRangeInclusiveForLoot(
		GetCurrentPlaylistVarInt( "survival_lootbins_min_regular_slots", 3 ),
		GetCurrentPlaylistVarInt( "survival_lootbins_max_regular_slots", 4 ) )
	for ( int i = 0; i < numRegularSlots; i++ )
	{
		file.worldLootZone.spawnPoints.append( CreateBinOrSpawnPoint( bin.GetOrigin(), bin ) )
	}

	if ( onMovingGeo )
	{
		file.movingGeoLootLocations.append( bin.GetOrigin() )
	}

	thread _AddLootLocation( bin.GetOrigin() )
}


void function SURVIVAL_AddCircleEndLocation( entity ent )
{
	thread _AddLootLocation( ent.GetOrigin(), float( ent.kv.script_radius ) )
	ent.Destroy()
}

array<vector> function GetStaticWeaponLocations()
{
	if ( !Flag( "Survival_LootSpawned" ) )
		Warning( "%s() -- Weapon locations not defined yet, not all loot hasn't finished spawning", FUNC_NAME() )

	return file.staticWeaponLocations
}

void function SURVIVAL_AddWeaponLocation( entity weaponLocation )
{
	bool onMovingGeo = SURVIVAL_ShouldBinOrSpawnPointMoveWithGeo( weaponLocation )

	if ( !onMovingGeo )
		file.staticWeaponLocations.append( weaponLocation.GetOrigin() )


	if ( !ShouldProcessSpecialZones() )
	{
		if ( weaponLocation.GetLinkEntArray().len() == 0 )
		{
			file.numLoot += 1
			if ( onMovingGeo )
				file.numMovingLoot += 1
		}
		else
		{
			file.numLoot += weaponLocation.GetLinkEntArray().len()
			if ( onMovingGeo )
				file.numMovingLoot += weaponLocation.GetLinkEntArray().len()

			foreach ( ent in weaponLocation.GetLinkEntArray() )
				ent.Destroy()
		}

		weaponLocation.Destroy()
		return
	}

	array<vector> locations
	array<entity> ents

	if ( weaponLocation.GetLinkEntArray().len() == 0 )
	{
		locations.append( weaponLocation.GetOrigin() )
		file.worldLootZone.spawnPoints.append( CreateBinOrSpawnPoint( weaponLocation.GetOrigin() ) )
		if ( onMovingGeo )
			file.movingGeoLootLocations.append( weaponLocation.GetOrigin() )

		thread _AddLootLocation( weaponLocation.GetOrigin() )
	}
	else
	{
		foreach ( ent in weaponLocation.GetLinkEntArray() )
		{
			locations.append( ent.GetOrigin() )
			file.worldLootZone.spawnPoints.append( CreateBinOrSpawnPoint( ent.GetOrigin() ) )
			if ( onMovingGeo )
				file.movingGeoLootLocations.append( weaponLocation.GetOrigin() )
			thread _AddLootLocation( ent.GetOrigin() )
			ent.Destroy()
		}
	}

	weaponLocation.Destroy()
}


bool function SURVIVAL_ShouldBinOrSpawnPointMoveWithGeo( entity binOrSpawnPoint )
{
	if ( binOrSpawnPoint.HasKey( "onMovingGeo" ) && (binOrSpawnPoint.kv.onMovingGeo == "true" || binOrSpawnPoint.kv.onMovingGeo == "1") )
		return true

	if ( binOrSpawnPoint.e.isOnMovingGeo )
		return true

	return false
}


table<vector, array<entity> > function Loot_GetParentLinkEntsTable()
{
	return file.binOriginParentLinkEntsGroups
}

