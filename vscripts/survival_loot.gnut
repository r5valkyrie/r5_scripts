entity function DEV_SpawnDeathBox( entity player, table<string, int> contents )
{
	if ( !IsValid( player ) )
		player = GetPlayerArray()

	entity deathBox = CreateDeathBox( EyeTraceVec( player ), <0, player.EyeAngles().y, 0> )
	deathBox.SetOwner( player )
	deathBox.SetNetInt( "ownerEHI", player.GetEncodedEHandle() )
	deathBox.ClearParent()
	deathBox.Solid()
	deathBox.SetUsable()
	deathBox.SetUsableByGroup( "pilot" )
	deathBox.SetUsePrompts( "#DEATHBOX_HINT", "#DEATHBOX_HINT" )
	deathBox.AddUsableValue( USABLE_CUSTOM_HINTS )

	thread FakePhysicsThrow( player, deathBox, <0, 0, -100>, false )

	DEV_AddToDeathBox( deathBox, contents )

	UpdateDeathBoxHighlight( deathBox, true )

	return deathBox
}
