void function AddCallback_LootSpawnParented_TargetName( string targetName, void functionref( entity parentEnt, entity childEnt ) callbackFunc )
{
	if ( targetName in file.Callbacks_OnLootSpawnParented )
	{
		file.Callbacks_OnLootSpawnParented[targetName].append( callbackFunc )
	}
	else
	{
		array< void functionref( entity parentEnt, entity childEnt ) > callbacks
		callbacks.append( callbackFunc )
		file.Callbacks_OnLootSpawnParented[targetName] <- callbacks
	}
}


