entity function DropEquipment( entity player, string equipSlot, vector dropOrigin, vector dropVel )
{
	vector startPos  = GetThrowOrigin( player )
	string equipRef  = Inventory_GetPlayerEquipment( player, equipSlot )
	EquipmentSlot es = Survival_GetEquipmentSlotDataByRef( equipSlot )

	if ( equipRef == "" )
		return null

	                    
	if( UpgradeCore_IsEquipmentArmorCore( equipRef ) && SURVIVAL_Loot_GetLootDataByRef( equipRef ).lootType == eLootType.ARMOR )
	{
		int shieldAmount = Inventory_GetSurvivalPropertyValueForEquipment( player, equipSlot ) + GetPlayerExtraShields( player )
		int tier = GetShieldTierFromShieldAmount( shieldAmount )
		equipRef = UpgradeCore_GetShieldCoreRefForTier( tier )
	}
       

	if ( equipSlot == "gadgetslot" )
	{
		entity heldGadget = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_GADGET )

		if ( IsValid( heldGadget ) && heldGadget.GetWeaponClassName() == equipRef )
		{
			int clipCount = heldGadget.GetWeaponPrimaryClipCount()

			if ( clipCount == 0 )
			{
				//Turns out this is, for now, the right place to protect against dropping items with 0 uses, so this is an expected code path
				//Assert( false, "Tried dropping a survival item with 0 uses left" )
				Inventory_SetPlayerEquipment( player, "", equipSlot )
				return null
			}
		}
	}

	entity item = SpawnGenericLoot( equipRef, dropOrigin )
	SetItemSpawnSource( item, eSpawnSource.PLAYER_DROP, player )

	entity dropWeapon

	BroadcastItemDrop( player, equipRef, item )

	LootData data = SURVIVAL_Loot_GetLootDataByRef( equipRef )
	if ( data.lootType == eLootType.INCAPSHIELD )
	{
		SetPropSurvivalMainPropertyOnEnt( item, GetPropSurvivalMainPropertyFromEnt( item ) ) //Axiom may have already set it during the Broadcast Drop
	}
	else
	                    
	if( UpgradeCore_IsEquipmentArmorCore( data.ref ) )
	{
		SetPropSurvivalMainPropertyOnEnt( item, Inventory_GetSurvivalPropertyValueForEquipment( player, equipSlot ) + GetPlayerExtraShields( player ) )
		SetPlayerExtraShields( player, 0 )
		SetPlayerExtraShieldsTier( player, 1 )
	}
	else
       
	SetPropSurvivalMainPropertyOnEnt( item, Inventory_GetSurvivalPropertyValueForEquipment( player, equipSlot ) )
	if ( data.lootType == eLootType.ARMOR )
	{
		if ( EvolvingArmor_IsEquipmentEvolvingArmor( data.ref ) )
		{
			SetPropSurvivalExtraPropertyOnEnt( item, EvolvingArmor_GetEvolutionProgress( player ) )
		}
	}

	entity heldGadget = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_GADGET )

                        
                             
  
                                                                                                                                                                                                     
   
                                                       
                                                                                                   

                                                                            
   
  
       
                             
                                                   
  
                                                                                
                                            
  
       

	if ( IsValid( heldGadget ) && heldGadget.GetWeaponClassName() == equipRef )
	{
		int clipCount = heldGadget.GetWeaponPrimaryClipCount()
		item.SetClipCount( clipCount )

		SwapToLastEquippedPrimary( player )
		player.TakeWeaponByEnt( heldGadget )

		dropWeapon = heldGadget
	}

	vector fwd    = RotateVector( player.GetViewVector(), <-10.0, GetThrowYawOffsetFromPlayer( player ), 0> )
	vector vel    = fwd * 100

	FakePhysicsThrow( player, item, vel, true )
	TrackingVision_CreatePOI( es.trackingVisionDropPOI, item, item.GetOrigin(), player.GetTeam(), player )

	Inventory_SetPlayerEquipment( player, "", equipSlot )

	Remote_CallFunction_Replay( player, "ServerCallback_RefreshInventoryAndWeaponInfo" )

	LiveAPI_SendInventoryAction( eLiveAPI_EventTypes.inventoryDrop, player, equipRef, dropWeapon )

	return item
}

                                     
                                                                                                           
 
                                                                       
        

                                 
        

                                                                

         

                              
                                            
  
                                                     
                                
                                            
   
                                                          
                                       

                                                                                                                            

                                 
    
                                                                                          

                                                                  
     
                                                                        
                                 
                                                                 
     
    
   
  
 

                                                                              
 
                                                                               
        

         

                              
                                                    
                                                                                  

                                                                                       

                                
  
                                                                
   
                                                                      

                                            
    
                                                                    
    
   

        
  

                                                                                       
                                                               
  
                                                                     

                                          
   
                                                        

                                                                                                      

                     
                                                              
   
  

                                             
    
                                                                  
   
                                                       
                                        
   
                                                                                          
   
                                                                  
     
                                                                        
   
                                 
                                                                 
     
    
 

                                                                           
                                                                                                    
 
                                                       
  
                                                                                     
   
                                           
    
               
    
   
  

             
 

                                                                                                   
 
                                                       
  
                                                                    
  
     
  
                                      

                                          

                                                                            
  
 
      

int function Inventory_GetSurvivalPropertyValueForEquipment( entity player, string equipmentSlot )
{
	string equipRef = Inventory_GetPlayerEquipment( player, equipmentSlot )
	if ( equipRef == "" )
		return 0

	if ( SURVIVAL_Loot_GetLootDataByRef( equipRef ).lootType == eLootType.ARMOR )
		return SURVIVAL_GetPlayerShieldHealthFromArmor( player )

	if ( SURVIVAL_Loot_GetLootDataByRef( equipRef ).lootType == eLootType.GADGET )
	{
		entity heldGadget = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_GADGET )
		if ( IsValid( heldGadget ) && heldGadget.GetWeaponClassName() == equipRef )
		{
			return heldGadget.GetWeaponPrimaryClipCount()
		}
	}
	return 0
}


void function SURVIVAL_GivePlayerEquipment( entity player, string ref, int propertyValue = 0, entity deathBox = null, string equipSlot = "", bool shouldPlaySound = true, int extrapropertyValue = 0 )
{
	LootData data    = SURVIVAL_Loot_GetLootDataByRef( ref )
	if ( equipSlot == "" )
		equipSlot = GetLootTypeData( data.lootType ).equipmentSlot

	if ( SURVIVAL_Loot_GetLootDataByRef( ref ).lootType == eLootType.GADGET )
	{
		SURVIVAL_EquipGadgetFromEquipment(player, ref, true, propertyValue, extrapropertyValue)
		Remote_CallFunction_Replay( player, "ServerCallback_RefreshInventoryAndWeaponInfo" )
	}

	                    
	if( SURVIVAL_Loot_GetLootDataByRef( ref ).lootType == eLootType.ARMOR && UpgradeCore_IsEquipmentArmorCore( ref ) && UpgradeCore_GetPlayerArmorTier( player ) > data.tier )
	{
		ref = UpgradeCore_GetPlayerShieldCoreRef( player, data.tier )
	}
       

	Inventory_SetPlayerEquipment( player, ref, equipSlot, propertyValue, deathBox )

                             
                                    
  
                                                                                
  
       

	if ( shouldPlaySound )
		PlayPickupSound( player, ref )
}


entity function SURVIVAL_DropWeapon( entity player, entity dropWeapon, vector origin, vector vel )
{
	array<entity> weapons = SURVIVAL_GetPrimaryWeaponsIncludingSling( player, false )

	if ( !IsValid( dropWeapon ) )
		return null

	if ( !SURVIVAL_Loot_IsRefValid( dropWeapon.GetWeaponClassName() ) )
		return null

	bool replaceWithMelee = (weapons.len() == 1)

	entity activeWeapon        = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	bool activeWeaponIsPrimary = weapons.contains( activeWeapon )

	bool activeWeaponIsSling = IsPlayerHoldingSlingWeapon( player )
	entity slingWeapon = GetPlayerSlingWeapon( player )

	LootData dropData = SURVIVAL_GetLootDataFromWeapon( dropWeapon )

	string weaponClassName = dropData.baseWeapon
	string dropName        = dropData.ref
	entity drop

	int slot = GetSlotForWeapon( player, dropWeapon )

                               
                                                                                                                        
      

	array<string> mods

	bool slotIsSling = slot == SLING_WEAPON_SLOT

	if( slotIsSling )
	{
		string weaponRef = GetStoredPreSlingWeaponRefForPlayer( player )
		if( !SURVIVAL_Loot_IsRefValid( weaponRef ) )
			weaponRef = weaponClassName

		dropName = weaponRef

		drop = SpawnGenericLoot( weaponRef, origin, player.GetAngles() )

		LootData data = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
		mods = clone data.baseMods
		ReplaceOpticInMods( mods, "" )

		WeaponDropBehavior( player, drop, dropWeapon, false )
	}
	else
	{
		drop = SpawnGenericLoot( dropName, origin, player.GetAngles() )
		WeaponDropBehavior( player, drop, dropWeapon, true )
	}

                                      
                                                                                     
       

	SetItemSpawnSource( drop, eSpawnSource.PLAYER_DROP, player )
	BroadcastItemDrop( player, dropName, drop, weaponClassName )
	LiveAPI_SendInventoryAction( eLiveAPI_EventTypes.inventoryDrop, player, dropName, dropWeapon )

	FakePhysicsThrow( player, drop, vel, true )

              
                                               
     
	bool spawnLoot = true
      
	thread DismantleWeaponModsAfterInterval( drop, LOOT_THROW_WEAPON_MOD_DISMANTLE_DELAY, 0, spawnLoot )

	if( slotIsSling && WeaponLootRefIsLockedSet( dropName ) )
		drop.SetWeaponMods( mods )

	//Create tracking POI marker for dropped weapon.
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_WEAPON, drop, drop.GetOrigin(), player.GetTeam(), player )

	weapons.removebyvalue( dropWeapon )
	player.TakeWeaponByEntNow( dropWeapon )

	if ( dropWeapon != activeWeapon )
		Remote_CallFunction_Replay( player, "ServerCallback_UpdateHudWeaponData", dropWeapon )

                    
                                           
  
                                                                  
                                                                           
  
       

	if ( activeWeaponIsPrimary )
	{
		if ( replaceWithMelee )
		{
			SURVIVAL_TryGivePlayerDefaultMeleeWeapons( player )
		}
		else
		{
			if( !IsValid( activeWeapon ) )
			{
				if( activeWeaponIsSling )
				{
					player.SetActiveWeaponBySlot( eActiveInventorySlot.mainHand, player.GetLastCycleSlot() )
					entity newActiveWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
					if( IsValid( newActiveWeapon ) )
					{
						player.DisableWeapon()
						player.DelayEnableWeaponWithSlowDeploy( newActiveWeapon.GetWeaponSettingFloat( eWeaponVar.raise_time ) )
					}
					else
					{
						foreach ( w in weapons )
						{
							player.SetActiveWeaponByName( eActiveInventorySlot.mainHand, w.GetWeaponClassName() )
						 	newActiveWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
							if( !IsValid( newActiveWeapon ) )
								continue

							player.DisableWeapon()
							player.DelayEnableWeaponWithSlowDeploy( w.GetWeaponSettingFloat( eWeaponVar.raise_time ) )

							break
						}
					}
				}
				else
				{
					foreach ( w in weapons )
					{
						player.SetActiveWeaponByName( eActiveInventorySlot.mainHand, w.GetWeaponClassName() )
						entity newActiveWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
						if( !IsValid( newActiveWeapon ) )
							continue

						player.DisableWeapon()
						player.DelayEnableWeaponWithSlowDeploy( w.GetWeaponSettingFloat( eWeaponVar.raise_time ) )

						break
					}
				}
			}
		}
	}
	else
	{
		if ( IsValid( activeWeapon ) )
			SURVIVAL_TryReplaceOffhandWithPrimary( player, activeWeapon )
	}

	                  
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			FR_Nessie_CheckCurrentWeapons( player )
		}
       

	return drop
}


void function SURVIVAL_TryGivePlayerDefaultMeleeWeapons( entity player )
{


	entity offhandMeleeWeapon                 = player.GetOffhandWeapon( OFFHAND_MELEE )
	string desiredOffhandMeleeWeaponClassname = Survival_GetOffhandMeleeWeaponName( player )

	bool forceGive = ( desiredOffhandMeleeWeaponClassname == ARTIFACT_DAGGER_MELEE_WEAPON ) // otherwise mod conflicts

	if ( !IsValid( offhandMeleeWeapon ) )
	{
		player.GiveOffhandWeapon( desiredOffhandMeleeWeaponClassname, OFFHAND_MELEE )
	}
	else if ( offhandMeleeWeapon.GetWeaponClassName() != desiredOffhandMeleeWeaponClassname || forceGive )
	{
		player.TakeOffhandWeapon( OFFHAND_MELEE )
		player.GiveOffhandWeapon( desiredOffhandMeleeWeaponClassname, OFFHAND_MELEE )
	}

	entity mainMeleeWeapon                 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 )
	string desiredMainMeleeWeaponClassname = Survival_GetMeleeWeaponName( player )

	if ( !IsValid( mainMeleeWeapon ) )
	{
		player.GiveWeapon( desiredMainMeleeWeaponClassname, WEAPON_INVENTORY_SLOT_PRIMARY_2 )
	}
	else if ( mainMeleeWeapon.GetWeaponClassName() != desiredMainMeleeWeaponClassname || forceGive )
	{
		entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

		if ( mainMeleeWeapon == activeWeapon && !player.IsPlayback() )
		{
			player.ReplaceActiveWeapon( eActiveInventorySlot.mainHand, desiredMainMeleeWeaponClassname )
		}
		else
		{
			player.TakeWeaponByEntNow( mainMeleeWeapon )
			player.GiveWeapon( desiredMainMeleeWeaponClassname, WEAPON_INVENTORY_SLOT_PRIMARY_2 )
		}
	}
	else
	{
		player.SetActiveWeaponBySlot( eActiveInventorySlot.mainHand, WEAPON_INVENTORY_SLOT_PRIMARY_2 )
	}

	MeleeWeaponCosmetics_Apply( player )
}

