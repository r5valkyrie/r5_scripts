void function SURVIVAL_HealPlayerOverTime( entity player, int ref )
{
	Assert( false, "SURVIVAL_HealPlayerOverTime is obsolete! Please use EntityHealResource_Add to heal players." )
	Assert( IsNewThread(), "Must be threaded off" )
	Assert( player.IsPlayer() )

	Assert( IsAlive( player ) )
	player.EndSignal( "OnDeath" )

	HealthPickup pickup = SURVIVAL_Loot_GetHealthKitDataFromStruct( ref )

	const float HEAL_PULSES_PER_SEC = 10.0

	float totalHealAmount = SURVIVAL_CalculateTotalHealFromItem( player, ref )
	printl( "HealthPickup: TotalHealing = " + totalHealAmount + "." )

	float amountToHealTotal = player.GetMaxHealth() * totalHealAmount
	float framesOfHealing   = pickup.healTime * HEAL_PULSES_PER_SEC
	float healthPerFrame    = framesOfHealing != 0.0 ? (amountToHealTotal / framesOfHealing) : amountToHealTotal

	float leftoverHealFromLastFrame = 0.0

	while ( amountToHealTotal > 0 )
	{
		float healThisFrame  = healthPerFrame + leftoverHealFromLastFrame
		int actualHealAmount = healthPerFrame <= amountToHealTotal ? int( healThisFrame ) : int( amountToHealTotal )

		if ( !player.IsTitan() )
		{
			if ( player.GetHealth() < player.GetMaxHealth() )
			{
				if ( player.GetHealth() + actualHealAmount > player.GetMaxHealth() )
				{
					player.SetHealth( player.GetMaxHealth() )
					return
				}
				else
				{
					player.SetHealth( player.GetHealth() + actualHealAmount )
				}
			}
		}
		else
		{
			SurvivalPlayerData data = Survival_GetPlayerData( EHIToEncodedEHandle( player ) )
			data.savedHealth = minint( int( data.savedHealth + float( actualHealAmount ) ), data.savedMaxHealth )
		}

		amountToHealTotal -= float( actualHealAmount )
		leftoverHealFromLastFrame = healthPerFrame - float( actualHealAmount ) + leftoverHealFromLastFrame

		if ( leftoverHealFromLastFrame < 0 )
			leftoverHealFromLastFrame = 0

		wait (1 / HEAL_PULSES_PER_SEC)
	}

	//EmitSoundAtPosition( TEAM_ANY, player.GetOrigin(), pickup.endSound)
}


float function  SURVIVAL_CalculateTotalHealFromItem( entity player, int pickupType )
{
	HealthPickup pickup = SURVIVAL_Loot_GetHealthKitDataFromStruct( pickupType )

	if ( PlayerHasPassive( player, ePassives.PAS_SYRINGE_BONUS ) )
		return pickup.healAmount + pickup.healBonus[ ePassives.PAS_SYRINGE_BONUS ]

	if ( PlayerHasPassive( player, ePassives.PAS_HEALTH_BONUS_MED ) )
		return pickup.healAmount + pickup.healBonus[ ePassives.PAS_HEALTH_BONUS_MED ]

	if ( PlayerHasPassive( player, ePassives.PAS_HEALTH_BONUS_ALL ) )
		return pickup.healAmount + pickup.healBonus[ ePassives.PAS_HEALTH_BONUS_ALL ]

	return pickup.healAmount
}

                    
                                                                   
  
                                                                                                                                                                                                                            
                                                                                                                                                                                              
                                                                                                                                                                                                                       
                                                                                                                                                                                  
                                                                                                                                                                                                                     
                                                                                                 
  
                                                                   

                                                              
 
                                  
 

                                    
                                                                      
 
                                
                           

                             
  
                 

                                                  
                                                                                                 
      
                               

                                          
                               
  

                                                            
  
                                                                               
                                                           
  

                          
 

                                                                                                            
 
                                                       
               

                                                                                               
                                                                     
     
                          

                  
 

                                                                   
 
                                                                          
  
        
  

                         
                           
                        
                                                                                    

                                                     
  
                                              

                                                                                               

                                                                                          
                                                               

                                           
                                           

                                                                                 
                                                                                                         
                                    
                                                                                       
                                                                
  
 
                              

