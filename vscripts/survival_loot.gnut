void function ResetPlayerInventory( entity player )
{
	bool resetPlayerInventoryOnRespawn = Survival_ShouldResetInventoryOnRespawn( player )
	if ( !resetPlayerInventoryOnRespawn )
		return

	ClearPlayerInventory( player )

	if ( player in file.Callbacks_OnResetPlayerInventory )
		file.Callbacks_OnResetPlayerInventory[player]( player )
}


void function ClearPlayerInventory( entity player )
{
	// Hard-coded removal of ordnance
	player.TakeNormalWeaponByIndexNow( WEAPON_INVENTORY_SLOT_ANTI_TITAN )

	// Melee weapon
	player.TakeNormalWeaponByIndexNow( WEAPON_INVENTORY_SLOT_PRIMARY_2 )

	SetPlayerInventory( player, [] )

	// Remove inventory
	foreach ( string slot, EquipmentSlot slotData in EquipmentSlot_GetAllEquipmentSlots() )
	{
		Inventory_SetPlayerEquipment( player, "", slot )
		if ( slotData.weaponSlot != -1 )
			player.TakeNormalWeaponByIndexNow( slotData.weaponSlot )
	}

               
                        
                                                     
  
                                           
  
                     

	SURVIVAL_TryGivePlayerDefaultMeleeWeapons( player )

	// Clear ammo pools
	for ( int i = 0 ; i < eAmmoPoolType.len() ; i++ )
		player.AmmoPool_SetCount( i, 0 )

	// Reset primary weapon netvars
	player.SetPlayerNetInt( "playerPrimaryWeapon0", -1 )
	player.SetPlayerNetInt( "playerPrimaryWeapon1", -1 )
}


void function OnHealingEnded( entity player )
{
	if ( !IsAlive( player ) )
		return

	ChooseBestHealthPickup( player, SURVIVAL_GetPlayerInventory( player ) )
}


void function ChooseBestHealthPickup( entity player, array<ConsumableInventoryItem> playerInventory )
{
	if ( player.GetPlayerNetBool( "isHealing" ) )
		return

	int healthPickupType = player.GetPlayerNetInt( "selectedHealthPickupType" )

	if ( healthPickupType == -1 )
		return

	if ( !WeaponDrivenConsumablesEnabled() )
	{
		if ( SURVIVAL_CountItemsInInventory( player, SURVIVAL_Loot_GetHealthPickupRefFromType( healthPickupType ) ) > 0 )
		{
			HealthPickup kit = SURVIVAL_Loot_GetHealthKitDataFromStruct( healthPickupType )

			// keep the current kit, because it heals and I don't have full health
			if ( kit.healAmount > 0 && GetHealthFrac( player ) != 1.0 )
				return

			// keep the current kit because it shields and I don't have full shields
			if ( kit.shieldAmount > 0 && player.GetShieldHealthMax() > 0 && GetShieldHealthFrac( player ) != 1.0 )
				return
		}

		healthPickupType = SURVIVAL_GetBestHealthPickupType( player, true )
		if ( SURVIVAL_CountItemsInInventory( player, SURVIVAL_Loot_GetHealthPickupRefFromType( healthPickupType ) ) == 0 )
		{
			if ( GetCurrentPlaylistVarBool( "auto_heal_option", false ) )
				healthPickupType = -1
			else
				healthPickupType = SURVIVAL_GetBestHealthPickupType( player, false )
		}
	}

	player.SetPlayerNetInt( "selectedHealthPickupType", healthPickupType )
}


void function SetItemSpawnSource( entity itemEnt, int spawnSourceId, entity ownerEnt = null )
{
	if(!IsValid( itemEnt ))
		return

	itemEnt.e.spawnSource = spawnSourceId

	switch ( spawnSourceId )
	{
		case eSpawnSource.PLAYER_DROP:
		case eSpawnSource.PLAYER_DEATH:
		case eSpawnSource.PLAYER_ABILITY:
			if ( IsValid( ownerEnt ) )
			{
				Assert( ownerEnt.IsPlayer() )
				itemEnt.e.spawnSourceIdType = ownerEnt.GetPINNucleusPid() != "unknown" ? "nucleus" : "persona"
				itemEnt.e.spawnSourceOwnerId = ownerEnt.GetPINNucleusPid() != "unknown" ? ownerEnt.GetPINNucleusPid() : ownerEnt.GetPINPlatformId()
				itemEnt.SetOwner( ownerEnt )
			}
			break
		case eSpawnSource.NPC_DEATH:
			if ( ownerEnt.IsNPC() )
			{
				itemEnt.e.spawnSourceIdType = GetEnumString( "eNPC", ownerEnt.ai.npcType )
				itemEnt.e.spawnSourceOwnerId = "NULL"
			}
			break
		default:
			itemEnt.e.spawnSourceIdType = "NULL"
			itemEnt.e.spawnSourceOwnerId = "NULL"
	}
}


