// Client to Server function triggered when an item is picked up on the Client and we need to tell the server
// Use this version when the item is picked up from a Loot Grabber (Loba Market, Firing Range Box) and we want to run extra logic around that
void function ClientCallback_PickupSurvivalItem_WithLootGrabEnt( entity player, entity lootEnt, int pickupFlags, entity lootGrabEnt )
{
	Internal_PickupSurvivalItem_ClientToServer( player, lootEnt, pickupFlags, lootGrabEnt )
}

// Client to Server function triggered when an item is picked up on the Client and we need to tell the server
// Use this version when the item is picked up from a Deathbox and we want to run extra logic around that
void function ClientCallback_PickupSurvivalItem_WithDeathBoxEnt( entity player, entity lootEnt, int pickupFlags, entity boxEnt )
{
	Internal_PickupSurvivalItem_ClientToServer( player, lootEnt, pickupFlags, boxEnt )
}

// Client to Server function triggered when an item is picked up on the Client and we need to tell the server
// Use this version when the item is NOT picked up from a deathbox/Loba Market ( don't send box Ent )
void function ClientCallback_PickupSurvivalItem_NoBoxEnt( entity player, entity lootEnt, int pickupFlags )
{
	Internal_PickupSurvivalItem_ClientToServer( player, lootEnt, pickupFlags, null )
}

                                     
                                                                                                       
 
                                                                                
  
                                                                                  
  
 
                                          

// Runs the logic that used to be run by ClientCallback_PickupSurvivalItem but it got seperated into:
// ClientCallback_PickupSurvivalItem_WithLootGrabEnt
// ClientCallback_PickupSurvivalItem_WithDeathBoxEnt
// ClientCallback_PickupSurvivalItem_NoBoxEnt
// to avoid sending a null ent throught the callback.
void function Internal_PickupSurvivalItem_ClientToServer( entity player, entity lootEnt, int pickupFlags, entity boxEnt )
{
	Remote_CallFunction_UI( player, "SurvivalMenu_AckAction" )

	if ( IsBitFlagSet( pickupFlags, PICKUP_FLAG_DONT_COUNT_TOWARD_BLACK_MARKET_QUOTA ) )
		return // only the Server should ever set this; means a hacker is cheating if it comes in set...

	if ( !IsValid( lootEnt ) )
		return

	string ref = lootEnt.e.lootRef

	if ( !SURVIVAL_Loot_IsRefValid( ref ) )
		return

	if ( !SURVIVAL_CanPlayerPickup( player, lootEnt, pickupFlags ) )
		return

	entity deathBox = null
	if ( IsValid( boxEnt ) && boxEnt.GetTargetName() == DEATH_BOX_TARGETNAME )
		deathBox = boxEnt

	if ( IsValid( deathBox ) )
	{
		if ( lootEnt.GetParent() != deathBox )
			return
	}
	else if ( IsValid( boxEnt ) )
	{
		if ( boxEnt.GetScriptName() == BLACK_MARKET_SCRIPTNAME )
		{
			if (SURVIVAL_Loot_GetLootDataByRef(lootEnt.e.lootRef).lootType == eLootType.AMMO)
				pickupFlags = pickupFlags | PICKUP_FLAG_DONT_COUNT_TOWARD_BLACK_MARKET_QUOTA

			pickupFlags = DoBlackMarketPrePickupLogic( player, boxEnt, lootEnt, pickupFlags )
			if ( pickupFlags == -1 )
				return
			deathBox = boxEnt
		}
	}
	else
	{
		if ( Distance( player.GetOrigin(), lootEnt.GetOrigin() ) > DEATH_BOX_MAX_DIST || SURVIVAL_Loot_IsLootRestricted ( lootEnt ) )
			return
	}

	if ( GetCurrentPlaylistVarBool( "death_box_dist_check", true  )  )
	{
		if ( IsValid( deathBox) )
		{
			if ( !IsPlayerCloseEnoughToDeathBoxToLoot( player, deathBox ) )
				return
		}
	}

	Survival_PickupItem( lootEnt, player, pickupFlags, deathBox )
}

void function ClientCallback_PickupSurvivalLootFromLootGrabber( entity player, int lootFlavorIndex, int desiredCount, entity preferredLootEnt, entity lootGrabber, int pickupFlags, int backpackSwapSlot )
{
	HandlePickupSurvivalLootFromBox( player, lootFlavorIndex, desiredCount, preferredLootEnt, lootGrabber, pickupFlags, backpackSwapSlot )
}

void function ClientCallback_PickupSurvivalLootFromDeathbox( entity player, int lootFlavorIndex, int desiredCount, entity preferredLootEnt, entity deathBox, int pickupFlags, int backpackSwapSlot )
{
	HandlePickupSurvivalLootFromBox( player, lootFlavorIndex, desiredCount, preferredLootEnt, deathBox, pickupFlags, backpackSwapSlot )
}

void function HandlePickupSurvivalLootFromBox( entity player, int lootFlavorIndex, int desiredCount, entity preferredLootEnt, entity deathBox, int pickupFlags, int backpackSwapSlot )
{
	if ( IsBitFlagSet( pickupFlags, PICKUP_FLAG_DONT_COUNT_TOWARD_BLACK_MARKET_QUOTA ) )
		return // only the Server should ever set this; means a hacker is cheating if it comes in set...

	if ( !SURVIVAL_Loot_IsLootIndexValid( lootFlavorIndex ) )
		return

	LootData lootFlavor   = SURVIVAL_Loot_GetLootDataByIndex( lootFlavorIndex )

	                  
		//BONK. You were cheating. No nessie for you
		if ( lootFlavor.lootType == eLootType.COLLECTABLE_NESSIE )
		{
			printf("" + player + " tried to take nessie" )
			RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
			return
		}
       
	                      
		//BONK. You were cheating. No candy for you
		if ( lootFlavor.lootType == eLootType.CANDY_PICKUP )
		{
			printf("" + player + " tried to take candy" )
			RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
			return
		}
       

	                    
		//BONK. You were cheating. No evo cache for you
		if ( lootFlavor.lootType == eLootType.EVO_CACHE )
		{
			printf("" + player + " tried to take evo cache" )
			RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
			return
		}
       

	LootTypeData lootType = GetLootTypeData( lootFlavor.lootType )
	bool isBackpackItem   = (lootType.index != eLootType.MAINWEAPON && lootType.equipmentSlot == "" && lootFlavor.inventorySlotCount > 0)

	if ( desiredCount <= 0 )
		return

	if ( !IsPlayerCloseEnoughToDeathBoxToLoot( player, deathBox ) )
		return

	                                
	bool isRemoteInteracting = false
	if ( deathBox.GetNetworkedClassName() == "prop_death_box" )
	{
		if ( !IsPlayerWithinStandardDeathBoxUseDistance( player, deathBox ) )
		{
			if ( !RemoteDeathboxInteractAllowTakingArmor() && lootFlavor.lootType == eLootType.ARMOR )
			{
				printf("" + player + " tried to take armor remotely" )
				#if DEVELOPER
				RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
				#endif
				return
			}

			if ( !CanPlayerRemoteInteractWithDeathbox( player, deathBox ) )
			{
				printf("" + player + " tried to use alter passive twice" )
				#if DEVELOPER
				RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
				#endif
				return
			}

			if ( lootFlavor.lootType == eLootType.AMMO )
			{
				int maxCount = SURVIVAL_GetInventorySlotCountForPlayer( player, lootFlavor )
				if ( desiredCount > maxCount )
				{
					desiredCount = maxCount

					printf("" + player + " tried to take too much ammo remotely" )
					#if DEVELOPER
					RecordServerAbuseForAntiCheat( player, eRSALabels.TriedToTakeBadItemFromBox )
					#endif
				}
			}

			isRemoteInteracting = true
		}
	}
       

	if ( backpackSwapSlot >= 0 )
	{
		array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )
		if ( backpackSwapSlot >= playerInventory.len() )
			return

		LootData dropLootFlavor = SURVIVAL_Loot_GetLootDataByIndex( playerInventory[backpackSwapSlot].type )
		printt( "trying to drop:", dropLootFlavor.ref )
		bool dropSuccessful = SURVIVAL_DropBackpackItem( player, dropLootFlavor.ref, playerInventory[backpackSwapSlot].count, deathBox )
		if ( !dropSuccessful )
			return
	}

	array<entity> pickupCandidates = [  ]

	entity realmEntity	  = null
	bool isBlackMarket        = (deathBox.GetScriptName() == BLACK_MARKET_SCRIPTNAME)

	bool isVendingMachine	  = (deathBox.GetScriptName() == VENDING_MACHINE_SCRIPTNAME)
	isBlackMarket = isBlackMarket || isVendingMachine
	realmEntity = isVendingMachine ? player : null

	                                
		isBlackMarket = isBlackMarket || isRemoteInteracting
       

	bool isFiringRange = GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE )

	if ( IsValidAndStandardGrabbableLootEnt( preferredLootEnt ) && IsLootEntAccessibleViaDeathBox( preferredLootEnt, deathBox, realmEntity ) )
	{
		pickupCandidates.append( preferredLootEnt )
	}
	else
	{
		preferredLootEnt = null
		// We allow the preferred loot ent to be invalid, so that if two players click the same item in a death box at the same time, the second player may
		// still pickup another loot ent of the same kind.
	}

	int actionType = bool(pickupFlags & PICKUP_FLAG_ALT) ? eLootActionType.ALT_ACTION : eLootActionType.PRIMARY_ACTION

	LootRef lootRef     = SURVIVAL_CreateLootRef( lootFlavor, null )
	LootActionStruct as = SURVIVAL_GetActionForGroundItem( player, lootRef, actionType )

	int amountToThrowOnGround = 0

	if ( isBlackMarket && isBackpackItem && (as.action == eLootAction.PICKUP || as.action == eLootAction.PICKUP_ALL || as.action == eLootAction.SWAP) )
	{
		bool reallyAddToInventory       = false
		int amountThatCanFitInInventory = SURVIVAL_AddToPlayerInventory( player, lootFlavor.ref, desiredCount, reallyAddToInventory )
		if ( amountThatCanFitInInventory < desiredCount )
		{
			amountToThrowOnGround = desiredCount - amountThatCanFitInInventory
			desiredCount -= amountToThrowOnGround
			if ( isVendingMachine )
			{
				amountToThrowOnGround = 0
			}
		}
	}

	int pickedUpCount                = 0
	int thrownOnGroundCount          = 0
	bool haveConsideredOtherLootEnts = false
	while ( pickedUpCount < desiredCount || thrownOnGroundCount < amountToThrowOnGround )
	{
		if ( pickupCandidates.len() == 0 )
		{
			if ( !haveConsideredOtherLootEnts )
			{
				haveConsideredOtherLootEnts = true
				pickupCandidates = GetDeathBoxLootEnts( deathBox, player )
				continue // recheck length
			}
			else
			{
				break
			}
		}

		entity candidate = pickupCandidates.pop()
		Assert( IsValidAndStandardGrabbableLootEnt( candidate ) )
		if ( candidate.GetSurvivalInt() != lootFlavor.index )
			continue // different kind of loot

                                  
		if ( isBlackMarket && !isVendingMachine && !isRemoteInteracting )
       
                                           
        
		{
			if (lootType.index == eLootType.AMMO)
				pickupFlags = pickupFlags | PICKUP_FLAG_DONT_COUNT_TOWARD_BLACK_MARKET_QUOTA

			pickupFlags = DoBlackMarketPrePickupLogic( player, deathBox, candidate, pickupFlags )
			if ( pickupFlags == -1 )
				continue
		}

		if ( pickedUpCount < desiredCount )
		{
			int effectivePickupCount = candidate.GetClipCount()

			if ( file.flyerDeathboxes.contains( deathBox ) ) // Set this for flyer specific PIN data
			{
				candidate.e.spawnSource = eSpawnSource.FLYER
			}

			int remainingNeeded   = desiredCount - pickedUpCount
			bool pickedUpAnything = Survival_PickupItem( candidate, player, pickupFlags, deathBox, remainingNeeded )

			if ( lootFlavor.lootType == eLootType.MAINWEAPON )
				effectivePickupCount = (IsValid( candidate ) ? 0 : 1)
			else if ( IsValid( candidate ) )
			{
				effectivePickupCount -= candidate.GetClipCount()

				if ( isFiringRange && isVendingMachine && lootFlavor.lootType == eLootType.AMMO )
				{
					candidate.Signal("fr_ammo_respawn_now")
				}
			}

			Assert( pickedUpAnything == (effectivePickupCount > 0) )

			pickedUpCount += effectivePickupCount
		}
		else
		{
			Assert( thrownOnGroundCount < amountToThrowOnGround )

			int remainingNeeded = amountToThrowOnGround - thrownOnGroundCount

			int candidateOldCount = candidate.GetClipCount()
			int amountToPickup    = minint( remainingNeeded, candidateOldCount )
			int candiateNewCount  = candidateOldCount - amountToPickup
			if ( candiateNewCount <= 0 )
			{
				if ( isFiringRange && (isVendingMachine || isBlackMarket) )
				{
					FRReplenishLootFromBlackMarketMerge( candidate, isVendingMachine )
				}
				candidate.Destroy()
			}
			else
			{
				candidate.SetClipCount( candiateNewCount )
				if ( isFiringRange && lootFlavor.lootType == eLootType.AMMO )
				{
					FRReplenishAmmoBrick( candidate, candidateOldCount, deathBox )
				}
			}
			thrownOnGroundCount += amountToPickup
		}

		if ( pickedUpCount > 0 )
			pickupFlags = pickupFlags | PICKUP_FLAG_DONT_COUNT_TOWARD_BLACK_MARKET_QUOTA
	}

                                  
                                                                             
  
                                                      
  
      

	if ( thrownOnGroundCount > 0 )
		SURVIVAL_ThrowLootFromPlayer( player, lootFlavor.ref, thrownOnGroundCount )
}

void function  ClientCallback_SwapSurvivalItem_UI( entity player, int inventoryIndex, int lootEntIndex, int boxEntIndex )
{
	// UI does not support to pass entity directly
	entity lootEnt = GetEntityFromEncodedEHandle( lootEntIndex )
	entity boxEnt = GetEntityFromEncodedEHandle( boxEntIndex )

	ClientCallback_SwapSurvivalItem( player, inventoryIndex, lootEnt, boxEnt )
}

// Reimplemented ClientCallback_PickupAllSurvivalItem as a honeypot, makes it easier for cheaters to code auto-looting.
void function ClientCallback_PickupAllSurvivalItem( entity player, int itemId, bool altPickup )
{
	bool hasRecorded = false //RecordServerAbuseForAntiCheat( player, eRSALabels.CC_PickupAllSurvivalItem ) // S3: returns null

	if ( !SURVIVAL_Loot_IsLootIndexValid( itemId ) )
		return

	array<entity> nearbyLoot = GetSurvivalLootNearbyPlayer( player, SURVIVAL_PICKUP_ALL_MAX_RANGE, true, false )

	foreach ( lootEnt in nearbyLoot )
	{
		if ( lootEnt.GetSurvivalInt() == itemId )
		{
			if ( !altPickup )
				Survival_PickupItem( lootEnt, player )
			else
				Survival_PickupItem( lootEnt, player, PICKUP_FLAG_ALT )
		}
	}
}

void function ClientCallback_SwapSurvivalItem( entity player, int inventoryIndex, entity lootEnt, entity boxEnt )
{
	Remote_CallFunction_UI( player, "SurvivalMenu_AckAction" )

	if ( SURVIVAL_IsPlayerCarryingLoot( player ) )
		return

	array< ConsumableInventoryItem > inventory = SURVIVAL_GetPlayerInventory( player )

	if ( inventoryIndex >= inventory.len() )
		return

	if ( !IsValid( lootEnt ) )
		return

	if ( lootEnt.GetNetworkedClassName() != "prop_survival" )
		return

	string ref = lootEnt.e.lootRef

	if ( !SURVIVAL_Loot_IsRefValid( ref ) )
		return

	LootData lootData = SURVIVAL_Loot_GetLootDataByRef( ref )
	LootRef lootRef   = SURVIVAL_CreateLootRef( lootData, lootEnt )

	LootData throwItemData = SURVIVAL_Loot_GetLootDataByIndex( inventory[inventoryIndex].type )

	LootActionStruct asMain = SURVIVAL_GetActionForGroundItem( player, lootRef, eLootActionType.PRIMARY_ACTION )
	LootActionStruct asAlt  = SURVIVAL_GetActionForGroundItem( player, lootRef, eLootActionType.ALT_ACTION )

	int pickupFlags = 0
	if ( asMain.action != eLootAction.PICKUP && asAlt.action == eLootAction.PICKUP )
		pickupFlags = PICKUP_FLAG_ALT

	entity deathBox = null
	if ( IsValid( boxEnt ) && boxEnt.GetTargetName() == DEATH_BOX_TARGETNAME )
		deathBox = boxEnt

	if ( IsValid( deathBox ) )
	{
		if ( lootEnt.GetParent() != deathBox )
			return
	}
	else if ( IsValid( boxEnt ) )
	{
		if ( boxEnt.GetScriptName() == BLACK_MARKET_SCRIPTNAME )
		{
			// we don't consider ammo here, because you don't "swap" ammo in the way you swap other items. pickup-and-drop is NOT the same as swap
			pickupFlags = DoBlackMarketPrePickupLogic( player, boxEnt, lootEnt, pickupFlags )
			if ( pickupFlags == -1 )
				return
			deathBox = boxEnt
		}
	}
	else
	{
		if ( Distance( player.GetOrigin(), lootEnt.GetOrigin() )  > DEATH_BOX_MAX_DIST || SURVIVAL_Loot_IsLootRestricted ( lootEnt ) )
			return
	}

	if ( GetCurrentPlaylistVarBool( "death_box_dist_check", true  )  )
	{
		if ( IsValid( deathBox) )
		{
			if ( !IsPlayerCloseEnoughToDeathBoxToLoot( player, deathBox ) )
				return
		}
	}

	if ( SURVIVAL_DropBackpackItem( player, throwItemData.ref, inventory[inventoryIndex].count, deathBox ) )
		Survival_PickupItem( lootEnt, player, pickupFlags, deathBox )
}

StoredWeapon function CreateStoredWeaponDataFromLoot( entity w )
{
	LootData data = SURVIVAL_Loot_GetLootDataByIndex( w.GetSurvivalInt() )

	StoredWeapon wd
	wd.inventoryIndex = 0
	wd.activeWeapon = false
	wd.clipCount = w.GetClipCount()
	wd.mods = w.GetWeaponMods()
	wd.skinGUID = w.e.skinItemFlavorGUID
	wd.charmGUID = w.e.charmItemFlavorGUID
	wd.name = data.baseWeapon

	wd.ammoCount = -1

	if ( w in file.specialAmmoCounts )
		wd.ammoCount = file.specialAmmoCounts[ w ]

	return wd
}

void function ApplyStoredWeaponDataToLoot( StoredWeapon wd, entity w )
{
	w.SetWeaponMods( wd.mods )

	string baseWeapon = wd.name

	if ( !IsWeaponKeyFieldDefined( baseWeapon, "ammo_pool_type" ) )
	{
		w.SetClipCount( wd.ammoCount )
		file.specialAmmoCounts[ w ] <- wd.clipCount
	}
	else
	{
		LootData wData = SURVIVAL_Loot_GetLootDataByIndex( w.GetSurvivalInt() )
		int clipSize = GetWeaponInfoFileKeyField_GlobalInt( wData.baseWeapon, "ammo_clip_size" )

		if ( wd.clipCount > clipSize )
			w.SetClipCount( clipSize )
		else
			w.SetClipCount( wd.clipCount )
	}

	w.e.charmItemFlavorGUID = wd.charmGUID
	w.e.skinItemFlavorGUID = wd.skinGUID

	ItemFlavor ornull weaponSkin = null
	if ( IsValidItemFlavorGUID( wd.skinGUID, eValidation.DONT_ASSERT ) )
	{
		weaponSkin = GetItemFlavorByGUID( wd.skinGUID )
	}

	ItemFlavor ornull  weaponCharm = null
	if ( IsValidItemFlavorGUID( wd.charmGUID, eValidation.DONT_ASSERT ) )
	{
		weaponCharm = GetItemFlavorByGUID( wd.charmGUID )
	}

	if ( weaponSkin != null || weaponCharm != null )
	{
		WeaponCosmetics_Apply( w, weaponSkin, weaponCharm )
	}
}

