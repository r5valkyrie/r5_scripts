#if DEVELOPER
void function DEV_PrintLootCounts()
{
	array<string> refs             = []
	table<string, int> refCountMap = {}
	int totalLoot = 0

	foreach ( entity ent in GetEntArrayByClass_Expensive( "prop_survival" ) )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )

		if ( !(data.ref in refCountMap) )
		{
			refCountMap[data.ref] <- 0
			refs.append( data.ref )
		}

		refCountMap[data.ref]++
		totalLoot++
	}

	refs.sort( SortStringAlphabetize )

	printf( "loot counts:" )
	foreach ( string ref in refs )
	{
		printf( "\t% 6d  %s", refCountMap[ref], ref )
	}
	printf( "\t% 6d  Total Loot", totalLoot )
}

