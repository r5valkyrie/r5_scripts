void function SURVIVAL_PlayerPickedupItem( entity pickup, entity player, int unitsPickedUp, int pickupAction, int pickupFlags = 0, bool dontDestroy = false, entity deathBox = null )
{
	string ref = pickup.e.lootRef

	PIN_ItemPickup( player, pickup, ref, unitsPickedUp )

	BroadcastItemPickup( player, ref, pickupAction )

	foreach ( callbackFunc in file.Callbacks_OnPlayerLootPickup )
		callbackFunc( player, pickup, ref, unitsPickedUp, !dontDestroy, deathBox, pickupFlags )

	pickup.e.playerPickedUpItem = true

	if ( dontDestroy )
		return

	pickup.Destroy()
}


#if DEVELOPER
void function ClientCommand_dev_survival_cycle_main_weapon( entity player, array<string> args )
{
	bool isForwardCycle = true
	if ( args.len() > 0 )
		isForwardCycle = (args[0] == "next")
	else
		isForwardCycle = !(player.IsCrouched() || player.IsInputCommandHeld( IN_DUCK ) || player.IsInputCommandHeld( IN_DUCKTOGGLE ))

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	array<LootData> allWeapons = SURVIVAL_Loot_GetByType( eLootType.MAINWEAPON )
	int currIndex              = -9999//allWeapons.len() - 1

	const bool shouldSkipFullyKittedWeapons = true

	if ( IsValid( activeWeapon ) )
	{
		LootData currWeaponLootData = SURVIVAL_GetLootDataFromWeapon( activeWeapon )
		string currRef              = currWeaponLootData.ref
		if ( currRef == "" )
		{
			activeWeapon = null
		}
		else
		{
			foreach ( int index, LootData data in allWeapons )
			{
				if ( data.ref == currRef )
				{
					currIndex = index
					break
				}
			}
		}
	}

	int nextIndex
	if ( currIndex == -9999 )
	{
		nextIndex = (isForwardCycle ? 0 : allWeapons.len() - 1)
	}
	else
	{
		for ( int offset = 1; offset < allWeapons.len(); offset++ )
		{
			nextIndex = real_int_modulo( currIndex + offset * (isForwardCycle ? 1 : -1), allWeapons.len() )

			LootData nextWeaponData = allWeapons[nextIndex]
			if ( shouldSkipFullyKittedWeapons && SURVIVAL_Weapon_IsAttachmentLocked( nextWeaponData.ref ) )
				continue

			break
		}
	}

	LootData newWeaponData = allWeapons[nextIndex]

	array<string> modsToAdd = []

	if ( IsValid( activeWeapon ) )
	{
		LootData weaponLootData = SURVIVAL_GetLootDataFromWeapon( activeWeapon )
		//printt( "$$$$$", "wtf", weaponLootData.baseMods.join( "," ) )
		if ( weaponLootData.baseMods.len() == 0 )
		{
			//printt( "$$$$$", "on weapon", activeWeapon.GetMods().join( "," ) )

			if ( newWeaponData.baseMods.len() == 0 )
				AddValidModsFromExistingWeapon( player, activeWeapon, newWeaponData.ref, modsToAdd )

			array<string> mods = activeWeapon.GetMods()
			//printt( "$$$$$", "to inventory", mods.join( "," ) )
			foreach ( string mod in mods )
			{
				if ( SURVIVAL_Loot_IsRefValid( mod ) )
				{
					player.p.DEV_preventAddBackAmmo = true
					EquipAttachments_Internal( player, activeWeapon, "", mod, true, true )
					player.p.DEV_preventAddBackAmmo = false
					activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand ) // todo(dw): wtf
				}
			}
		}

		player.TakeWeaponByEntNow( activeWeapon )
	}

	entity newWeaponLoot            = SpawnGenericLoot( newWeaponData.ref, player.GetOrigin() + <0, 0, 20>, <-1, -1, -1>, newWeaponData.countPerDrop )
	array<string> newWeaponLootMods = newWeaponLoot.GetWeaponMods()
	//printt( "$$$$$", "ground base", newWeaponLootMods.join( "," ) )
	//printt( "$$$$$", "to ground", modsToAdd.join( "," ) )
	newWeaponLootMods.extend( modsToAdd )
	newWeaponLoot.SetWeaponMods( newWeaponLootMods )
	Survival_PickupItem( newWeaponLoot, player )

	//activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	//activeWeapon.Anim_Stop()

	if ( SURVIVAL_Loot_IsRefValid( newWeaponData.ammoType ) )
	{
		LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( newWeaponData.ammoType )
		int currentCount  = player.AmmoPool_GetCount( eAmmoPoolType[ newWeaponData.ammoType ] )
		if ( currentCount < ammoData.inventorySlotCount )
		{
			entity ammoBox = SpawnGenericLoot( ammoData.ref, player.GetOrigin() + <0, 0, 20>, <-1, -1, -1>, ammoData.inventorySlotCount - currentCount )
			Survival_PickupItem( ammoBox, player )
		}
	}
}
#endif

void function SURVIVAL_ClearLootGroupRemappings()
{
	file.lootGroupRemappings.clear()
}


void function SURVIVAL_AddLootGroupRemapping( string groupToOverride, string override )
{
	string g1 = groupToOverride.tolower()
	string g2 = override.tolower()

	Assert( !(g1 in file.lootGroupRemappings) )

	Assert( g1 in file.lootGroups || SURVIVAL_Loot_IsRefValid( g1 ) )
	Assert( g2 in file.lootGroups || SURVIVAL_Loot_IsRefValid( g2 ) )

	if ( g2 in file.lootGroups )
		Assert( !(g1 in file.lootGroups[ g2 ].entries) )

	file.lootGroupRemappings[ g1 ] <- g2
}


string function CheckLootGroupRemapping( string groupName )
{
	string group = groupName.tolower()

	if ( group in file.lootGroupRemappings )
		return file.lootGroupRemappings[ group ]

	return groupName
}


float function GetThrowYawOffsetFromPlayer( entity player )
{
	if ( player in file.playerLootThrowData )
	{
		if ( Time() - file.playerLootThrowData[ player ].lastThrowTime < 3.0 && fabs( file.playerLootThrowData[ player ].lastThrowYawOffset ) < 75.0 )
		{
			file.playerLootThrowData[ player ].lastThrowYawOffset = file.playerLootThrowData[ player ].lastThrowYawOffset <= 0 ? (file.playerLootThrowData[ player ].lastThrowYawOffset * -1) + 20.0 : -1 * file.playerLootThrowData[ player ].lastThrowYawOffset
		}
		else
		{
			file.playerLootThrowData[ player ].lastThrowYawOffset = 0.0
		}
	}
	else
	{
		PlayerLootThrowData d
		file.playerLootThrowData[ player ] <- d
	}

	file.playerLootThrowData[ player ].lastThrowTime = Time()

	return file.playerLootThrowData[ player ].lastThrowYawOffset
}


entity function Survival_CreateDeathBox( vector origin, entity playerOwner, array<int> realmsToAddBoxTo, array<DropWeaponData> playerWeaponData, entity attacker, int damageSourceId, bool fallOrCrushDeath )
{
	if ( !PositionIsInMapBounds( origin ) )
		return null

	entity box = CreateDeathBox( origin, <0, RandomFloat( 360 ), RandomFloatRange( -10, 10 )> )

	PutEntityInSafeSpot( box, null, null, origin, origin )

	Highlight_SetNeutralHighlight( box, "survival_item_common" )

	if ( IsValid( playerOwner ) )
	{
		// set owner but not team!
		// team is being used by respawn beacon
		box.SetOwner( playerOwner )
		playerOwner.p.myLastDeathbox = box
		box.SetNetInt( "ownerEHI", EHIToEncodedEHandle( playerOwner ) )
	}

	foreach ( wData in playerWeaponData )
		wData.mods.clear()

	box.RemoveFromAllRealms()
	foreach ( realmIndex in realmsToAddBoxTo )
	{
		box.AddToRealm( realmIndex )
	}

	box.SetUsable()
	box.SetUsableByGroup( "pilot" )
	box.SetUsePrompts( "#DEATHBOX_HINT", "#DEATHBOX_HINT" )
	box.AddUsableValue( USABLE_CUSTOM_HINTS )
	box.e.blockActive = true

	box.NotSolid()

	foreach ( func in file.onDeathboxSpawnedCallbacks )
	{
		func( box, attacker, damageSourceId )
	}

	bool doFakePhysicsThrow = !fallOrCrushDeath

	                          
		if ( TitanSword_DamageSourceIsTitanSword( damageSourceId ) )
		{
			if ( TitanSword_Slam_DeathboxOverride( box, attacker, playerOwner ) )
				doFakePhysicsThrow = false
		}
       

	if ( doFakePhysicsThrow )
	{
                           
                                                          
                                                                   
      
        
			thread FakePhysicsThrow( playerOwner, box, <0, 0, 300>, false )
	}
	else
	{
		box.Solid()
	}

	MarkEntForCleanupOnRoundEnd( box )

	return box

}


array<string> function SURVIVAL_Loot_GetRandomLootRefsOfType( int maxLootTier, int numOfLoot, array<int> whiteListedLootTypes, bool allowDuplicates = true )
{
	Assert( whiteListedLootTypes.len() >= 1, "Error: no whitelisted loot types!" )

	table<int, int> lootTypesTable

	foreach ( lootType in whiteListedLootTypes ) //Just convert it to a table for quick "in" checks. Maybe this is premature optimization and isn't needed.
	{
		lootTypesTable[ lootType  ] <- 1
	}

	array<string> refs
	table< string, LootData > lootDataTable = SURVIVAL_Loot_GetLootDataTable()
	foreach ( string lootName, LootData lootData in lootDataTable )
	{
		if ( !IsLootTypeValid( lootData.lootType ) )
			continue

		if ( !LootTypeHasAnyChanceToSpawn( lootName ) )
			continue

		if ( !(lootData.lootType in lootTypesTable) )
			continue

		if ( (maxLootTier >= 0) && (lootData.tier > maxLootTier) )
			continue

		refs.append( lootName )
	}

	array<string> results
	for ( int idx = 0; idx < numOfLoot; ++idx )
	{
		Assert( refs.len() > 0, " Number of loot pieces requested is more than loot that fulfills criteria!" )
		int randomRefIndex = RandomIntForLoot( refs.len() )
		results.append( refs[ randomRefIndex  ] )

		if ( !allowDuplicates )
		{
			refs.fastremove( randomRefIndex )
		}
	}

	//foreach( result in results )
	//{
	//	printt( "Loot type: " + result  )
	//}

	return results
}


string function SURVIVAL_Loot_GetRandomLootOfSpecifiedTierAndType( int lootTier, int lootType )
{
	array<LootData> lootItems = SURVIVAL_Loot_GetByType( lootType )

	array<string> refs
	foreach ( lootItem in lootItems )
	{
		if ( !IsLootTypeValid( lootItem.lootType ) )
			continue

		if ( !LootTypeHasAnyChanceToSpawn( lootItem.ref ) )
			continue

		if ( lootItem.tier != lootTier )
			continue

		refs.append( lootItem.ref )
	}

	if ( refs.len() == 0 )
		return ""

	return refs[ RandomInt( refs.len() )  ]
}


array<string> function SURVIVAL_Loot_GetLootMimickingPlayer( int maxLootTier, int numOfLoot )
{
	array<string> results

	//Loot for player is defined as follows: 1-2 weapons, 0-1 armor, 0-1 helmet, 0-1 backpack, and lastly, random amounts of ammo, ordnance, health and attachments, which can be duplicated.

	if ( numOfLoot == 0 )
		return results

	//First do weapons.

	int numWeapons = RandomIntRangeInclusiveForLoot( 1, 2 )
	if ( numWeapons > numOfLoot )
		numWeapons = numOfLoot

	array<string> weapons = SURVIVAL_Loot_GetRandomLootRefsOfType( maxLootTier, numWeapons, [ eLootType.MAINWEAPON ], false )


	results.extend( weapons )

	int numLootRemaining = numOfLoot - numWeapons

	if ( numLootRemaining == 0 )
		return results

	//Next do armor

	int numArmor = CoinFlip() ? 1 : 0
	if ( numArmor > 0 )
	{
		array<string> armor = SURVIVAL_Loot_GetRandomLootRefsOfType( maxLootTier, numArmor, [ eLootType.ARMOR ], false )
		results.extend( armor )

		numLootRemaining -= numArmor
	}

	if ( numLootRemaining == 0 )
		return results

	//Next do helmet
	int numHelmet = CoinFlip() ? 1 : 0
	if ( numHelmet > 0 )
	{
		array<string> helmet = SURVIVAL_Loot_GetRandomLootRefsOfType( maxLootTier, numHelmet, [ eLootType.HELMET ], false )
		results.extend( helmet )

		numLootRemaining -= numHelmet
	}

	if ( numLootRemaining == 0 )
		return results

	//Next do backpack

	int numBackpack = CoinFlip() ? 1 : 0
	if ( numBackpack > 0 )
	{
		array<string> backpack = SURVIVAL_Loot_GetRandomLootRefsOfType( maxLootTier, numBackpack, [ eLootType.BACKPACK ], false )
		results.extend( backpack )

		numLootRemaining -= numBackpack
	}

	if ( numLootRemaining == 0 )
		return results

	//Now for remaining items: ammo, health, ordnance and attachments, which can be duplicated
	array<string> remainingItems = SURVIVAL_Loot_GetRandomLootRefsOfType( maxLootTier, numLootRemaining, [ eLootType.HEALTH, eLootType.AMMO, eLootType.ORDNANCE, eLootType.ATTACHMENT ], true )
	results.extend( remainingItems )

	Assert( results.len() ==  numOfLoot )

	return results

}


