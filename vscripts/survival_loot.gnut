void function CreateHotZones( bool createAll, bool debugOnly )
{
	if ( !GetCurrentPlaylistVarBool( "loot_hotzone_enabled", true ) )
	{
		#if DEVELOPER
		printf( "[hotzone] HOT ZONES NOT SPAWNED, loot_hotzone_enabled IS FALSE" )
		#endif // DEVELOPER

		return
	}

	if ( file.lootHotZones.len() == 0 )
	{
		#if DEVELOPER
		printf( "[hotzone] HOT ZONES NOT SPAWNED, 0 HOT ZONES FOUND" )
		#endif // DEVELOPER

		return
	}

	array<LootZone> selectedHotZones = ( createAll ? SURVIVAL_GetPotentialHotZones() : SelectHotZones() )

	foreach ( zone in selectedHotZones )
	{
		EnableHotZone( zone, debugOnly )
	}
}

