void function OnPlayerAddWeaponMod( entity player, entity weapon, string mod )
{
	//printt( "OnPlayerAddWeaponMod", player, weapon, mod )

	if ( mod == "altfire" && DoesModExist( weapon, "hopup_selectfire" ) && !weapon.HasMod( "hopup_selectfire" ) )
		weapon.RemoveMod( "altfire" )

	                      
		if ( mod == "altfire" && weapon.HasMod( "hopup_highcal_rounds" ) )
			weapon.RemoveMod( "altfire" )
                            

	//foreach ( modName in weapon.GetMods() )
	//	printt( "\t", modName )
}


