{
	SURVIVAL_StopDisplayingHotzones()

	CreateHotZones( false, true )
}
#endif // DEVELOPER

#if DEVELOPER
void function DEV_CreateHotZonesDebugAll()
{
	SURVIVAL_StopDisplayingHotzones()

	CreateHotZones( true, true )
}
#endif // DEVELOPER

array<LootZone> function SelectHotZones()
{
	array<LootZone> selectedHotZones

	array<LootZone> lootHotZones = SURVIVAL_GetPotentialHotZones()
	float planePathFrac = GetCurrentPlaylistVarFloat( "loot_hotzone_plane_path_frac", 0.65 )
	int hotZoneCount = GetCurrentPlaylistVarInt( "loot_hotzone_count", 1 )
	hotZoneCount = minint( lootHotZones.len(), hotZoneCount )

	if ( hotZoneCount <= 0 )
	{
		#if DEVELOPER
		printf( "[hotzone] TOTAL OF 0 HOT ZONES WAS REQUESTED" )
		#endif // DEVELOPER

		return selectedHotZones
	}

	// If we are locking loot, hot zone is in same spot every time
	if ( planePathFrac == 0.0 || IsLockedLootActive() )
	{
		for ( int i = 0; i < hotZoneCount; ++i )
		{
			LootZone lootZone

			//if ( IsLockedLootActive() ) // S3: getrandomseeded not available
			//	lootZone = lootHotZones.getrandomseeded( GetRandomSeedForLoot() )
			//else
				lootZone = lootHotZones.getrandom()

			selectedHotZones.append( lootZone )

			lootHotZones.fastremovebyvalue( lootZone )
		}
	}
                     
                                           
  
                                          
   
                                               

                
                                                                                                                          
    
                                       
           
    

                   
    
                                       
                                              
    
   
  
                           
	else
	{
		// Sort hot zones by closest to the planePathFrac point
		{
			vector startPos  = SURVIVAL_GetPlaneJumpStartPos()
			vector endPos    = SURVIVAL_GetPlaneJumpEndPos()
			vector planeVec  = Normalize( endPos - startPos )
			float jumpLength = (endPos - startPos).Length()

			vector pathOrigin = startPos + (planeVec * (jumpLength * planePathFrac))

			lootHotZones.sort( int function( LootZone a, LootZone b ) : (pathOrigin) {
				return SortLowestFloat( Distance2DSqr( pathOrigin, a.origin ), Distance2DSqr( pathOrigin, b.origin ) )
			} )
		}

		array<LootZone> hotZonePool
		{
			int hotZonePoolSize = GetCurrentPlaylistVarInt( "loot_hotzone_plane_path_pool_size", 3 )
			hotZonePoolSize = minint( hotZonePoolSize, lootHotZones.len() )

			if ( hotZonePoolSize <= 0 )
			{
				#if DEVELOPER
				printf( "[hotzone] NO HOT ZONES IN POOL TO CONSIDER" )
				#endif // DEVELOPER

				return selectedHotZones
			}

			hotZonePool = lootHotZones.slice( 0, hotZonePoolSize )
			hotZonePool.randomize()
		}

		for ( int i = hotZoneCount; i > 0 ; --i )
		{
			if ( hotZonePool.len() == 0 )
			{
				#if DEVELOPER
				printf( "[hotzone] ALL POSSIBLE HOT ZONES HAVE BEEN ADDED" )
				#endif // DEVELOPER

				break
			}

			LootZone ornull testZone = null
			LootZone ornull testZoneBackup = null
			int backupPriority = 0

			int tries = hotZonePool.len() - i
			tries = maxint( tries, 1 )

			while ( tries > 0 )
			{
				testZone = hotZonePool.pop()
				expect LootZone( testZone )

				// Check if hot zone is inside the ring
				{
					float safeZoneDist = GetCurrentPlaylistVarFloat( "loot_hotzone_check_safe_zone_spawn", -1.0 )
					if ( safeZoneDist >= 0.0 )
					{
						int defaultRealm = Survival_Loot_GetDefaultRealm()
						bool inSafeZone = SURVIVAL_PosInSafeZone( defaultRealm, testZone.origin, safeZoneDist )

						if ( !inSafeZone )
						{
							#if DEVELOPER
							printf( "[hotzone] HOT ZONE NOT IN SAFE ZONE: " + testZone.origin )
							#endif // DEVELOPER

							tries--
							continue
						}
					}
				}

				// Minimum distance from flight path
				{
					float distFromPlane = GetCurrentPlaylistVarFloat( "loot_hotzone_dist_from_plane_path", -1.0 )
					if ( distFromPlane >= 0.0 )
					{
						vector startPos = FlattenVec( SURVIVAL_GetPlaneJumpStartPos() )
						vector endPos = FlattenVec( SURVIVAL_GetPlaneJumpEndPos() )
						vector originTest = FlattenVec( testZone.origin )

						float distSqr = GetDistanceSqrFromLineSegment( startPos, endPos, originTest )
						float requiredDistSqr = pow( distFromPlane, 2 )
						if ( distSqr < requiredDistSqr )
						{
							#if DEVELOPER
							printf( "[hotzone] HOT ZONE TOO CLOSE TO PLANE PATH: " + testZone.origin )
							#endif // DEVELOPER

							tries--
							continue
						}
					}

				}

				// Enforce distance threshold from each other
				{
					if ( selectedHotZones.len() > 0 )
					{
						float distanceThreshold = GetCurrentPlaylistVarFloat( "loot_hotzone_min_distance_threshold", 30000.0 )

						bool isTooClose = false
						foreach ( LootZone prevSelected in selectedHotZones )
						{
							if ( !IsPositionWithinRadius( distanceThreshold, testZone.origin, prevSelected.origin ) )
							{
								continue
							}

							#if DEVELOPER
							printf( "[hotzone] HOT ZONE: " + testZone.origin + " TOO CLOSE TO SELECTED HOT ZONE: " + prevSelected.origin )
							#endif // DEVELOPER

							// Don't hard enforce this rule, use this zone if nothing better is found
							if ( backupPriority <= 1 )
							{
								testZoneBackup = testZone
								backupPriority = 1
							}

							isTooClose = true
							break
						}

						if ( isTooClose )
						{
							tries--
							continue
						}
					}
				}

				// Have an even number of hot zones on each side of the plane path
				{
					bool isOddCount = ( selectedHotZones.len() % 2 ) > 0
					if ( selectedHotZones.len() > 0 && isOddCount )
					{
						vector startPos = SURVIVAL_GetPlaneJumpStartPos()
						vector prevHotZoneOrigin = FlattenVec( selectedHotZones[ selectedHotZones.len() - 1 ].origin - startPos )
						vector currHotZoneOrigin = FlattenVec( testZone.origin - startPos )
						vector flattenedStart = FlattenVec( startPos )
						float prevZ = CrossProduct( flattenedStart, prevHotZoneOrigin ).z
						float currZ = CrossProduct( flattenedStart, currHotZoneOrigin ).z

						bool isCurrZoneFlipped = ( prevZ < 0 && currZ > 0 ) || ( prevZ > 0 && currZ < 0 )
						if ( !isCurrZoneFlipped )
						{
							#if DEVELOPER
							printf( "[hotzone] HOT ZONE ON WRONG SIDE OF PLANE PATH: " + currHotZoneOrigin )
							#endif // DEVELOPER

							// Don't hard enforce this rule, use this zone if nothing better is found
							if ( backupPriority <= 2 )
							{
								testZoneBackup = testZone
								backupPriority = 2
							}

							tries--
							continue
						}
					}
				}

				// Passed all checks, use this current test zone
				testZoneBackup = null
				break
			}

			if ( testZoneBackup != null )
			{
				testZone = testZoneBackup
				expect LootZone( testZone )

				#if DEVELOPER
				printf( "[hotzone] SELECTED HOT ZONE WAS A BACKUP: " + testZone.origin )
				#endif // DEVELOPER
			}

			if ( tries <= 0 && testZone != null )
			{
				expect LootZone( testZone )

				#if DEVELOPER
				printf( "[hotzone] HOT ZONE CHECK RAN OUT OF TRIES, USING ZONE: " + testZone.origin )
				#endif // DEVELOPER
			}
			else if ( testZone == null )
			{
				#if DEVELOPER
				printf( "[hotzone] ALL POSSIBLE HOT ZONES HAVE BEEN ADDED" )
				#endif // DEVELOPER

				break
			}

			expect LootZone( testZone )
			selectedHotZones.append( testZone )
		}
	}

	return selectedHotZones
}

void function EnableHotZone( LootZone zone, bool debugOnly )
{
	ActiveHotZone enabledZone
	enabledZone.zone = zone

	if ( !debugOnly )
	{
		CreateHotZoneLoot( enabledZone )

		CreateHotZoneFX( enabledZone )
	}

	CreateHotZoneMinimap( enabledZone )

	file.activeHotZones.append( enabledZone )
}

void function CreateHotZoneLoot( ActiveHotZone activeZone )
{
	float radiusSqr = activeZone.zone.radius * activeZone.zone.radius
	int hotZonePriority = file.lootGroups[ HOT_ZONE_POI_GENERAL.tolower() ].priority
	foreach ( LootZone zone in file.lootZones )
	{
		for ( int ptIndex = zone.spawnPoints.len() - 1; ptIndex >= 0; ptIndex-- )
		{
			BinOrSpawnPoint testPoint = zone.spawnPoints[ptIndex]

			if ( DistanceSqr( testPoint.pos, activeZone.zone.origin ) > radiusSqr )
				continue

			if ( zone.priority > hotZonePriority )
				continue

			activeZone.zone.spawnPoints.append( testPoint )
			zone.spawnPoints.remove( ptIndex )
		}
	}

	// Create POIs inside the hot zone
	if ( activeZone.zone.spawnPoints.len() > 3 )
	{
		if ( IsLockedLootActive() )
			activeZone.zone.spawnPoints.randomize() // S3: seeded shuffle not available for typed arrays
		else
			activeZone.zone.spawnPoints.randomize()

		LootZone poiA
		poiA.origin = activeZone.zone.spawnPoints[0].pos
		poiA.radius = 16.0
		poiA.zoneClass = HOT_ZONE_POI_WEAPON.tolower()
		poiA.spawnPoints.append( activeZone.zone.spawnPoints[0] )
		activeZone.zone.spawnPoints.remove( 0 )
		file.lootZones.append( poiA )

		LootZone poiB
		poiB.origin = activeZone.zone.spawnPoints[0].pos
		poiB.radius = 16.0
		poiB.zoneClass = HOT_ZONE_POI_ITEM.tolower()
		poiB.spawnPoints.append( activeZone.zone.spawnPoints[0] )
		activeZone.zone.spawnPoints.remove( 0 )
		file.lootZones.append( poiB )

		LootZone poiC
		poiC.origin = activeZone.zone.spawnPoints[0].pos
		poiC.radius = 16.0
		poiC.zoneClass = HOT_ZON_POI_ATTACHMENTS.tolower()
		poiC.spawnPoints.append( activeZone.zone.spawnPoints[0] )
		activeZone.zone.spawnPoints.remove( 0 )
		file.lootZones.append( poiC )

		if( HOT_ZONE_DEBUG )
		{
			DebugDrawLine( poiA.origin, poiA.origin + <0,0,256>, 255, 255, 0, true, 9999.0 ) //Yellow Line
			DebugDrawLine( poiB.origin, poiB.origin + <0,0,256>, 0, 255, 0, true, 9999.0 ) //Green Line
			DebugDrawLine( poiC.origin, poiC.origin + <0,0,256>, 0, 0, 255, true, 9999.0 ) //Blue Line
		}
	}

	file.lootZones.append( activeZone.zone )
                      
                                                  
   
                                                             
   
       
}

void function CreateHotZoneMinimap( ActiveHotZone activeZone )
{
	// Minimap Entity
	activeZone.minimapEnt = CreateEntity( "prop_script" )
	activeZone.minimapEnt.SetValueForModelKey( $"mdl/dev/empty_model.rmdl" )
	activeZone.minimapEnt.kv.fadedist = -1
	activeZone.minimapEnt.kv.renderamt = 255
	activeZone.minimapEnt.kv.rendercolor = "255 255 255"
	activeZone.minimapEnt.kv.solid = 6
	activeZone.minimapEnt.SetOrigin( activeZone.zone.origin )
	activeZone.minimapEnt.SetAngles( <0, 0, 0> )
	activeZone.minimapEnt.NotSolid()
	activeZone.minimapEnt.Hide()
	activeZone.minimapEnt.DisableHibernation()
	float radius = min( 65536.0, activeZone.zone.radius )
	activeZone.minimapEnt.Minimap_SetObjectScale( radius / SURVIVAL_MINIMAP_RING_SCALE )
	activeZone.minimapEnt.Minimap_SetAlignUpright( true )
	activeZone.minimapEnt.Minimap_SetZOrder( MINIMAP_Z_OBJECTIVE )
	activeZone.minimapEnt.Minimap_SetClampToEdge( true )
	activeZone.minimapEnt.Minimap_SetCustomState( eMinimapObject_prop_script.OBJECTIVE_AREA )
	foreach ( entity player in GetPlayerArray() )
		activeZone.minimapEnt.Minimap_AlwaysShow( 0, player )
	SetTargetName( activeZone.minimapEnt, "hotZone" )
	DispatchSpawn( activeZone.minimapEnt )
}

void function CreateHotZoneFX( ActiveHotZone activeZone )
{
	// World FX Beam
	activeZone.effectHandle = StartParticleEffectInWorld_ReturnEntity( GetParticleSystemIndex( $"P_ar_hot_zone_far" ), activeZone.zone.origin, <0, 0, 0> + <90, 0, 0> )
}

void function SURVIVAL_VerifyLootProbabilitiesForAllGroups()
{
	printt( "Verifying probabilities for all groups!" )

	float sanityCheck
	int numGroupElements
	array<string> violatingGroups
	foreach ( groupName, groupData in file.lootGroups )
	{
		array<string> violatingGroupsToPopulate
		VerifyLootProbabilitiesForGroup( groupName, violatingGroupsToPopulate )
		violatingGroups.extend( violatingGroupsToPopulate )
	}

	printt( "Verify loot probabilities summary:" )
	foreach ( group in violatingGroups )
	{
		printt( "Group:", group, "in violation!" )
		Warning( "Group: " + group + " in violation!" )
	}
}


void function VerifyLootProbabilitiesForGroup( string group, array<string> violatingGroups )
{
	LootGroup groupData  = clone file.lootGroups[ group ]
	array<WeightedLootData> lootArray
	float sanityCheck    = 0.0
	float smallestWeight = 1.0
	int numGroupElements

	foreach ( itemRef, numItems in groupData.entries )
	{
		// Num is out of 100. Normalize to be 0 - 1 range, incorporate recursive context weight ( example: item is of a group with weight 0.2 aka 20% )
		float itemWeight = numItems * 0.01
		numGroupElements++

		if ( itemWeight < smallestWeight )
			smallestWeight = itemWeight

		WeightedLootData newLootData
		newLootData.ref = itemRef
		newLootData.weight = itemWeight
		lootArray.append( newLootData )
	}

	lootArray.sort( SortLootItemRefsLowestToHighestProbability )
	for ( int i; i < numGroupElements; i++ )
	{
		sanityCheck += lootArray[ i ].weight
	}

	float epsilon = smallestWeight * 0.01        // Float precision variance below this value shouldn't be indicative of an error.

	if ( fabs( sanityCheck - 1.0 ) > epsilon )
	{
		printt( ">>>>>>>> WARNING! <<<<<<<<" )
		printt( "Group", group, "has invalid sum! Should be 1:", sanityCheck )
		printt( ">>>>>>>> -------- <<<<<<<<" )
		violatingGroups.append( group )
	}
}


int function SortLootItemRefsLowestToHighestProbability( WeightedLootData a, WeightedLootData b )
{
	if ( a.weight > b.weight )
		return 1
	else if ( b.weight > a.weight )
		return -1

	return 0
}


void function SURVIVAL_DebugLoot( string ref, vector origin )
{
	#if DEVELOPER
		if ( GetSurvivalDebugMode() == eSurvivalDebugType.NONE )
			return

		LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )

		if ( ref == "blank" )
		{
			DebugDrawLine( origin, origin + <0, 0, 100>, 255, 0, 0, true, 100.0 )
		}
		else
		{
			bool drawText = false
			switch ( GetSurvivalDebugMode() )
			{
				case eSurvivalDebugType.WEAPONS_NOT_WEAPONS:
					if ( data.lootType == eLootType.MAINWEAPON )
					{
						DebugDrawLine( origin, origin + <0, 0, 500>, 0, 0, 255, true, 100.0 )
					}
					else
					{
						DebugDrawLine( origin, origin + <0, 0, 500>, 0, 255, 0, true, 100.0 )
					}
					break

				case eSurvivalDebugType.TIERS:
					array<vector> colors =
					[
						< 0, 0, 0 >,
						< 200, 200, 200 >,
						< 0, 0, 255 >,
						< 255, 0, 255 >,
						< 255, 233, 0 >,
					]
					vector color = colors[0]

					if ( data.tier < colors.len() )
					{
						color = colors[data.tier]
					}

					DebugDrawLine( origin, origin + <0, 0, 500>, int(color.x), int(color.y), int(color.z), true, 100.0 )
					break

                      
				case eSurvivalDebugType.DATA_KNIFE:
					drawText = false
					if ( data.lootType == eLootType.DATAKNIFE )
					{
						DebugDrawLine( origin, origin + <0, 0, 500>, 0, 255, 0, true, 100.0 )
					}
			}

			if ( drawText )
				DebugDrawText( origin, ref, false, 100.0 )
		}
	#endif // #if DEVELOPER
}


entity function SpawnLoot( string ref, vector origin, bool onMovingGeo )
{
	return SpawnLoot_Internal( ref, origin, onMovingGeo )
}


entity function SpawnLoot_Internal( string ref, vector origin, bool onMovingGeo )
{
	if( SURVIVAL_Loot_IsReforBaseWeaponDisabled( ref ) )
	{
		Warning( "SpawnLoot - Attempting to spawn disabled item: %s", ref )
		// Allow item to spawn with just the warning for now
		//return null
	}

	entity ent

	int lootType = SURVIVAL_Loot_GetLootDataByRef( ref ).lootType

	vector startOrigin = origin + <0, 0, 8>
	vector endOrigin   = origin - <0, 0, 20000>
	vector newOrigin   = GetGroundPosition( startOrigin, endOrigin ).endPos

	SURVIVAL_DebugLoot( ref, origin )

	LootTypeData lt = GetLootTypeData( lootType )
	if ( lt.specialCaseSpawnFunction != null )
		ent = lt.specialCaseSpawnFunction( ref, newOrigin )
	else
		ent = SpawnGenericLoot( ref, newOrigin, <-1, -1, -1>, SURVIVAL_Loot_GetLootDataByRef( ref ).countPerDrop )

	if ( ent == null )
		return null

	if ( onMovingGeo )
	{
		TraceResults trace = TraceLineHighDetail( ent.GetOrigin(), ent.GetOrigin() - <0, 0, 88>, ent, LOOT_TRACE, LOOT_COLLISION_GROUP )
		if ( IsValid( trace.hitEnt ) && trace.hitEnt.HasPusherAncestor() )
		{
			string parentTargetName = trace.hitEnt.GetTargetName()
			if ( parentTargetName in file.Callbacks_OnLootSpawnParented )
			{
				foreach ( func in file.Callbacks_OnLootSpawnParented[parentTargetName] )
					func( trace.hitEnt, ent )
			}

			ent.SetParent( trace.hitEnt, "", true, 0 )
		}
	}
	return ent
}


entity function SpawnWeaponAndAmmo( string weaponName, vector origin )
{
	vector newOrigin = origin + <0, 0, 2> // OriginToGround(origin) + <0,0,2>

	entity weapon = SpawnGenericLoot( weaponName, newOrigin, < 0, RandomFloatRange( 0, 360 ), 90 >, -1 )

	LootData data = SURVIVAL_Loot_GetLootDataByRef( weaponName )

	if ( SURVIVAL_Loot_IsAmmoSpawningDisabled() )
		return weapon

	if ( GetWeaponInfoFileKeyField_GlobalBool( data.baseWeapon, "uses_ammo_pool" ) )
	{
		string ammoType = GetWeaponAmmoType( weaponName )

		int ammoMin = 1
		int ammoMax = 2

		//if ( WeaponsSpawnWithAmmo() )
		//{
		//	ammoMin = 1
		//	ammoMax = 2
		//}

		int numAmmo = 1
		if ( RandomIntRangeInclusiveForLoot( 1, 10 ) > 3 )
			numAmmo = 2

		for ( int i = 0; i < numAmmo; i++ )
		{
			thread DelayedSpawnAmmo( weapon, ammoType, newOrigin, GetCurrentPlaylistVarFloat( "survival_ammo_spawn_scale_" + ammoType, 1.0 ) )
		}
	}

	return weapon
}


void function DelayedSpawnAmmo( entity weapon, string ammoType, vector origin, float scale )
{
	if ( SURVIVAL_Loot_IsAmmoSpawningDisabled() )
		return

	bool isForTestMap = (GetMapName() == "mp_rr_box")
	float angle       = (isForTestMap ? RandomFloatRange( 85.0, 95.0 ) : RandomFloat( 360.0 ))

	// TraceResults trace = TraceLine( origin + <0,0,8>, origin - <0,0,200>, [], LOOT_TRACE, LOOT_COLLISION_GROUP )

	float upZ        = (isForTestMap ? 12.0 : 32.0)
	vector newOrigin = origin // trace.endPos
	vector startPos  = (newOrigin + <0, 0, upZ>)
	int tries        = 0

	wait RandomFloatRange( 0, 1 )

	TraceResults trace = TraceLine( newOrigin, startPos, [], LOOT_TRACE, LOOT_COLLISION_GROUP )
	// DebugDrawLine( newOrigin, startPos, 255, 0, 0, true, 100.0 )

	//if ( trace.fraction < 0.99 )
	//{
	//	Warning( "WARNING: loot spot at " + origin + " cannot spawn ammo: hitting ceiling.  Please lower it." )
	//	return
	//}

	startPos = trace.endPos

	wait RandomFloatRange( 0, 1 )

	int countPerDrop = int( floor( SURVIVAL_Loot_GetLootDataByRef( ammoType ).countPerDrop * scale ) )

	float pitch          = 40.0
	int triesForPitch    = 0
	int maxTriesForPitch = 2
	int maxTriesForYaw   = 32

	while ( tries < maxTriesForYaw )
	{
		vector angleDown = < pitch, angle, 0.0 >
		vector endPos    = startPos + (AnglesToForward( angleDown ) * 200)

		//trace = TraceLine( startPos, endPos, [], LOOT_TRACE, LOOT_COLLISION_GROUP )
		trace = GetGroundPosition( startPos, endPos, [], <3, 3, 0> )
		newOrigin = trace.endPos
		// DebugDrawLine( startPos, trace.endPos, 0, 255, 0, true, 100.0 )

		if ( DotProduct( trace.surfaceNormal, < 0, 0, 1 > ) > 0.9 )
		{
			// DebugDrawLine( startPos, endPos, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 600.0 )
			entity ammo = SpawnGenericLoot( ammoType, newOrigin, <-1, -1, -1>, countPerDrop )
			if ( IsValid( trace.hitEnt ) && trace.hitEnt.HasPusherAncestor() )
				ammo.SetParent( trace.hitEnt, "", true, 0 )

			if ( IsValid( weapon ) )
			{
				ammo.RemoveFromAllRealms()
				ammo.AddToOtherEntitysRealms( weapon )
			}

			return
		}

		tries++

		angle = (angle + RandomFloatRange( 10, 20 )) % 360

		// DebugDrawLine( startPos, endPos, 0, 0, 255, true, 1.0 )

		if ( triesForPitch < maxTriesForPitch && tries >= maxTriesForYaw )
		{
			tries = 0
			triesForPitch++
			pitch += 10.0
		}

		wait RandomFloatRange( 0, 1 )
	}

	Warning( "WARNING: loot spot at " + origin + " didn't spawn enough ammo: couldn't find a spot.  Please give it more breathing room." )
}

              
entity function SpawnVaultKey( string vaultKeyRef, vector origin )
{
	vector newOrigin = origin + <0, 0, 2>
	entity vaultKey = SpawnGenericLoot( vaultKeyRef, newOrigin )

	SURVIVAL_Loot_DisableNetworkDistanceCullingManaged( vaultKey )

	return vaultKey
}
                        

entity function SpawnArmor( string armorRef, vector origin )
{
	vector newOrigin = origin + <0, 0, 2> // OriginToGround(origin) + <0,0,2>

	entity armor = SpawnGenericLoot( armorRef, newOrigin )

	if( IsValid( armor  ) )
		armor.AddUsableValue( USABLE_BLOCK_CONTINUOUS_USE )

	return armor
}


void function DelayedSpawnArmorShard( string shardType, vector origin, int count )
{
	float angle = RandomFloat( 360.0 )

	vector newOrigin = origin // trace.endPos
	vector startPos  = newOrigin + < 0, 0, 32 >
	int tries        = 0

	wait RandomFloatRange( 0, 1 )

	TraceResults trace = TraceLine( newOrigin, startPos, [], LOOT_TRACE, LOOT_COLLISION_GROUP )
	startPos = trace.endPos

	wait RandomFloatRange( 0, 1 )

	float pitch          = 40.0
	int triesForPitch    = 0
	int maxTriesForPitch = 2
	int maxTriesForYaw   = 32

	while ( tries < maxTriesForYaw )
	{
		vector angleDown = < pitch, angle, 0.0 >
		vector endPos    = startPos + (AnglesToForward( angleDown ) * 200)

		//trace = TraceLine( startPos, endPos, [], LOOT_TRACE, LOOT_COLLISION_GROUP )
		trace = GetGroundPosition( startPos, endPos, [], <6, 6, 0> )
		newOrigin = trace.endPos
		// DebugDrawLine( startPos, trace.endPos, 0, 255, 0, true, 100.0 )

		if ( DotProduct( trace.surfaceNormal, < 0, 0, 1 > ) > 0.9 )
		{
			// DebugDrawLine( startPos, endPos, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 600.0 )
			entity shard = SpawnGenericLoot( shardType, newOrigin, <-1, -1, -1>, count )
			if ( IsValid( trace.hitEnt ) && trace.hitEnt.HasPusherAncestor() )
				shard.SetParent( trace.hitEnt, "", true, 0 )
			return
		}

		tries++

		angle = (angle + RandomFloatRange( 10, 20 )) % 360

		// DebugDrawLine( startPos, endPos, 0, 0, 255, true, 1.0 )

		if ( triesForPitch < maxTriesForPitch && tries >= maxTriesForYaw )
		{
			tries = 0
			triesForPitch++
			pitch += 10.0
		}

		wait RandomFloatRange( 0, 1 )
	}

	Warning( "WARNING: loot spot at " + origin + " didn't spawn enough shard: couldn't find a spot.  Please give it more breathing room." )
}

entity function SpawnGenericLoot( string ref, vector origin, vector overrideAngles = < -1, -1, -1>, int clipCount = 1, int collisionGroup = TRACE_COLLISION_GROUP_NONE, bool onlySetModsForLockedAttachPoints = false, int stockpileCount = 0 )
{
	if( SURVIVAL_Loot_IsReforBaseWeaponDisabled( ref ) )
	{
		Warning( "SpawnGenericLoot - Attempting to spawn disabled item: %s", ref )
		// Allow item to spawn with just the warning for now
		//return null
	}

	vector angles
	if ( overrideAngles != < -1, -1, -1> )
		angles = overrideAngles
	else
		angles = <0, RandomFloatRange( 0, 360 ), 0>

	LootData lootData = SURVIVAL_Loot_GetLootDataByRef( ref )

                   
                                                           
                                                                     
  
                   
                                                  
  
       

	entity ent = CreateEntity( "prop_survival" )
	ent.kv.CollisionGroup = collisionGroup
	Assert( lootData.model != $"" )
	ent.SetValueForModelKey( lootData.model )
	ent.kv.fadedist = 6000
	ent.kv.renderamt = 255
	ent.kv.rendercolor = "255 255 255"
	ent.kv.solid = 0 // 0 = no collision, 2 = bounding box, 6 = use vPhysics, 8 = hitboxes only
	ent.SetOrigin( origin )
	ent.SetAngles( angles )

	ent.SetSurvivalInt( SURVIVAL_Loot_GetLootDataTable()[ref].index )
	DispatchSpawn( ent )

	MarkEntForCleanupOnRoundEnd( ent )

	int skinOverride = lootData.skinOverride
	if ( skinOverride > 0 )
		ent.SetSkin( skinOverride )

	int lootType = lootData.lootType

	SetForceDrawWhileParented( ent, true )
	//ent.SetSurvivalPropFadeDist( GetFadeDistForLoot( lootData ) ) // S3: not available
	ent.kv.fadedist = GetFadeDistForLoot( lootData )

	ent.SetUsable()
	ent.SetUsableByGroup( "pilot" )
	ent.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )

	ent.SetClipCount( clipCount )

	ent.e.lootRef = ref

	if ( lootType == eLootType.MAINWEAPON )
	{
		string baseWeapon = lootData.baseWeapon
		ent.SetWeaponName( baseWeapon )

		array<string> mods = []
		mods.extend( SURVIVAL_Weapon_GetBaseMods( ref ) )

		if ( onlySetModsForLockedAttachPoints )
		{
			for ( int i = mods.len() - 1; i >= 0; i-- )
			{
				if ( SURVIVAL_Loot_IsRefValid( mods[i] ) && (SURVIVAL_Loot_GetLootDataByRef( mods[i] ).lootType == eLootType.ATTACHMENT) )
				{
					string attachPoint = GetAttachPointForAttachmentOnWeapon( baseWeapon, mods[i] )
					if ( !SURVIVAL_IsAttachmentPointLocked( lootData.ref, attachPoint ) )
						mods.remove( i )
				}
			}
		}

		ent.SetWeaponMods( mods )
		// TEMP HACK
		//okay then, let's un-hack it? - johodgson
		if ( !GetWeaponInfoFileKeyField_GlobalBool( baseWeapon, "uses_ammo_pool" ) )
		{
			ent.SetClipCount( GetWeaponInfoFileKeyField_GlobalInt( baseWeapon, "ammo_default_total" ) )

			int ammoToStore = GetWeaponInfoFileKeyField_GlobalInt( baseWeapon, "ammo_clip_size" )

			if ( clipCount == 0 )
				ent.SetClipCount( 0 )

			file.specialAmmoCounts[ ent ] <- ammoToStore
		}
		else
		{
			if ( WeaponsSpawnWithAmmo() )
				ent.SetClipCount( -1 )
			else
				ent.SetClipCount( 0 )
		}

		ShowDefaultBodygroupsOnFakeWeapon( ent, baseWeapon )
	}

	if ( lootType == eLootType.ARMOR )
	{
		int shieldHealth = SURVIVAL_GetArmorShieldCapacity( lootData.tier )
		SetPropSurvivalMainPropertyOnEnt( ent, shieldHealth )
	}

	if ( lootType == eLootType.ARMOR && EvolvingArmor_IsEquipmentEvolvingArmor( lootData.ref ) )
	{
		ent.kv.fadedist = 15000.0  // S3: SetSurvivalPropFadeDist not available
		SetPropSurvivalMainPropertyOnEnt( ent, EvolvingArmor_GetEvolvingArmorHealthForTier( lootData.tier ) )
		SetPropSurvivalExtraPropertyOnEnt( ent, EvolvingArmor_GetRequirementForEvolution( lootData.tier ) )
	}

	                    
	if( lootType == eLootType.ARMOR && UpgradeCore_IsEquipmentArmorCore( lootData.ref ) && lootData.tier == 5 )
	{
		SetPropSurvivalMainPropertyOnEnt( ent, EvolvingArmor_GetEvolvingArmorHealthForTier( lootData.tier ) )
	}
       

                      
                         
   
                                            
   
       

	if ( GetCurrentPlaylistVarInt( "sur_dev_disable_hibernation", 0 ) == 1 )
	{
		ent.DisableHibernation()
	}

	ent.e.spawnTime = Time()
	SetItemSpawnSource( ent, eSpawnSource.GAME )

	foreach ( callbackFunc in file.Callbacks_OnLootSpawn )
		thread callbackFunc( ent, lootData, clipCount )

	return ent
}


string function GetRefOrRefFromGroup( string refOrGroup )
{
	if ( SURVIVAL_IsValidLootGroup( refOrGroup ) )
		return SURVIVAL_GetWeightedItemFromGroup( refOrGroup )
	return refOrGroup
}


void function GiveLoot( entity player, string refOrGroup, int countOverride = -1 )
{
	string ref = GetRefOrRefFromGroup( refOrGroup )
	if ( ref == "blank" )
		return

	int countNatural = SURVIVAL_Loot_GetLootDataByRef( ref ).countPerDrop
	int count        = ((countOverride >= 0) ? countOverride : countNatural)
	entity item      = SpawnGenericLoot( ref, player.GetOrigin() + <0, 0, 32>, <-1, -1, -1>, count )
	Survival_PickupItem( item, player, 0 )
}


