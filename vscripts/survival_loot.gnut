#if DEVELOPER
entity function DEV_SpawnDeathBoxWithRandomLoot( entity player )
{
	if ( !IsValid( player ) )
		player = GetPlayerArray()

	table<string, int> contents = {}

	array<LootData> lootFlavs = []
	foreach ( string ref, LootData lootFlav in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( ref != "blank" )
			lootFlavs.append( lootFlav )
	}

	int maxLootFlavs = 40			// Stops us from hitting limit on items parented to the deathbox
	int numFlavs = RandomInt( minint( lootFlavs.len(), maxLootFlavs) )
	lootFlavs.randomize()
	for ( int flavIdx = 0; flavIdx < numFlavs; flavIdx++ )
	{
		LootData lootFlav = lootFlavs[flavIdx]
		int count         = int(RandomFloat( 5.0 ) * lootFlav.inventorySlotCount)
		contents[lootFlav.ref] <- count
	}

	return DEV_SpawnDeathBox( player, contents )
}
#endif

#if DEVELOPER
entity function DEV_AddToDeathBox( entity deathBox, table<string, int> contents )
{
	if ( !IsValid( deathBox ) )
	{
		entity player   = GetPlayerArray()
		TraceResults tr = TraceLine( player.EyePosition(), player.EyePosition() + 1000.0 * player.GetViewForward(), [ player ] )
		deathBox = tr.hitEnt
	}
	if ( !IsValid( deathBox ) )
		return null

	deathBox.e.blockActive = true
	//foreach ( string lootRef in lootRefs )
	foreach ( string ref, int count in contents )
	{
		string lootRef = ""
		if ( SURVIVAL_Loot_IsRefValid( ref ) )
		{
			lootRef = ref
		}
		else
		{
			foreach ( string _, LootData lootFlavor in SURVIVAL_Loot_GetLootDataTable() )
			{
				if ( lootFlavor.ref == ref )
				{
					lootRef = ref
					break
				}
			}
			if ( lootRef == "" )
			{
				foreach ( string _, LootData lootFlavor in SURVIVAL_Loot_GetLootDataTable() )
				{
					if ( lootFlavor.ref.find( ref ) >= 0 )
					{
						if ( lootRef == "" )
							lootRef = lootFlavor.ref
						else
							Warning( "Multiple matches for \"%s\" (%s, %s)", ref, lootRef, lootFlavor.ref )
					}
				}
			}
		}
		if ( lootRef == "" )
		{
			Warning( "Couldn't match \"%s\"", ref )
			continue
		}

		int placedCount = 0
		while ( placedCount < count )
		{
			LootData lootFlavor = SURVIVAL_Loot_GetLootDataByRef( lootRef )
			int toPlace         = minint( lootFlavor.countPerDrop, count - placedCount )
			entity loot         = SpawnGenericLoot( lootRef, deathBox.GetOrigin(), < -1, -1, -1>, toPlace )
			AddToDeathBox( loot, deathBox )
			placedCount += toPlace
		}
	}
	deathBox.e.blockActive = false

	UpdateDeathBoxHighlight( deathBox, true )

	return deathBox
}
#endif


#if DEVELOPER
void function DEV_PrintDeathBoxContents( entity box )
{
	if ( !IsValid( box ) )
	{
		entity player   = GetPlayerArray()
		TraceResults tr = TraceLine( player.EyePosition(), player.EyePosition() + 1000.0 * player.GetViewForward(), [ player ] )
		box = tr.hitEnt
	}
	if ( !IsValid( box ) )
		return

	string str = ""
	foreach ( int lootEntIdx, entity lootEnt in box.GetLinkEntArray() )
	{
		if ( lootEnt.GetNetworkedClassName() != "prop_survival" )
			continue

		LootData lootFlavor = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )

		if ( lootEntIdx > 0 )
			str += ","
		int count = (lootFlavor.lootType == eLootType.MAINWEAPON ? 1 : lootEnt.GetClipCount())
		str += format( "%s=%d", lootFlavor.ref, count )
	}
	printt( str )
}

#endif


void function MaybeAddWeaponToLootBinOnOpen( entity lootBin, entity player )
{
	if ( !ShouldPlayerGetWeaponAssist( player, LootBin_GetLootRefs( lootBin, true, false ) ) )
		return

	if( lootBin.e.hasBeenOpened )
		return

	bool isRegularCompOpen    = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	if( isRegularCompOpen )
		return

	string lootGroup

	if( !Loot_LootBin_WeaponAssist_Always_Enabled() )
		lootGroup = GetCurrentPlaylistVarString( "maybe_add_weapon_to_loot_bin_on_open", "Weapon_UltraLow" ).tolower()
	else
		lootGroup = GetCurrentPlaylistVarString( "maybe_add_weapon_to_loot_bin_on_open", "Weapon_UltraLow" ).tolower() // set up an alternate logic path so we can give the weapon assist it's own loot group pull.

	string weaponRef = SURVIVAL_GetWeightedItemFromGroup( lootGroup )
	LootBin_PutLootItemInside( lootBin, eLootBinCompartment.REGULAR, weaponRef, 1 )

	printf( "MaybeAddWeaponToLootBinOnOpen: Added %s to loot bin for %s (%1.2fs since landing)", weaponRef, string(player), Survival_GetPlayerTimeOnGround( player ) )

	file.playersWhoGotWeaponAssist[player] <- IN_SET
}

              
                                                                    
 
                                                                           
  
                          

                                                                        

                                                               
                           
   
                                                            
   
  
 


                                                                                    
 

                                                                       
                                                
              

                                          
                                                                                      
                                   

                            
  
                                  

                                                                             
                                                                     
   
                              
                               
                                                     

                                   
    
                                                                                      
                                                       
    

                                           
    
                                          
    
   

                                                              
                                
   
                                                                          

                                                                                       
                                         
    
                                                         
     
                                             
      
                                                           
       
                   
       
      
     
    

                                                      
                                                   

                            
                                                           

                                                                                  
              
   
  
             
 

                                                                                    
 
                                                                        

                                       
  
                                       

                                                       
   
                                                        
                                                          
    
                                                 
          
    

                                                                                                

                        
    
                                                                                                
                                      

                               
     
                                                                                            
     
    
   
  
 
                   

bool function ShouldPlayerGetWeaponAssist( entity player, array<LootRef> lootAlreadyInBin )
{
	if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return false

	float weaponAssistDelay = GetCurrentPlaylistVarFloat( "lootbin_weapon_assist_delay", 8.0 )
	if ( weaponAssistDelay <= 0.0 )
		return false

	if ( SURVIVAL_GetPrimaryWeapons( player ).len() > 0 )
		return false

	if ( player in file.playersWhoGotWeaponAssist )
		return false

	if ( Survival_GetPlayerTimeOnGround( player ) < weaponAssistDelay )
	{
		if( !Loot_LootBin_WeaponAssist_Always_Enabled() )
			return false
	}

	foreach ( LootRef existingLoot in lootAlreadyInBin )
	{
		if ( existingLoot.lootData.lootType == eLootType.MAINWEAPON )
			return false
	}

	return true
}

int function WeaponAttachment_GetIndexByRef( string attachmentRef )
{
	var attachmentTable = GetDataTable( $"datatable/survival_weapon_mods.rpak" )
	Assert( attachmentTable )

	int refCol = GetDataTableColumnByName( attachmentTable, "mod" )
	int row = GetDataTableRowMatchingStringValue( attachmentTable, refCol, attachmentRef )

	int modelCol = GetDataTableColumnByName( attachmentTable, "modelAsset" )
	string modelAsset = GetDataTableString( attachmentTable, row, modelCol )

	if( modelAsset == "" )
		return -1

	return row
}

int function WeaponAttachment_GetAttachmentType( int row )
{
	if( row == -1 )
		return WAT_INVALID

	var attachmentTable = GetDataTable( $"datatable/survival_weapon_mods.rpak" )
	Assert( attachmentTable )

	int typeCol =  GetDataTableColumnByName( attachmentTable, "type" )
	string type = GetDataTableString( attachmentTable, row, typeCol )

	if( type in weaponAttachmentTypeMap )
		return weaponAttachmentTypeMap[type]

	return WAT_INVALID
}

void function WeaponAttachment_Init()
{
	PrecacheModel( $"mdl/weapons/attachments/attach_cq_hcog_classic_v.rmdl" )
	PrecacheModel( $"mdl/weapons/attachments/attach_cq_hcog_classic_w.rmdl" )
}

                   
void function LootBin_AddOldBinToPerkBinMapping( entity oldBin, entity newBin )
{
	file.oldBinToPerkBinMapping[oldBin] <- newBin
}
      

void function SURVIVAL_RefreshWeaponSkinAndModel( entity weapon, entity player )
{
	Assert( IsValid( weapon ) )

	// Refresh weapon view model body group
	if ( weapon.e.skinItemFlavorGUID != ASSET_SETTINGS_UNIQUE_ID_INVALID )
	{
		ItemFlavor ornull skinOrNull = GetItemFlavorByGUID( weapon.e.skinItemFlavorGUID )
		if ( skinOrNull != null )
		{
			ItemFlavor skin = expect ItemFlavor( skinOrNull )
			Assert( ItemFlavor_GetType( skin ) == eItemType.weapon_skin )
			WeaponCosmetics_ApplyModelAndSkin( weapon, skin )

                 
                                                        
     
                                                                                  
                                   
                                                              
     
         
		}
	}
}
