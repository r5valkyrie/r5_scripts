void function SURVIVAL_ChooseLootLocations()
{
	thread SURVIVAL_ChooseLootLocations_Internal()
}


void function SURVIVAL_ChooseLootLocations_Internal()
{
	if ( GetCurrentPlaylistVarBool( "survival_loot_enabled", true ) )
	{
		FlagWait( "PopulateSpecialZonesDone" )
		//FlagWait( "PlaneStartMoving" )

		int lootSpawnPerFrame = 22
		int currentLootSpawn  = 0

		float startTime = Time()

		table< entity, array< entity > > realmedBins

		int totalSpawnedLoot = 0

		foreach ( groupName, spawnPoints in file.groupedSpawnpoints )
		{
			if ( spawnPoints.len() > 0 )
				Assert ( SURVIVAL_Loot_IsRefValid( groupName ) )

			if ( GetBugReproNum() == 100 )
			{
				if ( SURVIVAL_Loot_IsRefValid( groupName ) )
					printt( " spawning " + spawnPoints.len() + " " + groupName )
			}

			totalSpawnedLoot += spawnPoints.len()

			int inBinCount = 0
			int onGroundCount = 0

			foreach ( BinOrSpawnPoint loc in spawnPoints )
			{
				                   
				if( loc.bin	in file.oldBinToPerkBinMapping )
				{
					loc.bin = file.oldBinToPerkBinMapping[loc.bin]
				}
          

				if ( IsValid( loc.bin ) )
				{
					inBinCount++
					array< entity > bins = [ loc.bin ]

					if ( !(loc.bin in realmedBins) )
					{
						for ( int i = 0; i < file.realmsToPopulate.len(); i++ )
						{
							entity bin
							if ( i < bins.len() )
							{
								bin = bins[i]
							}
							else
							{
								bin = CreateLootBin( loc.bin.GetOrigin(), loc.bin.GetAngles(), file.movingGeoLootLocations.contains( loc.pos ) )
								bins.append( bin )
							}

							bin.RemoveFromAllRealms()
							bin.AddToRealm( file.realmsToPopulate[ i ] )
						}

						realmedBins[ loc.bin ] <- bins
					}

					foreach ( bin in realmedBins[ loc.bin ] )
						LootBin_PutLootItemInside( bin, eLootBinCompartment.REGULAR, groupName, null )
				}
				else
				{
					onGroundCount++

					foreach ( realm in file.realmsToPopulate )
					{
						entity loot = SpawnLoot( groupName, loc.pos, file.movingGeoLootLocations.contains( loc.pos ) )
						if ( IsValid( loot ) )
						{
							loot.RemoveFromAllRealms()
							loot.AddToRealm( realm )
						}

						if ( ++currentLootSpawn > lootSpawnPerFrame )
						{
							WaitFrame()
							currentLootSpawn = 0
						}
					}
				}
			}

			if ( GetBugReproNum() == 104 )
			{
				if ( SURVIVAL_Loot_IsRefValid( groupName ) )
					printt( "  spawned " + string(inBinCount + onGroundCount) + " " + groupName + " (" + inBinCount + " in bins, " + onGroundCount + " on ground)" )
			}
		}

		printt( "----------------------" )
		printt( "Total Spawn Time: " + (Time() - startTime) )
		printt( "Total Spawned Loot: " + totalSpawnedLoot )
		#if DEVELOPER
			if ( GetBugReproNum() == 103 )
			{
				printt( "Total Spawn Point Considered Leftovers at some point: " + file.leftoverSpawnPointHistoryMap.len() )
				printt( "Total Leftover Spawn Point Ending Assigned weighted pick from final loot pool: " + file.startedAsLeftovers )
				printt( "Total Leftover Spawn Point Ending Assigned random pick from final loot pool: " + file.totalLeftovers )
				printt( "----------------------" )

				int index = 1
				foreach ( BinOrSpawnPoint loc, array < string> path in file.leftoverSpawnPointHistoryMap )
				{
					string output = "LEFTOVER #" + index
					for ( int i = 0; i < file.maxSpawnPointHistoryPath - 1; i++ )
					{
						output += ","
						if ( i < path.len() - 1 )
						{
							output += path[i]
						}
					}
					string finalRef = path[path.len() - 1]
					output += "," + ( ( SURVIVAL_Loot_IsRefValid ( finalRef ) || Crafting_GetDisabledGroundLoot().contains( finalRef ) ) ? "true" : "false" )
					printt( output )
					index ++
				}
			}
		#endif

		//SURVIVAL_DebugLootBins()
		foreach ( entity bin in GetAllLootBins() )
		{
			if ( LootBin_IsEmpty( bin ) )
			{
				bin.Destroy()
				continue
			}

			                       
			// the perk system has multiple bins with secret compartment loot that drive their contents themselves.
			// so if its enabled don't put loot into them and let the individual bins drive their secret compartment loot
                       
                                              
     
                                                                                                   
                                                                                                                   
                                                                                          
     
         
         
		}

		              
			SetupVaultPanels()
        
	}

	// A lot of logic relies on this flag. Even if we don't use survival loot we want this flag set
	FlagSet( "Survival_LootSpawned" )
}

void function SURVIVAL_PopulateSpecialZones()
{
	if ( ShouldProcessSpecialZones() )
	{
		if ( !IsTestMap() && !ShouldPreprocessData() && GetCurrentPlaylistVarBool( "maps_use_preprocessed_data", true ) )
		{
			Warning( "This level is not a test map, and so expects to have a survival preprocess file.  Please run \"Survival Loot Zone Preprocess\" in the DEV MENU." )
			Warning( "Or add RunMySurvivalPreprocess() to the map script file." )
		}

		thread PopulateSpecialZonesInternal()
	}
	else
	{
		thread PopulateSpecialZones_DistributeZones()
	}
}


bool function ShouldProcessSpecialZones()
{
	if ( GetCurrentPlaylistVarBool( "loot_preprocessing_should_be_skipped", false ) )
		return false

	return !file.levelHasPreprocessData || ShouldPreprocessData()
}


void function PopulateSpecialZonesInternal()
{
	if ( ShouldPreprocessData() )
	{
		thread PreprocessMessage()
	}

	PopulateSpecialZones_FillZones()

	if ( ShouldPreprocessData() )
	{
		ExportSurvivalScriptDataFileForMap()
		Dev_CommandLineRemoveParm( "-survival_preprocess" )
		LevelTransitionStruct tempTrans
		ChangeLevel( GetMapName(), tempTrans )
		return
	}

	thread PopulateSpecialZones_DistributeZones()
}


void function PopulateSpecialZones_FillZones()
{
	file.lootZones.sort( LootZoneSort )

	// take locations from default pool

	int maxComparePerFrame = 2300

	int numCompares = 0

	printt( "============== Filling Special Zones ==============" )

	foreach ( zone in file.lootZones )
	{
		if ( zone.zoneClass == file.defaultLevelZone )
			continue

		printt( "type: " + zone.zoneClass )
		printt( "priority: " + zone.priority )

		for ( int i = file.worldLootZone.spawnPoints.len() - 1; i >= 0; i-- )
		{
			if ( Distance2D( zone.origin, file.worldLootZone.spawnPoints[i].pos ) < zone.radius
			&& (!zone.useHeight || fabs( zone.origin.z - file.worldLootZone.spawnPoints[i].pos.z ) < zone.height) )
			{
				zone.spawnPoints.append( file.worldLootZone.spawnPoints[i] )
				file.worldLootZone.spawnPoints.remove( i )
			}

			numCompares++
			if ( numCompares >= maxComparePerFrame )
			{
				WaitFrame()
				numCompares = 0
			}
		}
	}

	printt( "============== Done Filling Special Zones ==============" )
}

table<string, int> s_extraSpawnsForType
//
void function Loot_SetExtraSpawnCountInDefaultZoneForLootType( string ref, int minCount )
{
	Assert( !(ref in s_extraSpawnsForType) )
	s_extraSpawnsForType[ref] <- minCount
}


bool function Loot_IsStandardSurvivalLootEnabled()
{
	return GetCurrentPlaylistVarBool( "loot_standard_survival_enabled", true )
}

bool function Loot_LootBin_WeaponAssist_Always_Enabled()
{
	return GetCurrentPlaylistVarBool( "lootbin_weapon_assist_always_enabled", true )
}

void function AddAnyExtraSpawnsInDefaultZone()
{
	string playlistSurvivalDisabledLootStr = GetPlaylistVarString( GetCurrentPlaylistName(), "survival_disabled_loot", "" )
	                    
	if( UpgradeCore_ArmorTiedToUpgrades() )
	{
		playlistSurvivalDisabledLootStr += " armor_pickup_lv0 armor_pickup_lv0_evolving armor_pickup_lv1 armor_pickup_lv1_evolving armor_pickup_lv2 armor_pickup_lv2_evolving armor_pickup_lv3 armor_pickup_lv3_evolving armor_pickup_lv4_exec_armor armor_pickup_lv4_all_fast"
	}
       

	string playlistSurvivalDisabledWeaponStr = GetPlaylistVarString( GetCurrentPlaylistName(), "survival_disabled_weapons", "" )
	playlistSurvivalDisabledWeaponStr += GetCurrentPlaylistVarString( "global_disabled_loot", "" )

	foreach ( data in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( !Loot_IsStandardSurvivalLootEnabled() )
			break
		if ( !(data.ref in s_extraSpawnsForType) )
			continue
		if ( SURVIVAL_Loot_IsRefDisabled( data.ref ) )
			continue
		if ( !IsLootTypeValid( data.lootType ) )
			continue
		if ( playlistSurvivalDisabledLootStr.find( data.ref ) >= 0 )
			continue
		if ( playlistSurvivalDisabledWeaponStr.find( data.ref ) >= 0 )
			continue

		int countLeft = s_extraSpawnsForType[data.ref]
		foreach ( int zoneIndex, zone in file.lootZones )
		{
			if ( zone.zoneClass != file.defaultLevelZone )
				continue
			if ( countLeft <= 0 )
				break

			array<BinOrSpawnPoint> spawns = zone.spawnPoints
			if ( spawns.len() == 0 )
				continue

			if ( IsLockedLootActive() )
				spawns.randomize() // S3: seeded shuffle not available for typed arrays
			else
				spawns.randomize()

			int numPlaced = 0
			for ( int idx = 0; ((idx < countLeft) && (spawns.len() > 0)); ++idx )
			{
				BinOrSpawnPoint loc = spawns.pop()
				file.groupedSpawnpoints[data.ref].append( loc )
                         
                                      
                               
				numPlaced++

				if ( IsValid( loc.bin ) )
					printf( "%s() - Forced '%s' item spawn into bin at %s.", FUNC_NAME(), data.ref, string( loc.bin.GetOrigin() ) )
				else
					printf( "%s() - Forced '%s' item spawn at %s.", FUNC_NAME(), data.ref, string( loc.pos ) )
			}

			countLeft = (countLeft - numPlaced)
		}
		printf( "%s() - Added %d/%d spawns for loot type '%s'.", FUNC_NAME(), (s_extraSpawnsForType[data.ref] - countLeft), s_extraSpawnsForType[data.ref], data.ref )
	}
}


void function PopulateSpecialZones_DistributeZones()
{
	if ( GetCurrentPlaylistVarBool( "survival_delete_random_loot_bins", false ) )
		DeleteRandomLootBins()

	CreateHotZones( false, false )

	#if DEVELOPER
		thread DebugLootZones()
	#endif

	//
	AddAnyExtraSpawnsInDefaultZone()

	#if DEVELOPER
		if ( GetBugReproNum() == 10 )
		{
			printt( "=============== ZONE COMPARISON ================" )

			table<string, int> counts
			table<string, int> binCounts

			foreach ( zone in file.lootZones )
			{
				array<BinOrSpawnPoint> spawnPoints = zone.spawnPoints
				array<entity> bins                 = []

				if ( !(zone.zoneClass in binCounts) )
				{
					binCounts[ zone.zoneClass ] <- 0
				}

				if ( !(zone.zoneClass in counts) )
				{
					counts[ zone.zoneClass ] <- 0
				}

				foreach ( pt in spawnPoints )
				{
					if ( pt.bin == null )
					{
						counts[ zone.zoneClass ] += 1
					}
					else if ( !bins.contains( pt.bin ) )
					{
						bins.append( pt.bin )
						binCounts[ zone.zoneClass ] += 1
					}
				}
			}

			foreach ( zName, count in counts )
			{
				printt( zName )
				printt( "nodes " + count )
				printt( "bins " + binCounts[ zName ] )
				printt( "=" )
			}
			printt( "=============== END ZONE COMPARISON ================" )
		}
	#endif

	if ( IsLootRoundBased() )
	{
		if ( !IsRoundBased() || GetRoundsPlayed() > 0 )
		{
			DeepCopyLootZoneBackupDataToArrayAndRestoreBins( file.lootZones, file.lootZonesBackup )
		}
	}

	if ( file.lootPreDistributeCallback != null )
		file.lootPreDistributeCallback( file.lootZones )

	if ( GetCurrentPlaylistVarInt( "sur_loot_spawn_only_in_start_deathfield_stage", 0 ) == 1 )
	{
		FlagWait( "DoneCreatingDeathFieldPosition" )
		FlagWait( "DeathFieldCalculationComplete" )
		vector center   = SURVIVAL_GetDeathFieldCenter( Survival_Loot_GetDefaultRealm() )
		float radius    = SURVIVAL_GetDeathFieldCurrentRadius( Survival_Loot_GetDefaultRealm() )
		float radiusSqr = radius * radius

		foreach ( zone in file.lootZones )
		{
			array< BinOrSpawnPoint > spawnPoints = zone.spawnPoints
			array< BinOrSpawnPoint > culledSpawnPoints
			foreach ( BinOrSpawnPoint spawnPoint in spawnPoints )
			{
				if ( Distance2DSqr( spawnPoint.pos, center ) < radiusSqr )
					culledSpawnPoints.append( spawnPoint )
			}
			zone.spawnPoints = culledSpawnPoints
		}
	}

	if ( !Loot_IsStandardSurvivalLootEnabled() )
	{
		foreach ( zone in file.lootZones )
		{
			zone.spawnPoints.clear()
		}
	}

	const int DEFAULT_MAX_ITEMS_PER_LOOTBIN = 99
	float chancePerGroundItem = Clamp( GetCurrentPlaylistVarFloat( "loot_spawns_chance_for_ground_items", 1.0 ), 0.0, 1.0 )
	float chancePerLootBin    = Clamp( GetCurrentPlaylistVarFloat( "loot_spawns_chance_for_loot_bins", 1.0 ), 0.0, 1.0 )
	int maxItemsPerLootBin    = ClampInt( GetCurrentPlaylistVarInt( "loot_spawns_max_per_loot_bin", DEFAULT_MAX_ITEMS_PER_LOOTBIN ), 0, 99 )
	if ( (chancePerGroundItem < 0.999) || (chancePerLootBin < 0.999) || (maxItemsPerLootBin < DEFAULT_MAX_ITEMS_PER_LOOTBIN) )
	{
		foreach ( zone in file.lootZones )
		{
			array<BinOrSpawnPoint> groundPoints
			table<entity, array<BinOrSpawnPoint> > binMap

			//
			foreach ( sp in zone.spawnPoints )
			{
				if ( IsValid( sp.bin ) )
				{
					if ( !(sp.bin in binMap) )
						binMap[sp.bin] <- []
					binMap[sp.bin].append( sp )
				}
				else
				{
					groundPoints.append( sp )
				}
			}

			//
			zone.spawnPoints.clear()

			//
			if ( chancePerGroundItem > 0.999 )
			{
				zone.spawnPoints.extend( groundPoints )
			}
			else if ( chancePerGroundItem <= 0.0 )
			{
				// nothing
			}
			else
			{
				foreach ( gp in groundPoints )
				{
					if ( RandomFloatForLoot( 1.0 ) <= chancePerGroundItem )
					{
						zone.spawnPoints.append( gp )
					}
				}
			}

			//
			foreach ( bin, arr in binMap )
			{
				if ( (chancePerLootBin < 1.0) && (RandomFloatForLoot( 1.0 ) > chancePerLootBin) )
					continue

				if ( arr.len() > maxItemsPerLootBin )
				{
					if ( IsLockedLootActive() )
						arr.randomize() // S3: seeded shuffle not available for typed arrays
					else
						arr.randomize()

					arr.resize( maxItemsPerLootBin )
				}
				zone.spawnPoints.extend( arr )
			}
		}
	}

	// split each zone's spawn points into groups
	for ( int i = 0; i < file.lootZones.len(); i++ )
	{
		LootZone zone = file.lootZones[i]
		if ( zone.spawnPoints.len() <= 0 )
			continue

		array<BinOrSpawnPoint> spawnPoints = zone.spawnPoints
                       
                                        

                                                   
    
                                                                     
    
                             
		BreakGroupIntoSmallerGroup( zone.zoneClass, spawnPoints )
	}

	bool hasInvalidEntries = true
	while ( hasInvalidEntries )
	{
		hasInvalidEntries = false

		foreach ( groupName, spawnPoints in file.groupedSpawnpoints )
		{
			if ( spawnPoints.len() == 0 )
				continue

			if ( SURVIVAL_Loot_IsRefValid( groupName ) )
				continue

			BreakGroupIntoSmallerGroup( groupName, spawnPoints )
			hasInvalidEntries = true
		}
	}

	FlagSet( "PopulateSpecialZonesDone" )
}


void function DeepCopyLootZoneBackupDataToArrayAndRestoreBins( array< LootZone > newLootZoneArray, array< LootZoneBackupData > lootZoneBackupToCopy )
{
	int numZones = lootZoneBackupToCopy.len()
	newLootZoneArray.clear()

	for ( int i; i < numZones; i++ )
	{
		LootZone newData
		LootZoneBackupData dataToCopy = lootZoneBackupToCopy[ i ]

		// Generic zone data
		newData.zoneClass = dataToCopy.zone.zoneClass
		newData.radius = dataToCopy.zone.radius
		newData.origin = dataToCopy.zone.origin
		newData.height = dataToCopy.zone.height
		newData.priority = dataToCopy.zone.priority
		newData.useHeight = dataToCopy.zone.useHeight

		// Copy spawn points
		int numSpawnPoints                        = lootZoneBackupToCopy[ i ].zone.spawnPoints.len()
		array<BinOrSpawnPoint> zoneSpawnPoints    = lootZoneBackupToCopy[ i ].zone.spawnPoints
		array<BinOrSpawnPoint> newSpawnPointArray = newData.spawnPoints
		for ( int j; j < numSpawnPoints; j++ )
		{
			BinOrSpawnPoint newBinData
			BinOrSpawnPoint backupBinData = zoneSpawnPoints[ j ]
			newBinData.bin = backupBinData.bin
			newBinData.pos = backupBinData.pos
			//newBinData.bin_isSecret = newBinData.bin_isSecret
			newSpawnPointArray.append( newBinData )
		}

		// Copy bins
		int numBins                           = lootZoneBackupToCopy[ i ].bins.len()
		array< LootBinBackupData > backupBins = lootZoneBackupToCopy[ i ].bins
		for ( int j; j < numBins; j++ )
		{
			SURVIVALPreProcess_CreateLootBinAndLocations( newData, backupBins[ j ].origin, backupBins[ j ].angles, backupBins[ j ].onMovingGeo )
		}

		newLootZoneArray.append( newData )
	}
}


void function BreakGroupIntoSmallerGroup( string groupName, array<BinOrSpawnPoint> spawnPoints )
{
	string groupToUse = CheckLootGroupRemapping( groupName )

	if ( SURVIVAL_Loot_IsRefValid( groupToUse ) )
	{
		for ( int i = 0; i < spawnPoints.len(); i++ )
		{
			BinOrSpawnPoint loc = spawnPoints[i]
			file.groupedSpawnpoints[ groupToUse ].append( loc )
		}
		spawnPoints.clear()
		return
	}

	LootGroup groupData = file.lootGroups[ groupToUse ]

	//printt( "============== New Zone " + groupName + " =============="  )

	int totalSpawns              = spawnPoints.len()
	float totalDistribution      = groupData.totalDistribution
	float distributionMultiplier = float( totalSpawns ) / totalDistribution

	//printt( "Number of spawn points: " +  spawnPoints.len() )
	//printt( "Distribution multiplier: " + distributionMultiplier )

	if ( IsLockedLootActive() )
		spawnPoints.randomize() // S3: seeded shuffle not available for typed arrays
	else
		spawnPoints.randomize()

	array<string> groupsUsed

	// Prioritize putting blanks into non-bins
	array<string> despawnTypes = clone Crafting_GetDisabledGroundLoot()
	despawnTypes.append( "blank" )

	table< string, int > numDespawnsLeftPerType

	foreach( despawnType in despawnTypes )
	{
		if ( despawnType in groupData.entries )
		{
			float distribution = groupData.entries[ despawnType ]

			float modifiedDistribution = distributionMultiplier * distribution
			int numSlots               = int( modifiedDistribution )

			numDespawnsLeftPerType[ despawnType ] <- numSlots

			for ( int i = 0; i < totalSpawns && numDespawnsLeftPerType[ despawnType ] > 0; i++ )
			{
				BinOrSpawnPoint loc = spawnPoints.remove( 0 )
				if ( loc.bin == null )
				{
					file.groupedSpawnpoints[ "blank" ].append( loc )
					numDespawnsLeftPerType[ despawnType ]--
				}
				else
				{
					spawnPoints.insert( spawnPoints.len(), loc )
				}
			}
		}
	}


	// try to distribute leftover blanks to seperate loot bins so they don't stack onto 1 which ends up deleting that one

	foreach( despawnType, numDespawnsLeft in numDespawnsLeftPerType )
	{
		int trueNumLeft = numDespawnsLeft
		while ( trueNumLeft > 0 )
		{
			array<entity> usedBins
			if ( IsLockedLootActive() )
				spawnPoints.randomize() // S3: seeded shuffle not available for typed arrays
			else
				spawnPoints.randomize()

			int numPoints = spawnPoints.len()
			for ( int i = 0; i < numPoints && trueNumLeft > 0; i++ )
			{
				BinOrSpawnPoint loc = spawnPoints.remove( 0 )
				if ( loc.bin != null && !usedBins.contains( loc.bin ) )
				{
					file.groupedSpawnpoints[ "blank" ].append( loc )
						trueNumLeft--
					usedBins.append( loc.bin )
				}
				else
				{
					spawnPoints.insert( spawnPoints.len(), loc )
				}
			}
		}

		numDespawnsLeftPerType[ despawnType ] = trueNumLeft
	}

	// Re-randomize since previous steps can create long strings of bins at the end of the array
	if ( IsLockedLootActive() )
		spawnPoints.randomize() // S3: seeded shuffle not available for typed arrays
	else
		spawnPoints.randomize()

	// actually add the spawnpoints to the list grouped by item type
	foreach ( group, distribution in groupData.entries )
	{
		if ( distribution <= 0 )
			continue

		float modifiedDistribution = distributionMultiplier * distribution
		int numSlots               = int( modifiedDistribution )
		int mult                   = int( ceil( modifiedDistribution - numSlots ) )

		//printt( group + " extra - " + mult )
		string overrideGroup = CheckLootGroupRemapping( group )

		for ( int i = 0; i < mult; i++ )
			groupsUsed.append( overrideGroup )

		if ( numSlots <= 0 )
			continue

		if ( despawnTypes.contains( overrideGroup ) )
		{
			numSlots = numDespawnsLeftPerType[ overrideGroup ]
			if ( numSlots <= 0 )
				continue
		}

		for ( int i = 0; i < numSlots; i++ )
		{
			BinOrSpawnPoint loc = spawnPoints.remove( 0 )

			#if DEVELOPER
			if ( loc in file.leftoverSpawnPointHistoryMap)
				file.leftoverSpawnPointHistoryMap[loc].append( overrideGroup )
			#endif

			if ( despawnTypes.contains( overrideGroup ) )
			{
				if ( GetBugReproNum() == 104 )
				{
					string type = IsValid( loc.bin ) ? "bin" : "ground"
					printt( groupName + ": Appending despawned " + type + " loot, new group is blank" )
				}

				file.groupedSpawnpoints[ "blank" ].append( loc )
			}
			else
			{
				if ( GetBugReproNum() == 104 )
				{
					string type = IsValid( loc.bin ) ? "bin" : "ground"
					printt( groupName + ": Appending " + type + " loot, new group is " + overrideGroup )
				}
				file.groupedSpawnpoints[ overrideGroup ].append( loc )
			}
			#if DEVELOPER
				if ( loc in file.leftoverSpawnPointHistoryMap && ( SURVIVAL_Loot_IsRefValid ( overrideGroup ) || despawnTypes.contains( overrideGroup ) ) )
				{
					file.startedAsLeftovers ++
					file.maxSpawnPointHistoryPath = maxint(file.leftoverSpawnPointHistoryMap[loc].len(), file.maxSpawnPointHistoryPath)
				}
			#endif
		}
	}

	int leftover = spawnPoints.len()

	array<string> leftOverRefs

	if ( leftover > 0 )
	{
		#if DEVELOPER
		// these don't work unless you remove the InitLabels in sh_init becuase of sequencing
		PerfStart( PerfIndexServer.LeftoverLootWeightingFix )
		#endif
		//file.totalLeftovers += leftover

		// specific fix for explosive hold attachments, delaying the larger fix for a later patch
		if ( groupName == "explosive_hold_attachments" )
		{
			SURVIVAL_AssignWeightedItemsForZoneLeftovers ( groupToUse, leftover, spawnPoints, despawnTypes )
		}
                                     
                           
                                                                            
   
                                                                                                   
   
		     
		// use old system for dealing with leftovers for now
		else
		{
			if ( groupName == "explosive_hold_attachments" )
			{
				printt ( "Error: trying to use the old leftover system for explosive_hold_attachments" )
			}
			for ( int i = 0; i < leftover; i++ )
			{
				if ( leftOverRefs.len() == 0 )
				{
					leftOverRefs = clone groupsUsed
					if ( IsLockedLootActive() )
						leftOverRefs.randomize() // S3: seeded shuffle not available for typed arrays
					else
						leftOverRefs.randomize()
				}

				string group         = leftOverRefs.remove( 0 )
				string overrideGroup = CheckLootGroupRemapping( group )
				BinOrSpawnPoint loc  = spawnPoints.remove( 0 )
				#if DEVELOPER
				if ( !(loc in file.leftoverSpawnPointHistoryMap) )
					file.leftoverSpawnPointHistoryMap[loc] <- [groupName, overrideGroup]
				else
					file.leftoverSpawnPointHistoryMap[loc].append(overrideGroup)
				#endif

				if ( despawnTypes.contains( overrideGroup ) )
					file.groupedSpawnpoints[ "blank" ].append( loc )
				else
					file.groupedSpawnpoints[ overrideGroup ].append( loc )

				#if DEVELOPER
				if ( ( SURVIVAL_Loot_IsRefValid ( overrideGroup ) || despawnTypes.contains( overrideGroup ) ) )
				{
					file.totalLeftovers ++
					file.maxSpawnPointHistoryPath = maxint(file.leftoverSpawnPointHistoryMap[loc].len(), file.maxSpawnPointHistoryPath)
				}

				#endif
			}
		}
        
		#if DEVELOPER
		PerfEnd ( PerfIndexServer.LeftoverLootWeightingFix )
		#endif
	}
}


void function SurvivalLoot_OnConnected( entity player )
{
	file.lastOrdnanceHeld[ player ] <- ""
}


void function SurvivalLoot_OnPlayerRespawned( entity player )
{
	if ( file.activeHotZones.len() > 0 && IsValid( player ) )
	{
		for ( int i = 0; i < file.activeHotZones.len(); ++i )
		{
			if ( IsValid( file.activeHotZones[i].minimapEnt ) )
			{
				file.activeHotZones[i].minimapEnt.Minimap_AlwaysShow( 0, player )
			}
		}
	}
}


void function SurvivalDeathFieldStageChanged( int stage, float nextCircleStartTime )
{
	if ( stage == 0 )
		thread SurvivalDeathField_ChangeToStageZero( stage, nextCircleStartTime )
}


void function SurvivalDeathField_ChangeToStageZero( int stage, float nextCircleStartTime )
{
	wait GetCurrentPlaylistVarFloat( "loot_hotzone_highlight_duration", 0 )

	SURVIVAL_StopDisplayingHotzones()
}


void function SURVIVAL_StopDisplayingHotzones()
{
	for ( int i = 0; i < file.activeHotZones.len(); ++i )
	{
		ActiveHotZone activeHotZone = file.activeHotZones[i]
		if ( IsValid( activeHotZone.minimapEnt ) )
			activeHotZone.minimapEnt.Destroy()

		if ( IsValid( activeHotZone.effectHandle ) )
		{
			EffectStop( activeHotZone.effectHandle )
			activeHotZone.effectHandle.Destroy()
		}
	}
}

#if DEVELOPER
void function DebugLootZones()
{
	if ( GetBugReproNum() != 99 )
		return

	array<LootZone> zoneCopy

	foreach ( zone in file.lootZones )
	{
		LootZone z = clone zone
		z.spawnPoints = []
		foreach ( p in zone.spawnPoints )
		{
			BinOrSpawnPoint b = clone p
			z.spawnPoints.append( b )
		}

		zoneCopy.append( z )
	}

	FlagWait( "EntitiesDidLoad" )

	while ( GetPlayerArray() == null )
		WaitFrame()

	GetPlayerArray().EndSignal( "OnDestroy" )

	while ( GetBugReproNum() == 99 )
	{
		while( !GetPlayerArray().IsInputCommandHeld( IN_USE_LONG ) )
			WaitFrame()

		foreach ( zone in zoneCopy )
		{
			foreach ( pt in zone.spawnPoints )
			{
				if ( Distance2D( GetPlayerArray().GetOrigin(), pt.pos ) > 300 )
					continue

				printt( zone.zoneClass )
				DebugDrawLine( pt.pos, pt.pos + <0, 0, 100>, 255, 255, 255, true, 8.0 )
				DebugDrawText( pt.pos, zone.zoneClass, true, 8.0 )
			}
		}

		wait 0.5

		while( GetPlayerArray().IsInputCommandHeld( IN_USE_LONG ) )
			WaitFrame()
	}
}

