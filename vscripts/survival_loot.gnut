void function Survival_ArmorPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	entity tacticalAbility = player.GetOffhandWeapon( OFFHAND_LEFT )
	entity ultimateAbility = player.GetOffhandWeapon( OFFHAND_INVENTORY )

	// TODO: make this handle stacking
	if ( IsValid( tacticalAbility ) && (passive == ePassives.PAS_REDUCED_COOLDOWN_TAC || passive == ePassives.PAS_REDUCED_COOLDOWNS_TAC_ULT) )
	{
		string tacName               = tacticalAbility.GetWeaponClassName()
		array<string> currentTacMods = tacticalAbility.GetMods()

		array<string> possibleTacMods = GetWeaponMods_Global( tacName )
		Assert( possibleTacMods.contains( "survival_armor_cooldown_mod" ), "Tactical Ability (" + tacName + ") is missing mod 'survival_armor_cooldown_mod' required by armor loot!" )

		if ( didHave )
		{
			if ( currentTacMods.contains( "survival_armor_cooldown_mod" ) )
			{
				tacticalAbility.RemoveMod( "survival_armor_cooldown_mod" )
			}
			else if ( currentTacMods.contains( "survival_armor_cooldown_extra_mod" ) )
			{
				tacticalAbility.RemoveMod( "survival_armor_cooldown_extra_mod" )
				tacticalAbility.AddMod( "survival_armor_cooldown_mod" )
			}
		}
		if ( nowHas )
		{
			if ( !currentTacMods.contains( "survival_armor_cooldown_mod" ) )
			{
				tacticalAbility.AddMod( "survival_armor_cooldown_mod" )
			}
			else if ( !currentTacMods.contains( "survival_armor_cooldown_extra_mod" ) )
			{
				tacticalAbility.RemoveMod( "survival_armor_cooldown_mod" )
				tacticalAbility.AddMod( "survival_armor_cooldown_extra_mod" )
			}
		}
	}

	if ( IsValid( ultimateAbility ) && (passive == ePassives.PAS_REDUCED_COOLDOWN_ULT || passive == ePassives.PAS_REDUCED_COOLDOWNS_TAC_ULT) )
	{
		string ultName               = ultimateAbility.GetWeaponClassName()
		array<string> currentUltMods = ultimateAbility.GetMods()

		array<string> possibleUltMods = GetWeaponMods_Global( ultName )
		Assert( possibleUltMods.contains( "survival_armor_cooldown_mod" ), "Ultimate Ability (" + ultName + ") is missing mod 'survival_armor_cooldown_mod' required by armor loot!" )

		if ( didHave )
		{
			if ( currentUltMods.contains( "survival_armor_cooldown_mod" ) )
			{
				ultimateAbility.RemoveMod( "survival_armor_cooldown_mod" )
			}
			else if ( currentUltMods.contains( "survival_armor_cooldown_extra_mod" ) )
			{
				ultimateAbility.RemoveMod( "survival_armor_cooldown_extra_mod" )
				ultimateAbility.AddMod( "survival_armor_cooldown_mod" )
			}
		}

		if ( nowHas )
		{
			if ( !currentUltMods.contains( "survival_armor_cooldown_mod" ) )
			{
				ultimateAbility.AddMod( "survival_armor_cooldown_mod" )
			}
			else if ( !currentUltMods.contains( "survival_armor_cooldown_extra_mod" ) )
			{
				ultimateAbility.RemoveMod( "survival_armor_cooldown_mod" )
				ultimateAbility.AddMod( "survival_armor_cooldown_extra_mod" )
			}
		}
	}
}


