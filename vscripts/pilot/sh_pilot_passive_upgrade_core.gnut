RingDropData function SetupPotentialAirdropLocations()
{
	array<vector> potentialSpots = NavMesh_SearchForOpenAreas( HULL_HUMAN,
		tunings.harvester_idealTileArea,
		tunings.harvester_minTileSize,
		tunings.harvester_minSurroundingArea,
		tunings.harvester_maxSurroundingArea,
		tunings.harvester_maxPathCost,
		tunings.harvester_minNumAdjacentTiles
	)

	if ( tunings.harvester_useBadAreaAvoidanceRadius )
	{
		array< vector > avoidPositions = EvoHarvesters_GetAvoidancePointsForPlacement()

		for ( int i = potentialSpots.len() - 1; i >= 0; i-- )
		{
			bool isInvalidatedByAvoidanceAreas = false

			vector consideredPos = potentialSpots[i]

			foreach ( badPos in avoidPositions )
			{
				float dist = Distance2D( badPos, consideredPos )

				if ( dist < tunings.harvester_badAreaAvoidanceRadius )
				{
					printf( "EVO HARVESTER SPAWN INVALIDATED BY AVOIDANCE AREA: " + consideredPos )
					isInvalidatedByAvoidanceAreas = true
					break
				}
			}

			if ( isInvalidatedByAvoidanceAreas )
			{
				potentialSpots.remove( i )
			}
		}
	}

	if ( tunings.harvester_useSafeDistFromRing >= 0.0 )
	{
		int defaultRealm = Survival_Loot_GetDefaultRealm()

		for ( int i = potentialSpots.len() - 1; i >= 0; i-- )
		{
			bool inSafeZone = SURVIVAL_PosInSafeZone( defaultRealm, potentialSpots[ i ], tunings.harvester_useSafeDistFromRing )
			if ( inSafeZone )
			{
				continue
			}

			#if DEVELOPER
			printf( "EVO HARVESTER SPAWN INVALIDATED BY SAFE DIST CHECK: " + potentialSpots[ i ] )
			#endif

			potentialSpots.remove( i )
		}
	}

	RingDropData data
	data.potentialDropLocations = clone(potentialSpots)
	data.spawnCount = tunings.numEvoHarvestersToSpawn

 	float baseAngle = RandomFloatForLoot( 360.0 )
	float angleAdjust = 360.0 / float( data.spawnCount )

	data.assignedMaxAngles = angleAdjust / 2

	for ( int i = 0; i < data.spawnCount; i++ )
	{
		data.assignedAngles.append( (baseAngle + (angleAdjust * i))%360 )
	}

	return data
}

void function SpawnUpgradeConsoleForIndex_Thread( int index, RingDropData data )
{
	Assert( IsNewThread() )

	float baseAngle = data.assignedAngles[index]
	vector mapCenter = SURVIVAL_GetMapCenter()

	int ringSpacingTries = 0

	float minSeperationDistance   = tunings.harvesterSpawnInitialSeperationDistance
	vector initialAngleDir        = AnglesToForward( <0, baseAngle % 360, 0> )
	float angleDeviation          = tunings.harvesterSpawnInitialAngleDeviation
	float angleDeviationIncrement = ( data.assignedMaxAngles - tunings.harvesterSpawnInitialAngleDeviation ) / 5
	float angleDeviationCos       = deg_cos( data.assignedMaxAngles)

	float minScale       = tunings.harvesterSpawnInitialMinScale
	float minScaleIncrement = tunings.harvesterSpawnInitialMinScale / tunings.harvesterSpawnNumRetries
	float maxScale		 = tunings.harvesterSpawnInitialMaxScale
	float absMaxScale 	 = 1.0
	float maxScaleIncrement = (absMaxScale - tunings.harvesterSpawnInitialMaxScale) / tunings.harvesterSpawnNumRetries

	const vector AIRDROP_MAXS = <25, 25, 128>
	const vector AIRDROP_MINS = <-25, -25, 0>

	array<vector> potentialDropLocationsWithinMaxAngle = clone(data.potentialDropLocations)
	vector chosenLocation = < 0,0,0 >
	if ( data.assignedMaxAngles < 360 )
	{
		float maxDir = deg_cos( data.assignedMaxAngles )
		for ( int i = potentialDropLocationsWithinMaxAngle.len() - 1; i >= 0; --i)
		{
			vector dropLocationToCenterNormalized = Normalize(FlattenVec( potentialDropLocationsWithinMaxAngle[i] - mapCenter ))

			float positionDir = DotProduct( initialAngleDir, dropLocationToCenterNormalized )

			if ( positionDir < maxDir )
			{
				potentialDropLocationsWithinMaxAngle.fastremove( i )
			}
		}
	}

	while ( true )
	{
		if ( potentialDropLocationsWithinMaxAngle.len() == 0 )
		{
			printf( "Evo Harvester - Unable to PickAirdropLocation." )
			chosenLocation = < 0,0,0 >
			return
		}

		WaitFrame()

		array<vector> dropLocationWithinTestZone
		//step 1, filter all positions

		float maxDist = -1
		for ( int i = potentialDropLocationsWithinMaxAngle.len() - 1; i >= 0; --i )
		{
			vector dropLocation = potentialDropLocationsWithinMaxAngle[i]

			vector flattenedVec = FlattenVec( dropLocation - mapCenter )
			float dist = Length( flattenedVec )
			maxDist = max( dist, maxDist )
			vector dropLocationToCenterNormalized = flattenedVec / dist

			float positionDir = DotProduct( initialAngleDir, dropLocationToCenterNormalized )

			if ( positionDir < angleDeviationCos )
			{
				continue
			}

			bool fail = false
			foreach ( point in file.previousDropLocations )
			{
				if ( Distance2DSqr( dropLocation, point ) < ( minSeperationDistance * minSeperationDistance ) )
				{
					fail = true
					break
				}
			}
			if ( fail )
				continue

			dropLocationWithinTestZone.append( dropLocation )
			potentialDropLocationsWithinMaxAngle.fastremove( i )
		}

		//step 2, increment search area
		{
			if ( ringSpacingTries < tunings.harvesterSpawnNumRetries )
			{
				ringSpacingTries++

				angleDeviation += angleDeviationIncrement

				minScale -= minScaleIncrement
				maxScale += maxScaleIncrement
			}
			else
			{
				//all positions are within the min distances from airdrops/spectre drops, so we're done
				return
			}

		}

		//step 3 pick 'ideal' airdrop spot and do final checks on it, retry until all positions are used
		bool foundSpot
		while ( dropLocationWithinTestZone.len() > 0 )
		{
			bool fail       = false

			vector startPos = GetRandomCenter( mapCenter, 0, maxDist, baseAngle - angleDeviation, baseAngle + angleDeviation )

			float closestSqrDist = FLT_MAX
			vector closestPoint
			int closestIndex     = 0
			int currentIndex     = 0

			foreach ( vector dropLocation in dropLocationWithinTestZone )
			{
				float dist = Distance2DSqr( startPos, dropLocation )
				if ( dist < closestSqrDist )
				{
					closestSqrDist = dist
					closestPoint   = dropLocation
					closestIndex   = currentIndex
				}
				currentIndex++
			}

			Assert( closestSqrDist != FLT_MAX, "Failed to find any location, which shouldn't happen")

			TraceResults results = TraceHull( closestPoint, closestPoint + <0, 0, 0 + 60000>, AIRDROP_MINS, AIRDROP_MAXS, null, TRACE_MASK_TITANSOLID, TRACE_COLLISION_GROUP_NONE )
			if ( !results.hitSky )
			{
				fail = true
			}

			if ( fail )
			{
				dropLocationWithinTestZone.fastremove( closestIndex )

				WaitFrame()
				continue
			}

			//FindDropAnglesForUnevenGround( vars )
			file.previousDropLocations.append( closestPoint )
			chosenLocation = closestPoint
			foundSpot = true
			break
		}
		if( foundSpot )
			break
	}
	UpgradeCore_SpawnUpgradeCoreConsole( chosenLocation )
}

void function UpgradeCore_SpawnConsoles()
{
	string mapName = GetMapName()

	if( !tunings.harvesters_enabled )
		return

	if( mapName.find( "mp_rr_box" ) >= 0 )
	{
#if DEVELOPER
		UpgradeCore_SpawnUpgradeCoreConsole( < -1249.258179, 1274.259399, 128.031250 > )
#endif
		return
	}

	                      
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
		return
       

	if( !GameMode_IsActive( eGameModes.SURVIVAL ) )
		return

	thread UpgradeCore_DynamicallySpawnUpgrades_Thread()
}

entity function UpgradeCore_SpawnUpgradeCoreConsole( vector position )
{
	entity console = CreateEntity( "prop_material_harvester" )
	console.SetScriptName( UPGRADE_CORE_CONSOLE_SCRIPT_NAME )

	//Using Navmesh to Find the exact point on the ground. With an offset factor to allow for changes in tolerances to the size of the harvester object and it's 3d anchor point.
	console.SetOrigin( NavMesh_GetClosestPoint( position ) + <0.0,0.0,tunings.harvesterSpawnVerticalOffset> )

	//Adding randomized angles to the harvester to prevent all harvesters having uniform placement.
	vector angleRandomized = <0, RandomFloatRange( 0.0, 360.0 ), 0>
	console.SetAngles( angleRandomized )

	if( UpgradeCore_UseUpdatedHarvesterModel() )
		console.SetModel( EVO_HARVESTER_MODEL )
	else
		console.SetModel( EVO_HARVESTER_MODEL_OLD )

	console.kv.solid = 6
	console.Solid()
	console.Hide()
	DispatchSpawn( console )

	vector forward    = console.GetForwardVector()
	vector up = console.GetUpVector()

	console.SetFadeDistance( 15000 )

	entity minimapEntity = CreatePropScript( $"mdl/dev/empty_model.rmdl", console.GetOrigin() )
	minimapEntity.SetAngles( <0, 0, 0> )
	minimapEntity.Minimap_SetCustomState( eMinimapObject_prop_script.UPGRADE_CORE_BIN )
	minimapEntity.Minimap_SetObjectScale( 1 )
	minimapEntity.SetParent( console )
	minimapEntity.Minimap_SetAlignUpright( true )
	minimapEntity.Minimap_SetZOrder( MINIMAP_Z_OBJECT )
	minimapEntity.DisableHibernation()
	console.LinkToEnt( minimapEntity )

	console.SetUsableByGroup( "pilot" )
	console.SetUsePrompts( "#LEGEND_UPGRADE_STATIONS_USE_PROMPT_PRESS" , "#LEGEND_UPGRADE_STATIONS_USE_PROMPT_PRESS" )
	AddCallback_OnUseEntity_ClientServer( console, OnUsed_UpgradeCoreConsole )


	ClearCallback_CanUseEntityCallback( console )
	SetCallback_CanUseEntityCallback( console, UpgradeCore_ConsoleCanUseFunction )
	console.AddUsableValue( USABLE_CUSTOM_HINTS )


	foreach( team in GetAllValidPlayerTeams() )
	{
		minimapEntity.Minimap_Hide( team, null )
	}

	file.evoHarvesters.append( console )
	file.evoHarvesterMinimapEnts.append( minimapEntity )

	return console
}

void function OnUsed_UpgradeCoreConsole( entity beacon, entity player, int useFlags )
{
	if( !UpgradeCore_CanUseConsole( player, beacon ) )
		return

	int team = player.GetTeam()
	beacon.SetUseStateByIndex( team, true )
	UpgradeCore_GrantTeamXp( player, tunings.evoHarvesterXp, eUpgradeXPActions.XPSTATION )
	entity minimapEnt = beacon.GetLinkEnt()
	if( IsValid( minimapEnt ) )
	{
		minimapEnt.Minimap_Hide( team, null )
	}

	array<entity> teammates = GetPlayerArrayOfTeam( player.GetTeam() )

	EmitSoundOnEntity( beacon, EVO_HARVESTER_COLLECT_3P ) // PLAYS 3P GLOBAL ON THE HARVESTER.

	foreach( entity teammate in teammates )
	{
		Remote_CallFunction_Replay( teammate, FUNCNAME_ServerToClient_UpgradeCore_Play1pEvoGainVfx, teammate )

		if( GetCurrentPlaylistVarBool( "upgrade_core_play_1pand3p_sfx_on_harvester_collect", false ) )
		{
			if( teammate == player )
			{
				EmitSoundOnEntityOnlyToPlayer( beacon, teammate, EVO_HARVESTER_COLLECT_1P )
			}
			else
			{
				EmitSoundOnEntityOnlyToPlayer( teammate, teammate, EVO_HARVESTER_COLLECT_TEAM )
			}
		}

		Remote_CallFunction_Replay( teammate, FUNCNAME_ServerToClient_UpgradeCore_ConsoleUsed, beacon )

		if ( teammate != player )
		{
			// The Thanks prompt is delayed so the material finder can mark more materials before possibly responding to teammates' thanks.
			if( IsAlive( teammate ) )
				thread DoDelayedThanks_Thread( teammate, player )
		}
	}

	//PIN_XP_Station_Used( player )

	//foreach( teamMember in teammates )
	//	PIN_XP_Station_Rewarded( teamMember )
}

void function DoDelayedThanks_Thread( entity player, entity playerToThank, float delay = 2.5 )
{
	wait delay
	if( IsValid( player ) )
		Remote_CallFunction_NonReplay( player, "ServerCallback_PromptSayThanks", playerToThank )
}

void function UpgradeCore_SetXP( entity player, int newXp )
{
	player.SetPlayerNetInt( UPGRADE_CORE_XP_NETINT, newXp )

#if AUTO_PLAYER
	AutoPlayer_UpgradeCoreXPChanged( player, newXp )
#endif
}

void function UpgradeCore_Redeem_XP_Cache( entity player, entity cacheEnt, int evoCacheType )
{
	int xpToAdd

	if( !IsValid( player ) || !player.IsPlayer() )
		return

	if( evoCacheType == eEvoCacheType.EVO_CACHE_DYNAMIC )
	{
		if( tunings.evoCacheUseDynamicAward )
		{

			xpToAdd = UpgradeCore_GetXPAmountToEvoPlayerToLevel( player, true )
			xpToAdd = maxint( tunings.xpCacheDynamicMinXp, xpToAdd )
		}
		else
		{
			xpToAdd = tunings.xpCacheDynamicMinXp
		}
	}

	if( evoCacheType == eEvoCacheType.EVO_CACHE_LARGE )
	{
		xpToAdd = tunings.xpCacheLargeXp
	}

	if( evoCacheType == eEvoCacheType.EVO_CACHE_SMALL )
	{
		xpToAdd = tunings.xpCacheSmallXp
	}

	Remote_CallFunction_Replay( player, FUNCNAME_ServerToClient_UpgradeCore_Play1pEvoGainVfx, player )

	UpgradeCore_IncrementXP( player, xpToAdd, false, eUpgradeXPActions.XPCACHE )
}

void function UpgradeCore_IncrementXP( entity player, int xpToAdd, bool teamAward = false, int actionID = -1, bool notifyPlayerWithPrompt = true, entity targetEntity = null )
{
	if( !UpgradeCore_IsEnabled() )
		return

	if( tunings.progressionLocked )
		return

	if ( !IsValid(player) || !player.IsPlayer() )
		return

	if( UpgradeCore_ProgressionLocked_ForPlayer_Get( player ) )
	{
		string scoreEventName = UpgradeCore_ActionToScoreEventString( actionID )
		if ( scoreEventName != "" )
		{
			AddPlayerScore( player, scoreEventName, targetEntity, "", xpToAdd, "", teamAward )
			UpgradeCore_RunCallbacks_OnPlayerIncrementXP( player, xpToAdd, teamAward )
		}
		return
	}

	if( !tunings.earnProgressWhileDead && !IsAlive( player ) )
		return

	if( xpToAdd <= 0 )
		return

                
                         
  
                                    
  
      

	int currentScore = player.GetPlayerNetInt( UPGRADE_CORE_XP_NETINT )

	int newScore = currentScore + xpToAdd

	int maxScore = tunings.xpLevelThresholds[tunings.xpLevelThresholds.len()-1]

	newScore = minint( newScore, maxScore )

	int prevLevel = UpgradeCore_GetPlayerLevel( player )

	if( !( player in file.playerToXpSourcesPerLevel ) )
		file.playerToXpSourcesPerLevel[player] <- []

	int maxXpGoingToThisLevel = INT_MAX
	array<int> xpRequirements = UpgradeCore_GetXpRequiredForNextLevel( player )
	if( xpRequirements.len() > 0 )
	{
		maxXpGoingToThisLevel = xpRequirements[1] - currentScore
	}
	int xpGoingToThisLevel = minint( maxXpGoingToThisLevel, xpToAdd )
	int xpGoingToNextLevel = xpToAdd - xpGoingToThisLevel
	UpgradeCore_AddXpSourceHistory( player, xpGoingToThisLevel, actionID, prevLevel )

	UpgradeCore_SetXP( player, newScore )

	if( UpgradeCore_UsePersonalObituaryNotifications() )
	{
		string scoreEventName = UpgradeCore_ActionToScoreEventString( actionID )
		if ( scoreEventName != "" )
		{
			AddPlayerScore( player, scoreEventName, targetEntity, "", xpToAdd, "", teamAward )
			UpgradeCore_RunCallbacks_OnPlayerIncrementXP( player, xpToAdd, teamAward )
		}
	}
	else if( notifyPlayerWithPrompt && xpToAdd > 0 )
	{
		Remote_CallFunction_Replay( player, FUNCNAME_ServerToClient_UpgradeCore_XPAwarded, actionID, xpToAdd, player, teamAward )
	}

	int newLevel = UpgradeCore_GetPlayerLevel( player )
	UpgradeCore_AddXpSourceHistory( player, xpGoingToNextLevel, actionID, newLevel )

	if( prevLevel != newLevel )
	{
		UpgradeCore_LevelUp( player )
	}
}

void function UpgradeCore_AddXpSourceHistory( entity player, int xp, int actionId, int level )
{
	array< table<string, int> > xpSourcesPerLevel = file.playerToXpSourcesPerLevel[player]
	while( level >= xpSourcesPerLevel.len() )
	{
		xpSourcesPerLevel.append( {})
	}
	string actionKey = file.upgradeActionReverseLookupTable[actionId]
	table<string,int> xpSources = xpSourcesPerLevel[level]
	if( !( actionKey in xpSources ) )
		xpSources[actionKey] <- 0
	xpSources[actionKey] += xp
}

string function UpgradeCore_ActionToScoreEventString( int actionId )
{
	switch( actionId )
	{
		case eUpgradeXPActions.KNOCK:
			return "Sur_DownedPilot"
		case eUpgradeXPActions.ASSIST:
			return "Evo_KnockAssist"
		case eUpgradeXPActions.RESPAWN:
			return "Evo_Respawn"
		case eUpgradeXPActions.REVIVE:
			return "Evo_Revive"
		case eUpgradeXPActions.BEACONSCAN:
			return "Evo_BeaconScan"
		case eUpgradeXPActions.RINGSCAN:
			return "Evo_RingScan"
		case eUpgradeXPActions.PERKBIN:
			return "Evo_PerkBin"
		case eUpgradeXPActions.CRATEREVEAL:
			return "Evo_CrateReveal"
		case eUpgradeXPActions.XPSTATION:
			return "Evo_Harvester"
		case eUpgradeXPActions.WILDLIFE:
			return "Evo_Wildlife"
		case eUpgradeXPActions.BANNERPICKUP:
			return "Evo_BannerPickup"
		case eUpgradeXPActions.FINISHER:
			return "Evo_Finisher"
		case eUpgradeXPActions.CRATELOOT:
			return "Evo_CrateLoot"
		case eUpgradeXPActions.VAULT:
			return "Evo_Vault"
		case eUpgradeXPActions.EXPLOSIVEHOLD:
			return "Evo_ExplosiveHold"
		case eUpgradeXPActions.FLYERKILL:
			return "Evo_Flyer"
		case eUpgradeXPActions.XPCACHE:
			return "Evo_Cache"
		case eUpgradeXPActions.BLOODHOUNDTRIALS:
			return "Evo_Trials"
		case eUpgradeXPActions.ARMORY:
			return "Evo_Armory"
		case eUpgradeXPActions.UNDERDOGBONUS:
			return "Evo_Underdog"
		case eUpgradeXPActions.RESPAWN_TOKEN_PRESERVED:
			return "Evo_RespawnTokenPreserved"
		case eUpgradeXPActions.EXPLORATION:
			return "Evo_Exploration"
		case eUpgradeXPActions.MINGUARANTEEDLOOT_RESPAWN:
			return "Evo_GuaranteedMinLootRespawn"
	}
	return ""
}

void function UpgradeCore_OnPlayerConnected_UpdateHarvester( entity connectingPlayer )
{
	if ( !IsValid( connectingPlayer ) )
		 return

	Remote_CallFunction_Replay( connectingPlayer, FUNCNAME_ServerToClient_UpgradeCore_UpdateHarvesterState, connectingPlayer )
}

void function Server_UpgradeCore_HandleSelection( entity player, int upgradeIndex, bool fromQuickSelect )
{
	if( tunings.upgradesLocked )
		return

	if ( !IsValid(player) )
		return

	if ( !player.IsPlayer() || !IsAlive(player ))
		return

	if( !UpgradeCore_IsUpgradeSelectable( player, upgradeIndex ) )
	{
		// in firing range the host cast reset the level of players, so this is technically possible if timed correctly
		// so don't report it as cheating in that case
		if( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			RecordServerAbuseForAntiCheat( player, eRSALabels.UnselectableUpgrade )
		}
		return
	}

	UpgradeCoreChoice upgrade = UpgradeCore_GetUpgradeChoiceStructByIndex( player, upgradeIndex )

	if( upgrade.passiveIndex == ePassives.INVALID )
	{
		Assert( false, "Tried applying an upgrade with an invalid upgrade index" )
		return
	}


	if( !( player in file.playerToCharacterClass ) )
	{
		ItemFlavor characterItemFlavor = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
		file.playerToCharacterClass[player] <- characterItemFlavor
	}

	int selectedUpgrades = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	selectedUpgrades = SetBitFlag( selectedUpgrades, ( 1 << upgradeIndex ) )
	player.SetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES, selectedUpgrades )
	Server_UpgradeCore_ApplyUpgrade( player, upgrade, false )
	Remote_CallFunction_Replay( player, FUNCNAME_ServerToClient_AcknowledgeUpgradeSelection, upgradeIndex )
	LiveAPI_OnUpgradeCoreSelected( player, upgradeIndex )
	//PIN_PlayerUpgradeSelected( player, upgradeIndex, fromQuickSelect )

	// hack for lifeline care package upgrade
	// annoyingly passives get granted on respawn. so to make only the NEXT ult a care package we have to do it in selection
	// so that respawning doesn't flag it back on
	if( player.HasPassive( ePassives.PAS_MEDIC ) && upgrade.passiveIndex == ePassives.PAS_ULT_UPGRADE_ONE )
	{
		AbilityCarePackage_SetNextUltIsCarePackage( player )
	}
}

table<string, int> function UpgradeCore_GetXpSourcesForLevel( entity player, int level )
{
	if( !( player in file.playerToXpSourcesPerLevel ) )
		return {}

	if( level >= file.playerToXpSourcesPerLevel[player].len() )
		return {}

	return file.playerToXpSourcesPerLevel[player][level]
}

void function Server_UpgradeCore_ApplyUpgrade( entity player, UpgradeCoreChoice upgrade, bool isRespawn )
{
	if( upgrade.passiveIndex == ePassives.INVALID )
		return
	GivePassive( player, upgrade.passiveIndex )
	Perks_UpdateForUpgradeSelection( player )
	StatsHook_UpgradeSelected( player )

	if( upgrade.passiveWeaponMod == "" )
		return
	GiveExtraWeaponMod( player, upgrade.passiveWeaponMod )
	Remote_CallFunction_Replay( player, "ServerCallback_UpdateOffhandRuis" )
}

void function UpgradeCore_RemoveUpgrade( entity player, UpgradeCoreChoice upgrade )
{
	if( upgrade.passiveIndex == ePassives.INVALID )
		return
	TakePassive( player, upgrade.passiveIndex )
	Perks_UpdateForUpgradeSelection( player )

	if( upgrade.passiveWeaponMod == "" )
		return
	TakeExtraWeaponMod( player, upgrade.passiveWeaponMod )
	Remote_CallFunction_Replay( player, "ServerCallback_UpdateOffhandRuis" )
}

string function UpgradeCore_GetPlayerShieldCoreRef( entity player, int defaultTier = 1 )
{
	int level = UpgradeCore_GetPlayerArmorTier( player )
	return UpgradeCore_GetShieldCoreRefForTier( level, defaultTier )
}

string function UpgradeCore_GetPlayerShieldCoreRefFromAmount( entity player, int defaultTier = 1 )
{
	int level = UpgradeCore_GetPlayerArmorTier( player )
	int savedShieldLevel = EvolvingArmor_GetCharacterShieldHealthMaxForArmorTier( player, level ) + GetPlayerExtraShields( player )
	int shieldTier = GetShieldTierFromShieldAmount( savedShieldLevel )

	return UpgradeCore_GetShieldCoreRefForTier( shieldTier, defaultTier )
}

string function UpgradeCore_GetShieldCoreRefForTier( int tier, int defaultTier = 1 )
{
	if( tier == 0 )
		tier = defaultTier

	return "armor_core_pickup_lv" + tier
}

void function UpgradeCore_LevelUp( entity player )
{
	int level = UpgradeCore_GetPlayerLevel( player )

	//VFX
	int levelUpFXID = GetParticleSystemIndex( UPGRADE_CORE_LEVEL_UP_FX )
	PlayImpactFXTable( player.GetOrigin(), player, UPGRADE_CORE_IMPACT_TABLE )

	LootData curEquipData = EquipmentSlot_GetEquippedLootDataForSlot( player, "armor" )
	if( UpgradeCore_IsEquipmentArmorCore( curEquipData.ref ) )
	{
		int maxArmorStart = player.GetShieldHealthMax()
		int currentShield = SURVIVAL_GetPlayerShieldHealthFromArmor( player ) + GetPlayerExtraShields( player )
		int playerTier = UpgradeCore_GetPlayerArmorTier( player )
		int newTier = playerTier
		if( curEquipData.tier >= newTier )
		{
			newTier = curEquipData.tier
			array<entity> teammates = GetPlayerArrayOfTeam( player.GetTeam() )
			foreach( teammate in teammates )
			{
				Remote_CallFunction_Replay( teammate, FUNCNAME_ServerToClient_UpgradeCore_RefreshArmorHud, player )
			}
		}
		else
		{
			Remote_CallFunction_Replay( player, FUNCNAME_ServerToClient_PlayFPEvoShieldUpgradeFx, player )
			EvolvingArmor_BroadcastEvoShieldUpgrade( player, playerTier )
		}
		string newArmorRef = UpgradeCore_GetShieldCoreRefForTier( newTier )
		SURVIVAL_GivePlayerEquipment( player, newArmorRef, currentShield )

		LiveAPI_OnUpgradeTierLevelChange( player, level )

		//TODO add analytic events for upgrading here
		//PIN_ItemGrantedByScript( player, newArmorRef, 1 )

		// evo armor stat hook expects the tier in progression not the tier in actual tier, so convert to the progression tier
		int armorTier = newTier == 5 ? 4 : newTier
		StatsHook_EvoArmorEvolved( player, armorTier )
		int maxArmorEnd = player.GetShieldHealthMax()
		thread UpgradeCore_RegenNewHealth( player, maxArmorEnd - maxArmorStart )
	}

	Remote_CallFunction_Replay( player, FUNCNAME_ServerToClient_NotifyLeveledUp, player )

	int playerTier = UpgradeCore_GetPlayerArmorTier( player )
	//PIN_PlayerEvoLeveledUp( player, UpgradeCore_GetShieldCoreRefForTier( playerTier ), level )

	UpgradeCore_PlayLevelUp_SFX( player, level )

	UpgradeCore_RunCallbacks_OnPlayerLeveledUp( player, level )
}

void function UpgradeCore_PlayLevelUp_SFX( entity player, int level )
{
	switch( level )
	{
		case 1:
			EmitSoundOnEntityOnlyToPlayer( player, player, EVO_LEVELUP_LVL1_SFX_1P )
			EmitSoundOnEntityExceptToPlayer( player, player, EVO_LEVELUP_LVL1_SFX_3P )
			break
		case 2:
			EmitSoundOnEntityOnlyToPlayer( player, player, EVO_LEVELUP_LVL2_SFX_1P )
			EmitSoundOnEntityExceptToPlayer( player, player, EVO_LEVELUP_LVL2_SFX_3P )
			break
		case 3:
			EmitSoundOnEntityOnlyToPlayer( player, player, EVO_LEVELUP_LVL3_SFX_1P )
			EmitSoundOnEntityExceptToPlayer( player, player, EVO_LEVELUP_LVL3_SFX_3P )
			break
		default:
			EmitSoundOnEntityOnlyToPlayer( player, player, EVO_LEVELUP_LVL1_SFX_1P )
			EmitSoundOnEntityExceptToPlayer( player, player, EVO_LEVELUP_LVL1_SFX_3P )
			break
	}
}

void function UpgradeCore_RegenNewHealth( entity player, int amountToRegen, bool cancelOnDamage = true, float healRateOverride = -1 )
{
	player.EndSignal( "OnDestroy" )

	if( cancelOnDamage )
	{
		player.EndSignal( "OnDamaged", "OnShieldDamaged" )
	}

                                   
                        
                                                      
   
                                                                                                                                                    
   
                                                                                                                  
                                              
                                                 
       

	float targetShields = amountToRegen / float( player.GetShieldHealthMax() )

	file.playerToShieldRegenStatusEffect[player] <- StatusEffect_AddEndless( player, eStatusEffect.target_shields, targetShields )

	OnThreadEnd (
		function() : ( player )
		{
			if( IsValid( player ) && player in file.playerToShieldRegenStatusEffect )
			{
				StatusEffect_Stop( player, file.playerToShieldRegenStatusEffect[player] )
			}
		}
	)

	if( tunings.upgradedShieldRegenStartDelay > 0 )
		wait( tunings.upgradedShieldRegenStartDelay )

	float lastRegenTime = Time()
	int shieldsRegened = 0
	float regenRate = healRateOverride >= 0 ? healRateOverride : tunings.upgradedShieldRegenRate

	while( shieldsRegened < amountToRegen )
	{
		WaitFrame()
		float curTime = Time()
		float elapsedTime = curTime - lastRegenTime
		float regenThisFrame  = elapsedTime * regenRate
		if( regenThisFrame < 1.0 )
			continue

		int regenAmount = minint( int( regenThisFrame ), amountToRegen - shieldsRegened )
		lastRegenTime = curTime

		// not sure if this is necessary since we already have a OnDestroy endon
		if( !IsValid( player ) )
			break

		int curShields = player.GetShieldHealth()
		int maxShields = player.GetShieldHealthMax()
		if( curShields >= maxShields )
			break

		int newShields = minint( curShields + regenAmount, maxShields )
		player.SetShieldHealthFromSource( newShields, SHIELD_CHANGE_SOURCE_REGEN )
		shieldsRegened += regenAmount
		StatusEffect_Stop( player, file.playerToShieldRegenStatusEffect[player] )
		targetShields = ( amountToRegen - shieldsRegened ) / float( player.GetShieldHealthMax() )
		file.playerToShieldRegenStatusEffect[player] <- StatusEffect_AddEndless( player, eStatusEffect.target_shields, targetShields )
	}
}

