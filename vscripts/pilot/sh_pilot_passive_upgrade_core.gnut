void function UpgradeCore_OnGameStart()
{
	if( tunings.modesInitialLevel > 0 )
	{
		array< entity > allPlayers = GetPlayerArray_Alive()

		foreach ( player in allPlayers )
		{
			if( UpgradeCore_EnabledForCharacter( player ) )
			{
				int targetLevel = tunings.modesInitialLevel

				int xpToAdd = 0

				targetLevel = minint( targetLevel, tunings.xpLevelThresholds.len() )

				if( targetLevel >= 0 )
					xpToAdd = tunings.xpLevelThresholds[targetLevel - 1]

				UpgradeCore_IncrementXP( player, xpToAdd, true, eUpgradeXPActions.MODESTARTXP )
			}
		}
	}
	foreach( player in GetPlayerArray_Alive() )
	{
		file.playerFirstSkydiveCompleteStatus[player] <- false
	}
}

