void function UpgradeCore_GrantConsoleScanXp( entity player, entity console )
{
	bool shouldRewardScan = true
	int currentDeathFieldStage = SURVIVAL_GetCurrentDeathFieldStage()

	PlayerRingScanData scanData

	int teamID = player.GetTeam()

	if( tunings.preventDoubleRingScanRewards )
	{
		if( teamID in file.teamConsoleScanRegistry )
		{
			// check if the console being scanned is the same as the MOST RECENT scan
			if( file.teamConsoleScanRegistry[teamID].lastConsoleScanned == console )
			{
				// if the current deathfield is greater than 1 more than the last time we scanned, allow the Evo award.
				// basically if they skipped scanning a full round, but used the same console, let them have the evo
				if( currentDeathFieldStage <= ( scanData.lastDeathfieldStageScanned + 1 ) )
				{
					// if the console being scanned, is the same console they just scanned, and they used it last round, do no grant Evo.
					shouldRewardScan = false
				}
			}

			// register the scanned console as the most recent (overwrites existing)
			scanData.lastConsoleScanned = console
			scanData.lastDeathfieldStageScanned = currentDeathFieldStage
		}
		else
		{
			//if nothing stored for last console scanned, insert this one as the most recent console scanned
			scanData.lastConsoleScanned = console
			scanData.lastDeathfieldStageScanned = currentDeathFieldStage

			file.teamConsoleScanRegistry[teamID] <- scanData
		}
	}

	if( shouldRewardScan )
	{
		UpgradeCore_GrantTeamXp( player, tunings.consoleScanXp, eUpgradeXPActions.RINGSCAN )
	}
	else
	{
		//modify the report of scanning console to be 'console re-scanned' (Check with Loc on this)
		if( tunings.messageDoubleRingScan )
		{
			UpgradeCore_Message_Ring_ReScan( player, console )
		}
	}
}

