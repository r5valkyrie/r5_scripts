int function UpgradeCore_GetOvermatchBonus_ForPlayerAndTarget( entity player, entity victim, bool overrideManualLevel = false, int manualLevel = -1 )
{
	int targetLevel = UpgradeCore_GetPlayerLevel( victim )

	int playerLevel = UpgradeCore_GetPlayerLevel( player )

	//if you want to manually override the level of the target you're checking, use the passed in value
	if( overrideManualLevel )
	{
		if( manualLevel >= 0 )
		{
			targetLevel = manualLevel
		}
	}

	int difference = targetLevel -  playerLevel  //player level is currently 0 indexed

	if( difference >= ( tunings.overmatchXpBonuses.len() - 1 ) )//if the difference is bigger than the array of scalars just give the best boost we have
	{
		return tunings.overmatchXpBonuses[tunings.overmatchXpBonuses.len() - 1]
	}
	else if( difference < 0 ) //if less than 0 on difference, just give the base value in the 0 index (1.0)
	{
		return tunings.overmatchXpBonuses[0]
	}
	else //if within the array boundaries, give the correct scalar based on this level difference
	{
		return tunings.overmatchXpBonuses[difference]
	}

	return 0 //return default bonus of 0, meaning players who are ahead of the curve get no additional xp
}

void function UpgradeCore_DynamicallySpawnUpgrades_Thread()
{
	Assert( IsNewThread() )
	RingDropData data = SetupPotentialAirdropLocations()
	for( int i=0; i < data.spawnCount; i++ )
	{
		waitthread SpawnUpgradeConsoleForIndex_Thread( i, data )
	}
}

void function UpgradeCore_SetXPForLevel( entity player, int level )
{
	level = minint( maxint( level, 0 ), tunings.xpLevelThresholds.len() )
	int curXp = player.GetPlayerNetInt( UPGRADE_CORE_XP_NETINT )

	if( level == 0 )
		UpgradeCore_SetXP( player, 0 )
	else
	{
		int newXp = tunings.xpLevelThresholds[level - 1]
		if( newXp > curXp )
			UpgradeCore_IncrementXP( player, newXp - curXp )
		else
			UpgradeCore_SetXP( player, newXp )
	}
}

