array<int> function UpgradeCore_GetLevelXpThresholds()
{
	string defaults = UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER
	if( GetCurrentPlaylistVarString( "pin_match_type", "survival" ) == "duo" )
	{
		defaults = UPGRADE_CORE_DEFAULT_XP_THRESHOLDS_THREE_TIER_DUOS
	}

	string playlistStr = GetCurrentPlaylistVarString( "passive_upgrade_core_xp_thresholds", defaults )
	array<int> xpRequirements = UpgradeCore_ParseStringIntoIntArray( playlistStr )
	int cumulativeXp = 0
	array<int> result
	for( int i=0; i < xpRequirements.len(); i++ )
	{
		cumulativeXp += xpRequirements[i]
		result.append( cumulativeXp )
	}
	return result
}

#if SERVER

void function UpgradeCore_ClearUpgradesAboveLevel( entity player, int level )
{
	int selectedUpgrades = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	array< UpgradeCoreChoice > choices = UpgradeCore_GetUpgradesForPlayer( player )
	for( int i =  level * 2; i <= UPGRADE_CORE_NUM_EXPECTED_UPGRADES; i++ )
	{
		int bit = 1 << i
		if( IsBitFlagSet( selectedUpgrades, bit ) )
		{
			selectedUpgrades = ClearBitFlag( selectedUpgrades, bit )
			UpgradeCoreChoice choice = choices[i]
			UpgradeCore_RemoveUpgrade( player, choice )
		}
	}
	player.SetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES, selectedUpgrades )
}

void function UpgradeCore_Set_Level( entity player, int level )
{
	level = minint( level, UPGRADE_CORE_TOTAL_LEVELS )
	UpgradeCore_ClearUpgradesAboveLevel( player, level )
	UpgradeCore_SetXPForLevel( player, level )

	// jump the player to their armor tier immediately. also clear out overshield armor
	string newArmorRef = UpgradeCore_GetPlayerShieldCoreRef( player )
	int newTier = UpgradeCore_GetPlayerArmorTier( player )
	int capacity = EvolvingArmor_GetEvolvingArmorHealthForTier( newTier )
	if( capacity < player.GetShieldHealthMax() )
	{
		player.SetShieldHealth( capacity )
	}
	SURVIVAL_GivePlayerEquipment( player, newArmorRef, capacity )
	SetPlayerExtraShields( player, 0 )
	SetPlayerExtraShieldsTier( player, 1 )
}

