void function UpgradeCore_OnNewZoneEntered( entity player, int zoneId )
{
	if( !IsValid( player ) )
		return

	if( player in file.playerFirstSkydiveCompleteStatus && GetCurrentPlaylistVarInt( "survival_squad_spawn_near_loot", 0 ) != 1 ) // playlist var is checking for Nitro contexts or places where no skydive happens and players spawn on the ground.
	{
		if( !file.playerFirstSkydiveCompleteStatus[player] )
			return
	}

	int tier = MapZones_GetTierForZone( zoneId )
	if( tier == 0 )
		return

	if( !( player in file.playerToExploredAreas ) )
	{
		file.playerToExploredAreas[player] <- [zoneId]
		return
	}

	if( file.playerToExploredAreas[player].contains( zoneId ) )
	{
		return
	}

	float currentTimeStamp = Time()

	if( player in file.playerExplorationCoolodowns )
	{
		if( currentTimeStamp - file.playerExplorationCoolodowns[ player ] < tunings.explorationCooldownDuration )
		{
			return
		}
		else
		{
			file.playerExplorationCoolodowns[ player ] <- currentTimeStamp
		}
	}
	else
	{
		file.playerExplorationCoolodowns[ player ] <- currentTimeStamp
	}

	file.playerToExploredAreas[player].append( zoneId )
	UpgradeCore_IncrementXP( player, tunings.explorationXp, false, eUpgradeXPActions.EXPLORATION )
}


