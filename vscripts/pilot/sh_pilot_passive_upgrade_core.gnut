void function UpgradeCore_MessageReKnock( entity victim, entity attacker )
{
	if( !IsValid( attacker ) || !attacker.IsPlayer() )
		return
	if( !IsValid( victim ) || !victim.IsPlayer() )
		return
	if ( !attacker.IsPlayer() )
		return

	AddPlayerScore( attacker, "Evo_ReKnock", victim )
}

void function UpgradeCore_MessageNonCombatRevive( entity victim, entity reviver )
{
	if( !IsValid( reviver ) || !reviver.IsPlayer() )
		return
	if( !IsValid( victim ) || !victim.IsPlayer() )
		return
	if ( !reviver.IsPlayer() )
		return

	AddPlayerScore( reviver, "Evo_NonCombatRevive", victim )
}

void function UpgradeCore_Message_Ring_ReScan( entity player, entity console )
{
	if( !IsValid( player ) || !player.IsPlayer() )
		return
	if( !IsValid( console ) )
		return

	AddPlayerScore( player, "Evo_Ring_ReScan" ) //"Evo_Ring_ReScan"
}

void function UpgradeCore_GrantKnockXp( entity victim, entity attacker )
{
	int xpToAdd = tunings.knockXp

	UpgradeCore_IncrementXP( attacker, xpToAdd, false, eUpgradeXPActions.KNOCK, true, victim )

	foreach ( entity assistCreditPlayer, float assistTime in victim.p.playerToTimeThatAssistCreditLastsTable )
	{
		if ( !IsValid( assistCreditPlayer ) )
			continue

		if ( assistCreditPlayer.p.hasMatchParticipationEnded )
			continue

		int assistXpToAdd = tunings.assistXp

		UpgradeCore_IncrementXP( assistCreditPlayer, assistXpToAdd, false, eUpgradeXPActions.ASSIST, true, victim )
	}

	if( tunings.awardOvermatchOnKnock )
	{
		array<entity> teammates = GetPlayerArrayOfTeam_Alive( attacker.GetTeam() )

		foreach( teammate in teammates )
		{
			UpgradeCore_IncrementXP ( teammate, UpgradeCore_GetOvermatchBonus_ForPlayerAndTarget( teammate , victim ), false, eUpgradeXPActions.UNDERDOGBONUS )
		}
	}
}

bool function UpgradeCore_ValidateIsCombatKill( entity victim, entity attacker, var damageInfo )
{
	bool isValidCombatKill = true

	// first check to see if this passes the basic check for self or env kills
	if( IsDeathSelfKillOrEnvDamage( victim, attacker, damageInfo ) )
	{
		isValidCombatKill = false
	}

	//if we're currently considering this a non combat kill and we're allowing grace period, verify that a enemy didn't contribute to the env kill right before it happened.
	if( tunings.allowGracePeriodForEnvKnocksAssistedByEnemies && !isValidCombatKill )
	{
		if( victim in file.playerDamageRegistry )
		{
			if( Time() - file.playerDamageRegistry[ victim ].lastTimeEnemyDamagedPlayer <= tunings.gracePeriodDurationForEnvKnocksAssistedByEnemies )
			{
				isValidCombatKill = true
			}
		}
	}

	//if we've above confirmed that this was not in the grace period or no player caused it, than this is a non combat death
	if( !isValidCombatKill )
	{
		// we want to make sure we still award banner and respawn evo when the player was downed legitimately but then died to the ring
		// so if they were killed by the environment but downed by a valid enemy, ignore the non combat register
		bool shouldRegister = true
		if( Bleedout_IsBleedingOut( victim ) && IsDeathSelfKillOrEnvDamage( victim, attacker, damageInfo ) )
		{
			entity bleedoutAttacker = Bleedout_GetBleedoutAttacker( victim )
			if( IsValid( bleedoutAttacker ) && bleedoutAttacker.IsPlayer() && bleedoutAttacker.GetTeam() != victim.GetTeam() )
			{
				shouldRegister = false
			}
		}


		//register this as a non combat kill for other checks on revive and respawn
		if( shouldRegister )
		{
			file.playerDiedToNonCombatSource[ victim ] <- true
		}
	}

	return isValidCombatKill
}

void function UpgradeCore_OnPlayerDowned( entity victim, entity attacker, var damageInfo )
{
	if( !IsValid( attacker ) )
		return
	if( !IsValid( victim ) || !victim.IsPlayer() )
		return

	if( tunings.preventFriendlyFireExploits )
	{
		bool isValidCombatKill = UpgradeCore_ValidateIsCombatKill( victim, attacker, damageInfo )

		if( isValidCombatKill )
		{
			if( victim in file.playerDamageRegistry )
			{
				entity lastAttacker = file.playerDamageRegistry[ victim ].lastEnemyToDamagePlayer

				//make sure the last player to deal damage before this valid combat kill is who get the Evo award.
				if(  IsValid( lastAttacker ) && lastAttacker.IsPlayer() )
				{
					attacker = lastAttacker
				}
			}
		}
		else
		{
			return
		}
	}
	else
	{
		if( victim == attacker )
			return
	}

	if ( !attacker.IsPlayer() )
		return

	//Logic that checks if you have been knocked by this attacker before: If so DO NOT AWARD EVO. We want to prevent players from farming/trading knocks as an exploit for free Evo.
	if( !UpgradeCore_ReKnockRewardEvo() )
	{
		if( victim in file.playerReKnockRegistry )
		{
			array< entity > attackersWithKnocksAgainstPlayer

			attackersWithKnocksAgainstPlayer = file.playerReKnockRegistry[ victim ]

			if( attackersWithKnocksAgainstPlayer.contains( attacker ) )
			{
				if( UpgradeCore_Message_ReKnocks() )
				{
					UpgradeCore_MessageReKnock( victim, attacker )
				}
				return
			}
			else
			{
				attackersWithKnocksAgainstPlayer.append( attacker )

				file.playerReKnockRegistry[ victim ] <- attackersWithKnocksAgainstPlayer
			}
		}
		else
		{
			array< entity > attackersWithKnocksAgainstPlayer = []

			attackersWithKnocksAgainstPlayer.append( attacker )

			file.playerReKnockRegistry[ victim ] <- attackersWithKnocksAgainstPlayer
		}
	}

	UpgradeCore_GrantKnockXp( victim, attacker )
}

void function UpgradeCore_OnPlayerRevived( entity player, entity reviver )
{
	if ( !IsValid( reviver ) )
		return
	if ( !reviver.IsPlayer() )
		return

	int xpToAward = tunings.reviveXp

	if ( player in file.playerDamageRegistry )
	{
		delete file.playerDamageRegistry[ player ]
	}

	if( player in file.playerDiedToNonCombatSource && tunings.preventFriendlyFireExploits )
	{
		if( file.playerDiedToNonCombatSource[ player ] )
		{
			file.playerDiedToNonCombatSource[ player ] = false

			UpgradeCore_MessageNonCombatRevive( player, reviver )
			return
		}
	}

	if( tunings.preventReviveFarmingExploits )
	{
		int teamID = reviver.GetTeam()

		if ( teamID in file.teamReviveRegistry )
		{
			int reducedAwardAmount

			int teamReviveCount = file.teamReviveRegistry[ teamID ]

			int reviveOverage = teamReviveCount - tunings.reviveFarmingThreshold

			if( reviveOverage > 0 )
			{
				reducedAwardAmount = tunings.reviveXp - ( tunings.reviveValueReduction * reviveOverage )

				xpToAward = maxint( tunings.reviveMinXp, reducedAwardAmount )
			}
		}
		else
		{
			file.teamReviveRegistry[ teamID ] <- 0
		}

		file.teamReviveRegistry[ teamID ] <- ( file.teamReviveRegistry[ teamID ] + 1 )

	}

	UpgradeCore_GrantTeamXp( player, xpToAward, eUpgradeXPActions.REVIVE  )
}

void function UpgradeCore_OnTeammatesRespawned( entity playerRespawner, entity respawnBeacon, array<entity> players )
{
	if ( !IsValid( playerRespawner ) )
		return
	if ( !playerRespawner.IsPlayer() )
		return

	foreach ( teammate in players )
	{
		if ( !IsValid( teammate ) && !teammate.IsPlayer() )
			continue

		if ( teammate in file.playerDamageRegistry )
		{
			delete file.playerDamageRegistry[ teammate ]
		}

		if ( teammate in file.playerDiedToNonCombatSource && tunings.preventFriendlyFireExploits )
		{
			if ( file.playerDiedToNonCombatSource[ teammate ] )
			{
				file.playerDiedToNonCombatSource[ teammate ] = false
				continue
			}
		}

		UpgradeCore_GrantTeamXp( playerRespawner, tunings.respawnXp, eUpgradeXPActions.RESPAWN  )
	}
}

void function UpgradeCore_OnBannerPickup( entity collectingPlayer, entity playerBeingCollected )
{
	if ( !IsValid( collectingPlayer ) )
		return
	if ( !collectingPlayer.IsPlayer() )
		return

	                            
		if ( GetCurrentPlaylistVarBool( "has_auto_banners", false ) )
		{
			return
		}
       

	if( playerBeingCollected in file.playerDiedToNonCombatSource && tunings.preventFriendlyFireExploits )
	{
		if( file.playerDiedToNonCombatSource[ playerBeingCollected ] )
		{
			return
		}
	}

	UpgradeCore_GrantTeamXp( collectingPlayer, tunings.bannerRecoveryXp, eUpgradeXPActions.BANNERPICKUP  )
}

void function UpgradeCore_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	if( !IsValid( attacker ) )
		return
	if( !IsValid( victim ) || !victim.IsPlayer() )
		return

	if( tunings.preventFriendlyFireExploits )
	{
		bool isValidCombatKill = UpgradeCore_ValidateIsCombatKill( victim, attacker, damageInfo )

		if( isValidCombatKill )
		{
			if( victim in file.playerDamageRegistry )
			{
				entity lastAttacker = file.playerDamageRegistry[ victim ].lastEnemyToDamagePlayer

				//make sure the last player to deal damage before this validate combat kill is who get the Evo.
				if(  IsValid( lastAttacker ) && lastAttacker.IsPlayer() )
				{
					attacker = lastAttacker
				}
			}
		}
		else
		{
			return
		}
	}

	if( !Bleedout_IsBleedingOut( victim ) )
	{
		UpgradeCore_GrantKnockXp( victim, attacker )
	}

	int victimTeam = victim.GetTeam()
	if ( GetPlayerArrayOfTeam_Alive( victimTeam ).len() > 0 )
		return

	int squadWipeXp = tunings.squadwipeXp

	array<entity> teammates = GetPlayerArrayOfTeam( attacker.GetTeam() )

	foreach( teammate in teammates )
	{
		UpgradeCore_IncrementXP( teammate, squadWipeXp, true, eUpgradeXPActions.SQUADWIPE, true, victim )

		//In the alternate case where we're trying to only award underdog based on squad wipe, and we need to just take the average level of the team to simplify things.
		if( tunings.awardOvermatchOnSquadWipe )
		{
			//Averge the enemy team level to get an accurate overmatch bonus.
			array<entity> enemies = GetPlayerArrayOfTeam( victim.GetTeam() )

			int cumulativeLevel = 0
			int playersInSquad = 0

			for( playersInSquad = 0; playersInSquad < enemies.len();  playersInSquad++ )
			{
				entity enemy = enemies[playersInSquad]

				cumulativeLevel = cumulativeLevel + UpgradeCore_GetPlayerLevel( enemy )
			}

			//Set averaged level of enemy team that is getting wiped, rounded up.
			int targetLevel = int ( ceil( ( cumulativeLevel ) / ( playersInSquad ) ) )

			//Override the Overmatch getter to use the specific averaged level you've determined.
			UpgradeCore_IncrementXP ( teammate, UpgradeCore_GetOvermatchBonus_ForPlayerAndTarget( teammate , victim, true, targetLevel ), false, eUpgradeXPActions.UNDERDOGBONUS )
		}
	}
}

bool function IsDeathSelfKillOrEnvDamage( entity victim, entity attacker, var damageInfo )
{
	if( !IsValidPlayer( victim ) )
		return false

	if( IsValidPlayer( attacker ) )
	{
		if( victim.GetTeam() == attacker.GetTeam() )
		{
			return true
		}
	}

	if( IsLethalDamageFromEnv( victim, attacker, damageInfo ) )
		return true

	if( !attacker.IsPlayer() )
		return true


	return false
}

bool function IsLethalDamageFromEnv( entity victim, entity attacker, var damageInfo )
{
	bool isEnvDamage = false

	int damageType = DamageInfo_GetDamageType( damageInfo )

	if( damageType == DMG_FALL || damageType == DMG_CRUSH || damageType == 0 ) //if the player is killed by something other than another player (fall, ring damage, accident, etc) we want to count that as a self damage/ff kill so that revives cannot give free Evo R5DEV-559267
	{
		isEnvDamage = true
	}

	return isEnvDamage
}


void function UpgradeCore_OnLootbinOpen( entity player, entity lootbin, array<entity> regularLootEnts, array<entity> secretLootEnts, void functionref( bool, bool ) preventLootRevealFun )
{
	if ( !IsValidPlayer( player ) )
		return

	bool perkBinOpened = false

	if( !lootbin.e.hasSecretBeenOpened )
	{
		if( SupportBin_EntityIsSupportBin( lootbin ) && Perks_DoesPlayerHavePerk( player, ePerkIndex.EXTRA_BIN_LOOT ) )
		{
			perkBinOpened = true
			UpgradeCore_GrantTeamXp( player, tunings.perkBinOpenXp, eUpgradeXPActions.PERKBIN )
		}
		else if( Perk_MunitionsBox_IsEntMunitionsBox( lootbin ) && Perks_DoesPlayerHavePerk( player, ePerkIndex.MUNITIONS_BOX ) )
		{
			perkBinOpened = true
			UpgradeCore_GrantTeamXp( player, tunings.perkBinOpenXp, eUpgradeXPActions.PERKBIN )
		}
	}

}

void function UpgradeCore_OnPlayerRespawned( entity ent )
{
	if( ent in file.playerReKnockRegistry )
	{
		file.playerReKnockRegistry[ent].clear()
	}

	//clear from env death registry
	if( ent in file.playerDiedToNonCombatSource )
	{
		delete file.playerDiedToNonCombatSource[ent]
	}

	//reset player damage registry
	if( ent in file.playerDamageRegistry )
	{
		delete file.playerDamageRegistry[ent]
	}


	thread UpgradeCore_DelayedUpgradeApply_Thread( ent )
}

void function UpgradeCore_DelayedUpgradeApply_Thread( entity ent )
{
	Assert( IsNewThread() )
	Assert( ent.IsPlayer() )

	// need to wait a frame because the character's weapons haven't been setup yet
	WaitFrame()

	if( !IsValid( ent ) )
		return

	int selectedUpgrades = 0

	foreach( upgradeInfo in UpgradeCore_GetSelectedUpgrades( ent ) )
	{
		Server_UpgradeCore_ApplyUpgrade( ent, upgradeInfo, true )
	}
}

#if DEVELOPER
array<vector> s_temp
void function DEV_EvoHarvestersNavmeshDebug( )
{
	float drawTime = 30

	array<vector> potentialSpots = NavMesh_SearchForOpenAreas( HULL_HUMAN,
		tunings.harvester_idealTileArea,
		tunings.harvester_minTileSize,
		tunings.harvester_minSurroundingArea,
		tunings.harvester_maxSurroundingArea,
		tunings.harvester_maxPathCost,
		tunings.harvester_minNumAdjacentTiles
	)

	array< vector > avoidPositions

	if ( tunings.harvester_useBadAreaAvoidanceRadius )
		avoidPositions = EvoHarvesters_GetAvoidancePointsForPlacement()

	printf("EVO HARVESTERS: " + potentialSpots.len())
	for( int i = potentialSpots.len() - 1; i >=0 ; i--  )
	{
		bool invalidatedByAvoidanceAreas = false

		if ( potentialSpots.len() != s_temp.len() && s_temp.contains( potentialSpots[i] ) )
			continue

		if ( tunings.harvester_useBadAreaAvoidanceRadius )
		{
			foreach ( badPos in avoidPositions )
			{
				float dist = Distance2D( badPos, potentialSpots[i] )
				if ( dist < tunings.harvester_badAreaAvoidanceRadius )
				{
					invalidatedByAvoidanceAreas = true
					break
				}
			}
		}

		if ( !invalidatedByAvoidanceAreas )
			DebugDrawLine( potentialSpots[i], potentialSpots[i] + <0,0,4000>, 0, 255, 0, false, drawTime  )
		else
			DebugDrawLine( potentialSpots[i], potentialSpots[i] + <0,0,4000>, 128, 0, 128, false, drawTime  )
	}

	s_temp = potentialSpots
}

void function DEV_EvoHarvestersExcludedAreas_DebugDraw()
{
	array< vector > potentialSpots = EvoHarvesters_GetAvoidancePointsForPlacement()

	printf ( "Avoidance Areas: " + potentialSpots.len() )
	for ( int i = potentialSpots.len() - 1; i >=0 ; i--  )
	{
		if ( potentialSpots.len() != s_temp.len() && s_temp.contains( potentialSpots[i] ) )
			continue

		DebugDrawLine( potentialSpots[i], potentialSpots[i] + <0,0,4000>, 255, 0, 0, false, 30  )
		DebugDrawCircle( potentialSpots[i], <0, 0, 0>, tunings.harvester_badAreaAvoidanceRadius, 255, 0, 0, false, 30 )
	}

	s_temp = potentialSpots
}
