int function UpgradeCore_GetPlayerLevel( entity player )
{
	if( !UpgradeCore_IsEnabled() )
	{
		return 0
	}

	if( !IsValid( player ) )
	{
		return 0
	}

	int currentScore = player.GetPlayerNetInt( UPGRADE_CORE_XP_NETINT )
	int currentLevel = 0

	array<int> levelThresholds = UpgradeCore_GetLevelXpThresholds()
	for( int i=0; i < levelThresholds.len(); i++ )
	{
		if( currentScore < levelThresholds[i] )
			break
		currentLevel = i + 1
	}
	currentLevel = minint( UPGRADE_CORE_TOTAL_LEVELS, currentLevel )

	return currentLevel
}

bool function UpgradeCore_IsLevelMaxLevel( int curLevel )
{
	return curLevel == UPGRADE_CORE_TOTAL_LEVELS
}

bool function UpgradeCore_IsPlayerAtMaxLevel( entity player )
{
	int curLevel = UpgradeCore_GetPlayerLevel( player )

	return curLevel == UPGRADE_CORE_TOTAL_LEVELS
}

#if SERVER
// Figure out how much XP we need to award the player to get them to the next level
// By default we take the players current XP progress into consideration, if shouldIgnorePlayersXPProgress is true we will grab the whole XP requirement for each level and ignore their progress
// By default we return the value that will get the player to the next level, if level is defined we will return the XP needed to get the player to the specified level instead
const int CALCULATE_NEXT_LEVEL_INT = -1
int function UpgradeCore_GetXPAmountToEvoPlayerToLevel( entity player, bool shouldIgnorePlayersXPProgress = false, int level = CALCULATE_NEXT_LEVEL_INT )
{
	int xpToAdd = 0

	if( !IsValid( player ) || !player.IsPlayer() )
		return xpToAdd

	int playerLevel = UpgradeCore_GetPlayerLevel( player )
	level = level < 0 ? playerLevel + 1 : level // Determine if we are using the passed in level value or the next level
	level = minint( level,  tunings.xpLevelThresholds.len() ) // Ensure we don't try to grab a level that is higher than the max level
	level = maxint( level, 0 ) // Ensure we are looking for a valid level

	// If the player is already at the level or a higher level, return 0
	if ( level <= playerLevel )
		return xpToAdd

	level -= 1 // We grab the an index for each level which is -1 from the actual level we are trying to get

	// If after the above update the index would be invalid, return 0
	if ( level < 0 )
		return xpToAdd

	xpToAdd = tunings.xpLevelThresholds[ level ]

	if( level > 0 )
	{
		xpToAdd = xpToAdd - tunings.xpLevelThresholds[ level - 1 ]
	}

	if ( !shouldIgnorePlayersXPProgress )
		xpToAdd = maxint( 0, xpToAdd - player.GetPlayerNetInt( UPGRADE_CORE_XP_NETINT ) )

	return xpToAdd
}
#endif // SERVER

array<UpgradeCoreChoice> function UpgradeCore_GetSelectedUpgrades( entity player )
{
	int selectedUpgradesInt = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	array<UpgradeCoreChoice> upgrades = UpgradeCore_GetUpgradesForPlayer( player )
	array<UpgradeCoreChoice> selectedUpgrades
	for( int i=0; i < UPGRADE_CORE_NUM_EXPECTED_UPGRADES; i++ )
	{
		int bit = 1 << i
		if( IsBitFlagSet( selectedUpgradesInt, bit ) )
		{
			selectedUpgrades.append( upgrades[i] )
		}
	}
	return selectedUpgrades
}

bool function UpgradeCore_IsUpgradeSelectable( entity player, int index, bool checkLevel = true )
{
	if ( !UpgradeCore_IsEnabled() )
		 return false
	int upgradesBitFlag = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )

	if( checkLevel )
	{
		int level = UpgradeCore_GetPlayerLevel( player )
		int levelForUpgrade = index / 2 + 1
		if( level < levelForUpgrade )
			return false
	}

	int levelUpgradeStart = ( index / 2 ) * 2
	return !UpgradeCore_IsUpgradeSelected( player, levelUpgradeStart ) && !UpgradeCore_IsUpgradeSelected( player, levelUpgradeStart + 1 )
}

bool function UpgradeCore_IsUpgradeSelected( entity player, int index )
{
	int upgradesBitFlag = player.GetPlayerNetInt( UPGRADE_CORE_SELECTED_UPGRADES )
	return IsBitFlagSet( upgradesBitFlag, ( 1 << index )  )
}

