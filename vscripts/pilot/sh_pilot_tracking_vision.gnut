////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////// WHITE RAVEN PROTOTYPE///////////////////////////////////////////////////////////////////////////

void function Bloodhound_PassiveToggle( entity player, int passive, bool didHave, bool nowHas )
{
	if ( !IsAlive( player ) )
		return
	//
	if ( didHave )
	{
		Signal( player, "OnEnd_WhiteRavenTracking" )
	}

	if ( nowHas )
	{
		#if SERVER
			thread TrackingVision_WhiteRavenSpawnTracking_Thread( player )
		#endif
	}
}

#if SERVER
void function TrackingVision_WhiteRavenSpawnTracking_Thread( entity player )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )
	EndSignal( player, "OnReset_SpawnTracking" )

	OnThreadEnd(
		function() : ( player )
		{
		}
	)

	wait GetRavenNaturalSpawnTime( player )

	while ( true )
	{
		if( !IsValid( player ) )
			return

		if( TrackingVision_CanSpawnWhiteRaven( player ) )
		{
			PerchInfo perchData = WhiteRaven_GetBestSpawnLocationData( player )
			if( perchData.validPerch )
			{
				thread TrackingVision_CreateWhiteRavenPerched_Thread( player, perchData.perchPos, WHITE_RAVEN_BIRD_LIFETIME_SHORT )
				return
			}
		}

		//Check to Spawn White Raven on Deathbox Discovery
		//Todo: Special Case Deathbox Spawn into the spawn logic

		//array< entity > deathboxArray = GetAllDeathBoxes()
		//vector origin = player.GetOrigin()
		//
		//foreach ( deathbox in deathboxArray)
		//{
		//	if( !IsValid( deathbox ) )
		//		continue
		//
		//	float distToBox = Distance( origin, deathbox.GetOrigin() )
		//	if( distToBox < WHITE_RAVEN_DEATHBOX_DISCOVERY_RANGE )
		//	{
		//		if( CanSpawnWhiteRaven( player ) )
		//		{
		//			TrackingVision_OnAttemptActivateWhiteRaven( player, eWhiteRavenTargetType.DEATHBOX )
		//			break
		//		}
		//	}
		//}

		wait 1 //We don't need this every frame
	}
}
#endif

#if SERVER
bool function TrackingVision_CanSpawnWhiteRaven( entity player )
{
	if( !IsValid( player ) )
		return false

	if ( !PlayerHasPassive( player, ePassives.PAS_TRACKING_VISION ) )
		return false
	if ( Bleedout_IsBleedingOut( player ) )
		return false
	if ( player.ContextAction_IsActive() )
		return false
	if ( player.Player_IsSkywardLaunching() || player.Player_IsSkywardFollowing() )
		return false

	int team 					= player.GetTeam()
	vector origin 				= player.GetOrigin()
	entity closestEnemy
	float closestEnemyDistance	= WHITE_RAVEN_MAX_ENEMY_DETECTION_RANGE

	#if DEVELOPER
	if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
	{
		DebugDrawCircle( origin, <0,0,0>, GetRavenCloseBreadcrumbDistance( player ), COLOR_RED, true, 0.1 )
		DebugDrawCircle( origin, <0,0,0>, GetRavenCloseEnemyDistance( player ), COLOR_YELLOW, true, 0.1 )
		DebugDrawCircle( origin, <0,0,0>, WHITE_RAVEN_MAX_ENEMY_DETECTION_RANGE, COLOR_ORANGE, true, 0.1 )
	}
	#endif

	//Check to make sure we don't already have an Active Raven
	if( player in file.whiteRavenPlayerData )
		if( file.whiteRavenPlayerData[player].whiteRavenActive )
			return false

	//Check for nearby breadcrumbs
	array< entity > poiArray = TrackingVision_GetAllValidTrackingPOIs()
	foreach ( poi in poiArray )
	{
		if( !(IsValid( poi ) ) )
			continue

		int poiTeam		= poi.GetTeam()

		if( poiTeam == team )
			continue

		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
			{
				//printt( "POI detected!   | TEAM:  " + poiTeam )
				//DebugDrawSphere( poi.GetOrigin() + <0, 0, 10>, 10, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 2.0 )
			}
		#endif

		float distToPlayer = Distance2D( poi.GetOrigin(), origin )
		if( distToPlayer <= GetRavenCloseBreadcrumbDistance( player ) )
			return false
	}


	//Check for nearby enemies && enemies in White Raven Range
	array<entity> enemyArray = GetPlayerArrayOfEnemies_Alive( team )

	foreach( enemy in enemyArray )
	{
		if( !IsValid( enemy ) )
			continue

		float distToPlayer = Distance2D( enemy.GetOrigin(), origin )
		if( distToPlayer <= GetRavenCloseEnemyDistance( player ) )
		{
			#if DEVELOPER
				if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
				{
					printt( "Nearby Enemy Detected - DO NOT SPAWN WHITE RAVEN" )
					DebugDrawSphere( enemy.GetOrigin() + <0, 0, 10>, 10, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 10.0 )
				}
			#endif

			return false
		}
	}

	return true
}
#endif //SERVER

#if SERVER

PerchInfo function WhiteRaven_GetBestSpawnLocationData( entity player )
{
	vector origin 				= player.GetOrigin()
	vector perchPos				= <0,0,0>

	int anglePerOffset = 10
	int maxNumTests = 90 / anglePerOffset
	float curOffsetAngle = 0
	vector fwd = FlattenVec( player.GetViewVector() )
	array<entity> ignoreArray = GetPlayerArray()

	bool hasValidPos = false

	//Test for Deathbox Perch Points
	entity closestDeathbox
	float closestDeathboxDist = WHITE_RAVEN_DEATHBOX_DISCOVERY_RANGE //Slightly farther than normal range?

	array< entity > deathboxArray = GetAllDeathBoxes()
	foreach ( deathbox in deathboxArray)
	{
		if( !IsValid( deathbox ) )
			continue

		vector deathboxOrigin = deathbox.GetOrigin()
		if( !SURVIVAL_PosInsideDeathField( Survival_Loot_GetDefaultRealm(), deathboxOrigin ) )
			continue

		float distToBox = Distance( origin, deathboxOrigin )
		if( distToBox < WHITE_RAVEN_PERCH_MIN_SPAWN_RANGE / 2 ) // too close
			continue

		if( distToBox < closestDeathboxDist )
		{
			closestDeathboxDist = distToBox
			closestDeathbox = deathbox
		}
	}

	if( IsValid( closestDeathbox ) )
	{
		perchPos = closestDeathbox.GetOrigin()
		hasValidPos = true
	}

	if( !hasValidPos )
	{
		for (int i=0; i<maxNumTests; i++)
		{

			vector dir = VectorRotate( fwd, <0, curOffsetAngle, 0> )

			vector TraceStart = player.EyePosition()
			vector TraceEnd   = ( player.EyePosition() + <0,0,WHITE_RAVEN_PERCH_OFF_SPAWN_HEIGHT> ) + dir * WHITE_RAVEN_PERCH_MAX_SPAWN_RANGE

			TraceResults traceResults = TraceLine( TraceStart, TraceEnd, ignoreArray, (TRACE_MASK_PLAYERSOLID | TRACE_MASK_TITANSOLID | CONTENTS_NOAIRDROP), TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
			if ( Distance2D( origin, traceResults.endPos) > WHITE_RAVEN_PERCH_MIN_SPAWN_RANGE )
			{
				perchPos = traceResults.endPos
				hasValidPos = true
				break
			}

			if ( i > 0 ) //after our first check, we want to do a second on the opposite side
			{
				dir = VectorRotate( fwd, <0, -curOffsetAngle, 0> )
				TraceEnd   = player.EyePosition() + dir * WHITE_RAVEN_PERCH_MAX_SPAWN_RANGE

				traceResults = TraceLine( TraceStart, TraceEnd, ignoreArray, (TRACE_MASK_PLAYERSOLID | TRACE_MASK_TITANSOLID | CONTENTS_NOAIRDROP), TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
				if ( Distance2D( origin, traceResults.endPos) > WHITE_RAVEN_PERCH_MIN_SPAWN_RANGE )
				{
					perchPos = traceResults.endPos
					hasValidPos = true
					break
				}
			}

			curOffsetAngle = curOffsetAngle + anglePerOffset

		}
	}


	vector targetPos = perchPos

	if( hasValidPos )
	{
		targetPos = WhiteRaven_GetValidPerchPos( player, perchPos )

		if( targetPos == perchPos ) //No ground point found
			hasValidPos = false
	}

	PerchInfo perchData
	perchData.validPerch = hasValidPos
	perchData.perchPos = targetPos //perchPos

	return perchData
}
#endif

#if SERVER
entity function WhiteRaven_GetNearestEnemyTarget( entity player, bool allowCloseEnemy = true )
{
	int team 					= player.GetTeam()
	vector origin 				= player.GetOrigin()
	entity closestEnemy
	float closestEnemyDistance	= WHITE_RAVEN_MAX_ENEMY_DETECTION_RANGE

	//Check for nearby enemies && enemies in White Raven Range
	array<entity> enemyArray = GetPlayerArrayOfEnemies_Alive( team )

	foreach( enemy in enemyArray )
	{
		if( !IsValid( enemy ) )
			continue

		float distToPlayer = Distance2D( enemy.GetOrigin(), origin )
		if( distToPlayer <= GetRavenCloseEnemyDistance( player ) && !allowCloseEnemy )
			continue

		if( distToPlayer > closestEnemyDistance )
			continue

		closestEnemy = enemy
		closestEnemyDistance = distToPlayer
	}

	return closestEnemy
}
#endif

#if SERVER
vector function WhiteRaven_GetValidPerchPos( entity player, vector targetPos )
{
	const float WHITE_RAVEN_PERCH_DOWNCAST_HEIGHT 	= 800
	const float WHITE_RAVEN_PERCH_DOWNCAST_RADIUS	= 128 //64

	array< vector > perchPositions
	array<entity> ignoreArray = GetPlayerArray()

	vector traceOrigin = targetPos + <0,0,WHITE_RAVEN_PERCH_DOWNCAST_HEIGHT>
	vector traceEndPos = targetPos + <0,0,-10000>

	//If we can't see the Trace Origin, we might be in a cave and bird could spawn inside the ceiling.
	//Use the original cast height instead - if that fails, use the target height to guarentee a visible result
	TraceResults eyeTrace = TraceLine( player.EyePosition(), traceOrigin, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	if( eyeTrace.fraction < 0.99 )
	{
		traceOrigin = targetPos + <0,0,WHITE_RAVEN_PERCH_OFF_SPAWN_HEIGHT>
		TraceResults eyeTraceLow = TraceLine( player.EyePosition(), traceOrigin, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
		if( eyeTraceLow.fraction < 0.99 )
			traceOrigin = targetPos
	}

	//Set the targetPos to the Ground
	vector perchPos = targetPos
	TraceResults groundTrace = TraceLine( targetPos, traceEndPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	if( groundTrace.fraction < 0.99 )
	{
		if( TrackingVision_IsValidRavenHull( groundTrace.endPos, player ) )
		{
			perchPos = groundTrace.endPos
			perchPositions.append( perchPos )
		}
	}

	//Check for Perch above the target
	TraceResults downTrace = TraceLine( traceOrigin, traceEndPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	if( !downTrace.startSolid && downTrace.endPos != perchPos && downTrace.fraction < 0.99 )
	{
		if( TrackingVision_IsValidRavenHull( downTrace.endPos, player ) )
			perchPositions.append( downTrace.endPos )
	}

	//Sample nearby points for potential Perch Locations
	array<vector> ridgeTraceVectorArray = [ <1, 0, 0>, <-0.5, 0.86, 0>, <-0.5, -0.86, 0>, <0, 1, 0>, <0.86, -0.5, 0>, <-0.86, -0.5, 0> ] //Hex Sample
	foreach ( traceVector in ridgeTraceVectorArray )
	{
		vector ridgeTraceStart = traceOrigin + traceVector * WHITE_RAVEN_PERCH_DOWNCAST_RADIUS
		vector ridgeTraceEnd   = traceEndPos + traceVector * WHITE_RAVEN_PERCH_DOWNCAST_RADIUS

		TraceResults ridgeTrace = TraceLine( ridgeTraceStart, ridgeTraceEnd, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
		if ( !ridgeTrace.startSolid && ridgeTrace.fraction < 0.99 && DotProduct( ridgeTrace.surfaceNormal, UP_VECTOR ) > 0.85 )
		{
			//Test against deathfield placement
			bool isInRing                 = SURVIVAL_PosInsideDeathField( Survival_Loot_GetDefaultRealm(), ridgeTrace.endPos )
			if( isInRing )
			{
				//Is this position on the other side of a wall from the original position?
				vector offsetPerchPos = < perchPos.x, perchPos.y, ridgeTrace.endPos.z > //
				TraceResults backLineTrace = TraceLine( ridgeTrace.endPos, offsetPerchPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
				if( backLineTrace.fraction > 0.98 )
				{
					if( TrackingVision_IsValidRavenHull( ridgeTrace.endPos, player ) )
						perchPositions.append( ridgeTrace.endPos )
				}
			}
		}
	}

	//Choose the highest position amidst our samples to perch at. Birds like to be high.
	vector bestPos	= perchPos
	float bestHeight = perchPos.z
	foreach( pos in perchPositions )
	{
		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
			{
				DebugDrawSphere( pos + <0, 0, 5>, 12, int(COLOR_ORANGE.x), int(COLOR_ORANGE.y), int(COLOR_ORANGE.z), true, 15.0 )
			}
		#endif

		float height = pos.z
		if( height > bestHeight )
		{
			bestHeight = height
			bestPos = pos
		}
	}

	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
		{
			if( bestPos == targetPos )
			{
				DebugDrawSphere( bestPos + <0, 0, 15>, 10, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 15.0 )
			}
			else
			{
				DebugDrawSphere( bestPos + <0, 0, 15>, 10, int(COLOR_GREEN.x), int(COLOR_GREEN.y), int(COLOR_GREEN.z), true, 15.0 )
			}
		}
	#endif

	return bestPos
}
#endif

#if SERVER
bool function TrackingVision_IsValidRavenHull( vector hullPos, entity player )
{
	array<entity> ignoreArray = GetPlayerArray()

	vector hullOffset = <0,0,5> //Offset Hull slightly from ground to allow slope clearance (He has little feet. It's fine)
	hullPos = hullPos + hullOffset

	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_SPAWN_DRAW )
		{
			DebugDrawBox( hullPos, WHITE_RAVEN_PERCH_HULL_MINS, WHITE_RAVEN_PERCH_HULL_MAXS, COLOR_RED, 1, 15 )
		}
	#endif

	TraceResults hullTrace = TraceHull( hullPos, hullPos + hullOffset, WHITE_RAVEN_PERCH_HULL_MINS, WHITE_RAVEN_PERCH_HULL_MAXS, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	if( hullTrace.fraction < 1 )
		return false

	// Disallow Raven Spawn in Kill Volumes
	//foreach ( entity trigger in GetTriggersByClassesInRealms(
	//	["trigger_hurt"],
	//	hullPos, hullPos,
	//	player.GetRealms(), TRACE_MASK_PLAYERSOLID ) )
	//{
	//	int damageSourceId = (trigger.HasKey( "damageSourceId" ) ? int(trigger.kv.damageSourceId) : eDamageSourceId.damagedef_unknown)
	//	if (  damageSourceId == eDamageSourceId.damagedef_crush || damageSourceId == eDamageSourceId.fall || damageSourceId == eDamageSourceId.splat )
	//	{
	//		// don't allow bird to spawn in kill triggers
	//		return false
	//	}
	//}
	return true
}
#endif



#if SERVER
entity function TrackingVision_SpawnWhiteRaven( entity player, vector birdOrigin, vector birdAngles, bool isPerched = false )
{
	if( !IsValid( player ) )
		return null

	//key stuff to create the bird (model, team, script name, enemy to point to
	entity bird = CreatePropScript( $"mdl/creatures/bird/bird.rmdl", birdOrigin, birdAngles, SOLID_VPHYSICS ) //OriginToGround( origin )
	bird.SetSkin( 2 )
	bird.SetOwner( player )
	SetTeam( bird, player.GetTeam() )
	bird.SetScriptName( TRACKING_VISION_BIRD_SCRIPTNAME )
	//bird.e.lastAttacker = enemyTarget	//bit hacky, but there shouldn't be a "last attacker" here anyway

	//basically make the bird a figment of imagination
	bird.e.isDoorBlocker = false
	bird.SetPhysics( MOVETYPE_FLY )
	bird.SetTakeDamageType( DAMAGE_NO )
	bird.SetVisibilityFlags( ENTITY_VISIBLE_TO_OWNER ) //ENTITY_VISIBLE_TO_OWNER
	bird.SetCanBeMeleed( false )
	bird.NotSolid()

	//Temporary Solution. Might need to create a new WP and new RUI that has a rui that acts like a POI rui but has the funcitonality to be used as a Basic WP rui
	//float pingRadius = 20.0
	//vector pingOrigin = bird.GetOrigin() + <0,0,15>
	//entity traceBlocker = CreateTraceBlockerVolume( pingOrigin, pingRadius, false, CONTENTS_BLOCK_PING, player.GetTeam(), TRACKING_VISION_BIRD_PING_SCRIPTNAME )
	////DebugDrawCircle( birdOrigin, <0,0,0>, pingRadius, COLOR_AQUA, true, 30 )
	//traceBlocker.RemoveFromAllRealms()
	//traceBlocker.AddToOtherEntitysRealms( bird )
	//traceBlocker.SetParent( bird )

	Highlight_SetFriendlyHighlight( bird, "sp_interact_object" )

	AddSonarDetectionForPropScript( bird )

	Remote_CallFunction_NonReplay( player, "ServerToClient_ActivateWhiteRavenIconRUI", player, bird )

	if( isPerched )
	{
		//usable by players - check to see if the prompt appears even if you can't use it (i.e. not Bloodhound)
		bird.SetUsable()
		bird.SetUsableByGroup( "pilot" )
		bird.SetUsePrompts( "#GEAR_TRACKING_VISION_OBJECT_BIRD_POINTER_USE", "#GEAR_TRACKING_VISION_OBJECT_BIRD_POINTER_USE" )
		SetCallback_CanUseEntityCallback( bird, TrackingVision_CanUseBirdPointerEntityCallback )
		AddCallback_OnUseEntity_ClientServer( bird, TrackingVision_OnBirdPointerUsed )

		Remote_CallFunction_NonReplay( player, "ServerToClient_ActivateWhiteRavenPerchedFX", player, bird )
	}

	//play an animation
	bird.Anim_Play( "Bird_casual_idle" )

	#if DEVELOPER
	if( DEBUG_WHITE_RAVEN_DRAW )
	{
		DebugDrawSphere( bird.GetOrigin() + <0, 0, 10>, 10, int(COLOR_DARK_GREEN.x), int(COLOR_DARK_GREEN.y), int(COLOR_DARK_GREEN.z), true, 10.0 )
	}
	#endif
	return bird
}
#endif //SERVER


#if SERVER
WhiteRavenInfo function TrackingVision_CreateWhiteRavenData( entity ent, entity bird, vector targetPos, entity enemyTarget = null )
{
	WhiteRavenInfo whiteRavenData
	whiteRavenData.whiteRavenActive = true
	whiteRavenData.whiteRavenFlight = bird
	whiteRavenData.perchInitTime = Time()

	vector perchPos = WhiteRaven_GetValidPerchPos( ent, targetPos )
	whiteRavenData.perchPos			= perchPos

	if( IsValid( enemyTarget ) )
		whiteRavenData.target 		= enemyTarget

	return whiteRavenData
}
#endif //SERVER


#if SERVER
void function TrackingVision_CreateWhiteRavenInFlight( entity player, int targetType, bool fromUlt = false )
{
	if( !IsValid( player ) )
		return

	Signal( player, "OnActivate_WhiteRaven" )
	thread TrackingVision_CreateWhiteRavenInFlight_Thread( player, targetType, fromUlt )
}

void function TrackingVision_CreateWhiteRavenInFlight_Thread( entity player, int targetType, bool fromUlt )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )

	OnThreadEnd(
		function() : ( player )
		{
			if( player in file.whiteRavenPlayerData )
			{
				WhiteRavenInfo whiteRavenData = file.whiteRavenPlayerData[player]

				entity flightBird 	= whiteRavenData.whiteRavenFlight
				entity perchBird	= whiteRavenData.whiteRavenPerched
				if( IsValid( flightBird ) )
					flightBird.Destroy()

				if( IsValid( perchBird ) )
					perchBird.Destroy()

				if( player in file.whiteRavenPlayerData && !WHITE_RAVEN_PERCH_AT_TARGET )
					delete file.whiteRavenPlayerData[ player ]
			}
		}
	)

	WhiteRavenInfo whiteRavenData
	if( !( player in file.whiteRavenPlayerData ) )
		file.whiteRavenPlayerData[player] <- whiteRavenData

	entity target
	vector targetPos


	if( targetType == eWhiteRavenTargetType.POI )
	{
		PerchInfo perchData = WhiteRaven_GetBestSpawnLocationData( player )
		if( !perchData.validPerch )
			return

		targetPos = perchData.perchPos
	}

	if ( targetType == eWhiteRavenTargetType.ENEMY )
	{
		target = WhiteRaven_GetNearestEnemyTarget( player )
		if( !IsValid(target) )
			return

		targetPos = target.GetOrigin()
	}

	//todo: Deathbox flyout TBD - Will investigate what the right deathbox version is after initial trials
	//if( targetType == eWhiteRavenTargetType.DEATHBOX )
	//{
	//	entity closestDeathbox
	//	float closestDeathboxDist = WHITE_RAVEN_DEATHBOX_DISCOVERY_RANGE
	//	vector origin = player.GetOrigin()
	//
	//	array< entity > deathboxArray = GetAllDeathBoxes()
	//	foreach ( deathbox in deathboxArray)
	//	{
	//		if( !IsValid( deathbox ) )
	//			continue
	//
	//		float distToBox = Distance( origin, deathbox.GetOrigin() )
	//		if( distToBox < 100 ) // too close
	//			continue
	//
	//		if( distToBox < closestDeathboxDist )
	//		{
	//			closestDeathboxDist = distToBox
	//			closestDeathbox = deathbox
	//		}
	//	}
	//
	//	target 				= closestDeathbox
	//	targetPos			= closestDeathbox.GetOrigin()
	//}

	////////////////////////////////////
	//Spawn a White Raven in Flight
	vector dir 			= Normalize( FlattenVec( player.GetViewVector() ) )
	vector birdOrigin 	= player.GetOrigin() + <0,0,WHITE_RAVEN_FLIGHT_SPAWN_HEIGHT_OFFSET>
	birdOrigin = birdOrigin - dir * WHITE_RAVEN_FLIGHT_SPAWN_DIST_OFFSET
	vector birdAngles	= player.GetAngles()

	entity bird = TrackingVision_SpawnWhiteRaven( player, birdOrigin, birdAngles, false )

	//This means that if we do our tac, we won't try and "use" the bird as it has already been used (IE its in flight,  flying towards a target, we don't want to give any tac/ult ammo refunds etc)
	bird.e.isBusy = true

	whiteRavenData = TrackingVision_CreateWhiteRavenData( player, bird, targetPos, target )
	file.whiteRavenPlayerData[ player ] <- whiteRavenData

	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_DRAW )
			printt( "SPAWN WHITE RAVEN  -> In Flight" )
	#endif

	TrackingVision_CreateWhiteRavenPingPath( player, whiteRavenData )

	file.whiteRavenPlayerData[player].perchInitTime = Time() //Reset Perch Init to restart Spawn Tracking Timer

	waitthread WhiteRaven_FlyToTarget_Thread( player, bird, whiteRavenData.perchPos, false, fromUlt )

	if( !IsValid( player ) )
		return

	///////////////////////////////////
	//Spawn the Perched White Raven

	if( WHITE_RAVEN_PERCH_AT_TARGET )
		waitthread TrackingVision_CreateWhiteRavenPerched_Thread( player, whiteRavenData.perchPos, WHITE_RAVEN_BIRD_LIFETIME_LONG )
	else
	{
		Signal( player, "OnReset_SpawnTracking" )
		thread TrackingVision_WhiteRavenSpawnTracking_Thread( player )
	}

}

void function TrackingVision_CreateWhiteRavenPerched_Thread( entity player, vector perchPos, float birdLifetime )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )

	if( !IsValid(player) )
		return
	///////////////////////////////////
	//Spawn the Perched White Raven

	vector birdOrigin = perchPos
	vector birdAngles = VectorToAngles( FlattenVec( player.GetOrigin() - birdOrigin ) )
	entity perchedBird = TrackingVision_SpawnWhiteRaven( player, birdOrigin, birdAngles, true )

	if( !( player in file.whiteRavenPlayerData ) )
	{
		WhiteRavenInfo whiteRavenData = TrackingVision_CreateWhiteRavenData( player, perchedBird, perchPos, null )
		file.whiteRavenPlayerData[ player ] <- whiteRavenData
	}

	waitthread WhiteRaven_Perched_Idle_Thread( player, perchedBird, birdLifetime )

}
#endif //SERVER


#if SERVER
CompanionFlightParams function GetWhiteRavenCompanionFlightData()
{
	CompanionFlightParams flightData = GetDefaultFlightParams()

	flightData.entSpeed				= WHITE_RAVEN_BASE_SPEED
	flightData.initHeightOffset		= WHITE_RAVEN_INIT_HEIGHT_OFFSET
	flightData.maxPathLength		= WHITE_RAVEN_DEFAULT_MAX_PATH_LENGTH
	flightData.maxLengthRatio 		= WHITE_RAVEN_PATHFIND_MAX_LENGTH_RATIO
	flightData.maxTimeDiff 			= WHITE_RAVEN_PATHFIND_MAX_TIME_DIFF
	flightData.eBailCondition		= ePathfindingBailCondition.TIME_AND_RATIO

	return flightData
}
#endif

const float UPDATE_RATE = 1.0

#if SERVER
void function WhiteRaven_FlyToTarget_Thread( entity player, entity bird, vector perchPos, bool isPerched = false, bool fromUlt = false )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( bird, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )

	if( !IsValid( player ) )
		return

	vector playerViewVec = FlattenVec( Normalize( player.GetViewVector() ) )
	vector birdPos = bird.GetOrigin()
	vector birdAngles
	vector targetPos = perchPos

	if( !isPerched )
		birdAngles = VectorToAngles( playerViewVec )
	else
		birdAngles = bird.GetAngles()

	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_DRAW )
		{
			DebugDrawSphere( birdPos, 15, int(COLOR_AQUA.x), int(COLOR_AQUA.y), int(COLOR_AQUA.z), true, 2.0 )
			DebugDrawSphere( perchPos, 20, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 2.0 )
		}
	#endif


	///////////// CREATE BIRD MOVER
	entity mover = CreateScriptMover( TRACKING_VISION_BIRD_MOVER_SCRIPTNAME, birdPos, birdAngles )
	mover.RemoveFromAllRealms()
	mover.AddToOtherEntitysRealms( bird )
	bird.SetParent( mover )
	bird.UnsetUsable()
	bird.SetUsePrompts( "#EMPTY_STRING", "#EMPTY_STRING" )

	RegisterNavMesh_EntityMemory( mover, HULL_HUMAN )

	EndSignal( mover, "OnDestroy" )

	array< entity > fxArray

	//Trail FX
	int fxId = GetParticleSystemIndex( TRACKING_VISION_BIRD_TRAIL )
	entity fx_dissolve = StartParticleEffectOnEntity_ReturnEntity( bird, fxId, FX_PATTACH_ABSORIGIN_FOLLOW, bird.LookupAttachment( "ORIGIN" ) )
	fx_dissolve.kv.VisibilityFlags = ENTITY_VISIBLE_TO_OWNER
	fx_dissolve.SetOwner( bird.GetOwner() )
	fxArray.append( fx_dissolve )

	// Fly-Out Sound Call //
	if( fromUlt )
	{
		EmitSoundOnEntityOnlyToPlayer( bird, player, WHITE_RAVEN_FLY_ULTIMATE_SFX )
	}
	else
		EmitSoundOnEntityOnlyToPlayer( bird, player, WHITE_RAVEN_FLY_SFX )

	//Adjust the Flight Position to the Ping Position//
	vector pingPos = TrackingVision_GetWhiteRavenPingPos( player, perchPos )

	OnThreadEnd(
		function() : ( bird, mover, player, fxArray )
		{
			if ( IsValid( bird ) )
				bird.Destroy()

			if ( IsValid( mover ) )
			{
				DeregisterNavMesh_EntityMemory( mover )
				mover.Destroy()
			}

			foreach( fx in fxArray )
			{
				if( IsValid( fx ) )
					EffectStop( fx )
			}

		}
	)
	//bird.e.isBusy = true
	//bird.Signal( "BirdFly" )

	vector forwardDir 		= mover.GetForwardVector()
	vector rightDir			= mover.GetRightVector()
	vector movementVector 	= perchPos - birdPos

	mover.SetAbsForwardVector( movementVector )

	if( !isPerched && fromUlt)
	{
		/////////////////////////////////////////////////////// FLY FORWARD
		bird.Anim_Play( "Bird_fly_cycle_long_no_root_motion" ) //"Bird_react_fly_small" )

		vector curVel = player.GetVelocity()
		float curSpeed = Length(curVel)
		float initPosMultiplier = GraphCapped( curSpeed, 125, 300, 1.75, 10 ) //Walk = 173 // Run = 260
		vector initFlightPos = birdPos + playerViewVec * WHITE_RAVEN_FLY_AHEAD_DISTANCE * initPosMultiplier
		array<entity> ignoreArray = GetPlayerArray()

		TraceResults trLOS = TraceLine( player.EyePosition(), initFlightPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
		if ( trLOS.fraction < 0.95 ) //We're looking at a wall or a hill
		{
			printt( DotProduct( UP_VECTOR, trLOS.surfaceNormal ) )
			if( DotProduct( UP_VECTOR, trLOS.surfaceNormal ) > 0.85 ) //We're on a hill. Let's try pushing the point up and use that end.
			{
				initFlightPos.z += WHITE_RAVEN_FLIGHT_HEIGHT_MIN*3
				TraceResults trHighLOS = TraceLine( player.EyePosition(), initFlightPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )

				initFlightPos = trHighLOS.endPos //either it's a new wall off the hill, or it's blue sky. Either way better, and we don't need perfection.
			}
			else // Just use where it hit, bird will correct immediately with pathing.
				initFlightPos = trLOS.endPos
		}

		mover.NonPhysicsRotateTo( VectorToAngles( playerViewVec ), 0.1, 0, 0  )
		mover.NonPhysicsMoveTo( initFlightPos, WHITE_RAVEN_FLY_AHEAD_TIME, 0.7, 0.0 )

		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
			{
				printt( "WHITE RAVEN FLYING FORWARD" )
				DebugDrawSphere( initFlightPos, 3, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), true, 5 )
				DebugDrawSphere( mover.GetOrigin(), 3, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 5 )
			}
		#endif

		//new - Wall Detection
		float flyAheadEndTime = Time() + WHITE_RAVEN_FLY_AHEAD_TIME

		while( Time() < flyAheadEndTime )
		{
			if( !IsValid( bird ) )
				return
			if( !IsValid( mover ) )
				return
			if( !IsValid( player ) )
				return

			//Wall Check
			ignoreArray = GetPlayerArray()
			vector fwdPos = mover.GetOrigin() + Normalize( FlattenVec( mover.GetForwardVector() ) ) * WHITE_RAVEN_FLY_AHEAD_WALL_TEST_DIST
			TraceResults trFwd = TraceLine( mover.GetOrigin(), fwdPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
			if( trFwd.startSolid || trFwd.fraction < 1 )
				break

			WaitFrame()
		}

		///////////////////////////////////////////////////// FLY-TURN TO PERCH POS
		if( !IsValid( bird ) )
			return
		if( !IsValid( mover ) )
			return
		if( !IsValid( player ) )
			return

		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
			{
				printt( "WHITE RAVEN TURNING" )
				DebugDrawSphere( initFlightPos, 3, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), true, 0.2 )
				DebugDrawSphere( mover.GetOrigin(), 3, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 0.2 )
			}
		#endif

		birdPos 				= mover.GetOrigin()
		forwardDir 				= mover.GetForwardVector()
		rightDir				= mover.GetRightVector()
		movementVector 			= perchPos - birdPos

		float dotDir 			= DotProduct( FlattenVec( Normalize( forwardDir ) ), FlattenVec( Normalize( movementVector ) ) )
		bool destIsLeft			= DotProduct( FlattenVec( Normalize( rightDir ) ), FlattenVec( Normalize( movementVector ) ) ) < 0

		float travelTime		= 0.5
		float bailTime 			= Time() + 5.0 //failsafe to exit the loop


		//Flight Turn Loop
		while( Time() < bailTime && dotDir < 0.9 )
		{
			if( !IsValid( bird ) )
				return
			if( !IsValid( mover ) )
				return
			if( !IsValid( player ) )
				return

			////Update the Bird Position/DirToTarget
			//printt( "DorDir:  " + dotDir )
			birdPos 			= mover.GetOrigin()

			//Wall Check
			ignoreArray = GetPlayerArray()
			vector fwdPos = mover.GetOrigin() + FlattenVec( Normalize( mover.GetForwardVector() ) ) * WHITE_RAVEN_FLY_AHEAD_WALL_TEST_DIST
			TraceResults trFwd = TraceLine( mover.GetOrigin(), fwdPos, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )

			if( trFwd.startSolid || trFwd.fraction < 1 )
				break

			//We're close enough
			vector fadePos = perchPos
			entity targetEnt

			if( player in file.whiteRavenPlayerData )
			{
				targetEnt = file.whiteRavenPlayerData[player].target
				if( IsValid( targetEnt ) )
					fadePos = targetEnt.GetOrigin()
			}

			if( Distance2D( birdPos, fadePos ) < WHITE_RAVEN_MIN_DIST_TO_FLIGHT_TARGET )
				break

			if( Distance2D( birdPos, perchPos ) < WHITE_RAVEN_MIN_DIST_TO_FLIGHT_TARGET )
				break

			vector destination 	= WhiteRaven_GetNextValidPos( mover, birdPos )
			destination = destination + FlattenVec( Normalize( mover.GetForwardVector() ) ) * WHITE_RAVEN_FLY_AHEAD_WALL_TEST_DIST
			mover.NonPhysicsMoveTo( destination, travelTime, 0.0, 0.0 )

			movementVector 	= perchPos - birdPos
			mover.NonPhysicsRotateTo( VectorToAngles(movementVector), 0.4, 0.2, 0.0 )

			#if DEVELOPER
				if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
				{
					DebugDrawSphere( birdPos, 3, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 1 )
					DebugDrawSphere( destination, 5, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), true, 1 )
				}
			#endif

			WaitFrame()

			if( !IsValid( mover ) )
				return

			birdPos 		= mover.GetOrigin()
			forwardDir		= mover.GetForwardVector()
			movementVector 	= perchPos - birdPos
			dotDir 			= DotProduct( FlattenVec(Normalize(forwardDir)), FlattenVec(Normalize(movementVector) ) )

			#if DEVELOPER
				if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
				{
					const float DEBUG_WHITE_RAVEN_ARROW_SIZE = 5
					//DebugDrawArrow( mover.GetOrigin(), mover.GetOrigin() + forwardDir * 50, DEBUG_WHITE_RAVEN_ARROW_SIZE, COLOR_RED, true, 0.3 )
					//DebugDrawArrow( mover.GetOrigin(), mover.GetOrigin() + movementVector * 50, DEBUG_WHITE_RAVEN_ARROW_SIZE, COLOR_BLUE, true, 0.3 )
				}
			#endif

		}
	}


	if( !IsValid( bird ) )
		return
	if( !IsValid( mover ) )
		return
	if( !IsValid( player ) )
		return

	////////////////////////////////////////////////////// FLY TO PERCH
	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
			printt( "WHITE RAVEN - FLY TO PERCH" )
	#endif

	//Set White Raven Flight Params//
	CompanionFlightParams flightData = GetWhiteRavenCompanionFlightData()

	birdPos 		= mover.GetOrigin()
	forwardDir		= mover.GetForwardVector()
	movementVector 	= perchPos - birdPos

	vector birdClosestNavMeshPos = birdPos //WhiteRaven_GetBestNavMeshPos( birdPos )
	vector destClosestNavMeshPos = WhiteRaven_GetBestNavMeshPos( perchPos )

	if( destClosestNavMeshPos == perchPos )
	{
		destClosestNavMeshPos = WhiteRaven_GetBestNavMeshPos( targetPos )
	}


	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
		{
			DebugDrawSphere( birdClosestNavMeshPos, 10, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 10 )
			DebugDrawSphere( destClosestNavMeshPos, 10, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), true, 10 )
		}
	#endif

	if( isPerched )
		mover.NonPhysicsRotateTo( VectorToAngles( movementVector ), 4.5, 0.5, 0.5  )
	else
		mover.NonPhysicsRotateTo( VectorToAngles( movementVector ), 0.3, 0.0, 0.0  )

	if( isPerched )
		bird.Anim_Play( "Bird_fly_cycle_long_no_root_motion" )

	//Create the PathData to determine if we have a valid path
	CompanionPathData pathData = GetCompanionPathData( mover, birdPos, destClosestNavMeshPos, birdPos.z, flightData )

	//Choose Pathfinding Type//
	if( !pathData.isValidFullPath )
	{
		waitthread WhiteRaven_DoBasicFlight_Thread( player, bird, mover, perchPos, fromUlt )
	}
	else
	{
		waitthread WhiteRaven_DoPathfindingFlight_Thread( player, bird, mover, perchPos, pathData, flightData, fromUlt )
	}

	waitthread WhiteRaven_FadeBird( bird )

}
#endif // SERVER

#if SERVER
void function WhiteRaven_DoBasicFlight_Thread( entity player, entity bird, entity mover, vector perchPos, bool fromUlt = false )
{

	if( !IsValid( bird ) )
		return
	if( !IsValid( mover ) )
		return
	if( !IsValid( player ) )
		return

	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )
	EndSignal( bird, "OnDestroy" )
	EndSignal( mover, "OnDestroy" )

	float flyTime = Time() + WHITE_RAVEN_FLIGHT_TIME
	float travelTime = 5 								//Travel time to next point - allows for a "mock" accelleration

	if( fromUlt )
		travelTime = 0.2

	// Original Simple Bird Flight - Flies ahead towards perchPos direction every frame following terrain//
	while( Time() < flyTime )
	{
		if( !IsValid( bird ) )
			return
		if( !IsValid( mover ) )
			return
		if( !IsValid( player ) )
			return


		if( travelTime < 0.2 )
			travelTime = 0.2

		////Update the Bird Position/DirToTarget
		vector birdPos 			= mover.GetOrigin()

		//We're close enough
		if( Distance2D( birdPos, perchPos ) < WHITE_RAVEN_MIN_DIST_TO_FLIGHT_TARGET )
			break

		vector destination 	= WhiteRaven_GetNextValidPos( mover, birdPos, true )
		mover.NonPhysicsMoveTo( destination, travelTime, 0.0, 0.0 )

		vector movementVector 	= perchPos - birdPos
		mover.NonPhysicsRotateTo( VectorToAngles(movementVector), 0.3, 0.2, 0.0 )

		travelTime = travelTime - 1

		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_FLIGHT_DRAW )
			{
				DebugDrawSphere( birdPos, 3, int(COLOR_CYAN.x), int(COLOR_CYAN.y), int(COLOR_CYAN.z), true, 1 )
				DebugDrawSphere( destination, 5, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), true, 1 )
			}
		#endif

		WaitFrame()

		if( !IsValid( mover ) )
			return

		birdPos 		= mover.GetOrigin()
		movementVector 	= perchPos - birdPos

	}

}

#endif //SERVER

#if SERVER
void function WhiteRaven_DoPathfindingFlight_Thread( entity player, entity bird, entity mover, vector perchPos, CompanionPathData pathData, CompanionFlightParams flightData, bool fromUlt )
{

	if( !IsValid( bird ) )
		return
	if( !IsValid( mover ) )
		return
	if( !IsValid( player ) )
		return

	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )
	EndSignal( bird, "OnDestroy" )
	EndSignal( mover, "OnDestroy" )

	//Set Nodes & Adjust Height//
	printt( "NumPathNodes:   " + pathData.pathPoints.len() )

	vector birdPos = mover.GetOrigin()
	vector startPos = birdPos
	vector echoPrevPos = birdPos

	//////////// Setup the CompanionData based on the chosen path //////////////////

	CompanionData currentCompanionData
	file.companionData[player] <- currentCompanionData

	currentCompanionData.orderRoute = pathData.pathPoints
	currentCompanionData.remainingPathNodes = (pathData.pathPoints.len() - 1)
	currentCompanionData.startedMovingCloser = false

	//Get the Ground Height for Path Points
	array<float> groundHeightArray = GetGroundHeightArrayForPath( pathData.pathPoints, pathData.pathPoints.len() )

	currentCompanionData.orderRoute[currentCompanionData.orderRoute.len() - 1] = perchPos
	currentCompanionData.indexHeightAdjusted.resize( currentCompanionData.orderRoute.len(), false )
	currentCompanionData.indexHeightAdjusted[currentCompanionData.orderRoute.len() - 1] = true

	//Adjust the Height of Path Points
	thread Companion_AdjustHeight_Thread( player, mover, perchPos, currentCompanionData, groundHeightArray, flightData )

	currentCompanionData.orderDidPathfinding = true

	TraceResults initTrace = TraceLine( currentCompanionData.orderRoute[0], birdPos, null, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT ) //TRACE_MASK_SHOT_HULL TRACE_MASK_SOLID
	if( initTrace.startSolid || initTrace.fraction < 0.98)
	{
		//Can occasionally target false navMesh below the terrain, as bird can perch on rocks that imbed through the ground with nav-generating geo.
		//Altering the first point if this happens to prevent diving into the earth. Should this be added to the groundHeightArray?
		if( currentCompanionData.orderRoute[0].z < birdPos.z )
			currentCompanionData.orderRoute[0] = <currentCompanionData.orderRoute[0].x, currentCompanionData.orderRoute[0].y, birdPos.z> //Can only set components on local vars - have to feed a full vector
	}

	vector toNextPoint  = (currentCompanionData.orderRoute[0] - birdPos)
	currentCompanionData.distanceToNextPoint = Length(toNextPoint)
	if ( currentCompanionData.distanceToNextPoint > 0.0 )
		currentCompanionData.dirToNextPoint = toNextPoint/currentCompanionData.distanceToNextPoint
	else
		currentCompanionData.dirToNextPoint = ZERO_VECTOR


	//////// Setup Complete ///////////

	if( !fromUlt )
		mover.NonPhysicsMoveTo( birdPos + UP_VECTOR * 50 , 1, 0.2, 0.2 )
	wait 0.5 //Give NavMesh a Chance

	if( !IsValid( player ) || !IsValid( bird ) || !(IsValid( mover )))
		return

	//////// Begin Flight ////////////

	const float WHITE_RAVEN_TAKEOFF_ACCEL_TIME = 1.0
	float flyTime 	= Time() + WHITE_RAVEN_FLIGHT_TIME
	float accelTime	= Time() + WHITE_RAVEN_TAKEOFF_ACCEL_TIME
	while( Time() < flyTime )
	{
		if ( !IsValid( bird ) )
			return
		if ( !IsValid( mover ) )
			return
		if ( !IsValid( player ) )
			return

		birdPos = mover.GetOrigin()
		vector currentVel        = mover.GetVelocity()
		float currentSpeed       = Length( currentVel )
		float angAccelMultiplier = 1

		//We're close enough
		if( Distance2D( birdPos, perchPos ) < WHITE_RAVEN_MIN_DIST_TO_FLIGHT_TARGET )
			break

		/////////// Pathfinding //////////////
		waitthread DoCompanionPathfinding( player, mover, perchPos, currentCompanionData )
		//////////////////////////////////////////////

		//we're keeping the turn rate consistent for the last step of pathfinding
		if ( currentCompanionData.orderDidPathfinding )
		{
			angAccelMultiplier = 3
		}

		//Set Destination of Next Node
		vector toGoalPos
		vector nextNode
		if( currentCompanionData.remainingPathNodes > 0 )
		{
			toGoalPos = currentCompanionData.orderRoute[currentCompanionData.currentPathNode] - birdPos
		}
		else
		{
			toGoalPos = perchPos - birdPos
		}

		//Figure out our speed
		float distance 			= Length( toGoalPos )
		float desiredSpeed 	= WHITE_RAVEN_BASE_SPEED

		if ( distance > WHITE_RAVEN_BASE_SPEED_RANGE )
		{
			desiredSpeed = GraphCapped( distance, WHITE_RAVEN_BASE_SPEED_RANGE, WHITE_RAVEN_MAX_SPEED_RANGE, WHITE_RAVEN_BASE_SPEED, WHITE_RAVEN_MAX_SPEED )
		}
		else if ( distance < WHITE_RAVEN_SLOW_SPEED_RANGE )
		{
			float minSpeed = 0
			if ( currentCompanionData.remainingPathNodes > 0 )
			{
				vector previousGoalToCurrentGoal
				int currentNode = currentCompanionData.currentPathNode
				if ( currentNode > 0 )
				{
					previousGoalToCurrentGoal = Normalize(currentCompanionData.orderRoute[currentNode] - currentCompanionData.orderRoute[currentNode - 1])
				}
				else
				{
					previousGoalToCurrentGoal = Normalize(currentCompanionData.orderRoute[currentNode] - birdPos)
				}
				vector currentGoalToNextGoal = Normalize(currentCompanionData.orderRoute[currentCompanionData.currentPathNode + 1] - currentCompanionData.orderRoute[currentCompanionData.currentPathNode])

				float currentToNextDot = DotProduct( previousGoalToCurrentGoal, currentGoalToNextGoal )
				if ( currentToNextDot < 0.25 )
				{
					//if we always use this speed, echo won't stop at final position, so only use this speed when not at end of path
					minSpeed = WHITE_RAVEN_BASE_SPEED * 0.25
					desiredSpeed = GraphCapped( distance, 0.0, WHITE_RAVEN_SLOW_SPEED_RANGE, minSpeed, WHITE_RAVEN_BASE_SPEED )
				}
			}
			else
			{
				desiredSpeed = GraphCapped( distance, 0.0, WHITE_RAVEN_SLOW_SPEED_RANGE, minSpeed, WHITE_RAVEN_BASE_SPEED )
			}
		}

		//Take-Off Speed Adjust
		if( Time() < accelTime )
		{
			float timeFrac = Time() / accelTime
			desiredSpeed = GraphCapped( timeFrac, 0, 1, desiredSpeed*0.25, desiredSpeed )
		}


		//Determine our Forward Direction & Actual Speed
		vector toGoalNorm = Normalize( toGoalPos )
		vector newFwd   = Normalize( SlerpVector( mover.GetForwardVector(), toGoalNorm, 0.5 ) )
		if ( currentSpeed <= WHITE_RAVEN_LOW_SPEED_THRESHOLD )
		{
			mover.SetAbsForwardVector( newFwd  )
		}

		vector companionFwd 	= mover.GetForwardVector()
		float dot         		= DotProduct( companionFwd, toGoalNorm )
		float degreesToTarget 	= (acos( dot ) * 180 / PI)

		float angAccel = GraphCapped( desiredSpeed, 0.0, WHITE_RAVEN_BASE_SPEED, WHITE_RAVEN_ANG_ACCEL_MAX_SPEED, WHITE_RAVEN_ANG_ACCEL_LOW_SPEED )
		angAccel *= angAccelMultiplier

		float lerpFrac = 0
		if ( degreesToTarget > 0 )
		{
			lerpFrac  = min( (angAccel * UPDATE_RATE) / degreesToTarget, 1.0)
		}

		float lowSpeed    = min( WHITE_RAVEN_BASE_SPEED*0.5, desiredSpeed*0.5)
		float actualSpeed = GraphCapped( degreesToTarget, 0, 90, desiredSpeed, lowSpeed )

		vector newDir   = Normalize( SlerpVector( companionFwd, toGoalNorm, lerpFrac ) )

		//Move the White Raven
		mover.NonPhysicsMoveWithGravity( newDir * actualSpeed, < 0, 0, 0 > )

		// This bit flattens out our trajectory
		if ( actualSpeed <= WHITE_RAVEN_LOW_SPEED_THRESHOLD )
		{
			newDir = FlattenVec( newDir )
		}
		mover.SetAbsForwardVector( newDir  )

		wait UPDATE_RATE
	}

}
#endif //SERVER

#if SERVER
void function WhiteRaven_Perched_Idle_Thread( entity player, entity bird, float birdLifetime )
{
	EndSignal( bird, "BirdFly", "OnDestroy" )
	EndSignal( player, "OnDeath", "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )

	#if DEVELOPER
		if( DEBUG_WHITE_RAVEN_DRAW )
			printt( "BIRD IDLE" )
	#endif

	vector perchPos = bird.GetOrigin()

	OnThreadEnd(
		function() : ( player, bird, perchPos )
		{
			#if DEVELOPER
				if( DEBUG_WHITE_RAVEN_DRAW )
					printt( "BIRD IDLE COMPLETE" )
			#endif

			if ( IsValid( bird ) )
			{
				StopSoundOnEntity( bird, WHITE_RAVEN_AMBIENT_ETHEREAL_SFX )
				if( IsValid( player ) )
					EmitSoundAtPositionOnlyToPlayer( TEAM_UNASSIGNED, perchPos, player, WHITE_RAVEN_AMBIENT_ETHEREAL_DISSIPATE_SFX )
			}

			if ( IsValid( bird ) && !bird.e.isBusy )
				bird.Destroy()

			if( player in file.whiteRavenPlayerData )
				delete file.whiteRavenPlayerData[player]

			if( IsValid( player ) )
			{
				Signal( player, "OnReset_SpawnTracking" )
				thread TrackingVision_WhiteRavenSpawnTracking_Thread( player )
			}
		}
	)

	if( player in file.whiteRavenPlayerData )
	{
		file.whiteRavenPlayerData[ player ].perchInitTime = Time()
		file.whiteRavenPlayerData[ player ].whiteRavenPerched = bird
	}

	bird.e.isBusy = false

	//play an animation
	bird.Anim_Play( "Bird_casual_idle" )

	//Emit initial Caw SFX
	EmitSoundOnEntityOnlyToPlayer( bird, player, WHITE_RAVEN_FLY_IN_SFX )

	bool showMapIcon = false
	bool iconActive = false

	array<entity> teamArray
	float birdDeathTime = Time() + birdLifetime
	float previousDist	= 100000
	float lastPulseTime = 0
	float prevTime = Time()
	bool firstTime = true

	                    
		if( UpgradeCore_IsEnabled() && PlayerHasPassive( player, ePassives.PAS_AUTO_WHITE_RAVEN_SPAWN ) )
		{
			thread TrackingVision_AutoDetectEnemyTracking_Thread( player, bird )
		}
       
	while ( Time() < birdDeathTime )
	{
		if( !IsValid( player ) )
			return

		if( !IsValid( bird ) )
			return

		vector origin 		= player.GetOrigin()
		vector birdOrigin	= bird.GetOrigin()
		float distToBird = Distance2D( origin, birdOrigin )

		//Destroy Birds in Deathfield
		DeathFieldData deathFieldData = SURVIVAL_GetDeathFieldData( Survival_Loot_GetDefaultRealm() )
		bool isInRing                 = SURVIVAL_PosInsideDeathField( Survival_Loot_GetDefaultRealm(), birdOrigin )
		if( !isInRing )
			return

		if( distToBird < GetRavenRefreshDistance( player ) )
		{
			birdDeathTime = birdDeathTime + ( Time() - prevTime )
			#if DEVELOPER
				if( DEBUG_WHITE_RAVEN_DRAW )
				{
					printt( "BIRD IDLE -> PLAYER NEARBY, DO NOT DESTROY:   " + birdDeathTime  )
					DebugDrawCircle( birdOrigin, <0,0,0>, GetRavenRefreshDistance( player ), COLOR_AQUA, true, 0.1 )
				}
			#endif
		}

		if( Time() > lastPulseTime && !showMapIcon )
		{
			vector dirToBird		= Normalize( FlattenVec( birdOrigin - origin ) )
			vector pingPos 			= origin + dirToBird * WHITE_RAVEN_PING_DIST_MAX

			if( distToBird <  WHITE_RAVEN_PING_DIST_MAX )
				pingPos = birdOrigin

			//Ping Pulse to indicate Bird Audio position
			Minimap_RingPulseForPlayer( player, birdOrigin, 300 , TRACKING_VISION_DIRECTION_LIFETIME, 1, TEAM_COLOR_FRIENDLY / 255.0 ) //COLOR_ORANGE
			Minimap_RingPulseForPlayer( player, birdOrigin, 30 , TRACKING_VISION_DIRECTION_LIFETIME, 4, TEAM_COLOR_FRIENDLY / 255.0)

			// Bird Call Audio
			if( WHITE_RAVEN_USE_OFFSET_BIRDCALL_AUDIO )
			{
				//Ideally, we just have the Audio come from the source object and the falloff is perfect.
				//Given the temp audio, I have hacked in a positional call that beckons you in the direction of the source to hint at this for now.
				const float WHITE_RAVEN_AUDIO_DIRECTIONAL_CALL_RANGE = 700

				//Ideally we can just make the bird call from the source. Needs audio support - for now, we fake it.
				vector sfxPos			= player.EyePosition() + dirToBird * WHITE_RAVEN_AUDIO_DIRECTIONAL_CALL_RANGE
				vector offsetSoundPos = sfxPos
				if( distToBird < WHITE_RAVEN_AUDIO_DIRECTIONAL_CALL_RANGE )
					offsetSoundPos = birdOrigin

				#if DEVELOPER
					if( DEBUG_WHITE_RAVEN_DRAW )
					{
						DebugDrawSphere( offsetSoundPos, 5, int(COLOR_AQUA.x), int(COLOR_AQUA.y), int(COLOR_AQUA.z), true, 15 )
					}
				#endif

				EmitSoundAtPosition( TEAM_UNASSIGNED, offsetSoundPos, WHITE_RAVEN_AMBIENT_CAW_SFX )
			}
			else
			{
				if( !firstTime )
					EmitSoundOnEntityOnlyToPlayer( bird, player, WHITE_RAVEN_AMBIENT_CAW_SFX )

				firstTime = false
			}


			lastPulseTime = Time() + TRACKING_VISION_DIRECTION_LIFETIME + 5
		}

		prevTime = Time()

		WaitFrame()
	}

	bird.UnsetUsable()
	bird.SetUsePrompts( "#EMPTY_STRING", "#EMPTY_STRING" )

	waitthread WhiteRaven_FadeBird( bird )
}
#endif

#if SERVER
vector function WhiteRaven_GetBestNavMeshPos( vector targetPos )
{
	vector bestPos = targetPos

	//todo: If we can get Pathfinding Movement to work - figure out how to find this WEDGE point instead.
	//vector and desiredPosition | vector & wedgePosition
	//int birdClosestNavMeshNode = NavMeshNode_GetBestNodeForPosInWedge( destDir, birdDir, 180, 90, 90, 5, 0, 0 )

	int closestNavMeshNode = NavMeshNode_GetNearestNodeToPos( targetPos )
	if ( closestNavMeshNode == -1 )
	{
		//DebugDrawLine( targetPos, targetPos + <0,0,100>, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 5.0 )
		targetPos = OriginToGround( targetPos )
		closestNavMeshNode = NavMeshNode_GetNearestNodeToPos( targetPos )

		if ( closestNavMeshNode == -1 )
		{
				return bestPos
		}
	}

	bestPos = NavMeshNode_GetNodePos( closestNavMeshNode )
	return bestPos
}
#endif

#if SERVER
vector function WhiteRaven_GetNextValidPos(entity mover, vector pos, bool isDirectFlight = false )
{
	vector nextValidPos = pos
	entity owner = mover.GetOwner()
	array<entity> ignoreArray 	= GetPlayerArray()

	vector dir = mover.GetForwardVector()
	dir = Normalize( FlattenVec( dir ) )

	const float WHITE_RAVEN_STEP_DIST 				= 64.0
	const float WHITE_RAVEN_STEP_DIST_DIRECT		= 128.0
	const float WHITE_RAVEN_CLIMB_HEIGHT			= 128.0

	vector newPos = pos + dir * WHITE_RAVEN_STEP_DIST
	if( isDirectFlight )
		newPos = pos + dir * WHITE_RAVEN_STEP_DIST_DIRECT

	vector traceStart = pos
	vector traceEndUnder = <newPos.x, newPos.y, traceStart.z >
	vector traceEndOver = <newPos.x, newPos.y, traceStart.z + WHITE_RAVEN_CLIMB_HEIGHT>

	TraceResults forwardTrace = TraceLine( traceStart, traceEndUnder, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT ) //TRACE_MASK_SHOT_HULL TRACE_MASK_SOLID
	if( !isDirectFlight )
		nextValidPos = forwardTrace.endPos
	else
		nextValidPos = newPos // Go forward, even through walls //

	if ( forwardTrace.fraction == 1.0 && !forwardTrace.startSolid ) //Found NOTHING ahead!
	{
		//Check for too close to ground
		TraceResults downTrace = TraceLine( forwardTrace.endPos, forwardTrace.endPos + <0.0, 0.0, -WHITE_RAVEN_FLIGHT_HEIGHT_MIN>, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
		if ( downTrace.fraction < 1.0 ) //FOUND A CLIFF
			nextValidPos = downTrace.endPos + <0,0,WHITE_RAVEN_FLIGHT_HEIGHT_MIN>
	}
	else // FOUND A WALL - Test for Step-Up
	{

		TraceResults upwardTrace = TraceLine( traceStart, traceEndOver, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
		if ( upwardTrace.fraction > 0.5 ) //We can climb this...
		{
			//Check for too close to ground
			TraceResults downTrace = TraceLine( forwardTrace.endPos, forwardTrace.endPos + <0.0, 0.0, -WHITE_RAVEN_FLIGHT_HEIGHT_MIN>, ignoreArray, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
			if ( downTrace.fraction < 1.0 ) //FOUND A CLIFF
				nextValidPos = downTrace.endPos + <0,0,WHITE_RAVEN_FLIGHT_HEIGHT_MIN/2>
		}
	}

	return nextValidPos
}
#endif // SERVER


#if SERVER
void function WhiteRaven_FadeBird( entity bird )
{
	//cool dissolve FX
	int fxId = GetParticleSystemIndex( TRACKING_VISION_BIRD_DISSOLVE )
	entity fx_dissolve = StartParticleEffectOnEntity_ReturnEntity( bird, fxId, FX_PATTACH_ABSORIGIN_FOLLOW, bird.LookupAttachment( "ORIGIN" ) )
	fx_dissolve.kv.VisibilityFlags = ENTITY_VISIBLE_TO_OWNER
	fx_dissolve.SetOwner( bird.GetOwner() )

	float fadeStartTime = Time()
	float fadeEndTime = fadeStartTime + 0.4
	bird.kv.rendermode = 4 //Rendmode TransAlpha
	while ( ( Time() <= fadeEndTime ) && IsValid( bird ) )
	{
		float alphaResult = GraphCapped( Time(), fadeStartTime, fadeEndTime, 255, 0 )
		bird.kv.renderamt = alphaResult
		WaitFrame()
	}

	if( IsValid( bird ) )
		bird.Destroy()
}
#endif


bool function TrackingVision_CanUseBirdPointerEntityCallback( entity player, entity bird, int useFlags )
{

	if ( !PlayerHasPassive( player, ePassives.PAS_TRACKING_VISION ) )
		return false
	if ( Bleedout_IsBleedingOut( player ) )
		return false
	if ( player.ContextAction_IsActive() )
		return false
	if ( player.Player_IsSkywardLaunching() || player.Player_IsSkywardFollowing() )
		return false
	if ( !PlayerCommonItemPickupCheck( player ) )
		return false
	if ( !IsFriendlyTeam( player.GetTeam(), bird.GetTeam() ) )
		return false

	return true
}

void function TrackingVision_OnBirdPointerUsed( entity bird, entity player, int useFlags )
{

                       
                                              
        
      
#if CLIENT
	if ( !InPrediction() || !IsFirstTimePredicted() )
		return
#endif

#if SERVER
	if( IsValid( bird ) && IsValid( player ) )
	{
		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_DRAW )
				printt( "BIRD POINTER USED" )
		#endif
		thread TrackingVision_OnBirdPointerUsed_Thread( player, bird )
	}
#endif

}

#if SERVER
void function TrackingVision_OnBirdPointerUsed_Thread( entity player, entity bird, bool wasScanned = false, bool shouldRefundTac = false )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnEnd_WhiteRavenTracking" )

	OnThreadEnd(
		function() : ( player, bird )
		{
			if( IsValid( player ) )
			{
				if( player in file.whiteRavenPlayerData  && !WHITE_RAVEN_PERCH_AT_TARGET )
					delete file.whiteRavenPlayerData[player]
			}
		}
	)

	bird.e.isBusy = true 		//ensure's bird won't be destroyed when perched thread ends
	bird.Signal( "BirdFly" )
	Remote_CallFunction_NonReplay( player, "ServerToClient_DeactivateWhiteRavenPerchedFX", player, bird )

	//If we have old Raven Data - Clear it
	if( player in file.whiteRavenPlayerData )
		delete file.whiteRavenPlayerData[player]

	thread TrackingVision_GiveAbilityRefunds_Thread( player, shouldRefundTac )

	WhiteRavenInfo whiteRavenData
	entity closestEnemy = WhiteRaven_GetNearestEnemyTarget( player )

	if( IsValid(closestEnemy) )
	{
		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_DRAW )
			{
				printt( "WHITE RAVEN [POINTER] >> FLY TO ENEMY TARGET! " )
				DebugDrawSphere( closestEnemy.GetOrigin() + <0, 0, 15>, 10, int(COLOR_RED.x), int(COLOR_RED.y), int(COLOR_RED.z), true, 10.0 )
			}
		#endif


		whiteRavenData = TrackingVision_CreateWhiteRavenData( player, bird, closestEnemy.GetOrigin(), closestEnemy )
		file.whiteRavenPlayerData[ player ] <- whiteRavenData

		TrackingVision_CreateWhiteRavenPingPath( player, whiteRavenData, wasScanned )


		waitthread WhiteRaven_FlyToTarget_Thread( player, bird, whiteRavenData.perchPos, true, false )

		if( !IsValid( player ) )
			return

		if( WHITE_RAVEN_PERCH_AT_TARGET )
			waitthread TrackingVision_CreateWhiteRavenPerched_Thread( player, whiteRavenData.perchPos, WHITE_RAVEN_BIRD_LIFETIME_LONG )
		else
		{
			Signal( player, "OnReset_SpawnTracking" )
			thread TrackingVision_WhiteRavenSpawnTracking_Thread( player )
		}

	}
	else
	{
		#if DEVELOPER
			if( DEBUG_WHITE_RAVEN_DRAW )
			{
				printt( "THERE WERE NO ENEMIES..." )
			}
		#endif

		waitthread WhiteRaven_FadeBird( bird )
	}

}
#endif

vector function TrackingVision_GetWhiteRavenPingPos( entity player, vector perchPos )
{
	if( !IsValid( player ) )
		return perchPos

	//Find the Ping Pos
	vector playerOrigin 		= player.GetOrigin()
	vector dirToPerch			= Normalize( FlattenVec( perchPos - playerOrigin ) )
	vector pingPos 				= playerOrigin + dirToPerch * WHITE_RAVEN_PING_DIST_MAX
	float distToPerchPos 		= Distance2D( playerOrigin, perchPos )

	if( distToPerchPos <  WHITE_RAVEN_PING_DIST_MAX )
		pingPos = perchPos

	//Adjust Height of the PingPos
	float pingOffset = 0
	TraceResults pingDownTrace = TraceLine( pingPos, pingPos + <0.0, 0.0, -300>, GetPlayerArray(), TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_PLAYER_MOVEMENT )
	if( pingDownTrace.fraction < 0.98 )
		pingOffset = GraphCapped( pingDownTrace.fraction, 0, 1, WHITE_RAVEN_PING_OFFSET_HEIGHT_MAX, 0 )

	return pingPos + <0,0,pingOffset>
}

#if SERVER
void function TrackingVision_CreateWhiteRavenPingPath( entity player, WhiteRavenInfo whiteRavenData, bool wasScanned = false )
{

	foreach ( teammate in GetPlayerArrayOfTeam( player.GetTeam() ) )
	{
		if( !IsValid( teammate ) )
			continue

		vector pingPos = TrackingVision_GetWhiteRavenPingPos( teammate, whiteRavenData.perchPos )

		Remote_CallFunction_NonReplay( teammate, "TrackingVision_DisplayEnemyDirection_ServerCallback", whiteRavenData.perchPos, pingPos, VectorToAngles( -(whiteRavenData.perchPos - teammate.GetOrigin()) ) )

		entity bird = whiteRavenData.whiteRavenFlight
		thread TrackingVision_DelayedWhiteRavenPing_Thread( player, teammate, bird, pingPos, wasScanned )
	}

}
#endif //SERVER

#if SERVER
void function TrackingVision_DelayedWhiteRavenPing_Thread( entity player, entity teammate, entity bird, vector pingPos, bool wasScanned )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnActivate_WhiteRaven" )

	//Delay the call to allow Bloodhound a moment to watch & follow the Raven flyoff and comprehend.
	float waitTime = Time() + WHITE_RAVEN_PING_DELAY
	while ( Time() < waitTime )
	{
		if( !IsValid(bird) ) //If the bird reached its destination early, we can bail out of the delay
			break

		WaitFrame()
	}

	if( !IsValid( player ) || !IsValid( teammate ) )
		return

	if( teammate == player )
	{
		EmitSoundOnEntityOnlyToPlayer( player, teammate, BLOODHOUND_DIAG_FOLLOW_RAVEN_1P )
		TrackingVision_CreateWhiteRavenWaypoint( player, pingPos )
	}
	else
	{
		EmitSoundOnEntityOnlyToPlayer( player, teammate, BLOODHOUND_DIAG_FOLLOW_RAVEN_3P )
	}
	
}

#endif

#if SERVER
void function TrackingVision_CreateWhiteRavenWaypoint( entity owner, vector pingPos )
{
	if ( !IsValid( owner ) )
		return

	EndSignal( owner, "OnActivate_WhiteRaven" )

	entity wp = CreateWaypoint_BasicLocation( pingPos, ePingType.BLOODHOUND_WHITE_RAVEN_TARGET_LOC ) //AREA_VISITED //WE_GO
	wp.SetVisibilityFlags( ENTITY_VISIBLE_TO_FRIENDLY )
	wp.SetOwner( owner )
	wp.SetOnlyTransmitToSingleTeam( owner.GetTeam() )

	OnThreadEnd(
		function() : ( wp )
		{
			wp.Destroy()
		}
	)

	wait 15

}
#endif

#if SERVER
void function TrackingVision_GiveAbilityRefunds_Thread( entity player, bool shouldRefundTac )
{

	WaitFrame() //Ensures Tactical ammo is used first

	if( IsValid( player ) )
	{
		//refresh Tactical on Bird Scan
		if( WHITE_RAVEN_GIVES_TAC_CHARGE )
		{
			entity tacticalWeapon = player.GetOffhandWeapon( OFFHAND_TACTICAL )

			if( IsValid( tacticalWeapon ) )
			{
				float tacCharge = tacticalWeapon.GetWeaponPrimaryClipCount().tofloat()

				int curTacAmmo       	= tacticalWeapon.GetWeaponPrimaryClipCount()
				int maxTacAmmo          = tacticalWeapon.GetWeaponPrimaryClipCountMax()

				if( shouldRefundTac )
				{
					tacticalWeapon.SetWeaponPrimaryClipCountNoRegenReset( maxTacAmmo )
				}
				else if ( maxTacAmmo > 0 )
				{
					float tacRefund = maxTacAmmo.tofloat() * WHITE_RAVEN_TACTICAL_REFUND_FRAC
					tacCharge = curTacAmmo + tacRefund
					tacticalWeapon.SetWeaponPrimaryClipCountNoRegenReset( minint( tacCharge.tointeger(), maxTacAmmo)  )
				}
			}
		}

		bool giveUltCharge = WHITE_RAVEN_GIVES_ULT_CHARGE
		                    
		if( UpgradeCore_IsEnabled() )
		{
			giveUltCharge = PlayerHasPassive( player, ePassives.PAS_PAS_UPGRADE_TWO ) // upgrade_bloodhound_white_raven_ult_charge
		}
        

		//refresh Ultimate on Bird Scan
		if( giveUltCharge )
		{
			entity ultWeapon = player.GetOffhandWeapon( OFFHAND_ULTIMATE )

			if( IsValid( ultWeapon ) )
			{
				float ultCharge = ultWeapon.GetWeaponPrimaryClipCount().tofloat()

				int curUltAmmo       	= ultWeapon.GetWeaponPrimaryClipCount()
				int maxUltAmmo          = ultWeapon.GetWeaponPrimaryClipCountMax()

				if ( maxUltAmmo > 0 )
				{
					float ultRefund = maxUltAmmo.tofloat() * WHITE_RAVEN_ULTIMATE_REFUND_FRAC
					ultCharge = curUltAmmo + ultRefund
					ultWeapon.SetWeaponPrimaryClipCountNoRegenReset( minint( ultCharge.tointeger(), maxUltAmmo)  )
				}
			}


		}
	}
}
#endif

                    
#if SERVER
void function TrackingVision_AutoDetectEnemyTracking_Thread( entity player, entity bird )
{
	EndSignal( player, "OnActivate_WhiteRaven" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDeath" )
	EndSignal( bird, "OnDestroy" )
	EndSignal( bird, "BirdFly" )

	const float WHITE_RAVEN_AUTO_RAVEN_COOLDOWN_TIME = 60.0

	bool enemiesWereClose = false
	float lastWhiteRavenSpawn = -60
	while( IsValid( player ) && IsValid( bird ) )
	{
		if( bird.e.isBusy ) // bird's already in flight - bail
			return

		int myTeam = player.GetTeam()
		array< entity > players = GetPlayerArray_Alive()
		float closeThreshold = GetRavenCloseEnemyDistance( player )
		bool enemyInCloseRange = false

		foreach( otherPlayer in players )
		{
			if( otherPlayer.GetTeam() == myTeam )
				continue

			float distSqr = DistanceSqr( otherPlayer.GetOrigin(), player.GetOrigin() )
			if( distSqr < ( closeThreshold * closeThreshold ) )
			{
				enemyInCloseRange = true
			}
		}

		if( enemyInCloseRange != enemiesWereClose )
		{
			float curTime = Time()
			if( enemyInCloseRange && ( curTime - lastWhiteRavenSpawn ) >  WHITE_RAVEN_AUTO_RAVEN_COOLDOWN_TIME )
			{
				thread TrackingVision_OnBirdPointerUsed_Thread( player, bird, false, false )
				lastWhiteRavenSpawn = curTime
			}
			enemiesWereClose = enemyInCloseRange
		}

		Wait( .5 )
	}
}
#endif
      

