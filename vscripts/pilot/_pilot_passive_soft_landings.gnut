global function PassiveSoftLandings_Init

#if DEVELOPER
global function DEV_PassiveSoftLandings_ForceStart
#endif //DEVELOPER

const float PASSIVE_SOFTLANDINGS_EFFECT_DURATION = 1.0
const bool PASSIVE_SOFTLANDINGS_DEBUG = false

const string SOUND_SOFTLANDINGS_3P = "Nova_Passive_SoftLanding_3P"

struct SoftLandingsStatusEffectIndexes
{
	int softLandingsVisualsID
}

struct
{
	table<entity, SoftLandingsStatusEffectIndexes> playerStatusEffects
} file


void function PassiveSoftLandings_Init()
{
	RegisterSignal( "passive_softLandings_stop_plane_wait" )
	RegisterSignal( "passive_softLandings_stop_ability" )
	AddCallback_OnPassiveChanged( ePassives.PAS_NOVA, PassiveSoftLandings_OnPassiveChanged )
}

void function PassiveSoftLandings_OnPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	if ( didHave )
	{
		player.Signal( "passive_softLandings_stop_plane_wait" )
		player.Signal( "passive_softLandings_stop_ability" )
	}

	if ( nowHas )
	{
		thread PassiveSoftLandings_WaitForPlaneJump( player )
	}
}

void function PassiveSoftLandings_WaitForPlaneJump( entity player )
{
	Assert ( IsNewThread(), "Must be threaded off" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "passive_softLandings_stop_plane_wait" )

	thread PassiveSoftLandings_HardLandingThread( player )

}

const float HARD_LANDINGS_Z_VELOCITY_THRESHOLD = -800

void function PassiveSoftLandings_HardLandingThread( entity player )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "passive_softLandings_stop_ability" )

	SoftLandingsStatusEffectIndexes statusEffectIndexes
	file.playerStatusEffects[ player ] <- statusEffectIndexes

	OnThreadEnd(
		function() : ( player )
		{
			#if DEVELOPER
			if ( PASSIVE_SOFTLANDINGS_DEBUG )
			{
				printt("PassiveSoftLandings_HardLandingThread ENDED" )
			}
			#endif //DEV
		}
	)

	bool wasInAir       = false
	float minVelocityZ  = 0.0
	float maxHeightAbsZ = -10000.0
	while ( true )
	{
		if ( player.IsZiplining() )
		{
			#if DEVELOPER
			if ( PASSIVE_SOFTLANDINGS_DEBUG )
			{
				printt( "NOVA ON ZIPLINE" )
			}
			#endif //DEV
			minVelocityZ = 0.0
			wasInAir = false
		}
		else if ( player.IsOnGround() )
		{
			if ( wasInAir )
			{
				//Just landed
				#if DEVELOPER
				if ( PASSIVE_SOFTLANDINGS_DEBUG )
				{
					printt( "NOVA LANDED V" + minVelocityZ + " Thresh " + HARD_LANDINGS_Z_VELOCITY_THRESHOLD )
				}
				#endif //DEVELOPER

				if ( minVelocityZ <= HARD_LANDINGS_Z_VELOCITY_THRESHOLD )
				{
					//Do thing
					PassiveSoftLandings_Start( player )
				}
				minVelocityZ = 0.0

				wasInAir = false
			}
		}
		else
		{
			wasInAir = true
			if (  player.GetVelocity().z < minVelocityZ )
			{
				minVelocityZ = player.GetVelocity().z
			}
			#if DEVELOPER
			if ( PASSIVE_SOFTLANDINGS_DEBUG )
			{
				printt( "NOVA IN AIR " + minVelocityZ )
			}
			#endif //DEVELOPER
		}
		WaitFrame()
	}


}

void function PassiveSoftLandings_Start( entity player )
{
	if ( StatusEffect_GetTimeRemaining( player, eStatusEffect.softLandings_visuals ) > 0 )
	{
		StatusEffect_SetDuration( player, file.playerStatusEffects[ player ].softLandingsVisualsID, PASSIVE_SOFTLANDINGS_EFFECT_DURATION )
	}
	else
	{
		file.playerStatusEffects[ player ].softLandingsVisualsID = StatusEffect_AddTimed( player, eStatusEffect.softLandings_visuals, 1, PASSIVE_SOFTLANDINGS_EFFECT_DURATION, PASSIVE_SOFTLANDINGS_EFFECT_DURATION )
		thread DelayedHorizonBattleChatterLine( player )
	}
	#if SERVER
		if ( IsValid( player ) )
		{
			EmitSoundOnEntityExceptToPlayer( player, player, SOUND_SOFTLANDINGS_3P )
			//StatsHook_HardLandingsAvoided( player )
		}
	#endif
}
void function DelayedHorizonBattleChatterLine( entity player )
{
	wait 0.75
	if (IsValid(player))
	{
		PlayBattleChatterLineToPlayer( "bc_horizon_passive", player, player )
	}
}
#if DEVELOPER
void function DEV_PassiveSoftLandings_ForceStart( entity player )
{
	PassiveSoftLandings_Start( player )
}
#endif //DEVELOPER