void function TrackingVision_PlayerUsedLaunchPad( entity player )
{
	file.launchPadUsed[ player ] = true
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_LAUNCH_PAD, player, player.GetOrigin(), player.GetTeam(), player )
}

void function TrackingVision_OnPlayerLeaveGround( entity player )
{
	file.lastGroundTouchPos[ player ] = player.GetOrigin()
}

void function TrackingVision_OnPlayerTouchGround( entity player )
{
	vector lastTouchPos = file.lastGroundTouchPos[ player ]

                
                                                                          
                                                      
         
       

	bool didLand = lastTouchPos.z > (player.GetOrigin().z + TRACKING_VISION_TRAVERSAL_POI_JUMP_DOWN_DIST) || file.launchPadUsed[player]

	if ( didLand )
		 TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_JUMP_DOWN_STOP, player, player.GetOrigin(), player.GetTeam(), player )

	bool didFallOfLedge = !file.ziplined[ player ] || file.launchPadUsed[player]
	if ( didFallOfLedge  )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_JUMP_DOWN_START, player, lastTouchPos, player.GetTeam(), player )

	file.launchPadUsed[player] = false
	file.ziplined[ player ] = false
}

void function TrackingVision_OnPlayerReload( entity player )
{
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_RELOAD, player, player.GetOrigin(), player.GetTeam(), player )
}

void function TrackingVision_OnPlayerStartBleedout( entity player, entity attacker, var damageInfo )
{
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_STARTBLEEDOUT, player, player.GetOrigin(), player.GetTeam(), player )
}

void function TrackingVision_OnPlayerGotFirstAid( entity player, entity reviver )
{
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_HEAL, player, player.GetOrigin(), player.GetTeam(), player )
}


void function TrackingVision_OnZiplineStart( entity player, entity zipline )
{
                
                                                                          
                                                      
         
       

	int attachment = player.LookupAttachment( "L_HAND" )
	vector origin  = player.GetAttachmentOrigin( attachment )
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_ZIPLINE_START, zipline, origin, player.GetTeam(), player )
	file.ziplined[ player ] = true
}

void function TrackingVision_OnZiplineStop( entity player )
{
                
                                                                          
                                                      
         
       

	entity zipline = player.Zipline_GetLastZipline()
	if ( !IsValid( zipline ) )
		return

	int attachment = player.LookupAttachment( "L_HAND" )
	vector origin = player.GetAttachmentOrigin( attachment )
	TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_ZIPLINE_STOP, zipline, origin, player.GetTeam(), player )
}

void function TrackingVision_OnGameStateEnter_WaitingForPlayers()
{
	thread TrackingVision_PlayerFootprintUpdate()
}

void function TrackingVision_PlayerFootprintUpdate()
{
	Assert ( IsNewThread(), "Must be threaded off." )

	while ( GetGameState() <= eGameState.Playing )
	{
		WaitFrame()

		foreach ( entity player in GetPlayerArray_Alive() )
		{
                  
                                                                            
                                                        
             
         

			if ( player.IsPhaseShifted() )
				continue

			                     
			if ( HoverVehicle_IsPlayerInAnyVehicle( player ) )
				continue
                              

			vector playerVel = player.GetVelocity()
			vector playerPos = player.GetOrigin()
			if ( player.IsOnGround() && playerVel != <0, 0, 0> )
			{
				float deltaLength = Length ( file.footprintLastPos[ player ] - playerPos )
				float velLength	= Length ( playerVel )
				file.footprintDist[ player ] += deltaLength

				if ( file.footprintDist[ player ] >= TRACKING_VISION_TRAVERSAL_POI_FOOTPRINT_DISTANCE )
				{
					file.footprintDist[ player ] = 0

					//if the player is bleeding out leave a blood trail
					if ( Bleedout_IsBleedingOut( player ) )
					{
						TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TOOK_DAMAGE, player, player.GetOrigin(), player.GetTeam(), player )
					}
					else if ( player.IsSliding() )
					{
						TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_SLIDE, player, player.GetOrigin(), player.GetTeam(), player )
					}
					//Only leave footprints if the player is running.
					else
					{
						TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TRAVERSAL_FOOTPRINT, player, player.GetOrigin(), player.GetTeam(), player )
					}
				}
			}
			file.footprintLastPos[ player ] = playerPos
		}
	}
}

                                              
array< entity > function TrackingVision_GetAllValidTrackingPOIs( )
{
	array< entity > poiArray

	foreach( dataArray in file.poiDataArray )
	{
		entity poi 	= dataArray.poi
		int type 	= dataArray.type

		//If there's no actual POI entity, remove
		if( !IsValid( poi ) )
		{
			file.poiDataArray.fastremovebyvalue( dataArray )
			continue
		}
		poiArray.append( poi )
	}

	return poiArray
}

POIData function TrackingVision_CreatePOIData( entity poi, int type )
{
	//Add more components in here if necessary later, ownerTeam, realms etc.
	POIData poiData
	poiData.poi = poi
	poiData.type = type

	return poiData
}
      

#if DEVELOPER
void function DEV_ForceAddTrackingVision( entity player )
{
	if ( player in file.trackingVisionData )
	{
		StatusEffect_Stop( player, file.trackingVisionData[ player ].statusID )
		delete file.trackingVisionData[ player ]
	}

	int statusID = StatusEffect_AddEndless( player, eStatusEffect.tracking_vision, 1.0 )

	TrackingVisionData data
	data.owner 		= player
	data.statusID 	= statusID
	file.trackingVisionData[ player ] <- data
}
#endif //DEV

bool function TrackingVision_ShouldCleanupPOISOnDeath()
{
	return GetCurrentPlaylistVarBool( "trackingvision_cleanup_pois_ondeath", false )
}

void function TrackingVision_MarkPOIForPostDeathCleanup( entity poi, entity player )
{
	array<entity> playerPOIs

	if ( player in file.playerToActivePOISTable )
		playerPOIs = file.playerToActivePOISTable[ player ]

	playerPOIs.append( poi )
	file.playerToActivePOISTable[ player ] <- playerPOIs
}