const float TRACKING_VISION_WEAPON_FIRE_POI_DBOUNCE = 1.5 //The D-Bounce interval for weapon fire points of intrest.
                                       
                                                        
                                                                 
      

const float TRACKING_VISION_DAMAGE_POI_HEALTH_FRAC = 0.05	//Only send a player damaged Point of Intrest a single attack does more than this fraction of the player's health.

const float TRACKING_VISION_TRAVERSAL_POI_FOOTPRINT_DISTANCE	= 384.0 //Distance interval at which players will crate a footprint POI.
const float TRACKING_VISION_TRAVERSAL_POI_JUMP_DOWN_DIST		= 98.0 //Distance player must fall to leave a jumped down POI.
const float TRACKING_VISION_TRAVERSAL_LAUNCH_PAD_MAX_TIME		= 6.0 //Landing within this time intervall will create a LANDED POI after launch pad use

//MACRO POINT OF INTREST CATAGORIES
const bool TRACKING_VISION_ENABLE_POI_PLAYER_ACTIONS 	= true	//Create Point of Intrest when player preforms action unrelated to loot.
const bool TRACKING_VISION_ENABLE_POI_PLAYER_ELIMINATED = true	//Create Point of Intrest when player is killed
const bool TRACKING_VISION_ENABLE_POI_PLAYER_TRAVERSAL	= true 	//Create Point of Intrest when player performs a traversal action.
const bool TRACKING_VISION_ENABLE_POI_PLAYER_ABILITIES	= true	//Create Point of Intrest when player preforms a non-deployable ability.
const bool TRACKING_VISION_ENABLE_POI_LOOT_PICKUP 		= true	//Create Point of Intrest when player picks up loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_EXCHANGE 	= true	//Create Point of Intrest when player exchanges one piece of loot for another of the same type.
const bool TRACKING_VISION_ENABLE_POI_LOOT_DROP 		= true  //Create Point of Intrest when player discards a piece of loot from their inventory.

//MICRO POINT OF INTREST CATAGORIES
const bool TRACKING_VISION_ENABLE_POI_LOOT_AMMO			= true  //Create Point of Intrest when player interacts with ammo loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_ARMOR		= true  //Create Point of Intrest when player interacts with armor loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_ATTACHMENT	= true  //Create Point of Intrest when player interacts with attachment loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_WEAPON		= true 	//Create Point of Intrest when player interacts with weapon loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_GRENADE		= true 	//Create Point of Intrest when player interacts with grenade loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_JUMPKIT		= true 	//Create Point of Intrest when player interacts with jumpkit loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_HEALTH		= true 	//Create Point of Intrest when player interacts with health loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_BACKPACK		= true 	//Create Point of Intrest when player interacts with backpack loot.
                  
                                                                                                                                
      
const bool TRACKING_VISION_ENABLE_POI_LOOT_GADGET		= true 	//Create Point of Intrest when player interacts with gadget loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_HELMET		= true 	//Create Point of Intrest when player interacts with helmet loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_TITAN		= true 	//Create Point of Intrest when player interacts with titan loot.
const bool TRACKING_VISION_ENABLE_POI_LOOT_INCAPSHIELD	= true	//Create Point of Interest when player interacts with incap shields.
                      
const bool TRACKING_VISION_ENABLE_POI_LOOT_DATAKNIFE	= true	//Create Point of Interest when player interacts with data knives.
      

struct TrackingVisionData
{
	entity owner
	int statusID
}

                                              
struct POIData //could add more to this struct if needed
{
	entity poi
	int type
}
      

struct
{
	array < entity > registeredPlayers
	table < entity, TrackingVisionData > trackingVisionData
	table < int, bool > activePOIEvents //Tracking events will only be sent to clients if they are included in this list.
	table < entity, float > lastWeaponFireTime
	table < entity, vector > lastGroundTouchPos
	table < entity, vector > footprintLastPos
	table < entity, float > footprintDist
	table < entity, bool > ziplined
	table < entity, bool > launchPadUsed
                                              
	array< POIData > poiDataArray
      

	bool trackingVision_ENABLE_POI_PLAYER_ACTIONS 		= TRACKING_VISION_ENABLE_POI_PLAYER_ACTIONS
	bool trackingVision_ENABLE_POI_PLAYER_ELIMINATED 	= TRACKING_VISION_ENABLE_POI_PLAYER_ELIMINATED
	bool trackingVision_ENABLE_POI_PLAYER_TRAVERSAL		= TRACKING_VISION_ENABLE_POI_PLAYER_TRAVERSAL
	bool trackingVision_ENABLE_POI_PLAYER_ABILITIES		= TRACKING_VISION_ENABLE_POI_PLAYER_ABILITIES
	bool trackingVision_ENABLE_POI_LOOT_PICKUP 			= TRACKING_VISION_ENABLE_POI_LOOT_PICKUP
	bool trackingVision_ENABLE_POI_LOOT_EXCHANGE 		= TRACKING_VISION_ENABLE_POI_LOOT_EXCHANGE
	bool trackingVision_ENABLE_POI_LOOT_DROP 			= TRACKING_VISION_ENABLE_POI_LOOT_DROP

	table< entity, array<entity> > playerToActivePOISTable
} file

void function TrackingVision_Init()
{
	BirdClusterSharedInit()

                                       
                                                        
                                                         
                                                        
                                                         
                                                      
                                                       
                                                    
      

	TrackingVision_SetActivePOIEventTypes()

	AddCallback_OnPassiveChanged( ePassives.PAS_TRACKING_VISION, TrackingVision_OnPassiveChanged )
	AddCallback_OnPilotBecomesTitan( TrackingVision_OnPilotBecomesTitan )
	AddCallback_OnTitanBecomesPilot( TrackingVision_OnTitanBecomesPilot )
	AddCallback_ZiplineStart( TrackingVision_OnZiplineStart )
	AddCallback_ZiplineStop( TrackingVision_OnZiplineStop )

	Bleedout_AddCallback_OnPlayerStartBleedout( TrackingVision_OnPlayerStartBleedout )
	Bleedout_AddCallback_OnPlayerGotFirstAid( TrackingVision_OnPlayerGotFirstAid )

	AddCallback_OnClientConnected( TrackingVision_OnClientConnected )
	AddCallback_OnClientDisconnected( TrackingVision_OnClientDisconnected )
	AddCallback_OnPlayerReload( TrackingVision_OnPlayerReload )

	AddCallback_OnPlayerKilled( TrackingVision_OnPlayerKilled )

	AddCallback_OnWeaponAttack( TrackingVision_OnWeaponAttack )
	AddPostDamageCallback( "player", TrackingVision_OnPlayerPostDamage )

	AddSpawnCallback( "prop_script", TrackingVision_OnPropScriptCreated )
	AddSpawnCallback( "prop_loot_grabber", TrackingVision_OnPropScriptCreated )

	AddCallback_GameStateEnter( eGameState.WaitingForPlayers, TrackingVision_OnGameStateEnter_WaitingForPlayers )
}

void function TrackingVision_OnClientConnected( entity player )
{
	if ( file.registeredPlayers.contains( player ) )
		return

	file.registeredPlayers.append( player )
	file.lastWeaponFireTime[ player ] <- Time()
	file.lastGroundTouchPos[ player ] <- <0,0,0>
	file.footprintLastPos[ player ] <- <0,0,0>
	file.footprintDist[ player ] <- 0
	file.ziplined[ player ] <- false
	file.launchPadUsed[ player ] <- false
	AddPlayerMovementEventCallback( player, ePlayerMovementEvents.MANTLE, TrackingVision_OnPlayerMantle )
	AddPlayerMovementEventCallback( player, ePlayerMovementEvents.LEAVE_GROUND, TrackingVision_OnPlayerLeaveGround )
	AddPlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, TrackingVision_OnPlayerTouchGround )
}

void function TrackingVision_OnClientDisconnected( entity player )
{
	if ( !file.registeredPlayers.contains( player ) )
		return

	file.registeredPlayers.fastremovebyvalue( player )

	RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.MANTLE, TrackingVision_OnPlayerMantle )
	RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.LEAVE_GROUND, TrackingVision_OnPlayerLeaveGround )
	RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, TrackingVision_OnPlayerTouchGround )

	if ( player in file.lastWeaponFireTime )
		delete file.lastWeaponFireTime[ player ]
	if ( player in file.lastGroundTouchPos )
		delete file.lastGroundTouchPos[ player ]
	if ( player in file.footprintLastPos )
		delete file.footprintLastPos[ player ]
	if ( player in file.footprintDist )
		delete file.footprintDist[ player ]
	if ( player in file.ziplined )
		delete file.ziplined[ player ]
}

