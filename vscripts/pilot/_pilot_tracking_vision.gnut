void function TrackingVision_OnPassiveChanged( entity player, int passive, bool didHave, bool nowHas )
{
	if ( didHave )
	{
		Assert ( player in file.trackingVisionData, "Player does not have tracking passive, but we are trying to remove it." )
		StatusEffect_Stop( player, file.trackingVisionData[ player ].statusID )
		delete file.trackingVisionData[ player ]
	}
	if ( nowHas )
	{
		int statusID = StatusEffect_AddEndless( player, eStatusEffect.tracking_vision, 1.0 )

		TrackingVisionData data
		data.owner 		= player
		data.statusID 	= statusID
		file.trackingVisionData[ player ] <- data

                        
                                                                     
                                                                                 
        
	}
}

array<entity> function GetAllTrackingPlayers()
{
	array<entity> list = []
	foreach( entity player, TrackingVisionData unused in file.trackingVisionData )
	{
		if ( IsAlive( player ) )
			list.append( player )
	}
	return list
}

void function TrackingVision_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	int dist = int( Distance(victim.GetOrigin(), attacker.GetOrigin() ) )

	entity victimWaypoint = TrackingVision_CreatePOIAndReturnEntity( eTrackingVisionNetworkedPOITypes.PLAYER_DEATH, victim, victim.GetOrigin(), victim.GetTeam(), victim, attacker )
	if ( IsValid( victimWaypoint ) )
	{
		victimWaypoint.SetWaypointInt( TRACKING_DAMAGE_SOURCE_INDEX, damageSourceID )
		victimWaypoint.SetWaypointInt( TRACKING_DIST_INDEX, dist )
	}

	if ( !TrackingVision_ShouldShowAttackerPOI( attacker, damageSourceID ) )
		return

	entity attackerWaypoint = TrackingVision_CreatePOIAndReturnEntity( eTrackingVisionNetworkedPOITypes.PLAYER_KILLER, attacker, attacker.GetOrigin(), attacker.GetTeam(), attacker, victim )
	if ( IsValid( attackerWaypoint ) )
	{
		attackerWaypoint.SetWaypointInt( TRACKING_DAMAGE_SOURCE_INDEX, damageSourceID )
		attackerWaypoint.SetWaypointInt( TRACKING_DIST_INDEX, dist )
	}

	// If we cleanup POI's on death, clean them up now ( but leave the death POI )
	if ( TrackingVision_ShouldCleanupPOISOnDeath() && victim in file.playerToActivePOISTable )
	{
		array <entity> pois = clone file.playerToActivePOISTable[ victim ]
		foreach( poi in pois )
		{
			if ( IsValid( poi ) )
				poi.Destroy()
		}
		delete file.playerToActivePOISTable[ victim ]
	}
}

bool function TrackingVision_ShouldShowAttackerPOI( entity attacker, int damageSourceID )
{
	if ( !attacker.IsPlayer() )
		return false

	switch( damageSourceID )
	{
		case eDamageSourceId.bleedout:
		case eDamageSourceId.bombardment:
		case eDamageSourceId.damagedef_grenade_gas:
		case eDamageSourceId.damagedef_gas_exposure:
			return false
	}

	return true
}

void function TrackingVision_OnWeaponAttack( entity player, entity weapon, string weaponName, int ammoUsed, vector attackOrigin, vector attackDir )
{
	if ( ammoUsed == 0 )
		return

	int flags = weapon.GetWeaponDamageFlags()
	/*
	printt( weaponName + ", FLAGS: " + flags )
	printt( "DF_BULLET: " + bool ( flags & DF_BULLET ) )
	printt( "DF_SHOTGUN: " + bool ( flags & DF_SHOTGUN ) )
	printt( "DF_EXPLOSION: " + bool ( flags & DF_EXPLOSION ) )
	printt( "IS OFFHAND: " + weapon.IsWeaponOffhand() )
	printt( "IS TOSS: " + weapon.IsTossWeapon() )
	printt( "AMMO USED: " + ammoUsed )
	*/

	//Debounce our weapon fire POI events.
	if ( Time() < file.lastWeaponFireTime[ player ] )
		return

		float poiDebounceTime = TRACKING_VISION_WEAPON_FIRE_POI_DBOUNCE
                                        
                                                                  
       

	//Weapon Fired Markers - Now include energy weapons
	if ( !IsBitFlagSet( flags, DF_EXPLOSION ) && !weapon.IsWeaponOffhand() && !weapon.IsTossWeapon() )
	{
		vector origin = OriginToGround( player.GetOrigin() + <0,0,1> )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_FIRE_WEAPON_BULLET, player, origin, player.GetTeam(), player )
		file.lastWeaponFireTime[ player ] = Time() + poiDebounceTime
	}
	//Non-Offhand Weapons that explode and are tossed should leave grenade pins.
	else if ( !IsBitFlagSet( flags, ( DF_BULLET | DF_SHOTGUN ) ) && IsBitFlagSet( flags, DF_EXPLOSION ) && !weapon.IsWeaponOffhand() && weapon.IsTossWeapon() )
	{
		vector origin = OriginToGround( player.GetOrigin() + <0,0,1> )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_FIRE_WEAPON_GRENADE, player, origin, player.GetTeam(), player )
		file.lastWeaponFireTime[ player ] = Time() + poiDebounceTime
	}
}

void function TrackingVision_OnPlayerPostDamage( entity victim, var damageInfo )
{

	//printt( victim.GetHealth() )

	//Don't create damage POI for dead players.
	if ( !IsAlive( victim ) )
		return

	//We don't create POIs for titan damage.
	if ( victim.IsTitan() )
		return

	//Don't create damage POI for players who will be killed by this damage.
	float damage = DamageInfo_GetDamage( damageInfo )
	int health = victim.GetHealth()
	if ( damage >= health )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )

	//Only create damage POI for attacks from valid attacker.
	if ( !IsValid( attacker ) )
		return

	int maxHealth = victim.GetMaxHealth()

	//printt( DamageInfo_GetDamageType( damageInfo ), DamageInfo_GetDamageFlags( damageInfo ), DamageInfo_GetCustomDamageType( damageInfo ) )

	//If this attack did more damage that our specified health fraction, create a damage Point of Intrest.
	if ( damage >= ( maxHealth * TRACKING_VISION_DAMAGE_POI_HEALTH_FRAC ) )
	{
		vector origin = OriginToGround( victim.GetOrigin() + <0,0,1> )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_TOOK_DAMAGE, victim, origin, victim.GetTeam(), victim )
	}
}

