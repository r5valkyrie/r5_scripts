	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_ARMOR ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_ARMOR
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_ATTACHMENT ]		<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_ATTACHMENT
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_WEAPON ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_WEAPON
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_GRENADE ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_GRENADE
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_JUMPKIT ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_JUMPKIT
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_HEALTH ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_HEALTH
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_BACKPACK ]		<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_BACKPACK
                   
                                                                                                                                                                                  
       
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_GADGET ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_GADGET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_HELMET ]			<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_HELMET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_INCAPSHIELD ]		<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_INCAPSHIELD
	                      
		file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_DATAKNIFE ]	<- file.trackingVision_ENABLE_POI_LOOT_PICKUP && TRACKING_VISION_ENABLE_POI_LOOT_DATAKNIFE
       

	//LOOT EXCHANGE POI EVENT TYPES
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_ARMOR ]			<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_ARMOR
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_WEAPON ]		<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_WEAPON
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_JUMPKIT ]		<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_JUMPKIT
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_BACKPACK ]		<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_BACKPACK
                   
                                                                                                                                                                                      
       
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_GADGET ]		<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_GADGET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_HELMET ]		<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_HELMET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_EXCHANGE_INCAPSHIELD ]	<- file.trackingVision_ENABLE_POI_LOOT_EXCHANGE && TRACKING_VISION_ENABLE_POI_LOOT_INCAPSHIELD

	//LOOT DROPPED POI EVENT TYPES
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP ]					<- file.trackingVision_ENABLE_POI_LOOT_DROP
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_AMMO ]				<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_AMMO
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_ARMOR ]				<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_ARMOR
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_ATTACHMENT ]		<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_ATTACHMENT
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_WEAPON ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_WEAPON
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_GRENADE ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_GRENADE
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_JUMPKIT ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_JUMPKIT
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_HEALTH ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_HEALTH
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_BACKPACK ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_BACKPACK
                   
                                                                                                                                                                               
       
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_GADGET ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_GADGET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_HELMET ]			<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_HELMET
	file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_INCAPSHIELD ]		<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_INCAPSHIELD
	                      
		file.activePOIEvents[ eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_DROP_DATAKNIFE ]		<- file.trackingVision_ENABLE_POI_LOOT_DROP && TRACKING_VISION_ENABLE_POI_LOOT_DATAKNIFE
       

	#if DEVELOPER
	//If we are running in DEV mode validate our POIType entries to ensure all of them have been registered as active or inactive.
	foreach( int eventType in eTrackingVisionNetworkedPOITypes )
	{
		if ( eventType != eTrackingVisionNetworkedPOITypes._count )
			Assert( eventType in file.activePOIEvents, "POI Event Type " + DEV_GetEnumStringSafe( "eTrackingVisionNetworkedPOITypes", eventType ) + " has not been registered active or inactive." )
	}
	#endif
}

bool function TrackingVision_IsPOIEventTypeEnabled( int eventType )
{
	Assert( eventType in file.activePOIEvents, "POI Event Type " + eventType + " has not been registered active or inactive." )

	if ( GetCurrentPlaylistVarString( "character_bloodhound", "" ) == "locked" )
		return false

	return file.activePOIEvents[ eventType ]
}

void function TrackingVision_CreatePOI( int type, entity ent, vector origin, int teamOwner, entity realmsEntity )
{
	if ( GetGameState() >= eGameState.WinnerDetermined )
		return

	//Don't transmit disabled POI event types to the client.
	if ( !TrackingVision_IsPOIEventTypeEnabled( type ) )
		return

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return

	bool entIsPlayer = ent.IsPlayer()

	if ( entIsPlayer && !file.registeredPlayers.contains( ent ) )
		return

                     
                                
        
      

	//If this ent is a player, reset the footprint distance interval.
	//We don't need footprints if the player is generating other POIs.
	if ( ent.IsPlayer() )
		file.footprintDist[ ent ] = 0

	vector offset = TrackingVision_GetOffsetForPOI( type )

	entity poi = CreateBasicPOIAndReturnEntity( type, (origin + offset), ent, teamOwner, TrackingVision_GetPriorityForPOIType( type ), realmsEntity )
	if( poi != null )
	{
		poi.wp.waypointCreatedTime = Time()
                                        
                                                                                                
       

	                                              
		POIData poiData = TrackingVision_CreatePOIData( poi, type )
		file.poiDataArray.append( poiData )
       
	}

	if ( IsRoundBased() )
		MarkEntForCleanupOnRoundEnd( poi )
	else
		MarkEntForCleanupOnWinnerDetermined( poi )

	if ( TrackingVision_ShouldCleanupPOISOnDeath() )
		TrackingVision_MarkPOIForPostDeathCleanup( poi, ent )
}


// only used by TrackingVision_OnPlayerKilled
entity function TrackingVision_CreatePOIAndReturnEntity( int type, entity ent, vector origin, int teamOwner, entity realmsEntity, entity otherEntity )
{
	if ( GetGameState() >= eGameState.WinnerDetermined )
		return null

	//Don't transmit disabled POI event types to the client.
	if ( !TrackingVision_IsPOIEventTypeEnabled( type ) )
		return null

	if ( ent.IsPlayer() && !file.registeredPlayers.contains( ent ) )
		return null

	//If this ent is a player, reset the footprint distance interval.
	//We don't need footprints if the player is generating other POIs.
	if ( ent.IsPlayer() )
		file.footprintDist[ ent ] = 0

	vector offset = TrackingVision_GetOffsetForPOI( type )
	entity poi = CreateBasicPOIAndReturnEntity( type, (origin + offset), ent, teamOwner, TrackingVision_GetPriorityForPOIType( type ), realmsEntity )

	if(poi != null)
	{
		poi.wp.waypointCreatedTime = Time()

		                                              
			POIData poiData = TrackingVision_CreatePOIData( poi, type )
			file.poiDataArray.append( poiData )
        
	}

	if ( IsRoundBased() )
		MarkEntForCleanupOnRoundEnd( poi )
	else
		MarkEntForCleanupOnWinnerDetermined( poi )
	return poi
}

void function TrackingVision_OnPropScriptCreated( entity ent )
{
	thread TrackingVision_OnPropScriptCreated_Internal( ent )
}

void function TrackingVision_OnPropScriptCreated_Internal( entity ent )
{
	WaitFrame() //Have to wait a frame so script name can be set because it's set after Dispatch Spawn on most of these

	if ( GetGameState() >= eGameState.WinnerDetermined )
		return

	if ( !IsValid( ent ) )
		return

	int poiType;

	switch ( ent.GetScriptName() )
	{
		case "dirty_bomb":
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_DIRTY_BOMB
			break
		case "jump_pad":
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_JUMP_PAD
			break

               
                        
                                                                          
        
                         

               
                     
                                                                        
        
                         

		/*
		case "tesla_trap":
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_TESLA_TRAP
			break

		case "trophy_system":
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_TROPHY_SYSTEM
			break
		*/

		case BLACK_MARKET_SCRIPTNAME:
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_BLACK_MARKET
			break

		default:
			return;
	}


	vector offset = TrackingVision_GetOffsetForPOI( poiType )
	entity poi = CreateBasicPOIAndReturnEntity( poiType, (ent.GetOrigin() + offset), ent, ent.GetTeam(), TrackingVision_GetPriorityForPOIType( poiType ), ent )
	                                              
		POIData poiData = TrackingVision_CreatePOIData( poi, poiType )
		file.poiDataArray.append( poiData )
       
	if ( IsRoundBased() )
		MarkEntForCleanupOnRoundEnd( poi )
	else
		MarkEntForCleanupOnWinnerDetermined( poi )
}

void function TrackingVision_CreatePOIForPickedUpLoot( entity ent, int lootType, string ref, vector origin, int teamOwner, entity realmsEntity )
{
	int poiType = -1
	switch ( lootType )
	{
	case eLootType.AMMO:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_AMMO
		break
	case eLootType.ARMOR:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_ARMOR
		break
	case eLootType.ATTACHMENT:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_ATTACHMENT
		break
	case eLootType.GADGET:
	case eLootType.ORDNANCE:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_GRENADE
		break
	case eLootType.JUMPKIT:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_JUMPKIT
		break
	case eLootType.HEALTH:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_HEALTH
		break
	case eLootType.HELMET:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_HELMET
		break
	case eLootType.BACKPACK:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_BACKPACK
		break

	case eLootType.INCAPSHIELD:
		poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_INCAPSHIELD
		break

                      
		case eLootType.DATAKNIFE:
			poiType = eTrackingVisionNetworkedPOITypes.PLAYER_LOOT_PICKUP_DATAKNIFE
			break
      

	case eLootType.CUSTOMPICKUP:
		return

                       
                           
        
      

	case eLootType.LOCKBOX:
		return

                   
	case eLootType.MARVIN_ARM:
		return
      

                   
                            
        

                            
        
      
                  
	case eLootType.COLLECTABLE_NESSIE:
		return
      
                      
		case eLootType.CANDY_PICKUP:
			return
      
                    
		case eLootType.EVO_CACHE:
			return
      

                         
                              
        
      
	}

	if ( poiType == -1 )
	{
		Warning( "Cannot Create Loot Pickup POI for invalid loot type: " + lootType + " with ref " + ref  )
		return
	}

	TrackingVision_CreatePOI( poiType, ent, origin, teamOwner, realmsEntity )
}

