#if SERVER
StatEntry function ResolveStatEntryFromVargv( StatTemplate template, array<var> args )
{
	int keyArgCount = args.len()

	switch ( keyArgCount )
	{
		case 0:
			return ResolveStatEntry( template )
			break
		case 1:
			return ResolveStatEntry( template, args[ 0 ] )
			break
		case 2:
			return ResolveStatEntry( template, args[ 0 ], args[ 1 ] )
			break
		case 3:
			return ResolveStatEntry( template, args[ 0 ], args[ 1 ], args[ 2 ] )
			break
	}

	unreachable
}

void function __Mode_IncrementStat_Int( entity player, StatTemplate template, ... )
{
	string mode = GetCurrentPlaylistVarString( "stats_match_type", "survival" )

	Assert( STATS_MATCH_TYPES.contains( mode ), "Invalid Playlist var stats_match_type " + mode )

	if ( STATS_ALTERNATE_MODE_REFS.contains( mode ) )
	{
		int keyArgCount = expect int(vargc)

		Assert( keyArgCount >= 1 )

		int incrementAmount = expect int( vargv[ keyArgCount - 1 ] )

		array<var> args = [ mode ]

		for ( int i=0; i<keyArgCount-1; i++ )
		{
			args.append( vargv[ i ] )
		}

		keyArgCount = expect int(vargc)

		StatEntry entry = ResolveStatEntryFromVargv( template, args )

		__IncrementStat_Int( player, entry, incrementAmount )
	}
}

void function __Mode_SetStat_Int( entity player, StatTemplate template, ... )
{
	string mode = GetCurrentPlaylistVarString( "stats_match_type", "survival" )

	Assert( STATS_MATCH_TYPES.contains( mode ), "Invalid Playlist var stats_match_type " + mode )

	if ( STATS_ALTERNATE_MODE_REFS.contains( mode ) )
	{
		int keyArgCount = expect int(vargc)

		Assert( keyArgCount >= 1 )

		int incrementAmount = expect int( vargv[ keyArgCount - 1 ] )

		array<var> args = [ mode ]
		for ( int i=0; i<keyArgCount-1; i++ )
		{
			args.append( vargv[ i ] )
		}

		keyArgCount = expect int(vargc)

		StatEntry entry = ResolveStatEntryFromVargv( template, args )
		__SetStat_Int( player, entry, incrementAmount )
	}
}

void function CallOnDependentStatDependencyChangedOnDependents( entity player, StatEntry entry )
{
	if ( entry.dependents != null )
	{
		array<StatEntry> dependents = expect array<StatEntry>( entry.dependents )
		foreach( StatEntry dependent in dependents )
			OnDependentStatDependencyChanged( player, dependent )
	}
}

bool function __SharedValidateUpdateStat_Int( entity player, StatEntry entry, bool DEV_isManualDevSet )
{
	#if DEVELOPER
		StatCallStackCheck( DEV_isManualDevSet )
	#endif

	if ( IsLowCostBot( player ) )
		return false

	#if ASSERTS
		if ( !GetCurrentPlaylistVarBool( "enable_stats", true ) && !IsLobby() && entry.gameMode != eChallengeGameMode.NON_MODE )
		{
			Assert( false, "tried to update a stat value when stats were disabled. Catch this earlier in the callstack." )
			return false
		}
	#endif

	if ( fileLevel.doOnDemandStats )
		LoadStatValuesFromPersistenceIntoPlayerStruct( player, entry, false )

	return true
}

void function __SharedUpdateStat_Int( entity player, StatEntry entry, int newValue, int oldValue )
{
	if ( STATS_DEBUG_PRINT_SPAM )
		printt( "@@@@ STATS __SharedUpdateStat_Int @@@@", player, entry.persistenceFullKey_Current, newValue, "(was " + oldValue + ")" )

	player.p.statValues_Int[entry.indexWithinType] = newValue

	if ( entry.indexWithinType in player.p.statEntryChangeCallbacks_Int )
		foreach( StatChangedCallbackType_Int cb in player.p.statEntryChangeCallbacks_Int[entry.indexWithinType] )
			cb( player, oldValue, newValue )

	CallOnDependentStatDependencyChangedOnDependents( player, entry )

#if DEVELOPER
	if ( !DEV_ShouldIgnorePersistence() )
#endif
	{
		if ( IsLobby() || ( entry.writeImmediately && entry.behavior != eStatBehavior.CALCULATED ) )
		{
			player.SetPersistentVar( entry.persistenceFullKey_Current, newValue )
		}
		else if ( fileLevel.doOnDemandStats )
		{
			MarkStatAsDirtyForPlayer( player, entry )
		}
	}
}

void function __IncrementStat_Int( entity player, StatEntry entry, int incrementAmount, bool DEV_isManualDevSet = false )
{
	Assert( entry.type == eStatType.INT )
	Assert( entry.behavior == eStatBehavior.VARIABLE || entry.behavior == eStatBehavior.ACCUMULATED )
	Assert( incrementAmount >= 0 )

	if ( !__SharedValidateUpdateStat_Int( player, entry, DEV_isManualDevSet ) )
		return

	#if DEVELOPER
		if ( fileLevel.DEV_statsMultiplier != 1.0 )
			incrementAmount = int( float( incrementAmount ) * fileLevel.DEV_statsMultiplier )
	#endif

	int oldValue = player.p.statValues_Int[entry.indexWithinType]
	int newValue = oldValue + incrementAmount
	
	Assert( newValue != UNINITIALIZED )
	if ( newValue == UNINITIALIZED )
		return

	__SharedUpdateStat_Int( player, entry, newValue, oldValue )
}
#endif // #if SERVER

#if SERVER
void function __SetFlagStat_Int( entity player, StatEntry entry, int bitFlagToSet, bool DEV_isManualDevSet = false )
{
	Assert( entry.type == eStatType.INT )
	Assert( entry.behavior == eStatBehavior.BITFIELD )

	if ( !__SharedValidateUpdateStat_Int( player, entry, DEV_isManualDevSet ) )
		return

	int oldValue = player.p.statValues_Int[entry.indexWithinType]
	int newValue = SetBitFlag( oldValue, bitFlagToSet )

	Assert( newValue != UNINITIALIZED )
	if ( oldValue == newValue || newValue == UNINITIALIZED )
		return

	__SharedUpdateStat_Int( player, entry, newValue, oldValue )
}
#endif


#if SERVER
void function __SetStat_Int( entity player, StatEntry entry, int newValue, bool DEV_isManualDevSet = false )
{
	Assert( entry.type == eStatType.INT )

	if ( !__SharedValidateUpdateStat_Int( player, entry, DEV_isManualDevSet ) )
		return

	#if DEVELOPER
		if ( fileLevel.DEV_statsMultiplier != 1.0 && !DEV_isManualDevSet )
			newValue = int( float( newValue ) * fileLevel.DEV_statsMultiplier )
	#endif

	int oldValue = player.p.statValues_Int[entry.indexWithinType]
	Assert( newValue != UNINITIALIZED )
	if ( oldValue == newValue || newValue == UNINITIALIZED )
		return

	Assert( entry.behavior == eStatBehavior.VARIABLE || (entry.behavior == eStatBehavior.ACCUMULATED && newValue >= oldValue) || DEV_isManualDevSet,
		"persistenceFullKey_Current: " + entry.persistenceFullKey_Current + ", entry.behavior = " + entry.behavior )

	__SharedUpdateStat_Int( player, entry, newValue, oldValue )
}
#endif


#if SERVER
void function InitializeBitfieldStat( entity player, StatEntry entry )
{
	Assert( entry.behavior == eStatBehavior.BITFIELD )
	player.p.statValues_Int[entry.indexWithinType] = 0
	player.SetPersistentVar( entry.persistenceFullKey_Current, 0 )
}
#endif


#if SERVER
void function UpdateCalculatedStatCachedValue( entity player, StatEntry entry, int ornull overrideValue = null )
{
	if ( IsLowCostBot( player ) )
		return

	Assert( entry.behavior == eStatBehavior.CALCULATED && entry.shouldCache )

	if ( fileLevel.doOnDemandStats )
		LoadStatValuesFromPersistenceIntoPlayerStruct( player, entry, false )

	int value = UNINITIALIZED
	if ( overrideValue != null )
	{
		value = expect int( overrideValue )
	}
	else
	{
		value = entry.calcFunc_Int( player, GetCalcSourceEntriesFromEntry( entry ), eStatGetWhen.CURRENT )
	}

	Assert( value != UNINITIALIZED )
	if ( player.p.statValues_Int[entry.indexWithinType] != value && value != UNINITIALIZED )
	{
		player.p.statValues_Int[entry.indexWithinType] = value

		if ( IsLobby() )
			player.SetPersistentVar( entry.persistenceFullKey_Current, value ) // avoid persistence writes and networking in matches
		else if ( fileLevel.doOnDemandStats )
			MarkStatAsDirtyForPlayer( player, entry )

		if ( STATS_DEBUG_PRINT_SPAM )
			printt( "@@@@ STATS UpdateCalculatedStatCachedValue @@@@", player, entry.persistenceFullKey_Current, value )
	}
}
#endif


#if SERVER
void function OnDependentStatDependencyChanged( entity player, StatEntry dependent )
{
	if ( dependent.indexWithinType in player.p.statEntryChangeCallbacks_Int )
	{
		int oldValue = 0
		int newValue = GetStat_Int( player, dependent ) // todo(dw): do we really need oldValue?
		foreach( StatChangedCallbackType_Int cb in player.p.statEntryChangeCallbacks_Int[dependent.indexWithinType] )
			cb( player, oldValue, newValue )
	}

	CallOnDependentStatDependencyChangedOnDependents( player, dependent )
}
#endif


#if SERVER || CLIENT || UI
StatEntry function ResolveStatEntry( StatTemplate template, ... )
{
	Assert( template.type != eStatType.INVALID, "StatTemplate was not initialized." )

	int keyArgCount = expect int(vargc)
	Assert( keyArgCount == template.enumKeyCount, "Stat '" + GetStatTemplateDebugName( template ) + "' requires " + template.enumKeyCount + " enum keys but ResolveStatEntry was called with " + keyArgCount + "." )

	if ( vargc == 0 )
		return template.rootEntry

	StatTemplateEnumKeyResolver resolver = template.resolver
	for ( int resolveDepth = 0; resolveDepth < keyArgCount - 1; resolveDepth++ )
	{
		Assert( !resolver.isFinal )
		string key = expect string(vargv[resolveDepth])

                                             
                                               
                                                                   
        

		resolver = resolver.children[key]
	}
	Assert( resolver.isFinal )
	string key = expect string(vargv[keyArgCount - 1])

                                            
                                              
                                                                  
       

	#if SERVER && DEVELOPER
		// We always expect any statRef specified to exist.  This is a check.
		if ( !(key in resolver.entries) )
		{
			Assert( false, "The statRef '" + key + "' does not exist. Check its spelling or properly create a new statRef." )
			return template.rootEntry
		}
	#endif

	return resolver.entries[key]
}

                                           
                                                                                 
 
                                                   
                                                                  
                                                                                      
                                                                                
                                                                               
                                                                                   
                                                                        
                                                                                 
                                                            
    
                                                                                      
                                     
  
                                                    
                                                               
   
                                                                   
                                                                              
   
  
           
 
             
#endif // SERVER || CLIENT || UI


#if SERVER || CLIENT || UI
StatEnumStruct function RegisterStatEnumStruct( StatEnumStruct ornull parentSESOrNull, string fieldName, string enumName, array<string> choices )
{
	StatEnumStruct ses
	ses.parentEnumStruct = parentSESOrNull
	ses.fieldName = fieldName
	ses.enumName = enumName
	ses.choices = choices

	#if DEVELOPER
		if ( parentSESOrNull == null )
		{
			fileLevel.rootFieldsList.childEnumStructs.append( ses )
		}
		else
		{
			StatEnumStruct parentSES = expect StatEnumStruct(parentSESOrNull)
			StatEnumStruct_Children sesChildren
			if ( parentSES in fileLevel.sesChildrenMap )
				sesChildren = fileLevel.sesChildrenMap[parentSES]
			else
				fileLevel.sesChildrenMap[parentSES] <- sesChildren
			sesChildren.childEnumStructs.append( ses )
		}
	#endif

	return ses
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function InternalRegisterStatCommon( StatEnumStruct ornull parentSESOrNull, string fieldName, int type, int behavior, bool writeImmediately, bool shouldCache, int gameMode )
{
	StatTemplate template

	template.fieldName = fieldName
	template.type = type
	template.behavior = behavior
	template.writeImmediately = writeImmediately
	template.shouldCache = shouldCache
	template.gameMode = gameMode
	Assert( !shouldCache || template.behavior == eStatBehavior.CALCULATED )

	if ( parentSESOrNull == null )
	{
		Assert( gameMode != MODE_SPECIFIC )

		template.rootEntry.type = template.type
		template.rootEntry.behavior = template.behavior
		template.rootEntry.writeImmediately = template.writeImmediately
		template.rootEntry.shouldCache = template.shouldCache
		template.rootEntry.gameMode = template.gameMode

		template.rootEntry.persistenceFullKey_Current = STATS_PERSISTENCE_PREFIX_CURRENT + "." + fieldName
		if ( template.rootEntry.behavior != eStatBehavior.CALCULATED || template.rootEntry.shouldCache )
		{
#if DEVELOPER
			//if ( GetConVarBool( "persistence_development_mode", false ) )
			if ( !DEV_ShouldIgnorePersistence() )
#endif
			{
				//template.rootEntry.persistenceFullKey_Current_Handle = PersistenceGetVarHandle( template.rootEntry.persistenceFullKey_Current ) // handle optimization not available
			}
		}

		template.rootEntry.index = fileLevel.allStats.len()
		fileLevel.allStats.append( template.rootEntry )

		fileLevel.refStatEntryMap[template.rootEntry.persistenceFullKey_Current] <- template.rootEntry

		template.rootEntry.indexWithinType = fileLevel.stats_Int.len()
		fileLevel.stats_Int.append( template.rootEntry )

		#if DEVELOPER
			fileLevel.rootFieldsList.childStatTemplates.append( template )
		#endif

		template.allEntries.append( template.rootEntry )
	}
	else
	{
		StatEnumStruct parentSES = expect StatEnumStruct(parentSESOrNull)

		#if DEVELOPER
			StatEnumStruct_Children sesChildren
			if ( parentSES in fileLevel.sesChildrenMap )
				sesChildren = fileLevel.sesChildrenMap[parentSES]
			else
				fileLevel.sesChildrenMap[parentSES] <- sesChildren
			sesChildren.childStatTemplates.append( template )
		#endif

		array<StatEnumStruct> sesAncestorsReversed = []
		StatEnumStruct ornull ancestorOrNull       = parentSESOrNull
		while ( ancestorOrNull != null )
		{
			StatEnumStruct ancestor = expect StatEnumStruct(ancestorOrNull)
			sesAncestorsReversed.append( ancestor )
			ancestorOrNull = ancestor.parentEnumStruct
		}

		template.enumKeyCount = sesAncestorsReversed.len()
		template.resolver = BuildStatTemplateEnumKeyResolversRecursive( template, 0, sesAncestorsReversed, template, "", [] )
	}

	return template
}
#endif


#if SERVER || CLIENT || UI
StatTemplateEnumKeyResolver function BuildStatTemplateEnumKeyResolversRecursive( StatTemplate template, int depth, array<StatEnumStruct> sesAncestorsReversed, StatTemplate stat, string partialKey, array<string> enumKeys )
{
	StatTemplateEnumKeyResolver resolver

	StatEnumStruct ancestor = sesAncestorsReversed[sesAncestorsReversed.len() - 1 - depth]

	if ( depth == sesAncestorsReversed.len() - 1 )
	{
		resolver.isFinal = true
		foreach ( string choice in ancestor.choices )
		{
			array<string> grownEnumKeys = []
			grownEnumKeys.extend( enumKeys )
			grownEnumKeys.append( choice )

			StatEntry entry
			entry.type = template.type
			entry.behavior = template.behavior
			entry.writeImmediately = template.writeImmediately
			entry.shouldCache = template.shouldCache
			entry.gameMode = template.gameMode

			string entryPersistencePartialKey = partialKey + ancestor.fieldName + "[" + choice + "]" + "." + stat.fieldName
			entry.persistenceFullKey_Current = STATS_PERSISTENCE_PREFIX_CURRENT + "." + entryPersistencePartialKey

			if ( template.gameMode == MODE_SPECIFIC )
			{
				foreach ( int gameModeEnum, string modeRef in GAME_MODE_TO_STAT_REF_MAP )
				{
					if ( entryPersistencePartialKey.find( modeRef ) != -1 )
						entry.gameMode = gameModeEnum
				}
			}

			if ( entry.behavior != eStatBehavior.CALCULATED || entry.shouldCache )
			{
#if DEVELOPER
				//if ( GetConVarBool( "persistence_development_mode", false ) )
				if ( !DEV_ShouldIgnorePersistence() )
#endif
				{
					//entry.persistenceFullKey_Current_Handle = PersistenceGetVarHandle( entry.persistenceFullKey_Current ) // handle optimization not available
				}
			}

			entry.enumKeys = grownEnumKeys

			entry.index = fileLevel.allStats.len()
			fileLevel.allStats.append( entry )

			fileLevel.refStatEntryMap[entry.persistenceFullKey_Current] <- entry

			entry.indexWithinType = fileLevel.stats_Int.len()
			fileLevel.stats_Int.append( entry )


			resolver.entries[choice] <- entry

			template.allEntries.append( entry )
		}
	}
	else
	{
		resolver.isFinal = false
		foreach ( string choice in ancestor.choices )
		{
			string grownPartialKey      = partialKey + ancestor.fieldName + "[" + choice + "]."

			array<string> grownEnumKeys = []
			grownEnumKeys.extend( enumKeys )
			grownEnumKeys.append( choice )
			StatTemplateEnumKeyResolver subResolver = BuildStatTemplateEnumKeyResolversRecursive( stat, depth + 1, sesAncestorsReversed, stat, grownPartialKey, grownEnumKeys )
			resolver.children[choice] <- subResolver
		}
	}

	return resolver
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function RegisterAccumulatedStat_Int( StatEnumStruct ornull enumStructOrNull, string fieldName, int gameMode, bool writeImmediately )
{
	return InternalRegisterStatCommon( enumStructOrNull, fieldName, eStatType.INT, eStatBehavior.ACCUMULATED, writeImmediately, false, gameMode )
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function RegisterVariableStat_Int( StatEnumStruct ornull enumStructOrNull, string fieldName, int gameMode, bool writeImmediately )
{
	return InternalRegisterStatCommon( enumStructOrNull, fieldName, eStatType.INT, eStatBehavior.VARIABLE, writeImmediately, false, gameMode )
}
#endif

#if SERVER || CLIENT || UI
void function InternalRegisterCalcFunc( StatTemplate stat, StatCalcFuncInfo functionref( StatEntry, array<StatTemplate> ) setupFunc, array<StatTemplate> sourceTemplates )
{
	foreach( StatEntry entry in stat.allEntries )
	{
		StatCalcFuncInfo calcInfo = setupFunc( entry, sourceTemplates )
		entry.calcFunc_Int = calcInfo.calcFunc_Int
		entry.calcSourceEntries = calcInfo.sourceEntries

		if ( calcInfo.sourceEntries != null )
		{
			array<StatEntry> sourceEntries = expect array<StatEntry>( calcInfo.sourceEntries )
			foreach( StatEntry sourceEntry in sourceEntries )
			{
				if ( sourceEntry.dependents == null )
					sourceEntry.dependents = []
				array<StatEntry> dependents = expect array<StatEntry>( sourceEntry.dependents )
				dependents.append( entry )
			}
		}
	}
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function InternalRegisterCalculatedStatCommon( StatEnumStruct ornull enumStructOrNull, string fieldName, bool writeImmediately, bool shouldCache,
		StatCalcFuncInfo functionref( StatEntry, array<StatTemplate> ) setupFunc, array<StatTemplate> sourceTemplates, int gameMode )
{
	StatTemplate stat = InternalRegisterStatCommon( enumStructOrNull, fieldName, eStatType.INT, eStatBehavior.CALCULATED, writeImmediately, shouldCache, gameMode )

	InternalRegisterCalcFunc( stat, setupFunc, sourceTemplates )

	return stat
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function RegisterExpensiveCalculatedStat_Int( StatEnumStruct ornull enumStructOrNull, string fieldName, bool writeImmediately,
		StatCalcFuncInfo functionref( StatEntry, array<StatTemplate> ) setupFunc, array<StatTemplate> sourceTemplates, int gameMode )
{
	return InternalRegisterCalculatedStatCommon( enumStructOrNull, fieldName, writeImmediately, false, setupFunc, sourceTemplates, gameMode )
}
#endif


#if SERVER || CLIENT || UI
StatTemplate function RegisterCachedCalculatedStat_Int( StatEnumStruct ornull enumStructOrNull, string fieldName, bool writeImmediately,
		StatCalcFuncInfo functionref( StatEntry, array<StatTemplate> ) setupFunc, array<StatTemplate> sourceTemplates, int gameMode )
{
	return InternalRegisterCalculatedStatCommon( enumStructOrNull, fieldName, writeImmediately, true, setupFunc, sourceTemplates, gameMode )
}
#endif

#if SERVER || CLIENT || UI
StatTemplate function RegisterBitfieldStat_Int( StatEnumStruct ornull enumStructOrNull, string fieldName, bool writeImmediately,
		StatCalcFuncInfo functionref( StatEntry, array<StatTemplate> ) setupFunc, array<StatTemplate> sourceTemplates, int gameMode )
{
	StatTemplate stat = InternalRegisterStatCommon( enumStructOrNull, fieldName, eStatType.INT, eStatBehavior.BITFIELD, writeImmediately, false, gameMode )

	InternalRegisterCalcFunc( stat, setupFunc, sourceTemplates )

	return stat
}
#endif


#if SERVER

void function Stats_Save( entity player )
{
	if ( IsLowCostBot( player ) )
		return

	Assert( player.IsPlayer() )

	#if DEVELOPER
		//if ( GetConVarBool( "persistence_development_mode", false ) )
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	if ( fileLevel.doOnDemandStats )
	{
		if ( player in fileLevel.playerDirtyStats )
		{
			foreach ( StatEntry entry in fileLevel.playerDirtyStats[ player ] )
			{
				int index = entry.indexWithinType
				SaveStatInt( player, index, entry )
			}
		}
	}
	else
	{
		foreach ( int index, StatEntry entry in fileLevel.stats_Int )
		{
			SaveStatInt( player, index, entry )
		}
	}
}

#endif

#if SERVER
void function MarkStatAsDirtyForPlayer( entity player, StatEntry entry )
{
	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	// SHOULD have happened when persistence was ready; defensive fix for live issue
	if ( ( player in fileLevel.playerDirtyStats ) == false )
	{
		// initialize (otherwise .append doesn't work)
		fileLevel.playerDirtyStats[ player ] <- []
	}

	if ( fileLevel.playerDirtyStats[ player ].contains( entry ) == false )
	{
		fileLevel.playerDirtyStats[ player ].append( entry )
	}
}
#endif

#if SERVER
void function LoadStatValuesFromPersistenceIntoPlayerStruct( entity player, StatEntry entry, bool isInitializing )
{
	int index = entry.indexWithinType
	if ( player.p.statValues_Int[index] == UNINITIALIZED || isInitializing )
	{
		if ( entry.behavior != eStatBehavior.CALCULATED || entry.shouldCache )
		{
			player.p.statValues_Int[index] = expect int(player.GetPersistentVar( entry.persistenceFullKey_Current ) )
			player.p.statValuesAtStart_Int[index] = player.p.statValues_Int[index]

			Assert( player.p.statValuesAtStart_Int[index] != UNINITIALIZED, "Found an unitialized value for non-calculated stat: " + entry.persistenceFullKey_Current )
		}
	}
}
#endif



#if SERVER
void function SaveStatInt( entity player, int index, StatEntry entry )
{
	if ( entry.behavior != eStatBehavior.CALCULATED || entry.shouldCache )
	{
		Assert(index < player.p.statValues_Int.len(), "Stats_Save " + entry.persistenceFullKey_Current)
		int statToSave = player.p.statValues_Int[index]
		Assert( statToSave != UNINITIALIZED, "Tried to save an unitialized value for stat: " + entry.persistenceFullKey_Current )
		if ( statToSave != UNINITIALIZED )
			player.SetPersistentVar( entry.persistenceFullKey_Current, statToSave )
	}
}
#endif


#if SERVER && DEVELOPER
void function GenerateGameStatsPDef()
{
	array<string> allWeaponStatsCategories = []

	foreach( ItemFlavor weapon in GetAllWeaponItemFlavors() )
	{
		string category = WeaponItemFlavor_GetStatsCategory( weapon )
		if ( !allWeaponStatsCategories.contains( category ) )
			allWeaponStatsCategories.append( category )
	}
	DEV_PDefGen_AddEnum( "eWeaponStatCategory", allWeaponStatsCategories, "All the weapon stats categories." )
	DEV_PDefGen_AddEnum( "eModesFlavors", STATS_ALTERNATE_MODE_REFS, "All the mode flavors that are registered in the game." )

	bool didRegister
	didRegister = GenerateGameStatsPDef_RegisterRootStatsStruct( "sStatsData", "sStatEnumStruct", "current data" )
	Assert( didRegister )

	DEV_PDefGen_BeginFieldGroup( "stats" )
	DEV_PDefGen_AddField_Struct( "sStatsData", STATS_PERSISTENCE_PREFIX_CURRENT )
	DEV_PDefGen_EndFieldGroup()
}
#endif


#if SERVER && DEVELOPER
bool function GenerateGameStatsPDef_RegisterRootStatsStruct( string structName, string sesNamePrefix, string comment )
{
	array<StatEnumStruct> childSESList = []
	foreach ( StatEnumStruct childSES in fileLevel.rootFieldsList.childEnumStructs )
	{
		if ( GenerateGameStatsPDef_RegisterSESRecursive( sesNamePrefix, childSES, null ) )
			childSESList.append( childSES )
	}

	array<StatTemplate> childStatList = []
	foreach ( StatTemplate stat in fileLevel.rootFieldsList.childStatTemplates )
	{
		childStatList.append( stat )
	}

	if ( childSESList.len() == 0 && childStatList.len() == 0 )
		return false

	DEV_PDefGen_BeginStruct( structName, comment )
	foreach ( StatEnumStruct ses in childSESList )
	{
		DEV_PDefGen_AddField_StructArray_EnumKey( ses.structName, ses.fieldName, ses.enumName )
	}
	foreach ( StatTemplate stat in childStatList )
	{
		GenerateGameStatsPDef_AddStatField( stat )
	}
	DEV_PDefGen_EndStruct()

	return true
}
#endif


#if SERVER && DEVELOPER
bool function GenerateGameStatsPDef_RegisterSESRecursive( string structNamePrefix, StatEnumStruct ses, StatEnumStruct ornull parentSESOrNull )
{
	if ( parentSESOrNull == null )
	{
		ses.structName = structNamePrefix + "_" + ses.fieldName
	}
	else
	{
		StatEnumStruct parentSES = expect StatEnumStruct(parentSESOrNull)
		ses.structName = parentSES.structName + "_" + ses.fieldName
	}

	StatEnumStruct_Children children
	if ( ses in fileLevel.sesChildrenMap )
		children = fileLevel.sesChildrenMap[ses]

	array<StatEnumStruct> childSESList = []
	foreach ( StatEnumStruct childSES in children.childEnumStructs )
	{
		if ( GenerateGameStatsPDef_RegisterSESRecursive( structNamePrefix, childSES, ses ) )
			childSESList.append( childSES )
	}

	array<StatTemplate> childStatList = []
	foreach ( StatTemplate stat in children.childStatTemplates )
	{
			childStatList.append( stat )
	}

	if ( childSESList.len() == 0 && childStatList.len() == 0 )
		return false

	DEV_PDefGen_BeginStruct( ses.structName )
	foreach ( StatEnumStruct childSES in childSESList )
	{
		DEV_PDefGen_AddField_StructArray_EnumKey( childSES.structName, childSES.fieldName, childSES.enumName )
	}
	foreach ( StatTemplate stat in childStatList )
	{
		GenerateGameStatsPDef_AddStatField( stat )
	}
	DEV_PDefGen_EndStruct()

	return true
}
#endif


#if SERVER && DEVELOPER
void function GenerateGameStatsPDef_AddStatField( StatTemplate stat )
{
	if ( stat.behavior == eStatBehavior.CALCULATED && !stat.shouldCache )
		return

	Assert( stat.type != eStatType.INVALID, "StatTemplate was not initialized." )
	DEV_PDefGen_AddField_Int( stat.fieldName )
}
#endif

