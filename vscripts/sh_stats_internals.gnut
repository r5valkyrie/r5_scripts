/////////////////////////
//// Initialiszation ////
/////////////////////////
/////////////////////////

#if SERVER || CLIENT || UI
void function ShStatsInternals_LevelInit()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	#if SERVER
		#if DEVELOPER
			AddCallback_GeneratePDef( GenerateGameStatsPDef )
			AddClientCommandCallback( "stats_dump", ClientCommand_stats_dump ) // dev
			AddClientCommandCallback( "stats_set", ClientCommand_stats_set ) // dev
		#endif

		AddCallback_OnPersistentDataReady( Stats_OnPersistentDataReady )
	#endif

	#if SERVER && DEVELOPER
		DEV_SetStatsMultiplier( GetCurrentPlaylistVarFloat( "stats_dev_multiplier", 1.0 ) )
	#endif

	int lobbyMultiplier = IsLobby() ? 10 : 1 // stats don't change in the lobby, so cache for 10X
	fileLevel.calculatedStatsCacheDurationSec = lobbyMultiplier * GetCurrentPlaylistVarInt( "calc_stats_cache_duration_sec", 30 )
	fileLevel.doOnDemandStats = GetCurrentPlaylistVarBool( "do_on_demand_stats", true )
}
#endif



