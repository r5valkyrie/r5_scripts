array<StatEntry> function GetCalcSourceEntriesFromEntry( StatEntry entry )
{
	array<StatEntry> calcSourceEntries
	if ( entry.calcSourceEntries == null )
		return []
	return expect array<StatEntry>( entry.calcSourceEntries )
}

#if SERVER || CLIENT || UI
bool function HasStatCachingOptimizations()
{
	return fileLevel.calculatedStatsCacheDurationSec > 0
}
#endif


#if SERVER || CLIENT || UI
int function GetStat_Int( entity player, StatEntry entry, int when = eStatGetWhen.CURRENT, int fetchMode = eStatFetchMode.DEFAULT )
{
	#if SERVER
		if ( IsLowCostBot( player ) )
			return 0
	#endif

	Assert( entry.type == eStatType.INT )
	#if CLIENT || UI
		if ( !entry.writeImmediately )
			Assert( when != eStatGetWhen.CURRENT || IsLobby(), format( "Cannot get current stats in client or UI VM during a match (they could be out of date): %s", entry.persistenceFullKey_Current ) )
	#endif

	if ( HasStatCachingOptimizations() )
	{
		int unixTime = GetUnixTimestamp()
		/* the "shouldCache" here refers to the broader ServerPlayerStruct-level support for caching of stats which we don't use for stats that change more frequently
		 * E.g.: damage with shotguns is calculated and will change during a match, though not so often that we shouldn't cache it *periodically*
		 * but BP level will only change at the end of a match, so we cache that in the actual stat entry on the ServerPlayerStruct ONCE

		 * R5DEV-309611 aims to solve this. And should:
		 * * put ALL calculated stats into the ServerPlayerStruct with caching
		 * * introduce timing concepts to all stats ("shouldCache" really means - should cache for the WHOLE match)
		 * * don't run calculations at the beginning of matches - use IsLobby more judiciously
		 */
		if ( ( when == eStatGetWhen.CURRENT || when == eStatGetWhen.START_OF_CURRENT_MATCH )
				&& entry.behavior == eStatBehavior.CALCULATED && !entry.shouldCache )
		{
			/*if ( player in fileLevel.calculatedStatsCache )
			{
				foreach ( CalcStatCache calcStat in fileLevel.calculatedStatsCache[player] )
				{
					if ( fetchMode == eStatFetchMode.DEFAULT && calcStat.when == when && calcStat.statRef == entry.persistenceFullKey_Current && unixTime <= calcStat.timeStamp + fileLevel.calculatedStatsCacheDurationSec )
						return calcStat.value
					else if ( calcStat.when == when && calcStat.statRef == entry.persistenceFullKey_Current && ( unixTime > calcStat.timeStamp + fileLevel.calculatedStatsCacheDurationSec || fetchMode == eStatFetchMode.FORCE_NO_CACHE  ) ) // purge
						fileLevel.calculatedStatsCache[player].fastremovebyvalue( calcStat )
				}

				// we have the player in the cache, but not this particular stat (or it expired)
				CalcStatCache calcStat
				calcStat.value = entry.calcFunc_Int( player, GetCalcSourceEntriesFromEntry( entry ), when )
				calcStat.timeStamp = unixTime
				calcStat.statRef = entry.persistenceFullKey_Current
				calcStat.when = when
				fileLevel.calculatedStatsCache[ player ].append( calcStat )

				return calcStat.value
			}
			else
			{
				// put this new player and their first calc stat in the cache
				CalcStatCache calcStat
				calcStat.value = entry.calcFunc_Int( player, GetCalcSourceEntriesFromEntry( entry ), when )
				calcStat.timeStamp = unixTime
				calcStat.statRef = entry.persistenceFullKey_Current
				calcStat.when = when
				fileLevel.calculatedStatsCache[ player ] <- [ calcStat ]

				return calcStat.value
			}*/
		}
	}
	else // original flow with no calculated stats caching
	{
		if ( (when == eStatGetWhen.CURRENT || when == eStatGetWhen.START_OF_CURRENT_MATCH)
				&& entry.behavior == eStatBehavior.CALCULATED && !entry.shouldCache )
			return entry.calcFunc_Int( player, GetCalcSourceEntriesFromEntry( entry ), when )
	}

	if ( entry.behavior == eStatBehavior.BITFIELD && fetchMode != eStatFetchMode.BITFIELD_RAW )
		return entry.calcFunc_Int( player, GetCalcSourceEntriesFromEntry( entry ), when )

	#if DEVELOPER
		//if ( GetConVarBool( "persistence_development_mode", false ) )
		if ( DEV_ShouldIgnorePersistence() )
			return 0
	#endif

	#if SERVER
		// TODO - R5DEV-350896: on demand stats
		if ( fileLevel.doOnDemandStats )
				LoadStatValuesFromPersistenceIntoPlayerStruct( player, entry, false )

		if ( when == eStatGetWhen.CURRENT )
		{
			Assert( player.p.statValues_Int[entry.indexWithinType] != UNINITIALIZED )
			return player.p.statValues_Int[entry.indexWithinType]
		}
		else if ( when == eStatGetWhen.START_OF_CURRENT_MATCH )
		{
			Assert( player.p.statValuesAtStart_Int[entry.indexWithinType] != UNINITIALIZED )
			return player.p.statValuesAtStart_Int[entry.indexWithinType]
		}
		unreachable
	#elseif CLIENT || UI
		if ( when == eStatGetWhen.CURRENT || when == eStatGetWhen.START_OF_CURRENT_MATCH )
		{
			if ( !entry.writeImmediately )
				Assert( when != eStatGetWhen.CURRENT || IsLobby() )
			return expect int(player.GetPersistentVar( entry.persistenceFullKey_Current ))
		}
		unreachable
	#endif
}

