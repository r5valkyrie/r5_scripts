#if SERVER
void function Inventory_SetPlayerEquipment_Internal( entity player, string itemRef, string equipmentSlot, int propertyValue, entity deathBox, bool isForRefresh )
{
	//
	{
		string currentEquip = Inventory_GetPlayerEquipment( player, equipmentSlot )
		if ( SURVIVAL_Loot_IsRefValid( currentEquip ) )
		{
			LootData data = SURVIVAL_Loot_GetLootDataByRef( currentEquip )
			if ( data.passive != ePassives.INVALID )
				TakePassive( player, data.passive )
		}
	}

	EquipmentSlot es = Survival_GetEquipmentSlotDataByRef( equipmentSlot )
	int index        = -1
	int prevShields = player.GetShieldHealth()

	if ( equipmentSlot == "armor" )
	{
		int currentShields = player.GetShieldHealth()
		player.SetShieldHealthMax( GetPlayerSettingBaseShield( player ) )
		player.SetShieldHealth( minint( currentShields, player.GetShieldHealthMax() ) )
	}

	if ( SURVIVAL_Loot_IsRefValid( itemRef ) )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByRef( itemRef )
		index = data.index

		if ( data.passive != ePassives.INVALID )
		{
			GivePassive( player, data.passive )
		}

		if ( data.lootType == eLootType.ARMOR && equipmentSlot == "armor" )
		{
			int healthFromPropValue = GetPropSurvivalMainProperty( propertyValue )
			int newShieldAmount     = player.GetShieldHealth() + healthFromPropValue

			int maxShield = SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, data )

			player.SetShieldHealthMax( maxShield )

			                    
			if( UpgradeCore_IsEquipmentArmorCore( data.ref ) )
			{
				int prevShieldTotal = prevShields + GetPlayerExtraShields( player )
				bool updateExtraShieldsTier = newShieldAmount > prevShieldTotal
				int overshieldAmount = 0
				int clampedShieldAmount = minint( newShieldAmount, maxShield )
				overshieldAmount = newShieldAmount - clampedShieldAmount
				newShieldAmount = clampedShieldAmount
				SetPlayerExtraShields( player, overshieldAmount )

				if( updateExtraShieldsTier )
				{
					int tier = GetShieldTierFromShieldAmount( healthFromPropValue )
					if ( tier == 4 )
						tier = 5
					SetPlayerExtraShieldsTier( player, tier )
				}
			}
         

			Assert( newShieldAmount <= maxShield, format( "Attempted to give player more shield health (%i) than maximum (%i)", newShieldAmount, maxShield ) )
			player.SetShieldHealth( newShieldAmount )
		}
	}

	if ( es.trackingNetInt != "" )
	{
		player.SetPlayerNetInt( es.trackingNetInt, index )
	}

	file.playerInventoryData[ player ][ equipmentSlot ] = itemRef

	if ( es.specialCaseEquipFunc != null )
		es.specialCaseEquipFunc( player, itemRef, deathBox, isForRefresh )

	if ( (itemRef != "") && !isForRefresh )
		StatsHook_PlayerEquip( player )

	                  
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			FR_Nessie_CheckCurrentWeapons( player )
		}
       
}
void function Inventory_SetPlayerEquipment( entity player, string itemRef, string equipmentSlot, int propertyValue = 0, entity deathBox = null )
{
	Inventory_SetPlayerEquipment_Internal( player, itemRef, equipmentSlot, propertyValue, deathBox, false )
}
void function SetPlayerEquipmentForRefresh( entity player, string itemRef, string equipmentSlot, int propertyValue )
{
	Inventory_SetPlayerEquipment_Internal( player, itemRef, equipmentSlot, propertyValue, null, true )
}

string function Inventory_GetPlayerEquipment( entity player, string equipmentSlot )
{
	return file.playerInventoryData[ player ][ equipmentSlot ]
}

void function Inventory_RefreshAllPlayerEquipment( entity player )
{
	foreach ( string slot, EquipmentSlot slotData in EquipmentSlot_GetAllEquipmentSlots() )
	{
		string itemRef = Inventory_GetPlayerEquipment( player, slot )
		if ( itemRef == "" )
			continue

		                      
			//Swap character fix for the Copycat Kit
			if ( itemRef.find( COPYCAT_NAME ) != -1 )
			{
				SURVIVAL_DropPlayerEquipment( player, "gadgetslot" )
				continue
			}
        

		int propertyValue = Inventory_GetSurvivalPropertyValueForEquipment( player, slot )

		SetPlayerEquipmentForRefresh( player, "", slot, 0 )
		SetPlayerEquipmentForRefresh( player, itemRef, slot, propertyValue )
	}
}

