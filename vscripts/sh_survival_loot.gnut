void function OnPropSurvivalCreate( entity prop )
{
	int index = prop.GetSurvivalInt()

	if ( index < 0 )
		return

	SURVIVAL_Loot_UpdateHighlightForLoot( prop )

	file.allLoot.append( prop )

	LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

                                      
                                                                                                                              
                                  
   
             
                                          
     
                                                                 
     
         
   
                                    
   
             
                                                        
     
                                                                 
     
         
   
                                           

                        
            
                                                    
    
                                                          
    
        
                              

                    
            
                                                
    
                                                           
    
        
                          

                          
            
                                                  
    
                                                          
    
        
                                

	                  
		#if SERVER
			if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
			{
				PropSurvivalFlagsSet( prop, ePropSurvivalFlag.HIDE_LOOT_LINE )
			}
		#endif
                         

	#if SERVER
		if ( GetCurrentPlaylistVarBool( "edict_cleanup_loot_merge_enabled", true ) )
		{
			file.newlySpawnedLootPendingCheck.append( prop )
			if ( file.initialLootDoneSpawning && !file.lootCheckPending  )
			{
				thread CheckForPotentiallyUselessLoot_OnLootSpawn_Thread( )
			}
		}

	                    
		if( UpgradeCore_IsEquipmentArmorCore( data.ref ) )
		{
			// we don't want to set this on armor that's in a deathbox, but since this is called at spawn we don't know if its in one yet
			// wait a frame and then check if it is parented to a deathbox
			thread DelayedSetArmorSkin( prop, data.tier )
		}
       
	#endif //SERVER

	AddCallback_OnUseEntity_ClientServer( prop, OnUseSurvivalPickup )
	SetCallback_CanUseEntityCallback( prop, SurvivalLoot_CanUseFunction )
}

#if SERVER
                    
	void function DelayedSetArmorSkin( entity ent, int tier )
{
	ent.EndSignal( "OnDestroy" )
	WaitFrame()
	entity entParent = ent.GetParent()
	if( IsValid( entParent ) && entParent.GetNetworkedClassName() == "prop_death_box")
		return
	// if fully depleted use the 0 index skin, otherwise use the tier to determine the skin.
	// gold is skipped in the skins so we can just clamp red tier to be the max skin index
	int currentShieldCharge = GetPropSurvivalMainPropertyFromEnt( ent )
	if( currentShieldCharge <= 0 )
	{
		ent.SetSkin( minint( tier, 0 ) )
		return
	}

	ent.SetSkin( minint( tier, ent.GetSkinCount() - 1 ) )
	int holoEffect     = GetParticleSystemIndex( SHIELD_CORE_PARTICLE_SYSTEM )
	// for some reason the fx does not obey rotation when spawn on the entity, so just spawn it at its location and parent for now
	entity effect = StartParticleEffectInWorld_ReturnEntity( holoEffect, ent.GetOrigin(), ent.GetAngles() )
	effect.SetParent( ent )
	EffectSetControlPointVector( effect, 1, GetFXRarityColorForTier( tier ) )
}
      

void function WaitForLootSpawned_Thread()
{
	WaitFrame()

	FlagWait( "Survival_LootSpawned" )

	thread CheckForPotentiallyUselessLoot_Initial_Thread( )
}

//This system checks through loot for items that can potentially be merged/deleted if we run out of edicts, and passes data off to code to perform the actual merges because script was too slow.
void function CheckForPotentiallyUselessLoot_Initial_Thread( )
{
	array< entity > lootBeingChecked = file.newlySpawnedLootPendingCheck
	file.newlySpawnedLootPendingCheck = []

	file.initialLootDoneSpawning = true

	//We wait here so we're not doing a bunch of work at the same time as everyone else who waits on loot spawned
	WaitFrame()

	const int LOOPS_PER_FRAME = 1000
	int numberOfLoops = 0
	foreach ( entity prop in lootBeingChecked)
	{
		if ( !IsValid( prop ) )
			continue

		int index = prop.GetSurvivalInt()
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

		//we don't need to check for helmets or knockdown shields initially since they don't spawn
		if ( data.tier == 1 )
		{
			switch( data.lootType )
			{
				case eLootType.AMMO:
				case eLootType.HEALTH:
					//EdictManager_AddLootForMerge( prop, data.inventorySlotCount )
					break
			}
		}

		if ( numberOfLoops < LOOPS_PER_FRAME )
		{
			numberOfLoops++
		}
		else
		{
			numberOfLoops = 0
			WaitFrame()
		}
	}
}

void function CheckForPotentiallyUselessLoot_OnLootSpawn_Thread( )
{
	file.lootCheckPending = true

	wait 1

	array< entity > lootBeingChecked = file.newlySpawnedLootPendingCheck
	file.newlySpawnedLootPendingCheck = []
	file.lootCheckPending = false

	//we wait here to make sure we don't destroy something someone JUST dropped
	float waitTime = GetCurrentPlaylistVarFloat( "edict_cleanup_wait_time", 10 )
	wait waitTime

	foreach ( entity prop in lootBeingChecked )
	{
		if ( !IsValid( prop ) )
			continue

		bool isInDeathbox = false
		entity parentEnt = prop.GetParent()
		if ( IsValid( parentEnt ) && parentEnt.GetNetworkedClassName() == "prop_death_box" )
		{
			isInDeathbox = true
		}

		int index = prop.GetSurvivalInt()
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( index )

		//Tier 1 Helmets and knockdowns can't be picked up, which makes them sorta useless
		if ( data.tier != 1 )
		{
			continue
		}

		switch ( data.lootType )
		{
			case eLootType.HELMET:
			case eLootType.INCAPSHIELD:
				if ( !isInDeathbox )
				{
					file.uselessLootItems.append( prop )
				}
				break

			case eLootType.AMMO:
			case eLootType.HEALTH:
				//EdictManager_AddLootForMerge( prop, data.inventorySlotCount )
				break
		}
	}
}

int function TryDespawnUselessLoot( int goal )
{
	int propsDestroyed = 0
	int optinPropsDestroyed = 0;
	int uselessEntitiesCount = file.uselessLootItems.len() + file.optinUselessEntities.len()
	for ( int i = uselessEntitiesCount - 1; i >= max( uselessEntitiesCount - goal, 0 ); i-- )
	{
		if( file.optinUselessEntities.len() > 0 )
		{
			entity entToDelete = file.optinUselessEntities.pop()
			if ( IsValid( entToDelete ) )
			{
				propsDestroyed++
				optinPropsDestroyed++
				entToDelete.Destroy()
			}
			continue
		}
		entity entToDelete = file.uselessLootItems.pop()
		if ( IsValid( entToDelete ) )
		{
			propsDestroyed++
			entToDelete.Destroy()
		}
	}

	if ( GetConVarBool( "sv_edict_cleanup_display_warnings" ) )
	{
		printt( "Sucessfully deleted " + optinPropsDestroyed + " opted-in props, and " + (propsDestroyed - optinPropsDestroyed) + " discovered useless items." )
	}
	return propsDestroyed
}

void function FlagEntityForDeletionInEmergency( entity ent )
{
	file.optinUselessEntities.append( ent )
}

