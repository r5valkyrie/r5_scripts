array<entity> function SURVIVAL_Loot_GetAllLoot()
{
	return file.allLoot
}

bool function ShouldDropOpticForKittedWeapon()
{
	if ( IsCurrentModeMixtape() )
	{
		return GetCurrentPlaylistVarBool( "drop_optic_for_kitted_weapons", false )
	}

	return GetCurrentPlaylistVarBool( "drop_optic_for_kitted_weapons", true )
}

                                     
                                                               
 
                                         
 

                                                       
 
                                  
 

                                                         
 
                                    
 

                                                             
 
                                          
 

                                                                 
 
                                              
 

                                                                            
 
                                                                                                
           
                                                                  
       
 

                                         
 
                                                                                                                                                                                         

                                                                                                                                                                  
                                                                                                                                                                  
                                                                                                                                                                     
                                                                                                                                                                        
                                                                                                                                                                     
                                                                                                                                                                  

                                                                                                                                                          
                                                                                                                                                       
                                                                                                                                                          
                                                                                                                                                 
                                                                                                                                                          
                                                                                                                                                             
                                                                                                                                                                        

                                                                                                                                                       
                                                                                                                                                                                            

                                                                                                                                                                                                      
 

                                                                    
 
                                        
  
                                            
   
                                                                                          
   

             
  

             
 

                                                                                          
 
                                                                                       
                       
                                              
                                                     
                                                                                                                

                                          

                           
              

            
 

                                                                                                              
 
                                                                                       
                       

                                                                                                                                                                                                         

                                                                                                                    

                                          

                           
              

            
 

                                                                                            
 
                                                                                                                    
                                

                                      

                                                            
                                                                                                                                     
                                 

                                                                   
                                             
                                       

                                                                                                               

                                                                                  

                                           
  
                                
           

                                                 

                                            
   
                                                 
    
                                    
                                                                                                
    
       
    
                                                 
    
   
      
   
                                                
   
  


                                     
                                                                        

                         
                      

                        
  
         
                    
        
         
                    
        
         
                    
        
         
         
                    
        

          
                                                           
        
  

                    
  
                                                                             
                                                                 
        
                 
                                                                 
        
                  
                                                                  
        
                   
                                                                   
        
                  
                                                                  
        
                  
                                                                 
        
          
                                                            
        
  

                                
  
                                              
   
                                                   
    
                                                     
     
                                                                                                                                    
     
        
     
                                                                                                                                                  
     
    
   
  

                                
                                                            

                                                           

                               
 

                                                                                                  
 
                                                                                                                       
                                  

                                         

                                                                          
                                                               
                                    

                                     
                                                                        

                                                                                  
                                         

                                  
  
                           

                       

                         
   
                        
                    
        

                                 
                    
        

                                 
                    
        

                                   

                                                                                                                
                    
        

           
                                                            
         
   

                            

                       
   
                                       
                         
         

                                       
                         
         

                                               
                          
                         
        

                                       
                         
         

                                       
                         
         

                                   
                          
                         
         

           
                         
         
   

                                    
                                             

                       
                                                                
      
                                                
  
     
  
                        
                           

                    
                             
                         

                       
   
                                       
                         
                                                         
         

                                       
                                                        
                
         

                                               
                
                     
                                                         
        

                                       
                
                                                         
         

                                       
                         
                                                      
         

                                   
                     
                                                          
         

           
                      
         
   

                         
   
                        
                        
     
                                           
     
        
     
                                           
     
         
                                 
                        
     
                                           
     
        
     
                                           
     
         

                                 
                        
     
                                           
     
        
     
                                           
     
         
                                   
                                                                                                                
                        
     
                                           
     
        
     
                                           
     
         
           
                                                            
         
   

                  
   
                          
                         
                                                                         
                         
   

                                    
   
              
                                             
   

                                               
  

                                 
 

                                                                                             
 
                                  

                                                                                  

                                
                             

                                           
  
                                                 

                              
   
                                  
                               
   
  

                            
 


                                          

string function GetWeaponClassNameWithLockedSet( entity weapon )
{
	string result = weapon.GetWeaponClassName()

	if ( weapon.HasMod( WEAPON_LOCKEDSET_MOD_PAINTBALL ) )
	{
		result += WEAPON_LOCKEDSET_SUFFIX_PAINTBALL
	}
	else
	{
		foreach ( mod, suffix in LOCKEDSET_MOD_TO_SUFFIX )
		{
			if ( weapon.HasMod( mod ) )
			{
				result += suffix

				//HACKY HACKY HACK TO TEMP FIX R5DEV-567586 -Anthony
                               
                                                                  
      
                                              
      
          

				return result
			}
		}
	}

               
                                                                                 
  
                     
  
       

	switch( weapon.GetWeaponLockedSet() )
	{
		case eWeaponLockedSet.WHITESET:
			result += WEAPON_LOCKEDSET_SUFFIX_WHITESET
			break

		case eWeaponLockedSet.BLUESET:
			result += WEAPON_LOCKEDSET_SUFFIX_BLUESET
			break

		case eWeaponLockedSet.PURPLESET:
			result += WEAPON_LOCKEDSET_SUFFIX_PURPLESET
			break

		case eWeaponLockedSet.GOLD:
			result += WEAPON_LOCKEDSET_SUFFIX_GOLD
			break
	}

	return result
}


bool function WeaponLootRefIsLockedSet( string ref )
{
	//Simplifying the logic here by a LOT since all locked sets have a base weapon
	if ( SURVIVAL_Loot_IsRefValid( ref ) )
	{
		LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( ref )

                      
                                                  
               
        

		return weaponData.baseWeapon != ref
	}
	return false
}

bool function CodeCallback_WeaponModCommandCheckMods( entity player, entity weapon, string mod, bool isAdd )
{
	array<string> alwaysAllowedMods = [
		"akimbo",
		"vertical_firestar",
		"double_link_mod",
		"altfire",
	]

	if ( mod == "choke" || mod == "kinetic_choke")
		return EnergyChoke_OnWeaponModCommandCheckMods( player, weapon, mod, isAdd )

	if ( alwaysAllowedMods.contains( mod ) )
		return true

	if ( ToggleModNeedsAttachments( mod ) )
	{
#if DEVELOPER
		return true //Allows debug command 'weapon_mod' to apply attachment-based mods
#else
		return ToggleModHasRequiredAttachments( mod, weapon.GetMods() )
#endif
	}

	if ( Consumable_IsValidModCommand( player, weapon, mod, isAdd ) )
		return true

                           
                                                                      
             
      

	#if DEVELOPER
		if ( GetBugReproNum() == 762 )
			return true
	#endif

	return false
}

#if SERVER
void function SURVIVAL_Loot_DisableNetworkDistanceCullingManaged( entity loot )
{
	if ( loot in file.lootNetworkDistanceCullingState )
	{
		file.lootNetworkDistanceCullingState[ loot ] += 1
	}
	else
	{
		//GetNetworkDistanceCull not in S3

		file.lootNetworkDistanceCullingState[ loot ] <- 1
	}

	//loot.SetNetworkDistanceCull( false )
}

void function SURVIVAL_Loot_EnableNetworkDistanceCullingManaged( entity loot )
{
	if( !(loot in file.lootNetworkDistanceCullingState) )
	{
		//if ( loot.GetNetworkDistanceCull() )
		{
			Assert ( loot in file.lootNetworkDistanceCullingState, "Loot is not in managed distance culling table." )
		}

		return
	}

	file.lootNetworkDistanceCullingState[ loot ] -= 1

	if ( file.lootNetworkDistanceCullingState[ loot ] <= 0 )
	{
		//loot.SetNetworkDistanceCull( true )
		delete file.lootNetworkDistanceCullingState[ loot ]
	}
}

array<LootData> function SURVIVAL_Loot_GetByType_InLevel( int lootType, int maxTier = -1, int minTier = -1 )
{
	array<LootData> lootOfType = []
	foreach ( string lootRef, LootData lootData in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( !IsLootTypeValid( lootData.lootType ) )
			continue

		if ( lootData.lootType != lootType )
			continue

		if ( !LootTypeHasAnyChanceToSpawn( lootRef ) )
			continue

		if ( maxTier > -1 && lootData.tier > maxTier )
			continue

		if ( minTier > -1 && lootData.tier < minTier )
			continue

		lootOfType.append( lootData )
	}

	return lootOfType
}

array<LootData> function SURVIVAL_Loot_GetByType_FixedTier( int lootType, int tier )
{
	array<LootData> lootOfType = []
	foreach ( string lootRef, LootData lootData in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( !IsLootTypeValid( lootData.lootType ) )
			continue

		if ( lootData.lootType != lootType )
			continue

		if ( !LootTypeHasAnyChanceToSpawn( lootRef ) )
			continue

		if ( tier > -1 && lootData.tier != tier )
			continue

		lootOfType.append( lootData )
	}

	return lootOfType
}
#endif

string function SURVIVAL_Loot_GetDetailType2String( LootData lootData )
{
	switch ( lootData.lootType )
	{
		case eLootType.MAINWEAPON:
			if ( lootData.baseMods.contains( "crate" ) )
				return "#WPN_CATEGORY_CRATE"
			else if ( SURVIVAL_Weapon_IsAttachmentLocked( lootData.ref ) )
				return "#WPN_CATEGORY_FULLY_KITTED"
			break
	}
	return ""
}


string function SURVIVAL_Loot_GetDetailTypeString( LootData lootData )
{
	switch ( lootData.lootType )
	{
		case eLootType.MAINWEAPON:
			return GetStringForTagId( weaponClassToTag[lootData.lootTags[0]] )

		case eLootType.AMMO:
			return ""

		case eLootType.HEALTH:
			int kitType = SURVIVAL_Loot_GetHealthPickupTypeFromRef( lootData.ref )
			HealthPickup pickupInfo = SURVIVAL_Loot_GetHealthKitDataFromStruct( kitType )
			if ( pickupInfo.healAmount > 0 && pickupInfo.shieldAmount > 0 )
				return "#HEAL_TYPE_COMBO"
			else if ( pickupInfo.healAmount > 0 && pickupInfo.healCap > 100 )
				return "#HEAL_TYPE_COMBO"
			else if ( pickupInfo.healAmount > 0 )
					return "#HEAL_TYPE_HEALTH"
				else if ( pickupInfo.shieldAmount > 0 )
						return "#HEAL_TYPE_SHIELD"
					else if ( pickupInfo.ultimateAmount > 0 )
							return "#HEAL_TYPE_ULTIMATE"
			return ""

		case eLootType.ARMOR:
			return "#ITEM_TYPE_DEFENSE"

		case eLootType.INCAPSHIELD:
			return ""

		case eLootType.JUMPKIT:
			return ""

		case eLootType.ORDNANCE:
			if ( lootData.ref == "mp_ability_mobile_respawn_beacon" )
				return "#ITEM_TYPE_SPECIAL"
			return "#ITEM_TYPE_THROWN"

		case eLootType.ATTACHMENT:
			array<string> attachPoints = GetAttachPointsForAttachment( lootData.ref )
			return GetAttachmentPointName( attachPoints[0] )	//dbocek: may need to improve this if we start allowing multi attach point attachments that don't share a string, but for now it's only hopup slots which share a string

		case eLootType.BACKPACK:
			return ""

		case eLootType.CUSTOMPICKUP:
			return ""
                      
		case eLootType.CANDY_PICKUP:
			return ""
      

                    
		case eLootType.EVO_CACHE:
			return ""
      

                       

                            
            
      

		case eLootType.HELMET:
			return "#ITEM_TYPE_DEFENSE"

                      
		case eLootType.DATAKNIFE:
      
                  
		case eLootType.SHIPKEYCARD:
      
			return "#ITEM_TYPE_SPECIAL"

                   

		case eLootType.MARVIN_ARM:
			return ""
      

		case eLootType.RESOURCE:
			return "#ITEM_TYPE_SHIELDS"

		case eLootType.GADGET:
				return "#GADGET_SLOT"

		case eLootType.BLANK:
			return ""
	}

	return ""
}


