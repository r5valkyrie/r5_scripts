int function GetPropSurvivalMainProperty( int prop )
{
	int offset     = 0
	int enoughBits = (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_MAIN_PROPERTY_BITS) - 1
	return (prop >> offset) & enoughBits
}
#endif


