#if SERVER || CLIENT
bool function IsPlayerCloseEnoughToDeathBoxToLoot( entity player, entity deathBox )
{
	if ( !IsValidAndUsableDeathBoxEnt( deathBox ) )
		return false

	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	                                
		if ( deathBox.GetNetworkedClassName() == "prop_death_box" && PlayerHasPassive( player, ePassives.PAS_ALTER ) && CanPlayerRemoteInteractWithDeathbox( player, deathBox ) )
		{
			if ( IsBitFlagSet(deathBox.GetUsableValue(), USABLE_FROM_EXTENDED_RANGE) )
			{
				maxSquareDist = GetRemoteDeathboxInteractSqrRangeForAlter( player )
			}
		}
       

	return distanceToDeathbox <= maxSquareDist
}

                                
bool function IsPlayerWithinStandardDeathBoxUseDistance( entity player, entity deathBox )
{
	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	return distanceToDeathbox <= maxSquareDist
}
      

                                
bool function IsPlayerOutsideStandardDeathBoxUseDistanceButRemoteInteractAllowed( entity player, entity deathBox )
{
	if ( !IsValidAndUsableDeathBoxEnt( deathBox ) )
		return false

	float distanceToDeathbox = DistanceSqr( player.GetOrigin(), deathBox.GetOrigin() )
	float maxSquareDist = ( DEATH_BOX_MAX_DIST * DEATH_BOX_MAX_DIST )

	if ( distanceToDeathbox <= maxSquareDist )
		return false

	if ( deathBox.GetNetworkedClassName() == "prop_death_box" && PlayerHasPassive( player, ePassives.PAS_ALTER ) && CanPlayerRemoteInteractWithDeathbox( player, deathBox ) )
	{
		if ( IsBitFlagSet(deathBox.GetUsableValue(), USABLE_FROM_EXTENDED_RANGE) )
		{
			maxSquareDist = GetRemoteDeathboxInteractSqrRangeForAlter( player )
			return distanceToDeathbox <= maxSquareDist
		}
	}

	return false
}
      
#endif


#if SERVER || CLIENT
array<entity> function GetDeathBoxLootEnts( entity deathBox, entity realmEntity = null )
{
	if ( deathBox.GetNetworkedClassName() == "prop_death_box" )
	{
		return deathBox.GetLinkEntArray()
	}
	else if ( deathBox.GetNetworkedClassName() == "prop_loot_grabber" )
	{
                 
                                    
   
                                    
   
        

		vector deathBoxOrigin = deathBox.GetOrigin()
		float radius          = 150.0 /*GetLootGrabDist not in S3*/
		entity realmEnt		  = realmEntity == null ? deathBox : realmEntity

		array<entity> lootEnts = GetSurvivalLootNearbyPos( deathBoxOrigin, radius, false, false )

		#if SERVER
			array<entity> nearbyDeathBoxes = GetScriptManagedEntArrayWithinCenter( GetAllDeathBoxesSMEA(), TEAM_ANY, deathBoxOrigin, radius )
		#elseif CLIENT
			array<entity> nearbyDeathBoxes = ArrayWithin( GetAllDeathBoxes(), deathBoxOrigin, radius )
		#endif
		foreach ( entity nearbyDeathBox in nearbyDeathBoxes )
			lootEnts.extend( GetDeathBoxLootEnts( nearbyDeathBox ) )
		return lootEnts
	}

	Assert( false, "Unhandled death box class: " + string(deathBox.GetNetworkedClassName()) )
	return []
}
#endif

#if SERVER
int function SURVIVAL_GetProximateAmmoCount( entity player, entity ammoEnt )
{
	int ammoOfSameTypeCount     = 0
	bool lootingFromBlackMarket = false
	bool lootingFromDeathbox    = false

	if ( ! IsValid( ammoEnt ) ) // because this is called via callback, the ammo entity can be null by the time it hits here.
		return ammoOfSameTypeCount

	entity deathboxOrMarketBeingLooted = GetBlackMarketInUseByPlayer( player )

	                   
	if ( !deathboxOrMarketBeingLooted )
	{
		deathboxOrMarketBeingLooted = GetVendingMachineInUseByPlayer( player )
	}
       
	if ( IsValid( deathboxOrMarketBeingLooted ) )
	{
		lootingFromBlackMarket = true
	}
	else if ( IsLootEntInsideDeathBox( ammoEnt ) )
	{
		lootingFromDeathbox = true
		deathboxOrMarketBeingLooted = ammoEnt.GetParent()
	}

	array<entity> lootEnts = []
	if ( lootingFromBlackMarket )
	{
		vector blackMarketOrigin = deathboxOrMarketBeingLooted.GetOrigin()
		float  blackMarketRadius = 150.0 /*GetLootGrabDist not in S3*/
		lootEnts = GetSurvivalLootNearbyPos( blackMarketOrigin, blackMarketRadius, false, false )
		array<entity> nearbyDeathBoxes = GetScriptManagedEntArrayWithinCenter( GetAllDeathBoxesSMEA(), TEAM_ANY, blackMarketOrigin, blackMarketRadius )
		foreach ( entity nearbyDeathBox in nearbyDeathBoxes )
			lootEnts.extend( GetDeathBoxLootEnts( nearbyDeathBox ) )
	}
	else if ( lootingFromDeathbox )
	{
		lootEnts.extend( GetDeathBoxLootEnts( deathboxOrMarketBeingLooted ) )
	}

	if ( lootEnts.len() > 0 )
	{
		foreach ( entity lootEnt in lootEnts )
		{
			LootData ammoData = SURVIVAL_Loot_GetLootDataByIndex( ammoEnt.GetSurvivalInt() )
			LootData lootData = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )

			if ( ammoData.lootType == lootData.lootType && ammoData.ref == lootData.ref )
				ammoOfSameTypeCount += lootEnt.GetClipCount()
		}
	}
	else
	{
		ammoOfSameTypeCount = ammoEnt.GetClipCount()
	}

	return ammoOfSameTypeCount
}
#endif


#if SERVER || CLIENT
bool function IsLootEntAccessibleViaDeathBox( entity lootEnt, entity deathBox, entity player )
{
	Assert( lootEnt.GetNetworkedClassName() == "prop_survival" )

	if ( deathBox.GetNetworkedClassName() == "prop_death_box" )
	{
		#if SERVER
			return deathBox.IsLinkedToEnt( lootEnt )
		#elseif CLIENT
			return deathBox.GetLinkEntArray().contains( lootEnt )
		#endif
	}
	else if ( deathBox.GetNetworkedClassName() == "prop_loot_grabber" )
	{
		vector deathBoxOrigin = deathBox.GetOrigin()
		float radius          = 150.0 /*GetLootGrabDist not in S3*/

		                   
		if ( IsVendingMachineUnsafe( deathBox ) )
		{
			if ( !IsValid( player ) )
				return false

			if ( lootEnt.DoesShareRealms( player ) )
				return true

			#if SERVER
				array<entity> nearbyDeathBoxes = GetScriptManagedEntArrayWithinCenter( GetAllDeathBoxesSMEA(), TEAM_ANY, deathBoxOrigin, radius )
			#elseif CLIENT
				array<entity> nearbyDeathBoxes = ArrayWithin( GetAllDeathBoxes(), deathBoxOrigin, radius )
			#endif
			foreach ( entity nearbyDeathBox in nearbyDeathBoxes )
			{
				if ( IsLootEntAccessibleViaDeathBox( lootEnt, nearbyDeathBox, player ) )
					return true
			}

			return false
		}
		else
        
		{
			if ( DistanceSqr( lootEnt.GetOrigin(), deathBoxOrigin ) <= radius * radius && lootEnt.DoesShareRealms( deathBox ) )
				return true

			#if SERVER
				array<entity> nearbyDeathBoxes = GetScriptManagedEntArrayWithinCenter( GetAllDeathBoxesSMEA(), TEAM_ANY, deathBoxOrigin, radius )
			#elseif CLIENT
				array<entity> nearbyDeathBoxes = ArrayWithin( GetAllDeathBoxes(), deathBoxOrigin, radius )
			#endif
			foreach ( entity nearbyDeathBox in nearbyDeathBoxes )
			{
				if ( IsLootEntAccessibleViaDeathBox( lootEnt, nearbyDeathBox, player ) )
					return true
			}

			return false
		}
	}

	Assert( false, "Unhandled death box class: " + string(deathBox.GetNetworkedClassName()) )
	return false
}
#endif


#if SERVER || CLIENT
bool function IsLootEntInsideDeathBox( entity lootEnt )
{
	Assert( lootEnt.GetNetworkedClassName() == "prop_survival" )

	if ( !IsValid( lootEnt ) )
		return false

	entity lootEntParent = lootEnt.GetParent()

	if ( !IsValid( lootEntParent ) )
		return false

	if ( lootEntParent.GetNetworkedClassName() != "prop_death_box" )
	{
		return false
	}

	array<entity> boxLinkedEnts = lootEntParent.GetLinkEntArray()	// Trying to get the linked parent(s) of the loot wasn't working on the client, so I'm checking the box's linked ents instead
	if ( boxLinkedEnts.contains( lootEnt ) )
		return true
	else
		return false

	unreachable
}
#endif


#if SERVER || CLIENT
bool function DoesDeathBoxSupportAddingLoot( entity deathBox )
{
	return (deathBox.GetNetworkedClassName() == "prop_death_box") // not prop_loot_grabber
}
#endif


#if SERVER || CLIENT
float function GetFadeDistForLoot( LootData lootData )
{
	switch ( lootData.lootType )
	{
		case eLootType.MAINWEAPON:
			return 15000.0

		case eLootType.BACKPACK:
		case eLootType.HELMET:
		case eLootType.ARMOR:
			if ( lootData.tier > 1 )
				return 5000.0
			else
				return 2000.0

		case eLootType.HEALTH:
			if ( lootData.tier > 1 )
				return 5000.0
			else
				return 2000.0
	}

	return 2000.0
}

bool function SURVIVAL_EquipmentPretendsToBeBlank( string ref )
{
	if ( !SURVIVAL_Loot_IsRefValid( ref ) )
		return false

	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	return data.pretendsToBeBlank
}

bool function ShouldUseAltInteractForArmorSwap()
{
	return file.useAltInteractForArmorSwap
}

entity function GetDeathboxArmorSwap( entity player, entity box )
{
	array<entity> items = GetDeathBoxLootEnts( box )
	foreach ( int idx, entity item in items )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( item.GetSurvivalInt() )
		//
		if ( data.lootType == eLootType.ARMOR )
		{
			int currentShields  = SURVIVAL_GetPlayerShieldHealthFromArmor( player )
			int lootShields     = GetPropSurvivalMainPropertyFromEnt( item )

			bool isEvoProgressUpgrade = false
			/*
			This doesn't quite work - Progress = damage to next tier
			So if we want to check evo progress, need to compare loot tiers as well

			int currentEvoProgress = EvolvingArmor_GetEvolutionProgress( player )
			int lootEvoProgress = GetPropSurvivalExtraPropertyFromEnt( item )
			printf( "CURRENT PROGRESS: %d, LOOT PROGRESS: %d", currentEvoProgress, lootEvoProgress )
			isEvoProgressUpgrade = lootEvoProgress < currentEvoProgress
			*/

			if( lootShields > currentShields || lootShields == currentShields && isEvoProgressUpgrade )
				return item
			else
				return null
		}
	}

	return null
}
#endif

#if DEVELOPER && CLIENT
void function DEV_PrintAllLootRefsWithNames()
{
	array<string> pickupString   = []
	array<string> tier           = []
	array<string> ref            = []
	array<string> type			 = []

	int pickupStringLen   = 0
	int tierLen           = 0
	int refLen            = 0
	int typeLen           = 0

	printt( "-------------- ALL LOOT --------------" )
	foreach ( string name, LootData data in SURVIVAL_Loot_GetLootDataTable() )
	{
		if ( name == "blank" )
			continue

		string _pickupString = Localize( data.pickupString )
		string _type         = GetEnumString( "eLootType", data.lootType ) // could use: SURVIVAL_Loot_GetGeneralTypeString( data.lootType )
		string _tier = ""
		switch ( data.tier )
		{
			case 1:
				_tier = "WHITE"
				break
			case 2:
				_tier = "BLUE"
				break
			case 3:
				_tier = "PURPLE"
				break
			case 4:
				_tier = "GOLD"
				break
			case 5:
				_tier = "RED"
				break
			default:
				_tier = "NONE"
		}
		string _ref			 = name

		ref.append( _ref )
		pickupString.append( _pickupString )
		tier.append( _tier )
		type.append( _type )

		if ( _ref.len() > refLen )
			refLen = _ref.len()
		if ( _pickupString.len() > pickupStringLen )
			pickupStringLen = _pickupString.len()
		if ( _tier.len() > tierLen )
			tierLen = _tier.len()
		if ( _type.len() > typeLen )
			typeLen = _type.len()
	}

	Assert( type.len() == ref.len() && pickupString.len() == ref.len() && type.len() == ref.len() )

	ref.insert( 0, "LOOT REF" )
	pickupString.insert( 0, "GAME NAME" )
	type.insert( 0, "TYPE" )
	tier.insert( 0, "TIER" )

	for ( int i = 0 ; i < ref.len() ; i++ )
	{
		string _ref            = ref[i]
		string _pickupString   = pickupString[i]
		string _tier           = tier[i]
		string _type           = type[i]

		while( _ref.len() < refLen )
			_ref += " "
		while( _pickupString.len() < pickupStringLen )
			_pickupString += " "
		while( _tier.len() < tierLen )
			_tier += " "
		while( _type.len() < typeLen )
			_type += " "

		printl( format( "%s  %s  %s  %s", _pickupString, _ref, _tier, _type ) )
	}

	printt( "-------------- END LOOT --------------" )
}
#endif
