			highlight = GoldenHorse_UpdateLootHighlight( prop, ref, data.tier, highlight )
        

		if ( prop.e.eyeForQuality_isScanned && PlayerHasPassive( GetLocalViewPlayer(), ePassives.PAS_LOBA_EYE_FOR_QUALITY ) )
