void function SetPlayerInventory( entity player, array<ConsumableInventoryItem> playerInventory )
{
	//playerInventory.sort( SortByPriorityThenTier ) // SortByInventoryIndexAndCount )

	foreach ( index, item in playerInventory )
	{
		item.slot = index
	}

	player.p.cachedInventory = clone playerInventory

	thread _SetPlayerInventory( player )
}

void function _SetPlayerInventory( entity player )
{
	Signal( player, "_SetPlayerInventory" )
	EndSignal( player, "_SetPlayerInventory" )
	EndSignal( player, "OnDestroy" )

	WaitEndFrame()

	Assert( player.p.cachedInventory != null )

	if ( player.p.cachedInventory == null )
		return

	array<ConsumableInventoryItem> playerInventory = expect array<ConsumableInventoryItem>( player.p.cachedInventory )

	player.ConsumableInventory_Set( playerInventory )

	player.p.cachedInventory = null

	foreach ( func in file.inventoryChangeCallbacks )
		func( player, playerInventory )
}

