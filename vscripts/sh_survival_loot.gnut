#if SERVER
void function BroadcastItemPickup( entity player, string ref, int lootAction )
{
	if ( player.p.lastLootPickupTime >= Time() && player.p.lastLootPickupRef == ref )
		return

	entity altWeapon

	player.p.lastLootPickupTime = Time()
	player.p.lastLootPickupRef = ref

	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	foreach ( entity teamPlayer in GetPlayerArrayOfTeam( player.GetTeam() ) )
		Remote_CallFunction_Replay( teamPlayer, "ServerToClient_PickedupItem", player, data.index, lootAction )

	if ( data.lootType == eLootType.MAINWEAPON )
	{
		int newWeaponSlot0 = data.index
		player.SetPlayerNetInt( "playerPrimaryWeapon0", newWeaponSlot0 )

		array<entity> playerWeaponArray = SURVIVAL_GetPrimaryWeaponsSorted( player )

		for ( int i = 0; i < playerWeaponArray.len(); i++ )
		{
			if ( playerWeaponArray[i].GetWeaponClassName() != ref )
				altWeapon = playerWeaponArray[i]
		}

		if ( !IsValid( altWeapon ) )
		{
			if ( playerWeaponArray.len() > 1 )
			{
				if ( playerWeaponArray[0].GetWeaponClassName() == playerWeaponArray[1].GetWeaponClassName() )
					altWeapon = playerWeaponArray[0]
				else
					Assert( false, "Failed to identify secondary weapon for unitframe" )
			}
			else
			{
				player.SetPlayerNetInt( "playerPrimaryWeapon1", -1 )
			}
		}
		else
		{
			string weaponName = GetWeaponClassNameWithLockedSet( altWeapon )
			if ( SURVIVAL_Loot_IsRefValid( weaponName ) )
			{
				LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponName )
				player.SetPlayerNetInt( "playerPrimaryWeapon1", weaponData.index )
			}
			else
			{
				player.SetPlayerNetInt( "playerPrimaryWeapon1", -1 )
			}
		}
	}
}

void function BroadcastItemDrop( entity player, string ref, entity dropEnt, string weaponClassName = "" )
{
	player.p.lastDroppedLootEnt = dropEnt

	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	foreach ( entity teamPlayer in GetPlayerArrayOfTeam( player.GetTeam() ) )
		Remote_CallFunction_Replay( teamPlayer, "ServerCallback_DroppedItem", player, data.index )

	if ( data.lootType == eLootType.MAINWEAPON )
	{
		int oldIndex0 = player.GetPlayerNetInt( "playerPrimaryWeapon0" )
		int oldIndex1 = player.GetPlayerNetInt( "playerPrimaryWeapon1" )

		if ( data.index == oldIndex0 )
		{
			player.SetPlayerNetInt( "playerPrimaryWeapon0", oldIndex1 )
		}

		player.SetPlayerNetInt( "playerPrimaryWeapon1", -1 )
	}
	                        
		if ( GameMode_IsActive( eGameModes.CONTROL ) )
			Control_OnItemDropped( dropEnt )
                               

	if ( PlayerHasPassive( player, ePassives.PAS_AXIOM ) )
		PassiveAxiom_OnItemDropped( player, ref, dropEnt )

	                   
		if ( Perks_DoesPlayerHavePerk( player, ePerkIndex.WEAPON_INFUSION ) )
			Perk_WeaponInfusion_OnItemDropped( player, ref, weaponClassName, dropEnt )
       
                    
                                                      
   
                                              
   
       
	                      
		if ( ref.find( COPYCAT_NAME ) != -1 )
		{
			CopycatKit_LootDropped (player, "gadgetslot", ref, dropEnt)
		}
       
                 
                                              
       
	// Track the last owner on the auto pickup item to prevent it from being picked up again right away
	if ( SurvivalLoot_IsAutoPickupOrdnance( data ) )
		dropEnt.e.lastOwner = player
}

void function ClientCallback_PlayerSwitchedWeapons( entity player, int switchToSlot )
{
	int index0 = player.GetPlayerNetInt( "playerPrimaryWeapon0" )

	array<entity> playerWeaponArray = SURVIVAL_GetPrimaryWeaponsSorted( player )
	entity nextWeapon
	string nextWeaponName

	if ( switchToSlot < -1 || switchToSlot > 2 )
		return

	if ( switchToSlot == 0 )
	{
		nextWeapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
	}

	if ( switchToSlot == 1 )
	{
		nextWeapon = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
	}

	if ( IsValid( nextWeapon ) )
	{
		nextWeaponName = nextWeapon.GetWeaponClassName()
		if ( SURVIVAL_Loot_IsRefValid( nextWeaponName ) )
		{
			LootData nextWeaponData = SURVIVAL_Loot_GetLootDataByRef( nextWeaponName )
			if ( nextWeaponData.index != index0 )
			{
				player.SetPlayerNetInt( "playerPrimaryWeapon0", nextWeaponData.index )
				player.SetPlayerNetInt( "playerPrimaryWeapon1", index0 )
				return
			}
			else
			{
				return
			}
		}
	}

	string activeWeapon = SURVIVAL_GetActiveWeapon( player )
	string stowedWeapon = SURVIVAL_GetStowedWeapon( player )

	if ( SURVIVAL_Loot_IsRefValid( activeWeapon ) && SURVIVAL_Loot_IsRefValid( stowedWeapon ) )
	{
		LootData activeData = SURVIVAL_Loot_GetLootDataByRef( activeWeapon )
		LootData stowedData = SURVIVAL_Loot_GetLootDataByRef( stowedWeapon )

		player.SetPlayerNetInt( "playerPrimaryWeapon0", stowedData.index )
		player.SetPlayerNetInt( "playerPrimaryWeapon1", activeData.index )
	}
}
#elseif CLIENT	// #if SERVER

void function ServerToClient_PickedupItem( entity player, int idx, int lootAction )
{
	if ( !IsValid( player ) )
		return

	LootData data   = SURVIVAL_Loot_GetLootDataByIndex( idx )
	string itemName = Localize( data.pickupString )

	bool isLocalPlayer = (player == GetLocalViewPlayer())
	if ( data.printPickupToObituary || GetCurrentPlaylistVarBool( "log_pickup_to_obituary", false ) )
	{
		if ( isLocalPlayer )
			Obituary_Print_Localized( Localize( "#SURVIVAL_PICKED_UP_YOU", itemName, data.hudIcon ), GetChatTitleColorForPlayer( player ), BURN_COLOR )
		else
			Obituary_Print_Localized( Localize( "#SURVIVAL_PICKED_UP_OTHER", player.GetPlayerName(), itemName, data.hudIcon ), GetChatTitleColorForPlayer( player ), BURN_COLOR )
	}

	if ( isLocalPlayer )
	{
		foreach ( func in file.localPlayerPickedupLootCallbacks )
			func( player, data, lootAction )

		// this usually gets signaled from ClientCodeCallback_OnShieldHealthChanged, but if we just switch tier that doesn't happen since the health might be the same.
		if ( data.lootType == eLootType.ARMOR )
			player.Signal( "ShieldChanged" )
	}

	//if ( isLocalPlayer )
	//	AddGenericQueueMessage( Localize( "#SURVIVAL_LOG_PICKUP", itemName, data.hudIcon ) )

	ResetInventoryMenu( GetLocalViewPlayer() )
}

void function AddCallback_LocalPlayerPickedUpLoot( void functionref( entity, LootData, int ) func )
{
	file.localPlayerPickedupLootCallbacks.append( func )
}

