#if SERVER
int function SetPropSurvivalMainProperty( int prop, int val )
{
	Assert( val >= 0 && val < (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_MAIN_PROPERTY_BITS) )
	int offset     = 0
	int enoughBits = (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_MAIN_PROPERTY_BITS) - 1
	int mask       = enoughBits << offset
	return (prop & ~mask) | (val << offset)
}
#endif


#if SERVER
int function SetPropSurvivalExtraProperty( int prop, int value )
{
	int val = value
	Assert( val >= 0 && val < (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_PROPERTY_BITS) )
	int offset     = PROP_SURVIVAL_SURVIVAL_PROPERTY_MAIN_PROPERTY_BITS
	int enoughBits = (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_PROPERTY_BITS) - 1
	int mask       = enoughBits << offset
	return (prop & ~mask) | (val << offset)
}
#endif


#if SERVER
int function SetPropSurvivalFlagsProperty( int prop, int val )
{
	Assert( val >= 0 && val < (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_FLAGS_PROPERTY_BITS) )
	int offset     = PROP_SURVIVAL_SURVIVAL_PROPERTY_MAIN_PROPERTY_BITS + PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_PROPERTY_BITS
	int enoughBits = (1 << PROP_SURVIVAL_SURVIVAL_PROPERTY_FLAGS_PROPERTY_BITS) - 1
	int mask       = enoughBits << offset
	return (prop & ~mask) | (val << offset)
}
#endif


#if SERVER
void function SetPropSurvivalMainPropertyOnEnt( entity ent, int val )
{
	ent.SetSurvivalProperty( SetPropSurvivalMainProperty( ent.GetSurvivalProperty(), val ) )
}
#endif


#if SERVER
void function SetPropSurvivalExtraPropertyOnEnt( entity ent, int value )
{
	int val = value

	LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )
	if ( data.lootType == eLootType.ARMOR )
	{
		if ( EvolvingArmor_IsEquipmentEvolvingArmor( data.ref ) )
		{
			if ( EvolvingArmor_ExceedsMaxIntLimit( data ) )
			{
				Assert( false, "Max armor level exceeded the max bit field value of 1024. Consider increasing PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_PROPERTY_BITS by 1 and multiply PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_MAX_VALUE by 2" )
				val = minint( value / 2, PROP_SURVIVAL_SURVIVAL_PROPERTY_EXTRA_MAX_VALUE )
			}
		}
	}

                    
                                            
  
                                     
   
                                                                                                                 
    
                   
    
   
  
       

	ent.SetSurvivalProperty( SetPropSurvivalExtraProperty( ent.GetSurvivalProperty(), val ) )
}
#endif


