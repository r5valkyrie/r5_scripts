{
	RegisterStatEnumStructs()

	CAREER_STATS.account_level = RegisterExpensiveCalculatedStat_Int( null, "account_level", BADGES_UNLOCK_NEED, SetupGetAccountLevelForStat, [], eChallengeGameMode.NON_MODE )
