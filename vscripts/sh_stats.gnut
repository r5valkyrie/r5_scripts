#if SERVER
void function StatsHook_LobbyStart()
{
	Assert( IsLobby() )
	PIN_GameStart()
}

void function OnGameState_WaitingForPlayers()
{
	Assert( !IsLobby() )
	PIN_GameStart()
}

void function StatsHook_SetPlaneData( vector startPos, vector endPos, float duration )
{
	PIN_PlanePath( startPos, endPos, duration )
}

void function OnGameState_Playing()
{
	PIN_SetGameStartTime()
	foreach ( entity player in GetPlayerArray() )
	{
		PIN_GameStartedForPlayer( player )
		if ( player.IsNPC() )
			fileLevel.matchHasBots = true
	}
}

bool function StatsHook_MatchHasBots()
{
	return fileLevel.matchHasBots
}

void function StatsHook_SetDeathCircle( vector origin, float radius, string pinAction )
{
	PIN_CircleLocation( "death_circle", origin, radius, pinAction )
}

void function StatsHook_SetSafeZone( vector origin, float radius )
{
	PIN_CircleLocation( "safe_circle", origin, radius, "end_circle_close" )
}

void function OnGameState_Postmatch()
{
	//
}

// TODO - R5DEV-413763: this should use one of the internal checks rather than cases
void function StatsHook_RecordPlacementStats( entity player )
{
	Assert( !player.p.placementStatsRecorded || player.p.DEV_hasDevRespawned )
	player.p.placementStatsRecorded = true

	bool isNewPlayerWhoHasNotGraduated = false
	                            
		isNewPlayerWhoHasNotGraduated = NewPlayerBotQueue_IsNewPlayerWhoHasNotGraduated( player )
       

                          
                                                                                           
                                                                                                           
   
                                                                   
   
                                

	if ( !Stats_PlayerIsValidForStats( player ) && !isNewPlayerWhoHasNotGraduated )
		return

	bool skipNormalPlacementStats = false
	bool skipNonPlacementStats    = false
                  
                                                                            
                                  
       

	                      
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
		{
			skipNormalPlacementStats = true
			skipNonPlacementStats    = true
		}
       

	                              
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
		{
			skipNormalPlacementStats = true
			skipNonPlacementStats    = true
		}
       

	                        
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_EXPLORE ) )
		{
			skipNormalPlacementStats = true
			skipNonPlacementStats    = true
		}
       

	if ( IsSpawnOnSquadMode() )
	{
		skipNormalPlacementStats = true
		skipNonPlacementStats    = true
	}
	if ( IsPVEMode() )
	{
		skipNormalPlacementStats = true
		skipNonPlacementStats    = true
	}

	                          
		if ( IsPrivateMatch() )
		{
			skipNormalPlacementStats = true
			skipNonPlacementStats    = true
		}
       

	skipNormalPlacementStats = skipNormalPlacementStats || Stats_CurrentModeSupportsCustomStats()

              
                                                                  
       

	int rank = Survival_GetCurrentRank( player )
	Assert( rank > 0 )
	GameSummarySquadData gameSummaryData                   = GameSummary_GetPlayerData( player )
	table<int, GameSummarySquadData> playerTeamData = {}
	// GameSummary_GetTeamDataOrNull returns var; stub always returns null
	table<int, GameSummarySquadData> ornull playerTeamDataOrNull = GameSummary_GetTeamDataOrNull( player.GetTeam() )

	ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	string characterRef  = ItemFlavor_GetGUIDString( character )

	// these must be ticked for new players - do NOT wrap in a blocking if check
	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.games_played_any_mode ), 1 )
	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_games_played_any_mode, characterRef ), 1 )

                          
                                        
   
                                                                          
                                
    
                                                                      

                                                       
     
                                                                        
     
        
     
                          
      
                                          
                                                                          
            

                                          
                                                                          
            

                                          
                                                                        
            
      
     
    
                                                                                  
       
    
                                                                     
    
   
                                

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()

	                    
		StatsHook_S21EXP_GamePlayedAnyMode( player, characterRef )
       

	                            
		if ( IsOrientationMatch() )
		{
			StatHook_NewPlayerBotQueue_OnRecordPlacementStats( player )
			return
		}
       

	if ( !skipNormalPlacementStats )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.games_played ), 1 )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_games_played, characterRef ), 1 )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.survival_time_seconds ), gameSummaryData.survivalTime )

               
                       
                                                                                                   
        

		                               
			StatsHook_S21_Solo_Games_Played( player, 1 )
        

		                               
			StatsHook_S21_Quad_GamesPlayed( player, 1 )
        
	}

	                   
	if ( !skipNormalPlacementStats || Stats_CurrentModeSupportsCustomStats() )
	{
		int role = CharacterClass_GetRole( character )
		switch( role )
		{
			case eCharacterClassRole.OFFENSE:
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.assault_games_played ), 1 )
				break
			case eCharacterClassRole.SKIRMISHER:
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.skirmisher_games_played ), 1 )
				break
			case eCharacterClassRole.DEFENSE:
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.controller_games_played ), 1 )
				break
			case eCharacterClassRole.RECON:
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.recon_games_played ), 1 )
				break
			case eCharacterClassRole.SUPPORT:
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.support_games_played ), 1 )
				break
		}
	}
       


	//Modes Lifetime Stats
	string modeRef = GetCurrentPlaylistVarString( "stats_match_type", "survival" )
	if ( Stats_CurrentModeSupportsCustomStats() )
	{
		                       
			StatsHook_S21_BigTDM_GamesPlayed( player, 1 )
        
		
		__Mode_IncrementStat_Int( player, CAREER_STATS.modes_games_played, 1 )
		__Mode_IncrementStat_Int( player, CAREER_STATS.modes_character_games_played, characterRef, 1 )

		int oldMaxModeKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_kills_max_single_game, modeRef ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.kills > oldMaxModeKills )
			__Mode_SetStat_Int( player, CAREER_STATS.modes_kills_max_single_game, gameSummaryData.kills )

		int oldMaxModeDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_damage_done_max_single_game, modeRef ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.damageDealt > oldMaxModeDamage )
			__Mode_SetStat_Int( player, CAREER_STATS.modes_damage_done_max_single_game, gameSummaryData.damageDealt )
	}

                               
                                                                                                          
	     
	if ( !skipNormalPlacementStats )
       
	{
		                               
		StatsHook_S21_Quad_DamageDoneMaxSingleGame( player, gameSummaryData.damageDealt )
                                       

		if ( gameSummaryData.kills >= 5 )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_games_with_5_kills, characterRef ), 1 )

		// wake (>=20 kills in one game) & wrath (2k, 2.5k, 3.5k, 4k damage in one game) badges; requires prestige badges flag
		if ( PrestigeBadgeIsAllowed() )
		{
			// wake
			if ( gameSummaryData.kills >= 20 )
			{
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_games_with_20_kills, characterRef ), 1 )
			}

			// wrath
			int oldMaxDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_damage_done_max_single_game, characterRef ), eStatGetWhen.CURRENT )
			if ( gameSummaryData.damageDealt > oldMaxDamage )
			{
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_damage_done_max_single_game, characterRef ), gameSummaryData.damageDealt - oldMaxDamage )
			}
		}

		int oldMaxKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.kills_max_single_game ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.kills > oldMaxKills )
		{
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.kills_max_single_game ), gameSummaryData.kills - oldMaxKills )}
		}

	if ( !skipNormalPlacementStats && currentSeasonRefOrNull != null )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_games_played, expect string( currentSeasonRefOrNull ) ), 1 )

		int oldSeasonalMaxDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_character_damage_done_max_single_game, expect string( currentSeasonRefOrNull ), characterRef ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.damageDealt > oldSeasonalMaxDamage )
			__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_character_damage_done_max_single_game, expect string( currentSeasonRefOrNull ), characterRef ), gameSummaryData.damageDealt )

		int oldMaxSeasonKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_kills_max_single_game, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.kills > oldMaxSeasonKills )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_kills_max_single_game, expect string( currentSeasonRefOrNull ) ), gameSummaryData.kills - oldMaxSeasonKills )
	}

	//Modes Season Stats
	if ( Stats_CurrentModeSupportsCustomStats() && currentSeasonRefOrNull != null )
	{
		__Mode_IncrementStat_Int( player, CAREER_STATS.modes_season_games_played, expect string(currentSeasonRefOrNull), 1 )

		int oldSeasonalMaxDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_season_damage_done_max_single_game, modeRef, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.damageDealt > oldSeasonalMaxDamage )
			__Mode_SetStat_Int( player, CAREER_STATS.modes_season_damage_done_max_single_game, expect string( currentSeasonRefOrNull ), gameSummaryData.damageDealt )

		int oldMaxSeasonKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_season_kills_max_single_game, modeRef, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.kills > oldMaxSeasonKills )
			__Mode_SetStat_Int( player, CAREER_STATS.modes_season_kills_max_single_game, expect string( currentSeasonRefOrNull ), gameSummaryData.kills )
	}

	string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )

	if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_games_played_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )

		int oldRankedMaxDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_character_damage_done_max_single_game_base, expect string( currentRankedPeriodRefOrNull ), characterRef ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.damageDealt > oldRankedMaxDamage )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_character_damage_done_max_single_game_base, expect string( currentRankedPeriodRefOrNull ), characterRef ), gameSummaryData.damageDealt - oldRankedMaxDamage )

		int oldMaxRankedKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_kills_max_single_game_base, expect string( currentRankedPeriodRefOrNull ) ), eStatGetWhen.CURRENT )
		if ( gameSummaryData.kills > oldMaxRankedKills )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_kills_max_single_game_base, expect string( currentRankedPeriodRefOrNull ) ), gameSummaryData.kills - oldMaxRankedKills )

		//if ( fullClubSquad )
		//	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_clubs_games_played_with_club, expect string( currentRankedPeriodRefOrNull ) ), 1 )
	}

                        
                                                                                                   
                                                                                                                                         

                                                                           
   
                                                                                                                                                           
                                                                                                                                                                        

                                                                                                                                                                                                                    
                                                                
                                                                                                                                                                                               

                                                                                                                                                                                                             
                                                         
                                                                                                                                                                                    
   
       


	int currentWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_current ), eStatGetWhen.CURRENT )

	bool fullPremadeSquad = player.GetPartySize() == 3

	if ( fullPremadeSquad && !skipNonPlacementStats && modeRef == "survival" )
	{
		int oldTeamWorkKillCount = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.team_work_kill_count ), eStatGetWhen.CURRENT )

		int index        = 0
		int newKillCount = 0
		foreach ( summaryData in playerTeamData )
		{
			index++
			if ( summaryData.kills <= oldTeamWorkKillCount || summaryData.kills == 0 )
				break

			newKillCount = newKillCount > 0 ? minint( newKillCount, summaryData.kills ) : summaryData.kills

			if ( index < 3 )
				continue

			__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.team_work_kill_count ), newKillCount )

		}
	}

	if ( GetGameState() >= eGameState.WinnerDetermined )
	{
		int winningTeam = GetWinningTeam()
		table<int, GameSummarySquadData> winnerTeamData = {}
		table<int, GameSummarySquadData> ornull winnerTeamDataOrNull = GameSummary_GetTeamDataOrNull( winningTeam )

		// if a player quits while we're in the WinnerDetermined state for a round-based game, we'll end up in here.
		// BEGIN MATCH OVER CHECK -- move me to my own dedicated helper function IF complexity increases beyond this.
		bool isMatchActuallyOver = false
		if ( IsRoundBased() )
			isMatchActuallyOver = IsRoundBasedGameOver()
		else
			isMatchActuallyOver = GetGameState() >= eGameState.WinnerDetermined
		// END MATCH OVER CHECK

		// BEGIN WON MATCH BLOCK
		if ( player.GetTeam() == winningTeam && isMatchActuallyOver ) // it's probably obvious, but this means the player won. So everything inside of this is related to a win
		{
			if ( rank == 1 && Stats_CurrentModeSupportsCustomStats() )
			{
				__Mode_IncrementStat_Int( player, CAREER_STATS.modes_placements_win, 1 )
                           
                                                  
                                                                                               
          

				__Mode_IncrementStat_Int( player, CAREER_STATS.modes_win_streak_current, 1 )
				int currentModeWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_win_streak_current, modeRef ), eStatGetWhen.CURRENT )
				int longestWinStreak     = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_win_streak_longest, modeRef ), eStatGetWhen.CURRENT )
				if ( currentModeWinStreak > longestWinStreak )
					__Mode_SetStat_Int( player, CAREER_STATS.modes_win_streak_longest, currentModeWinStreak )

				if ( currentSeasonRefOrNull != null )
				{
					__Mode_IncrementStat_Int( player, CAREER_STATS.modes_season_placements_win, expect string( currentSeasonRefOrNull ), 1 )

					__Mode_IncrementStat_Int( player, CAREER_STATS.modes_season_win_streak_current, expect string( currentSeasonRefOrNull ), 1 )
					int currentModeSeasonWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_season_win_streak_current, modeRef, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
					int longestModeSeasonWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.modes_season_win_streak_longest, modeRef, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
					if ( currentModeSeasonWinStreak > longestModeSeasonWinStreak )
						__Mode_SetStat_Int( player, CAREER_STATS.modes_season_win_streak_longest, expect string( currentSeasonRefOrNull ), currentModeSeasonWinStreak )
				}

				__Mode_IncrementStat_Int( player, CAREER_STATS.modes_character_placements_win, characterRef, 1 )
			}


			if( rank == 1 )
			{
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.wins_any_mode ), 1 )
				AutogenChallenge_TriggerScriptHooksForId( eAutogenStatHooks.ON_PLAYER_WIN, player )

				                               
					StatsHook_S21_Solo_Games_Wins( player )
          

				                               
					StatsHook_S21_Quad_PremadeWin( player )
          
			}


                          
                                                 
     
                     
      
                      
       
                                                                                                                               
                                                                                                                                                           
                                                                                                                                                                 
                                           
                                                                                                                                                            
       

                                                                                  
       
                                                                                                   
       

                                                                   
                                                                     
       
                                                                                                  
       

                            
                                                                                                  
                                                                                                          

                                                                     

              
                           
                                                                                                                       
        
                                                                                                                                                                

                                                                                                                                                                        
                                                                                                                                                                                                                     
                                                                                                                                                                                                                     
                                                                        
                                                                                                                                                                                             
        
            
      

     
         

			if ( rank == 1 && !skipNormalPlacementStats )
			{
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win ), 1 )
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win, characterRef ), 1 )
				UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.master_of_all ) )

				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_current ), 1 )
				currentWinStreak     = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_current ), eStatGetWhen.CURRENT )
				int longestWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_longest ), eStatGetWhen.CURRENT )
				if ( currentWinStreak > longestWinStreak )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_longest ), currentWinStreak - longestWinStreak )

				// this is super redundant, but it's because we added this badge in S10 and didn't want to give it away to everyone. So we needed redundant stats.
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_account_badge_current ), 1 )
				int currentBadgeWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_account_badge_current ), eStatGetWhen.CURRENT )
				int longestBadgeWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_account_badge_longest ), eStatGetWhen.CURRENT )
				if ( currentBadgeWinStreak > longestBadgeWinStreak )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_account_badge_longest ), currentBadgeWinStreak - longestBadgeWinStreak )

				if ( currentSeasonRefOrNull != null )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_placements_win, expect string( currentSeasonRefOrNull ) ), 1 )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_character_placements_win, expect string(currentSeasonRefOrNull), characterRef ), 1 )

					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_win_streak_current, expect string( currentSeasonRefOrNull ) ), 1 )
					int currentSeasonWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_win_streak_current, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
					int longestSeasonWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_win_streak_longest, expect string( currentSeasonRefOrNull ) ), eStatGetWhen.CURRENT )
					if ( currentSeasonWinStreak > longestSeasonWinStreak )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_win_streak_longest, expect string( currentSeasonRefOrNull ) ), currentSeasonWinStreak - longestSeasonWinStreak )
				}

				if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_placements_win_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )

					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_current, expect string( currentRankedPeriodRefOrNull ) ), 1 )
					int currentRankedWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_current, expect string( currentRankedPeriodRefOrNull ) ), eStatGetWhen.CURRENT )
					int longestRankedWinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_longest, expect string( currentRankedPeriodRefOrNull ) ), eStatGetWhen.CURRENT )
					if ( currentRankedWinStreak > longestRankedWinStreak )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_longest_base, expect string( currentRankedPeriodRefOrNull ) ), currentRankedWinStreak - longestRankedWinStreak )
				}

                 
                         
      
                                                                                                       

                                                                                        
                                                                                                                                                                      
      
          

				int count = 0
				foreach ( legendRef in GetAllCharacterGUIDStringsForStats() )
				{
					if ( GetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win, legendRef ) ) > 0 )
						count++
				}
				if ( count >= 8 )
					UnlockAchievement( player, achievements.APEX_LEGEND )

				bool anyDead        = false
				int teamKillCount   = 0
				bool noWitnessess   = true
				bool groupTheatrics = true
				int teamDeathCount  = 0
				int teamDownedCount = 0
				foreach ( int winnerTeamIndex, GameSummarySquadData winnerData in winnerTeamData )
				{
					entity winner = GetEntityFromEncodedEHandle( winnerData.eHandle )
					if ( !IsValid( winner ) || !IsAlive( winner ) )
						anyDead = true
					EHIScriptStruct ehiss = GetEHIScriptStructFromEncodedEHandle( winnerData.eHandle )

					teamKillCount += winnerData.kills
					noWitnessess = noWitnessess && ehiss.noWitnessess
					groupTheatrics = groupTheatrics && (ehiss.gaveFinisherCount > 0)
					teamDeathCount += winnerData.deaths
					teamDownedCount += ehiss.gotDownedCount
				}

				noWitnessess = noWitnessess && (teamKillCount >= 15)

				if ( teamDeathCount == 0 && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_flawless_1, characterRef ), 1 )
					if ( teamDownedCount == 0 )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_flawless_2, characterRef ), 1 )

                  
                          
       
                                                                                                                  
                                  
                                                                                                                                
       
           
				}

				if ( player.p.headshotKills >= 5 )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_with_5_headshots, characterRef ), 1 )

				if ( winnerTeamData.len() == GetExpectedSquadSize( player ) && !anyDead && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win_with_squad_alive ), 1 )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_with_squad_alive, characterRef ), 1 )

                  
                          
                                                                                                                    
            
				}

				if ( fullPremadeSquad )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win_with_friends ), 1 )
					if ( noWitnessess )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win_with_no_witnessess ), 1 )
					if ( groupTheatrics )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win_with_min_executions_per_person ), 1 )
				}

				if ( GetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_won_last_game, characterRef ) ) == 1 )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_hot_streaks, characterRef ), 1 )
				__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_won_last_game, characterRef ), 1 )

				if ( player.GetEncodedEHandle() == SurvivalCommentary_GetKillLeaderEEH() )
				{
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_as_killleader, characterRef ), 1 )
					if ( player.GetTeam() == SurvivalCommentary_GetChampionTeam() )
						__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_as_killleader_and_champion, characterRef ), 1 )
				}

				if ( player.p.wasJumpmaster && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
					__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_as_jumpmaster, characterRef ), 1 )
			}

			if ( player == fileLevel.mostRecentDoomAttacker && !skipNonPlacementStats )
			{
				// this player got the winning "kill"

				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.winning_kills ), 1 )
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_winning_kills, characterRef ), 1 )
			}
		}
		//END WON MATCH BLOCK
	}

	/* TODO - R5DEV-413763: if a player leaves a ROUND-BASED match after winning a round - while still in the "round won" state, they will be rank == 1,
	   this means that win streaks, for example, will not reset if you quit in this window. This IS EXPLOITABLE
	   Ideally, we should fix this so it checks 1) if the match isn't actually over and 2) IF A PENALTY is active (this system needs work too...)
	   to evaluate if your streak should be preserved or not.
	*/

	// now is where we do stuff for everything other than a win
	if ( rank > 1 && !skipNormalPlacementStats )
	{
		__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_won_last_game, characterRef ), 0 )

		__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_current ), 0 )
		__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.win_streak_account_badge_current ), 0 )
		if ( currentSeasonRefOrNull != null )
			__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.season_win_streak_current, expect string( currentSeasonRefOrNull ) ), 0 )
		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
			__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_current, expect string( currentRankedPeriodRefOrNull ) ), 0 )
	}

	if ( rank > 1 && Stats_CurrentModeSupportsCustomStats() )
	{
		__Mode_SetStat_Int( player, CAREER_STATS.modes_win_streak_current, 0 )

		if ( currentSeasonRefOrNull != null )
			__Mode_SetStat_Int( player, CAREER_STATS.modes_season_win_streak_current, expect string( currentSeasonRefOrNull ), 0 )
	}

                       
                                              
  
                                                                                    
                                                                      
                 
   
                                                                                                                      

                        
                                                                                                                     
                                                                                                                                                               
         
   

                                                                                                                                                             
                                                   
                                                                                                                                                    

                                                                                                                                                   
                                         
                                                                                                                                        
  
      

	if ( rank <= 3 && !skipNormalPlacementStats )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_top_3 ), 1 )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_top_3, characterRef ), 1 )

		// BattlePass Specific
		if ( ( gameSummaryData.kills + gameSummaryData.knockdowns + gameSummaryData.assists ) >= 3 )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.top_3_with_3_kill_ko_assist ), 1 )
	}

	if ( rank <= 5 && !skipNormalPlacementStats )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_top_5 ), 1 )
		if ( currentSeasonRefOrNull != null )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.season_character_placements_top_5, expect string(currentSeasonRefOrNull), characterRef ), 1 )

		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
		{
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_placements_top_5_base, expect string(currentRankedPeriodRefOrNull) ), 1 )
		}

		                               
			StatsHook_S21_Quad_PlacementTop5With10Legends( player, characterRef )
			StatsHook_S21_Quad_PlacementTop5( player )
        
	}

	if ( rank <= 10 && !skipNormalPlacementStats )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_top_10 ), 1 )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.br_top_10_or_arena_win ), 1 )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_top_10, characterRef ), 1 )

		                               
			StatsHook_S21_Solo_Placement_Top_10_with_10_Legends( player, characterRef )
        

		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
		{
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_placements_top_10_base, expect string(currentRankedPeriodRefOrNull) ), 1 )
		}

		                            
			StatsHook_NewPlayerBotQueue_RecordTop10Placement( player )
                                    
	}

	if ( !skipNormalPlacementStats )
	{
		int playersOutlived = MAX_PLAYERS - GetGlobalNetInt( "livingPlayerCount" )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.opponents_outlived ), playersOutlived )

		int oldMaxSquadWipes = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_most_squad_squad_kills_in_1_game, characterRef ), eStatGetWhen.CURRENT )
		if ( player.p.squadWipes > oldMaxSquadWipes )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_most_squad_squad_kills_in_1_game, characterRef ), player.p.squadWipes - oldMaxSquadWipes )
	}

	// PUT CALCULATED STAT UPDATE CALLS THAT ONLY NEED TO HAPPEN AT MATCH END HERE FOR NOW
	if ( modeRef == "survival" ) // TODO - R5DEV-413763: if we make this a loop, we could check enum for modeType against mode. But it's just this one check for now...
		UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.well_rounded ) )

	GladiatorCardBadge_CheckAndAwardBadges( player )

	if( !player.IsNPC() )
	{
		Boost_ApplyBoostEnabledChallengeBoost( player )
		Mythics_UnregisterBoostedMythicChallengesForPlayer( player )
	}
}

void function StatsHook_TransferWinStreak( entity player, string split1GUIDString, string split2GUIDString )
{
	//handle win streak stats for ranked 2.0 split
	int split1WinStreak = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_current, split1GUIDString ) )
	if ( split1WinStreak > 0 )
		__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_win_streak_current, split2GUIDString ), split1WinStreak )
}

void function StatsHook_RecordRankScoreStats( entity player, int newScore )
{
	string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )

	if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( player ) )
	{
		int oldScore = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_current_rank_score, expect string( currentRankedPeriodRefOrNull ) ) )
		__SetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_current_rank_score, expect string( currentRankedPeriodRefOrNull ) ), newScore )

		if ( newScore > oldScore )
		{
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_gained_rank_score_only, expect string( currentRankedPeriodRefOrNull ) ), newScore - oldScore )
		}
	}
}

                                            
                                                                                 
 
                                                                                                                                        

                                                                                                                 
  
                                                                                                                                                                    
                                                                                                                                                                 

                            
   
                                                                                                                                                                                       
   
  
 
      

void function UpdatePlayerMatchCodeStats( entity player )
{
	if ( IsLobby() )
		return

	int level = GetPlayerAccountLevel( player )
	player.TrackPlayerLevel( level )

	if ( ShouldRecordRankedStats( player ) )
	{
		ItemFlavor ornull rankedPeriod = Ranked_GetCurrentActiveRankedPeriod()
		if ( rankedPeriod != null )
			player.TrackRankScore( Ranked_GetStryderLadderNameForLatestRankedPeriod(), GetPlayerRankScore( player ) )
	}

	int jumpmasterWins = 0
	foreach ( legendRef in GetAllCharacterGUIDStringsForStats() )
	{
		jumpmasterWins += GetStat_Int( player, ResolveStatEntry( CAREER_STATS.character_placements_win_as_jumpmaster, legendRef ) )
	}
	int matches           = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.games_played ) )
	int jumpmasterMatches = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.times_jumpmaster_post_fix ) )
	int wins              = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win ), eStatGetWhen.CURRENT )
	int winsWithFriends   = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.placements_win_with_friends ) )
	player.TrackPlayerMatches( matches, wins, winsWithFriends, jumpmasterMatches, jumpmasterWins )

	int shotsFired = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.shots ) )
	int shotsHit   = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.hits ) )
	player.TrackPlayerShots( shotsFired, shotsHit )

	int totalKills         = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.kills ) )
	int totalTeamworkKills = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.team_work_kill_count ) )
	player.TrackPlayerKills( totalKills, totalTeamworkKills )

	int damageDone  = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.damage_done ) )
	int damageTaken = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.damage_taken ) )
	player.TrackPlayerDamage( damageDone, damageTaken )

	int allyRevives = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.revived_ally ) )
	player.TrackPlayerAllyRevives( allyRevives )
}

void function StatsHook_SquadEliminated( array<entity> connectedSquadMembers )
{
	if ( connectedSquadMembers.len() == 0 )
		return

	const int MIN_MEMBERS_FOR_SQUADWIPE = 3
	int maxTeamSize = GetMaxTeamSizeForPlaylist( GetCurrentPlaylistName() )
	if ( maxTeamSize < MIN_MEMBERS_FOR_SQUADWIPE )
		return

	bool squadWipe      = true
	entity lastAttacker = connectedSquadMembers[0].p.doomedAttacker
	if ( !IsValid( lastAttacker ) ) //Squads can die by jumping off cliffs.
		return

	if ( !( connectedSquadMembers[0].GetTeam() in lastAttacker.p.doomedEnemies ) )
		return

	if ( lastAttacker.p.doomedEnemies[connectedSquadMembers[0].GetTeam()].len() == maxTeamSize )
		lastAttacker.p.squadWipes++
}

