// TODO - R5DEV-413763
void function StatsHook_UpdateCachedStatsThatDependOnGRX( entity player )
{
	if ( player.IsNPC() )
		return

	if ( player.p.isDisconnected )
		return

	StatsHook_UpdateCachedBattlePassLevelStats( player )

	// TODO - R5DEV-413763: refactor me to just be variable counter stats and then adjust them based on actual GRX operations rather than doing this calculation
	UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.total_legendary_items ) )
	UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.fashionista ) )
	UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.weapons_with_legendary_skin ) )
}

void function StatsHook_UpdateCachedBattlePassLevelStats( entity player )
{
	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()
	if ( currentSeasonRefOrNull != null )
	{
		string currentSeasonRef = expect string(currentSeasonRefOrNull)
		UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.season_battlepass_level, currentSeasonRef ) ) // this is the only thing we need, but can be refactored to be an incrementing counter
	}
}

// TODO - R5DEV-413763: delete the similarly named function above and replace with this one ONLY once we are confident in functionality
void function StatsHook_UpdateCachedStatsThatDependOnGRXThreaded( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	if ( player.IsNPC() )
		return

	StatsHook_UpdateCachedBattlePassLevelStats( player )

	wait 0.1

	// the next two depend on this having run first so make sure it runs
	if ( GetCurrentPlaylistVarBool( "has_grx_badge_stats_opts", true ) )
		waitthread UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.total_legendary_items ) ) // baller
	else
		thread UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.total_legendary_items ) ) // baller

	wait 0.1

	thread UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.fashionista ) ) // fashionista

	wait 0.1

	thread UpdateCalculatedStatCachedValue( player, ResolveStatEntry( CAREER_STATS.weapons_with_legendary_skin ) ) // warlord
}
// TODO - R5DEV-413763: REFACTOR BLOCK END

