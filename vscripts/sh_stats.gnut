	if ( !Stats_ShouldGatherBRStatsInModeForPlayer( attacker ) )
		return

                  
                                                                             
         
       
}

void function StatsHook_UnlockJumpmasterAchievement( entity player )
{
	if ( !Stats_PlayerIsValidForStats( player ) )
		return

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.times_jumpmaster ), 1 )
	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.times_jumpmaster_post_fix ), 1 )
	int timesJumpmaster = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.times_jumpmaster ), eStatGetWhen.CURRENT )
	if ( timesJumpmaster >= 5 )
		UnlockAchievement( player, achievements.JUMPMASTER )
}



void function RemoveInvalidRapidElimKills( entity killer )
{
	for ( int i = killer.p.rapidElimTracker.len() - 1; i >= 0; i-- )
	{
		if ( Time() - killer.p.rapidElimTracker[ i ] > 20.0 )
			killer.p.rapidElimTracker.remove( i )
	}
}

void function ClearRapidElimKills( entity killer )
{
	for ( int i = killer.p.rapidElimTracker.len() - 1; i >= 0; i-- )
	{
		killer.p.rapidElimTracker.remove( i )
	}
}

void function OnNPCKilled( entity victim, entity attacker, var damageInfo )
{
	// todo(dw): do this section
}


void function StatsHook_PlayerRespawnedTeammate( entity respawnCaller, entity respawningPlayer )
{
	if ( !Stats_PlayerIsValidForStats( respawnCaller ) )
		return

	__IncrementStat_Int( respawnCaller, ResolveStatEntry( CAREER_STATS.times_respawned_ally ), 1 )

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()
	if ( currentSeasonRefOrNull != null )
		__IncrementStat_Int( respawnCaller, ResolveStatEntry( CAREER_STATS.season_times_respawned_ally, expect string( currentSeasonRefOrNull ) ), 1 )

	string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
	if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( respawnCaller ) )
		__IncrementStat_Int( respawnCaller, ResolveStatEntry( CAREER_STATS.rankedperiod_times_respawned_ally_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )

	if ( GetCurrentPlaylistVarInt( "valentines_event", 0 ) > 0 )
		__IncrementStat_Int( respawnCaller, ResolveStatEntry( CAREER_STATS.valentines_revives_and_respawns ), 1 )

	if ( respawnCaller.p.playersRespawned.find( respawningPlayer ) == -1 )
	{
		respawnCaller.p.playersRespawned.append( respawningPlayer )
		if ( respawnCaller.p.playersRespawned.len() == 2 )
		{
			ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( respawnCaller ), Loadout_Character() )
			string characterRef  = ItemFlavor_GetGUIDString( character )
			__IncrementStat_Int( respawnCaller, ResolveStatEntry( CAREER_STATS.character_games_with_respawning_both_teammates, characterRef ), 1 )
		}
	}

	respawningPlayer.p.lastRespawnTime = Time()

	if ( IsValid( respawningPlayer.p.doomedAttacker ) )
	{
		GetEHIScriptStruct( respawningPlayer.p.doomedAttacker ).noWitnessess = false
		if (respawningPlayer.GetTeam() in respawningPlayer.p.doomedAttacker.p.doomedEnemies)
		{
			table< int, array<entity> > attackersDoomedEnemies = respawningPlayer.p.doomedAttacker.p.doomedEnemies
			attackersDoomedEnemies[respawningPlayer.GetTeam()].removebyvalue(respawningPlayer)
		}

		respawningPlayer.p.doomedAttacker = null
	}
}
#endif //SERVER







////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Weapon-fire and damage player events ////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
#if SERVER

void function StatsHook_PrivateMatch_IncrementShots( entity player )
{
	Assert( IsValid( player ) )
	Assert( player.IsPlayer() )

	if ( !Stats_IsValidMapForStats() )
		return
	if ( GameMode_IsActive( eGameModes.SURVIVAL ) && !Survival_HasPlayerJumpedOutOfPlane( player ) )
		return

	GameSummarySquadData gameSummaryData = GameSummary_GetPlayerData( player )
	gameSummaryData.shots++
}

void function OnWeaponAttack( entity player, entity weapon, string weaponName, int ammoUsed, vector attackOrigin, vector attackDir )
{
	Assert( IsValid( player ) )
	Assert( player.IsPlayer() )
	Assert( IsValid( weapon ) || IsInvalidButMemberVarsStillValid( weapon ) )

	if ( IsPrivateMatch() )
		StatsHook_PrivateMatch_IncrementShots( player )

	if ( !Stats_ShouldGatherBRStatsInModeForPlayer( player ) )
		return

	ItemFlavor ornull weaponFlavorOrNull = GetWeaponItemFlavorByClass( weaponName )
	if ( weaponFlavorOrNull != null )
	{
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.shots ), 1 )

		ItemFlavor playerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
		string playerCharacterRef  = ItemFlavor_GetGUIDString( playerCharacter )
		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_shots, playerCharacterRef ), 1 )

		string weaponFlavorRef = ItemFlavor_GetGUIDString( expect ItemFlavor(weaponFlavorOrNull) )

		__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.weapon_shots, weaponFlavorRef ), 1 )

		string statsCategory = WeaponItemFlavor_GetStatsCategory( expect ItemFlavor( weaponFlavorOrNull ) )
		bool isCrate = statsCategory == WEAPON_STAT_CATEGORY_CRATE_WEAPON
		ItemFlavor ornull catOrNull = WeaponItemFlavor_GetCategory( expect ItemFlavor( weaponFlavorOrNull ) )
		if ( catOrNull != null )
		{
			string category = WeaponCategoryFlavor_GetStatsKey( expect ItemFlavor( catOrNull ) )
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_weaponcategory_shots, playerCharacterRef, category ), 1 )
			if ( isCrate )
				__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.character_weaponcategory_shots, playerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), 1 )
		}

		GameSummarySquadData gameSummaryData = GameSummary_GetPlayerData( player )
		gameSummaryData.shots++
	}

                                   
                                                                         
       
}

void function StatsHook_PrivateMatch_IncrementHitsAndHeadshots( entity attacker, entity victim, bool isValidHeadshot, var damageInfo )
{
	Assert( IsValid( victim ) )
	if ( !Stats_IsValidMapForStats() )
		return
	if ( attacker == victim )
		return
	if ( !( IsValid( attacker ) && attacker.IsPlayer() && victim.IsPlayer() ) )
		return
	if ( GameMode_IsActive( eGameModes.SURVIVAL ) && !Survival_HasPlayerJumpedOutOfPlane( attacker ) )
		return

	string ornull weaponClassNameOrNull = GetWeaponClassNameFromDamageInfo( damageInfo )
	if ( weaponClassNameOrNull == null )
		return

	bool isDowned   = Bleedout_IsBleedingOut( victim )
	bool isHeadshot = !isDowned && isValidHeadshot
	GameSummarySquadData gameSummaryData = GameSummary_GetPlayerData( attacker )
	gameSummaryData.hits++
	if ( isHeadshot )
		gameSummaryData.headshots++
}

// Temporary Calevents: Generic Damage Hooks
void function StatsHook_TemporaryCalEventsTotalDamageDone( entity attacker, int damageAmount )
{
}

void function StatsHook_LegendDamageAndAbilities( entity attacker, entity victim, int damageAmount, int damageSourceId )
{
	ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
	string attackerCharacterRef  = ItemFlavor_GetGUIDString( attackerCharacter )
	__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_character_damage_done, attackerCharacterRef, damageAmount )
	__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_damage_done_any_mode, attackerCharacterRef ), damageAmount )

	// Begin: Legend Abilities - need to be tracked in all modes
	if ( PlayerHasPassive( attacker, ePassives.PAS_NOVA ) && StatusEffect_HasSeverity( victim, eStatusEffect.in_black_hole_field ) )
		StatsHook_BlackholeDamageDone(attacker, damageAmount)
	StatsHook_GasDamage_OnPlayerTookDamage( attacker, damageSourceId, damageAmount )
	StatsHook_SmokeHits_OnPlayerTookDamage( attacker, damageSourceId )
	StatsHook_VantageUltimateDamage( attacker, damageSourceId, damageAmount )
	StatsHook_CatalystSpikesDamage( attacker, damageSourceId, damageAmount )
	StatsHook_BallisticUltimateDamage( attacker, damageSourceId, damageAmount )
	               
		StatsHook_ConduitUltDamage( attacker, damageSourceId, damageAmount )
       
	// End: Legend Abilities
}

void function StatsHook_OnPlayerOrNPCTookDamage( entity attacker, entity victim, bool isValidHeadshot, var damageInfo, int healthDamage, int shieldDamage )
{
	Assert( IsValid( victim ) )

	if ( IsPrivateMatch() )
		StatsHook_PrivateMatch_IncrementHitsAndHeadshots( attacker, victim, isValidHeadshot, damageInfo )

	int damageAmount = healthDamage + shieldDamage

	if ( IsValid( attacker ) ) // PIN-specific: we want PIN data even for things that we don't want stats on - like self-inflicted, Ring, NPC, & fall damage
		PIN_DamageDone( attacker, victim, float( damageAmount ) )

	if ( attacker == victim )
		return // don't track self-inflicted damage in Stats

	if ( IsCombatNPC( attacker ) || !attacker.IsPlayer() )
		return

	if ( victim.IsPlayer() && Stats_PlayerIsValidForStats( victim ) )
		__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.damage_taken ), damageAmount )

	// we fire this FTUE hook specifically before checking PlayerIsValidForStats so that we don't early exit before checking if they're FTUE bot queue folks
	StatHook_NewPlayerBotQueue_OnPlayerOrNPCTookDamage( attacker, victim, damageAmount )

	if ( !IsValid( attacker ) || !Stats_PlayerIsValidForStats( attacker ) )
		return

	// BEGIN: NPC & Non-Player Victim Stats
	if ( victim.IsNPC() )
	{
		if ( IsStormPoint() )
		{
			switch ( victim.ai.npcType )
			{
				                                           
				                         
				case eNPC.SPIDER_JUNGLE:
          
                      
                     
          
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_to_spider_on_storm_point ), damageAmount )
					break
          
				case eNPC.PROWLER:
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_to_prowler_on_storm_point ), damageAmount )
					break
			}
		}
		return
	}
	// END: NPC & Non-Player Victim Stats

	if ( !victim.IsPlayer() )
		return

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()
	entity weapon = DamageInfo_GetWeapon( damageInfo )

	bool isDowned   = Bleedout_IsBleedingOut( victim )
	bool isHeadshot = !isDowned && isValidHeadshot

	// Event-Specific Stats for Total Damage During Event
	StatsHook_TemporaryCalEventsTotalDamageDone( attacker, damageAmount )

	// BEGIN: Mode-Specific & Any-Mode Stats
	// ALL the damage for ALL the things
	__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_any_mode ), damageAmount )

	// Mixtape LTMs: track overall damage done per mode
	__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_damage_done, damageAmount )

	// BR Solos: track all damage done (also counts as regular survival mode)
	                               
		StatsHook_S21_Solo_Damage_Done( attacker, damageAmount )
       

	                               
		StatsHook_S21_Quad_DamageDone( attacker, damageAmount )
       

	// BattlePass Specific
	if ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_MELEE ) )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.melee_damage_any_mode ), damageAmount )

	if ( currentSeasonRefOrNull != null )
		__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_season_damage_done, expect string( currentSeasonRefOrNull ), damageAmount )

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	StatsHook_LegendDamageAndAbilities( attacker, victim, damageAmount, damageSourceId )

	// BEGIN: Weapon Damage
	string ornull weaponClassNameOrNull = GetWeaponClassNameFromDamageInfo( damageInfo )
	if ( weaponClassNameOrNull != null )
	{
		PIN_DamageDoneToPlayerForWeapon( attacker, expect string( weaponClassNameOrNull ), float(damageAmount), isHeadshot )
		GameSummarySquadData gameSummaryData = GameSummary_GetPlayerData( attacker )
		gameSummaryData.hits++
		if ( isHeadshot )
			gameSummaryData.headshots++

		string category = "unknown"
		if ( SURVIVAL_Loot_IsRefValid( expect string(weaponClassNameOrNull) ) )
			category = GetEnumString( "eLootType", SURVIVAL_Loot_GetLootDataByRef( expect string(weaponClassNameOrNull) ).lootType )

		if ( category == "ORDNANCE" ) // grenades, thermites, & arc stars
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_ordnance_any_mode ), damageAmount )

		ItemFlavor ornull weaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(weaponClassNameOrNull) )
		if ( weaponFlavorOrNull != null )
		{
			string weaponFlavorRef = ItemFlavor_GetGUIDString( expect ItemFlavor(weaponFlavorOrNull) )
			__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_weapon_damage_done, weaponFlavorRef, damageAmount )

                            
                                                                
                                 

			// BattlePass Specific
			if ( PlayerIsInADS( attacker ) == false )
			{
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_hipfire_any_mode ), damageAmount )
			}
                            
       
    
                                                              
    
                                 

			array<string> baseMods = SURVIVAL_Weapon_GetBaseMods( expect string(weaponClassNameOrNull) )
			if ( baseMods.find( "crate" ) != -1 )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_with_red_weapons_any_mode ), damageAmount )

			if ( isHeadshot )
			{
				__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_headshots, 1 )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.headshots_any_mode ), 1 )
				__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_weapon_headshots, weaponFlavorRef, 1 )
			}
		}
	}
	// END: Weapon Damage
	// END: Mode-Specific & Any-Mode Stats

	// Mixtape LTMs use modes[mode_name] Persistence fields
	if ( !Stats_ShouldGatherBRStatsInModeForPlayer( attacker ) || !victim.IsPlayer() )
		return

	// BEGIN: BR & BR-derived LTM Stats
	// BR damage done for all things
	__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done ), damageAmount )

	// Battle Pass Specific
	if ( fileLevel.currentDeathFieldStage == 0 )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_first_ring_round_br ), damageAmount )

	// BR damage done for all things WHILE mid air
	if ( !attacker.IsOnGround() )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.damage_done_midair ), damageAmount )

	ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
	string attackerCharacterRef  = ItemFlavor_GetGUIDString( attackerCharacter )
	__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_damage_done, attackerCharacterRef ), damageAmount )

	if ( currentSeasonRefOrNull != null )
	{
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.season_character_damage_done, expect string(currentSeasonRefOrNull), attackerCharacterRef ), damageAmount )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.season_damage_done, expect string( currentSeasonRefOrNull ) ), damageAmount )
	}

	string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
	if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( attacker ) )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.rankedperiod_damage_done_base, expect string( currentRankedPeriodRefOrNull ) ), damageAmount )

	// BEGIN: Weapon Damage
	if ( weaponClassNameOrNull != null )
	{
		ItemFlavor ornull weaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(weaponClassNameOrNull) )
		if ( weaponFlavorOrNull != null )
		{
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.hits ), 1 )
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_hits, attackerCharacterRef ), 1 )

			string weaponFlavorRef = ItemFlavor_GetGUIDString( expect ItemFlavor(weaponFlavorOrNull) )
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.weapon_damage_done, weaponFlavorRef ), damageAmount )
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.weapon_hits, weaponFlavorRef ), 1 )

			string statsCategory = WeaponItemFlavor_GetStatsCategory( expect ItemFlavor( weaponFlavorOrNull ) )
			bool isCrate = statsCategory == WEAPON_STAT_CATEGORY_CRATE_WEAPON
			ItemFlavor ornull catOrNull = WeaponItemFlavor_GetCategory( expect ItemFlavor( weaponFlavorOrNull ) )
			if ( catOrNull != null )
			{
				string category = WeaponCategoryFlavor_GetStatsKey( expect ItemFlavor( catOrNull ) )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_damage_done, attackerCharacterRef, category ), damageAmount )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_hits, attackerCharacterRef, category ), 1 )
				if ( isCrate )
				{
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_damage_done, attackerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), damageAmount )
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_hits, attackerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), 1 )
				}
			}

			if ( isHeadshot )
			{
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.headshots ), 1 )
				ItemFlavor ornull headCatOrNull = WeaponItemFlavor_GetCategory( expect ItemFlavor( weaponFlavorOrNull ) )
				if ( headCatOrNull != null )
				{
					string headCategory = WeaponCategoryFlavor_GetStatsKey( expect ItemFlavor( headCatOrNull ) )
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_headshots, attackerCharacterRef, headCategory ), 1 )
					if ( isCrate )
						__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_headshots, attackerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), 1 )
				}
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.weapon_headshots, weaponFlavorRef ), 1 )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_headshots, attackerCharacterRef ), 1 )
			}
		}
	}
	// END: Weapon Damage
	// END: BR & BR-derived LTM Stats
}
#endif



////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Loot player events //////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
#if SERVER

table<entity, bool> t_fullyKittedPlayers

void function OnPlayerLootPickup( entity user, entity lootPickup, string ref, int pickupCount, bool willDestroy, entity deathBox, int spawnSource )
{
	Assert( IsValid( user ) && user.IsPlayer() && IsValid( lootPickup ) )

	if ( !Stats_PlayerIsValidForStats( user ) )
		return

	// we want to track ally pickup from Lifeline care packages across all modes
	StatsHook_MedicCarePackage_OnPlayerLootPickup( user, lootPickup )

	// we want to track care package openings across all modes
	if ( lootPickup.e.spawnSource == eSpawnSource.DROPPOD  && !IsValid( GetBlackMarketInUseByPlayer( user ) ) )
	{
		entity droppod = lootPickup.GetParent()
		if ( IsValid( droppod ) && droppod.e.sourceWeaponClassname == "" )
		{
			if ( !(user in droppod.e.stats_usersSet) )
			{
				ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( user ), Loadout_Character() )
				string characterRef  = ItemFlavor_GetGUIDString( character )

				__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.neutral_airdrops_looted ), 1 )
				__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.character_neutral_airdrops_looted, characterRef ), 1 )
			}
			droppod.e.stats_usersSet[user] <- true
		}
	}

	if ( !Stats_ShouldGatherBRStatsInModeForPlayer( user ) )
		return

	#if SERVER
		StatsHook_Gameplay_LootedAllNonGoldWeaponsInOneMatch( user, ref )
	#endif

	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
	if ( data.lootType == eLootType.MAINWEAPON )
	{

                                    
                                                                
                                          

		array<entity> weapons = user.GetMainWeapons()
		int fullyKittedCount  = 0
		foreach ( weapon in weapons )
		{
			LootData wData = SURVIVAL_GetLootDataFromWeapon( weapon )
			if ( SURVIVAL_Weapon_IsFullyKitted( wData.ref ) )
				fullyKittedCount++
		}
		if ( fullyKittedCount >= 2 && !(user in t_fullyKittedPlayers) && !IsGoldRushMode() ) // TODO: probably a better way to track this via new challenges functionality
		{
			__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.times_fully_kitted ), 1 )
			t_fullyKittedPlayers[user] <- true
		}
	}

                                   
                                            
  
                                                                              
  
                                                
  
                                                                                  
  
                                         

	if ( lootPickup.e.spawnSource != eSpawnSource.PLAYER_DROP )
	{
		if ( data.tier == 3 )
		{
			__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.looted_epic_item ), 1 )
		}
		else if ( data.tier == 4 )
		{
			ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( user ), Loadout_Character() )
			string characterRef  = ItemFlavor_GetGUIDString( character )

			__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.looted_legendary_item ), 1 )
			__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.character_looted_legendary_item, characterRef ), 1 )

			if ( data.lootType == eLootType.ARMOR )
				__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.looted_legendary_armor ), 1 )
			else if ( data.lootType == eLootType.HELMET )
				__IncrementStat_Int( user, ResolveStatEntry( CAREER_STATS.looted_legendary_helmet ), 1 )
		}
	}
}

