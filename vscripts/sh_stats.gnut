void function StatsHook_TrackSkyDiveDistance( entity player )
{
	//printf( "[StatDebug] TrackSkyDiveDistance: Beginning tracking skydive for %s", player.GetPlayerName() )

	Assert( IsNewThread(), "Must be threaded off." )
	player.EndSignal( "OnDestroy" )

	int startDistance = player.GetPlayerStateStats()["d_pilot"]

	//printf( "[StatDebug] TrackSkyDiveDistance: startDistance: %i", startDistance )

	while( IsValid( player ) && !player.IsOnGround() )
	{
		wait 0.5
	}

	int endDistance = player.GetPlayerStateStats()["d_pilot"]
	float distance  = (endDistance - startDistance) / 12.0
	distance *= 0.3048 //Convert to meters
	int distanceInt = int( distance ) //Because we can't use floats for challenge stats

	printf( "[StatDebug] TrackSkyDiveDistance: endDistance: %i. Total Distance (meters): %i", endDistance, distance )
}

void function StatsHook_TrackSprint( entity player )
{
	Assert( IsNewThread(), "Must be threaded off." )
	player.EndSignal( "OnDestroy" )

                                   
                                                          
                                         
}
#endif



