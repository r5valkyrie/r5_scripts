	}
}

void function AddCallback_OnPlayerConnectedForStats( void functionref( entity player ) callBackFunc )
{
	Assert( file.onPlayerConnectedForStatsCallbacks.find( callBackFunc ) == -1, "Already added " + string( callBackFunc ) + " with AddCallback_OnPlayerConnectedForStats" )
	file.onPlayerConnectedForStatsCallbacks.append( callBackFunc )
}

