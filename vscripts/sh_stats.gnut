void function StatsHook_OnDoomingDamage( entity victim, entity attacker, var damageInfo )
{
	if ( !attacker.IsPlayer() || !Stats_PlayerIsValidForStats( attacker ) )
		return

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()

	if ( IsValid( attacker ) && attacker.IsPlayer() )
	{
		if ( victim != attacker )
		{
			ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
			string attackerCharacterRef  = ItemFlavor_GetGUIDString( attackerCharacter )

			__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_dooms, 1 )

			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.dooms_any_mode ), 1 )

			__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_character_dooms, attackerCharacterRef, 1 )

			if ( currentSeasonRefOrNull != null )
				__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_season_dooms, expect string(currentSeasonRefOrNull), 1 )

			if ( IsValidHeadShot( damageInfo, victim ) )
				__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_headshots, 1 )

			//Ranked Arenas
                                               
                                                                                                                                           
                                                                                                                    
     
                                                                                                                                                        
     
         

			// S21 quads knockdowns hook
			                               
			StatsHook_S21_Quad_Knockdowns( attacker )
         
		}
	}

	ScriptDamageInfoClone attackerDIC           = CloneScriptDamageInfo( damageInfo ) // need to clone because Code doesn't guarantee this instance of damageInfo persists
	string ornull attackerWeaponClassNameOrNull = GetWeaponClassNameFromDamageInfoClone( attackerDIC )
	if ( attackerWeaponClassNameOrNull != null )
	{
		ItemFlavor ornull attackerWeaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(attackerWeaponClassNameOrNull) )
		if ( attackerWeaponFlavorOrNull != null )
		{
			if ( IsValid( attacker ) && attacker.IsPlayer() )
			{
				string attackerWeaponRef = ItemFlavor_GetGUIDString( expect ItemFlavor(attackerWeaponFlavorOrNull) )
				__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_weapon_dooms, attackerWeaponRef, 1 )
			}
		}
	}

	GetEHIScriptStruct( victim ).gotDownedCount++

	bool validAttacker = IsValid( attacker ) && attacker.IsPlayer() && victim != attacker

	float distance = DamageInfo_GetDistFromAttackOrigin( damageInfo )
	distance = distance / 12
	distance *= 0.3048 //Convert to meters
	int newDistance    = int( distance )
	                           
		StatsHook_BeginnerChallenges_OnDoomingDamage( victim, attacker, damageInfo )
                                 

	if ( !Stats_ShouldGatherBRStatsInModeForPlayer( victim ) )
		return

	__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.times_got_doomed ), 1 )

	if ( validAttacker )
	{
		fileLevel.mostRecentDoomAttacker = attacker
		victim.p.doomedAttacker = attacker
		fileLevel.mostRecentDoomVictim = victim

		int victimTeam = victim.GetTeam()
		array<entity> doomedEnemies
		if (victimTeam in attacker.p.doomedEnemies)
			doomedEnemies = attacker.p.doomedEnemies[victimTeam]
		else
			attacker.p.doomedEnemies[victimTeam] <- doomedEnemies

		if ( doomedEnemies.find( victim ) != -1 )
			Warning( "StatsHook_OnDoomingDamage, doomedEnemies already contains victim!" )
		else
			doomedEnemies.append(victim)

		ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
		string attackerCharacterRef  = ItemFlavor_GetGUIDString( attackerCharacter )

		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.dooms ), 1 )
		__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_dooms, attackerCharacterRef ), 1 )

		if ( attackerWeaponClassNameOrNull != null )
		{
			ItemFlavor ornull attackerWeaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(attackerWeaponClassNameOrNull) )
			if ( attackerWeaponFlavorOrNull != null )
			{
				string attackerWeaponRef = ItemFlavor_GetGUIDString( expect ItemFlavor(attackerWeaponFlavorOrNull) )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.weapon_dooms, attackerWeaponRef ), 1 )
				string statsCategory = WeaponItemFlavor_GetStatsCategory( expect ItemFlavor( attackerWeaponFlavorOrNull ) )
				bool isCrate = statsCategory == WEAPON_STAT_CATEGORY_CRATE_WEAPON
				ItemFlavor ornull catOrNull = WeaponItemFlavor_GetCategory( expect ItemFlavor(attackerWeaponFlavorOrNull) )
				if ( catOrNull != null )
				{
					string category = WeaponCategoryFlavor_GetStatsKey( expect ItemFlavor( catOrNull ) )
					__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_dooms, attackerCharacterRef, category ), 1 )
					if ( isCrate )
						__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_weaponcategory_dooms, attackerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), 1 )
				}
			}
		}

		if ( currentSeasonRefOrNull != null )
		{
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.season_dooms, expect string( currentSeasonRefOrNull ) ), 1 )
		}

		string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( attacker ) )
		{
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.rankedperiod_dooms_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )
		}

		Stats_UpdateDistanceKillStatEntry( attacker, ResolveStatEntry( CAREER_STATS.distance_kill ), newDistance )

		if ( IsValidHeadShot( damageInfo, victim ) )
		{
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.headshots ), 1 )
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.headshots_any_mode ), 1 )
			attacker.p.headshotKills++
		}
	}
}
void function OnPlayerStartBleedout( entity victim, entity attacker, var damageInfo )
{
	Assert( victim.IsPlayer() )

	PIN_PlayerDowned( victim, attacker, damageInfo )
}

void function OnPlayerGotRevived( entity injured, entity healer )
{
	PIN_PlayerRevived( injured, healer )

	if ( !Stats_PlayerIsValidForStats( healer ) )
		return

	if ( IsValid( injured.p.doomedAttacker ) )
	{
		GetEHIScriptStruct( injured.p.doomedAttacker ).noWitnessess = false
		if (injured.GetTeam() in injured.p.doomedAttacker.p.doomedEnemies)
		{
			table< int, array<entity> > attackersDoomedEnemies = injured.p.doomedAttacker.p.doomedEnemies
			attackersDoomedEnemies[injured.GetTeam()].removebyvalue(injured)
		}

		injured.p.doomedAttacker = null
	}

	bool modeIsValidForBRStats = Stats_ModeIsValidForBRStats()

	__Mode_IncrementStat_Int( healer, CAREER_STATS.modes_revived_ally, 1 )

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()
	if ( currentSeasonRefOrNull != null )
		__Mode_IncrementStat_Int( healer, CAREER_STATS.modes_season_revived_ally, expect string( currentSeasonRefOrNull ), 1 )

	// character specific trackers are updated across all modes
	if ( PlayerHasPassive( injured, ePassives.PAS_MIRAGE ) )
		__IncrementStat_Int( injured, ResolveStatEntry( CAREER_STATS.mirage_successful_revives ), 1 )

	// should this be inside of the mode-checK? ModeIsValid doesn't currently check against the valentine's playlist var
	if ( GetCurrentPlaylistVarInt( "valentines_event", 0 ) > 0 )
		__IncrementStat_Int( healer, ResolveStatEntry( CAREER_STATS.valentines_revives_and_respawns ), 1 )

	if ( modeIsValidForBRStats )
	{
		__IncrementStat_Int( healer, ResolveStatEntry( CAREER_STATS.revived_ally ), 1 )

		ItemFlavor healerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( healer ), Loadout_Character() )
		string healerCharacterRef  = ItemFlavor_GetGUIDString( healerCharacter )
		__IncrementStat_Int( healer, ResolveStatEntry( CAREER_STATS.character_revived_ally, healerCharacterRef ), 1 )

		if ( currentSeasonRefOrNull != null )
			__IncrementStat_Int( healer, ResolveStatEntry( CAREER_STATS.season_revived_ally, expect string( currentSeasonRefOrNull ) ), 1 )

		string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( healer ) )
			__IncrementStat_Int( healer, ResolveStatEntry( CAREER_STATS.rankedperiod_revived_ally_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )
	}

	//Ranked Arenas
                                             
                                                                                                                                         
                                                                                                                  
                                                                                                                                                           
       
}

void function StatsHook_TrackPlayerDeaths( entity victim )
{
	Assert( IsValid( victim ) )
	Assert( victim.IsPlayer() )
	if ( victim.p.updatedPersistenceOnDisconnect )
		return // if a player was bleeding out and disconnected, we intercepted earlier to accurately track deaths before persistence is finalized

	if ( !Stats_PlayerIsValidForStats( victim ) )
		return

	bool modeIsValidForBRStats           = Stats_ModeIsValidForBRStats()
	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()
	string victimCharacterRef            = ItemFlavor_GetGUIDString( LoadoutSlot_GetItemFlavor( ToEHI( victim ), Loadout_Character() ) )

	__Mode_IncrementStat_Int( victim, CAREER_STATS.modes_deaths, 1 )
	__Mode_IncrementStat_Int( victim, CAREER_STATS.modes_character_deaths, victimCharacterRef, 1 )
	if ( currentSeasonRefOrNull != null )
	{
		__Mode_IncrementStat_Int( victim, CAREER_STATS.modes_season_deaths, expect string( currentSeasonRefOrNull ), 1 )
	}

	if ( modeIsValidForBRStats )
	{
		__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.deaths ), 1 )
		__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.character_deaths, victimCharacterRef ), 1 )

		if ( currentSeasonRefOrNull != null )
		{
			__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.season_deaths, expect string( currentSeasonRefOrNull ) ), 1 )
		}

		string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( victim ) )
		{
			__IncrementStat_Int( victim, ResolveStatEntry( CAREER_STATS.rankedperiod_deaths_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )
		}
	}
}

void function OnPlayerKilled( entity victim, entity attacker, var attackerDamageInfo )
{
	Assert( IsValid( victim ) )
	Assert( IsValid( attacker ) )
	Assert( victim.IsPlayer() )

	// check Bleedout below as well just because it makes Script more legible
	// START PIN-SPECIFIC SCOPE
	{
		entity bleedoutAttacker
		if ( Bleedout_IsBleedingOut( victim ) )
			bleedoutAttacker = Bleedout_GetBleedoutAttacker( victim )
		PIN_PlayerKilled( victim, attacker, attackerDamageInfo )
	}
	// END PIN SCOPE

	if ( !Stats_PlayerIsValidForStats( victim ) )
		return

	StatsHook_TrackPlayerDeaths( victim )

	if ( attacker == victim )
		return // don't record kill stats for suicides

	bool modeIsValidForBRStats = Stats_ModeIsValidForBRStats()
	ItemFlavor attackerCharacter

	if ( attacker.IsPlayer() )
	{
		attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
		if ( DamageInfo_GetDamageType( attackerDamageInfo ) == DMG_MELEE_EXECUTION )
		{
			// EXECUTION DAMAGE START - Monitor RPROF for performance issues as *both* callbacks here are expensive.
			{
				int damageAmount = int( DamageInfo_GetDamage( attackerDamageInfo ) ) // returns float
				StatsHook_OnPlayerOrNPCTookDamage( attacker, victim, false, attackerDamageInfo, damageAmount, 0 )
			}
			// EXECUTION DAMAGE END

			__Mode_IncrementStat_Int( attacker, CAREER_STATS.modes_executions, 1 )

			// Battle Pass Specific
			__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.executions_any_mode ), 1 )

			if ( modeIsValidForBRStats )
			{
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.executions ), 1 )
				__IncrementStat_Int( attacker, ResolveStatEntry( CAREER_STATS.character_executions, ItemFlavor_GetGUIDString( attackerCharacter ) ), 1 )
			}
			GetEHIScriptStruct( attacker ).gaveFinisherCount++
		}

		                        
			StatsEvent_Control_OnPlayerKilled( victim, attacker )
                                
	}

	bool haveKiller = false
	entity killer
	ItemFlavor killerCharacter
	ScriptDamageInfoClone killerDIC

	if ( Bleedout_IsBleedingOut( victim ) )
	{
		// todo(dw): find out who execution kills should be credited to
		entity bleedoutAttacker = Bleedout_GetBleedoutAttacker( victim )
		if ( IsValid( bleedoutAttacker ) && bleedoutAttacker.IsPlayer() )
		{
			haveKiller = true
			killer = bleedoutAttacker
			killerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( killer ), Loadout_Character() )
			//killerDamageInfo = Bleedout_GetBleedoutDamageInfo( victim )
			killerDIC = Bleedout_GetBleedoutDamageInfo( victim )
		}
	}

	if ( !haveKiller && attacker.IsPlayer() )
	{
		haveKiller = true
		killer = attacker
		killerCharacter = attackerCharacter
		//killerDamageInfo = attackerDamageInfo
		killerDIC = CloneScriptDamageInfo( attackerDamageInfo ) // todo(dw): aaaaaaaaaAAAAAAAA
	}

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()

	// Modes Stats
	if ( haveKiller )
	{
		// This could possibly go into ShouldGatherStats(), but stats can still be updated for some things after match participation ends
		if ( killer.p.hasMatchParticipationEnded ) // Don't award kills XP for players who have already been eliminated.
			return

		// BattlePass Specific
		// Note that this works fine with melee weapons (fists & heirlooms)
		string ornull killerWeaponClassNameOrNull = GetWeaponClassNameFromDamageInfoClone( killerDIC )
		if ( killerWeaponClassNameOrNull != null )
		{
			ItemFlavor ornull killerWeaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(killerWeaponClassNameOrNull) )
			if ( killerWeaponFlavorOrNull != null )
			{
				array<string> baseMods = SURVIVAL_Weapon_GetBaseMods( expect string(killerWeaponClassNameOrNull) )
				if ( baseMods.find( "crate" ) != -1 )
					__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills_with_red_weapons_any_mode ), 1 )
				string killerWeaponFlavorRef = ItemFlavor_GetGUIDString( expect ItemFlavor(killerWeaponFlavorOrNull) )
				__Mode_IncrementStat_Int( killer, CAREER_STATS.modes_weapon_kills, killerWeaponFlavorRef, 1 )
			}

			                        
			if ( GameModeVariant_IsActive( eGameModeVariants.FREEDM_GUNGAME ) && killerWeaponClassNameOrNull == GUNGAME_THROWING_KNIFE_WEAPON_NAME )
			{
				__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills_with_throwing_knife_gungame ), 1 )
			}
         
		}
		// BattlePass Specific
		__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills_or_assists_any_mode ), 1 )

		// BattlePass Specific
		ItemFlavor victimCharacter = LoadoutSlot_GetItemFlavor( ToEHI( victim ), Loadout_Character() )
		if ( victimCharacter == killerCharacter )
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.mirror_legend_kills_any_mode ), 1 )

		__Mode_IncrementStat_Int( killer, CAREER_STATS.modes_kills, 1 )
		__Mode_IncrementStat_Int( killer, CAREER_STATS.modes_kills_or_assists, 1 )

		if ( currentSeasonRefOrNull != null )
			__Mode_IncrementStat_Int( killer, CAREER_STATS.modes_season_kills, expect string(currentSeasonRefOrNull), 1 )

		string killerCharacterRef = ItemFlavor_GetGUIDString( killerCharacter )
		__Mode_IncrementStat_Int( killer, CAREER_STATS.modes_character_kills, killerCharacterRef, 1 )

		// abilities are NOT mode-specific, but we need to increment before we return
		int killerDamageSourceId = killerDIC.damageSourceIdentifier
		StatsHook_HuntMode_OnKill( killer )
		StatsHook_GasTraps_OnKill( killer, victim, killerCharacter )
		StatsHook_DefensiveBombardment_OnKill( killer, killerDamageSourceId )

		                               
			StatsHook_S21_Solo_Kills( killer, 1 )
        

		                               
			StatsHook_S21_Quad_Kills( killer, 1 )
        
	}

	if ( !modeIsValidForBRStats )
		return

	if ( haveKiller )
	{
		if ( !Stats_ShouldGatherBRStatsInModeForPlayer( killer ) )
			return

		// This could possibly go into ShouldGatherStats(), but stats can still be updated for some things after match participation ends
		if ( killer.p.hasMatchParticipationEnded ) // Don't award kills XP for players who have already been eliminated.
			return

		string killerCharacterRef = ItemFlavor_GetGUIDString( killerCharacter )

		// player killed player
		__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills ), 1 )
		__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills_or_assists ), 1 )
		__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_kills, killerCharacterRef ), 1 )

		if ( currentSeasonRefOrNull != null )
		{
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.season_kills, expect string( currentSeasonRefOrNull ) ), 1 )
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.season_character_kills, expect string(currentSeasonRefOrNull), killerCharacterRef ), 1 )
		}

		string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
		if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( killer ) )
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.rankedperiod_kills_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )

		if ( Time() < victim.p.lastRespawnTouchGroundTime + 10.0 || victim.p.lastRespawnTouchGroundTime < victim.p.lastRespawnTime )
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_reinforcement_recalls, killerCharacterRef ), 1 )

		RemoveInvalidRapidElimKills( killer )
		killer.p.rapidElimTracker.append( Time() )
		if ( killer.p.rapidElimTracker.len() == 4 )
		{
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_rapid_eliminations, killerCharacterRef ), 1 )
			ClearRapidElimKills( killer )
		}

		if ( killer.GetEncodedEHandle() == SurvivalCommentary_GetKillLeaderEEH() )
		{
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.kills_while_killleader ), 1 )
			__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_kills_while_killleader, killerCharacterRef ), 1 )
		}

		string ornull killerWeaponClassNameOrNull = GetWeaponClassNameFromDamageInfoClone( killerDIC )

		if ( killerWeaponClassNameOrNull != null )
		{
			ItemFlavor ornull killerWeaponFlavorOrNull = GetWeaponItemFlavorByClass( expect string(killerWeaponClassNameOrNull) )
			if ( killerWeaponFlavorOrNull != null )
			{
				string killerWeaponRef = ItemFlavor_GetGUIDString( expect ItemFlavor(killerWeaponFlavorOrNull) )

				__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.weapon_kills, killerWeaponRef ), 1 )

				string statsCategory = WeaponItemFlavor_GetStatsCategory( expect ItemFlavor( killerWeaponFlavorOrNull ) )
				bool isCrate = statsCategory == WEAPON_STAT_CATEGORY_CRATE_WEAPON
				ItemFlavor ornull catOrNull = WeaponItemFlavor_GetCategory( expect ItemFlavor( killerWeaponFlavorOrNull ) )
				if ( catOrNull != null )
				{
					string category = WeaponCategoryFlavor_GetStatsKey( expect ItemFlavor( catOrNull ) )
					__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_weaponcategory_kills, killerCharacterRef, category ), 1 )
					if ( isCrate )
						__IncrementStat_Int( killer, ResolveStatEntry( CAREER_STATS.character_weaponcategory_kills, killerCharacterRef, WEAPON_STAT_CATEGORY_CRATE_WEAPON ), 1 )
				}
			}
		}
	}
}

void function StatsHook_OnPlayerAssist( entity assistingPlayer )
{
	Assert( IsValid( assistingPlayer ) )
	Assert( assistingPlayer.IsPlayer() )

	if ( !Stats_PlayerIsValidForStats( assistingPlayer ) )
		return

	string ornull currentSeasonRefOrNull = GetCurrentStatSeasonRefOrNull()

	__Mode_IncrementStat_Int( assistingPlayer, CAREER_STATS.modes_assists, 1 )
	__Mode_IncrementStat_Int( assistingPlayer, CAREER_STATS.modes_kills_or_assists, 1 )
	if ( currentSeasonRefOrNull != null )
		__Mode_IncrementStat_Int( assistingPlayer, CAREER_STATS.modes_season_assists, expect string( currentSeasonRefOrNull ), 1 )

	// BattlePass Specific
	__IncrementStat_Int( assistingPlayer, ResolveStatEntry( CAREER_STATS.kills_or_assists_any_mode ), 1 )

	//Ranked Arenas
                                             
                                                                                                                                         
                                                                                                                  
   
                                                                                                                                                               
   
       

	if ( !Stats_ModeIsValidForBRStats() )
		return

	__IncrementStat_Int( assistingPlayer, ResolveStatEntry( CAREER_STATS.assists ), 1 )
	__IncrementStat_Int( assistingPlayer, ResolveStatEntry( CAREER_STATS.kills_or_assists ), 1 )

	if ( currentSeasonRefOrNull != null )
		__IncrementStat_Int( assistingPlayer, ResolveStatEntry( CAREER_STATS.season_assists, expect string( currentSeasonRefOrNull ) ), 1 )

	string ornull currentRankedPeriodRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )
	if ( currentRankedPeriodRefOrNull != null && ShouldRecordRankedStats( assistingPlayer ) )
		__IncrementStat_Int( assistingPlayer, ResolveStatEntry( CAREER_STATS.rankedperiod_assists_base, expect string( currentRankedPeriodRefOrNull ) ), 1 )
}

void function StatsHook_LootCreepKilled( entity creep, entity attacker )
{
	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
