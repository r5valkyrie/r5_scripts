void function StatsHook_ArenasBuySystem( entity player, int purchaseType, int purchaseAmount )
{
	if ( !Stats_PlayerIsValidForStats( player ) )
		return

	if ( purchaseAmount < 1 )
		return

	switch ( purchaseType )
	{
		case eArenasPurchaseData.UPGRADE:
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.arenas_weapons_upgraded ), purchaseAmount )
			break
		case eArenasPurchaseData.SKILL:
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.arenas_skills_purchased ), purchaseAmount )
			break
		case eArenasPurchaseData.ORDNANCE:
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.arenas_ordnance_purchased ), purchaseAmount )
			break
		case eArenasPurchaseData.HEAL:
			__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.arenas_heals_purchased ), purchaseAmount )
			break
	}
}
