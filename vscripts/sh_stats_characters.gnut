	__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.loba_ultimate_loot_taken_by_allies ), 1 )
}

void function StatsHook_EyeForQuality_OnLootPinged( entity player, entity lootEnt )
{
	if ( !Stats_PlayerIsValidForStats( player ) )
		return

	LootData lootFlav = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )

	if ( lootFlav.tier - 1 < eRarityTier.EPIC )
		return

	if ( lootEnt.e.spawnSource == eSpawnSource.PLAYER_DROP )
		return

	if ( lootEnt.e.eyeForQuality_everPinged )
		return

	lootEnt.e.eyeForQuality_everPinged = true

	vector trPos        = lootEnt.GetWorldSpaceCenter()
	TraceResults tr     = TraceLineHighDetail( player.EyePosition(), trPos, player, TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_PLAYER )
	float distTolerance = 16.0
	if ( tr.hitEnt != lootEnt && DistanceSqr( trPos, tr.endPos ) < distTolerance * distTolerance )
		return // only count pings through walls

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.loba_passive_loot_pinged_through_walls ), 1 )
}

// Mirage - Cloaked Revives are handled separately.
void function StatsHook_HoloPiliot_OnDecoyCreated( entity owner )
{
	if ( !Stats_PlayerIsValidForStats( owner ) )
		return

	__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.mirage_decoys_created ), 1 )
}

void function StatsHook_HoloPiliot_OnDecoyDamaged( entity decoy, entity owner, entity attacker, var damageInfo )
{
	if ( !Stats_PlayerIsValidForStats( owner ) )
		return

	if ( attacker in decoy.e.stats_usersSet )
		return
	decoy.e.stats_usersSet[attacker] <- true

	// if a decoy is damaged, count it as a bamboozle
	__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.mirage_successful_bamboozles ), 1 )
}

//Octane
void function StatsHook_TrackStimDistance( entity player )
{
	Assert( IsNewThread(), "Must be threaded off." )
	player.EndSignal( "OnDestroy" )

	if ( !Stats_PlayerIsValidForStats( player ) )
		return

	int startDistance = player.GetPlayerStateStats()["d_pilot"]

	while( StatusEffect_HasSeverity( player, eStatusEffect.stim_visual_effect ) )
	{
		wait 0.6
	}

	int endDistance = player.GetPlayerStateStats()["d_pilot"]
	float distance  = (endDistance - startDistance) / 12.0
	distance *= 0.3048 //Convert to meters

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.octane_stim_distance_traveled ), int( distance ) )
}

void function StatsHook_JumpPad_OnUsed( entity jumpPad, entity owner, entity user )
{
	if ( !Stats_PlayerIsValidForStats( owner ) )
		return

	if ( owner == user || !IsFriendlyTeam( owner.GetTeam(), user.GetTeam() ) )
		return // only count friendly uses

	if ( user in jumpPad.e.stats_usersSet )
		return // only count the first use by each ally for each jumpad
	jumpPad.e.stats_usersSet[user] <- true

	__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.octane_jump_pad_allies_launched ), 1 )
}

void function StatsHook_OctaneHealthRegen_OnEntityHealResourceFinished( entity receiver, int healAmount, string refName, entity provider )
{
	Assert( IsValid( receiver ) )
	if ( !receiver.IsPlayer() )
		return

	if ( !receiver.HasPassive( ePassives.PAS_OCTANE ) )
		return

	if ( !Stats_PlayerIsValidForStats( receiver ) )
		return

	__IncrementStat_Int( receiver, ResolveStatEntry( CAREER_STATS.octane_passive_health_regenerated ), healAmount )
}

// Pathfinder
void function StatsHook_Grapple_OnAttach( entity player )
{
	thread StatsHook_Grapple_Think( player )
}

void function StatsHook_Grapple_Think( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDeath" )
	//EndSignal( player, "OnGrappleDetach" )

	if ( !Stats_PlayerIsValidForStats( player ) )
		return

	const float MAX_GRAPPLE_AIR_TIME_TO_COUNT = 5.0
	vector startPos     = player.GetOrigin()
	bool wasGrappling   = true
	float forcedEndTime = 0.0
	while ( wasGrappling || Time() < forcedEndTime )
	{
		if ( !wasGrappling && (player.IsOnGround() || player.IsZiplining() || player.IsMountingZipline()) )
			break

		bool isGrappling = player.IsGrappleActive()
		if ( wasGrappling && !isGrappling )
			forcedEndTime = Time() + MAX_GRAPPLE_AIR_TIME_TO_COUNT
		wasGrappling = isGrappling

		WaitFrame()
	}

	vector pos     = player.GetOrigin()
	float distance = Distance( startPos, pos )
	distance *= INCHES_TO_METERS
	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.pathfinder_tactical_meters_moved_by_grapple ), int( distance ) )
}

void function StatsHook_PlacedZipline_OnUsed( entity zipline, entity owner, entity user )
{
	if ( owner == user || !IsFriendlyTeam( owner.GetTeam(), user.GetTeam() ) )
		return // only count friendly uses

	if ( !Stats_PlayerIsValidForStats( owner ) )
		return

	if ( user in zipline.e.stats_usersSet )
		return // only count the first use by each ally for each zipline
	zipline.e.stats_usersSet[user] <- true

	__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.pathfinder_ultimate_ziplines_used_by_allies ), 1 )
}

