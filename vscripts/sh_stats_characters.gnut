	// Only increase stat when enemies cross
	if ( IsEnemyTeam( owner.GetTeam(), crossingEnt.GetTeam() ) )
		__IncrementStat_Int( owner, ResolveStatEntry( CAREER_STATS.wattson_breaches_detected ), 1 )
}

