void function StatsHook_MotherlodeEnemiesCaptured( entity fuse, array<entity> bomblets )
{
	if ( !IsValid( fuse ) || !PlayerHasPassive( fuse, ePassives.PAS_FUSE ) || !Stats_PlayerIsValidForStats( fuse ) )
		return

	thread StatsHook_MotherlodeEnemiesCaptured_Think( fuse, bomblets )
}

void function StatsHook_FuseGrenadeBarrage( entity fuse )
{
	if ( !IsValid( fuse ) || !PlayerHasPassive( fuse, ePassives.PAS_FUSE ) || !Stats_PlayerIsValidForStats( fuse ) )
		return

	__IncrementStat_Int( fuse, ResolveStatEntry( CAREER_STATS.fuse_grenade_barrage_thrown ), 1 )
}

void function StatsHook_MotherlodeEnemiesCaptured_Think( entity fuse, array<entity> bomblets )
{
	EndSignal( fuse, "OnDestroy" )

	array<entity> localBomblets = clone bomblets
	float highestHeight = 0.0
	float lowestHeight = 0.0
	while ( true )
	{
		highestHeight = 0.0
		lowestHeight = 0.0
		bool allIgnited = true
		foreach( bomblet in localBomblets )
		{
			if( !IsValid( bomblet ) )
				return

			if( !bomblet.proj.bombletIgnited )
			{
				allIgnited = false
				break
			}
			vector pos = bomblet.GetOrigin()

			if( localBomblets[ 0 ] == bomblet )
			{
				highestHeight = pos.z
				lowestHeight = pos.z
			}
			else
			{
				if( pos.z > highestHeight )
					highestHeight = pos.z

				if( pos.z < lowestHeight )
					lowestHeight = pos.z
			}
		}

		if( allIgnited )
			break

		WaitFrame()
	}

	array< entity > players = GetPlayerArrayOfEnemies( fuse.GetTeam() )

	int numCaptured = 0
	foreach( player in players )
	{
		bool captured = true

		float playerHeight = player.GetOrigin().z
		if ( playerHeight < lowestHeight || playerHeight > highestHeight + MORTAR_RING_FIRE_SEGMENT_HEIGHT )
			continue

		foreach( bomblet in localBomblets )
		{
			vector dirToCenter = -bomblet.proj.mortarRingDirFromCenter
			vector dirToPlayer = FlattenNormalizeVec( player.GetOrigin() - bomblet.GetOrigin() )


			if( dirToCenter.Dot( dirToPlayer ) < 0.0 )
			{
				captured = false
				break
			}
		}
		if( captured )
			numCaptured++
	}

	__IncrementStat_Int( fuse, ResolveStatEntry( CAREER_STATS.fuse_motherlode_enemies_captured ), numCaptured )
}

