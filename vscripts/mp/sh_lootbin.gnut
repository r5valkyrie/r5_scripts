#if SERVER
void function LootBin_PutLootItemInside( entity lootBin, int compartment, string ref, int ornull count )
{
	Assert( compartment != eLootBinCompartment.SECRET || LootBin_HasSecretCompartment( lootBin ), "Tried to put loot into the secret compartment of a regular loot bin" )
	Assert( ( compartment == eLootBinCompartment.SECRET && !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET ) )
		|| ( compartment == eLootBinCompartment.REGULAR && !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) ),
		"Tried to put loot into loot bin that is already open" )

	if ( ref == "blank" )
		return

	LootData lootData = SURVIVAL_Loot_GetLootDataByRef( ref )

	LootRef lootRef
	lootRef.lootData = lootData
	lootRef.count = (count != null ? expect int(count) : lootRef.lootData.countPerDrop)

	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	if ( compartment == eLootBinCompartment.REGULAR )
		lbsd.delayedRegularLoot.append( lootRef )
	else if ( compartment == eLootBinCompartment.SECRET )
		lbsd.delayedSecretLoot.append( lootRef )

	lootBin.e.lootOfRarityHasBeenSpawned = eLootTier._count
	bool shouldSpawnAmmo = !SURVIVAL_Loot_IsAmmoSpawningDisabled()

	if ( lootData.lootType == eLootType.MAINWEAPON && shouldSpawnAmmo )
	{
		string ammoRef = lootData.ammoType
		if ( SURVIVAL_Loot_IsRefValid( ammoRef ) )
		{
			LootData ammoData = SURVIVAL_Loot_GetLootDataByRef( ammoRef )
                         
                                                                                                        
			     
				LootBin_PutLootItemInside( lootBin, compartment, ammoRef, ammoData.countPerDrop * 2 )
         
		}
	}
}
#endif


#if SERVER
int function LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( entity lootBin, int compartment, bool isCompartmentOpen, int onlySpawnLootOfTierOrHigher = eLootTier.NONE, int spawnFilter = -1 )
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]

	bool isSecretCompartment = compartment == eLootBinCompartment.SECRET

	array<LootRef> delayedLoot = (!isSecretCompartment ? lbsd.delayedRegularLoot : lbsd.delayedSecretLoot)

	bool delayLootSpawning = GetCurrentPlaylistVarBool( LOOT_BIN_DELAY_LOOT_SPAWNING_PLAYLIST_VAR, true )

	int amountOfLootSpawned = 0

	int currentEmptySpace = lbsd.spawnedLootIndexes.len() - lbsd.numberOfPiecesOfSpawnedLoot
	if ( delayLootSpawning && !isSecretCompartment && ( currentEmptySpace < delayedLoot.len() ) )
	{
		int newSize = delayedLoot.len() + lbsd.numberOfPiecesOfSpawnedLoot
		lbsd.spawnedLootIndexes.resize( newSize, null )
	}

	int delayedLootInitialSize = delayedLoot.len()
	array<entity> spawnedLoot
	for ( int i = delayedLoot.len() - 1; i >= 0; i-- )
	{
		LootRef lootToSpawn = delayedLoot[i]

		Assert( lootToSpawn.lootData.ref != "blank" )

		if ( delayLootSpawning && lootToSpawn.lootData.tier < onlySpawnLootOfTierOrHigher )
			continue

		if( delayLootSpawning && spawnFilter != -1 && spawnFilter in file.binSpawnFilters && !file.binSpawnFilters[spawnFilter]( lootToSpawn.lootData ) )
			continue

		entity lootEnt = SpawnGenericLoot( lootToSpawn.lootData.ref, lootBin.GetWorldSpaceCenter(), lootBin.GetAngles(), lootToSpawn.count )
		//DebugDrawLine( lootEnt.GetOrigin(), lootEnt.GetOrigin() + <0, 0, 9000>, <255, 0, 0>, true, 10.0 )
		CopyRealmsFromTo( lootBin, lootEnt )
		lootEnt.SetParent( lootBin )
		CopyRealmsFromTo( lootBin, lootEnt )
		amountOfLootSpawned++
		spawnedLoot.append( lootEnt )
		if ( isSecretCompartment )
			lbsd.spawnedSecretLootEnts.append( lootEnt )
		else
			lbsd.spawnedRegularLootEnts.append( lootEnt )

		SetItemSpawnSource( lootEnt, eSpawnSource.LOOTBIN, lootBin )
		lootEnt.e.isSecretLoot = isSecretCompartment

		delayedLoot.fastremove(i)

		if ( delayLootSpawning && !isSecretCompartment )
		{
			lbsd.numberOfPiecesOfSpawnedLoot++

			Assert( lbsd.spawnedLootIndexes.len() == (delayedLoot.len() + lbsd.numberOfPiecesOfSpawnedLoot) )

			int firstIndex = (lbsd.spawnedLootIndexes.len() - 1) - (delayedLootInitialSize - 1 - i)

			Assert( firstIndex >= 0 && firstIndex < lbsd.spawnedLootIndexes.len() )
			for ( int j = firstIndex; j >= 0; j-- )
			{
				if ( lbsd.spawnedLootIndexes[j] == null )
				{
					lbsd.spawnedLootIndexes[j] = lootEnt
					break
				}

				Assert( j != 0, "Failed to find index for loot!" )
			}

		}
	}

	array<entity> existingLootEnts = LootBin_GetSpawnedLoot( lootBin, (compartment == eLootBinCompartment.REGULAR), (compartment == eLootBinCompartment.SECRET) )

	// Merge: use existingLootEnts for items GetChildren() can see, plus the tracked array for items it may miss
	// (GetChildren() may not reflect newly SetParent'd entities in the same frame)
	// Use compartment-specific arrays so regular loot doesn't shift into secret compartment positions and vice versa
	array<entity> trackedLootEnts = isSecretCompartment ? lbsd.spawnedSecretLootEnts : lbsd.spawnedRegularLootEnts
	array<entity> lootEnts = []
	foreach ( entity ent in existingLootEnts )
	{
		if ( !trackedLootEnts.contains( ent ) )
			lootEnts.append( ent )
	}
	lootEnts.extend( trackedLootEnts )

	int numberOfLootItems = lootEnts.len()
	foreach ( int lootIdx, entity lootEnt in lootEnts )
	{
		if ( delayLootSpawning && !isSecretCompartment )
		{
			int index = lbsd.spawnedLootIndexes.find( lootEnt )

			Assert( index != -1 )

			lootIdx = index
		}

		LootData lootFlavor = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )

		float posY = Graph( lootIdx + 1, 0, numberOfLootItems + 1, -51, 51 )

		bool turn90Deg = (lootFlavor.lootType == eLootType.AMMO)
                       
                                                                        
       

		vector localPos = <0, 0, 0>
		vector localAng = <0, 0, 0>
		if ( isCompartmentOpen )
		{
			PropSurvivalFlagsClear( lootEnt, ePropSurvivalFlag.HIDE_LOOT_LINE )

			lootEnt.MakeVisible()
			lootEnt.SetUsable()
			lootEnt.SetUsableByGroup( "pilot" )
                        
                                                    
        
				lootEnt.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )
                        
       
                                                                                                                                  
        

			localPos = <14, posY, 33>
			if ( compartment == eLootBinCompartment.SECRET )
				localPos += <24, 0, -16>

			localAng = <10, 0, 0>
		}
		else
		{
			// todo(dw): R5DEV-121201
			//lootEnt.SetModelScale( 0.5 )

			if ( compartment == eLootBinCompartment.REGULAR )
				localPos = <5, posY, 19>
			else if ( compartment == eLootBinCompartment.SECRET )
				localPos = <-5, posY, 12>

			if ( lootFlavor.lootType == eLootType.MAINWEAPON )
				turn90Deg = true

			if( spawnedLoot.contains( lootEnt ) )
			{
				#if IS_R5DEV_137998_FIXED
					if ( lootFlavor.tier >= eLootTier.EPIC )
					{
						PropSurvivalFlagsSet( lootEnt, ePropSurvivalFlag.HIDE_LOOT_LINE )
						lootEnt.MakeVisible()
						lootEnt.SetUsable()
						lootEnt.SetUsableByGroup( "pilot" )
						lootEnt.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )
					}
					else
					{
						lootEnt.MakeInvisible()
						lootEnt.UnsetUsable()
					}
				#else
					PropSurvivalFlagsSet( lootEnt, ePropSurvivalFlag.HIDE_LOOT_LINE )
					lootEnt.SetUsable()
					lootEnt.SetUsableByGroup( "pilot" )
					lootEnt.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )

					if ( lootFlavor.tier >= eLootTier.EPIC || spawnFilter != -1 )
						lootEnt.MakeVisible()
					else
						lootEnt.MakeInvisible()
				#endif
			}
		}

		if ( turn90Deg )
			localAng = AnglesCompose( localAng, <0, 90.0, 0> )

		//dbocek: Bow needs special rotation to not clip horribly in the loot bins. I tried making this a loot table setting but I didn't really forsee this being used again anytime soon and it added too much unnecessary data
		if ( lootFlavor.ref == "mp_weapon_bow" || lootFlavor.baseWeapon == "mp_weapon_bow" )
		{
			localPos += lootBin.GetUpVector() * 9 + lootBin.GetRightVector() * 2
			localAng = AnglesCompose( localAng, <-45, 0, 0> )
		}


		lootEnt.SetLocalOrigin( localPos )
		lootEnt.SetLocalAngles( localAng )
	}

	if( spawnFilter == -1 )
		lootBin.e.lootOfRarityHasBeenSpawned = onlySpawnLootOfTierOrHigher
	else
		lootBin.e.spawnedFilters[spawnFilter] <- IN_SET

	return amountOfLootSpawned
}
#endif


#if SERVER
void function LootBin_RegisterRadiusSpawnFilter( int index, bool functionref( LootData ) filter )
{
	file.binSpawnFilters[index] <- filter
}

void function TriggerLootSpawnForLootBinsInRadius( vector pos, float radius, int lootTier, int spawnLimitPerFrame = -1, int spawnFilter = -1 )
{
	if ( spawnLimitPerFrame != -1 && GetCurrentPlaylistVarBool( LOOT_BIN_DELAY_LOOT_SPAWNING_PLAYLIST_VAR, true ) )
	{
		thread TriggerLootSpawnForLootBinsInRadius_Thread( pos, radius, lootTier, spawnLimitPerFrame, spawnFilter )
		return
	}

	foreach ( entity lootBin in GetScriptManagedEntArrayWithinCenter( file.lootBinSMEA, TEAM_ANY, pos, radius ) )
	{
		if( spawnFilter != -1  && spawnFilter in lootBin.e.spawnedFilters )
			continue

		if ( lootBin.e.lootOfRarityHasBeenSpawned <= lootTier ) // Set to true by LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary
			continue


		if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
			LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.REGULAR, false, lootTier, spawnFilter )
		//if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET ) )
		//	LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.SECRET, false )
	}
}

void function TriggerLootSpawnForLootBinsInRadius_Thread( vector pos, float radius, int lootTier, int spawnLimitPerFrame, int spawnFilter )
{
	int lootSpawnedSinceWait = 0
	foreach ( entity lootBin in GetScriptManagedEntArrayWithinCenter( file.lootBinSMEA, TEAM_ANY, pos, radius ) )
	{
		if( spawnFilter != -1 && spawnFilter in lootBin.e.spawnedFilters )
			continue

		if ( lootBin.e.lootOfRarityHasBeenSpawned <= lootTier ) // Set to true by LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary
			continue


		if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
			lootSpawnedSinceWait += LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.REGULAR, false, lootTier, spawnFilter )

		if ( lootSpawnedSinceWait > spawnLimitPerFrame )
		{
			lootSpawnedSinceWait = 0
			WaitFrame()
		}
	}
}

#endif


#if SERVER || CLIENT
bool function LootBin_HasSecretCompartment( entity lootBin )
{
                 
                                                                                                                                                        
	     
		Assert( lootBin.GetScriptName() == LOOT_BIN_SCRIPTNAME || lootBin.GetScriptName() == LOOT_BIN_MARKER_SCRIPTNAME )
       

                       
             
       

	bool isSupportBin = lootBin.GetSkin() == lootBin.GetSkinIndexByName( LOOT_BIN_SUPPORT_SKIN )
	bool isMunitionsBin = lootBin.GetSkin() == lootBin.GetSkinIndexByName( MUNITIONS_BOX_LOOT_BIN_SKIN_NAME )

	
	if( lootBin.GetSkin() == lootBin.GetSkinIndexByName( SUPPORT_LOOT_BIN_SKIN_NAME ) )
		return true

	                   
	if( isMunitionsBin )
		return true
       

                 
                                        
             
       

                 
                                                              
             
       

	return false
}
#endif

#if SERVER || CLIENT
bool function LootBin_HasUnopenedSecretCompartment( entity lootBin )
{
	Assert( lootBin.GetScriptName() == LOOT_BIN_SCRIPTNAME || lootBin.GetScriptName() == LOOT_BIN_MARKER_SCRIPTNAME )

	if ( lootBin.GetNetworkedClassName() != "prop_dynamic" )
		return false

	if (LootBin_HasSecretCompartment( lootBin ) == false)
		return false

	if (GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET ) == true)
		return false

	return true
}
#endif

#if SERVER || CLIENT
array<entity> function LootBin_GetSpawnedLoot( entity lootBin, bool includeRegular, bool includeSecret )
{
	#if CLIENT
		Assert( includeRegular && includeSecret, "Cannot distinguish between regular and secret compartments on CLIENT -- must include both" )
	#endif

	array<entity> out = []
	foreach ( entity child in lootBin.GetChildren() )
	{
		if ( child.GetNetworkedClassName() != "prop_survival" )
			continue

		#if SERVER
			if ( child.e.spawnSource != eSpawnSource.LOOTBIN )
				continue

			if ( (!includeRegular && !child.e.isSecretLoot) || (!includeSecret && child.e.isSecretLoot) )
				continue
		#endif

		out.append( child )
	}
	return out
}
#endif


#if SERVER
bool function LootBin_IsEmpty( entity lootBin )
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]

	if ( lbsd.delayedRegularLoot.len() > 0 )
		return false

	if ( lbsd.delayedSecretLoot.len() > 0 )
		return false

	array<entity> loot = LootBin_GetSpawnedLoot( lootBin, true, true )
	if ( loot.len() > 0 )
		return false

	                   
	// munitions boxes get loot inserted into the secret compartment on open, so never consider them empty
	if( lootBin.GetSkin() == lootBin.GetSkinIndexByName( MUNITIONS_BOX_LOOT_BIN_SKIN_NAME ) )
		return false
       

	return true
}
#endif


#if SERVER
array<LootRef> function LootBin_GetLootRefs( entity lootBin, bool includeRegular, bool includeSecret )
{
	array<LootRef> refs = []

	foreach ( entity spawnedLoot in LootBin_GetSpawnedLoot( lootBin, includeRegular, includeSecret ) )
		refs.append( SURVIVAL_CreateLootRefFromLootEnt( spawnedLoot ) )

	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	if ( includeRegular )
		refs.extend( lbsd.delayedRegularLoot )
	if ( includeSecret )
		refs.extend( lbsd.delayedSecretLoot )

	return refs
}
#endif


#if SERVER
bool function LootBin_OnUse( entity lootBin, entity player, int useInputFlags )
{
	if ( !IsBitFlagSet( useInputFlags, USE_INPUT_DEFAULT ) )
		return false

	if ( lootBin.Anim_IsActive() )
		return false

	if ( GradeFlagsHas( lootBin, eGradeFlags.IS_BUSY ) )
		return false

                                 
                                                                               
              
        

	bool isLocked             = GradeFlagsHas( lootBin, eGradeFlags.IS_LOCKED )
	bool isRegularCompOpen    = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	bool isSecretCompOpen     = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )
	bool canAccessSecretComps = IsValid( player )
	bool canBeClosed          = LootBin_CanBeClosed( lootBin )

	int sequenceKind = -1

	// Is this needed?
	bool isValidGameMode = true
                        
                                                                      
       

	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	if( IsValid( player ) && player.IsPlayer() && isValidGameMode && lbsd.addItemsToBinOnOpenCallback != null )
	{
		lbsd.addItemsToBinOnOpenCallback( lootBin, player )
	}

               
                                          
       

                      
                          
  
                                                                       
                                                
      
                                                   
  
     
	canAccessSecretComps = canAccessSecretComps && CanAccessSecretCompartments( lootBin, player )
	if ( isLocked )
	{
		entity owner = lootBin.GetOwner()
		if( owner == player  || GetCurrentPlaylistVarBool( "lootbin_locking_disabled", false ) )
		{
			isLocked = false
			GradeFlagsClear( lootBin, eGradeFlags.IS_LOCKED )
		}
	}

                      
                                         
  
              
  
       

                
                                                                                                                                  
  
                                                      
                                                
      
                                           
  
      
                
                                                             
                                                                     

                                                                                                                          
  
                                                               
                                                               
                                            
   

                             
                                                          
                                                
                                                                                                                                                
                                                          
        
                                                                                   
         
                                       
   
  
      

	if( isLocked )
	{
		//do nothing
	}
	else if ( !isRegularCompOpen || (!isSecretCompOpen && canAccessSecretComps) )
	{
		if ( !isRegularCompOpen && (!isSecretCompOpen && canAccessSecretComps) )
			sequenceKind = eLootBinSequenceKind.OPEN_BOTH
		else if ( !isRegularCompOpen )
			sequenceKind = eLootBinSequenceKind.OPEN_REGULAR
		else if ( !isSecretCompOpen && canAccessSecretComps )
			sequenceKind = eLootBinSequenceKind.OPEN_SECRET
	}
	else if ( canBeClosed )
	{
		if ( isRegularCompOpen && isSecretCompOpen )
			sequenceKind = eLootBinSequenceKind.CLOSE_BOTH
		else if ( isRegularCompOpen )
			sequenceKind = eLootBinSequenceKind.CLOSE_REGULAR
		else if ( isSecretCompOpen )
			Assert( false )
	}
      

	if ( sequenceKind == -1 )
		return false

	thread DoLootBinSequenceThread( lootBin, player, sequenceKind )

	if ( IsValid( player ) )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_LOOTBIN_USED, lootBin, lootBin.GetWorldSpaceCenter(), player.GetTeam(), player )

	return true
}
#endif


#if SERVER
void function LootBin_ForceOpen_Thread( entity lootBin, bool doRegular, bool doSecret )
{
	Assert( doRegular || !doSecret, "Cannot open only secret compartment -- must do only regular or both" )

	while ( GradeFlagsHas( lootBin, eGradeFlags.IS_BUSY ) )
		WaitFrame()

	bool isRegularCompOpen = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	bool isSecretCompOpen  = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )

	int sequenceKind = -1

                      
                          
  
                                                                       
                                                
      
                                                   
  
     
	if ( (!isRegularCompOpen && doRegular) && (!isSecretCompOpen && doSecret) )
		sequenceKind = eLootBinSequenceKind.OPEN_BOTH
	else if ( !isRegularCompOpen && doRegular )
		sequenceKind = eLootBinSequenceKind.OPEN_REGULAR
	else if ( !isSecretCompOpen && doSecret )
		sequenceKind = eLootBinSequenceKind.OPEN_SECRET
      

	if ( sequenceKind == -1 )
		return

	waitthread DoLootBinSequenceThread( lootBin, null, sequenceKind )
}
#endif


#if SERVER
void function LootBin_EmptyBinOfLoot (entity lootBin, bool doRegular, bool doSecret)
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]

	if(doRegular)
	{
		foreach ( entity lootEnt in LootBin_GetSpawnedLoot( lootBin, true, false ) )
			lootEnt.Destroy()

		lbsd.delayedRegularLoot.clear()
	}

	if(doSecret)
	{
		foreach ( entity lootEnt in LootBin_GetSpawnedLoot( lootBin, false, true ) )
			lootEnt.Destroy()

		lbsd.delayedSecretLoot.clear()
	}

                     
                                                                                                                                                                                                                   
                                
                                     
      

}

void function Lootbin_RemoveSpecificLootFromInside( entity lootBin, int compartmentToRemoveFrom, string lootRefToRemove )
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	array<entity> consideredLootEnts

	array<LootRef> consideredDelayedLoot

	switch( compartmentToRemoveFrom )
	{
		case eLootBinCompartment.REGULAR:
			consideredLootEnts = LootBin_GetSpawnedLoot( lootBin, true, false )
			consideredDelayedLoot = lbsd.delayedRegularLoot
			break
		case eLootBinCompartment.SECRET:
			consideredLootEnts = LootBin_GetSpawnedLoot( lootBin, false, true )
			consideredDelayedLoot = lbsd.delayedSecretLoot
			break
	}

	if( consideredLootEnts.len() > 0 )
	{
		for( int i = 0; i < consideredLootEnts.len(); i++ )
		{
			LootRef lootRef = SURVIVAL_CreateLootRefFromLootEnt( consideredLootEnts[i] )
			if( lootRef.lootData.ref == lootRefToRemove )
			{
				consideredLootEnts[i].Destroy()
				break
			}
		}
	}

	if( consideredDelayedLoot.len() > 0 )
	{
		for( int i = 0; i < consideredDelayedLoot.len(); i++ )
		{
			if( consideredDelayedLoot[i].lootData.ref == lootRefToRemove )
			{
				consideredDelayedLoot.fastremove( i )
				break
			}
		}
	}
}

void function LootBin_RemoveLootFromInside (entity lootBin,  int compartmentToRemoveFrom, int numberOfItemsToRemove )
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	array<entity> regularLootEnts = LootBin_GetSpawnedLoot( lootBin, true, false )
	array<entity> secretLootEnts = LootBin_GetSpawnedLoot( lootBin, false, true )

	for( int i = 0; i < numberOfItemsToRemove; i++ )
	{
		switch( compartmentToRemoveFrom )
		{
			case eLootBinCompartment.REGULAR:
				if( regularLootEnts.len() > 0 )
				{
					entity lootEnt = regularLootEnts[ regularLootEnts.len() - 1 ]
					lootEnt.Destroy()
				}
				if( lbsd.delayedRegularLoot.len() > 0 )
				{
					lbsd.delayedRegularLoot.fastremove( lbsd.delayedRegularLoot.len() - 1 )
				}
				break
			case eLootBinCompartment.SECRET:
				if( secretLootEnts.len() > 0 )
				{
					entity lootEnt = secretLootEnts[ secretLootEnts.len() - 1 ]
					lootEnt.Destroy()
				}
				if( lbsd.delayedSecretLoot.len() > 0 )
				{
					lbsd.delayedSecretLoot.fastremove( lbsd.delayedSecretLoot.len() - 1 )
				}
				break
		}
	}
}
#endif

#if SERVER
void function LootBin_ForceClose_Thread( entity lootBin, bool doRegular, bool doSecret, bool deleteLoot )
{
	Assert( doRegular || !doSecret, "Cannot close only secret compartment -- must do only regular or both" )

	EndSignal( lootBin, "OnDestroy" )

	if ( deleteLoot )
	{
		LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
		OnThreadEnd(
			function( ) : ( lootBin, lbsd )
			{
				foreach ( entity lootEnt in LootBin_GetSpawnedLoot( lootBin, true, true ) )
					lootEnt.Destroy()

				lbsd.delayedRegularLoot.clear()
				lbsd.delayedSecretLoot.clear()
			}
		)
	}

	while ( GradeFlagsHas( lootBin, eGradeFlags.IS_BUSY ) )
		WaitFrame()

	bool isRegularCompOpen = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	bool isSecretCompOpen  = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )

	int sequenceKind = -1
	if ( (isRegularCompOpen && doRegular) && (isSecretCompOpen && doSecret) )
		sequenceKind = eLootBinSequenceKind.CLOSE_BOTH
	else if ( isRegularCompOpen && doRegular )
		sequenceKind = eLootBinSequenceKind.CLOSE_REGULAR

	if ( sequenceKind != -1 )
	{
		waitthread DoLootBinSequenceThread( lootBin, null, sequenceKind )
	}

	// find all the players along the bin
	float radius = 50
	array<entity> allPlayers
	vector origin = lootBin.GetOrigin()
	vector right = lootBin.GetRightVector()
	float rightDist = 60
	vector up = lootBin.GetUpVector()
	float upDist = 40
	vector forward = lootBin.GetForwardVector()
	for( int i = -1; i <= 1; i++ )
	{
		array<entity> players = GetPlayerArrayEx( "any", TEAM_ANY, TEAM_ANY, origin + right * i * rightDist + up * upDist, radius )
		foreach( player in players )
		{
			if( !allPlayers.contains( player ) )
				allPlayers.append( player )
		}
	}

	// force the player out of the bin
	vector angledOut = VectorRotateAxis( forward, right, 45 )
	float safeSpotDist = 150
	vector safeSpot = origin + angledOut * safeSpotDist
	foreach( entity player in allPlayers )
	{
		StopPlayingAnimation(player) // R5DEV-601556
		PutPlayerInSafeSpot( player, null, null, safeSpot, safeSpot )
	}
}
#endif


#if SERVER
void function DoLootBinSequenceThread( entity lootBin, entity userOrNull, int sequenceKind )
{
	EndSignal( lootBin, "OnDestroy" )

	Assert( !GradeFlagsHas( lootBin, eGradeFlags.IS_BUSY ) )

	OnThreadEnd( void function() : ( lootBin ) {
		if ( IsValid( lootBin ) )
		{
			GradeFlagsClear( lootBin, eGradeFlags.IS_BUSY )
		}
	} )

	GradeFlagsSet( lootBin, eGradeFlags.IS_BUSY )

	CleanUpPermanentsParentedToDynamicEnt( lootBin )

	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]

	bool wasRegularOpen = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	bool wasSecretOpen  = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )

	//
	// Play the animation
	//

	bool willRegularBeOpen = wasRegularOpen
	bool willSecretBeOpen  = wasSecretOpen

	string animSeq
	if ( sequenceKind == eLootBinSequenceKind.OPEN_REGULAR )
	{
		Assert( !wasRegularOpen )
		animSeq = "loot_bin_01_loba_open_top"
		willRegularBeOpen = true
	}
	else if ( sequenceKind == eLootBinSequenceKind.OPEN_SECRET )
	{
		Assert( !wasSecretOpen )
		animSeq = "loot_bin_01_loba_open_bottom"
		willSecretBeOpen = true
	}
	else if ( sequenceKind == eLootBinSequenceKind.OPEN_BOTH )
	{
		Assert( !wasRegularOpen && !wasSecretOpen )
		animSeq = "loot_bin_01_loba_open_all"
		willRegularBeOpen = true
		willSecretBeOpen = true
	}
	else if ( sequenceKind == eLootBinSequenceKind.CLOSE_REGULAR )
	{
		Assert( wasRegularOpen )
		animSeq = "loot_bin_01_loba_close_top"
		willRegularBeOpen = false
	}
	else if ( sequenceKind == eLootBinSequenceKind.CLOSE_BOTH )
	{
		Assert( wasRegularOpen && wasSecretOpen )
		animSeq = "loot_bin_01_loba_close_all"
		willRegularBeOpen = false
		willSecretBeOpen = false
	}

	lootBin.Anim_SetSafePushMode( false )

	float duration = 0.0
	if ( animSeq != "" )
	{
		duration = lootBin.GetSequenceDuration( animSeq )
		thread PlayAnimOnly( lootBin, animSeq )

		LootBin_Opening_PlaySFX( lootBin, sequenceKind )
	}

	if ( !wasRegularOpen && willRegularBeOpen )
	{
		lbsd.openRegularFX = StartParticleEffectOnEntity_ReturnEntity( lootBin, GetParticleSystemIndex( LOOT_BIN_OPEN_REGULAR_FX ), FX_PATTACH_POINT_FOLLOW, lootBin.LookupAttachment( "FX_LIGHT" ) )
	}
	if ( !wasSecretOpen && willSecretBeOpen )
	{
		//lbsd.openSecretFX = StartParticleEffectOnEntity_ReturnEntity( lootBin, GetParticleSystemIndex( LOOT_BIN_OPEN_SECRET_FX ), FX_PATTACH_POINT_FOLLOW, lootBin.LookupAttachment( "FX_LIGHT" ) )
		//thread DestroyServerFXAfterDelayThread( lbsd.openSecretFX, 6.0 )
		                       
		if ( IsAlive( userOrNull ) && userOrNull.IsPlayer() )
		{
                      
			if( Perk_MunitionsBox_IsEntMunitionsBox( lootBin ) )
			{
				PlayBattleChatterLineToSpeakerAndTeam( userOrNull, "bc_supplyBinWeaponOpened" )
			}

			if( SupportBin_EntityIsSupportBin( lootBin ) )
			{
				PlayBattleChatterLineToSpeakerAndTeam( userOrNull, "bc_supplyBinExtendedOpened" )
			}
        
                                                                      
         
		}
        
		                   
		//StartParticleEffectOnEntity( lootBin, GetParticleSystemIndex( LOOT_BIN_OPEN_SECRET_FX ), FX_PATTACH_POINT_FOLLOW, lootBin.LookupAttachment( "SECRET" ) )
		entity fx = StartParticleEffectOnEntity_ReturnEntity( lootBin, GetParticleSystemIndex( LOOT_BIN_OPEN_SECRET_FX ), FX_PATTACH_POINT_FOLLOW, lootBin.LookupAttachment( "SECRET" ) )
		if (SupportBin_EntityIsSupportBin(lootBin))
		{
			//set support bin color
			EffectSetControlPointVector( fx, 2, <32, 180, 255> )
		}
		if (Perk_MunitionsBox_IsEntMunitionsBox(lootBin))
		{
			//set munition bin color
			EffectSetControlPointVector( fx, 2, <255, 80, 105> )
		}
        

	}

	// Let the loot bin open about halfway before turning on safe push mode.
	// This both gives feedback to the user, and also works around an issue where a player standing right up against it would stop it from opening at all.
	// It still seems to be early enough to fix the cases of crush death that we've seen in practice.
	thread (void function() : ( lootBin ) {
		EndSignal( lootBin, "OnDestroy" )

		wait 0.6
		lootBin.Anim_SetSafePushMode( true )
	})()

	//
	// Update the flags and child loot visibility
	//

	if ( sequenceKind == eLootBinSequenceKind.OPEN_BOTH || sequenceKind == eLootBinSequenceKind.OPEN_REGULAR )
		GradeFlagsSet( lootBin, eGradeFlags.IS_OPEN )

	if ( sequenceKind == eLootBinSequenceKind.OPEN_BOTH || sequenceKind == eLootBinSequenceKind.OPEN_SECRET )
		GradeFlagsSet( lootBin, eGradeFlags.IS_OPEN_SECRET )

	if ( sequenceKind == eLootBinSequenceKind.CLOSE_BOTH || sequenceKind == eLootBinSequenceKind.CLOSE_REGULAR )
		GradeFlagsClear( lootBin, eGradeFlags.IS_OPEN )

	if ( sequenceKind == eLootBinSequenceKind.CLOSE_BOTH )
		GradeFlagsClear( lootBin, eGradeFlags.IS_OPEN_SECRET )

	bool isRegularOpen = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN )
	bool isSecretOpen  = GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )

	if ( !wasRegularOpen && isRegularOpen )
		LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.REGULAR, false )
	if ( !wasSecretOpen && isSecretOpen )
		LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.SECRET, false )

	array<entity> regularLoot = LootBin_GetSpawnedLoot( lootBin, true, false )
	array<entity> secretLoot  = LootBin_GetSpawnedLoot( lootBin, false, true )

	bool revealRegular = false
	bool revealSecret  = false

	// Opening
	if ( (!wasRegularOpen && isRegularOpen) || (!wasSecretOpen && isSecretOpen) )
	{
		bool[1] preventRevealRegular                     = [false]
		bool[1] preventRevealSecret                      = [false]
		void functionref( bool, bool ) preventLootReveal = void function( bool regularArg, bool secretArg ) : ( preventRevealRegular, preventRevealSecret ) {
			preventRevealRegular[0] = preventRevealRegular[0] || regularArg
			preventRevealSecret[0] = preventRevealSecret[0] || secretArg
		}

		foreach ( OnLootBinOpeningCallbackType cb in file.onLootBinOpeningCallbacks )
			cb( userOrNull, lootBin, regularLoot, secretLoot, preventLootReveal )

		if ( !wasRegularOpen && isRegularOpen && !preventRevealRegular[0] )
		{
			if ( !lootBin.e.hasBeenOpened )
			{
				lootBin.e.hasBeenOpened = true
				if ( IsValid( userOrNull ) && userOrNull.IsPlayer() )
					StatsHook_OnPlayerOpenedLootBin( userOrNull, lootBin )
			}
			revealRegular = true
		}

		if ( !wasSecretOpen && isSecretOpen && !preventRevealSecret[0] )
		{
			if( !lootBin.e.hasSecretBeenOpened )
			{
				lootBin.e.hasSecretBeenOpened = true
			}
			revealSecret = true
		}
	}

	// Closing
	if ( (wasRegularOpen && !isRegularOpen) || (wasSecretOpen && !isSecretOpen) )
	{
		if ( (wasRegularOpen && !isRegularOpen) && IsValid( lbsd.openRegularFX ) )
		{
			lbsd.openRegularFX.Destroy()
			lbsd.openRegularFX = null
		}

		//if ( (wasSecretOpen && !isSecretOpen) && IsValid( lbsd.openSecretFX ) )
		//{
		//	lbsd.openSecretFX.Destroy()
		//	lbsd.openSecretFX = null
		//}

		bool shouldDelete = IsInfiniteLootBinsEnabled()

		if ( wasRegularOpen && !isRegularOpen )
		{
			if ( shouldDelete )
				DestroyEntities( regularLoot )
			else
				LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.REGULAR, false ) // put into closed positions
		}

		if ( wasSecretOpen && !isSecretOpen )
		{
			if ( shouldDelete )
				DestroyEntities( secretLoot )
			else
				LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, eLootBinCompartment.SECRET, false ) // put into closed positions
		}
	}

	void functionref( int ) revealLootThread = void function( int compartment ) : ( lootBin ) {
		if ( !IsValid( lootBin ) )
			return

		LootBin_SpawnAndSetupCompartmentLootInsideAsNecessary( lootBin, compartment, true )
	}

	if ( revealRegular )
		delaythread( 0.44 ) revealLootThread( eLootBinCompartment.REGULAR )
	if ( revealSecret )
		delaythread( 0.74 ) revealLootThread( eLootBinCompartment.SECRET )

	//
	// Wait for the animation
	//
	float animTimeLeft = duration
	wait animTimeLeft
}
#endif

#if CLIENT
void function CL_LootBinOpening( entity lootBin, int sequenceType )
{
	foreach ( OnLootBinOpeningCallbackType cb in file.onLootBinOpeningCallbacks )
		cb( lootBin )
}
#endif


#if SERVER || CLIENT
bool function CanAccessSecretCompartments( entity lootBin, entity player )
{
	// todo(dw): move this common role logic to a helper function
	if (!LootBin_HasSecretCompartment( lootBin ))
        return false

	if ( !IsValid( player ) )
		return false

                     
                                                                           
	     
		//change to the perk system has it so that all can access the special bins, but not the secret compartments
		bool canOpenCompartment = false

		bool isSupportBin = SupportBin_EntityIsSupportBin( lootBin )//lootBin.GetSkin() == lootBin.GetSkinIndexByName( LOOT_BIN_SUPPORT_SKIN )
		bool isMunitionsBin = Perk_MunitionsBox_IsEntMunitionsBox( lootBin ) //lootBin.GetSkin() == lootBin.GetSkinIndexByName( MUNITIONS_BOX_LOOT_BIN_SKIN_NAME )

		if( isMunitionsBin && Perks_DoesPlayerHavePerk( player, ePerkIndex.MUNITIONS_BOX ) )
			canOpenCompartment = true
		else if( isSupportBin && Perks_DoesPlayerHavePerk( player, ePerkIndex.EXTRA_BIN_LOOT ) )
			canOpenCompartment = true
                 
                                                                                                 
                            
       
                 
                                                                                                                          
                            
       

       

	return canOpenCompartment
}
#endif


#if SERVER || CLIENT
bool function LootBin_IsOpenAtAll( entity lootBin )
{
	return GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) || GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )
}
#endif


#if SERVER || CLIENT
bool function LootBin_IsFullyOpenedForPlayer( entity lootBin, entity player )
{
	if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
		return false

	if ( CanAccessSecretCompartments( lootBin, player ) && !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET ) )
		return false

	return true
}
#endif


