#if SERVER || CLIENT
void function ShLootBin_Init()
{
	PrecacheModel( LOOT_BIN_MODEL )
	PrecacheScriptString( LOOT_BIN_SCRIPTNAME )
	PrecacheParticleSystem( LOOT_BIN_OPEN_REGULAR_FX )
	PrecacheParticleSystem( LOOT_BIN_OPEN_SECRET_FX )

	#if SERVER
		AddSpawnCallback_ScriptName( LOOT_BIN_MARKER_SCRIPTNAME, InitLootBinFromMap )
		AddSpawnCallback_ScriptName( LOOT_BIN_SCRIPTNAME, InitLootBin )
		AddCallback_OnSurvivalPreprocessFinished( InitLootBinEnts )
		AddCallback_EntitiesDidLoad( EntitiesDidLoad )
		AddCallback_OnLootBinOpening( LootBin_Opened_CountForPIN )
		file.lootBinSMEA = CreateScriptManagedEntArray()

		#if DEVELOPER
			AddClientCommandCallback( "dev_spawn_lootbin", ClientCommand_dev_spawn_lootbin ) // dev
		#endif
	#endif

	#if CLIENT
		AddCreateCallback( "prop_dynamic", OnPropCreated )
		AddDestroyCallback( "prop_dynamic", OnPropDestroyed )
		AddCreateCallback( "prop_script", OnPropCreated )
		AddDestroyCallback( "prop_script", OnPropDestroyed )
	#endif
}
#endif


#if SERVER || CLIENT
array<entity> function GetAllLootBins()
{
	#if SERVER
		return GetScriptManagedEntArray( file.lootBinSMEA )
	#elseif CLIENT
		return GetEntArrayByScriptName( LOOT_BIN_SCRIPTNAME )
	#endif
}
#endif


#if SERVER
int function GetAllLootBinsSMEA()
{
	return file.lootBinSMEA
}
#endif


#if SERVER || CLIENT
void function AddCallback_OnLootBinOpening( OnLootBinOpeningCallbackType callbackFunc )
{
	Assert( !file.onLootBinOpeningCallbacks.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with Survival_AddCallback_OnLootbinOpened" )
	file.onLootBinOpeningCallbacks.append( callbackFunc )
}
#endif


#if SERVER
void function InitLootBinEnts()
{
	// The preprocess step seems to happen before ShLootBin_Init() is called, so delay loot bin inits.
	foreach ( entity lootBin in GetEntArrayByScriptName( LOOT_BIN_SCRIPTNAME ) )
		InitLootBin( lootBin )
}

void function EntitiesDidLoad()
{
	thread InitPerkBins()
}

void function InitPerkBins()
{
	FlagWait("Survival_LootSpawned")

	                       
		                   
			if(!SupportBin_ShouldUseDiscreteSupportBins()) //if using the support loot bin perk, don't randomize support loot bins into normal bin distribution
        
				Randomize_SupportLootBins()
       

	                   
	if( LootBin_RandomizePerkBinsFromExistingBins() )
		Randomize_SupportAndAssaultBins()
       
}
#endif


#if SERVER
void function InitLootBinFromMap( entity lootBinMarker )
{
	SURVIVAL_AddLootBin( lootBinMarker, lootBinMarker.GetLinkParentArray() )

	// SURVIVAL_AddLootBin may delete the bin

	if ( IsValid( lootBinMarker ) )
	{
		lootBinMarker.SetScriptName( LOOT_BIN_SCRIPTNAME )
		InitLootBin( lootBinMarker )
	}
}
#endif


#if SERVER && DEVELOPER
bool function ClientCommand_dev_spawn_lootbin( entity player, array<string> args )
{
	TraceResults tr = TraceLine(
		player.EyePosition(),
		player.EyePosition() + 900.0 * player.GetViewVector(),
		player, TRACE_MASK_NPCWORLDSTATIC, TRACE_COLLISION_GROUP_NONE )
	CreateLootBin( tr.endPos, VectorToAngles( FlattenNormalizeVec( player.EyePosition() - tr.endPos ) ) )
	return true
}
#endif


#if SERVER
entity function CreateLootBin( vector origin, vector angles, bool doMovingGeoDownTrace = false, bool DEV_preventPlaytestSpecial = false, bool supportMinimapIcons = false )
{
	entity lootBin
	if( supportMinimapIcons )
	{
		lootBin = CreateEntity( "prop_script" )
	}
	else
	{
		lootBin = CreateEntity( "prop_dynamic" )
	}

	lootBin.SetScriptName( LOOT_BIN_SCRIPTNAME )
	lootBin.SetValueForModelKey( LOOT_BIN_MODEL )
	lootBin.kv.solid = SOLID_VPHYSICS

	//#if HAS_DEVSCRIPTS
	//	if ( !DEV_preventPlaytestSpecial && RandomFloat( 1.0 ) < GetCurrentPlaylistVarFloat( "playtest_lootbin_override_chance", 0.0 ) )
	//	{
	//		lootBin.e.isPlaytestLootbin = true
	//		lootBin.SetSkin( LOOT_BIN_SKIN_PLAYTEST_BLUE )
	//	}
	//#endif

	lootBin.SetOrigin( origin )
	lootBin.SetAngles( angles )
	DispatchSpawn( lootBin )
	lootBin.SetOrigin( origin )
	lootBin.SetAngles( angles )
	SetIsPermanentEntity( lootBin, true )

                    
	//Forces m_lastPusherAbsOrigin and others variables to update so we don't get "pusher moved outside of think function" warnings
	lootBin.SetPusher( false )
	lootBin.SetPusher( true )
      

	// the loot bin's children actually do the pushing. prevent them from crushing players and close the bin if they were to crush a player
	array<entity> children = lootBin.GetChildren()
	foreach( entity child in children )
	{
		//child.SetDoOnWouldOtherwiseCrushEntityCallback( true )
		AddCallback_OnWouldOtherwiseCrushEntity( child, OnWouldCrushCallback )
	}


	thread Thread_AttachMovingLootBinToGeo( lootBin, doMovingGeoDownTrace )

	// InitLootBin will be called automatically

	return lootBin
}

void function OnWouldCrushCallback( entity pusher, entity pushed )
{
	if( !pushed.IsPlayer() )
		return;
	entity pusherParent = pusher.GetParent()
	if( GradeFlagsHas( pusherParent, eGradeFlags.IS_BUSY ) )
		return
	bool isRegularCompOpen = GradeFlagsHas( pusherParent, eGradeFlags.IS_OPEN )
	bool isSecretCompOpen  = GradeFlagsHas( pusherParent, eGradeFlags.IS_OPEN_SECRET )
	if( !isRegularCompOpen && !isSecretCompOpen )
		return
	thread LootBin_ForceClose_Thread( pusherParent, true, true, false )
}
#endif


#if SERVER
entity function CreateCustomLootBin( vector origin, vector angles, array<string> lootRefs = [], bool doMovingGeoDownTrace = false )
{
	entity lootBin = CreateLootBin( origin, angles, doMovingGeoDownTrace, true )

	LootBin_PutMultipleLootItemsInside( lootBin, eLootBinCompartment.REGULAR, lootRefs )

	return lootBin
}
#endif


#if SERVER
void function Thread_AttachMovingLootBinToGeo( entity lootBin, bool doTrace )
{
	EndSignal( lootBin, "OnDestroy" )

	vector binOriginParentLinkEntsGroupsKey = RoundVectorInLocalSpace( lootBin.GetOrigin(), 1.0, <0, 0, 0>, <0, 0, 0> )

	bool entitiesLoaded = Flag( "EntitiesDidLoad" )
	if ( !entitiesLoaded )
	{
		FlagWait( "EntitiesDidLoad" )
		// HACK - Lets other things, like DLands train, take a frame to init after entities loaded
		WaitFrame()
	}

	// was there a mover linked to the bin in LevelEd?
	table< vector, array<entity> > binOriginParentLinkEntsGroups = Loot_GetParentLinkEntsTable()
	if ( binOriginParentLinkEntsGroupsKey in binOriginParentLinkEntsGroups )
	{
		array<entity> parentLinkEnts = binOriginParentLinkEntsGroups[ binOriginParentLinkEntsGroupsKey ]

		foreach ( entity parentLinkEnt in parentLinkEnts )
		{
			if ( !IsValid( parentLinkEnt ) )
				continue

			if ( parentLinkEnt.GetClassName() == "script_mover" || parentLinkEnt.GetClassName() == "script_mover_lightweight" )
			{
				lootBin.SetParent( parentLinkEnt )
				parentLinkEnt.LinkToEnt( lootBin )
				return
			}
		}
	}
	if ( doTrace )
	{
		TraceResults trace = TraceLineHighDetail(
			lootBin.GetOrigin() + < 0, 0, 32 >,
			lootBin.GetOrigin() - <0, 0, 88>,
			lootBin, LOOT_TRACE, LOOT_COLLISION_GROUP, lootBin )

		if ( IsValid( trace.hitEnt ) && trace.hitEnt.HasPusherAncestor() )
		{
			lootBin.SetParent( trace.hitEnt )
			return
		}

		Warning( "Moving loot bin trace unable to attach to geo! " + lootBin.GetOrigin() )
		//DebugDrawSphere( lootBin.GetOrigin(), 64, <255, 0, 0>, true, 100 )
	}
}
#endif

#if SERVER
EntitySet lootBinDoubleInitCheck
void function InitLootBin( entity lootBin )
{
	if ( lootBin in lootBinDoubleInitCheck )
		return
	lootBinDoubleInitCheck[lootBin] <- IN_SET
	AddEntityDestroyedCallback( lootBin, void function( entity lootBin ) {
		delete lootBinDoubleInitCheck[lootBin]
	} )

	lootBin.SetModel( LOOT_BIN_MODEL )
	lootBin.e.isOpen = false
	lootBin.e.isBusy = false
	lootBin.e.hasBeenOpened = false
	lootBin.e.hasSecretBeenOpened = false
	lootBin.AllowMantle()
	lootBin.SetForceVisibleInPhaseShift( true )
	lootBin.SetFadeDistance( 15000 )
	lootBin.SetIgnorePredictedTriggerTypes( TT_JUMP_PAD | TT_GRAVITY_LIFT | TT_BLACKHOLE  )



	thread LootBin_Enable( lootBin )

	lootBin.Highlight_Enable()
	AddNeurolinkDetectionForPropScript( lootBin )
	AddToScriptManagedEntArray( file.lootBinSMEA, lootBin )

	#if SURVIVAL_DEBUG_LOOT_BINS
		//DebugDrawLine( lootBin.GetOrigin(), lootBin.GetOrigin() + <0, 0, 1000>, <255, 255, 255>, true, 100.0 )
	#endif

	LootBinServerData lbsd
	lbsd.addItemsToBinOnOpenCallback = MaybeAddWeaponToLootBinOnOpen
	file.lootBinServerDataMap[lootBin] <- lbsd
}

void function LootBin_SetAddItemsToBinOnOpenCallback( entity lootBin, void functionref( entity, entity ) callback )
{
	file.lootBinServerDataMap[lootBin].addItemsToBinOnOpenCallback = callback
}

void function LootBin_Enable( entity lootBin )
{
	#if DEVELOPER
		lootBin.EndSignal( "OnDestroy" )
		FlagWait( "Survival_LootSpawned" )
	#endif

	lootBin.SetUsable()
	lootBin.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_BY_OWNER | USABLE_BY_PILOTS | USABLE_BY_ENEMIES )
	lootBin.SetUsablePriority( USABLE_PRIORITY_LOW )
	SetCallback_CanUseEntityCallback( lootBin, CanUseLootBin )
	AddCallback_OnUseEntity_ServerOnly( lootBin, void function( entity lootBin, entity player, int useInputFlags ) {
		LootBin_OnUse( lootBin, player, useInputFlags )
	} )
}
#endif

