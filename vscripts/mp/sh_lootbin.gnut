#if SERVER || CLIENT
global enum eLootBinCompartment
{
	REGULAR,
	SECRET,
	BOTH,
	_COUNT
}
global enum lootBinType
{
	REGULAR,
                   
	MUNITIONS,
	SUPPORT
      
}

global enum eLootBinSequenceKind
{
	OPEN_REGULAR,
	OPEN_SECRET,
	OPEN_BOTH,
	CLOSE_REGULAR,
	//CLOSE_SECRET,
	CLOSE_BOTH,
}
#endif


#if SERVER
global typedef OnLootBinOpeningCallbackType void functionref( entity, entity, array<entity>, array<entity>, void functionref( bool, bool ) )
#elseif CLIENT
global typedef OnLootBinOpeningCallbackType void functionref( entity )
#endif


#if SERVER
struct LootBinServerData
{
	entity openRegularFX

	array<LootRef> delayedRegularLoot
	array<LootRef> delayedSecretLoot

	array<entity> spawnedLootIndexes
	int numberOfPiecesOfSpawnedLoot

	array<entity> spawnedRegularLootEnts
	array<entity> spawnedSecretLootEnts

	void functionref( entity, entity ) addItemsToBinOnOpenCallback
}
#endif

#if SERVER
void function LootBin_Opening_PlaySFX( entity lootBin, int lootBinSequenceKind )
{
	int binType

	//Smart Loot bins for Armories will be read as Regular bin type via this check. All non perk bins will be read as regular bins.
	binType = lootBinType.REGULAR

                   
	if( Perk_MunitionsBox_IsEntMunitionsBox( lootBin ) )
	{
		binType = lootBinType.MUNITIONS
	}

	if( SupportBin_EntityIsSupportBin( lootBin ) )
	{
		binType = lootBinType.SUPPORT
	}
      

	switch ( binType )
	{
		case lootBinType.REGULAR:
			switch( lootBinSequenceKind )
			{
				case eLootBinSequenceKind.OPEN_REGULAR:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Open" )
					break
				case eLootBinSequenceKind.OPEN_SECRET:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Support_Drawer" )
					break
				case eLootBinSequenceKind.OPEN_BOTH:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Support_Open" )
					break
				default:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Open" )
					break
			}
			break
                   
		case lootBinType.SUPPORT:
			switch( lootBinSequenceKind )
			{
				case eLootBinSequenceKind.OPEN_REGULAR:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Open" )
					break
				case eLootBinSequenceKind.OPEN_SECRET:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Support_Drawer" )
					break
				case eLootBinSequenceKind.OPEN_BOTH:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Support_Open" )
					break
			}
			break
		case lootBinType.MUNITIONS:
			switch( lootBinSequenceKind )
			{
				case eLootBinSequenceKind.OPEN_REGULAR:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Assault_Open" )
					break
				case eLootBinSequenceKind.OPEN_SECRET:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Assault_Drawer" )
					break
				case eLootBinSequenceKind.OPEN_BOTH:
					EmitSoundOnEntity( lootBin , "Door_Lootbin_Assault_Open_All" )
					break
			}
			break
      
	}
}

void function LootBin_Opened_CountForPIN( entity player, entity lootbin, array<entity> regularLootEnts, array<entity> secretLootEnts, void functionref( bool, bool ) preventLootRevealFunc )
{
	if ( IsValidPlayer( player ) )
	{
		player.p.lootBinsOpenedCount++
		#if DEVELOPER
			printt( "***** lootbin entity name == " + lootbin.GetScriptName() )
			printt( "***** lootbins opened is now " + ( player.p.lootBinsOpenedCount + 1 ))
		#endif
	}
}
#endif

