#if SERVER || CLIENT
void function AddCallback_CanOpenLootBin( entity lootBin, bool functionref( entity,entity ) callback )
{
	file.canOpenLootBinCallback[lootBin] <- callback
}

bool function CanUseLootBin( entity player, entity lootBin, int useFlags )
{
                   
	if( lootBin in file.canOpenLootBinCallback )
	{
		if( !file.canOpenLootBinCallback[lootBin]( player, lootBin ) )
			return false
	}
      

	if ( player.GetWeaponDisableFlags() == WEAPON_DISABLE_FLAGS_ALL )
		return false

	if ( Bleedout_IsBleedingOut( player ) )
		return false

	if ( LootBin_IsBusy( lootBin ) )
		return false

                       
	if ( LootBin_IsFullyOpenedForPlayer( lootBin, player ) )
		return false
      

	return true
}
#endif


#if CLIENT
string function GetLootBinUseTextOverride( entity lootBin )
{
	entity player = GetLocalViewPlayer()

                                 
                                                                               
  
                                
  
     
       
	if ( !LootBin_IsFullyOpenedForPlayer( lootBin, player ) )
	{
		if ( GradeFlagsHas( lootBin, eGradeFlags.IS_LOCKED ) )
		{
			if ( IsValid( lootBin.GetOwner() ) )
			{
				entity lootBinOwner = lootBin.GetOwner()

				EHI ornull ehi = ToEHI( lootBinOwner )
				if ( ehi == null )
					return ""
				expect EHI( ehi )
				if ( !EHIHasValidScriptStruct( ehi ) )
					return ""

				int team          = EHI_GetTeam( ehi )
				string playerName = GetDisplayablePlayerNameFromEHI( ehi )

				string hint = "#SURVIVAL_LOOTBIN_LOCKED_FRIENDLY"

				if ( lootBinOwner == player || GetCurrentPlaylistVarBool( "lootbin_locking_disabled", false ) )
					hint = "#SURVIVAL_LOOTBIN_LOCKED_SELF"
				else if ( IsEnemyTeam( team, player.GetTeam() ) )
					hint = "#SURVIVAL_LOOTBIN_LOCKED_ENEMY"

				return Localize( hint, playerName )
			}
			return "#SURVIVAL_LOOTBIN_LOCKED"
		}
		else if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
			return "#SURVIVAL_LOOTBIN_OPEN"
	                       
		else if ( !GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET ) )
			return "#SURVIVAL_LOOTBIN_OPEN_SECRET"
       
	}
	else if ( LootBin_CanBeClosed( lootBin ) )
	{
		return "#SURVIVAL_LOOTBIN_CLOSE"
	}
	return ""
}
#endif

#if SERVER

void function Randomize_SupportLootBins()
{
	int lootBinCount = GetScriptManagedEntArrayLen( file.lootBinSMEA )
	if ( lootBinCount == 0 )
		return
	array<entity> allLootBins = GetScriptManagedEntArray( file.lootBinSMEA )
	allLootBins.randomize()
	array<entity> distributedBins
	array<entity> nonDistributedBins

	int goal = int( lootBinCount * GetCurrentPlaylistVarFloat( "supportBinRatio", 0.2 ) )
	if ( GetCurrentPlaylistVarBool( "lootbins_all_support", false ) )
	{
		distributedBins = allLootBins
	}
	else if ( lootBinCount >= goal )
	{
		distributedBins.append( allLootBins[0] )
		for ( int i = 0; i < goal - 1; i++ )
		{
			for ( int j = 0; j < allLootBins.len(); j++ )
			{
				int count = 0
				foreach ( distributedBin in distributedBins )
				{
					if ( DistanceSqr( allLootBins[j].GetOrigin(), distributedBin.GetOrigin() ) > 4000 * 4000 )
					{
						count++
					}
				}
				if ( count == distributedBins.len() )
				{
					distributedBins.append( allLootBins[j] )
					allLootBins.remove( j )
					j--
					break
				}
				else
				{
					nonDistributedBins.append( allLootBins[j] )
					allLootBins.remove( j )
					j--
				}
			}
		}

		int validSpotsFound = distributedBins.len()
		if ( validSpotsFound < goal )
		{
			for ( int i = 0; i < goal - validSpotsFound; i++ )
			{
				distributedBins.append( nonDistributedBins[i] )
			}
		}
	}

	foreach ( entity supportBin in distributedBins )
	{
		supportBin.SetSkin( supportBin.GetSkinIndexByName( SUPPORT_LOOT_BIN_SKIN_NAME ) )
	}
}
                   
bool function LootBin_RandomizePerkBinsFromExistingBins()
{
	return ( GetCurrentPlaylistVarBool( "randomize_perk_bins_from_existing_bins", true ) ) && !ShouldPreprocessData()
}

float function LootBin_Randomization_ExclusionDistance()
{
	return ( GetCurrentPlaylistVarFloat( "perk_bin_randomization_exclusion_distance", 13000 ) )
}

float function LootBin_Randomization_RespawnBeaconExclusionDistance()
{
	return ( GetCurrentPlaylistVarFloat( "perk_bin_randomization_respawn_beacon_exclusion_distance", 3500 ) )
}

float function LootBin_Randomization_FallBackExclusionDistance()
{
	return ( GetCurrentPlaylistVarFloat( "perk_bin_randomization_fallback_exclusion_distance", 7000 ) )
}

int function LootBin_Randomization_Count()
{
	return ( GetCurrentPlaylistVarInt( "perk_bin_randomization_spawn_count", 20 ) )

}

bool function LootBin_RotatingLoot_RefilledInPerkBins_Enabled()
{
	if( Crafting_IsDispenserCraftingEnabled() )
	{
		if( GetCurrentPlaylistVarBool( "lootbin_rotatingloot_refilled_perkbins_enabled", false ) )
			return true
	}

	return false
}

void function Randomize_SupportAndAssaultBins()
{
	int lootBinCount = GetScriptManagedEntArrayLen( file.lootBinSMEA )
	if ( lootBinCount == 0 )
		return

	array<entity> allLootBins = GetScriptManagedEntArray( file.lootBinSMEA )
	array<entity> unchosenBins
	array<entity> supportBins

	int spawnCount = LootBin_Randomization_Count()
	if ( GetCurrentPlaylistVarBool( "lootbins_all_support", false ) )
	{
		supportBins = allLootBins
	}
	else
	{
		RandomizeResult result = RandomizeLootBins( allLootBins, spawnCount )
		supportBins = result.chosenBins
		unchosenBins = result.unchosenBins
	}

	array<entity> assaultBins = RandomizeLootBins( unchosenBins, spawnCount ).chosenBins

	foreach( entity bin in supportBins )
	{
		entity newBin = SupportBin_SpawnSupportBinFromExistingBin( bin )
		if( !IsValid( newBin ) )
			continue
		LootBin_AddOldBinToPerkBinMapping( bin, newBin )
		RemoveFromScriptManagedEntArray( file.lootBinSMEA, bin )
		LootBin_DeleteLootBin(bin)
		PIN_Perks_ExtendedSupplyBinCreated( newBin, newBin.GetOrigin() )
	}

	foreach( entity bin in assaultBins )
	{
		entity newBin = MunitionsBox_SpawnMunitionsBoxPropFromExistingBin( bin )
		if( !IsValid( newBin ) )
			continue
		LootBin_AddOldBinToPerkBinMapping( bin, newBin )
		RemoveFromScriptManagedEntArray( file.lootBinSMEA, bin )
		LootBin_DeleteLootBin(bin)
		PIN_Perks_WeaponSupplyBinCreated( newBin, newBin.GetOrigin() )
	}

	LootBin_RotatingLoot_RefilledInPerkBins_Enabled()
	{
		SupportBin_RotatingLoot_RefillBins_BothCompartments()
	}
}

RandomizeResult function RandomizeLootBins( array<entity> allLootBins, int goal )
{
	RandomizeResult result
	array<entity> distributedBins
	int lootBinCount = allLootBins.len()
	if ( lootBinCount == 0 )
		return result

	allLootBins.randomize()
	array<entity> nonDistributedBins

	array<vector> respawnBeaconLocations = GetRespawnBeaconLocations()

	float exclusionDistance = LootBin_Randomization_ExclusionDistance()
	float respawnBeaconExclusionDistance = LootBin_Randomization_RespawnBeaconExclusionDistance()

	float fallBackExclusionDistance = LootBin_Randomization_FallBackExclusionDistance()

	if ( lootBinCount >= goal )
	{
		distributedBins.append( allLootBins[0] )
		allLootBins.fastremove( 0 )
		for ( int i = 0; i < goal - 1; i++ )
		{
			for ( int j = 0; j < allLootBins.len(); j++ )
			{
				vector binPos = allLootBins[j].GetOrigin()
				bool isDistributed = true
				foreach ( distributedBin in distributedBins )
				{
					if ( DistanceSqr( binPos, distributedBin.GetOrigin() ) < ( exclusionDistance  * exclusionDistance ) )
					{
						isDistributed = false
						break
					}
				}

				if( isDistributed )
				{
					foreach( respawnBeaconPos in respawnBeaconLocations )
					{
						if( DistanceSqr( respawnBeaconPos, binPos ) < ( respawnBeaconExclusionDistance  * respawnBeaconExclusionDistance ) )
						{
							isDistributed = false
							break
						}
					}
				}

				if ( isDistributed )
				{
					distributedBins.append( allLootBins[j] )
					allLootBins.fastremove( j )
					j--
					break
				}
				else
				{
					nonDistributedBins.append( allLootBins[j] )
					allLootBins.fastremove( j )
					j--
				}
			}
		}

		int validSpotsFound = distributedBins.len()
		if ( validSpotsFound < goal )
		{
			//do another exclusion distance pass, but this time with a exclusion distance half the size.
			for ( int i = 0; i < nonDistributedBins.len(); i++ )
			{
				entity currentBin =  nonDistributedBins[i]
				vector binPos = currentBin.GetOrigin()

				bool canBeDistributed = true

				foreach ( distributedBin in distributedBins )
				{
					if ( DistanceSqr( binPos, distributedBin.GetOrigin() ) < ( fallBackExclusionDistance  * fallBackExclusionDistance ) )
					{
						canBeDistributed = false
						break
					}
				}

				if( canBeDistributed )
				{
					distributedBins.append( nonDistributedBins[i] )
					nonDistributedBins.fastremove( i )
					validSpotsFound++
				}

				if( validSpotsFound == goal )
					break
			}

			//if you are STILL short of the valid spots after loosing the exclsuion rules, then add bins that are left over in a random way.
			//this is a hard fail over to find good spots for special bins.
			if( validSpotsFound < goal )
			{
				for ( int i = 0; i < goal - validSpotsFound; i++ )
				{
					int currentBinIndex = RandomInt( nonDistributedBins.len() )

					distributedBins.append( nonDistributedBins[currentBinIndex] )
					nonDistributedBins.fastremove( currentBinIndex )
				}
			}
		}
	}
	result.chosenBins = distributedBins
	result.unchosenBins = allLootBins
	result.unchosenBins.extend( nonDistributedBins )
	return result
}

      

void function LootBin_TransferLootBinServerData( entity oldBin, entity newBin, int compartment )
{
	LootBinServerData lbsd = file.lootBinServerDataMap[oldBin]
	if ( newBin in file.lootBinServerDataMap )
	{
		if ( compartment == eLootBinCompartment.REGULAR )
		{
			file.lootBinServerDataMap[newBin].delayedRegularLoot = lbsd.delayedRegularLoot
		}
		else if ( compartment == eLootBinCompartment.SECRET )
		{
			file.lootBinServerDataMap[newBin].delayedSecretLoot = lbsd.delayedSecretLoot
		}
		else if ( compartment == eLootBinCompartment.BOTH )
		{
			file.lootBinServerDataMap[newBin] <- lbsd
		}
	}
	else
	{
		file.lootBinServerDataMap[newBin] <- lbsd
	}
}
void function LootBin_DeleteLootBin ( entity bin )
{
	delete (file.lootBinServerDataMap[bin])
	bin.Destroy()
}
#endif


#if SERVER && DEVELOPER
void function DEV_TakeMeToAnUnopenedLootBin( bool withSecretCompartment, string withLoot = "" )
{
	foreach ( entity lootBin in GetAllLootBins() )
	{
		if ( GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
			continue

		if ( withSecretCompartment && (!CanAccessSecretCompartments( lootBin, null ) || GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )) )
			continue

		if ( withLoot != "" )
		{
			LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
			array<LootRef> lootRefs
			lootRefs.extend( lbsd.delayedRegularLoot )
			lootRefs.extend( lbsd.delayedSecretLoot )
			foreach ( entity lootEnt in LootBin_GetSpawnedLoot( lootBin, true, true ) )
				lootRefs.append( SURVIVAL_CreateLootRef( SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() ), lootEnt ) )

			bool found = false
			foreach ( LootRef ref in lootRefs )
			{
				if ( ref.lootData.ref.find( withLoot ) != -1 )
				{
					found = true
					break
				}
			}
			if ( !found )
				continue
		}

		GP().SetOrigin( OriginToGround( lootBin.GetOrigin() + 100.0 * lootBin.GetForwardVector() + 50.0 * lootBin.GetUpVector() ) + <0, 0, 8> )
		GP().SetAngles( VectorToAngles( lootBin.GetWorldSpaceCenter() - GP().EyePosition() ) )
		printt( "Lootbin pos:", lootBin.GetOrigin() )
		break
	}
}

void function DEV_TakeMeToAnUnopenedCrowdedLootBin( bool withSecretCompartment )
{
	foreach ( entity lootBin in GetAllLootBins() )
	{
		if ( GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN ) )
			continue

		if ( withSecretCompartment && (!CanAccessSecretCompartments( lootBin, null ) || GradeFlagsHas( lootBin, eGradeFlags.IS_OPEN_SECRET )) )
			continue

		if ( DEV_GetItemCountForLootBin( lootBin, false ) <= 5 )
			continue

		GP().SetOrigin( OriginToGround( lootBin.GetOrigin() + 100.0 * lootBin.GetForwardVector() + 50.0 * lootBin.GetUpVector() ) + <0, 0, 8> )
		GP().SetAngles( VectorToAngles( lootBin.GetWorldSpaceCenter() - GP().EyePosition() ) )
		printt( "Lootbin pos:", lootBin.GetOrigin() )
		break
	}
}
void function DEV_GetLootBinItemCounts()
{
	int binCount = 0
	foreach ( entity lootBin in GetAllLootBins() )
	{
		binCount++
		int lootCount = DEV_GetItemCountForLootBin( lootBin, false )
		printt("Bin " + binCount + " contains: " + lootCount )
	}
}

int function DEV_GetItemCountForLootBin( entity lootBin, bool includeSecret, bool printResults = false)
{
	LootBinServerData lbsd = file.lootBinServerDataMap[lootBin]
	array<LootRef> lootRefs
	array<LootRef> refObjectsToRemove
	lootRefs.extend( lbsd.delayedRegularLoot )
	if( includeSecret )
		lootRefs.extend( lbsd.delayedSecretLoot )

	foreach ( lRef in lootRefs )
	{
		if ( lRef.lootData.index <= 0 )
			refObjectsToRemove.append( lRef )
	}

	foreach ( removeCandidate in refObjectsToRemove )
		lootRefs.fastremovebyvalue( removeCandidate )

	if ( printResults )
	{
		foreach ( lRef in lootRefs )
			printt( lRef.lootData.ref )
	}

	return lootRefs.len()
}

