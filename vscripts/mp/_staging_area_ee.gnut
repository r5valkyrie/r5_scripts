	Assert( IsValid(player), "Player is not valid!" )

	int realm = player.GetRealms()[0]
	if ( realm in file.yellowNessieConditionsPerRealm )
	{
		file.yellowNessieConditionsPerRealm[realm].usedChargeTower = true
		Signal( RealmInfoEntity_Get( realm ), "nessies_used_charge_tower" )
	}
}

void function FR_Nessie_OnUseZipline( entity player, entity ziprail)
{
	if ( IsNessieDisabled( NessieSkinIndexes.YELLOW_NESSIE ) )
