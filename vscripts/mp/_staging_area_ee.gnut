void function Staging_Area_EE_Init()
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return
	                  
		PrecacheModel( ROCK_MDL )
		PrecacheModel( NESSIE_BALLOON_MDL )
		PrecacheModel( NESSY_MDL )

		RegisterSignal( "nessies_reset" )
		RegisterSignal( "nessie_dropped" )
		RegisterSignal( "nessie_collected" )
		RegisterSignal( "nessies_dummies_killed" )
		RegisterSignal( "nessies_knife_lob_shot" )
		RegisterSignal( "nessies_tour_complete" )
		RegisterSignal( "nessies_rode_ziprail" )
		RegisterSignal( "nessies_used_charge_tower" )
		RegisterSignal( "nessies_used_vending_machine" )

		RegisterSignal( "blue_nessie_quest_completed" )

		RegisterSignal( "nessies_completed_red_challenges" )

		RegisterSignal( "moy_nessie_steps_complete" )

		RegisterSignal( "purple_nessie_steps_complete" )

		Loot_AddCallback_OnLootSpawn( OnLootSpawn )
		AddCallback_GameStateEnter( eGameState.WaitingForPlayers, OnEnterWaitingForPlayers )

		AddCallback_ZiplineMount ( FR_Nessie_OnUseZipline )

		AddSpawnCallback_ScriptName( "nfx_loch_point", FR_Nessie_InfoTargetSpawn )

		if ( !GetCurrentPlaylistVarBool("fr_nessies_balloons_disabled", false) )
		{
			AddSpawnCallback_ScriptName( REDEPLOY_BALLOON_INFLATABLE_SCRIPT_NAME, FR_Nessie_RedeployBalloonSpawn )
		}

                               
                                              
        

		PrecacheScriptString(NESSIE_BALLOON_SCRIPTNAME)

		PrecacheEffect( $"P_impact_dpod_default" )
		PrecacheEffect( $"droppod_trail" )

                               
                              
        
		BlueNessieWeaponsInit()
		MoyNessieInit()
       

	if ( GetCurrentPlaylistVarBool( "survival_staging_high_point_enabled", true ) )
	{
		thread HighPointMonitor_Thread()
	}
}


void function OnEnterWaitingForPlayers()
{
	Loot_AddCallback_OnPlayerLootPickup( OnPlayerLootPickedUp )
}

                  
bool function IsNessieDisabled( int nessie )
{
	if ( GetCurrentPlaylistVarBool("fr_nessies_disabled", false) )
		return true

	if ( nessie == -1 )
		return false

	switch( nessie )
	{
		case NessieSkinIndexes.GREEN_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_green_disabled", false)
		case NessieSkinIndexes.YELLOW_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_yellow_disabled", false)
		case NessieSkinIndexes.PINK_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_pink_disabled", false)
		case NessieSkinIndexes.TURQUOISE_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_turquoise_disabled", false)
		case NessieSkinIndexes.BLUE_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_blue_disabled", false)
		case NessieSkinIndexes.RED_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_red_disabled", false)
		case NessieSkinIndexes.MOY_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_moy_disabled", false)
		case NessieSkinIndexes.LARGE_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_large_disabled", false)
		case NessieSkinIndexes.PURPLE_NESSIE:
			return GetCurrentPlaylistVarBool("fr_nessies_purple_disabled", false)
                             
      
	}

	return true
}

void function FR_ManageNessiesForRealm( int realm )
{
	if ( IsNessieDisabled( -1 ) )
		return

	if ( realm in file.nessiesPerRealm )
	{
		//we're already setup, no need to setup again
		return
	}

	printf("FIRING RANGE NESSIES - Init for realm " + realm )

	file.nessiesPerRealm[realm] <- []
	file.nessieBalloonsPerRealm[realm] <- []

                              
                                          
       

	SpawnGreenNessies( realm )
	thread PinkNessieSpawnMonitor_Thread( realm )
	thread YellowNessieSpawnMonitor_Thread( realm )
	thread TurquoiseNessieSpawnMonitor_Thread( realm )
	thread BlueNessieSpawnMonitor_Thread( realm )
	thread RedNessieSpawnMonitor_Thread( realm )
	thread MoyNessieSpawnMonitor_Thread( realm )
	thread PurpleNessieSpawnMonitor_Thread( realm )

	SpawnLargeNessies( realm ) //moving Large Nessie's location for S21

                              
                                         
       
}

void function FR_CleanupNessieForRealm( int realm )
{
	if ( IsNessieDisabled( -1 ) )
		return

	printf("FIRING RANGE NESSIES - Cleanup for realm " + realm )
	if ( !(realm in file.nessiesPerRealm) )
	{
		#if DEVELOPER
			Assert( false, "Trying to reset nessies in a realm that wasn't setup!" )
		#endif
		return
	}

	{//nessies
		foreach ( entity nessie in file.nessiesPerRealm[realm] )
		{
			if ( !IsValid( nessie ) )
				continue

			nessie.Destroy()
		}
		delete file.nessiesPerRealm[realm]
	}

                              
                    
                                                               
   
                          
            

                 
   
                                           
  
       

	{//nessie ballons
		foreach ( entity balloon in file.nessieBalloonsPerRealm[realm] )
		{
			if ( !IsValid( balloon ) )
				continue

			balloon.Destroy()
		}
		delete file.nessieBalloonsPerRealm[realm]
	}

	Signal( RealmInfoEntity_Get( realm ), "nessies_reset" )
}

void function SpawnGreenNessies( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.GREEN_NESSIE ) )
		return

	foreach ( Coord loc in file.greenNessieLocations )
	{
		FR_SpawnNessie( realm, loc.pos, loc.ang, NessieSkinIndexes.GREEN_NESSIE )
	}
}

void function SpawnLargeNessies( int realm )
{
	FR_SpawnNessie( realm, <-7595.1875, 7236.125, 2464.20044>, <0, 69.3456955, 0>, NessieSkinIndexes.LARGE_NESSIE )
}

void function PinkNessieSpawnMonitor_Thread( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.PINK_NESSIE ) )
		return

	EndSignal( RealmInfoEntity_Get( realm ), "nessies_reset" )

	file.dummieKillsPerRealm[realm] <- 0

	WaitSignal( RealmInfoEntity_Get( realm ), "nessies_dummies_killed" )

	vector pinkNessieSpawnLocation = <-4013.84375, 512.40625, 1408.74902>
	vector pinkNessieSpawnAngles   = <-0.131835938, -178.725571, 0>
	FR_SpawnNessie( realm, pinkNessieSpawnLocation, pinkNessieSpawnAngles, NessieSkinIndexes.PINK_NESSIE )
}

void function YellowNessieSpawnMonitor_Thread( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.YELLOW_NESSIE ) )
		return

	EndSignal( RealmInfoEntity_Get( realm ), "nessies_reset" )
	//5 min
	float endTime = Time() + GetCurrentPlaylistVarInt("fr_hangout_time", (5*60) )

	YellowNessieConditionTracker conditionTracker
	file.yellowNessieConditionsPerRealm[realm] <- conditionTracker

	if ( !conditionTracker.rodeZiprail )
	{
		WaitSignal( RealmInfoEntity_Get( realm ), "nessies_rode_ziprail" )
	}

	if ( !conditionTracker.usedChargeTower )
	{
		WaitSignal( RealmInfoEntity_Get( realm ), "nessies_used_charge_tower" )
	}

	if ( !conditionTracker.usedVendingMachine )
	{
		WaitSignal( RealmInfoEntity_Get( realm ), "nessies_used_vending_machine" )
	}

	while ( !conditionTracker.didSkydive )
	{
		wait 1
		foreach( entity player in GetAllPlayersByRealm( realm ) )
		{
			if ( player.p.survivalLandedOnGround )
			{
				conditionTracker.didSkydive = true
				break
			}
		}
	}

	if ( conditionTracker.visitedZones.len() < 5 )
	{
		WaitSignal( RealmInfoEntity_Get( realm ), "nessies_tour_complete" )
	}

	if ( Time() < endTime )
	{
		wait (endTime - Time())
	}

	vector yellowNessieSpawnLocation = <-12013.25, 247.6875, 1581.85303>
	vector yellowNessieSpawnAngles = <0.48337695, 123.618164, 0>
	FR_SpawnNessie( realm, yellowNessieSpawnLocation, yellowNessieSpawnAngles, NessieSkinIndexes.YELLOW_NESSIE )
}

void function TurquoiseNessieSpawnMonitor_Thread( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.TURQUOISE_NESSIE ) )
