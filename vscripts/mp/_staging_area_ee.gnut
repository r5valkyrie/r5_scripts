		if ( realm in file.yellowNessieConditionsPerRealm )
		{
			file.yellowNessieConditionsPerRealm[realm].rodeZiprail = true
			Signal( RealmInfoEntity_Get( realm ), "nessies_rode_ziprail" )
		}
	}
}


void function FR_Nessie_OnUseVendingMachine( entity player )
{
	if ( IsNessieDisabled( NessieSkinIndexes.YELLOW_NESSIE ) )
		return

	Assert( IsValid(player), "Player is not valid!" )

	int realm = player.GetRealms()[0]
	if ( realm in file.yellowNessieConditionsPerRealm )
	{
		file.yellowNessieConditionsPerRealm[realm].usedVendingMachine = true
		Signal( RealmInfoEntity_Get( realm ), "nessies_used_vending_machine" )
	}
}


void function FR_Nessie_CheckCurrentWeapons( entity player )
{
	if ( !IsValid( player ) )
		return

	entity weapon1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
	entity weapon2 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
	entity weapon3 = GetPlayerSlingWeapon( player )

	if ( !IsValid( weapon1 ) || !IsValid( weapon2 ) || !IsValid( weapon3 ) )
	{
		if ( player in file.playerHasRedNessieWeapons )
		{
			file.playerHasRedNessieWeapons[ player ] = false
		}
		return
	}

	bool hasRWeapon = R_WEAPONS.contains( weapon1.GetWeaponBaseClassName() ) || R_WEAPONS.contains( weapon2.GetWeaponBaseClassName() ) || R_WEAPONS.contains( weapon3.GetWeaponBaseClassName() )
	bool hasEWeapon = E_WEAPONS.contains( weapon1.GetWeaponBaseClassName() ) || E_WEAPONS.contains( weapon2.GetWeaponBaseClassName() ) || E_WEAPONS.contains( weapon3.GetWeaponBaseClassName() )
	bool hasDWeapon = D_WEAPONS.contains( weapon1.GetWeaponBaseClassName() ) || D_WEAPONS.contains( weapon2.GetWeaponBaseClassName() ) || D_WEAPONS.contains( weapon3.GetWeaponBaseClassName() )

	if ( hasRWeapon && hasEWeapon && hasDWeapon )
	{
		int realm = player.GetRealms()[0]
		if ( !( player in file.playerHasRedNessieWeapons )  )
		{
			file.playerHasRedNessieWeapons[ player ] <- true

			Assert( realm in file.redNessieStepTrackerPerRealm, "The realm needs to already be in the tracked red nessie realms" )

			// Set the first step complete as long as no one has completed it yet
			if ( file.redNessieStepTrackerPerRealm[ realm ] == 0 )
			{
				// Play the success audio after a second so that it doesn't overlap with the sound from killing dummies
				thread function() : ( realm )
				{
					wait 0.25
					EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
				}()

				file.redNessieStepTrackerPerRealm[ realm ] = 1
			}
		}

		if ( !file.playerHasRedNessieWeapons[ player ] )
		{
			if ( GetCurrentPlaylistVarBool( "fr_nessies_play_red_audio_on_all_pickups", true ) )
			{
				thread function() : ( realm )
				{
					wait 0.25
					EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
				}()
			}

			file.playerHasRedNessieWeapons[ player ] = true
		}
	}
	else if ( player in file.playerHasRedNessieWeapons )
	{
		file.playerHasRedNessieWeapons[ player ] = false
	}
}


array< string > function FR_Nessie_GetRedNessieWeapons()
{
	array< string > refs
	if ( FR_Nessie_FlipRedNessieWeapons() )
	{
		refs.extend( R_WEAPONS )
		refs.extend( E_WEAPONS )
		refs.extend( D_WEAPONS )
	}

	return refs
}

void function FR_Nessie_OnQuipUsed( entity player )
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return

	if ( IsNessieDisabled( NessieSkinIndexes.MOY_NESSIE ) )
		return

	Assert( IsValid( player ), "Player is not valid!" )

	MoyNessieConditionTracker tracker
	int realm = player.GetRealms()[0]

	if ( !(realm in file.moyNessieConditionsPerRealm) ) //this can happen in training
		return

	tracker = file.moyNessieConditionsPerRealm[realm]

	ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )
	string characterRef  = ItemFlavor_GetCharacterRef( character ).tolower()

	foreach ( string legendName in file.moyNessieLegends )
	{
		if ( characterRef == legendName )
		{
			if ( !tracker.legendsUsed.contains( characterRef ) )
			{
				tracker.legendsUsed.append( characterRef )
			}
			break
		}
	}

	if ( tracker.legendsUsed.len() == file.moyNessieLegends.len() )
	{
		Signal( RealmInfoEntity_Get( realm ), "moy_nessie_steps_complete" )  // Nessie Unlocked
	}
}

void function FR_Nessie_OnVoidNexusUsed( entity player, vector portalOrigin )
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return

	if ( IsNessieDisabled( NessieSkinIndexes.PURPLE_NESSIE ) )
		return

	Assert( IsValid( player ), "Player is not valid!" )

	PurpleNessieConditionTracker tracker
	int realm = player.GetRealms()[0]

	tracker = file.purpleNessieConditionsPerRealm[realm]

	int numberOfNessies = 0
	array<ConsumableInventoryItem> playerInventory = SURVIVAL_GetPlayerInventory( player )

	foreach ( ConsumableInventoryItem invItem in playerInventory )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( invItem.type )

		if ( FR_IsNessie( data ) )
			numberOfNessies++
	}

	if ( numberOfNessies == 16 && tracker.nessieArmyComplete == false ) //number of slots in puple/gold bag
	{
		Signal( RealmInfoEntity_Get( realm ), "purple_nessie_steps_complete" )  // Nessie Unlocked Sound
		tracker.nessieArmyComplete = true

		FR_SpawnNessie( realm, portalOrigin, < 0 ,0 ,0 >, NessieSkinIndexes.PURPLE_NESSIE )
	}
}

bool function FR_IsNessie( LootData data )
{
	if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
		return true

	return false
}

entity function FR_SpawnNessie( int realm, vector origin, vector angles, int skinOverride )
{
	string lootRef = "fr_nessie"

	switch ( skinOverride )
	{
		case NessieSkinIndexes.GREEN_NESSIE:
			lootRef = "fr_nessie"
			break
		case NessieSkinIndexes.YELLOW_NESSIE:
			lootRef = "fr_nessie_yellow"
			break
		case NessieSkinIndexes.PINK_NESSIE:
			lootRef = "fr_nessie_pink"
			break
		case NessieSkinIndexes.TURQUOISE_NESSIE:
			lootRef = "fr_nessie_turquoise"
			break
		case NessieSkinIndexes.BLUE_NESSIE:
			lootRef = "fr_nessie_blue"
			break
		case NessieSkinIndexes.RED_NESSIE:
			lootRef = "fr_nessie_red"
			break
		case NessieSkinIndexes.MOY_NESSIE:
			lootRef = "fr_nessie_moy"
			break
		case NessieSkinIndexes.LARGE_NESSIE:
			lootRef = "fr_nessie_large"
			break
		case NessieSkinIndexes.PURPLE_NESSIE:
			lootRef = "fr_nessie_lavender"
			break
                             
      
		default:
			Assert(false)
	}

	//printf("FIRING RANGE NESSIES - Spawing " + lootRef)
	entity lootEnt = SpawnGenericLoot( lootRef, origin, angles, 1 )
	lootEnt.SetNetworkDistanceCull( false )
	lootEnt.RemoveFromAllRealms()
	lootEnt.AddToRealm( realm )
	file.nessiesPerRealm[realm].append( lootEnt )

	return lootEnt
}

                             
                                         
 
                                                                  
        

                      

  
                   
                   
                       
                    
                                               
  

 
      

