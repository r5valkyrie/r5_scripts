void function BlueNessieSpawnMonitor_Thread( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.BLUE_NESSIE ) )
		return

	EndSignal( RealmInfoEntity_Get( realm ), "nessies_reset" )

	BlueNessieConditionTracker tracker
	file.blueNessieConditionsPerRealm[realm] <- tracker

	WaitSignal( RealmInfoEntity_Get( realm ), "blue_nessie_quest_completed" )

	thread BlueNessieSpawnSequenceThread(realm)
}

