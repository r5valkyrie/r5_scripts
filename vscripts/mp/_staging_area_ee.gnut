	vector turquoiseNessieSpawnAngles = <0, 179.824219, 0>
	FR_SpawnNessie( realm, turquoiseNessieSpawnLocation, turquoiseNessieSpawnAngles, NessieSkinIndexes.TURQUOISE_NESSIE )
}

void function BlueNessieSpawnSequenceThread( int realm )
{
	EndSignal( RealmInfoEntity_Get( realm ), "nessies_reset" )
	vector start = <-5777.322754, 511.766510, 196.031250>
	vector path = start + <0, 0, 18000>
	vector angles = <-6.116994, -179.801102, 0.000000>

	entity mover = CreateScriptMover( "blue_nessie_spawn_mover", path, angles )

	OnThreadEnd(
		function () : ( mover, start )
		{
			if ( IsValid( mover ) )
			{
				mover.Destroy()
			}

			//StopSoundAtPosition( start, "Survival_LootPod_Beacon_Marker" )
		}
	)

	int fxId = GetParticleSystemIndex( $"droppod_trail" )
	StartParticleEffectOnEntity( mover, fxId, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )

	const string SOUND_CARE_PACKAGE_LAND = "Survival_LootPod_Impact"

	EmitSoundOnEntity( mover, "Survival_LootPod_Launch" )
	//EmitSoundOnEntity( mover, "Survival_LootPod_SteamSizzle" )
	//EmitSoundOnEntity( mover, "Survival_LootPod_Incoming" )

	float dropTime = 5
	mover.NonPhysicsMoveTo( start, dropTime, 0, 0 )

	//EmitSoundAtPosition( TEAM_UNASSIGNED, start, "Survival_LootPod_Beacon_Marker", mover )

	wait dropTime

	entity nessie = FR_SpawnNessie( realm, start, angles, NessieSkinIndexes.BLUE_NESSIE )

	StartParticleEffectInWorld( GetParticleSystemIndex( $"P_impact_dpod_default" ), start, angles )
	EmitSoundAtPosition( TEAM_UNASSIGNED, start, SOUND_CARE_PACKAGE_LAND, nessie )
	CreateShake( start, 7, 0.15, 1.75, 768 )

	PlayImpactFXTable( start, nessie, "droppod_impact" )
}

void function RedNessieSpawnMonitor_Thread( int realm )
{
	if ( IsNessieDisabled( NessieSkinIndexes.RED_NESSIE ) )
		return

	EndSignal( RealmInfoEntity_Get( realm ), "nessies_reset" )

	file.redNessieStepTrackerPerRealm[realm] <- 0

	WaitSignal( RealmInfoEntity_Get( realm ), "nessies_completed_red_challenges" )

	vector redNessieDummieSpawnLocation = < 2985.666748, 1065.594727, 132.623962 >
	vector redNessieDummieSpawnAngles = < 0, -177.769180, 0.000000 >
	entity nessieDummie = SpawnNPCTrainingDummy( redNessieDummieSpawnLocation, redNessieDummieSpawnAngles, 5, true )
	nessieDummie.RemoveFromAllRealms()
	nessieDummie.AddToRealm( realm )
	//nessieDummie.SetNetworkDistanceCullEnabled( false )

	vector redNessieSpawnLocation = < 3448, 759, 340 >
	vector redNessieSpawnAngles =  < 0, -177.769180, 0.000000 >
	entity nessie = FR_SpawnNessie( realm, redNessieSpawnLocation, redNessieSpawnAngles, NessieSkinIndexes.RED_NESSIE )
	nessie.SetParent( nessieDummie, "HEADSHOT" )
}

void function FR_Nessie_OnDummyKilled( entity player, entity dummie )
{
	if ( IsNessieDisabled( NessieSkinIndexes.PINK_NESSIE ) && IsNessieDisabled( NessieSkinIndexes.RED_NESSIE ) )
		return

	Assert( IsValid( player ), "player is not valid!" )
	Assert( IsValid( dummie ), "dummie is not valid!" )

	if ( !player.IsPlayer() )
		return

	int realm = player.GetRealms()[0]

	if ( realm in file.dummieKillsPerRealm )
	{
		int dummiesKilled = file.dummieKillsPerRealm[realm]
		if ( dummiesKilled == (GetCurrentPlaylistVarInt("fr_dummie_kill_threashold", 100 ) - 1) )
		{
			Signal( RealmInfoEntity_Get( realm ), "nessies_dummies_killed" )
		}
		file.dummieKillsPerRealm[realm] = dummiesKilled + 1
	}

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	if ( realm in file.redNessieStepTrackerPerRealm && IsValid( activeWeapon ) &&
			player in file.playerHasRedNessieWeapons && file.playerHasRedNessieWeapons[ player ] )
	{
		int step = file.redNessieStepTrackerPerRealm[ realm ]
		string activeWeaponName = activeWeapon.GetWeaponBaseClassName()
		switch( step )
		{
			case 0:
				break
			case 1:
				if ( !IsValid( player.GetGroundEntity() ) && !player.IsZiplining() )
				{
					foreach ( baseWeapon in R_WEAPONS )
					{
						if ( activeWeaponName.find( baseWeapon ) > -1 )
						{
							// Play the success audio after a second so that it doesn't overlap with the sound from killing dummies
							thread function() : ( realm )
							{
								wait 0.25
								EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
							}()

							file.redNessieStepTrackerPerRealm[ realm ] = 2
							break
						}
					}
				}
				break
			case 2:
				if ( DistanceSqr( dummie.GetOrigin(), player.GetOrigin() ) > E_KILL_DISTANCE_SQR )
				{
					foreach ( baseWeapon in E_WEAPONS )
					{
						if ( activeWeaponName.find( baseWeapon ) > -1 )
						{
							// Play the success audio after a second so that it doesn't overlap with the sound from killing dummies
							thread function() : ( realm )
							{
								wait 0.25
								EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
							}()

							file.redNessieStepTrackerPerRealm[ realm ] = 3
							break
						}
					}
				}
				break
			case 3:
				if ( activeWeapon.GetWeaponPrimaryClipCount() == 0 && ( !FR_Nessie_Red_Dropship_Location_Enabled() ||
						 DistanceSqr( DROPSHIP_POSITION, player.GetOrigin() ) < MAX_DROPSHIP_DISTANCE_SQR ) )
				{
					foreach ( baseWeapon in D_WEAPONS )
					{
						if ( activeWeaponName.find( baseWeapon ) > -1 )
						{
							// Play the success audio after a second so that it doesn't overlap with the sound from killing dummies
							thread function() : ( realm )
							{
								wait 0.25
								EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
							}()

							file.redNessieStepTrackerPerRealm[ realm ] = 4
							Signal( RealmInfoEntity_Get( realm ), "nessies_completed_red_challenges" )

							break
						}
					}
				}
				break
			default:
				break
		}
	}
}

void function FR_Nessie_OnDamagedEntity( entity ent, var damageInfo )
{
	if ( IsNessieDisabled( NessieSkinIndexes.BLUE_NESSIE ) )
		return

	if ( !IsValid( ent ) )
		return

	if ( DamageInfo_GetDamage( damageInfo ) <= 0 )
		return

	int hitGroup = DamageInfo_GetHitGroup( damageInfo )

	if (hitGroup != HITGROUP_HEAD )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )
	table data
	data["attacker"] <- attacker
	data["hitgroup"] <- hitGroup

	if ( !IsValid(attacker) )
		return

	int realm = attacker.GetRealms()[0]
	entity weapon = DamageInfo_GetWeapon( damageInfo )

	if ( !IsValid( weapon ) )
		return

	string weaponName = weapon.GetWeaponBaseClassName()
	array<string> currentStepArray

	BlueNessieConditionTracker tracker

	if ( !(realm in file.blueNessieConditionsPerRealm) )
	{
		//this can happen in training
		return
	}

	tracker = file.blueNessieConditionsPerRealm[realm]

	int currentStep =  tracker.currentStep

	if ( currentStep >= 3 )
		return

	if (currentStep == 0)
		currentStepArray = file.blueNessieWeaponsStep1
	else if (currentStep == 1)
		currentStepArray = file.blueNessieWeaponsStep2
	else if (currentStep == 2)
		currentStepArray = file.blueNessieWeaponsStep3
	else
	{
		Assert( false, "Doing too many steps! this shouldn't happen" )
		return
	}

	bool legalWeaponHit = false

	//Check your current steps weapon array
	foreach ( string baseWeaponName in currentStepArray )
	{
		if ( weaponName.find( baseWeaponName ) > -1 )
		{
			legalWeaponHit = true
			if ( !tracker.currentWeaponsBullseyed.contains( weaponName ) )
				tracker.currentWeaponsBullseyed.append( weaponName ) // add it to the bullseyed array

			break
		}
	}

	// If you hit a bullseye on a weapon that is NOT in your current array
	if ( !legalWeaponHit )
		tracker.currentWeaponsBullseyed.clear()  // reset your current progress

	if ( tracker.currentWeaponsBullseyed.len() == currentStepArray.len() )
	{
		// Advance step and clear your array
		tracker.currentStep++
		tracker.currentWeaponsBullseyed.clear()

		// Play the success audio after a second so that it doesn't overlap with the sound from killing dummies
		thread function() : ( realm )
		{
			wait 0.25
			EmitSoundToPlayersInRealm( "UI_CTF_1P_GrabFlag", realm )
		}()
	}

	// if we make it to step 3
	if ( tracker.currentStep == 3)
		Signal( RealmInfoEntity_Get( realm ), "blue_nessie_quest_completed" )  // Nessie Unlocked

}

void function FR_Nessie_DidKnifeLobShot( entity dummie )
{
	if ( IsNessieDisabled( NessieSkinIndexes.TURQUOISE_NESSIE ) )
		return

	Assert( IsValid(dummie), "dummie is not valid!" )

	int realm = dummie.GetRealms()[0]

	Signal( RealmInfoEntity_Get( realm ), "nessies_knife_lob_shot" )
}

void function FR_Nessie_InfoTargetSpawn( entity spawnPoint )
{
	Coord loc
	loc.pos = spawnPoint.GetOrigin()
	loc.ang = spawnPoint.GetAngles()

	file.greenNessieLocations.append( loc )

	spawnPoint.Destroy()
}

void function FR_Nessie_EnterZone( entity player, int zoneID )
{
	if ( IsNessieDisabled( NessieSkinIndexes.YELLOW_NESSIE ) )
		return

	Assert( IsValid(player), "Player is not valid!" )

	int realm = player.GetRealms()[0]

	#if DEVELOPER
		printf("FIRING RANGE ZONE: " + zoneID)
	#endif
	//tunnel 1
	//pit =3
	//mountain 5
	//town tower 6
	//raven's nest 8

	array<int> validZones = [1, 3, 5, 6, 8]
	if ( validZones.contains(zoneID) )
	{
		if ( realm in file.yellowNessieConditionsPerRealm )
		{
			if ( !file.yellowNessieConditionsPerRealm[realm].visitedZones.contains( zoneID ) )
			{
				file.yellowNessieConditionsPerRealm[realm].visitedZones.append( zoneID )

				if ( file.yellowNessieConditionsPerRealm[realm].visitedZones.len() >= 5 )
				{
					Signal( RealmInfoEntity_Get( realm ), "nessies_tour_complete" )
				}
			}
		}
	}
}

void function FR_Nessie_OnUseChargeTower( entity player )
{
	if ( IsNessieDisabled( NessieSkinIndexes.YELLOW_NESSIE ) )
