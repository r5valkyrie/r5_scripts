}

                             
                                                  
 
                                                                  
        

                                                           

                                  
                                                   

               
  
                                                                

                                      
                                                        
   
                                                                   
    
                                    
         
    
   

                                 
        
  

                                                             
  
                                                                                                                                                                          
                                                   

               
   
                                                               

                               
                                
    
                                                                                             
     
                             
          
     
    

                          
         
   
  



                             
              
  
                                                                       
   
                                                                      
    
                            
         
    
   

                         
   
                                                                                                   
                                 
    
                                                   
          
    

            

                                                                 
   
      
   
                                                            
   

                                                              
  

                                       
                                                                                                             
                                                                   
 

                                                
 
                                                                      

                                                    
                                                      
                                    
                                                                                
                            
                      
                                              

                                                                      
                          

                                                             
                                                                     
                                                                        
          

          
                                        
         
                                              
                                                                          
           
                                                                   
                                                                
         
                

                                                                                    
                                                                                                      
                                                                               
                                                  
            
                                                 
            
                                                                                
                                                  
            
                  
 
      

void function FR_Nessie_RedeployBalloonSpawn( entity redeployBalloon )
{
	Assert( !GetCurrentPlaylistVarBool("fr_nessies_balloons_disabled", false) )

	thread RedeployBallonSpawned_Thread( redeployBalloon )
}

void function RedeployBallonSpawned_Thread( entity redeployBalloon )
{
	EndSignal( redeployBalloon, "OnDestroy" )

	wait 0.5

	int realm = redeployBalloon.GetRealms()[0]

	array<entity> nessies
	const float maxDist = 100
	const float maxFacingAngle = 30
	vector groundPos = redeployBalloon.GetOrigin() - <0,0, RedeployBalloon_GetHeight()>
	vector nessieBalloonPos = redeployBalloon.GetOrigin() + <0,0,1100>
	vector nessieBalloonAngles = AnglesCompose( redeployBalloon.GetAngles(), <0, 90, 0> )
	int numberOfNessies = NumberOfNessiesInLocationWithFacing( realm, groundPos, maxDist, maxFacingAngle, nessies )

	const int nessieCountRequired = 8
	if ( numberOfNessies < nessieCountRequired )
		return

	const float cos45 = cos(45 * DEG_TO_RAD)
	array< vector > dirsToCheck = [<1,0,0>, <0,1,0>, <-1,0,0>, <0,-1,0>]
	foreach ( vector dir in dirsToCheck )
	{
		bool foundNessie = false
		foreach ( entity nessie in nessies )
		{
			if ( DotProduct( dir, nessie.GetForwardVector() ) >= cos45 )
			{
				foundNessie = true
				break
			}
		}
		if ( !foundNessie )
			return
	}

	const float minSqrDistBetweenBalloons = 1200 * 1200
	for ( int i = 0; i < file.nessieBalloonsPerRealm[realm].len(); i++ )
	{
		entity nessieBalloon = file.nessieBalloonsPerRealm[realm][i]
		if ( !IsValid( nessieBalloon ) )
		{
			Assert( false, "Invalid Nessie Balloon in list!" )
			continue
		}

		if ( DistanceSqr( nessieBalloonPos, nessieBalloon.GetOrigin() ) < minSqrDistBetweenBalloons )
		{
			file.nessieBalloonsPerRealm[realm].remove(i)
			i--

			nessieBalloon.Destroy()
		}
	}

	int maxNessieBalloons = GetCurrentPlaylistVarInt("balloons_max", 10 )
	if ( file.nessieBalloonsPerRealm[realm].len() >= maxNessieBalloons )
	{
		entity nessieBalloon = file.nessieBalloonsPerRealm[realm][0]
		file.nessieBalloonsPerRealm[realm].remove(0)

		if ( IsValid( nessieBalloon ) )
		{
			nessieBalloon.Destroy()
		}
	}

	entity nessieBalloon = CreatePropDynamic( NESSIE_BALLOON_MDL, nessieBalloonPos, nessieBalloonAngles, SOLID_VPHYSICS )
	nessieBalloon.SetScriptName( NESSIE_BALLOON_SCRIPTNAME )
	nessieBalloon.SetOrigin( nessieBalloonPos + (nessieBalloon.GetForwardVector() * 300) )
	//tilts the balloons down a bit
	//nessieBalloon.SetAngles( AnglesCompose( nessieBalloon.GetAngles(), <0, 0, -20> ) )
	SetupDecorativeBalloon( nessieBalloon )
	AddAirdropTraceIgnoreEnt ( nessieBalloon )
	CopyRealmsFromTo( redeployBalloon, nessieBalloon )

	file.nessieBalloonsPerRealm[realm].append( nessieBalloon )
}

bool function CheckIfAnyNessieIsInLocation( int realm, vector location, float maxDist )
{
	return IsValid( GetNessieAtLocation( realm, location, maxDist ) )
}

entity function GetNessieAtLocation( int realm, vector location, float maxDist )
{
	if ( !(realm in file.nessiesPerRealm) )
		return null

	foreach( entity nessie in file.nessiesPerRealm[realm])
	{
		if ( !IsValid( nessie ) )
		{
			Assert( false, "invalid nessie in list!" )
			continue
		}

		if ( Distance( nessie.GetOrigin(), location ) <= maxDist )
			return nessie
	}
	return null
}

int function NumberOfNessiesInLocationWithFacing( int realm, vector location, float maxDist, float toleranceAngle, array<entity> outNessies )
{
	if ( !(realm in file.nessiesPerRealm) )
		return 0

	float toleranceCos = cos( toleranceAngle * DEG_TO_RAD )

	int count = 0
	foreach( entity nessie in file.nessiesPerRealm[realm])
	{
		if ( !IsValid( nessie ) )
		{
			Assert( false, "invalid nessie in list!" )
			continue
		}

		if ( Distance( nessie.GetOrigin(), location ) > maxDist )
			continue

		vector facing = Normalize(FlattenVec(location - nessie.GetOrigin()))
		if ( DotProduct( facing, nessie.GetForwardVector() ) < toleranceCos )
			continue

		outNessies.append( nessie )
		count++
	}

	return count
}

int function GetNessieSkin( entity nessie )
{
	LootData data = SURVIVAL_Loot_GetLootDataByIndex( nessie.GetSurvivalInt() )
	Assert( data.lootType == eLootType.COLLECTABLE_NESSIE )

	return data.skinOverride
}

      

void function OnPlayerLootPickedUp( entity player, entity ent, string ref, int unitsPickedUp, bool willDestroy, entity deathBox, int pickupFlags )
{
	if ( !willDestroy )
		return

	if ( !ent.e.recreateLootOnPickup )
	{
		                  
			LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )
			if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
			{
				int realm = ent.GetRealms()[0]
				if ( !(realm in file.nessiesPerRealm) )
				{
					Assert( false, "Picked up a nessie which wasn't in a tracked realm!" )
					return
				}

				#if DEVELOPER
					printf("FIRING RANGE NESSIES Pickup:" + ent.GetOrigin() + " " + ent.GetAngles() )
				#endif

				Assert( file.nessiesPerRealm[realm].contains( ent ), "Picked up an untracked nessie!!" )

				file.nessiesPerRealm[realm].fastremovebyvalue( ent )

				Signal( RealmInfoEntity_Get( realm ), "nessie_collected" )
			}
        
	}
}

void function OnLootSpawn( entity ent, LootData data, int count )
{
	if ( GetGameState() >= eGameState.Playing )
		return

	EndSignal( ent, "OnDestroy" )

	WaitFrame()

	if ( ent.e.spawnSource != eSpawnSource.PLAYER_DROP )
		return

	entity owner = ent.GetOwner()
	if ( IsValid( owner ) )
	{
		int ownerRealm = GetFiringRangeRealm( owner )

		                  
			if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
			{
				if ( ownerRealm in file.nessiesPerRealm )
				{
					file.nessiesPerRealm[ownerRealm].append( ent )

					thread NessieDroppedSignal_Thread( ownerRealm, ent )
				}
				else
				{
					Assert(false, "Dropped a nessie that wasn't in any realm!")
				}
				return
			}
        
	}

	                  
		Assert( data.lootType != eLootType.COLLECTABLE_NESSIE, "Dropping an nessie that wasn't owned by anyone!" )
       
}

void function NessieDroppedSignal_Thread( int realm, entity nessie )
{
	EndSignal( nessie, "OnDestroy" )

	WaitFrame()

	entity physicsProp = nessie.GetParent()
	if ( IsValid( physicsProp) && physicsProp.GetScriptName() == THROWN_OBJECT_PHYSICS_ENT_SCRIPTNAME )
	{
		WaitSignal( physicsProp, "OnDestroy" )

		Signal( RealmInfoEntity_Get( realm ), "nessie_dropped" )
	}
}

                   
//the top of the flag
const vector HIGH_POINT_POS = <-1211.045532, 5884.230469, 3477.838623>
const float HIGH_POINT_MAX_DIST = 150
const float HIGH_POINT_MAX_Z_DIST = 10
//TLDR, if you climb to the top of the flag when in 3rd person mode, crouch and don't move for some time, this will activate
void function HighPointMonitor_Thread()
{
	array<entity> playersWithThreads

	while (true)
	{
		foreach ( player in GetPlayerArray_AliveConnected() )
		{
			if ( !IsValid( player ) )
				continue

			if ( !player.IsCrouched() )
				continue

			if ( !player.IsThirdPersonShoulderModeOn() )
				continue

			if ( playersWithThreads.contains(player) )
				continue

			vector playerOrigin = player.GetOrigin()
			float zDiff = fabs(playerOrigin.z - HIGH_POINT_POS.z)
			if ( zDiff > HIGH_POINT_MAX_Z_DIST )
				continue

			if ( Distance2DSqr(playerOrigin, HIGH_POINT_POS) > HIGH_POINT_MAX_DIST )
				continue

			playersWithThreads.append( player )
			thread HighPointMonitorPlayer_Thread( player, playersWithThreads )
		}

		wait 0.5
	}
}

void function HighPointMonitorPlayer_Thread( entity player, array<entity> playersWithThreads )
{
	PassByReferenceBool needToClearFlags
	PassByReferenceInt crouchHandle

	OnThreadEnd(
		function () : ( player, playersWithThreads, needToClearFlags, crouchHandle )
		{
			playersWithThreads.fastremovebyvalue( player )

			if ( needToClearFlags.value )
			{
				player.RemoveForcedStance( crouchHandle.value )
				player.MovementEnable()
				player.ClearInvulnerable()
				player.EnableWeaponTypes( WPT_ALL_EXCEPT_VIEWHANDS )
				RemoveCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD_INSTANT )
				RemoveCinematicFlag( player, CE_FLAG_HIDE_PERMANENT_HUD )
				player.PlayerCone_Disable()
			}
		}
	)

	EndSignal( player, "OnDeath", "OnDestroy" )

	vector oldPlayerPosition = player.GetOrigin()
	float lastMoveTime = Time()
	float waitTime = GetCurrentPlaylistVarFloat( "survival_staging_high_point_time", 3 )

	while ( (lastMoveTime + waitTime) > Time() )
	{
		if ( !player.IsCrouched() )
			return

		if ( !player.IsThirdPersonShoulderModeOn() )
			return

		vector newPlayerPosition = player.GetOrigin()
		if ( oldPlayerPosition != newPlayerPosition )
		{
			float zDiff = fabs(newPlayerPosition.z - HIGH_POINT_POS.z)
			if ( zDiff > HIGH_POINT_MAX_Z_DIST )
				return

			if ( Distance2DSqr(newPlayerPosition, HIGH_POINT_POS) > HIGH_POINT_MAX_DIST )
				return

			oldPlayerPosition = newPlayerPosition
			lastMoveTime = Time()
		}

		WaitFrame()
	}

	vector angles = player.CameraAngles()
	Remote_CallFunction_NonReplay( player, "ServerToClient_DoPresentation" )

	needToClearFlags.value = true
	crouchHandle.value = player.PushForcedStance( FORCE_STANCE_CROUCH )
	player.MovementDisable()
	player.SetInvulnerable()
	//player.DisableWeaponTypes( WPT_ALL_EXCEPT_VIEWHANDS )
	AddCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD_INSTANT )
	AddCinematicFlag( player, CE_FLAG_HIDE_PERMANENT_HUD )

	wait .1
	player.PlayerCone_SetSpecific(angles)

	wait 12.4

	player.RemoveForcedStance( crouchHandle.value )
	player.MovementEnable()
	player.ClearInvulnerable()
	player.SetShieldHealth( player.GetShieldHealthMax() )
	player.SetHealth( player.GetMaxHealth() )
	//player.EnableWeaponTypes( WPT_ALL_EXCEPT_VIEWHANDS )
	RemoveCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD_INSTANT )
	RemoveCinematicFlag( player, CE_FLAG_HIDE_PERMANENT_HUD )
	needToClearFlags.value = false
	player.PlayerCone_Disable()

	//wait until the move off the flag to kill the thread, which in turn prevents it starting again
	while ( true )
	{
		vector playerPosition = player.GetOrigin()
		float zDiff = fabs(playerPosition.z - HIGH_POINT_POS.z)
		if ( zDiff > HIGH_POINT_MAX_Z_DIST )
			return

		if ( Distance2DSqr(playerPosition, HIGH_POINT_POS) > HIGH_POINT_MAX_DIST )
			return

		WaitFrame()
	}
}

bool function FR_Nessie_Red_Dropship_Location_Enabled()
{
	return GetCurrentPlaylistVarBool( "nessies_red_dropship_location_enabled", true )
}

bool function FR_Nessie_FlipRedNessieWeapons()
{
	return GetCurrentPlaylistVarBool( "nessies_red_flip_red_weapons", false )
}
      
