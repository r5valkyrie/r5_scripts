// dev function
void function summonplayers()
{
	entity guy                  = GetPlayerArray()[0]
	array<entity> livingPlayers = GetPlayerArray_Alive()
	foreach ( player in livingPlayers )
	{
		if ( player == guy )
			continue
		player.SetOrigin( guy.GetOrigin() )
		player.SetVelocity( RandomVec( 250.0 ) )
	}
}


void function DefaultStayPut( entity guys )
{
	foreach ( guy in guys )
	{
		guy.AssaultPoint( guy.GetOrigin() )
		guy.DisableNPCFlag( NPC_ALLOW_PATROL | NPC_ALLOW_INVESTIGATE )
	}
}


float function GetTimeLimit_ForGameMode()
{
	#if DEVELOPER
		if ( "devForcedTimeLimit" in level && level.devForcedTimeLimit )
			return 0.1
	#endif

	if ( GameState_GetTimeLimitOverride() >= 0 )
		return GameState_GetTimeLimitOverride()

	return GetCurrentPlaylistVarFloat( "timelimit", 30.0 )
}


void function SetupAssaultPointKeyValues()
{
	printt( "WARNING, USED GETENTARRAY INSTEAD OF ADDSPAWNCALLBACK" )
	array<entity> assaultpoints = GetEntArrayByClass_Expensive( "assault_assaultpoints" )
	foreach ( point in assaultpoints )
	{
		SetupAssaultPoint( point )
	}
}


void function SetupAssaultPoint( entity point )
{
	point.kv.allowdiversionradius = 1000
	point.kv.faceAssaultPointAngles = 1
	point.kv.arrivaltolerance = 120
}


float function GetTimeTillGameStarts()
{
	return GetGameStartTime() - Time()
}


//////////////////////////////////////////////////////////////
// No death screams from npcs
void function SetSilentDeath( entity npc, bool silent )
{
	Assert( npc.IsNPC(), "Cannot call SetSilentDeath on a non-npc: " + npc.GetClassName() )
	Assert( IsAlive( npc ), "Cannot call SetSilentDeath on a dead npc" )

	if ( silent )
	{
		if ( !("silentDeath" in npc.s) )
			npc.s.silentDeath <- true
	}
	else
	{
		if ( "silentDeath" in npc.s )
			delete npc.s.silentDeath
	}
}


bool function PlayerFullyConnected( player )
{
	if ( !player.hasConnected || player.GetTeam() == TEAM_SPECTATOR )
		return false

	if ( player.IsMarkedForDeletion() )
		return false

	return true
}


void function SaveDatePlayed( entity player )
{
	Assert( IsServer() )
	Assert( IsValid( player ) )
	Assert( player.IsPlayer() )

	player.SetPersistentVar( "lastTimePlayed", Daily_GetCurrentTime() )
}


void function SaveDateLoggedIn( entity player )
{
	Assert( IsServer() )
	Assert( IsValid( player ) )
	Assert( player.IsPlayer() )

	player.SetPersistentVar( "lastTimeLoggedIn", Daily_GetCurrentTime() )
}


float function GetDaysInactive( entity player )
{
	return _GetDaysSinceVar( player, "lastTimePlayed" )
}


float function GetDaysSinceLastLogin( entity player )
{
	return _GetDaysSinceVar( player, "lastTimeLoggedIn" )
}


string function GetMapNameForScoreboardData()
{
	string mapName = GetMapName()

	#if DEV
		if ( MapIsValidForPersistence( mapName ) )
			return mapName

		if ( IsTestMap() && !IsLobby() )
		{
			string fakeMapName = PersistenceGetEnumItemNameForIndex( "maps", 0 )
			Warning( "GetMapNameForScoreboardData() - Test map '" + mapName + "' isn't set up for scoreboard persistence, so substituting map name '" + fakeMapName + "' instead." )
			return fakeMapName
		}
	#endif // DEV

	return mapName
}

#if DEV
struct
{
	int health
} DEV_botPlaybackState
#endif

void function CodeCallback_BotRecordStart( entity player )
{
	// note: I already save position, orientation and velocity in C++ code
	#if DEV
		DEV_botPlaybackState.health = player.GetHealth()
		foreach( void functionref( entity recordPlayer ) callback in file.botRecordStartCallbacks )
			callback( player )
	#endif
}


void function CodeCallback_BotPlaybackStart( entity bot )
{
	// note: the bot has been spawned and already set to the correct initial position, orientation and velocity by C++ code
	#if DEV
		Assert( IsValid( bot ) )

		//bot.SetHealth( DEV_botPlaybackState.health )

		// todo(dw): status effects

		foreach( void functionref( entity playbackBot ) callback in file.botPlaybackStartCallbacks)
			callback( bot )

		thread DelayedBotPlaybackState( bot )
	#endif
}

#if DEV
void function DelayedBotPlaybackState( entity bot )
{
	EndSignal( bot, "OnDestroy" )

	WaitEndFrame()
	while ( true )
	{
		if ( IsAlive( bot ) )
		{
			bot.SetHealth( DEV_botPlaybackState.health )
			break
		}
		WaitFrame()
	}
}
void function AddCallback_BotRecordStart( void functionref( entity recordPlayer ) callback )
{
	Assert( !file.botRecordStartCallbacks.contains( callback ), "Tried to add a callback that was already added" )
	file.botRecordStartCallbacks.append( callback )
}

void function AddCallback_BotPlaybackStart( void functionref( entity playbackBot ) callback )
{
	Assert( !file.botPlaybackStartCallbacks.contains( callback ), "Tried to add a callback that was already added" )
	file.botPlaybackStartCallbacks.append( callback )
}
#endif

void function UpdatePersistenceOnDisconnect( entity player )
{
	if ( player.p.updatedPersistenceOnDisconnect )
		return

	if ( Bleedout_IsBleedingOut( player ) ) // if we don't catch this here, players can disconnect and because stats have been written, deaths are not recorded
		StatsHook_TrackPlayerDeaths( player )

	StatsInternals_UpdatePersistenceOnDisconnect( player )
	//Boost_UpdatePersistenceOnDisconnect( player ) // sh_boost, implement later - kral
	//Mastery_UpdatePersistenceOnDisconnect( player ) // implement later - kral
	UpdatePlayerMatchCodeStats( player )

	if ( player.GetTeam() != TEAM_SPECTATOR )
		SaveDatePlayed( player )
	SaveDateLoggedIn( player )

	player.p.updatedPersistenceOnDisconnect = true
}


void function CodeCallback_FinalizePersistentData( entity player )
{
	printt( "CodeCallback_FinalizePersistentData():", player.GetPlayerName() )

	if ( !player.hasConnected || player.GetTeam() == TEAM_SPECTATOR )
		return

	UpdatePersistenceOnDisconnect( player )
}



