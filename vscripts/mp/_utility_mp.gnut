void function ForceMatchEnd()
{
	printt( "Match ended with ForceMatchEnd()" )
	int winningTeam = GetWinningTeam()

	if ( winningTeam == TEAM_UNASSIGNED )
	{
		winningTeam = GetPlayerArray().getrandom().GetTeam()
	}

	ForceTeamWin( winningTeam )
}


void function ForceTeamWin( int team )
{
	level.devForcedWin = true
	svGlobal.levelEnt.Signal( "devForcedWin" )
	if ( IsRoundBased() )
	{
		SetWinner( team, eWinReason.DEFAULT, "#DEV_COMMAND_FORCED_WIN_ANNOUNCEMENT", "#DEV_COMMAND_FORCED_LOSS_ANNOUNCEMENT" )
	}
	else
	{
		SetWinner( team, eWinReason.DEFAULT, "#DEV_COMMAND_FORCED_WIN_ANNOUNCEMENT", "#DEV_COMMAND_FORCED_LOSS_ANNOUNCEMENT" )
	}
}


bool function HasGameStateProtection( entity ent )
{
	// return true if the ent CAN'T die in the current gamestate
	switch ( GetGameState() )
	{
		case eGameState.WaitingForCustomStart:
		case eGameState.WaitingForPlayers:
		case eGameState.PickLoadout:
		case eGameState.Playing:
		case eGameState.SuddenDeath:
		case eGameState.Epilogue:
		case eGameState.Resolution:
			// can die
			return false

		case eGameState.Prematch:

			if ( "canDieInPrematch" in ent.s )
				return false // some ents could die in Prematch

			return true // most ents doesn't die in Prematch

		case eGameState.SwitchingSides:
		case eGameState.Postmatch:
			// nothing dies
			return true

		case eGameState.WinnerDetermined:
			return !IsWinnerDeterminedPlayable()

		default:
			Assert( false, "Unknown gamestate " + GetGameState() )
	}

	return false
}

// Return a table which organizes all players into their teams
table< int, array<entity> > function GetAllPlayersSortedByTeam()
{
	return GetPlayersSortedByTeam( GetPlayerArray() )
}

// Return a table which organizes players ( from the passed in array of players ) into their teams
table< int, array<entity> > function GetPlayersSortedByTeam( array<entity> players )
{
	table< int, array<entity> > groupedPlayers

	foreach( entity player in players )
	{
		if ( !IsValid( player ) )
			continue

		int team = player.GetTeam()
		if ( !(team in groupedPlayers) )
			groupedPlayers[ team ] <- []

		groupedPlayers[ team ].append( player )
	}

	return groupedPlayers
}


float function GetDistanceToNearestTeammate( entity player )
{
	float dist              = -1
	array<entity> teammates = GetPlayerArrayOfTeam_Alive( player.GetTeam() )
	if ( teammates.len() <= 1 )
		return dist

	foreach( entity teammate in teammates )
	{
		if ( teammate == player )
			continue
		float d = Distance( teammate.GetOrigin(), player.GetOrigin() )
		if ( dist < 0 || d < dist )
			dist = d
	}
	return dist
}



#if DEV

entity function GetPlayerByName( string name )
{
	foreach ( player in GetPlayerArray() )
	{
		if ( player.GetPlayerName().tolower() == name.tolower() )
			return player
	}

	return null
}


void function PlayerKillsPlayer( string killerName, string victimName )
{
	entity killer = GetPlayerByName( killerName )
	entity victim = GetPlayerByName( victimName )
	if ( !IsValid( killer ) || !IsValid( victim ) )
		return

	victim.TakeDamage( 1000, killer, killer, {} )
}

void function AddLastSquadPlayer( int index, string name, string playerUID, string nucleusID, int hardwareID )
{
	GP().SetPersistentVar( "lastGameSquadStats[" + index + "].playerName", name )
	GP().SetPersistentVar( "lastGameSquadStats[" + index + "].platformUid", playerUID )
	GP().SetPersistentVar( "lastGameSquadStats[" + index + "].nucleusID", nucleusID )
	GP().SetPersistentVar( "lastGameSquadStats[" + index + "].hardwareID", hardwareID )


	GP().SetPersistentVar( "lastGamePlayers", 6 )
	GP().SetPersistentVar( "lastGameTime", GetUnixTimestamp() + 3000 )
}

void function DEV_SetShowBattlePassSummary( entity player  )
{
	player.SetPersistentVar( "showGameSummary", true )
	player.SetPersistentVar( "lastGameTime", GetUnixTimestamp()  )
}
#endif