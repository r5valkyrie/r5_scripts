// This script file contains logic for Alliance Proximity and support functions for working with Alliances

// Alliance Proximity logic determines when gameplay, minimap, and map icons generated by players ( abilities, pings etc)
// display for players that are on the same alliance but not in the same squad.
// If an alliance member is within proximity to the player creating the icon or the icon itself it will show up otherwise it is hidden.
// If an icon is created at a location ( a ping for example) and a player was out of range when it was created but moves into range while the icon is still alive, it will become visible.
// This logic is currently being used in Control Mode.

// ============================================================================
// Engine Native Stubs — global declarations
// ============================================================================
#if SERVER || CLIENT
global function IsPositionWithinRadius
#endif // SERVER || CLIENT
#if CLIENT
global function SetPlayerTempMuted
#endif // CLIENT

// Alliance constants — defined here since this file loads before sh_freedm_stubs.nut
global const int ALLIANCE_NONE = -1
global const int ALLIANCE_A = 0
global const int ALLIANCE_B = 1


global function AllianceProximity_Init
global function AllianceProximity_IsUsingAlliances // Is this a mode that uses alliances
global function AllianceProximity_IsUsingAllianceProximity // Is this a mode that allows players in the same alliance but different squad to ping to each other and show ability icons
global function AllianceProximity_IsUsingAllianceProximityDistanceChecks // Same as above but only when in proximity to the source player or the ping/icon
global function AllianceProximity_GetMaxDistForProximity // What is the max distance from source or icon/ping that we will show it to a player not on the same squad but in the same alliance
global function AllianceProximity_GetMaxNumAlliances // What is the max number of alliances allowed for this mode
global function AllianceProximity_GetMaxNumPlayersPerAlliance // What is the max number of players allowed in alliances
global function AllianceProximity_GetAllianceFromTeam // Get the alliance this team ( squad ) is in
global function AllianceProximity_GetTeamsInAlliance // Use if you want all the squads in this alliance and don't care if the teams are empty
global function AllianceProximity_GetRepresentativeTeamForAlliance // Pick a team that is in an alliance, return the same team when possible ( usually used for game end logic where all players are placed on a single team )
global function AllianceProximity_GetTeamsInSameAllianceAsTeam // Return an array of other teams that are in the same alliance as the passed in team
global function AllianceProximity_IsTeamInAnAlliance // Is this team in an alliance
global function AllianceProximity_GetOtherAlliances // Get all other alliances besides the one passed in
global function AllianceProximity_GetOtherAlliance // Get the other alliance besides the one passed in ( assumes only 2 alliances are used )
global function AllianceProximity_GetAllAlliances // Get an array of all alliances
global function AllianceProximity_GetAllTeamsOrAlliances // Gets an array of all alliances if and only if alliances are being used, otherwise it gets an array of teams
global function AllianceProximity_GetAllTeamsInAlliances // Get an array of all teams that are in alliances
global function AllianceProximity_RegisterNonPlayerTeamToAlliances // Put an NPC team into an alliance ( normally only player teams are placed in alliances )
global function AddCallback_AllianceProximity_OnTeamPutIntoAlliance // Add a callback for when a team gets placed into an alliance

#if SERVER || CLIENT
global function AllianceProximity_ShouldTryToTransmitPingOrIconToAlliance // Based on all the different alliance ping settings, determine if this ping/icon should be transmitted to alliance members
global function AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance // Does this mode only transmit specific pings to alliance members
global function AllianceProximity_SetPriorityPingsForAlliance // If we only want specific pings to show for alliances, this function allows a mode to set which pings will display
global function AllianceProximity_GetOriginalPlayerTeam_FromPlayerEHI // Usually at match end all players in an alliance are placed on the same team. Use this to get the original team the player was on before the switch
global function AllianceProximity_GetLivingAllianceMembersInProximity // Return all living members of an alliance within the defined alliance proximity radius
global function AllianceProximity_GetLivingPlayerTeamsInAlliance // Return teams with living players on them in an alliance
global function AllianceProximity_GetNumPlayersInAlliance // Return how many players are in an alliance
global function AllianceProximity_GetAllPlayersInAlliance // Return all players in the passed in alliance
global function AllianceProximity_GetGroupsOfAllAlliancePlayers // Return all players in the passed in alliance split into groups (team members in the same group)
global function AllianceProximity_GetAllPlayersInOtherAlliances // Return all players in alliances other than the passed in alliance
global function AllianceProximity_GetPlayersInSameAllianceAsTeam // Return all players that are in the same alliance that the passed in team is in
global function AllianceProximity_GetLivingPlayerTeamsInSameAllianceAsTeam // Get teams with living players on them in the same alliance as the passed in team
global function AllianceProximity_GetPopulatedTeamsInAlliance // Return an array of teams in the passed in alliance but only if they are not empty
global function AllianceProximity_GetAllianceScoreDifference // Return the score difference between alliances
#endif // SERVER || CLIENT

