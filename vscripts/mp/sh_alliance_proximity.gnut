global function AllianceProximity_SetMinimapAlwaysShow_ForAlliance
global function AllianceProximity_SetOnlyTransmitWaypointToFriendlyTeams
global function AllianceProximity_ReassignAlliancePlayersToTeams
global function AllianceProximity_GetHaveAlliancesBeenReassignedToTeams
