struct {
	array < int > allAlliances
	array < int > allAllianceTeams

	table< int, int > teamToAllianceTable
	table< int, array< int > > allianceToTeamsTable
	array<void functionref( int, int )> callbacks_AllianceProximity_OnTeamPutIntoAlliance

	#if SERVER || CLIENT
		table< EHI, int > playerEHIToOriginalTeamTable // Match the player EHI to their team before we do a team change at the end of the match
		bool isMinimapDisabled
		array < int > priorityPingTypes
	#endif // SERVER || CLIENT

	#if SERVER
		bool hasFinalizedTeamReassignments = false
		table < int, int > allianceToReassignedTeamTable // teams from alliances get re-assigned to a single team at the end of the match, this keeps track of which team each alliance got assigned to
		table < int, array< int > > originalTeamIDToCurrentTeamMemberIndexesTable // store the current indexes of all the team members that were on the same team before the end of match team change
	#endif // SERVER

} file

// Init Alliance Proximity logic
void function AllianceProximity_Init()
{
	#if DEVELOPER
		printt( "ALLIANCE PROXIMITY: Running ", FUNC_NAME() )
	#endif // DEVELOPER

	#if DEVELOPER
		Assert( AllianceProximity_GetMaxNumAlliances() <= 0 || AllianceProximity_GetMaxNumAlliances() <= GetCurrentPlaylistVarInt( "max_teams", 0 ), "ALLIANCE PROXIMITY: Trying to use Alliances but have set more alliances ( " + AllianceProximity_GetMaxNumAlliances() + " ) than squads ( " + GetCurrentPlaylistVarInt( "max_teams", 0 ) + " )" )
	#endif // DEVELOPER

	// Logic below should only be needed when using Alliances
	if ( !AllianceProximity_IsUsingAlliances() )
		return

	Remote_RegisterClientFunction( "AllianceProximity_ServerCallback_SetTeamToAllianceOnClient", "int", TEAM_MULTITEAM_FIRST, TEAM_MULTITEAM_LAST, "int", ALLIANCE_NONE, AllianceProximity_GetMaxNumAlliances() + 1 )
	Remote_RegisterClientFunction( "AllianceProximity_MuteAllianceOnMatchEndReassignment" )

	file.allAllianceTeams = GetAllTeams() // Get all human player teams, store this data because we can also add AI Teams to Alliances

	// Put alliances into the team to alliance table ( determine which teams are going to be in which alliance )
	AllianceProximity_SetTeamsToAlliances()

	// Add Callbacks so we can track players original team before the team change that happens at the end of matches that use alliances
	// Need to do this until alliances are properly supported in end of game flow
	#if SERVER
		AddCallback_OnClientConnected( AllianceProximity_OnPlayerConnected )
		AddCallback_OnClientConnectionRestored( AllianceProximity_OnPlayerConnectionRestored )
	#endif // SERVER

	#if CLIENT
		AddCreateCallback( "player", AllianceProximity_OnPlayerCreated )
	#endif // CLIENT

	#if CLIENT
		file.isMinimapDisabled = GetCurrentPlaylistVarBool( "disable_minimap_labels", false )
	#endif // CLIENT
}

// Store callback functions that will trigger if a team gets put into an alliance.
// Most likely used for when a team is put into a new alliance that is different from the default
// Will trigger anytime the team is put into an alliance that is not the same as the current alliance for the team ( including the first time the team is put into an alliance )
void function AddCallback_AllianceProximity_OnTeamPutIntoAlliance( void functionref( int, int ) func )
{
	Assert( !file.callbacks_AllianceProximity_OnTeamPutIntoAlliance.contains( func ) )
	file.callbacks_AllianceProximity_OnTeamPutIntoAlliance.append( func )
}

// Is this gamemode using alliances
// Alliances are a team of players made up of multiple squads ( squads are referred to as teams in our script )
bool function AllianceProximity_IsUsingAlliances()
{
	return AllianceProximity_GetMaxNumAlliances() > 0 && !IsLobby()
}

// Is this gamemode using Alliance Proximity
// Alliance proximity allows ability icons, highlights, and pings to appear for players in an Alliance that are not in the same squad
bool function AllianceProximity_IsUsingAllianceProximity()
{
	return GetCurrentPlaylistVarBool( "use_proximity_alliance_members", false )
}

// When using alliance proximity logic do we care how far away a player is from the source of the icon/highlight/ping or the icon/highlight/ping itself
// If false we just show these at all ranges
bool function AllianceProximity_IsUsingAllianceProximityDistanceChecks()
{
	return AllianceProximity_GetMaxDistForProximity() > 0.0 && AllianceProximity_IsUsingAllianceProximity()
}

#if SERVER || CLIENT
// When using alliance proximity logic, do we only want specified pings to appear and ignore all other icons/pings?
bool function AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance()
{
	return GetCurrentPlaylistVarBool( "use_proximity_alliance_priority_pings", false )
}
#endif // SERVER || CLIENT

#if SERVER || CLIENT
// Set which ping types are considered priority pings. When AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance is true, only these pings will transmit to alliance members
void function AllianceProximity_SetPriorityPingsForAlliance( array < int > priorityPingTypes )
{
	Assert( AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance(), "ALLIANCE PROXIMITY: Setting priority pings using " + FUNC_NAME() + " for a mode that doesn't have priority pings enabled." )


	#if DEVELOPER
		if ( file.priorityPingTypes.len() > 0 )
			Warning( "ALLIANCE PROXIMITY: Setting priority pings for alliance when we already have defined priority pings, the old pings will be overridden" )
	#endif // DEVELOPER


	file.priorityPingTypes = priorityPingTypes
}
#endif // SERVER || CLIENT

#if SERVER || CLIENT
// Determine if we should be transmitting this icon/ping to alliance members or if only squadmates should see it as normal
bool function AllianceProximity_ShouldTryToTransmitPingOrIconToAlliance( bool isPing, int pingType = -1 )
{
	// We don't want to transmit anything if we are not using the alliance proximity system
	if ( !AllianceProximity_IsUsingAllianceProximity() )
		return false

	#if DEVELOPER
		if ( AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance() && file.priorityPingTypes.len() < 1 )
			Warning( "ALLIANCE PROXIMITY: AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance is set to true but there are no priority pings defined, use AllianceProximity_SetPriorityPingsForAlliance to set them" )
	#endif // DEVELOPER

	// We don't want to transmit anything if we only transmit priority pings and this is not a ping or not a priority ping
	if ( AllianceProximity_ShouldOnlyDisplayPriorityPingsForAlliance() && ( !isPing || pingType == -1 || !file.priorityPingTypes.contains( pingType ) ) )
		return false

	return true
}
#endif // SERVER || CLIENT

// Determine if a team is in an Alliance
bool function AllianceProximity_IsTeamInAnAlliance( int team )
{
	return team in file.teamToAllianceTable
}

// Should all teams start on the same alliance to start
bool function AllianceProximity_ShouldAllTeamsStartOnTheSameAlliance()
{
	return GetCurrentPlaylistVarBool( "start_with_teams_on_same_alliance", false )
}

// How many alliances are there in this gamemode
int function AllianceProximity_GetMaxNumAlliances()
{
	return GetCurrentPlaylistVarInt( "max_alliances", 0 )
}

// How many players can there be in each alliance
int function AllianceProximity_GetMaxNumPlayersPerAlliance()
{
	int maxPlayers = GetCurrentPlaylistVarInt( "max_players", 0 )

	if ( maxPlayers <= 0 )
		return 0

	#if UI
		bool tooEarlyToCheckMaxNumAlliances = GetGameState() < eGameState.Playing
	#else
		bool tooEarlyToCheckMaxNumAlliances = !Flag( "EntitiesDidLoad" ) || GetGameState() < eGameState.Playing
	#endif

	if ( tooEarlyToCheckMaxNumAlliances && AllianceProximity_ShouldAllTeamsStartOnTheSameAlliance() )
		return maxPlayers

	return maxPlayers / AllianceProximity_GetMaxNumAlliances()
}

#if SERVER
// If false Alliances are set at match start and remain static. If True we allow teams to switch to different alliances mid match ( like in Rev Army Mode )
bool function AllianceProximity_IsMidMatchAllianceSwitchingEnabled()
{
	return GetCurrentPlaylistVarBool( "allow_mid_match_alliance_switching", false )
}
#endif

// Put a team in our all teams array so it can be added to an alliance. Normally only player teams are used
void function AllianceProximity_RegisterNonPlayerTeamToAlliances( int team )
{
	if ( !AllianceProximity_GetAllTeamsInAlliances( false ).contains( team ) )
	{
		#if DEVELOPER
			printt( "ALLIANCE PROXIMITY: ", FUNC_NAME(), " adding team: ", team, " to file.allAllianceTeams and putting them on alliance: ", ALLIANCE_A )
		#endif // DEVELOPER
		file.allAllianceTeams.append( team )
		// Put on temp alliance, script should set this team to an alliance manually
		AllianceProximity_SetTeamToAlliance_Internal( team, ALLIANCE_A )
	}
}

#if CLIENT
vector function AllianceProximity_GetAllianceColor( int alliance )
{
	switch( alliance )
	{
		case ALLIANCE_A:	return GetKeyColor( COLORID_CONTROL_FRIENDLY ) / 255.0
		case ALLIANCE_B:	return GetKeyColor( COLORID_CONTROL_ENEMY ) / 255.0
		default:
			return <0.0, 0.0, 0.0>
	}

	unreachable
}
vector function AllianceProximity_GetAllianceColorFromTeam( int team )
{
	int alliance = AllianceProximity_GetAllianceFromTeam( team )
	return AllianceProximity_GetAllianceColor( alliance )
}
#endif

// Get the alliance number from the team number ( squad )
int function AllianceProximity_GetAllianceFromTeam( int team )
{
	if ( team < TEAM_MULTITEAM_FIRST )
		return ALLIANCE_NONE

	if ( !AllianceProximity_IsTeamInAnAlliance( team ) )
		return ALLIANCE_NONE

	return file.teamToAllianceTable[ team ]
}

#if CLIENT
int function AllianceProximity_GetAllianceFromTeamWithObserverCorrection( int team )
{
	entity localPlayer = GetLocalClientPlayer()
	bool isObserver = false

	if( IsValid( localPlayer ) )
	{
		isObserver = localPlayer.GetTeam() == TEAM_SPECTATOR || localPlayer.GetTeam() == TEAM_UNASSIGNED
	}

	return ( isObserver )? 0: AllianceProximity_GetAllianceFromTeam( localPlayer.GetTeam() )

}
#endif

#if CLIENT
int function AllianceProximity_GetUIAllianceFromTeam( int team )
{
	int alliance = AllianceProximity_GetAllianceFromTeam( team )
	return AllianceProximity_GetUIAlliance( alliance )
}
#endif // CLIENT

#if CLIENT
int function AllianceProximity_GetUIAlliance( int alliance )
{
	entity localPlayer = GetLocalViewPlayer()
	if( !IsValid( localPlayer ) )
		return alliance

	int localTeam = localPlayer.GetTeam()
	if( localTeam == TEAM_SPECTATOR )
		return alliance

	int localAlliance = AllianceProximity_GetAllianceFromTeam( localTeam )
	int uiAlliance = alliance == localAlliance ? 0 : alliance == 0 ? localAlliance : alliance
	return uiAlliance
}
#endif // CLIENT

// Get the other Alliances from the passed in Alliance.
array< int > function AllianceProximity_GetOtherAlliances( int alliance )
{
	array< int > otherAlliances = []

	foreach( key, value in file.allianceToTeamsTable )
	{
		if ( key != alliance )
			otherAlliances.append( key )
	}

	return otherAlliances
}

// Get all Alliances
array < int > function AllianceProximity_GetAllAlliances()
{
	array< int > resultArray = clone file.allAlliances
	return resultArray
}

array < int > function AllianceProximity_GetAllTeamsOrAlliances()
{
	if ( AllianceProximity_IsUsingAlliances() )
		return AllianceProximity_GetAllAlliances()

	return GetAllTeams()
}

// Get all teams that are in any alliance ( just need this because AI can get added to Alliances)
array < int > function AllianceProximity_GetAllTeamsInAlliances( bool playerTeamsOnly )
{
	if ( playerTeamsOnly )
		return GetAllTeams()

	// Intent is NOT to allow these to be manipulated from outside, return a clone of the array
	return clone file.allAllianceTeams
}

// Get the other Alliance in modes that only have 2 Alliances
int function AllianceProximity_GetOtherAlliance( int alliance )
{
	Assert( AllianceProximity_GetMaxNumAlliances() == 2, "ALLIANCE PROXIMITY: Running " + FUNC_NAME() + " in a mode with maxAlliances not equal to 2, you probably want to use AllianceProximity_GetOtherAlliances" )
	return alliance == ALLIANCE_A ? ALLIANCE_B : ALLIANCE_A
}

#if SERVER || CLIENT
// Return the player's team prior to end of match team switch if it is available otherwise return their current team number
int function AllianceProximity_GetOriginalPlayerTeam_FromPlayerEHI( EHI playerEHI )
{
	#if DEVELOPER
		Assert(  EHIHasValidScriptStruct( playerEHI ), "ALLIANCE PROXIMITY: Attempted to run " + FUNC_NAME() + " on an Invalid playerEHI" )
	#endif // DEVELOPER

	int team = EHI_GetTeam( playerEHI )

	if ( playerEHI in file.playerEHIToOriginalTeamTable )
	{
		team = file.playerEHIToOriginalTeamTable[ playerEHI ]
	}

	return team
}
#endif // SERVER || CLIENT

#if SERVER
// Return the current team member indexes of the original members of a team before we reassign teams on match end
array< int > function AllianceProximity_GetCurrentTeamMemberIndexesOfOriginalTeam( int originalTeamID )
{
	if ( originalTeamID in file.originalTeamIDToCurrentTeamMemberIndexesTable )
		return file.originalTeamIDToCurrentTeamMemberIndexesTable[ originalTeamID ]

	return []
}
#endif // SERVER

// When using Alliance Proximity logic with distance checks, this is the max distance at which icons/highlights/pings will appear.
// This distance is based on the distance from the player that is the source of the icon/highlight/ping or the distance from the icon/highlight/ping itself
float function AllianceProximity_GetMaxDistForProximity()
{
	return GetCurrentPlaylistVarFloat( "max_dist_proximity_alliance_members", 0.0 )
}

#if SERVER || CLIENT
// Get all Alliance members within proximity to the passed in position. Only returns living members of the same alliance who are not on the same team
// If we are not using proximity distance checks, just return all living alliance members in the same alliance but not on the same team
array<entity> function AllianceProximity_GetLivingAllianceMembersInProximity( int team, vector origin )
{
	array<entity> allianceMembersInProximity = []
	array<entity> livingAlliancePlayers = AllianceProximity_GetPlayersInSameAllianceAsTeam( team, true )

	// If we are in fact using distance checks, only return players in proximity.
	if ( AllianceProximity_IsUsingAllianceProximityDistanceChecks() )
	{
		foreach ( playerAlive in livingAlliancePlayers )
		{
			if ( IsPositionWithinRadius( AllianceProximity_GetMaxDistForProximity(), origin, playerAlive.GetOrigin() ) )
				allianceMembersInProximity.append( playerAlive )
		}
	}
	else // If we are not using distance checks, return all living alliance players
	{
		allianceMembersInProximity = livingAlliancePlayers
	}

	return allianceMembersInProximity
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
// Get all players in the specified Alliance.
array<entity> function AllianceProximity_GetAllPlayersInAlliance( int alliance, bool shouldReturnOnlyLivingPlayers )
{
	array<entity> allianceMembers = []
	array<entity> players = []

	if ( shouldReturnOnlyLivingPlayers )
	{
		players = GetPlayerArray_AliveConnected()
	}
	else
	{
		players = GetPlayerArray()
	}


	foreach ( playerEnt in players )
	{
		if ( IsValid( playerEnt ) )
		{
			int playerEntAlliance = AllianceProximity_GetAllianceFromTeam( playerEnt.GetTeam() )
			if ( playerEntAlliance == alliance )
				allianceMembers.append( playerEnt )
		}
	}

	return allianceMembers
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
// Get all players in other Alliances than the one specified
array< array< entity > > function AllianceProximity_GetGroupsOfAllAlliancePlayers( int alliance, int numGroups, bool shouldReturnOnlyLivingPlayers )
{
	array<entity> players = []

	if ( shouldReturnOnlyLivingPlayers )
	{
		players = GetPlayerArray_AliveConnected()
	}
	else
	{
		players = GetPlayerArray()
	}

	table< int, array< entity > > teamInAllianceToPlayersMap

	foreach ( playerEnt in players )
	{
		if ( IsValid( playerEnt ) )
		{
			int team = playerEnt.GetTeam()
			int playerEntAlliance = AllianceProximity_GetAllianceFromTeam( team )
			if ( playerEntAlliance == alliance && team in teamInAllianceToPlayersMap )
			{
				teamInAllianceToPlayersMap[ team ].append( playerEnt )
			}
			else if ( playerEntAlliance == alliance )
			{
				teamInAllianceToPlayersMap[ team ] <- [ playerEnt ]
			}
		}
	}

	array< array< entity > > groupsOfAllianceTeams
	for ( int i = 0; i < numGroups; i++ )
	{
		groupsOfAllianceTeams.append( [] )
	}

	int groupIdx = 0
	foreach( team, teamPlayers in teamInAllianceToPlayersMap )
	{
		groupsOfAllianceTeams[ groupIdx % numGroups ].extend( teamPlayers )
		groupIdx++
	}

	return groupsOfAllianceTeams
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
// Get a count of players in an alliance
int function AllianceProximity_GetNumPlayersInAlliance( int alliance, bool shouldOnlyCountLivingPlayers )
{
	return AllianceProximity_GetAllPlayersInAlliance( alliance, shouldOnlyCountLivingPlayers ).len()
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
// Get all players in other Alliances than the one specified
array<entity> function AllianceProximity_GetAllPlayersInOtherAlliances( int alliance, bool shouldReturnOnlyLivingPlayers )
{
	array <entity> otherAlliancePlayers = []
	array<entity> players = []

	if ( shouldReturnOnlyLivingPlayers )
	{
		players = GetPlayerArray_AliveConnected()
	}
	else
	{
		players = GetPlayerArray()
	}

	foreach ( playerEnt in players )
	{
		if ( IsValid( playerEnt ) )
		{
			int playerEntAlliance = AllianceProximity_GetAllianceFromTeam( playerEnt.GetTeam() )
			if ( playerEntAlliance != alliance )
				otherAlliancePlayers.append( playerEnt )
		}
	}

	return otherAlliancePlayers
}
#endif // SERVER || CLIENT



#if SERVER || CLIENT
// Get all Alliance members that are in the same Alliance as this team
array<entity> function AllianceProximity_GetPlayersInSameAllianceAsTeam( int playerTeam, bool shouldReturnOnlyLivingPlayers )
{
	int alliance = AllianceProximity_GetAllianceFromTeam( playerTeam )
	array<entity> allianceMembers = AllianceProximity_GetAllPlayersInAlliance( alliance, shouldReturnOnlyLivingPlayers )
	array<entity> playersInSameAllianceAsTeam = allianceMembers

	foreach ( playerEnt in allianceMembers )
	{
		int playerEntTeam = playerEnt.GetTeam()
		if ( playerEntTeam == playerTeam )
			playersInSameAllianceAsTeam.fastremovebyvalue( playerEnt )
	}

	return playersInSameAllianceAsTeam
}
#endif // SERVER || CLIENT

// Get all teams (squads) in the same Alliance as this team
array<int> function AllianceProximity_GetTeamsInSameAllianceAsTeam( int playerTeam )
{
	int alliance = AllianceProximity_GetAllianceFromTeam( playerTeam )
	array<int> uniqueAllianceTeams = AllianceProximity_GetTeamsInAlliance( alliance )
	array<int> teamsInSameAllianceAsTeam = []

	foreach ( team in uniqueAllianceTeams )
	{
		if ( team != playerTeam )
			teamsInSameAllianceAsTeam.append( team )
	}

	return teamsInSameAllianceAsTeam
}

#if SERVER || CLIENT
// Get all teams (squads) of living players in the same Alliance as this team
array<int> function AllianceProximity_GetLivingPlayerTeamsInSameAllianceAsTeam( int playerTeam )
{
	int alliance = AllianceProximity_GetAllianceFromTeam( playerTeam )
	array<int> uniqueAllianceTeams = AllianceProximity_GetLivingPlayerTeamsInAlliance( alliance )
	array<int> teamsInSameAllianceAsTeam = []

	foreach ( team in uniqueAllianceTeams )
	{
		if ( team != playerTeam )
			teamsInSameAllianceAsTeam.append( team )
	}

	return teamsInSameAllianceAsTeam
}
#endif // SERVER || CLIENT

// Get all teams (squads) in this Alliance
array< int > function AllianceProximity_GetTeamsInAlliance( int alliance )
{
	if ( !(alliance in file.allianceToTeamsTable) )
		return []

	// Intent is NOT to allow these to be manipulated from outside, return a clone of the array
	return clone file.allianceToTeamsTable[ alliance ]
}

#if SERVER || CLIENT
// Get all teams (squads) in this Alliance but only if the teams are not empty
array< int > function AllianceProximity_GetPopulatedTeamsInAlliance( int alliance )
{
	array < int > teams
	array < int > teamsToTest = AllianceProximity_GetTeamsInAlliance( alliance )
	foreach ( team in teamsToTest )
	{
		if ( GetPlayerArrayOfTeam( team ).len() > 0 )
			teams.append( team )
	}

	return teams
}
#endif // SERVER || CLIENT

#if SERVER
// Alliances aren't fully supported in a lot of the game systems.
// At the end of matches we assign all players in an alliance to a single team so stats, win/losses etc can be handled.
void function AllianceProximity_ReassignAlliancePlayersToTeams()
{
	if ( !AllianceProximity_IsUsingAlliances() )
		return

	array < int > allAlliancesArray = AllianceProximity_GetAllAlliances()
	array < int > allTeamsArray = GetAllValidPlayerTeams()

	// Designate a team for alliance teams to be assigned to.
	// We use the AllianceProximity_GetRepresentativeTeamForAlliance function because some gamemodes ( like TDM ) use that function to set winners, we want things to line up
	foreach ( alliance in allAlliancesArray )
	{
		file.allianceToReassignedTeamTable[ alliance ] <- AllianceProximity_GetRepresentativeTeamForAlliance( alliance )
	}

	foreach ( team in allTeamsArray )
	{
		int allianceForTeam = AllianceProximity_GetAllianceFromTeam( team )

		if ( !(allianceForTeam in file.allianceToReassignedTeamTable) )
			continue

		int teamToAssignTo = file.allianceToReassignedTeamTable[ allianceForTeam ]

		if ( teamToAssignTo != team ) // don't worry about moving players already on the team that will be used for EOG
		{
			array < entity > teamPlayersArray = GetPlayerArrayOfTeam( team )
			foreach ( player in teamPlayersArray )
			{
				if ( !IsValid( player ) )
					continue

				SetTeam( player, teamToAssignTo )
			}
		}
	}

	foreach ( player in GetPlayerArray() )
	{
		if ( IsValid ( player ) )
			Remote_CallFunction_NonReplay( player, "AllianceProximity_MuteAllianceOnMatchEndReassignment" )
	}

	file.hasFinalizedTeamReassignments = true
}
#endif // SERVER

#if SERVER
// Make sure squad data gets updated if the player team changes
void function AllianceProximity_OnPlayerTeamChanged_Server( entity player, int oldIndex, int newIndex, int oldTeam, int newTeam )
{
	// Don't do anything if the teams are the same
	if ( oldTeam == newTeam )
		return

	if ( IsValid( player ) )
	{
		if ( oldIndex > -1 && oldTeam > -1)
		{
			// We want to keep track of the up to date team member indexes of players from the players original team to help finalize squad data on match end
			if ( oldTeam in file.originalTeamIDToCurrentTeamMemberIndexesTable )
			{
				file.originalTeamIDToCurrentTeamMemberIndexesTable[ oldTeam ].fastremovebyvalue( oldIndex )
				file.originalTeamIDToCurrentTeamMemberIndexesTable[ oldTeam ].append( newIndex )
			}
			else
				file.originalTeamIDToCurrentTeamMemberIndexesTable[ oldTeam ] <- [ newIndex ]
		}
	}
}
#endif // SERVER

// Get any team that belongs to an alliance. This is used in situations where logic calls for a team to be set on an entity and we just need it to be any team from the correct alliance
int function AllianceProximity_GetRepresentativeTeamForAlliance( int alliance )
{
	int repTeam = TEAM_INVALID

	#if SERVER
		if ( file.hasFinalizedTeamReassignments )
		{
			if ( alliance in file.allianceToReassignedTeamTable )
				return file.allianceToReassignedTeamTable[ alliance ]
		}
	#endif // SERVER

	#if SERVER || CLIENT
		array< int > populatedTeams = AllianceProximity_GetPopulatedTeamsInAlliance( alliance )

		if ( populatedTeams.len() > 0 )
		{
			foreach ( team in populatedTeams )
			{
				// Ensure the team is valid
				if ( GamemodeUtility_GetIsTeamIndexValidPlayerTeam( team ) )
				{
					repTeam = team
					break
				}
			}
		}

		// On Server and Client only try to grab an unpopulated team if a valid one wasn't found for this alliance
		if ( repTeam == TEAM_INVALID )
	#endif // SERVER || CLIENT
		{
			array<int> teamsInAlliance = AllianceProximity_GetTeamsInAlliance( alliance )

			if ( teamsInAlliance.len() > 0 )
			{
				// If there are no populated teams, just grab a valid team in the alliance
				// Can't test for population on the UI VM so grab a valid team this way
				foreach ( team in teamsInAlliance )
				{
					// Ensure the team is valid
					if ( GamemodeUtility_GetIsTeamIndexValidPlayerTeam( team ) )
					{
						repTeam = team
						break
					}
				}
			}
		}

	return repTeam
}

#if SERVER
// Get whether we have finished team reassignments for alliances ( see AllianceProximity_ReassignAlliancePlayersToTeams )
bool function AllianceProximity_GetHaveAlliancesBeenReassignedToTeams()
{
	return file.hasFinalizedTeamReassignments
}
#endif // SERVER

#if SERVER || CLIENT
// Get all teams (squads) of living players in this Alliance
array<int> function AllianceProximity_GetLivingPlayerTeamsInAlliance( int alliance )
{
	array<int> uniqueAllianceTeams = []
	array<entity> livingPlayers = GetPlayerArray_AliveConnected()

	foreach ( playerEnt in livingPlayers )
	{
		int playerEntTeam = playerEnt.GetTeam()
		int playerEntAlliance = AllianceProximity_GetAllianceFromTeam( playerEntTeam )
		if ( !uniqueAllianceTeams.contains( playerEntTeam ) && playerEntAlliance == alliance )
			uniqueAllianceTeams.append( playerEntTeam )
	}

	return uniqueAllianceTeams
}
#endif // SERVER || CLIENT


#if SERVER
// SERVER: Track the player's old team before we switch it up on game conclusion ( used to prevent issues until we do a refactor of how alliances are handled in end game flow)
void function AllianceProximity_OnPlayerConnected( entity player )
{
	if ( GetGameState() < eGameState.WinnerDetermined && IsValid( player ) )
	{
		int team = player.GetTeam()
		file.playerEHIToOriginalTeamTable[ ToEHI( player ) ] <- team
		int teamMemberIndex = player.GetTeamMemberIndex()

		if ( team in file.originalTeamIDToCurrentTeamMemberIndexesTable )
			file.originalTeamIDToCurrentTeamMemberIndexesTable[ team ].append( teamMemberIndex )
		else
			file.originalTeamIDToCurrentTeamMemberIndexesTable[ team ] <- [ teamMemberIndex ]

		// If we can change alliances mid match, make sure we update the data on the client if the player joins late
		// eGameState.PickLoadout not available — use Prematch as equivalent
		if ( AllianceProximity_IsMidMatchAllianceSwitchingEnabled() && GetGameState() > eGameState.Prematch )
			AllianceProximity_UpdateAllianceDataOnClientForPlayer( player )
	}
}
#endif // SERVER

#if SERVER
// SERVER: If needed, update alliance data on the client when a player reconnects to the match
void function AllianceProximity_OnPlayerConnectionRestored( entity player )
{
	if ( AllianceProximity_IsMidMatchAllianceSwitchingEnabled() && GetGameState() < eGameState.WinnerDetermined && IsValid( player ) )
		AllianceProximity_UpdateAllianceDataOnClientForPlayer( player )
}
#endif // SERVER

#if CLIENT
// CLIENT: Track the player's old team before we switch it up on game conclusion ( used to prevent issues until we do a refactor of how alliances are handled in end game flow)
void function AllianceProximity_OnPlayerCreated( entity player )
{
	if ( GetGameState() < eGameState.WinnerDetermined && IsValid( player ) )
		file.playerEHIToOriginalTeamTable[ ToEHI( player ) ] <- player.GetTeam()
}
#endif // CLIENT

#if CLIENT
void function AllianceProximity_MuteAllianceOnMatchEndReassignment()
{
	if ( GetGameState() < eGameState.WinnerDetermined )
		return

	entity localPlayer = GetLocalClientPlayer()

	if ( !IsValid( localPlayer ) )
		return

	EHI playerEhi = localPlayer.GetEncodedEHandle()
	int playerTeam = AllianceProximity_GetOriginalPlayerTeam_FromPlayerEHI( playerEhi )

	array< entity > teamPlayers = GetPlayerArrayOfTeam( localPlayer.GetTeam() )
	foreach( teamplayer in teamPlayers )
	{
		if ( !IsValid( teamplayer ) )
			continue

		EHI teamplayerEhi = teamplayer.GetEncodedEHandle()
		if ( playerTeam != AllianceProximity_GetOriginalPlayerTeam_FromPlayerEHI( teamplayerEhi ) )
		{
			SetPlayerTempMuted( teamplayer )
		}
	}
}
#endif // CLIENT

// Seperate out teams into alliances to populate the team to alliance table
// Setup alliances in code ( on the Server only )
void function AllianceProximity_SetTeamsToAlliances()
{
	int allianceIndex = 0
	array<int> allTeams = AllianceProximity_GetAllTeamsInAlliances( false )

	foreach ( team in allTeams )
	{
		AllianceProximity_SetTeamToAlliance_Internal( team, allianceIndex )

		// Only swap between alliances if we don't start everyone on the same alliance to start
		if ( !AllianceProximity_ShouldAllTeamsStartOnTheSameAlliance() )
		{
			allianceIndex++

			if ( allianceIndex >= AllianceProximity_GetMaxNumAlliances() )
				allianceIndex = 0
		}
	}
}

// Internal function for setting a team to an alliance. It sets the data on the Client as well.
// The external function that is used to change teams mid match runs on the server then does a server callback to use this function and update the data on the Client
void function AllianceProximity_SetTeamToAlliance_Internal( int team, int alliance )
{
	array<int> allTeams = AllianceProximity_GetAllTeamsInAlliances( false )

	if ( !allTeams.contains( team ) )
	{
		#if DEVELOPER
				Assert( false, "ALLIANCE PROXIMITY: " + FUNC_NAME() + " is trying to change the alliance for a team that doesn't exist: " + team + " if this is intentional try the AllianceProximity_RegisterNonPlayerTeamToAlliances function" )
		#endif // DEVELOPER
		return
	}

	if ( alliance >= AllianceProximity_GetMaxNumAlliances() )
	{
		#if DEVELOPER
			Assert( false, "ALLIANCE PROXIMITY: " + FUNC_NAME() + " is trying to put team: " + team + " into an invalid alliance: " + alliance )
		#endif // DEVELOPER
		return
	}

	int currentAlliance = team in file.teamToAllianceTable ? file.teamToAllianceTable[ team ] : ALLIANCE_NONE
	if ( currentAlliance == alliance )
	{
		printt( "ALLIANCE PROXIMITY: ", FUNC_NAME(), " Exiting, alliance passed in: ", alliance, " for team: ", team, " is the same as the current alliance: ", currentAlliance )
		return
	}


	#if DEVELOPER
		printt( "ALLIANCE PROXIMITY: Putting team ", team, " on Alliance ", alliance )
	#endif // DEVELOPER

	#if SERVER
		// Need to take the team out of the old alliance otherwise it will be treated as friendly even though the player is put on a new alliace.
		// SetTeamIsInAlliance not available — alliance team relationships are managed at script level only
		// SetTeamIsInAlliance( team, currentAlliance, false )
		// SetTeamIsInAlliance( team, alliance, true )
	#endif // SERVER

	// Update the team to alliance table
	file.teamToAllianceTable[ team ] <- alliance

	// Make sure we clear this team out from the old alliance array
	foreach( allianceToUpdate in file.allAlliances )
	{
		if ( allianceToUpdate in file.allianceToTeamsTable && file.allianceToTeamsTable[ allianceToUpdate ].contains( team ) )
			file.allianceToTeamsTable[ allianceToUpdate ].fastremovebyvalue( team )
	}

	// Update the alliance to teams table
	if ( alliance in file.allianceToTeamsTable )
	{
		file.allianceToTeamsTable[ alliance ].append( team )
	}
	else
	{
		file.allianceToTeamsTable[ alliance ] <- [ team ]
	}

	if ( !file.allAlliances.contains( alliance ) )
		file.allAlliances.append( alliance )

	// Trigger callback funcs for team changing alliances
	foreach ( func in file.callbacks_AllianceProximity_OnTeamPutIntoAlliance )
	{
		func( team, alliance )
	}
}

#if SERVER
// Put a team into an alliance, can be done mid match to switch a team from one alliance to another
void function AllianceProximity_SetTeamToAlliance( int team, int alliance )
{
	AllianceProximity_SetTeamToAlliance_Internal( team, alliance )

	// Calls the internal function from the server to make sure we have updated data on the Client ( since this function can be called externally on the server )
	array< entity > allPlayersArray = GetPlayerArray()
	foreach ( player in allPlayersArray )
	{
		if ( IsValid( player ) )
			Remote_CallFunction_NonReplay( player, "AllianceProximity_ServerCallback_SetTeamToAllianceOnClient", team, alliance )
	}
}
#endif // SERVER

#if CLIENT
// Put a team into an alliance on the Client. This is done when the alliance change is done midmatch ( from the external alliance change function )
void function AllianceProximity_ServerCallback_SetTeamToAllianceOnClient( int team, int alliance )
{
	AllianceProximity_SetTeamToAlliance_Internal( team, alliance )
}
#endif // CLIENT

#if SERVER
// Update team to alliance assignments on the client in situations where mid match alliance switching is possible
void function AllianceProximity_UpdateAllianceDataOnClientForPlayer( entity player )
{
	array<int> allTeams = AllianceProximity_GetAllTeamsInAlliances( false )

	foreach ( team in allTeams )
	{
		if ( team in file.teamToAllianceTable )
		{
			int alliance = file.teamToAllianceTable[ team ]
			Remote_CallFunction_NonReplay( player, "AllianceProximity_ServerCallback_SetTeamToAllianceOnClient", team, alliance )
		}
	}
}
#endif // SERVER

#if CLIENT
// Manage the visibility of client side icons based on player distance from icon source. Used for Team proximity logic (currently being used in the Control GameMode).
// With this logic, players on the same team (but not squad) can see pings and ability icons when in close proximity.
void function AllianceProximity_ManageIconVisibility_Thread( entity ent, var rui, bool isFullMapRui, bool ruiHasBuiltInDistTracking )
{
	entity player = GetLocalClientPlayer()
	// Only run this logic if we are culling the icons based on distance and using alliance proximity logic
	if ( !AllianceProximity_IsUsingAllianceProximityDistanceChecks() || !IsValid( player ) || !IsValid( ent ) )
		return

	// If this is a minimap Rui and the minimap is turned off, break out
	if ( file.isMinimapDisabled )
		return

	int playerTeam = player.GetTeam()
	int entTeam = ent.GetTeam()

	// Don't run this logic for icons that belong to the player that placed the ping/ability or their squad, this is only for team proximity logic
	if ( playerTeam == entTeam || !IsFriendlyTeam( playerTeam, entTeam ) || entTeam == 0 )
		return

	float maxProximity = AllianceProximity_GetMaxDistForProximity()

	// If an alliance member is near the player when they ping, allow the player to see the ping regardless of distance to the ping
	entity entOwner = ent.GetOwner()
	if ( IsValid( entOwner ) )
	{
		if ( entOwner.IsPlayer() && IsPositionWithinRadius( maxProximity, player.GetOrigin(), entOwner.GetOrigin() ) )
			return
	}

	if ( ruiHasBuiltInDistTracking )
	{
		RuiSetFloat( rui, "maxDrawDistance", maxProximity )
		return
	}

	while ( IsValid( player ) && IsValid( ent ) && IsValid( rui ) )
	{
		if ( IsPositionWithinRadius( maxProximity, player.GetOrigin(), ent.GetOrigin() ) )
		{
			if ( isFullMapRui )
			{
				RuiSetVisible( rui, Fullmap_IsVisible() )
			}
			else
			{
				RuiSetVisible( rui, true )
			}
		}
		else
		{
			RuiSetVisible( rui, false )
		}
		WaitFrame()
	}
}
#endif // CLIENT

#if SERVER
// In instances where we show an icon on the map to a team, run this logic if we also want to show that icon to alliance members
void function AllianceProximity_SetMinimapAlwaysShow_ForAlliance( int team, entity minimapObj, entity owner )
{
	if ( AllianceProximity_IsUsingAllianceProximity() && !file.isMinimapDisabled )
	{
		// If we pass in a valid owner, set them as the owner for the minimap object and set it's team.
		// This is done in case proximity checks need to be done, they need this info.
		// Some character logic already sets these in which case we don't do it here, but if they don't we should pass in the owner and do it here.
		if ( IsValid( owner ) )
		{
			SetTeam( minimapObj, team )
			minimapObj.SetOwner( owner )
		}

		array<int> teamsInSameAllianceAsTeam = AllianceProximity_GetLivingPlayerTeamsInSameAllianceAsTeam( team )

		foreach ( allianceTeam in teamsInSameAllianceAsTeam )
		{
			minimapObj.Minimap_AlwaysShow( allianceTeam, null )
		}
	}
}
#endif // SERVER

#if SERVER
// In instances where we would normally only transmit waypoint data to a single team but want to transmit it to all friendlies when using alliances
// transmit to friendlies using this function
void function AllianceProximity_SetOnlyTransmitWaypointToFriendlyTeams( entity wp, int team )
{
	if ( !IsValid( wp ) )
		return

	if ( AllianceProximity_IsUsingAllianceProximity() )
	{
		// SetOnlyTransmitToTeamAndFriendlyAlliance not available — fall back to single team
		wp.SetOnlyTransmitToSingleTeam( team )
	}
	else
	{
		wp.SetOnlyTransmitToSingleTeam( team )
	}
}
#endif // SERVER

#if CLIENT || SERVER
// Return the score difference between the highest scoring alliance and the lowest scoring alliance
int function AllianceProximity_GetAllianceScoreDifference()
{
	array< int > allAlliances = AllianceProximity_GetAllAlliances()
	int scoreDifference = 0

	// If we only have 2 alliances compare the highest score from one to the lowest score from the other
	if ( allAlliances.len() == 2 )
	{
		int allianceAScore = GetAllianceTeamsScore( ALLIANCE_A )
		int allianceBScore = GetAllianceTeamsScore( ALLIANCE_B )
		scoreDifference = maxint( allianceAScore, allianceBScore ) - minint( allianceAScore, allianceBScore )
	}
	else // If we don't have 2 alliances, go through all the alliances to figure out the highest and lowest scores then subtract them
	{
		int lowestScore = -1
		int highestScore = 0
		int currentAllianceScore = 0

		foreach( alliance in allAlliances )
		{
			currentAllianceScore = GetAllianceTeamsScore( alliance )
			lowestScore = currentAllianceScore < lowestScore || lowestScore == -1 ? currentAllianceScore : lowestScore
			highestScore = currentAllianceScore > highestScore ? currentAllianceScore : highestScore
		}
		scoreDifference = highestScore - lowestScore
	}


	return scoreDifference
}
#endif // CLIENT || SERVER

