array< array<string> > function GetContentsForRound( int dropIndex )
{
	AirdropRoundData aData = file.airdropData[ dropIndex ]

	array< array<string> > contents = aData.contents
	if ( aData.optionalGetContentsFunc != null )
	contents = aData.optionalGetContentsFunc( dropIndex )

	array< array<string> > podContents = DetermineAirdropContents ( contents )
	return podContents
}


void function AirdropForRound( vector origin, vector angles, int dropIndex )
{
	AirdropRoundData aData = file.airdropData[ dropIndex ]
	AirdropItemsOptionalInfo optionInfo
	optionInfo.animationName = aData.animation

	thread AirdropItems( origin, angles, GetContentsForRound( dropIndex ), optionInfo )
}

// DetermineAirdropContents is the final determination of airdrop loot.
// Loot groups are narrowed down to actual loot refs.
array< array<string> > function DetermineAirdropContents( array< array<string> > contents )
{
	array< array<string> > podContents
	for ( int i = 0; i < contents.len(); i++ )
	{
		array<string> inside
		foreach ( c in contents[i] )
		{
			if ( SURVIVAL_Loot_IsRefValid( c ) )
				inside.append( c )
			else
				inside.append( SURVIVAL_GetWeightedItemFromGroup( c ) )
		}
		podContents.append( inside )
	}
	int lootLen = podContents.len()
	int contentsLen = contents.len()
	#if DEVELOPER
		DEV_AirdropPrint( "***** DetermineAirdropContents(): Droppod: contents: " )
		foreach( contentList in contents )
			foreach( content in contentList )
				DEV_AirdropPrint( " - Droppod: content == " + content )
		DEV_AirdropPrint( "***** DetermineAirdropContents(): Droppod: podContents: " )
		foreach( podContentList in podContents )
			foreach( podContent in podContentList )
				DEV_AirdropPrint( "- Droppod: podContent == " + podContent )
	#endif

	Assert( lootLen >= contentsLen, "ERROR in DetermineAirdropContents(): contents.len() = " + contentsLen + " but podContents.len() = " + lootLen )

	return podContents
}

void function AirdropItems( vector origin, vector angles, array< array<string> > contents, AirdropItemsOptionalInfo optionInfo, bool saveEntity = false )
{
	array<string> doors 					= [ "L", "R", "C" ]
	array< array<string> > airdropContents 	= contents
	int airdropBeamColorID 					= COLORID_AIRDROP_LIFELINE_COLOR
	bool delayedContents 					= ( ( airdropContents.len() != doors.len() ) && ( optionInfo.delayedContentFunc != null ) )

	#if DEVELOPER
		DEV_AirdropPrint( "***** AirdropItems(): Droppod started @ time == " + Time() )
		DEV_AirdropPrint( " - Droppod: Number of doors 			== " + doors.len() )
		DEV_AirdropPrint( " - Droppod: Number of Contents 		== " + airdropContents.len() )
		DEV_AirdropPrint( " - Droppod: delayedContents? 			== " + delayedContents )
	#endif

	if ( !delayedContents )
	{
		Assert ( airdropContents.len() >= doors.len(), "Must have at least " + doors.len() + " entries in contents" )

		int highestContentsRarity = DetermineAirdropTier ( airdropContents )
		if ( optionInfo.targetName != CARE_PACKAGE_LIFELINE_TARGETNAME )
			airdropBeamColorID = file.airdropRarityColorEnabled ? GetAirdropBeamColorIDFromRarityTier( highestContentsRarity ) : COLORID_AIRDROP_DEFAULT_COLOR
	}

	                               
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_VALENTINES_S15 ) && optionInfo.targetName != CARE_PACKAGE_LIFELINE_TARGETNAME) //All airdrops except lifeline are valentines airdrops
			airdropBeamColorID = COLORID_HUD_LOOT_TIER_SPECIAL
       

	if ( optionInfo.forceDefaultColor ) //Used for Lifeline TT Carepackage
		airdropBeamColorID = COLORID_AIRDROP_DEFAULT_COLOR

	entity dropPod = CreatePropDynamic_NoDispatchSpawn( SURVIVAL_LOOT_POD_MODEL, origin, angles, 6 )
	dropPod.SetScriptName( CARE_PACKAGE_SCRIPTNAME )
	dropPod.e.sourceWeaponClassname = optionInfo.sourceWeaponClassname
	dropPod.EnableRenderAlways()
	dropPod.DisableHibernation()
	if ( IsValid( optionInfo.owner ) )
	{
		dropPod.SetOwner( optionInfo.owner )
		AddToUltimateRealm( optionInfo.owner, dropPod )
	}
	else if ( optionInfo.realm >= eRealms.DEFAULT )
	{
		dropPod.RemoveFromAllRealms()
		dropPod.AddToRealm( optionInfo.realm )
	}

	dropPod.SetSkin( optionInfo.skin )

	#if DEVELOPER
		if ( saveEntity )
			file.devAirdrops.append( dropPod )
	#endif // DEVELOPER

              
                                                                                                                                    
                                     
       

                                
                                                                            
   
                                    
                                                 
   
       

                                
                               
  
                                                                           
   
                                    
                                                     
   
  
      

	// Need to know if airdrop gets destroyed for some reason so we can turn off the vfx
	AddEntityDestroyedCallback( dropPod, OnAirdropDestroyed )

	SetTargetName( dropPod, optionInfo.targetName )
	DispatchSpawn( dropPod )

	dropPod.SetAIObstacle( true )
	TeslaTrap_MakeEntityRealTimeObstructor( dropPod )
	MarkEntForCleanupOnRoundEnd( dropPod )

	if ( IsValid( optionInfo.owner ) )
		FiringRange_AddToPermanentDeployableQuota( dropPod, optionInfo.owner )

	dropPod.EndSignal( "OnDestroy" )
	
	CreateAirdropBadPlace( dropPod, origin, AIR_DROP_BAD_PLACE_RADIUS )

	int podFlags = 0
	dropPod.Solid()
	dropPod.DisallowZiplines()

	dropPod.Highlight_Enable()
	AddNeurolinkDetectionForPropScript( dropPod )

	if( optionInfo.targetName == CARE_PACKAGE_LIFELINE_TARGETNAME )
	{
		SetTeam( dropPod, optionInfo.owner.GetTeam() )
		thread DropPodLocationMarker( dropPod, optionInfo.owner, airdropBeamColorID )
	}
	else
	{
		thread DropPodLocationMarker( dropPod, optionInfo.owner, airdropBeamColorID )
		thread DropPodLocationBeam( dropPod, optionInfo.owner, airdropBeamColorID )
	}
	vector soundOrigin = dropPod.GetOrigin()
	EmitSoundAtPosition( TEAM_UNASSIGNED, soundOrigin, SOUND_CARE_PACKAGE_MARKER, dropPod )

	OnThreadEnd(
		function() : ( soundOrigin )
		{
			// incase the droppod gets destroyed before it lands. Shouldn't happen but better safe ...
			StopSoundAtPosition( soundOrigin, SOUND_CARE_PACKAGE_MARKER )
		}
	)

	// amazing R5DEV-293895 - need to set the care package from being used before landing
	dropPod.e.isBusy = true

	                   
	dropPod.e.airDropContents = airdropContents
       

	foreach ( callbackFunc in file.Callbacks_OnAirdropLaunched )
		callbackFunc( dropPod, origin )

	if ( Time() > 30 )
		Leviathan_ConsiderLookAtEnt( dropPod, RandomFloatRange( 10, 16 ), 0.2 )

	if ( optionInfo.animatePod )
		waitthread AnimateAirdropPod( dropPod, origin, angles, optionInfo.animationName )
	else
		dropPod.Signal( "StopBraking" )


	if ( delayedContents )
		airdropContents = optionInfo.delayedContentFunc( optionInfo )

	StopSoundAtPosition( soundOrigin, SOUND_CARE_PACKAGE_MARKER )

	dropPod.AllowZiplines()

	// amazing R5DEV-293895 - need to set the care package from being used before landing
	dropPod.e.isBusy = false

	foreach ( callbackFunc in file.Callbacks_OnAirdropLanded )
		callbackFunc( dropPod, origin )

	DEV_AirdropPrint( "***** AirdropItems(): Droppod landing finished @ time == " + Time() )

	EmitSoundOnEntity( dropPod, SOUND_CARE_PACKAGE_STEAM )

	thread PlayAnim( dropPod, "droppod_loot_closed_idle" )

	dropPod.SetUsable()
	dropPod.SetUsableByGroup( "pilot" )
	dropPod.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN )
	dropPod.SetUsePrompts( "#SURVIVAL_DROPPOD_USE", "#SURVIVAL_DROPPOD_USE" )

	table < string, array<entity> > itemsSpawnedForPodDoor
	for ( int i = 0; i < airdropContents.len(); i++ ) // NOTE: This assumes airdropContents.len() == doors.len().
	{
		itemsSpawnedForPodDoor[ doors[i] ]<-DroppodDoorThink( dropPod, doors[i], airdropContents[i] )
	}


	DEV_AirdropPrint( "***** AirdropItems(): Droppod items spawned @ time == " + Time() )

	// DOOR ITEMS CHECK: Check to ensure all doors are stocked.
	foreach( door in doors )
	{
		Assert( itemsSpawnedForPodDoor[ door ].len() > 0, "ERROR in AirdropItems(): Pod Door " + door + "is empty!!!" )
		foreach( lootItem  in itemsSpawnedForPodDoor[ door ] )
		{
			Assert( IsValid( lootItem ), "ERROR in AirdropItems(): Invalid Item in spawnedLoot array: " + lootItem )
		}
	}

	PIN_AirdropAction ( "care_package", origin )

	if( optionInfo.targetName == CARE_PACKAGE_LIFELINE_TARGETNAME )
		thread DropPodLocationBeam( dropPod, optionInfo.owner, airdropBeamColorID, true )


	// Display a hologram effect on top of the package if using the Chevrex skin
	if ( optionInfo.skin == CHEVREX_AIRDROP_SKIN_INDEX )
	{
		// If there is already an effect on this drop pod, stop it before playing the new one ( There really shouldn't be)
		if ( dropPod in file.dropPodToVFXEntityTable )
		{
			entity effect = file.dropPodToVFXEntityTable[ dropPod ]
			if ( IsValid( effect ) )
				EffectStop( effect )
		}

		entity fx = StartParticleEffectOnEntityWithPos_ReturnEntity( dropPod, GetParticleSystemIndex( CHEVREX_AIRDROP_HOLOGRAM_VFX ), FX_PATTACH_POINT_FOLLOW_NOROTATE, dropPod.LookupAttachment( "FX_LIGHT" ), <0,0,0>, <-90,0,0>)
		EffectSetControlPointVector( fx, 1, CHEVREX_AIRDROP_HOLOGRAM_VFX_COL )
		file.dropPodToVFXEntityTable[ dropPod ] <- fx
	}

	dropPod.WaitSignal( "OpenDroppod" )

	DEV_AirdropPrint( "***** AirdropItems(): Droppod doors opened @ time == " + Time() )

	dropPod.UnsetUsable()
	dropPod.EnableHibernation()

	thread DroppodDoorReorientLoot( dropPod )
}

void function DroppodDoorReorientLoot ( entity dropPod, bool shouldWait = true, bool isCrafting = false )
{
	if ( shouldWait )
		wait 0.8 // delay for the doors to open

	if ( !IsValid( dropPod ) )
		return

	array<entity> spawnedLoot = AirdropGetSpawnedLoot( dropPod )

	DEV_AirdropPrint( "***** DroppodDoorReorientLoot(): spawnedLoot count == " + spawnedLoot.len() )

	foreach (lootEnt in spawnedLoot)
	{
		Assert( IsValid( lootEnt), "----- ERROR in DroppodDoorReorientLoot(): item is invalid." )

		vector localPos = lootEnt.GetLocalOrigin()
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( lootEnt.GetSurvivalInt() )
		vector offset = GetOffsetForAirdropLoot( data.lootType )

		DEV_AirdropPrint( "***** DroppodDoorReorientLoot(): offset vector == " + offset )

		lootEnt.SetLocalOrigin( localPos - offset )

		PropSurvivalFlagsClear( lootEnt, ePropSurvivalFlag.HIDE_LOOT_LINE )
		lootEnt.MakeVisible()
		lootEnt.SetUsable()
		lootEnt.SetUsableByGroup( "pilot" )
		lootEnt.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )

		#if DEVELOPER
			AddEntityDestroyedCallback( lootEnt, OnDestroyedDroppodLootItem )
		#endif
	}

	// [ R5DEV-348463 ] Check on and Assert visibility for all spawned Loot.
	DEV_AirdropPrint( "***** DroppodDoorReorientLoot() Reoriented Loot @ time == " + Time() )
	DEV_AirdropPrint( " - Droppod: Droppod Location  	== " + dropPod.GetOrigin() )
	DEV_AirdropPrint( " - Droppod: Items Count 		== " + spawnedLoot.len() )

	WaitFrame()
	foreach( lootEnt in spawnedLoot )
	{
		if( IsValid( lootEnt ) )
		{
			DEV_AirdropPrint( " - DroppodDoorReorientLoot(): lootEnt " + lootEnt.GetScriptName() + " visibility flags == " + lootEnt.kv.VisibilityFlags )
			Assert( lootEnt.kv.VisibilityFlags == string( ENTITY_VISIBLE_TO_EVERYONE ), "ERROR in DroppodDoorReorientLoot(): Item not visible: " + lootEnt )
		}
	}
}

array<entity> function DroppodDoorThink( entity dropPod, string doorPosition, array<string> items, bool isCrafting = false )
{
	// TODO : uncomment this when we get additive anim support

	array<entity> spawnedLoot

	dropPod.EndSignal( "OnDestroy" )

	array<vector> offsets

	bool hasHealthItem = false
	bool hasWeapon     = false
	bool hasAttachment = false
	bool hasAmmo	   = false

	LootData data
	for ( int i = 0; i < items.len(); i++ )
	{
		data = SURVIVAL_Loot_GetLootDataByRef( items[i] )

		if ( data.lootType == eLootType.MAINWEAPON )
			hasWeapon = true
		else if ( data.lootType == eLootType.HEALTH )
			hasHealthItem = true
		else if ( data.lootType == eLootType.ATTACHMENT )
			hasAttachment = true
		else if ( data.lootType == eLootType.AMMO )
			hasAmmo = true
	}

	bool useAttachmentCustomOffset = hasWeapon && hasAttachment ? true : false

	switch ( items.len() )
	{
		case 1:
			if ( isCrafting == true && hasHealthItem && items.contains( "health_pickup_combo_large" ) )
			{
				offsets = [ < 0, 0, -8 > ]
			}
			else if( isCrafting == true && hasHealthItem && items.contains( "health_pickup_health_large" ) )
			{
				offsets = [ < -5, 0, 0 > ]
			}
			else
			{
				offsets = [ < 0, 0, 0 > ]
			}
			break

		case 2:
			if ( !hasWeapon && hasAmmo ) // Made this specific so it doesn't interfere with the munitions drop perk which assault legends have.
			{
				float z = 14.0
				float y = 6.0
				offsets = [ <0, -y, z * 0.75>,
					<0, -y, -z> ]
			}
			else if ( isCrafting == true && hasHealthItem && items.contains( "health_pickup_combo_large" ) )
			{
				float z = 8.0
				float y = 6.0
				offsets = [ <0, y, -z>,
					<0, -y, -z> ]
			}
			else if ( !hasWeapon )
			{
				float z = 14.0
				float y = 6.0
				offsets = [ <0, y, z * 0.75>,
					<0, -y, -z> ]
			}
			else
			{
				float y = 6.0

				if ( useAttachmentCustomOffset )
					offsets = [ <0, 0, 0>, <0, -8, 16.0> ]
				else
					offsets = [ <0, y, 0>, <0, -y, 0> ]
			}
			break

		case 3:
			float z = 14.0
			float y = 8.0
			offsets = [ <0, 0, z * 0.75>,
				<0, y, -z>,
				<0, -y, -z> ]
			break

		case 4:
			float z = 16.0
			float y = 8.0
			offsets = [ <0, y, z>,
				<0, -y, z>,
				<0, y, -z>,
				<0, -y, -z> ]
			break

		default:
			Assert( false, "care package does not support " + items.len() + " items" )
			return spawnedLoot
	}

	// stupid special case to put giant health kit to the bottom
	array<string> refToPutInBottom = [
		"health_pickup_health_large",
		"backpack_pickup_lv1",
		"backpack_pickup_lv2",
		"backpack_pickup_lv3",
		"backpack_pickup_lv4_revive_boost"
	]
	if ( items.len() > 1 )
	{
		foreach ( ref in refToPutInBottom )
		{
			if ( items.contains( ref ) )
			{
				int idx = items.find( ref )
				items.remove( idx )
				items.append( ref )
			}
		}
	}

	for ( int i = 0; i < items.len(); i++ )
		spawnedLoot.extend( SpawnLootInDropPod( dropPod, items[i], doorPosition, 1, offsets[i], isCrafting ) )

	#if DEVELOPER
		DEV_AirdropPrint( "***** DroppodDoorThink(): Droppod Door lootItems spawned @ time == " + Time() )
		DEV_AirdropPrint( " - Droppod: Droppod Location  	== " + dropPod.GetOrigin() )
		DEV_AirdropPrint( " - Droppod: Droppod Door ID		== " + doorPosition )
		DEV_AirdropPrint( " - Droppod: Items Count 		== " + spawnedLoot.len() )
	#endif
	return spawnedLoot
}

vector function GetOffsetForAirdropLoot( int lootType )
{
	switch ( lootType )
	{
		case eLootType.MAINWEAPON:
			return AIRDROP_LOOT_OFFSET_WEAPON
		case eLootType.BACKPACK:
			return AIRDROP_LOOT_OFFSET_BACKPACK
		case eLootType.HELMET:
			return AIRDROP_LOOT_OFFSET_HELMET
		case eLootType.INCAPSHIELD:
			return AIRDROP_LOOT_OFFSET_INCAPSHIELD
		case eLootType.ARMOR:
			return AIRDROP_LOOT_OFFSET_ARMOR
		case eLootType.AMMO:
			return AIRDROP_LOOT_OFFSET_AMMO
		case eLootType.HEALTH:
			return AIRDROP_LOOT_OFFSET_HEALING
		case eLootType.ORDNANCE:
		case eLootType.GADGET:
			return AIRDROP_LOOT_OFFSET_GADGET
		case eLootType.ATTACHMENT:
			return AIRDROP_LOOT_OFFSET_ATTACHMENT
	}

	Warning( "WARNING --- GetOffsetForAirdropLoot() got unknown lootType == " + lootType )
	return < 0, 0, 0 >
}

array<entity> function AirdropGetSpawnedLoot( entity airdropPod )
{
	array<entity> loot = []
	// S3: GetChildren() entity method not available
	Warning( "GetAirdropLoot: GetChildren not available in S3" )
	return loot
}

array<entity> function SpawnLootInDropPod( entity dropPod, string item, string doorPosition, int spotIndex = 1, vector originOffset = <0, 0, 0>, bool isCrafting = false, bool craftingAmmo = true )
{
	array<entity> allSpawnedLoot

	LootData data = SURVIVAL_Loot_GetLootDataByRef( item )

	string suffix            = "_MID"
	vector objectAngleOffset = <0, 0, 0>
	bool shouldSpawnOrdnanceWithWeapons = GetCurrentPlaylistVarBool( "airdrop_spawn_ordnance_with_weapons", false )
	switch ( data.lootType )
	{
		case eLootType.MAINWEAPON:
			suffix = "_TOP"
			bool spawnAmmo = !SURVIVAL_Loot_IsAmmoSpawningDisabled()

			if ( isCrafting )
			{
				spawnAmmo = false
				originOffset -= <10, 0, 3>

				// If a Crate weapon is in crafting, this check allows it to spawn without it's ammo
				// TODO We should refactor this and the lower section that also checks for ammo to be cleaner.
				if ( GetWeaponInfoFileKeyField_GlobalBool( data.baseWeapon, "uses_ammo_pool" ) )
				{
					array<entity> recloot1 = SpawnLootInDropPod( dropPod, data.ammoType, doorPosition, spotIndex, <2, 0, 5>, true, false )
					allSpawnedLoot.extend( recloot1 )

					array<entity> recLoot2 = SpawnLootInDropPod( dropPod, data.ammoType, doorPosition, spotIndex, <2, 0, -15>, true, false )
					allSpawnedLoot.extend( recLoot2 )
				}

				if ( data.baseWeapon == "mp_weapon_autopistol" || data.baseWeapon == "mp_weapon_semipistol" || data.baseWeapon == "mp_weapon_shotgun_pistol" )
				{
					array<entity> attachment = SpawnLootInDropPod( dropPod, "hopup_unshielded_dmg", doorPosition, spotIndex, <2, -5, 8>, true, false )
					allSpawnedLoot.extend( attachment )
				}
			}
                        
                                                                                                                                   
                                          
     
                                                     
      
                                                                                                                                             
                                       
      
     
         

			// For modes with infinite ammo, spawn ordnance instead of ammo with weapons
			if ( shouldSpawnOrdnanceWithWeapons )
			{
				string ordnanceLootGroup = GetCurrentPlaylistVarString( "airdrop_weapon_ordnance_loot_group", "control_ordnance" )
				spawnAmmo = false
				if ( data.baseWeapon == "mp_weapon_dragon_lmg" )
				{
					array<entity> recLoot1 = SpawnLootInDropPod( dropPod, "mp_weapon_thermite_grenade", doorPosition, spotIndex, originOffset + <0, originOffset.y, 15> )
					allSpawnedLoot.extend( recLoot1 )
				}
				else
				{
					array<entity> recLoot1 = SpawnLootInDropPod( dropPod, SURVIVAL_GetWeightedItemFromGroup( ordnanceLootGroup ), doorPosition, spotIndex, originOffset + <0, originOffset.y, 15> )
					allSpawnedLoot.extend( recLoot1 )
				}
			}

			if ( GetWeaponInfoFileKeyField_GlobalBool( data.baseWeapon, "uses_ammo_pool" ) && spawnAmmo )
			{
				array<entity> recloot1 = SpawnLootInDropPod( dropPod, data.ammoType, doorPosition, spotIndex, originOffset + <0, originOffset.y, -2> )
				array<entity> recLoot2 = SpawnLootInDropPod( dropPod, data.ammoType, doorPosition, spotIndex, originOffset + <0, originOffset.y, 15> )

				allSpawnedLoot.extend( recloot1 )
				allSpawnedLoot.extend( recLoot2 )
			}
			originOffset -= <0, 0, 5>

      		                         
			if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_HEATWAVE ) )
			{
				if ( data.tier >= eLootTier.MYTHIC )
				{
					if ( data.baseWeapon == "mp_weapon_hemlok" )
					{
						array<entity> recLoot1 = SpawnLootInDropPod( dropPod, "helmet_pickup_lv5_sunglasses", doorPosition, spotIndex, originOffset + < 0, 11, 7.5> )
						allSpawnedLoot.extend( recLoot1 )
					}

					else if ( data.baseWeapon == "mp_weapon_bow" )
					{
						array<entity> recLoot1 = SpawnLootInDropPod( dropPod, "helmet_pickup_lv5_sunglasses", doorPosition, spotIndex, originOffset + < 0, 0, 25> )
						allSpawnedLoot.extend( recLoot1 )
					}

					else
					{
						array<entity> recLoot1 = SpawnLootInDropPod( dropPod, "helmet_pickup_lv5_sunglasses", doorPosition, spotIndex, originOffset + < 0, 9, 10.5> )
						allSpawnedLoot.extend( recLoot1 )
					}

				}
			}
                                   

			break

		case eLootType.AMMO:
			suffix = "_AMMO_" + spotIndex
			break


		// We are spawning ordnance instead of ammo in modes with infinite ammo, but would still like it to spawn in the same positions
		case eLootType.ORDNANCE:
			if ( shouldSpawnOrdnanceWithWeapons )
				suffix = "_AMMO_" + spotIndex
			break

		case eLootType.HEALTH:
			if ( shouldSpawnOrdnanceWithWeapons )
				suffix = "_AMMO_" + spotIndex
			break

	}

	if ( data.droppodRotate )
	{
		objectAngleOffset = <90, 0, 0>
	}

	                   
	if( isCrafting && data.ref == CRAFTED_BANNER_REF )
	{
		objectAngleOffset = <90, 0, 0>
	}
       

	                         
		if (data.ref == "helmet_pickup_lv5_sunglasses" )
		{
			originOffset.x -= 3
			objectAngleOffset = <90, 90, 90>
		}
       

	                          
		if (data.ref == "mp_weapon_titan_sword" )
		{
			originOffset.x -= 15
			originOffset.z += 6
		}
       

	                    
		if (data.ref == "mp_pickup_xp_cache_dynamic" )
		{
			originOffset.x -=1
		}
       

	string lootAttachmentRef = "LOOT_" + doorPosition + suffix
	int lootAttachmentPoint  = dropPod.LookupAttachment( lootAttachmentRef )
	vector attachmentAngles  = dropPod.GetAttachmentAngles( lootAttachmentPoint )
	vector lootAngles        = AnglesCompose( attachmentAngles, objectAngleOffset )
	vector lootOrigin        = dropPod.GetAttachmentOrigin( lootAttachmentPoint ) + AnglesToForward( lootAngles )

	vector up     = AnglesToUp( attachmentAngles )
	vector fwd    = AnglesToForward( attachmentAngles )
	vector rgt    = AnglesToRight( attachmentAngles )
	vector offset = fwd * originOffset.x + rgt * originOffset.y + up * originOffset.z

	int count = data.countPerDrop


                
	if ( !isCrafting )
      
		if ( data.lootType == eLootType.AMMO )
			count = data.inventorySlotCount

              
                                                                  
   
                                               
    
                              
     
               
     
    
   
       
	if ( isCrafting )
	{
		if ( data.lootType == eLootType.AMMO && craftingAmmo )
		{
			if ( data.ref == BULLET_AMMO || data.ref == HIGHCAL_AMMO || data.ref == SPECIAL_AMMO )
			{
				count = count * CRAFTING_AMMO_MULTIPLIER
				if ( Crafting_IsDispenserCraftingEnabled() )
				{
					count = data.countPerDrop
					count = count * DISPENSERS_CRAFTING_AMMO_MULTIPLIER
				}
			}

			if ( data.ref == SHOTGUN_AMMO || data.ref == ARROWS_AMMO || data.ref == SNIPER_AMMO )
			{
				count = count * CRAFTING_AMMO_MULTIPLIER_SMALL
				if ( Crafting_IsDispenserCraftingEnabled() )
				{
					count = data.countPerDrop
					count = count * DISPENSERS_CRAFTING_AMMO_MULTIPLIER_SMALL
				}
			}
		}
	}

	if( data.lootType == eLootType.MAINWEAPON )
		count = -1

	entity loot = SpawnGenericLoot( item, lootOrigin + offset, lootAngles, count, TRACE_COLLISION_GROUP_BLOCK_WEAPONS )

                        
                                                                                                 
                                                                                      
  
                                       
                                                                                        
                                                                  
                                                       

                                                                          
                                                                                   

                                    
   
                                                                                          

                         
    
                                                                         
                                                                                                      
                       
     
                                                                            
                                         
     
    
   
  
       

                
	if ( isCrafting )
		SetItemSpawnSource( loot, eSpawnSource.CRAFTING, dropPod )
	else
      
		SetItemSpawnSource( loot, eSpawnSource.DROPPOD, dropPod )
	loot.SetParent( dropPod, lootAttachmentRef, true )
	loot.RemoveFromAllRealms()
	loot.AddToOtherEntitysRealms( dropPod )

                
	if ( !isCrafting )
      
	{
		vector localPos = loot.GetLocalOrigin()
		vector internal_offset = GetOffsetForAirdropLoot( data.lootType )
		loot.SetLocalOrigin( localPos + internal_offset )

		PropSurvivalFlagsSet( loot, ePropSurvivalFlag.HIDE_LOOT_LINE )
		loot.SetUsable()
		loot.SetUsableByGroup( "pilot" )
		loot.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_USE_COLLISION_ORIGIN | USABLE_USE_VERTICAL_LINE | USABLE_HORIZONTAL_FOV | USABLE_HIGH_DETAIL_TRACE )

		if ( data.tier >= eLootTier.EPIC )
			loot.MakeVisible()
		else
			loot.MakeInvisible()
	}
                                      
     
  
                                        
                                                     
  
      

	allSpawnedLoot.append( loot )
	return allSpawnedLoot
}

void function DropPodLocationMarker( entity dropPod, entity owner, int colorID = COLORID_AIRDROP_DEFAULT_COLOR, asset markerParticleSystem = FX_AIRDROP_GROUND_MARKER_DEFAULT_CP )
{
	int markerIndex = GetParticleSystemIndex( markerParticleSystem )
	entity markerFx = StartParticleEffectInWorld_ReturnEntity( markerIndex, dropPod.GetOrigin(), dropPod.GetAngles() )
	EffectSetControlPointColorById( markerFx, 1, colorID )

	entity threatIndicator = CreateThreatIndicator( dropPod.GetOrigin() + <0, 0, 48>, eThreatIndicatorID.GRENADE_INDICATOR_GENERIC, 128.0 )
	threatIndicator.RemoveFromAllRealms()
	threatIndicator.AddToOtherEntitysRealms( dropPod )

	markerFx.RemoveFromAllRealms()
	markerFx.AddToOtherEntitysRealms( dropPod )

	dropPod.EndSignal( "OnDestroy" )
	dropPod.EndSignal( "OpenDroppod" )
	dropPod.EndSignal( "OnDeath" )
	dropPod.EndSignal( "DroppodRemoveLocationMarker" )


	OnThreadEnd(
		function() : ( markerFx, threatIndicator )
		{
			if ( IsValid( markerFx ) )
				EffectStop( markerFx )

			if ( IsValid( threatIndicator ) )
				threatIndicator.Destroy()
		}
	)

	dropPod.WaitSignal( "StopBraking" )
	if ( IsValid( markerFx ) )
	{
		EffectStop( markerFx )
	}
	if ( IsValid( threatIndicator ) )
	{
		threatIndicator.Destroy()
	}

	WaitForever()
}

void function DropPodLocationBeam( entity dropPod, entity owner, int colorID = COLORID_AIRDROP_DEFAULT_COLOR, bool IsLifelineCarePackage = false, asset beamParticleSystem = FX_AIRDROP_BEAM_CP )
{
	int beamIndex       = GetParticleSystemIndex( beamParticleSystem )
	entity beamFx       = StartParticleEffectInWorld_ReturnEntity( beamIndex, dropPod.GetOrigin(), dropPod.GetAngles() + <0, 180, 0> )
	entity markerSource = CreateScriptMover( AIRDROP_MOVER_SCRIPTNAME, dropPod.GetOrigin(), dropPod.GetAngles() )
	EffectSetControlPointColorById( beamFx, 1, colorID )

	beamFx.RemoveFromAllRealms()
	beamFx.AddToOtherEntitysRealms( dropPod )
	                            
		if ( GetCurrentPlaylistVarBool( "lifeline_res_slow_disabled", true ) )
		{
			if ( IsLifelineCarePackage )
			{
				SetTeam(beamFx, dropPod.GetTeam())
				beamFx.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY
			}
		}
       

	dropPod.EndSignal( "OnDestroy" )
	dropPod.EndSignal( "OpenDroppod" )
	dropPod.EndSignal( "OnDeath" )
	dropPod.EndSignal( "DroppodRemoveLocationMarker" )


	OnThreadEnd(
		function() : ( markerSource, beamFx )
		{
			if ( IsValid( markerSource ) )
				markerSource.Destroy()
			EffectStop( beamFx )
		}
	)

	dropPod.WaitSignal( "StopBraking" )

	WaitForever()
}

void function Survival_AddCallback_OnAirdropPositionsDetermined( void functionref() callbackFunc )
{
	Assert( !file.Callbacks_OnAirdropPositionsDetermined.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with Survival_AddCallback_OnAirdropPositionsDetermined" )
	file.Callbacks_OnAirdropPositionsDetermined.append( callbackFunc )
}

