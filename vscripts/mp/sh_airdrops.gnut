const vector AIRDROP_LOOT_OFFSET_INCAPSHIELD 	= <-5, 0, 0>
const vector AIRDROP_LOOT_OFFSET_AMMO 			= <-3, 0, 0>
const vector AIRDROP_LOOT_OFFSET_WEAPON 		= <-4, 8, -8>
const vector AIRDROP_LOOT_OFFSET_GADGET			= <-5, 0, 0>
