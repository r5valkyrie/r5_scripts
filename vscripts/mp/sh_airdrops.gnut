			vector origin = aData.originArray[i]
			//DebugDrawArrow( origin + <0, 0, 7000>, origin, 128, <0, 255, 0>, true, 100.0 )
			//DebugDrawCircle( origin, <0,0,0>, 32, <0, 255, 0>, true, 100.0 )
		}
	}
	else
	{
		AirdropRoundData aData = file.airdropData[ maxint( round - 1, 0 ) ]
		thread Survival_LaunchAirdropsFromAirdropData( aData, true )

		for ( int i = 0; i < aData.originArray.len(); i++ )
		{
			vector origin = aData.originArray[i]
			//DebugDrawArrow( origin + <0, 0, 7000>, origin, 128, <0, 255, 0>, true, 100.0 )
			//DebugDrawCircle( origin, <0,0,0>, 32, <0, 255, 0>, true, 100.0 )
		}
	}

	thread DEV_LaunchCraftersForRound_Thread( round )
}

void function DEV_LaunchCraftersForRound( int round )
{
	thread DEV_LaunchCraftersForRound_Thread( round )
}

// copies logic from Crafting_WorkbenchAirdropLogic()
void function DEV_LaunchCraftersForRound_Thread( int round )
{
	if ( file.stageToAmountTable.len() == 0 )
	{
		string playlistVar = GetCurrentPlaylistVarString( "crafting_midgame_airdrop_stages", "1:2 2:1" )
		array<string> airdropStrings = GetTrimmedSplitString( playlistVar, " " )

		foreach( stage in airdropStrings )
		{
			array<string> tokens = GetTrimmedSplitString( stage, ":" )
			file.stageToAmountTable[int(tokens[0])-1] <- int(tokens[1])
		}
	}

	if ( !( round in file.stageToAmountTable ) )
		return

	int dropCount = file.stageToAmountTable[ round ]
	thread Crafting_WorkbenchAirdropLogicForRound_Thread( dropCount, true, round )
}

void function DEV_LaunchAirdropsForAllRounds()
{
	foreach( airdropData in file.airdropData )
	{
		thread Survival_LaunchAirdropsFromAirdropData( airdropData, true )

		foreach ( origin in airdropData.originArray )
		{
			//DebugDrawArrow( origin + <0, 0, 7000>, origin, 128, <0, 255, 0>, true, 100.0 )
			//DebugDrawCircle( origin, <0,0,0>, 32, <0, 255, 0>, true, 100.0 )
		}

		DEV_DrawCircleLocations( -1, -1, 100.0 )
	}

	if ( GetCurrentPlaylistVarBool( "crafting_midgame_airdrop_enabled", true ) )
	{
		thread DEV_LaunchCraftersForAllRounds_Thread()
	}
}

// This won't launch the actual crafters for all rounds as their locations are only chosen when the round begins, this
// is just a replica of that logic
void function DEV_LaunchCraftersForAllRounds_Thread()
{
	if ( file.stageToAmountTable.len() == 0 )
	{
		string playlistVar = GetCurrentPlaylistVarString( "crafting_midgame_airdrop_stages", "1:2 2:1" )
		array<string> airdropStrings = GetTrimmedSplitString( playlistVar, " " )

		foreach( stage in airdropStrings )
		{
			array<string> tokens = GetTrimmedSplitString( stage, ":" )
			file.stageToAmountTable[int(tokens[0])-1] <- int(tokens[1])
		}
	}

	foreach( round, dropCount in file.stageToAmountTable )
	{
		thread DEV_LaunchCraftersForRound_Thread( round )
	}
}

// Drops airdrop at closest navmesh location
void function DEV_CallAirdropAtCrosshairLocation( entity player, bool dropPackageNotCrafter, bool animatePod = true )
{
	Point airdropPos = GetClosestAirdropPoint( GetPlayerCrosshairOrigin( player ) )

	array< array<string> > podContents
	if ( GetBugReproNum() == 417823 )
	{
		podContents = DetermineAirdropContents ( [["armor_pickup_lv2_evolving"], ["armor_pickup_lv3_evolving"], ["armor_pickup_lv5_evolving"]] )
	}
	else
	{
		podContents = DetermineAirdropContents ( [["crate_weapons_lategame"], ["gold_weapons"], ["gold_weapons"]] )
	}
	AirdropItemsOptionalInfo optionInfo
	optionInfo.animatePod = animatePod

	if ( dropPackageNotCrafter )
	{
		thread AirdropItems( airdropPos.origin, airdropPos.angles, podContents, optionInfo, true )

		//DebugDrawCircle( airdropPos.origin, airdropPos.angles, 32, <0, 255, 0>, true, 100.0 )
		//DebugDrawArrow( airdropPos.origin + <0, 0, 7000>, airdropPos.origin, 128, <0, 255, 0>, true, 100.0 )
	}
	else
	{
		thread AirdropWorkbench_Thread( airdropPos.origin, airdropPos.angles, animatePod, true )

		//DebugDrawCircle( airdropPos.origin, airdropPos.angles, 32, <255, 0, 0>, true, 100.0 )
		//DebugDrawArrow( airdropPos.origin + <0, 0, 7000>, airdropPos.origin, 128, <255, 0, 0>, true, 100.0 )
	}
}

// Drops airdrop somewhere nearby a location, uses FindRandomAirdropDropPoint_Thread
void function DEV_CallAirdropNearPlayer( entity player, float radius, bool dropPackageNotCrafter, bool animatePod = true )
{
	thread DEV_CallAirdropNearPlayer_Thread( player.GetOrigin(), radius, dropPackageNotCrafter, animatePod )
}

void function DEV_CallAirdropNearPlayer_Thread( vector center, float radius, bool dropPackageNotCrafter, bool animatePod )
{
	int randomSeedIntForCircleCenter = -1
	if ( IsLockedLootActive() )
		randomSeedIntForCircleCenter = GetRandomSeedIntForLoot()

	center = GetGroundPosition( center - <0, 4000, 0>,  center + <0, 4000, 0> ).endPos

	Point airdropPoint
	waitthread FindRandomAirdropDropPoint_Thread( airdropPoint, RandomFloatForLoot( 360.0 ), center, radius, [], true, -1, randomSeedIntForCircleCenter, MIN_AIRDROP_DISPLACEMENT )

	if ( dropPackageNotCrafter )
	{
		//DebugDrawCircle( airdropPoint.origin, airdropPoint.angles, 32, <0, 255, 0>, true, 100.0 )
		//DebugDrawArrow( airdropPoint.origin + <0, 0, 7000>, airdropPoint.origin, 128, <0, 255, 0>, true, 100.0 )

		array< array<string> > podContents = DetermineAirdropContents ( [["crate_weapons_lategame"], ["gold_weapons"], ["gold_weapons"]] )
		AirdropItemsOptionalInfo optionInfo
		optionInfo.animatePod = animatePod

		thread AirdropItems( airdropPoint.origin, airdropPoint.angles, podContents, optionInfo, true )
	}
	else
	{
		//DebugDrawCircle( airdropPoint.origin, airdropPoint.angles, 32, <255, 0, 0>, true, 100.0 )
		//DebugDrawArrow( airdropPoint.origin + <0, 0, 7000>, airdropPoint.origin, 128, <255, 0, 0>, true, 100.0 )

		thread AirdropWorkbench_Thread( airdropPoint.origin, airdropPoint.angles, animatePod, true )
	}
}

void function DEV_SimulateMultipleAirdrops( int dropCount, bool dropPackageNotCrafter, float minDistance = MIN_AIRDROP_DISPLACEMENT, bool animatePod = true, bool ignoreRing = false, float drawTime = 100.0 )
{
	thread DEV_SimulateMultipleAirdrops_Thread( dropCount, dropPackageNotCrafter, minDistance, animatePod, ignoreRing, drawTime )
}

void function DEV_SimulateMultipleAirdrops_Thread( int dropCount, bool dropPackageNotCrafter, float minDistance, bool animatePod, bool ignoreRing, float drawTime )
{
	file.previousDevAirdrops.clear()
	int roundNum = SURVIVAL_GetCurrentDeathFieldStage( 0 ) + 1

	array< array<string> > contents = [["crate_weapons_lategame"], ["gold_weapons"], ["gold_weapons"]]
	AirdropRoundData aData = CreateAirDropData( roundNum, dropCount, 0, contents, null, ignoreRing ? eAirdropRingArea.IGNORE_RING : eAirdropRingArea.CURRENT_RING )
	aData.minDelayBetweenPods = 0
	aData.maxDelayBetweenPods = 0
	if ( !animatePod )
		aData.airdropSpeed = eAirdropSpeed.INSTANT

	string animOverride = GetCurrentPlaylistVarString( "airdrop_anim_override", "" )
	if ( animOverride != "" )
		aData.animation = animOverride

	ReferenceStruct tempData
	waitthread SetAirdropPositionsForAirdropData_Thread( tempData, aData, RandomFloatForLoot( 360.0 ), minDistance, true )

	for ( int i = 0; i < aData.originArray.len(); i++ )
	{
		array< array<string> > contentGroups = clone aData.contents
		array< array<string> > podContents = DetermineAirdropContents ( contentGroups )
		aData.contentsArray.append( podContents )

		int airdropContentsTier = DetermineAirdropTier ( podContents )
		aData.rarityArray.append( airdropContentsTier )
	}

	if ( aData.dropCount >= AIRDROP_LARGE_DROP_COUNT )
	{
		array<vector> originArray = clone aData.originArray
		aData.originArray = ShuffleVectorArray ( originArray )
	}

	if ( dropPackageNotCrafter )
	{
		thread Survival_LaunchAirdropsFromAirdropData( aData, true )

		foreach ( origin in aData.originArray )
		{
			//DebugDrawArrow( origin + <0, 0, 7000>, origin, 128, <0, 255, 0>, true, drawTime )
			//DebugDrawCircle( origin, <0,0,0>, 32, <0, 255, 0>, true, drawTime )
		}
	}
	else
	{
		for ( int i = 0; i < aData.originArray.len(); i++ )
		{
			thread AirdropWorkbench_Thread( aData.originArray[i], aData.anglesArray[i], animatePod, true )

			//DebugDrawArrow( aData.originArray[i] + <0, 0, 7000>, aData.originArray[i], 128, <255, 0, 0>, true, drawTime )
			//DebugDrawCircle( aData.originArray[i], <0,0,0>, 32, <255, 0, 0>, true, drawTime )
		}
	}

	int circle = aData.dropCircle
	DEV_DrawCircleLocations( -1, circle, drawTime )
}


