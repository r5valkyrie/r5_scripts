global const int CHEVREX_AIRDROP_SKIN_INDEX = 2
const CHEVREX_AIRDROP_HOLOGRAM_VFX = $"P_workbench_chev"
const vector CHEVREX_AIRDROP_HOLOGRAM_VFX_COL = <0, 255, 198>

global enum eAirdropRingArea
{
	IGNORE_RING, 			//ring location and size is completely ignored when placing airdrops
	PREVIOUS_RING, 			//airdrops can spawn anywhere in the previous round's ring center/radius
	CURRENT_RING,	 		//airdrops can spawn only in this round's ring center/radius (default behavior)

	_count
}

global enum eAirdropSpeed
{
	INSTANT, 	//airdrop spawns immediately on the ground - should only be used before the game begins, or in debug
	FAST, 		//airdrop drops without delays as defined in playlist
	STANDARD 	//airdrop uses delays as defined in playlist
}

global enum eAirdropType
{
	STANDARD, 				//normal airdrops
	CHARACTER_CAREPACKAGE,	//"care package" airdrops called down by player characters
                
	CRAFTING_REPLICATOR,	//crafting bench clusters
      

                        
                 
                              

	_count
}

// 2.11.20 Cleanup of AirdropItems function
global struct AirdropItemsOptionalInfo
{
	string animationName 			= CARE_PACKAGE_ANIMATION																// the animation for  the airdrop pod to play.
	string targetName 				= CARE_PACKAGE_TARGETNAME																// basically an identifier for player-driven Airdrops (Lifeline)
	entity owner 					= null
	int team						= 0
	int skin 						= 0																						// skin index for the drop-pod model
	string sourceWeaponClassname 	= ""																					// if a player use an ability (a weapon) to fire off an airdrop, this should be the name of the weapon
	int realm 						= -1																					// the realm of the airdrop. -1 is the gameplay realm for a normal game. Used in the firing range.
	bool animatePod 				= true																					// whether or not the airdrop actually animates (true) or simply appears on the ground (false)
	bool forceDefaultColor 			= false																					// forces the default color scheme
	array< array<string> > functionref( AirdropItemsOptionalInfo ) delayedContentFunc = null								// function used to determine loot at the last possible valid moment (when the airdrop actually lands). Used for Lifeline.
}

// Definition of airdrop "round": a set of one or more airdrops that drop in association of airdrop round
global struct AirdropRoundData
{
	int                                     dropCircle																		// the "round", based on the ring/deathfield index
	int                                     dropCount																		// number of airdrops in the set
	float                                   preWait																			// time to wait within the round before beginning to launch the set
	array<int>                           	rarityArray																		// rarity level of individual airdrops in the set
	array<vector>                           originArray																		// locations of individual airdrops in the set
	array< array<vector> > 					clusterOriginArray																// location of airdrop "clusters" for the Extravaganzza LTM/Takeover
	array<vector>                           anglesArray																		// angles of individual airdrops in the set
	array< array<string> >                  contents																		// loot groups for all airdrops in this set
	array< array< array<string> > >         contentsArray																	// actual loot groups/refs of individual airdrops in the set
	array< array<string> > functionref(int) optionalGetContentsFunc
	int                                     airdropRingArea = eAirdropRingArea.CURRENT_RING									// valid area where the set will drop based on ring/deathfield status (see eAirdropRingArea)
	int										airdropSpeed = eAirdropSpeed.STANDARD											// "speed" at which all airdrops in the set will be launched (see eAirdropSpeed)
	bool									airdropRadiusOverrideEnabled = false
	float									airdropRadiusOverride = AIRDROP_IGNORE_RING_STD_DROP_RADIUS
	float									airdropRadiusOverride_LargeCount_Inner = AIRDROP_IGNORE_RING_MIN_DROP_RADIUS
	float									airdropRadiusOverride_LargeCount_Outer = AIRDROP_IGNORE_RING_MAX_DROP_RADIUS
	float                                   minDelayBetweenPods = 3.0														// min delay between launching individual airdrops in the set
	float                                   maxDelayBetweenPods = 5.0														// max delay between launching individual airdrops in the set
	string                                  animation = CARE_PACKAGE_ANIMATION												// animation of all airdrops in the set
	float									animationDuration
	bool									launched = false																// whether or not the airdrop set has begun to launch
	float 									delayBetweenPods
}

struct ReferenceStruct
{
	float returnedFloat
}

struct
{
	#if SERVER
		array<AirdropRoundData>          	pregameAirdropData
		array<AirdropRoundData>          	airdropData
		array<vector>                     	previousAirdrops

		int airdropCircleCalcProgress = -1

		bool airdropRarityColorEnabled

		array< void functionref( entity, entity ) > Callbacks_OnAirdropOpened
		array< void functionref( entity, vector ) > Callbacks_OnAirdropLaunched
		array< void functionref( entity, vector ) > Callbacks_OnAirdropLanded
		array< void functionref( AirdropRoundData, int ) > Callbacks_OnAirdropRoundMessaging
		array< void functionref( AirdropRoundData, int ) > Callbacks_OnAirdropRoundLaunchRequest
		array< void functionref() > Callbacks_OnAirdropPositionsDetermined
		#if DEVELOPER
			bool devPrintOn = false
			array< vector > previousDevAirdrops
			table< int, int > stageToAmountTable
			array< entity > devAirdrops = []
		#endif

		table< entity, entity > dropPodToVFXEntityTable // Keep track of VFX created on airdrops so we can clean them up in case the air drop gets destroyed
	#endif

} file

void function Sh_Airdrops_Init()
{
	RegisterSignal( "OpenDroppod" )
	RegisterSignal( "DroppodRemoveLocationMarker" )
	PrecacheScriptString( CARE_PACKAGE_SCRIPTNAME )
	PrecacheScriptString( AIRDROP_MOVER_SCRIPTNAME )

	#if CLIENT
		AddCreateCallback( "prop_dynamic", OnAirdropCreated )
	#elseif SERVER
		AddSpawnCallback( "prop_dynamic", OnAirdropCreated )
		file.airdropRarityColorEnabled = GetCurrentPlaylistVarBool( "airdrop_raritycolor_enabled", false )
		PrecacheParticleSystem( CHEVREX_AIRDROP_HOLOGRAM_VFX )
	#endif

}


void function OnAirdropCreated( entity dropPod )
{
	#if CLIENT
	if ( dropPod.GetTargetName() == CARE_PACKAGE_PROXY)
	{
		ShowGrenadeArrow( GetLocalViewPlayer(), dropPod, 192, 0, true )
	}
	#endif

	if ( dropPod.GetTargetName() != CARE_PACKAGE_TARGETNAME && dropPod.GetTargetName() != CARE_PACKAGE_LIFELINE_TARGETNAME )
		return

	AddCallback_OnUseEntity( dropPod, OnAirdropUse )
	#if CLIENT
	AddEntityCallback_GetUseEntOverrideText( dropPod, ExtendedUseTextOverride )
	#endif
}

int function GetAirdropPingColorIDFromRarityTier( int rarityTier )
{
	switch ( rarityTier )
	{
		case eLootTier.COMMON:
			return COLORID_HUD_LOOT_TIER1
		case eLootTier.RARE:
			return COLORID_HUD_LOOT_TIER2
		case eLootTier.EPIC:
			return COLORID_HUD_LOOT_TIER3
		case eLootTier.LEGENDARY:
			return COLORID_HUD_LOOT_TIER4
		case eLootTier.MYTHIC:
			return COLORID_HUD_LOOT_TIER5
	}
	return COLORID_AIRDROP_DEFAULT_COLOR
}

entity function GetAirdropForHitEnt( entity hitEnt )
{
	if ( hitEnt.GetScriptName() == CARE_PACKAGE_SCRIPTNAME )
		return hitEnt

	entity parentEnt = hitEnt.GetParent()
	if ( IsValid( parentEnt ) && parentEnt.GetScriptName() == CARE_PACKAGE_SCRIPTNAME )
		return parentEnt

	return null
}

#if SERVER
void function AirdropPodRemoveLocationMarker( entity droppod )
{
	if ( !IsValid( droppod ) )
		return

	droppod.Signal( "DroppodRemoveLocationMarker" )
}

