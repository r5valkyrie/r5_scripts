int function CodeCallback_IsAirdropPointValid( vector origin, int index )
{
	vector angles = < 0, 0, 0 >
	// This function assumes you input a valid navmesh point as the origin

	vector maxs          = <80, 80, 256>
	vector mins          = <-80, -80, 0>

	bool result = CommonAirdropValidationCheck( origin, angles, <0, 0, 0>, maxs, mins, -1, false )

	//0 is valid, 1 is failure due to AIRDROP. see InvalidRingReason for the return codes
	return result ? 0 : 1
}
