void function SURVIVAL_CalculateAirdropPositions()
{
	svGlobal.levelEnt.EndSignal( "GenerateDeathFieldData" )

	file.airdropCircleCalcProgress = 0
	foreach ( apData in file.pregameAirdropData )
	{
		apData.originArray.clear()
		apData.anglesArray.clear()
	}
	foreach ( aData in file.airdropData )
	{
		aData.originArray.clear()
		aData.anglesArray.clear()
	}

	FlagWait( "DoneCreatingDeathFieldPosition" )
	FlagWait( "DeathFieldCalculationComplete" )

	file.previousAirdrops.clear()

	float baseAngle = RandomFloatForLoot( 360.0 )

	if ( GetCurrentPlaylistVarBool( "airdrop_pregame_enabled", false ) )
	{
		foreach ( apData in file.pregameAirdropData )
		{
			ReferenceStruct tempData
			waitthread SetAirdropPositionsForAirdropData_Thread ( tempData, apData, baseAngle )
			baseAngle = tempData.returnedFloat
		}
	}

	int index = 0
	foreach ( aData in file.airdropData )
	{
		ReferenceStruct tempData
		waitthread SetAirdropPositionsForAirdropData_Thread ( tempData, aData, baseAngle )
		baseAngle = tempData.returnedFloat
		file.airdropCircleCalcProgress = ++index
	}

	foreach ( callbackFunc in file.Callbacks_OnAirdropPositionsDetermined )
		callbackFunc()
}

void function SURVIVAL_CalculateAirdropPositionsForRound( int round )
{
	FlagWait( "DoneCreatingDeathFieldPosition" )
	FlagWait( "DeathFieldCalculationComplete" )

	//int deathFieldStage =  SURVIVAL_GetCurrentDeathFieldStage( 0 )
	float baseAngle = RandomFloatForLoot( 360.0 )

	int index = 0
	foreach ( aData in file.airdropData )
	{
		if ( aData.dropCircle == round )
		{
			ReferenceStruct tempData
			waitthread SetAirdropPositionsForAirdropData_Thread ( tempData, aData, baseAngle )
			baseAngle = tempData.returnedFloat
			file.airdropCircleCalcProgress = ++index
		}
	}
}

void function SetAirdropPositionsForAirdropData_Thread( ReferenceStruct returnStruct, AirdropRoundData aData, float baseAngle, float minDistance = MIN_AIRDROP_DISPLACEMENT, bool runningTests = false )
{
	int deathFieldStage = aData.dropCircle
	bool airdropsIgnoreRing = ( aData.airdropRingArea == eAirdropRingArea.IGNORE_RING )
	bool airdropsLargeCount = ( aData.dropCount >= AIRDROP_LARGE_DROP_COUNT )
	bool airdropsUseOverrides = ( airdropsIgnoreRing || aData.airdropRadiusOverrideEnabled )

	if ( aData.airdropRingArea == eAirdropRingArea.PREVIOUS_RING )
		deathFieldStage -= 1
	if ( deathFieldStage >= SURVIVAL_GetDeathFieldStages( Survival_Loot_GetDefaultRealm() ).len() )
	{
		Warning( "Airdrop has bad death field stage: %d", deathFieldStage )
		deathFieldStage = SURVIVAL_GetDeathFieldStages( Survival_Loot_GetDefaultRealm() ).len() - 1
	}
	DeathFieldStageData deathFieldStageData = GetDeathFieldStage( Survival_Loot_GetDefaultRealm(), deathFieldStage )
	vector center                           = airdropsIgnoreRing ? SURVIVAL_GetCalculatedMapCenter() : deathFieldStageData.endPos
	bool allowLoopForever 					= !airdropsLargeCount
	float maxAirdropSearchRuntime				= DEFAULT_MAX_AIRDROP_SEARCH_RUNTIME
	float angleAdjust 						= 360.0 / float( aData.dropCount )

                               
                                                                                                                                     
                                                                                                                        
                           
                                     

	for ( int i = 0; i < aData.dropCount; i++ )
	{
		int randomSeedIntForCircleCenter = -1
		if ( IsLockedLootActive() )
			randomSeedIntForCircleCenter = GetRandomSeedIntForLoot()

		float radius = airdropsUseOverrides ? aData.airdropRadiusOverride : ( deathFieldStageData.endRadius * 0.85 )

		if ( airdropsUseOverrides && airdropsLargeCount )
		{
			switch ( i % 3 )//large counts of airdrops need to be distributed over a large area
			{
				case 0:
					radius = aData.airdropRadiusOverride_LargeCount_Outer
					break

				case 1:
					radius = aData.airdropRadiusOverride
					break

				case 2:
					radius = aData.airdropRadiusOverride_LargeCount_Inner
					break
			}
		}


		radius *= (aData.dropCount == 1) ? 0.5 : 1.0

		                    
			if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_GOLDEN_HORSE ) && GoldenHorse_ModifyCarePackageSpawnDistance() )
			{
				float distScale = GetCurrentPlaylistVarFloat( "golden_horse_carepackage_scale", 0.5 )
				int dropCount = GetCurrentPlaylistVarInt( "golden_horse_carepackage_distance_count", 2 )
				minDistance *= (aData.dropCount == dropCount) ? distScale : 1.0
			}
        

		Point airdropPoint
		#if DEVELOPER
			if ( runningTests )
			{
				maxAirdropSearchRuntime = -1
				waitthread FindRandomAirdropDropPoint_Thread( airdropPoint, baseAngle, center, radius, file.previousDevAirdrops, allowLoopForever, maxAirdropSearchRuntime, randomSeedIntForCircleCenter, minDistance )
			}
			else
		#endif
		{
			waitthread FindRandomAirdropDropPoint_Thread( airdropPoint, baseAngle, center, radius, file.previousAirdrops, allowLoopForever, maxAirdropSearchRuntime, randomSeedIntForCircleCenter, minDistance )
		}
		if ( ( airdropPoint.angles == <0,0,0> ) && ( airdropPoint.origin == <0,0,0> ) )
			continue //skip airdrop if we failed to find a location

		aData.originArray.append( airdropPoint.origin )
		aData.anglesArray.append( airdropPoint.angles )
		#if DEVELOPER
			if ( runningTests )
				file.previousDevAirdrops.append( airdropPoint.origin )
			else
		#endif
		{
			file.previousAirdrops.append( airdropPoint.origin )
		}


		if ( DEBUG_DROP_POINTS )
		{
			DebugDrawText( airdropPoint.origin + <0, 0, 7000>, "Circle " + aData.dropCircle, false, 20.0 )
			//DebugDrawArrow( airdropPoint.origin + <0, 0, 7000>, airdropPoint.origin, 128, <255, 0, 0>, true, 20.0 )
		}
		baseAngle += angleAdjust
	}
	returnStruct.returnedFloat = baseAngle
}

AirdropRoundData function Survival_CreatePregameAirDropData( int circle, int dropCount, float preWait, array< array<string> > contents, int airdropRingArea )
{
	AirdropRoundData data = CreateAirDropData( circle, dropCount, preWait, contents, null, airdropRingArea )
	file.pregameAirdropData.append( data )
	return data
}

AirdropRoundData function Survival_CreateAirDropData( int circle, int dropCount, float preWait, array< array<string> > contents, int airdropRingArea )
{
	AirdropRoundData data = CreateAirDropData( circle, dropCount, preWait, contents, null, airdropRingArea )
	file.airdropData.append( data )
	return data
}

AirdropRoundData function CreateAirDropData( int circle, int dropCount, float preWait, array< array<string> > contents, array< array<string> > functionref(int) contentFunc = null, int airdropRingArea = eAirdropRingArea.CURRENT_RING )
{
	AirdropRoundData data
	data.dropCircle = circle
	data.dropCount = dropCount
	data.preWait = preWait
	data.contents = contents
	data.optionalGetContentsFunc = contentFunc
	data.airdropRingArea = airdropRingArea

	return data
}

void function Survival_ClearAirDropData()
{
	file.airdropData = []
}

int function GetAirdropBeamColorIDFromRarityTier( int rarityTier )
{
	switch ( rarityTier )
	{
		case eLootTier.COMMON:
			return COLORID_FX_LOOT_TIER1
		case eLootTier.RARE:
			return COLORID_FX_LOOT_TIER2
		case eLootTier.EPIC:
			return COLORID_FX_LOOT_TIER3
		case eLootTier.LEGENDARY:
			return COLORID_FX_LOOT_TIER4
		case eLootTier.MYTHIC:
			return COLORID_FX_LOOT_TIER5
	}
	return COLORID_AIRDROP_DEFAULT_COLOR
}

int function DetermineAirdropTier ( array< array<string> > podContents )
{
	int airdropContentsTier = 0
	foreach ( panel in podContents )
	{
		foreach ( loot in panel )
		{
			LootData ld = SURVIVAL_Loot_GetLootDataByRef( loot )
			if ( ( ld.tier > airdropContentsTier ) && ( ld.lootType != eLootType.HEALTH ) )
				airdropContentsTier = ld.tier
		}
	}
	return airdropContentsTier
}

void function IssueAirdropPing ( vector origin, float duration, int rarity = eLootTier.NONE, int airdropType = eAirdropType.STANDARD )
{
	float pingDuration = duration * 2
	float pingMaxSize = 500.0
	float pingIntialSize = 50.0
	float pingFrequency = 0.8
	float pingFrequencyVariance = 0.2
	int colorID = file.airdropRarityColorEnabled ? GetAirdropPingColorIDFromRarityTier ( rarity ) : COLORID_AIRDROP_DEFAULT_COLOR

	                
		if ( airdropType == eAirdropType.CRAFTING_REPLICATOR )
		{
			colorID = COLORID_AIRDROP_CRAFTING_COLOR
			if ( Crafting_IsDispenserCraftingEnabled() )
				colorID = COLORID_CRAFTING_DISPENSER
		}
       

	//%if HAS_STRAYTELEPORTERS
	//	if ( airdropType == eAirdropType.STRAYTELEPORTER )
	//	{
	//		colorID = COLORID_EVAC_TOWER_METER_HEALTHY
	//	}
	//%endif

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_AIRDROPEXTRA ) )
	{
		pingFrequency = 1.2
		pingFrequencyVariance = 0.3
		pingIntialSize = 35.0
	}

	foreach ( player in GetPlayerArray_Alive() )
		Remote_CallFunction_NonReplay( player, "ServerCallback_SUR_PingMinimap", origin, pingDuration, pingMaxSize, pingIntialSize, colorID, pingFrequency, pingFrequencyVariance, airdropType )

}

void function AirdropLogic()
{
	EndSignal( svGlobal.levelEnt, "RoundEnd" )

	int startCircle = GetCurrentPlaylistVarInt( "survival_death_field_start_stage", 0 )
	int dropIndex   = 0
	if( file.airdropData.len() > 0 )
	{
		while( file.airdropData[ dropIndex ].dropCircle < startCircle )
			dropIndex++
	}

	SetGlobalNetInt( "numberOfAirdropRoundsLeft", file.airdropData.len() - dropIndex )

	if ( GetCurrentPlaylistVarBool( "airdrop_pregame_enabled", false ) )
	{
		foreach ( apData in file.pregameAirdropData )
		{
			wait apData.preWait

			if (!apData.launched)
			{
				waitthread Survival_LaunchAirdropsFromAirdropData( apData )
				apData.launched = true
			}
			else
				printf("Pregame airdrop data already launched. Skipping.")
		}
	}

	FlagWait( "DeathCircleActive" )

	bool airdropStartOnShrink = GetCurrentPlaylistVarBool( "airdrop_start_during_shrink", true )

	while ( true )
	{
		if ( airdropStartOnShrink )
			FlagWait( "SUR_DeathFieldShrinking" )

		if ( dropIndex >= file.airdropData.len() )
			return

		// wait for the airdrop positions to finish calculating, if needed.
                               
                                                                                                                          
                                                                                                                             
                                     
		{
			while ( dropIndex >= file.airdropCircleCalcProgress )
				wait 0.1
		}

		AirdropRoundData aData = file.airdropData[ dropIndex ]
		int nextDropCircle     = aData.dropCircle

		if ( nextDropCircle < startCircle )
		{
			dropIndex++
			continue
		}

		if ( SURVIVAL_GetCurrentDeathFieldStage( 0 ) >= nextDropCircle )
		{
			wait aData.preWait

                                 
                                                                                                                      
                                                                                                                          
                                                                            
                                       

			if ( aData.dropCount >= AIRDROP_LARGE_DROP_COUNT )
			{
				array<vector> originArray = clone aData.originArray
				aData.originArray = ShuffleVectorArray ( originArray )
			}

			                    
				if ( UpgradeCore_EvoHarvesters_Enabled() && GetCurrentPlaylistVarBool( "prevent_evo_harvesters_airdrop_overlap_enabled", true ) )
				{
					float minHarvesterAirdropAvoidanceDistance = 10 * METERS_TO_INCHES
					array<vector> originArray = clone aData.originArray

					for( int i = originArray.len() - 1; i >=0 ; i--  )
					{
						foreach( harvesterEnt in UpgradeCore_Get_EvoHarvester_Ents() )
						{
							if( Distance2DSqr( harvesterEnt.GetOrigin(), originArray[i] ) < ( minHarvesterAirdropAvoidanceDistance * minHarvesterAirdropAvoidanceDistance )  )
							{
								#if DEVELOPER
										printt( "Invalidating an Airdrop Location Due to Proximity with Evo Harvester: " + originArray[i] )
								#endif
								originArray.fastremove( i )
								break
							}
						}
					}

					aData.originArray = originArray
				}
         

			waitthread Survival_LaunchAirdropsFromAirdropData( aData )

			dropIndex += 1
			SetGlobalNetInt( "numberOfAirdropRoundsLeft", file.airdropData.len() - dropIndex )
		}
		else
		{
			wait 0.1
			FlagWaitClear( "SUR_DeathFieldShrinking" )
		}
	}
}

void function Survival_LaunchAirdropsFromAirdropData ( AirdropRoundData aData, bool runningTests = false )
{
	if ( aData.launched )
	{
		printf("Survival_LaunchAirdropsFromAirdropData for circle " + aData.dropCircle + " already launched. Skipping.")
		return
	}

	if ( aData.dropCount <= 0 )
	{
		printf( "No airdrops in AirdropData for round " + aData.dropCircle + ". Skipping.")
		return
	}

	aData.launched = true

	array<vector> originArray = clone aData.originArray
	array<vector> anglesArray = clone aData.anglesArray

	float pingDuration = ( aData.animationDuration + 8.0 )

	AirdropItemsOptionalInfo optionInfo
	optionInfo.animatePod = ( aData.airdropSpeed != eAirdropSpeed.INSTANT )
	optionInfo.animationName = aData.animation

	if ( aData.dropCount >= AIRDROP_LARGE_DROP_COUNT )
		aData.originArray = ShuffleVectorArray ( originArray )

	for ( int i = 0; i < aData.originArray.len(); i++ )
	{
		if( !GetCurrentPlaylistVarBool( "predetermine_airdrop_data_at_game_start", false ) )
		{
			array< array<string> > contentGroups = clone aData.contents
                       
				array< array<string> > podContents
				if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_GOLDEN_HORSE ) && GoldenHorse_SwordCarePackageEnabled() && i == 0 && contentGroups.len() >= 3 )
				{
					string former = ""
					if ( contentGroups[2].len() >= 1 )
					{
						former              = contentGroups[2][0]
						contentGroups[2][0] = "crate_weapons_sword"
					}
					else
					{
						contentGroups[2].append( "crate_weapons_sword" )
					}
					podContents         = DetermineAirdropContents ( contentGroups )
					contentGroups[2][0] = former
				}
				else
					podContents = DetermineAirdropContents ( contentGroups )
        
                                                                                   
         

			aData.contentsArray.append( podContents )

			int airdropContentsTier = DetermineAirdropTier ( podContents )
			aData.rarityArray.append( airdropContentsTier )
		}

		#if DEVELOPER
		if ( !runningTests )
		#endif // DEVELOPER
		{
			IssueAirdropPing ( aData.originArray [ i ], pingDuration, aData.rarityArray [ i ] )
		}

		foreach ( callbackFunc in file.Callbacks_OnAirdropRoundMessaging )
			callbackFunc( aData, i )
	}

	if ( aData.airdropSpeed != eAirdropSpeed.INSTANT )
		AddSurvivalCommentaryEvent( eSurvivalEventType.CARE_PACKAGE_DROPPING )

	wait TIME_BEFORE_DROPPING_AIRDROPS

	for ( int i = 0; i < aData.originArray.len(); i++ )
	{
		vector origin = aData.originArray[i]
		vector angles = aData.anglesArray[i]

		HeatMapStat( null, "AirdropLocation", origin )

		thread AirdropItems( origin, angles, aData.contentsArray [ i ], optionInfo, runningTests )

		foreach ( callbackFunc in file.Callbacks_OnAirdropRoundLaunchRequest )
			callbackFunc( aData, i )

		if( GetCurrentPlaylistVarBool( "predetermine_airdrop_data_at_game_start", false ) )
			wait aData.delayBetweenPods
		else
			wait RandomFloatRangeForLoot( aData.minDelayBetweenPods, aData.maxDelayBetweenPods )
	}
}

