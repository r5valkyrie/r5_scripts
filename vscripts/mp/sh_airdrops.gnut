}
#endif

void function OnAirdropUse( entity dropPod, entity player, int useInputFlags )
{
	if ( !dropPod.DoesShareRealms( player ) )
		return

	if ( IsBitFlagSet( useInputFlags, USE_INPUT_DEFAULT ) )
	{
		#if SERVER
			if ( dropPod.e.isBusy )
				return

			dropPod.Signal( "OpenDroppod" )
			PIN_Interact ( player, "care_package", null, dropPod.GetTargetName() )
			thread AirDropOpen( dropPod, player )
		#endif
	}
}

#if SERVER
void function RemoteOpenAirdrop( entity dropPod, entity player )
{
	if ( dropPod.e.isBusy )
		return

	DEV_AirdropPrint( "***** RemoteOpenAirDrop() called, remotely opened... Crypto or Loba, is that you?" )

	dropPod.Signal( "OpenDroppod" )

	PIN_Interact ( player, "care_package", dropPod.GetOrigin() )
	thread AirDropOpen( dropPod, player )
}

void function AirDropOpen( entity ent, entity player )
{
	ent.EndSignal( "OnDestroy" )

	if ( ent.e.blockActive )
		return

	ent.e.blockActive = true

	GradeFlagsSet( ent, eGradeFlags.IS_BUSY )

	if ( IsValid( player )  )
		TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_OPENDROPPOD, ent, ent.GetOrigin(), player.GetTeam(), player )

	foreach ( callbackFunc in file.Callbacks_OnAirdropOpened )
		callbackFunc( ent, player )

	DEV_AirdropPrint( "***** AirDropOpen(): Droppod opening started @ time == " + Time() )
	waitthread PlayAnim( ent, "droppod_loot_opening" )
	DEV_AirdropPrint( "***** AirDropOpen(): Droppod opening finished @ time == " + Time() )
	thread PlayAnim( ent, "droppod_loot_open_idle" )
}

// Make sure we cleanup VFX if the airdrop gets destroyed
void function OnAirdropDestroyed( entity dropPod )
{
	// Currently we only cleanup Chevrex logo vfx
	if ( dropPod.GetTargetName() != CARE_PACKAGE_TARGETNAME && dropPod.GetTargetName() != CARE_PACKAGE_LIFELINE_TARGETNAME )
		return

	if ( dropPod in file.dropPodToVFXEntityTable )
	{
		entity effect = file.dropPodToVFXEntityTable[ dropPod ]
		if ( IsValid( effect ) )
			EffectStop( effect )
	}
}

#if DEVELOPER
void function OnDestroyedDroppodLootItem( entity lootItem )
{
	DEV_AirdropPrint( "xxxxx Droppod lootItem DESTROYED @ time == " + Time() )
	DEV_AirdropPrint( " - Droppod looItem Targetname	== " + lootItem.GetTargetName())
	DEV_AirdropPrint( " - Droppod looItem Owner 		== " + lootItem.GetParent().GetScriptName())
	DEV_AirdropPrint( " - Droppod Location			== " + lootItem.GetParent().GetOrigin())

	if( !lootItem.e.playerPickedUpItem )
	{
		DEV_AirdropPrint( format( "WARNING: Care Package item %s was destroyed but never picked up.", string( lootItem ) ))
	}
	else
	{
		DEV_AirdropPrint( " - Droppod lootItem was picked up by player: " + lootItem.e.playerPickedUpItem )
	}
}
#endif

#endif