void function Training_EntitiesDidLoad()
{
	printt( "Training: EntitiesDidLoad" )
	#if SERVER
		thread Staging_SpawnChargePylons_Thread()
		                   
			thread CLootV2_InitLootInfo()
			thread Staging_SpawnJumpPads_Thread()
        

		Training_Trigger_Hurt_Init()
	#endif
}

#if SERVER
void function Training_Trigger_Hurt_Init()
{
	array< entity > hurtTriggers = GetEntArrayByClass_Expensive( "trigger_hurt" )
	foreach( trigHurt in hurtTriggers )
	{
		trigHurt.SetEnterCallback( Training_TriggerHurtEnter )
	}

	//Disable oob triggers to prevent deaths in Training.
	array<entity> oobTriggers = GetEntArrayByClass_Expensive( "trigger_out_of_bounds" )
	foreach( entity trigger in oobTriggers )
	{
		trigger.Disable()
	}

}

void function Training_TriggerHurtEnter( entity trig, entity entrant )
{
	if( !IsValidPlayer( entrant ) )
		return

	#if DEVELOPER
		printt( format( "%s(): %s entered trigger_hurt", FUNC_NAME(), entrant.GetPlayerName() ) )
	#endif

	// Put the player back in tutorial area.
	int tutorialContext = entrant.GetPlayerNetInt( "tutorialContext" )
	vector destination
	vector angles
	switch( tutorialContext )
	{
		case eTutorialContext.LOOT_BIN:
		case eTutorialContext.LOOT_BIN_ITEMS:
		case eTutorialContext.ORDNANCE:
		case eTutorialContext.WEAPON_LOOT_BIN:
		case eTutorialContext.WEAPON_PICKUP:
		case eTutorialContext.WEAPON:
		case eTutorialContext.WEAPON_SWAP:
		case eTutorialContext.PING:
			destination = < -7549.312988, 499.452789, -19.968752 >
			angles = < 3.299994, -2.196961, 0.000000 >
			break
		case eTutorialContext.PATHFINDER:
			destination = < -7177.492188, 552.886963, -19.968752 >
			angles = < -11.220007, -38.826954, 0.000000 >
			break
		case eTutorialContext.PATHFINDER_INTRO:
		case eTutorialContext.REVIVE:
		case eTutorialContext.REVIVE_DONE:
		case eTutorialContext.HEALING_DRONE:
		case eTutorialContext.HEALING_DRONE_DONE:
		case eTutorialContext.PICK_UP_DNA:
		case eTutorialContext.RESPAWN_CHAMBER:
		case eTutorialContext.RESPAWN_CHAMBER_DONE:
		case eTutorialContext.ULTIMATE:
		case eTutorialContext.ULTIMATE_DONE:
			destination = < -5405.439453, -439.065063, 396.061798 >
			angles = < 4.688800, -97.202988, 0.000000 >
			break
		default:
			destination = NEW_PLAYERSTART_POS
			angles = < 0, 0, 0 >
			break
	}

	thread Training_TeleportPlayer_Thread( entrant, destination, angles )
}

void function Training_TeleportPlayer_Thread( entity player, vector destination, vector angles = <0,0,0> )
{
	if( !IsValidPlayer( player ) )
		return

	player.EndSignal( "OnDestroy" )

	ScreenFadeToColor( player, 255, 255, 255, 255, 0.25, 5.0 )
	wait ( 0.25 )

	if ( !IsValid( player ) )
		return

	//player.StartTeleport() // S3: entity method not available

	while( !IsAlive( player ) && IsValid( player ) )
	{
		WaitFrame()
	}

	if( !IsValidPlayer( player ) )
		return

	bool success = TeleportPlayerNoInterp( player, destination )
	//player.EndTeleport() // S3: entity method not available
	player.SetVelocity( <0 ,0, 0> )
	player.SetAngles( angles )
	ScreenFadeFromColor( player, 255, 255, 255, 255, 0.5, 0.5 )
}
#endif // SERVER

                   
bool function IsStagingMU1()
{
	return( GetMapName() == "mp_rr_canyonlands_staging_mu1" )
}
                         

#if SERVER
void function OnPlayerConnected( entity player )
{
	printt( "Training: OnPlayerConnected", player, player.GetTeam() )

	FiringRange_Banners_Init( player.GetTeam() )

	// Init player training data
	Assert( !(player in file.playerTrainingData) )
	PlayerTrainingData data

	table<string, vector> startingInfo = playerAndBloodhoundStartOrigins.getrandom()
	data.playerRandomStartOrigin = startingInfo[ "playerStart" ]
	data.bloodhoundRandomStartOrigin = startingInfo[ "bloodhoundStart" ]

	Assert( !(player in file.playerTrainingData) )
	file.playerTrainingData[ player ] <- data
}

void function OnPlayerDisconnected( entity player )
{
	printt( "Training: OnPlayerDisconnected" )

	if( player.IsInvulnerable() )
	{
		player.ClearInvulnerable()
	}

	// Clean up their entitiestostring
	if ( !(player in file.playerTrainingData) )
		return

	PlayerTrainingData data = file.playerTrainingData[ player ]

	if ( IsValid( data.trainingNPC ) )
		data.trainingNPC.Destroy()
	if ( IsValid( data.trainingDummy ) )
		data.trainingDummy.Destroy()
	if ( IsValid( data.trainingDummyNode ) )
		data.trainingDummyNode.Destroy()
	if ( IsValid( data.npcNodeBloodhound1 ) )
		data.npcNodeBloodhound1.Destroy()
	if ( IsValid( data.npcNodeBloodhound2 ) )
		data.npcNodeBloodhound2.Destroy()
	if ( IsValid( data.npcNodePathfinder1 ) )
		data.npcNodePathfinder1.Destroy()
	if ( IsValid( data.lootBin1 ) )
		data.lootBin1.Destroy()
	if ( IsValid( data.lootBin2 ) )
		data.lootBin2.Destroy()
	if ( IsValid( data.deathBox ) )
		data.deathBox.Destroy()
	if ( IsValid( data.respawnChamber ) )
		data.respawnChamber.Destroy()
	if ( IsValid( data.respawnChamberRadar ) )
		data.respawnChamberRadar.Destroy()
	if ( IsValid( data.dropship ) )
		data.dropship.Destroy()

	if ( (player in file.playerUltimateDropPods) && IsValid( file.playerUltimateDropPods[ player ] ) )
	{
		file.playerUltimateDropPods[ player ].Destroy()
		delete file.playerUltimateDropPods[ player ]
	}

	delete file.playerTrainingData[ player ]
}

void function Training_OnPlayerRespawned( entity player )
{
	Assert( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ), "Training_OnPlayerRespawned should only be running in training!" )

	if ( player.IsBot() )
		return

	printt( "Training: Training_OnPlayerRespawned", player )

	RemoveStagingAreaEntsForRealm( GetPlayerSquadRealm( player ) )
	PlayerTrainingData data = file.playerTrainingData[ player ]
	data.gun_range_enabled = false
	DecideRespawnPlayer( player, false )
	thread PlayerStartsTraining( player )
}

void function PlayerStartsTraining( entity player )
{
	// Training player spawns at the back of tunnel in one of 3 random spots
	PlayerTrainingData data = file.playerTrainingData[ player ]

	if ( IsRandomizedTrainingPlaylistEnabled() )
	{
		player.SetOrigin( data.playerRandomStartOrigin )
	}
	else
	{
                     
		if( !IsStagingMU1() )
		{
			player.SetOrigin( <26328, -6235, -27540> )
		}
		else
		{
			player.SetOrigin( NEW_PLAYERSTART_POS )
		}
       
                                             
                           
	}

	player.SetAngles( < 0, 0, 0 > )

	bool skipToPing = GetBugReproNum() == 123

	player.SetPlayerNetBool( "pingEnabled", false )

	bool skipToPathfinder = GetBugReproNum() == 12345
	if ( skipToPathfinder )
	{
		// TODO: UPDATE FOR MU1
		player.SetOrigin( < 33215, -7036, -28916 > )
		player.SetAngles( < 0, -90, 0 > )
		player.SetPlayerNetBool( "pingEnabled", true )
		Remote_CallFunction_NonReplay( player, "ServerCallback_SetCommsDialogueEnabled", 1 )
	}

	PlayerMatchState_Set( player, ePlayerMatchState.TRAINING )
	if ( GetCurrentPlaylistVarBool( "full_training_required", true ) == false )
		player.SetPersistentVar( "trainingCompleted", 1 )
	PIN_Training( player, "start", "training_start" )

	// Force player to be Lifeline for training
	ItemFlavor survivalTrainingCharacter = GetItemFlavorByAsset( CHARACTER_ASSET_LIFELINE )
                       
                                                                      
  
                                                                                     
  
      
	SetItemFlavorLoadoutSlot( ToEHI( player ), Loadout_Character(), survivalTrainingCharacter )

	// Disable inventory for now (gets enabled later)
	//Survival_SetInventoryEnabled( player, false )

	EndSignal( player, "OnDeath" )

	OnThreadEnd(
		function() : ( player, data )
		{
			if ( IsValid( data.deathBox ) )
				data.deathBox.Destroy()

			if ( IsValid( data.lootBin1 ) )
				data.lootBin1.Destroy()

			if ( IsValid( data.lootBin2 ) )
				data.lootBin2.Destroy()

			if ( IsValid( data.trainingDummy ) )
				data.trainingDummy.Destroy()

			if ( IsValid( data.trainingDummyNode ) )
				data.trainingDummyNode.Destroy()

			if ( IsValid( data.npcNodeBloodhound1 ) )
				data.npcNodeBloodhound1.Destroy()

			if ( IsValid( data.npcNodeBloodhound2 ) )
				data.npcNodeBloodhound2.Destroy()

			if ( IsValid( data.npcNodePathfinder1 ) )
				data.npcNodePathfinder1.Destroy()

			if ( IsValid( data.trainingNPC ) )
				data.trainingNPC.Destroy()

			if ( IsValid( data.respawnChamberRadar ) )
				data.respawnChamberRadar.Destroy()

			if ( IsValid( data.respawnChamber ) )
				data.respawnChamber.Destroy()

			if ( IsValid( player ) )
			{
				PlayerTrainingData newData
				newData.completed_movement = data.completed_movement
				newData.completed_ordnance = data.completed_ordnance
				newData.completed_weapons = data.completed_weapons
				newData.completed_ping = data.completed_ping
				newData.completed_pathfinder = data.completed_pathfinder
				newData.playerRandomStartOrigin = data.playerRandomStartOrigin
				newData.bloodhoundRandomStartOrigin = data.bloodhoundRandomStartOrigin

				file.playerTrainingData[ player ] <- newData
			}
		}
	)

	WaitFrame()

	ResetPlayerInventory( player )
	data.openedLootBin1 = false
	data.openedLootBin2 = false
	data.pickedUpFrag = false
	data.pickedUpThermite = false
	data.pickedUpHealth = false
	data.swappedGrenade = false
	data.usedHealth = false
	data.usedHealthDialoguePlayed = false
	data.threwGrenade = false
	data.threwGrenadeDialoguePlayed = false
	data.shotTrainingTargets = false
	data.pingedEnemyTarget = false
	data.openedOrdnanceMenu = false
	data.openedPingMenu = false
	data.pingedWeapon = false
	data.pingedAmmo = false

	#if DEVELOPER
	//Lootbins need to have this flag set to become enabled on DEV environments.  Training doesn't do the usual loot spawn flow that would call this.
	//However the SpawnTrainingLootBin() call will unset usable on them, so we want to set this flag to finish initializing them before we unset usable on them.
	FlagSet( "Survival_LootSpawned" )
	#endif //DEVELOPER

	// Spawn Loot Bin ( Ordnance )

	vector lootBin1_pos = < 30739, -6937, -29162 >
	vector lootBin2_pos = < 30952, -6937, -29162 >
	vector lootBin1_ang = < 0, 90, 0 >
	vector lootBin2_ang = < 0, 90, 0 >

	                   
		if( IsStagingMU1() )
		{
			array< vector > lootbin1_coords = LOOTBIN1_COORDS[ 1 ]
			array< vector > lootbin2_coords = LOOTBIN2_COORDS[ 1 ]
			lootBin1_pos = lootbin1_coords[ 0 ]
			lootBin1_ang = lootbin1_coords[ 1 ]
			lootBin2_pos = lootbin2_coords[ 0 ]
			lootBin2_ang = lootbin2_coords[ 1 ]
		}
       

	data.lootBin1 = SpawnTrainingLootBin( player, lootBin1_pos, lootBin1_ang, [ LOOT_NAME_HEALTH_KIT, LOOT_NAME_THERMITE, LOOT_NAME_FRAG ] )

	LootData ammoLootData = SURVIVAL_Loot_GetLootDataByRef( LOOT_NAME_WEAPON )
	data.lootBin2 = SpawnTrainingLootBin( player, lootBin2_pos, lootBin2_ang, [ LOOT_NAME_WEAPON, ammoLootData.ammoType, ammoLootData.ammoType ] ) //< 30954, -6242, -29164 >, < 0, 90, 0 >

	player.SetHealth( 75 )
	player.TakeOffhandWeapon( OFFHAND_TACTICAL )
	player.TakeOffhandWeapon( OFFHAND_ULTIMATE )

	#if DEVELOPER
		if ( GetBugReproNum() == 2020 )
		{
			thread SlideDownHillAnimRecord( player )
			return
		}
	#endif

	// New version has targets spawning immediately.
	CreateGunRangeTargetsForRealm( GetPlayerSquadRealm( player ) )

	if ( !data.completed_movement && !skipToPathfinder && !skipToPing )
	{
		waitthread StartTraining_Movement( player )
		data.completed_movement = true
		PIN_Training( player, "complete", "training_movement" )
	}

	if ( !data.completed_ordnance && !skipToPathfinder && !skipToPing )
	{
		waitthread StartTraining_Loot( player )
		data.completed_ordnance = true
		PIN_Training( player, "complete", "training_loot" )
	}

	if ( !data.completed_weapons && !skipToPathfinder && !skipToPing )
	{
		waitthread StartTraining_Weapons( player )
		PIN_Training( player, "complete", "training_weapons" )
		data.completed_weapons = true
	}

	if ( !data.gun_range_enabled )
	{
		data.lootBin1.Dissolve( ENTITY_DISSOLVE_CORE, <0, 0, 0>, 500 )
		data.lootBin2.Dissolve( ENTITY_DISSOLVE_CORE, <0, 0, 0>, 500 )
		CreateWeaponRacksForRealm( GetPlayerSquadRealm( player ) )
		CreateGunRangeTargetsForRealm( GetPlayerSquadRealm( player ) )
	}

	if ( !data.completed_ping && !skipToPathfinder )
	{
		waitthread StartTraining_Ping( player )
		PIN_Training( player, "complete", "training_ping" )
		data.completed_ping = true
	}

	if ( !data.completed_pathfinder )
	{
		waitthread StartTraining_Revive( player )
		PIN_Training( player, "complete", "training_revive" )

		waitthread StartTraining_Respawn( player )
		PIN_Training( player, "complete", "training_respawn" )

		waitthread StartTraining_Ultimate( player )
		PIN_Training( player, "complete", "training_ultimate" )

		data.completed_pathfinder = true
	}

	PIN_Training( player, "complete", "training_complete" )
	player.SetPlayerNetTime( "TrainingEndTime", Time() + GetTrainingEndTime() )
	player.SetPersistentVar( "trainingCompleted", 1 )

	float dummieDissolveTime = min( 5.0, GetTrainingEndTime() )
	wait 5.0
}

float function GetTrainingEndTime()
{
                     
	if ( Training_IsFTUEEnabled() )
		return TRAINING_FIRING_RANGE_QUEUE_TIME
                          
	
	return TRAINING_RETURN_TO_MENU_DURATION
}

entity function SpawnTrainingLootBin( entity player, vector origin, vector angles, array<string> lootRefs )
{
	entity lootBin = CreateCustomLootBin( origin, angles, lootRefs )
	lootBin.RemoveFromAllRealms()
	lootBin.AddToRealm( GetPlayerSquadRealm( player ) )
	lootBin.UnsetUsable()
	Highlight_SetFriendlyHighlight( lootBin, "sp_objective_entity" )
	Highlight_SetNeutralHighlight( lootBin, "sp_objective_entity" )
	Highlight_ClearFriendlyHighlight( lootBin )
	Highlight_ClearNeutralHighlight( lootBin )
	return lootBin
}

#endif

bool function Training_IsFTUEEnabled()
{
	if( !GetConVarBool( "ftue_flow_enabled" ) )
		return false

	bool ret = false
	#if CLIENT || UI
		ret = IsFeatureSuppressed( eFeatureSuppressionFlags.TRAINING_RETURN_TO_LOBBY )
	#elseif SERVER
		ret = file.proceedToFiringRange
	#endif
	return ret
}

#if CLIENT
void function Training_AddPlayer( entity player )
{
	printt( "Training: OnLocalPlayerSpawned", player )
}

void function OnLocalClientConnected( entity player )
{
	printt( "Training: OnLocalClientConnected", player )
	Remote_ServerCallFunction( "ClientCallback_SetProceedToFiringRange", Training_IsFTUEEnabled() )
}

void function TrainingEndTimeChanged( entity player, float new )
{
	if ( new > 0 )
	{
		if ( GetFirstTimePlayerState() < eNewPlayerState.TRAINING_COMPLETED )
		{
			SetFirstTimePlayerState( eNewPlayerState.TRAINING_COMPLETED )
		}

		var rui = CreateFullscreenRui( $"ui/training_end_countdown.rpak" )

		bool plv_ftue_loads_into_firingrange = GetCurrentPlaylistVarBool( "ftue_loads_into_firingrange", true )

		if (plv_ftue_loads_into_firingrange && ( file.ftueTestOn || ( !AreWeMatchmaking() && Training_IsFTUEEnabled() )))
		{
			#if DEVELOPER
				printt( format( "%s(): Match Making for Firing Range.", FUNC_NAME()) )
			#endif
			StartMatchmakingStandard( PLAYLIST_FIRING_RANGE )
		}
		
		// Add a fallback just in case firing range matchmaking takes an absurd amount of time.
		thread QuitToLobbyDelayed( player, new )
	}
}

void function QuitToLobbyDelayed( entity player, float time )
{
	EndSignal( player, "OnDestroy" )
	wait max( 0, time - Time() )

	if( AreWeMatchmaking() ) //Stop the Firing Range Queue from progressing further
		CancelMatchmaking()

	ScreenFade( player, 0, 0, 0, 255, 1.5, 5.0, FFADE_OUT )
	wait 2.0
	Remote_ServerCallFunction( "ClientCallback_LeaveMatch" )
}
#endif

#if SERVER
entity function GetTrainingNPCForPlayer( entity player, asset characterSettingsAsset )
{
	Assert( player in file.playerTrainingData )

	asset modelName = GetGlobalSettingsAsset( characterSettingsAsset, "bodyModel" )
	entity npc      = file.playerTrainingData[ player ].trainingNPC

	if ( IsValid( npc ) && npc.GetModelName() == modelName )
		return npc

	if ( IsValid( npc ) )
	{
		npc.SetModel( modelName )
		return npc
	}

	npc = CreatePropScript( modelName, < 0, 0, 0 >, < 0, 0, 0 >, SOLID_BBOX, 99999 )
	npc.Solid()

	if ( characterSettingsAsset == CHARACTER_BLOODHOUND )
		npc.SetFootstepType( "bloodhound" )
	else if ( characterSettingsAsset == CHARACTER_PATHFINDER )
		npc.SetFootstepType( "pathfinder" )

	int squadRealm = GetPlayerSquadRealm( player )
	npc.RemoveFromAllRealms()
	npc.AddToRealm( squadRealm )

	SetTeam( npc, player.GetTeam() )
	Highlight_SetFriendlyHighlight( npc, "sp_friendly_hero" )

	file.playerTrainingData[ player ].trainingNPC = npc

	return npc
}

entity function GetTrainingDummyForPlayer( entity player )
{
	Assert( player in file.playerTrainingData )

	entity dummy = file.playerTrainingData[ player ].trainingDummy

	if ( IsValid( dummy ) )
		return dummy

	dummy = CreatePropScript( TRAINING_DUMMY_MODEL, < 0, 0, 0 >, < 0, 0, 0 >, SOLID_BBOX, 99999 )
	//dummy = CreatePropDynamic( TRAINING_DUMMY_MODEL, < 0, 0, 0 >, < 0, 0, 0 >, SOLID_BBOX, 99999 )
	dummy.Solid()
	dummy.SetSkin( 1 ) //red
	dummy.SetScriptName( "survival_training_target_dummy" )
	dummy.SetFootstepType( "bloodhound" )

	int squadRealm = GetPlayerSquadRealm( player )
	dummy.RemoveFromAllRealms()
	dummy.AddToRealm( squadRealm )

	SetTeam( dummy, player.GetTeam() )
	Highlight_SetFriendlyHighlight( dummy, "sp_friendly_hero" )

	file.playerTrainingData[ player ].trainingDummy = dummy

	return dummy
}

entity function GetTrainingNPCNode( entity player, string nodeName )
{
	PlayerTrainingData data = file.playerTrainingData[ player ]

	entity node
	vector pos
	vector ang = < 0, 0, 0 >

	switch( nodeName )
	{
		case "npcNodeBloodhound1":
                      
				if( !IsStagingMU1() )
				{
					if ( IsValid( file.playerTrainingData[ player ].npcNodeBloodhound1 ) )
						return file.playerTrainingData[ player ].npcNodeBloodhound1
					if ( IsRandomizedTrainingPlaylistEnabled() )
					{
						node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound1", data.bloodhoundRandomStartOrigin, < 0, -90, 0 > )
					}
					else
					{
						//node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound1", <27260, -6238, -27548>, < 0, -90, 0 > )
						node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound1", OLD_BLOODHOUNDSTART_POS, < 0, -90, 0 > )
					}
				}
				else
				{
					// TODO: REFINE FOR MU1
					pos = NEW_BLOODHOUNDSTART_POS
					ang = < 0, -90, 0 >
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound1", pos, ang )
				}
				#if DEVELOPER
					if( DevDraws )
						//DebugDrawSphere( node.GetOrigin(), 5, <255, 0, 0>, true, 30.0 )
				#endif // DEVELOPER
        
                                                                          
                                                                
                                                
     
                                                                                                                                              
     
        
     
                                                                                                                                      
                                                                                                                                     
     
                            

			file.playerTrainingData[ player ].npcNodeBloodhound1 = node
			return node
		case "npcNodeBloodhound2":
                      
				if( !IsStagingMU1() )
				{
					if ( IsValid( file.playerTrainingData[ player ].npcNodeBloodhound2 ) )
						return file.playerTrainingData[ player ].npcNodeBloodhound2
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound2", < 30944, -6880, -29164 >, < 0, 90, 0 > )
				}
				else
				{
					array< vector > coords = BLOODHOUND2_COORDS[ 2 ]
					pos = coords[ 0 ]
					ang = coords[ 1 ]
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_bloodhound2", pos, ang )
				}
				#if DEVELOPER
					if( DevDraws )
						//DebugDrawSphere( node.GetOrigin(), 5, <255, 0, 0>, true, 30.0 )
				#endif // DEVELOPER
        
                                                                          
                                                                
                                                                                                                                    
                            

			file.playerTrainingData[ player ].npcNodeBloodhound2 = node
			return node
		case "npcNodePathfinder1":
                      
				if( !IsStagingMU1() )
				{
					if ( IsValid( file.playerTrainingData[ player ].npcNodePathfinder1 ) )
						return file.playerTrainingData[ player ].npcNodePathfinder1
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_pathfinder1", < 33119, -7765, -28916 >, < 0, 0, 0 > )
				}
				else
				{
					// TODO: REFINE FOR MU1.
					pos = NEW_PATHFINDER_POS[ 1 ]
					ang = NEW_PATHFINDER_ANG[ 1 ] + NPC_REF_ANGLE_ADJUST
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__npcNode_pathfinder1", pos , ang )
				}
				#if DEVELOPER
					if( DevDraws )
						//DebugDrawSphere( node.GetOrigin(), 5, <255, 0, 0>, true, 30.0 )
				#endif // DEVELOPER
        
                                                                          
                                                                
                                                                                                                                   
                       

			file.playerTrainingData[ player ].npcNodePathfinder1 = node
			return node
		case "trainingDummyNode":
                      
				if( !IsStagingMU1() )
				{
					if ( IsValid( file.playerTrainingData[ player ].trainingDummyNode ) )
						return file.playerTrainingData[ player ].trainingDummyNode
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__training_dummy_node", < 33262, -7828, -28916 >, < 0, 115, 0 > )
				}
				else
				{
					array< vector > coords = ROOFDUMMIE_COORDS[ file.Index_RoofDummie ]
					pos = coords[ 0 ]
					ang = coords[ 1 ] + NPC_REF_ANGLE_ADJUST
					node = CreateScriptMover( SURVIVAL_TRAINING_MOVER_SCRIPTNAME + "__training_dummy_node", pos, ang )
				}
				#if DEVELOPER
					if( DevDraws )
						//DebugDrawSphere( pos, 5, <255, 0, 0>, true, 30.0 )
				#endif // DEVELOPER
        
                                                                         
                                                               
                                                                                                                                     
                            

			file.playerTrainingData[ player ].trainingDummyNode = node
			return node
		default:
			Assert( false, "Invalid value for nodeName " + nodeName )
	}

	return null
}

void function TrainingNPCAnim( entity npc, entity node, string anim, string animNext = "", float blend = 0.5 )
{
	Signal( npc, "TrainingNPCAnim" )
	EndSignal( npc, "TrainingNPCAnim" )
	EndSignal( npc, "OnDeath" )
	EndSignal( npc, "OnDestroy" )

	waitthread PlayAnim( npc, anim, node, null, blend )

	if ( animNext != "" )
		thread PlayAnim( npc, animNext, node, null, blend )
}

void function TrainingNPCRecordedAnim( entity npc, asset animAsset, asset animAssetNext = $"", vector pos = < 0,0,0>, vector angles = <0,0,0> )
{
	Signal( npc, "TrainingNPCAnim" )
	EndSignal( npc, "TrainingNPCAnim" )
	EndSignal( npc, "OnDeath" )
	EndSignal( npc, "OnDestroy" )

	var anim = LoadRecordedAnimation( animAsset )
	npc.PlayRecordedAnimation( anim, pos, angles, 0.5 )
	wait GetRecordedAnimationDuration( anim )

	if ( animAssetNext == $"" )
		return

	anim = LoadRecordedAnimation( animAssetNext )
	npc.PlayRecordedAnimation( anim, pos, angles, 0.5 )
	//wait GetRecordedAnimationDuration( anim )
}

