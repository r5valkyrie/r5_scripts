#if CLIENT
void function ServerCallback_MonitorCommsMenuUsage( int type )
{
	thread ServerCallback_MonitorCommsMenuUsage_thread( type )
}

void function ServerCallback_MonitorCommsMenuUsage_thread( int type )
{
	entity player = GetLocalViewPlayer()
	if ( !IsValid( player ) )
		return

	EndSignal( player, "OnDeath", "OnDestroy" )

	float openMenuDuration = 0.0
	int menuStyle          = type == 0 ? eCommsMenuStyle.ORDNANCE_MENU : eCommsMenuStyle.PING_MENU

	while( IsValid( player ) )
	{
		if ( IsCommsMenuActive() && CommsMenu_GetCurrentCommsMenu() == menuStyle )
			openMenuDuration += 0.1
		else
			openMenuDuration = 0.0

		if ( openMenuDuration >= 0.4 )
		{
			Remote_ServerCallFunction( "ClientCallback_TrainingUsedCommsMenu", type )
			return
		}

		wait 0.1
	}
}

void function ServerCallback_SetCommsDialogueEnabled( int enabled )
{
	if ( enabled == 1 )
		SetCommsDialogueEnabled( true )
	else
		SetCommsDialogueEnabled( false )
}

#endif

#if SERVER
void function ClientCallback_TrainingUsedCommsMenu( entity player, int type )
{
	if ( !(player in file.playerTrainingData) )
		return

	if ( type == 0 )
	{
		file.playerTrainingData[ player ].openedOrdnanceMenu = true
	}
	else if ( type == 1 )
	{
		file.playerTrainingData[ player ].openedPingMenu = true
	}
}
void function ClientCallback_SetProceedToFiringRange( entity player, bool proceed )
{
	if( file.proceedToFiringRange != proceed )
	{
		file.proceedToFiringRange = proceed
	}
}
#endif

#if SERVER && DEVELOPER
bool function ClientCommand_mark_training_complete( entity player, array<string> args )
{
	// Mark training as complete, with regular flow
	PIN_Training( player, "complete", "training_complete" )
	player.SetPlayerNetTime( "TrainingEndTime", Time() + GetTrainingEndTime() )

	player.SetPersistentVar( "trainingCompleted", 1 )
	return true
}

void function TrainingBloodhoundSetup()
{
	entity player          = GP()
	vector bloodhoundStart = <0, 0, 0>

	if ( IsRandomizedTrainingPlaylistEnabled() )
	{
		bloodhoundStart = file.playerTrainingData[ player ].bloodhoundRandomStartOrigin
	}
	else
	{
                     
		if( !IsStagingMU1() )
		{
			bloodhoundStart = OLD_BLOODHOUNDSTART_POS
		}
		else
		{
			bloodhoundStart = NEW_BLOODHOUNDSTART_POS
		}
       
                                           
                           
	}

	player.SetThirdPersonShoulderModeOn()
	player.SetOrigin( bloodhoundStart + <-128, 0, 0> )
	player.SetAngles( <0, 0, 0> )
}
#endif


#if SERVER || CLIENT
bool function IsRandomizedTrainingPlaylistEnabled()
{
	return GetCurrentPlaylistVarBool( "sur_randomized_training_enabled", true )
}
#endif // SERVER || CLIENT


                               
#if SERVER
int function GetTruncatedNucleusId( entity player )
{
	string nucleusID = player.GetPINNucleusId()
	Assert( nucleusID.isnumeric() )
	int nucLen = nucleusID.len()
	// 9-digit numbers can always be represented as 32-bit ints
	int truncatedNucleusID = nucLen > 9 ? int( nucleusID.slice( ( nucLen - 9 ), nucLen ) ) : int( nucleusID )
	Assert( truncatedNucleusID < INT_MAX )
	return truncatedNucleusID
}


void function SelectPlayerForFTUETrainingTestCohort( entity player )
{
	int truncatedNucleusID = GetTruncatedNucleusId( player )
	if ( player.GetPersistentVarAsInt( "trainingCompleted" ) == 0 && GetConVarInt( "script_ftue_skip_training_ab_test" ) > 0 && truncatedNucleusID % GetConVarInt( "script_ftue_skip_training_ab_test" ) == 0 )
	{
		player.SetPersistentVar( "trainingCompleted", 1 )
		Remote_CallFunction_UI( player, "ServerCallback_SetPlaylistById", PLAYLIST_ID_NEW_PLAYER_ORIENTATION )
	}
}

const int FTUE_FORCE_GRADUATED_SENTINEL = 2
void function SelectPlayerForFTUEOrientationTestCohort( entity player )
{
	int truncatedNucleusID = GetTruncatedNucleusId( player )
	if ( player.GetPersistentVarAsInt( "botGraduationState" ) == 0 && GetConVarInt( "script_ftue_skip_orientation_ab_test" ) > 0 && truncatedNucleusID % GetConVarInt( "script_ftue_skip_orientation_ab_test" ) == 0 )
	{
		player.SetPersistentVar( "botGraduationState", FTUE_FORCE_GRADUATED_SENTINEL )
		player.SetPersistentVar( "showOrientationMatchGraduationDialog", false )
		SetPlayerBotQueueGraduation( player, FTUE_FORCE_GRADUATED_SENTINEL )
		Remote_CallFunction_UI( player, "ServerCallback_SetPlaylistById", PLAYLIST_ID_SURVIVAL )
	}
}
#endif
                                     