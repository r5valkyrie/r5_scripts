void function StartTraining_Movement( entity player )
{
	EndSignal( player, "OnDeath" )

	entity npc  = GetTrainingNPCForPlayer( player, CHARACTER_BLOODHOUND )
	entity node = GetTrainingNPCNode( player, "npcNodeBloodhound1" )

	thread TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_intro_start_idle", "mp_pt_medium_training_blood_intro_start_idle" )

	float startTime = Time() + 3.0
	while( true )
	{
		if ( Time() >= startTime )
			break
		if ( Distance( npc.GetOrigin(), player.GetOrigin() ) <= 700 )
			break
		WaitFrame()
	}

	                   
		if( IsStagingMU1())
			file.Index_RoofDummie = RandomIntRange( 0, ROOFDUMMIE_COORDS.len() - 1 )
       

	// Welcome to Apex Legends
	thread TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_intro", "mp_pt_medium_training_blood_intro_idle" )
	wait 2.5
	//waitthread PlayDialogueForPlayer( "Training_Welcome", player, npc )
	float duration = EmitSoundOnEntityOnlyToPlayer( npc, player, "diag_mp_trIntro_01_75_bloodhound_3p" )

	wait duration
	// I am Bloth Hoondr... you can call me bloodhound.
	//waitthread PlayDialogueForPlayer( "Training_Welcome2", player, npc )
	duration = EmitSoundOnEntityOnlyToPlayer( npc, player, "diag_mp_trIntro_02_50_bloodhound_3p" )

	wait duration
	// Basic Movement Checklist
	SetTutorialContext( player, eTutorialContext.MOVEMENT )

	// Let's start with basic movement. Complete the checklist on your HUD and then we'll get to the real stuff.
	//waitthread PlayDialogueForPlayer( "Training_Movement", player, npc )
	duration = EmitSoundOnEntityOnlyToPlayer( npc, player, "diag_mp_trIntro_03_50_bloodhound_3p" )
	wait duration


	while( !IsTutorialContextCompleted( player, eTutorialContext.MOVEMENT ) )
		wait 1.0

	SetTutorialContext( player, eTutorialContext.NONE )

	// Follow me. Sliding down hills will let you travel faster. Speed's important inside the Ring.
	StopDialogueForPlayer( player )
	thread PlayDialogueForPlayer( "Training_GoToLoot", player, npc )
	waitthread TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_intro_end" )

	thread SlideDownHillEffects( npc, player )

	asset bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform.rpak"
	vector pos = < 0,0,0 >
	vector angles = < 0,0,0 >

	if ( IsRandomizedTrainingPlaylistEnabled() )
	{
                     
			if( IsStagingMU1() )
			{
				// Update for MU1 to use the new recorded hillslide.
				//pos += deltaOldNewMap
				bloodhoundRecordedAnim = $"anim_recording/survival_training_bloodhound_hillslide_mu1.rpak"
			}
			else
			{
				switch ( file.playerTrainingData[player].bloodhoundRandomStartOrigin )
				{
					case playerAndBloodhoundStartOrigins[0][ "bloodhoundStart" ]:
						bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform.rpak"
						break

					case playerAndBloodhoundStartOrigins[1][ "bloodhoundStart" ]:
						bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform2.rpak"
						break

					case playerAndBloodhoundStartOrigins[2][ "bloodhoundStart" ]:
						bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform3.rpak"
						break

					default:
						Assert( false, "Couldn't find bloodhound recorded slide anim for player: " + player )
				}
			}
       
                                                                         
    
                                                                 
                                                                                       
          

                                                                 
                                                                                        
          

                                                                 
                                                                                        
          

            
                                                                                          
    
                           
	}
	#if DEVELOPER
		if( DevDraws )
		{
			printt( format( "%s(): Bloodhound Hill Start Pos: %s", FUNC_NAME(), string( npc.GetOrigin() ) ))
			printt( format( "%s(): Bloodhound Hill Start Ang: %s", FUNC_NAME(), string( npc.GetAngles() ) ))
			//DebugDrawSphere( npc.GetOrigin(), 25, <0, 0, 255>, true, 100 )
		}
	#endif
	waitthread TrainingNPCRecordedAnim( npc, bloodhoundRecordedAnim, $"", pos, angles )
}
#if DEVELOPER
void function DEV_Training_PlayBloodHoundSlide( entity player, int i, vector posAdjust = < 0, 0, 0 >, vector angAdjust = < 0, 0, 0 > )
{
	asset bloodhoundRecordedAnim

	vector pos =  posAdjust
	vector angles = angAdjust

                    
		if( IsStagingMU1() )
		{
			pos += deltaOldNewMap
			//bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform.rpak"
			bloodhoundRecordedAnim = $"anim_recording/survival_training_bloodhound_hillslide_mu1.rpak"
		}
		else
		{
			switch ( i )
			{
				case 0:
					bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform.rpak"
					break

				case 1:
					bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform2.rpak"
					break

				case 2:
					bloodhoundRecordedAnim = $"anim_recording/survival_training_cave_to_platform3.rpak"
					break

				default:
					Assert( false, "Couldn't find bloodhound recorded slide anim for player: " + player )
			}
		}
      
              
   
          
                                                                                      
         

          
                                                                                       
         

          
                                                                                       
         

           
                                                                                         
   
                          
	thread TrainingNPCRecordedAnim( GetTrainingNPCForPlayer( player, CHARACTER_BLOODHOUND ), bloodhoundRecordedAnim, $"", pos, angles )
}

void function DEV_DoTutAnims( string section )
{
	thread DEV_DoTutAnims_Thread( section )
}

void function DEV_DoTutAnims_Thread( string section )
{
	entity player = GP()
	entity npc
	entity node

	switch( section )
	{
		case "loot":
			npc  = GetTrainingNPCForPlayer( player, CHARACTER_BLOODHOUND )
			node = GetTrainingNPCNode( player, "npcNodeBloodhound2" )
			//TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_transA", "mp_pt_medium_training_blood_idle_A" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_transA" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_transB", "mp_pt_medium_training_blood_idle_B" )
			break
		case "weapons":
			npc  = GetTrainingNPCForPlayer( player, CHARACTER_BLOODHOUND )
			node = GetTrainingNPCNode( player, "npcNodeBloodhound2" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_trans_C", "mp_pt_medium_training_blood_idle_C" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_idle_C" )
			break
		case "ping":
			npc  = GetTrainingNPCForPlayer( player, CHARACTER_BLOODHOUND )
			node = GetTrainingNPCNode( player, "npcNodeBloodhound2" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_talk_C", "mp_pt_medium_training_blood_idle_C" )
			TrainingNPCAnim( npc, node, "mp_pt_medium_training_blood_twitch_C", "mp_pt_medium_training_blood_idle_C" )
			break
	}
}

void function DEV_PrintDummieInfo()
{
	entity dummie = GetTrainingDummyForPlayer( GP() )
	if( IsValid( dummie ) )
	{
		printt( "Dummie Position == " + dummie.GetOrigin() )
		printt( "Dummie Angles 	 == " + dummie.GetAngles() )
	}
}

void function DEV_Seq_DropshipAndDummie()
{
	entity player = GP()
	entity dummy = GetTrainingDummyForPlayer( player )
	Seq_DropshipAndDummie( player, dummy )
}

void function DEV_Do_Training_Respawn()
{
	thread DEV_Do_Training_Respawn_Thread()
}

void function DEV_Do_Training_Respawn_Thread()
{
	entity player = GP()

	// [92.653] setpos -5436.907715 -950.374695 396.061798;setang 17.843922 -171.789993 0.000000
	vector pos = < -5436.907715, -950.374695, 396.061798 >
	vector ang = < 17.843922, -171.789993, 0.000000 >

	player.SetAngles( ang )
	//player.StartTeleport() // S3: entity method not available
	WaitFrame()

	if ( !IsValid( player ) )
		return

	bool success = TeleportPlayerNoInterp( player, pos )

	thread StartTraining_Respawn( player)
}

void function DEV_Do_Training_Revive()
{
	entity player = GP()
	thread StartTraining_Revive( player)
}

void function DEV_Goto_Pathfinder_AfterDeath( )
{
	entity player = GP()

	PlayerTrainingData data = file.playerTrainingData[ player ]

	data.completed_movement = true
	data.completed_ordnance = true
	data.completed_weapons = true
	data.completed_ping = true

	player.TakeDamage( player.GetMaxHealth() + 1, null, null, { damageSourceId=damagedef_suicide } )
}

