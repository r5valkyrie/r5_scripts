struct AccumulatedDamageData
{
	float accumulatedDamage
	float lastDamageTime
}

struct
{
	float titanMeterGainScale = 0.0001
	table<entity, AccumulatedDamageData> playerAccumulatedDamageData
	table < entity, float > smallDamageAccumulation
	bool hammerpointIgnoreShadows
} file

#if DEV
const bool DEBUG_DAMAGE_AMOUNT = false
#endif

void function CodeCallback_Init()
{
	RegisterSignal( "DamagedPlayerOrNPC" )
	RegisterSignal( "UpdateAccumulatedDamageAfterDelay" )

	file.hammerpointIgnoreShadows = GetCurrentPlaylistVarBool( "weapon_hammerpoint_ignore_shadows", false )

	AddCallback_OnClientConnected( OnClientConnected )
}

void function OnClientConnected( entity player )
{
	AccumulatedDamageData damageData
	file.playerAccumulatedDamageData[player] <- damageData
	file.smallDamageAccumulation[ player ] <- 0.0
}

string function ShortenDamageCallbackName( string funcName )
{
	funcName = replace( funcName, "Player", "Plr" )
	funcName = replace( funcName, "Damage", "Dmg" )
	return funcName
}

                     
struct FallDamageProtectionData
{
	float timeStarted
	int counter
}
table<entity, FallDamageProtectionData> s_mapPlayerToFallDamageData
bool function UpdateFallDamageTrackingAndGetShouldProtect( entity player )
{
	const float TIMEOUT_RESET = 5.0
	const float MAX_PROTECT_COUNT = 2
	const float MAX_PROTECT_TIME = 1.0

	if ( !(player in s_mapPlayerToFallDamageData) )
	{
		FallDamageProtectionData newData
		s_mapPlayerToFallDamageData[player] <- newData
	}
	FallDamageProtectionData data = s_mapPlayerToFallDamageData[player]

	float timeNow = Time()
	if ( (timeNow - data.timeStarted) > TIMEOUT_RESET )
	{
		data.timeStarted = timeNow
		data.counter = 0
	}

	data.counter++
	if ( data.counter > MAX_PROTECT_COUNT )
		return false
	if ( (timeNow - data.timeStarted) > MAX_PROTECT_TIME )
		return false

	return true	// yes, should protect the player
}
                           

// TODO: Get an equivalent callback happening on the client, so we can stop using ServerCallback_PlayerTookDamage which is always out of date to some degree.
void function CodeCallback_DamagePlayerOrNPC( entity ent, var damageInfo )
{
	bool entIsPlayer = ent.IsPlayer()
	bool entIsTitan = ent.IsTitan()
	bool entIsNPC = ent.IsNPC()

	entity attacker = DamageInfo_GetAttacker( damageInfo )
	entity inflictor = DamageInfo_GetInflictor( damageInfo )

	bool attackerIsPlayer = false
	bool attackerIsTitan = false
	bool attackerIsNPC = false

	if ( IsValid( attacker ) )
	{
		attackerIsPlayer = attacker.IsPlayer()
		attackerIsTitan = attacker.IsTitan()
		attackerIsNPC = attacker.IsNPC()
	}

	#if SERVER
		//WeaponStatsHook_OnPreDamageEnemy( ent, attacker, damageInfo )
	#endif

	// Set damage source correctly when npc grunts or titans try to melee us
	if ( attackerIsNPC )
	{
		if ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_MELEE ) )
		{
			if ( attackerIsTitan )
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.auto_titan_melee )
			}
			else if ( IsSpectre( attacker ) )
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.spectre_melee )
			}
			else if ( IsProwler( attacker ) )
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.prowler_melee )
			}
			                         
				else if ( IsSpider( attacker ) )
				{
					DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.spider_melee )
				}
         
			//else if ( IsNessie( attacker ) )
			//{
			//	DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.nessie_hug )
			//}
			else if ( IsSuperSpectre( attacker ) )
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.super_spectre_melee )
			}
			else
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.grunt_melee )
			}
		}
		else if( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_BULLET ) )
		{
			if ( IsSpectre( attacker ) )
			{
				//can add more cases later
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.spectre_ranged_hemlock )
			}
			                         
			else if ( IsSpider( attacker ) )
			{
				DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.spider_ranged )
			}
         
			//else if ( IsNessie( attacker ) )
			//{
			//	DamageInfo_SetDamageSourceIdentifier( damageInfo, eDamageSourceId.nessie_kiss )
			//}
		}
	}

	int sourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	                     
		if ( entIsPlayer && (sourceID == eDamageSourceId.fall) && HoverVehicle_IsPlayerInAnyVehicle( ent ) )
		{
			bool shouldProtect = UpdateFallDamageTrackingAndGetShouldProtect( ent )
			if ( shouldProtect )
			{
				printf( "Not hitting player with fall damage, because they're in a vehicle: %s", string( ent ) )
				DamageInfo_Print( damageInfo, "no fall dmg in vehicle" )
				DamageInfo_SetDamage( damageInfo, 0 )
				return
			}
			printf( "Allowing fall damage to harm player even though they're in a vehicle: %s", string( ent ) )
		}
                            

	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "CodeCallback_DamagePlayerOrNPC ent:", ent )
		printt( "    Attacker:", DamageInfo_GetAttacker( damageInfo ) )
		printt( "    Inflictor:", DamageInfo_GetInflictor( damageInfo ) )
		printt( "    Distance:", DamageInfo_GetDistFromAttackOrigin( damageInfo ) )
		printt( "    Original damage:", DamageInfo_GetDamage( damageInfo ) )
		printt( "    Hitbox:", DamageInfo_GetHitBox( damageInfo ) )
		printt( "    SourceID:", sourceID )
		if ( sourceID == -1 )
			printt( "    SourceID: From Code (npc melee, etc)" )
		else
			printt( "    SourceID:", GetObitFromDamageSourceID( sourceID ) )

		PrintDamageFlags( DamageInfo_GetCustomDamageType( damageInfo ) )
	#endif

	if ( !ScriptCallback_ShouldEntTakeDamage( ent, damageInfo ) )
	{
		// EMP triggers on damage, but in some cases players are invlunerable (embark, disembark, etc...)
		if ( entIsPlayer && DamageInfo_GetDamageSourceIdentifier( damageInfo ) in level._empForcedCallbacks )
		{
			if ( ShouldPlayEMPEffectEvenWhenDamageIsZero( ent, attacker ) )
				EMP_DamagedPlayerOrNPC( ent, damageInfo )
		}

		//AddEntityCallback_OnFriendlyFire allows scripter to still detect and deal with friendlyfire events
		if ( (ent.e.entFriendlyFireCallbacks.len() > 0) && ShouldPreventDamageDueToFriendlyFire( attacker, ent, damageInfo ) )
		{
			// Added via AddEntityCallback_OnFriendlyFire
			foreach ( callbackFunc in ent.e.entFriendlyFireCallbacks )
			{
				callbackFunc( ent, damageInfo )
			}
			#if VERBOSE_DAMAGE_PRINTOUTS
				printt( "    after AddEntityCallback_OnFriendlyFire callbacks:", DamageInfo_GetDamage( damageInfo ) )
			#endif
		}

		                    
		if( sourceID == eDamageSourceId.damagedef_grenade_gas && entIsPlayer && ent.HasPassive( ePassives.PAS_GAS_HP_REGEN ) )
		{
			WeaponGrenadeGas_StartHealing( ent )
		}
        

		DamageInfo_Print( damageInfo, "no take dmg" )
		DamageInfo_SetDamage( damageInfo, 0 )
		return
	}

	if ( ( IsAirDrone( ent ) ) && ( DamageInfo_GetDamageSourceIdentifier( damageInfo ) in level._empForcedCallbacks ) )
	{
		EMP_DamagedPlayerOrNPC( ent, damageInfo )
		DamageInfo_Print( damageInfo, "air drone no emp" )
		DamageInfo_SetDamage( damageInfo, 0 )
		return
	}

	if( ( ent.IsNPC() && !ent.IsNonCombatAI() ) && ( DamageInfo_GetDamageSourceIdentifier( damageInfo ) in level._empForcedCallbacks ) )
	{
		EMP_DamagedPlayerOrNPC( ent, damageInfo )
	}

	if ( DamageInfo_GetDamageSourceIdentifier( damageInfo ) == damagedef_titan_step )
		HandleFootstepDamage( ent, damageInfo )

	// HACK helps trap/grenade weapons do damage to the correct entities (player who deployed it as well as the team opposite his)
	if ( IsValid( inflictor ) && "originalOwner" in inflictor.s )
	{
		entity ogOwner = expect entity( inflictor.s.originalOwner )
		if ( IsValid( ogOwner ) )
		{
			// if the victim is the guy who damaged the trap, and he is not the ogOwner...
			if ( ent == attacker && ent != ogOwner )
			{
				// HACK to do this legit we need DamageInfo_SetAttacker( damageInfo )
				// victim should take damage from the original owner instead of the satchel attacker so he gets a kill credit
				ent.TakeDamage( DamageInfo_GetDamage( damageInfo ), ogOwner, inflictor, { weapon = DamageInfo_GetWeapon( damageInfo ), origin = DamageInfo_GetDamagePosition( damageInfo ), force = DamageInfo_GetDamageForce( damageInfo ), scriptType = DamageInfo_GetCustomDamageType( damageInfo ), damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo ) } )

				// now zero out the normal damage and return
				DamageInfo_Print( damageInfo, "trap damager" )
				DamageInfo_SetDamage( damageInfo, 0 )
				return
			}
		}
	}

	if ( IsValid( inflictor ) )
	{
		if ( inflictor.IsProjectile() && entIsPlayer )
		{
			if ( inflictor.proj.damageScale != 1.0 )
			{
				DamageInfo_ScaleDamage( damageInfo, inflictor.proj.damageScale )
				DamageInfo_Print( damageInfo, "proj.damageScale " + inflictor.proj.damageScale + " -> " + DamageInfo_GetDamage( damageInfo ) )
			}

			// Don't take damage from projectiles created before you where spawned.
			if ( inflictor.GetProjectileCreationTime() < ent.s.respawnTime && ( Time() - ent.s.respawnTime ) < 2.0 )
			{
				DamageInfo_Print( damageInfo, "proj created before respawn" )
				DamageInfo_SetDamage( damageInfo, 0 )
				return
			}
		}

		if ( inflictor.e.onlyDamageEntitiesOnce == true || inflictor.e.onlyDamageEntitiesOncePerTick == true )
		{
			Assert( !inflictor.e.damagedEntities.contains(ent) )
			inflictor.e.damagedEntities.append( ent )
		}
	}

	ApplyUnshieldedDamageScalar( ent, damageInfo )

	// Round damage to nearest full value
	DamageInfo_SetDamage( damageInfo, floor( DamageInfo_GetDamage( damageInfo ) + 0.5 ) )
	if ( DamageInfo_GetDamage( damageInfo ) <= 0 )
	{
		DamageInfo_Print( damageInfo, "rounded to 0" )
		return
	}

	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    rounded damage amount:", DamageInfo_GetDamage( damageInfo ) )
	#endif

	HandleLocationBasedDamage( ent, damageInfo )
	DamageInfo_SetDamage( damageInfo, floor( DamageInfo_GetDamage( damageInfo ) + 0.5 ) )
	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    after location based damage:", DamageInfo_GetDamage( damageInfo ) )
	#endif

	RunClassDamageCallbacks( ent, damageInfo )
	DamageInfo_SetDamage( damageInfo, floor( DamageInfo_GetDamage( damageInfo ) + 0.5 ) )
	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    after class damage callbacks:", DamageInfo_GetDamage( damageInfo ) )
	#endif
	if ( DamageInfo_GetDamage( damageInfo ) == 0 )
	{
		DamageInfo_Print( damageInfo, "0 dmg" )
		return
	}

	// use AddDamageByCallback( "classname", function ) to registed functions
	if ( IsValid( attacker ) )
	{
		if ( attackerIsTitan )
		{
			entity soul = attacker.GetTitanSoul()
			if ( IsValid( soul ) )
			{
				float damageAmpScale = 1.0 + StatusEffect_GetSeverity( soul, eStatusEffect.titan_damage_amp )
				if ( damageAmpScale != 1.0 )
				{
					DamageInfo_ScaleDamage( damageInfo, damageAmpScale )
					DamageInfo_Print( damageInfo, "damageAmpScale " + damageAmpScale + " -> " + DamageInfo_GetDamage( damageInfo ) )
				}
			}
		}

                                 
                      
   
                                                            
    
                                                                                 

                                                                               

                           
     
                                                                                      
                               
                                                                                         

                                                    
                            

                                                      
                            

                                                   
                                                         
                                                                                       
     
    
   
       
		string attackerClassName = attacker.GetClassName()
		if ( attackerClassName in svGlobal.damageByCallbacks )
		{
			foreach ( callbackFunc in svGlobal.damageByCallbacks[attackerClassName] )
			{
				callbackFunc( ent, damageInfo )
				DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
				if ( DamageInfo_GetDamage( damageInfo ) == 0 )
					return
			}
		}
	}

	float damageMultiplier = 1.0 + StatusEffect_GetSeverity( ent, eStatusEffect.damage_received_multiplier )
	if ( damageMultiplier != 1.0 )
	{
		DamageInfo_Print( damageInfo, "dmg_rcv_mult " + damageMultiplier + " -> " + DamageInfo_GetDamage( damageInfo ) )
		DamageInfo_ScaleDamage( damageInfo, damageMultiplier )
	}

	// Added via AddEntityCallback_OnDamaged
	foreach ( callbackFunc in ent.e.entDamageCallbacks )
	{
		callbackFunc( ent, damageInfo )
		DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
	}
	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    after AddEntityCallback_OnDamaged callbacks:", DamageInfo_GetDamage( damageInfo ) )
	#endif

	// use AddDamageCallbackSourceID( "classname", function ) to registed functions
	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	if ( damageSourceId in shGlobal.damageSourceIdCallbacks )
	{
		foreach ( callbackFunc in shGlobal.damageSourceIdCallbacks[ damageSourceId ] )
		{
			callbackFunc( ent, damageInfo )
			DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
			damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo ) //callback may have changed the damageSourceId, so let's get that again.
		}
	}
	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    after damageSourceID callbacks:", DamageInfo_GetDamage( damageInfo ) )
	#endif

	#if DEV
		if ( GetBugReproNum() == 1747 ) //Testing for FastPatch - Server script change - 2x damage
		{
			DamageInfo_ScaleDamage( damageInfo, 2.0 )
		}

		#if VERBOSE_DAMAGE_PRINTOUTS
			printt( "    after fastPatch x2 damage amp, CodeCallback_DamagePlayerOrNPC:", DamageInfo_GetDamage( damageInfo ) )
		#endif
	#endif

	                    
		if( entIsPlayer && IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_EXPLOSION ) )
		{
			float damageScale = 1.0
			if( ent.HasPassive( ePassives.PAS_EXPLOSIVE_DAMAGE_RESIST ) ) // upgrade_explosive_damage_resist
			{
				const PAS_EXPLOSIVE_DAMAGE_RESIST_MULTIPLIER = 0.5
				damageScale = PAS_EXPLOSIVE_DAMAGE_RESIST_MULTIPLIER
			}

                           
                                                                     
    
                                                                   
    
                                


			if( damageScale < 1.0 )
			{
				float scaledDamage = DamageInfo_GetDamage( damageInfo ) * damageScale
				if ( scaledDamage < 1.0 )
				{
					file.smallDamageAccumulation[ ent ] += scaledDamage
					if( file.smallDamageAccumulation[ent] > 1.0 )
					{
						DamageInfo_SetDamage( damageInfo, int( file.smallDamageAccumulation[ ent ] ) )
						file.smallDamageAccumulation[ent] -= file.smallDamageAccumulation[ ent ]
					}
					else
					{
						DamageInfo_SetDamage( damageInfo, 0 )
					}
				}
				else
				{
					int roundedScaledDamage = int( floor( scaledDamage + 0.5 ) )
					DamageInfo_SetDamage( damageInfo, roundedScaledDamage )
				}
			}
			if( ent.HasPassive( ePassives.PAS_EXPLOSIVE_DAMAGE_SPEED_BOOST ) )
			{
				//ShPassive_ExplosiveSpeedBoostStart( ent )
			}
		}

		if( entIsPlayer )
		{
			float ziplineDamageMultiplier = 1.0//ZiplineShield_GetDamageMultiplier( ent )
			if( ziplineDamageMultiplier != 1.0 )
			{
				DamageInfo_Print( damageInfo, "ziplineDamageMultiplier " + ziplineDamageMultiplier + " -> " + DamageInfo_GetDamage( damageInfo ) )
				DamageInfo_ScaleDamage( damageInfo, ziplineDamageMultiplier )
			}
		}
       

	if ( DamageInfo_GetDamage( damageInfo ) == 0 )
	{
		DamageInfo_Print( damageInfo, "0 dmg" )
		return
	}

	// save a bunch of stuff because bleedout messes with health
	float actualDamage  = DamageInfo_GetDamage( damageInfo )
	int savedHealth = ent.GetHealth()
	bool wasBleedingOut = entIsPlayer && Bleedout_IsBleedingOut( ent )
	RunClassDamageFinalCallbacks( ent, damageInfo )

	#if SERVER
		//WeaponStatsHook_OnDamageEnemy( ent, attacker, damageInfo )
	#endif

	               
		int overshieldDamage = 0

		                    
			int extrashieldHealth = ent.IsPlayer() ? ent.GetShieldHealth() : 0
			if ( extrashieldHealth > 0 && !IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_BYPASS_SHIELD ) )
			{

				int multipliedDamage = int( actualDamage * DamageInfo_GetDamageShieldScale( damageInfo ) )

				overshieldDamage = minint( extrashieldHealth, multipliedDamage )
				int remainingOvershieldHealth = extrashieldHealth - overshieldDamage
				//SetPlayerExtraShields( ent, remainingOvershieldHealth )

				//if( remainingOvershieldHealth == 0 )
				//{
				//	string newArmorRef = UpgradeCore_GetPlayerShieldCoreRef( ent )
				//	SURVIVAL_GivePlayerEquipment( ent, newArmorRef, ent.GetShieldHealth() )
				//}

				actualDamage = actualDamage - overshieldDamage
				if( actualDamage <= 0 )
				{
					actualDamage = 0
					// this is technically wrong, since you could deal exactly extra shields with no actual shield damage
					// but the way we determine we are hitting extra shields vs conduit overshields
					// is if extra shields > 0. so if we deplete all the extra shields we'll consider this conduit shields
					// instead just lie to a player a tiny bit if this somehow exactly happens
					if( remainingOvershieldHealth > 0 )
					{
						DamageInfo_AddCustomDamageType( damageInfo, DF_OVERSHIELD )
					}
				}

				DamageInfo_SetDamage( damageInfo, actualDamage )
			}
        

		int tempShieldHealth = ent.IsPlayer() ? ent.GetShieldHealth() : 0
		if ( actualDamage > 0 && tempShieldHealth > 0 && !IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_BYPASS_SHIELD ) )
		{
			DamageInfo_AddCustomDamageType( damageInfo, DF_OVERSHIELD )

			int multipliedDamage = int( actualDamage * DamageInfo_GetDamageShieldScale( damageInfo ) )

			overshieldDamage = minint( tempShieldHealth, multipliedDamage )
			int remainingOvershieldHealth = tempShieldHealth - overshieldDamage
			//SetPlayerTempshieldAmt( ent, remainingOvershieldHealth )

			actualDamage = actualDamage - overshieldDamage
			if( actualDamage < 0 )
				actualDamage = 0

			DamageInfo_SetDamage( damageInfo, actualDamage )
		}

       

	bool shadowSaveFromDeath = false
	int shieldDamage = 0

	if ( !entIsTitan )
	{
		if ( entIsPlayer && ent.IsShadowForm() )
		{
			shadowSaveFromDeath = ShadowHealthUpdate( ent, damageInfo )
		}
		else
		{
			shieldDamage = PilotShieldHealthUpdate( ent, damageInfo )
		}
	}

	int postShieldDamage = maxint( int( actualDamage ) - shieldDamage, 0 )

	bool isShieldOnlyDamage = bool( DamageInfo_GetCustomDamageType( damageInfo ) & DF_SHIELD_ONLY_DAMAGE )
	if ( isShieldOnlyDamage )
		postShieldDamage = 0

	if ( shieldDamage > 0 || isShieldOnlyDamage )
		DamageInfo_SetDamage( damageInfo, postShieldDamage )

	int healthDamage  = minint( postShieldDamage, savedHealth )

	int effectiveShieldDamage = shieldDamage
	               
		effectiveShieldDamage = shieldDamage + overshieldDamage
       

	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    after class damage final callbacks:", DamageInfo_GetDamage( damageInfo ) )
	#endif


	if ( DamageInfo_GetDamage( damageInfo ) == 0 && effectiveShieldDamage == 0 )
	{
		DamageInfo_Print( damageInfo, "0 dmg 0 shield" )
		return
	}

	if ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS ) )
		DamageInfo_AddDamageFlags( damageInfo, DAMAGEFLAG_NOPAIN )

	TitanDamage titanDamage
	if ( entIsPlayer )
	{
		PlayerTookDamage( ent, damageInfo, attacker, inflictor, damageSourceId )

		#if DEV
			if( DEBUG_DAMAGE_AMOUNT )
			{
				printt( "Player took damage, Actual Damage: ", actualDamage, " Total Damage: ", DamageInfo_GetDamage( damageInfo ), " Shield Damage: ", effectiveShieldDamage )
			}
		#endif //DEV

		float damageHistoryTime = GetCurrentPlaylistVarFloat( "max_damage_history_time", MAX_DAMAGE_HISTORY_TIME  )

		if ( effectiveShieldDamage > 0 )
			StoreDamageHistoryAndUpdate( ent, damageHistoryTime, float( effectiveShieldDamage ), attacker.GetOrigin(), DamageInfo_GetCustomDamageType( damageInfo ), damageSourceId, attacker )
		if ( DamageInfo_GetDamage( damageInfo ) != 0 )
			StoreDamageHistoryAndUpdate( ent, damageHistoryTime, DamageInfo_GetDamage( damageInfo ), attacker.GetOrigin(), DamageInfo_GetCustomDamageType( damageInfo ) & ~DF_SHIELD_DAMAGE, damageSourceId, attacker )

		if ( DamageInfo_GetDamage( damageInfo ) == 0 && entIsTitan )
		{
			DamageInfo_Print( damageInfo, "0 dmg and titan" )
			return
		}

		if ( attackerIsNPC && CanNPCDoDamageOnBehalfOfPlayer(attacker) )
		{
			entity playerOwner = attacker.GetBossPlayer()
			if ( IsValid( playerOwner ) )
			{
				PlayerDamageFeedback( ent, damageInfo, effectiveShieldDamage )
			}
		}

		if ( attackerIsPlayer )
			PlayerDamageFeedback( ent, damageInfo, effectiveShieldDamage )

		if ( !entIsTitan )
			ent.SetCloakFlicker( 0.5, 0.65 )
	}
	else
	{
		Assert( entIsNPC )
		bool clearedDamage
		if ( ent.ai.buddhaMode )
		{
			float currentDamage = DamageInfo_GetDamage( damageInfo )
			int remainingHealth = ent.GetHealth()

			const int DOOMED_MIN_HEALTH = 1
			if ( currentDamage >= remainingHealth - ( DOOMED_MIN_HEALTH + 1 ) )
			{
				currentDamage = max( remainingHealth - ( DOOMED_MIN_HEALTH + 1 ), 0 )
				DamageInfo_SetDamage( damageInfo, currentDamage )
				clearedDamage = currentDamage == 0
				DamageInfo_Print( damageInfo, "ai buddha -> " + DamageInfo_GetDamage( damageInfo ) )
			}
		}

		if ( !clearedDamage )
			Generic_NPCTookDamage( ent, damageInfo, titanDamage )

		if ( attackerIsPlayer || attackerIsNPC && CanNPCDoDamageOnBehalfOfPlayer(attacker) )
			PlayerDamageFeedback( ent, damageInfo, effectiveShieldDamage )
	}

	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    After player damage mod:", DamageInfo_GetDamage( damageInfo ) )
	if ( titanDamage.shieldDamage > 0 )
		printt( "    	Shield Damage:", titanDamage.shieldDamage )
	#endif

	// Added via AddEntityCallback_OnPostDamaged
	foreach ( callbackFunc in ent.e.entPostDamageCallbacks )
	{
		callbackFunc( ent, damageInfo )
		DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
	}

	UpdateLastDamageTime( ent, attacker )

	UpdateAttackerInfo( ent, attacker, actualDamage )
	if ( attackerIsPlayer )
	{
		if ( !IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS ) )
		{
			entity weapon = DamageInfo_GetWeapon( damageInfo )
			Survival_PlayerDealtDamage( attacker, ent, weapon, healthDamage, effectiveShieldDamage, 0, DamageInfo_GetDamageType( damageInfo ) )

                    
                                                                                                                                             
         

			Ultimates_OnPlayerDealtDamage( attacker, ent, healthDamage, effectiveShieldDamage )

			//LiveAPI_SendCombatInstanceEvent( eLiveAPI_EventTypes.playerDamaged, attacker, ent, damageSourceId, healthDamage + effectiveShieldDamage )
		}
	}
	else if ( attackerIsNPC && CanNPCDoDamageOnBehalfOfPlayer(attacker) )
	{
		entity playerOwner = attacker.GetBossPlayer()
		if (IsValid(playerOwner) && playerOwner.IsPlayer())
		{
			Survival_PlayerDealtDamage( playerOwner, ent, null, healthDamage, effectiveShieldDamage, 0, DamageInfo_GetDamageType( damageInfo ) )
			Ultimates_OnPlayerDealtDamage( playerOwner, ent, healthDamage, effectiveShieldDamage )

			//LiveAPI_SendCombatInstanceEvent( eLiveAPI_EventTypes.playerDamaged, playerOwner, ent, damageSourceId, healthDamage + effectiveShieldDamage )
		}
	}

	if ( !IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS ) )
	{
		if ( attackerIsPlayer )
		{
			if ( entIsTitan )
			{
				PlayerDealtTitanDamage( attacker, ent, actualDamage, damageInfo )

				entity entSoul = ent.GetTitanSoul()
				if ( attacker.p.currentTargetPlayerOrSoul_Ent != entSoul )
				{
					attacker.p.currentTargetPlayerOrSoul_Ent = ent.GetTitanSoul()
				}
				attacker.p.currentTargetPlayerOrSoul_LastHitTime = Time()
			}
			else if ( entIsPlayer )
			{
				attacker.p.currentTargetPlayerOrSoul_Ent = ent
				attacker.p.currentTargetPlayerOrSoul_LastHitTime = Time()
			}
		}
	}

	if ( entIsPlayer && !entIsTitan )
		PilotDamageFlinch( ent, damageInfo )

	#if VERBOSE_DAMAGE_PRINTOUTS
		printt( "    final damage done - damage: " + DamageInfo_GetDamage( damageInfo ) + " effectiveShieldDamage: " + effectiveShieldDamage + " total Damage: " +  DamageInfo_GetDamage( damageInfo ) + effectiveShieldDamage)
		printt( "	 health: " + ent.GetHealth() )
	#endif

	RunClassPostDamageCallbacks( ent, damageInfo )

	//pain sounds _base_gametype.nut, death sounds in _death_package.nut
	// this is after "post damage callbacks" so that it runs after battle chatter, thus battle chatter takes priority
	HandlePainSounds( ent, damageInfo )

	#if VERBOSE_DAMAGE_PRINTOUTS
		printf( "    after RunClassPostDamageCallbacks(): %d, forcekill:%s", (DamageInfo_GetDamage( damageInfo ) + effectiveShieldDamage), (DamageInfo_GetForceKill( damageInfo ) ? "TRUE" : "false") )
	#endif

	#if SERVER
		bool isValidHeadshot = IsValidHeadShot( damageInfo, ent )
		StatsHook_OnPlayerOrNPCTookDamage( attacker, ent, isValidHeadshot, damageInfo, healthDamage, effectiveShieldDamage )
	#endif

	// Don't allow the player to die, but allow all damage callbacks to fire first
	if ( shadowSaveFromDeath )
		DamageInfo_SetDamage( damageInfo, 0 )

	//Assert( (DamageInfo_GetDamage( damageInfo ) == 0 && effectiveShieldDamage > 0) || DamageInfo_GetDamage( damageInfo ) == savedDamage, "damageInfo damage was modified after RunClassDamageFinalCallbacks" )
	attacker.Signal( "DamagedPlayerOrNPC" )
}

void function ApplyUnshieldedDamageScalar( entity ent, var damageInfo )
{
	if ( file.hammerpointIgnoreShadows )
	{
		if ( ent.IsPlayer() && ent.IsShadowForm() )
			return
	}

	entity weapon = DamageInfo_GetWeapon( damageInfo )
	if ( !IsValid( weapon ) )
		return

	float ogDmg = DamageInfo_GetDamage( damageInfo )
	float dmgToScale = 0

	int shieldHealth = ent.GetShieldHealth()

	if ( ent.IsPlayer() && ent.IsShadowForm() )
		shieldHealth = 0

	if ( shieldHealth <= ogDmg )
		dmgToScale = ogDmg - shieldHealth

	if  ( dmgToScale <= 0 )
		return

	float dmgShielded = 0
	if ( dmgToScale < ogDmg )
		dmgShielded = ogDmg - dmgToScale

	float unshieldedDamageScale = weapon.GetWeaponSettingFloat( eWeaponVar.damage_unshielded_scale )

	if ( unshieldedDamageScale != 1.0 )
	{
		float dmgUnshielded = dmgToScale * unshieldedDamageScale

		//printt( "shielded:", dmgShielded, "/ unshielded:", dmgUnshielded )
		int finalDmg = dmgShielded.tointeger() + dmgUnshielded.tointeger()
		DamageInfo_SetDamage( damageInfo, finalDmg )
	}
}

