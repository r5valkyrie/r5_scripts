void function PingMyLastDeathbox( entity player, int commsAction, entity subjectEnt )
{
	entity deathbox = player.p.myLastDeathbox
	if ( IsValid( deathbox ) )
	{
		entity wp = CreateWaypoint_Ping_Location( player, ePingType.MARK_MY_LAST_DEATH_BOX, deathbox, deathbox.GetOrigin(), -1, true, true )
		wp.SetAbsOrigin( deathbox.GetOrigin())
		wp.SetParent( deathbox )
	}
}
                                  

void function PingMyDNA( entity player )
{
	entity dna = player.p.respawnBeacon
	if ( IsValid( dna ) )
	{
		entity wp = CreateWaypoint_Ping_Location( player, ePingType.RESPAWN_CARD, dna, dna.GetOrigin(), -1, false )
		wp.SetAbsOrigin( dna.GetOrigin() )
		wp.SetParent( dna )
	}
}

void function PingNearestRespawnBeacon( entity player, vector origin )
{
	entity station = RespawnBeacon_GetClosestValidBeacon( player, origin )
	if ( IsValid( station ) )
	{
		entity wp = CreateWaypoint_Ping_Location( player, ePingType.RESPAWN_STATION, station, station.GetOrigin(), -1, true )
		wp.SetAbsOrigin( station.GetOrigin() + <0, 0, 35> )
		wp.SetParent( station )
	}
}

void function PutPlayerInDropship( entity player, entity ship, int positionIndex, float idleTimeOverride, bool isFirstSpawn, bool isDropshipRedeploy, bool useCameraDown1PAnims = false )
{
	ship.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )

	// Track how many players are on a dropship. Used in modes that add players to a dropship during it's animation sequence
	if ( ship in file.dropshipToNumPlayersOnDropshipTable )
	{
		int currentPlayerCount = file.dropshipToNumPlayersOnDropshipTable[ ship ]
		file.dropshipToNumPlayersOnDropshipTable[ ship ] = currentPlayerCount + 1
	}
	else
	{
		file.dropshipToNumPlayersOnDropshipTable[ ship ] <- 1
	}

	dropshipAnimData animData = file.dropshipAnimDataList[positionIndex]

	//FirstPersonSequenceStruct idleAnimSequence
	//idleAnimSequence.firstPersonAnim = animData.idlePOVAnim
	//idleAnimSequence.thirdPersonAnim = animData.idleAnim
	//idleAnimSequence.viewConeFunction = ViewCone360
	//idleAnimSequence.attachment = animData.attachment
	//idleAnimSequence.hideProxy = animData.hideProxy

	FirstPersonSequenceStruct jumpAnimSequence
	jumpAnimSequence.firstPersonAnim = animData.jumpPOVAnim
	jumpAnimSequence.thirdPersonAnim = animData.jumpAnim
	jumpAnimSequence.viewConeFunction = ViewConeTight
	jumpAnimSequence.attachment = animData.attachment
	jumpAnimSequence.hideProxy = animData.hideProxy

	player.Signal( "StopPostDeathLogic" )
	AddCinematicFlag( player, CE_FLAG_INTRO )
	AddCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD )
	AddCinematicFlag( player, CE_FLAG_EMBARK ) // DoF
	if ( !isFirstSpawn )
		player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.WAITING_FOR_DROPPOD )

	entity dummyEnt = CreatePropDynamic( $"mdl/humans/class/medium/pilot_medium_bloodhound.rmdl" ) // TODO: use generic model.  Can't use player settings here since they could be a spectator
	float idleTime  = ((idleTimeOverride > 0.0) ? idleTimeOverride : dummyEnt.GetSequenceDuration( animData.idleAnim ))
	float jumpTime  = dummyEnt.GetSequenceDuration( animData.jumpAnim )
	float totalTime = idleTime + jumpTime

	ScreenFadeFromBlack( player, 0.75, 1.0 )

	if ( !isFirstSpawn )
		Remote_CallFunction_NonReplay( player, "ServerCallback_RespawnPodStarted", Time() + totalTime )
	dummyEnt.Destroy()

	// Make sure the player isn't parented to anything
	entity parentEnt = player.GetParent()
	if( IsValid ( parentEnt ) )
	{
		Warning( FUNC_NAME() + "(): Player should be parented. Parent Entity == " + parentEnt )
		player.ClearParent()
	}

	int observerMode = OBS_MODE_CHASE
	player.p.respawnPod = ship
	player.p.observerMode = observerMode
	player.StartObserverMode( observerMode )
	player.SetObserverTarget( ship )
	player.EnableVelocityShakeAlwaysOn()

	table<string, bool> e
	e[ "clearDof" ] <- true
	e[ "didHolsterAndDisableWeapons" ] <- false
	e[ "didClearVelocityShakeAlwaysOn" ] <- false

	// Allow invulnerable in all cases until after 1P animation.
	player.SetInvulnerable()

	OnThreadEnd(
		function () : ( player, e, isFirstSpawn, ship )
		{
			if ( IsValid( player ) )
			{
				if ( !IsAlive( player ) )
					thread HandleSquadEliminationWhileObservingDropship( player )

				RemoveCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD )
				RemoveCinematicFlag( player, CE_FLAG_INTRO )

				if ( e["clearDof"] )
					RemoveCinematicFlag( player, CE_FLAG_EMBARK )
				if ( e["didHolsterAndDisableWeapons"] )
					DeployAndEnableWeapons( player )
				if ( e["didClearVelocityShakeAlwaysOn"] == false )
					player.DisableVelocityShakeAlwaysOn()

				player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.NONE )
				player.SetPlayerNetTime( "respawnBannerPickedUpTime", -1 )
				player.p.respawnPod = null
				player.p.respawnPodLanded = false
				player.ClearParent()
				ClearPlayerAnimViewEntity( player )
				player.ClearInvulnerable()

				// Respawn Equipped: This version goes guns out during the fall.
				                           
					if( !isFirstSpawn && file.respawning_JumpGunsOut )
					{
						RespawnEquipped_Restore( player )
						Remote_CallFunction_Replay( player, "ServerCallback_PlayFPEvoShieldUpgradeFX", player )
					}
                                     

				                  
					if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_THE_HUNT ) )
					{
						//Remote_CallFunction_NonReplay( player, "ServerToClient_Bounty_CL_InteractText", player )
						//thread Bounty_TrackRavenSpawn( player )
						Warning("Bounty_TrackRavenSpawn missing for survival the hunt gamemode")
					}
          
			}

			if ( IsValid( ship ) )
			{
				ship.kv.solid = 0
			}
		}
	)

	//waitthread FirstPersonSequence( idleAnimSequence, player, ship )
	wait idleTime

	HolsterViewModelAndDisableWeapons( player, true )
	e[ "didHolsterAndDisableWeapons" ] <- true

	if ( isDropshipRedeploy )
	{
		player.StopObserverMode()
		MakePlayerVisible( player, true )
	}
	else
	{
		DoCommonRespawnForPlayer( player )
	}

	foreach( func in file.Callbacks_OnPlayerPutInDropship )
		func( player, ship )

	// Set Invulnerable again in case there was a DoCommonRespawnForPlayer(), which apparently Control does in a callback ( Tricky! ).
	player.SetInvulnerable()

	thread FadePlayerView( player, 0.1, e )

	player.SetOrigin( ship.GetOrigin() )
	player.SetAngles( ship.GetAngles() )

	player.DisableVelocityShakeAlwaysOn()
	e[ "didClearVelocityShakeAlwaysOn" ] <- true

	EmitSoundOnEntityOnlyToPlayer( player, player, animData.firstPersonJumpOutSound )
	ship.Signal( "PlayersDeployingFromDropship" )

	if( useCameraDown1PAnims )
	{
		array< string > jumpAnims = [ 	"Classic_MP_flyin_exit_povA_jump_CameraAngleDown",
										"Classic_MP_flyin_exit_povB_jump_CameraAngleDown",
										"Classic_MP_flyin_exit_povC_jump_CameraAngleDown",
										"Classic_MP_flyin_exit_povD_jump_CameraAngleDown" ]

		if( ( positionIndex >= 0 ) && ( positionIndex < jumpAnims.len() ) )
		{
			jumpAnimSequence.firstPersonAnim =  jumpAnims[ positionIndex ]
		}

		#if DEV
			printt( format( "%s(): Player %s 1p Anim == %s ", FUNC_NAME(), player.GetPlayerName(), jumpAnimSequence.firstPersonAnim ) )
		#endif
	}

	waitthread FirstPersonSequence( jumpAnimSequence, player, ship )

	// Moved from FallTempAirControl.
	ForceCrouchStand_1PCameraRestoreHack_Thread( player )

	// Enable inventory if disabled.
	if( IsInventoryDisabled( player ) )
	{
		EnableInventory( player )
	}

	if ( isDropshipRedeploy )
	{
		player.Signal( "PlayerRedeployingFromDropship" )
	}

	FallTempAirControl( player )

	if ( !isFirstSpawn && !isDropshipRedeploy )
	{
		PlayBattleChatterLineToSpeakerAndTeam( player, "bc_returnFromRespawn" )
		                            
			if ( IsValid( player.p.myLastDeathbox ) ) // don't show the prompt if DB contains no items
			{
				Remote_CallFunction_NonReplay( player, "ServerCallback_PromptMarkMyLastDeathbox" )
			}
        

		thread PromptRespawnThanks( player )
	}
}

void function PromptRespawnThanks( entity player )
{
	EndSignal( player, "OnDeath", "OnDestroy" )

	while ( true )
	{
		if( player.IsOnGround() )
		{
			wait RESPAWN_THANKS_DELAY

			Remote_CallFunction_NonReplay( player, "ServerCallback_PromptRespawnThanks" )
			return
		}
		WaitFrame()
	}
}

                     
                                                                                            
 
                      
                                                                     

                                           
                                                        
                                                     
                                                  
                                                  
                                                

                                      
                                   
                                           
                                             
                        
                         

                                        
                                                

                                                                                  

             
                             
   
                           
    
                             
                                                                  

                                                        
                                                

                        
                                                  
                                           
                                     
                                                      
                                          

                                                    
                                       
                              
    
   
  

                                                                 
 
                          


void function HandleSquadEliminationWhileObservingDropship( entity player )
{
	EndSignal( player, "OnDestroy" )

	wait 2 // Forced to wait a bit here or I'll get a callback on the client that closes the death screen menu. Timing related.

	entity observerTarget = player.GetObserverTarget()
	if ( !IsAlive( player ) && player.IsObserver() && IsValid( observerTarget ) && observerTarget.IsPlayer() )
		PutPlayerInObserverMode( player, OBS_MODE_IN_EYE )
}

void function FadePlayerView( entity player, float duration, table<string, bool> e )
{
	player.EndSignal( "OnDeath" )
	wait duration
	RemoveCinematicFlag( player, CE_FLAG_EMBARK )
	e[ "clearDof" ] = false
	ScreenFadeFromBlack( player, 1.0, 1.0 )
}

entity function RespawnBeacon_GetClosestValidBeacon( entity player, vector origin )
{
	ArrayRemoveInvalid( file.allStations )

	array<entity> stations               = clone file.allStations

	                            
		// Remove unusable beacons if we are in Rev Army mode. Beacons are disabled for a variety of different reasons in that mode
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
		{
			for ( int index = stations.len() - 1; index >= 0; index-- )
			{
				if ( !ShadowArmy_RespawnBeacon_CanBeaconBeUsed( stations[ index ] ) )
					stations.remove( index )
			}
		}
                                   

	// If the array is empty, there are no valid beacons
	if ( stations.len() == 0 )
		return null

	array<ArrayDistanceEntry> allResults = ArrayDistanceResults( stations, origin )
	allResults.sort( DistanceCompareClosest )

	// parameters for improved beacon validation
	bool expensiveBeaconDetection = GetCurrentPlaylistVarBool( "respawn_beacon_allow_outside_safe_zone", true )
	bool allowRisky = GetCurrentPlaylistVarBool( "respawn_beacon_allow_risky", true )
	float traversalTimeModifier = GetCurrentPlaylistVarFloat( "respawn_beacon_traversal_time_scalar", 1.15 )
	float timeForPlayerToArrive = GetCurrentPlaylistVarFloat( "respawn_beacon_respawn_time_allowance", 10 )

	// get current round data
	DeathFieldData data = SURVIVAL_GetDeathFieldData( Survival_GetPlayerRealm( player ) )


	// go thru stations from nearest to furthest
	for ( int i = 0; i < allResults.len(); i++ )
	{
		entity station = allResults[i].ent
		bool isSafeFromLevelHazard  = true
                                
                                                                                                                                                                
                                                                                                                                                                                                                                       
   
          
                                                                                                                                                  
         
                                
   
                                                                                                                                                                                                                                                                               
   
          
                                                                                                                                
         
                                
   
                                      

		// the death field appears a few seconds after Round 1 begins closing
		if ( !SURVIVAL_DeathFieldIsValid( Survival_GetPlayerRealm( player ) ) && isSafeFromLevelHazard )
		{
			// the ring hasn't yet manifested
			return station
		}

		if ( SURVIVAL_PosInSafeZone( Survival_GetPlayerRealm( player ), station.GetOrigin() ) && isSafeFromLevelHazard )
		{
			// Beacon is inside next safe zone
			return station
		}

		if( expensiveBeaconDetection )
		{
			// validate beacon is not already inside the death field
			float beaconDistanceFromDeathField = DeathField_PointDistanceFromFrontierForIndex( station.GetOrigin(), player.DeathFieldIndex() )
			if ( beaconDistanceFromDeathField > 0 )
			{
				// use a heuristic to determine if the beacon is close enough to ping

				// test cases:
				// when the first ring has begun to close
				// when the second ring is waiting to close
				// a short moment between rounds when the ring has stopped closing but the next circle hasn't appeared yet

				// get the distance from player to respawn station as the crow flies
				float distToBeacon = Distance2D( origin, station.GetOrigin() )
				// determine time to run to station
				float traversalTime = ( distToBeacon / PLAYER_STANDING_SPRINT_SPEED ) * traversalTimeModifier // add a little padding to account for actual traversal
				traversalTime += GetRespawnStationUseTime(station) + timeForPlayerToArrive // add some buffer time for the player to activate the beacon and the respawned player to fly in
				// predict moment in time that player will arrive
				float predictedArrivalTime = Time() + traversalTime

				#if DEV
					printf( "distance to beacon: %f", distToBeacon)
					printf( "Entire respawn time buffer is %f", traversalTime )
					printf( "Current time is %f", Time() )
					printf( "Predicting player will finish respawning at %f", predictedArrivalTime )
					printf( "data.startTime is %f", data.startTime )
				#endif
				// Confirmed: data.startTime is the moment in time that the ring begins to shrink

                                  
                                                                                                                                                                         
                                                                                                        
     
                                     
                                                     
                                                      
                                 
                                
                                 
                                     
                              
                               
                              
                      
                    
                     

                                                                   
      
                                                                                          
                                                                                                                                   
                                                                                                                                   

                                                                                                                                              
                                                      
                             

                                                                                                                         
                             
       
                                                                                          
                                                
                                                                                                                      
                                                                                                  

                                                         
        
                                                                                                       
                                                                                
                                                                                    
        

                                                                             
                                                                                                                                                  
                                                                                                                      
        
               
                                                                                                                                                                   
              
                                                                              
                              
        
                                                                                                                                                                                       
        
               
                                                                                                                                                                                          
              
                                                                                                                       
                                                          
                                                                                               
                                                 

                                                          
         
                                                                               
         
            
         
                                         
         
                              
        
                                                                                                                                     
        
               
                                                                                                                                                                           
              
                                                                                                                         
                                        
                              
        
                                                                                                                                                                                                                 
        
               
                                                                                                                                                              
              
                                                                                                                                   
                                                                    
                              
        
                                                               
        
               
                                                                                                   
              
        
       

                                                                                                                                
                                                                                                               
       
                                                       
        
                                          
                                         
                                          
        
           
        

                                                                                                                                                      
                                           
                                           
                                           
               
                                                                                                                                                                                        
              
        

                                                                       
                                                                                      
                                                                          

                                                       
        
               
                                                                                                                                                                                                              
              
                                    
             
        
           
        
               
                                                                                                                                                                                                                  
              
        
       

                                                                                                       
                                                                                                          
                                                                                                                                                                                          
       
                                                                                                         
                                                                                    
                                                                                    
                                                        
        
               
                                                                                                                                                                                                                  
              
                                    
             
        
           
        
               
                                                                                                                                                                                                                      
              
        
       
      
     
                                        

				// If we are still not safe from a level hazard, look for a different station
				if ( !isSafeFromLevelHazard )
				{
					#if DEV
						printf( "sh_respawn_beacon: Failing ExpensiveBeaconDetection test because this beacon is still not safe from a Level Hazard" )
					#endif
					continue
				}

				if (predictedArrivalTime < data.startTime)
				{
					#if DEV
						printf( "player should arrive before the ring shrinks", data.startTime - predictedArrivalTime )
					#endif
					return station
				}
				else if( allowRisky )
				{
					// Evaluate ring location & radius at the predicted moment of player respawn
					float progress = ( predictedArrivalTime - data.startTime ) / ( data.endTime - data.startTime )
					vector predictedCenter = LerpVector( data.center, data.nextCenter, progress )
					float predictedRadius = LerpFloat( data.startRadius, data.endRadius, progress )
					#if DEV
						printf( "ring collapse progress at ETA: %f", progress )
						printf (
							"Ring Center | started: < %f, %f, %f > | ending: < %f, %f, %f > | predicted at ETA: < %f, %f, %f >",
							data.center.x, data.center.y, data.center.z,
							data.nextCenter.x, data.nextCenter.y, data.nextCenter.z,
							predictedCenter.x, predictedCenter.y, predictedCenter.z
						)
						printf ("Ring Radius | started: %f | ending: %f | predicted at ETA: %f",  data.startRadius, data.endRadius, predictedRadius)
					#endif
					// then we get beacon's distance from currentCenter
					// and test if the distance is less than currentRadius
					float beaconDistToCircleCenter = Distance2D( station.GetOrigin(), predictedCenter )
					if (beaconDistToCircleCenter < predictedRadius)
					{
						#if DEV
							printf( "This beacon should be safe to recommend" )
						#endif
						return station
					}
					#if DEV
						printf( "Respawn Beacon was predicted to be outside the ring upon player arrival" )
					#endif
				}
			}
		}
	}
	return null
}

void function FallTempAirControl( entity player )
{
	if( !IsValid( player ) )
		return

	if ( player.IsOnGround() )
		return

	// To guard against cases where the player dies out of bounds in the respawn before and the OnPlayerTouchGround was never called
	if ( !HasPlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, OnPlayerTouchGround ) )
	{
		AddPlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, OnPlayerTouchGround )
	}

	player.kv.airSpeed = 300
	player.kv.airAcceleration = 1000

	if( Has_RespawnSkyDive() )
	{
		Respawn_Dropship_SkyDive( player )
	}
}

void function Respawn_Dropship_SkyDive( entity player )
{
	vector initVelocity = < 0, 0, -50 >
	vector dir = player.GetViewVector() * 100 + initVelocity
	thread PlayerSkyDive( player, player.GetViewVector(), [player], player, false, true, dir, true)
}

bool function Has_RespawnSkyDive()
{
	return( GetCurrentPlaylistVarBool( "respawn_dropship_skydive", false ) )
}

void function OnPlayerTouchGround( entity player )
{
	if( !IsValidPlayer( player ) )
		return

	RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, OnPlayerTouchGround )
	player.kv.airSpeed = player.GetPlayerSettingFloat( "airSpeed" )
	player.kv.airAcceleration = player.GetPlayerSettingFloat( "airAcceleration" )

	player.p.lastRespawnTouchGroundTime = Time()

	// TODO: defensive fix for players being perpetually OOB when respawning; this is a reasonable quick fix vs. a rewrite of the OOB trigger system.
	player.SetOutOfBoundsDeadTime( 0.0 )

	PIN_PlayerLandedOnGround( player )

	// Respawn Equipped: This version gives equipment upon touching the ground.
	                           
		if( !file.respawning_JumpGunsOut )
		{
			RespawnEquipped_Restore( player )
		}
                                  
}

entity function RespawnBeacon_GetBestObserverTarget( entity observer, bool reverse )
{
	if ( !IsValidPlayer( observer ) )
		return null

	if ( IsValid( observer.p.respawnPod ) )
	{
		if ( observer.GetObserverMode() != observer.p.observerMode && !IsValid( observer.GetParent() ) )
		{
			observer.StartObserverMode( observer.p.observerMode )
		}
		return observer.p.respawnPod
	}

	return null
}
#endif // SERVER

bool function AnaylsisFuncDropshipTestJumpout( FlightPath flightPath, vector origin, float yaw )
{
	vector angles  = <0, yaw, 0>
	vector forward = AnglesToForward( angles )
	vector right   = AnglesToRight( angles )

	if ( !IsLegalFlightPath( flightPath, origin, forward, right, true ) )
		return false

	if ( !CanDeploy( flightPath, origin, angles, forward, right ) )
		return false

	return true
}

bool function CanDeploy( FlightPath flightPath, vector origin, vector angles, vector forward, vector right )
{
	Point deployPoint   = GetPreviewPoint( flightPath )
	vector deployOrigin = GetOriginFromPoint( deployPoint, origin, forward, right )
	vector deployAngles = GetAnglesFromPoint( deployPoint, angles )

	// flatten it
	deployAngles.x = 0
	deployAngles.z = 0

	vector deployFwd = AnglesToForward( deployAngles )

	deployOrigin = deployOrigin - deployFwd * 150 // move backwards a bit

	TraceResults results = TraceHull( deployOrigin, deployOrigin - <0, 0, 1000>, <-300, -300, -300>, <300, 300, 300>, null, flightPath.traceMask, TRACE_COLLISION_GROUP_NONE )
	// DebugDrawSphere( deployOrigin, 20, COLOR_RED, true, 5.0 )
	// DebugDrawLine( deployOrigin, results.endPos, COLOR_RED, true, 5.0 )
	// DebugDrawSphere( deployOrigin - <0,0,1000>, 20, COLOR_RED, true, 5.0 )

	if ( results.startSolid )
		return false

	if ( results.fraction < 1 )
		return false

	return true
}

#if CLIENT
void function TryPingRespawnItem( entity player )
{
	if ( !IsSpectating() )
		return

	entity viewPlayer = GetLocalViewPlayer()

	if ( PlayerIsMarkedAsCanBeRespawned( player ) )
	{
		vector org = viewPlayer.GetOrigin()
		Remote_ServerCallFunction( "ClientCallback_PingNearestRespawn", org )
	}

	                   
		if ( !PlayerIsMarkedAsCanBeRespawned( player ) )
		{
			vector org = viewPlayer.GetOrigin()
			Remote_ServerCallFunction( "ClientCallback_PingNearestRespawn", org )
		}
       
}
#endif

#if SERVER
void function ClientCallback_PingNearestRespawn( entity player, vector org )
{
	float lastPingTime = 0.0
	if ( player in file.lastPingTimes )
		lastPingTime = file.lastPingTimes[ player ]
	else
		file.lastPingTimes[ player ] <- 0.0

	if ( Time() - lastPingTime < GetCurrentPlaylistVarFloat( "ping_nearest_beacon_wait_time", 7.0 ) )
		return

	file.lastPingTimes[ player ] = Time()

	if ( player.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.WAITING_FOR_PICKUP )
	{
		PingMyDNA( player )
	}
	else if ( player.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.WAITING_FOR_DELIVERY )
	{
		PingNearestRespawnBeacon( player, org )
	}
	                   
		else if ( player.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.PICKUP_DESTROYED && Perk_CanTeammateCraftPlayerBanner( player ) )
		{
			if ( Crafting_IsDispenserCraftingEnabled() )
			{
				Dispensers_PingNearestDispenser( player, org )
			}
			else
			{
				Crafting_PingNearestWorkbench( player, org )
			}
		}
       
}

void function ClientToServer_GladCardPlayerReset( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	player.SetPlayerNetEnt( "gladCardPlayer", null )
}

