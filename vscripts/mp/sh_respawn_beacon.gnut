void function Sh_RespawnBeacon_Init()
{
	#if SERVER
		                            
			if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
                                    
		
		AddSpawnCallbackEditorClass( "prop_dynamic", "script_survival_revival_chamber", OnRespawnChamberSpawned )
	#endif // SERVER

	PrecacheScriptString( RESPAWN_CHAMBER_SCRIPTNAME )

	PrecacheModel( RESPAWN_DROPSHIP_MODEL )

	if ( GetRespawnStyle() == eRespawnStyle.NONE )
		return

	PrecacheParticleSystem( RESPAWN_BEACON_EMITTER_FX )
	PrecacheParticleSystem( RESPAWN_BEACON_BEAM_FX )
	PrecacheParticleSystem( RESPAWN_BEACON_SCAN_FX )
	PrecacheParticleSystem( RESPAWN_BEACON_PULSATE_FX )

	#if SERVER || CLIENT
		Remote_RegisterServerFunction( "ClientCallback_PingNearestRespawn", "vector", -FLT_MAX, FLT_MAX, 32 )
		Remote_RegisterServerFunction( FUNCNAME_PingBeaconFromMap, "typed_entity", "prop_script" )

		if ( HasInterruptableBannerPickup() )
		{
			Remote_RegisterServerFunction( "ClientToServer_CancelBannerPickupAnim" )
		}
	#endif

	#if CLIENT
		RegisterSignal( "ReviveRuiThread" )
		RegisterSignal( "SpectatorShowRespawnRui" )

		                            
			if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
                                    
			{
				AddCreateCallback( "prop_dynamic", RespawnEntitySpawned )
				AddCreateCallback( "prop_script", RespawnEntitySpawned )
			}

		AddCreateCallback( PLAYER_WAYPOINT_CLASSNAME, PlayerWaypoint_CreateCallback )
		AddDestroyCallback( PLAYER_WAYPOINT_CLASSNAME, PlayerWaypoint_DestroyCallback )

		if ( HasInterruptableBannerPickup() )
		{
			RegisterConCommandTriggeredCallback( "+attack", AttemptCancelBannerPickup )
			RegisterConCommandTriggeredCallback( "+melee", AttemptCancelBannerPickup )

			RegisterConCommandTriggeredCallback( "+speed", AttemptCancelBannerPickup )
		}

		                            
			if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
                                    
			{
				RegisterMinimapPackages()
			}

		RegisterButtonPressedCallback( KEY_SPACE, TryPingRespawnItem )
		RegisterButtonPressedCallback( BUTTON_A, TryPingRespawnItem )

		if( RespawnBeacons_PingFromMap_Enabled() )
			AddCallback_OnFindFullMapAimEntity( GetRespawnBeaconUnderAim, PingRespawnBeaconUnderAim )

		if ( (GetRespawnStyle() == eRespawnStyle.RESPAWN_CHAMBERS) && RespawnBeaconsAreEnabled() && !RespawnBeacons_ShouldEnableBeaconsInNonBeaconRespawnMode() )
			SetMapFeatureItem( 1100, "#RESPAWN_BEACON", "#RESPAWN_BEACON_DESC", RESPAWN_BEACON_ICON )

	#elseif SERVER

		                            
			if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
                                    
			{
				AddSpawnCallback( "prop_dynamic", RespawnEntitySpawned )
				AddSpawnCallback( "prop_script", RespawnEntitySpawned )
			}

		AddCallback_GameStatePostEnter( eGameState.Prematch, RespawnBeacon_OnPrematch )

		AddCallback_OnClientConnected( RespawnBeacon_OnClientConnected )
		AddCallback_OnClientDisconnected( RespawnBeacon_OnClientDisconnected )
		AddCallback_OnPlayerPostRespawned( OnPlayerPostRespawned_RespawnEquipped )

		// from CLASSIC MP, because I didn't want to revive that file
		RegisterSignal( "sRampOpen" )
		RegisterSignal( "PlayersDeployingFromDropship" )
		RegisterSignal( "PlayerRedeployingFromDropship" )

		RegisterSignal( "pickingUpRespawnBanner" )

		                           
			RegisterSignal( "StopBeaconPulsate" )
			RegisterSignal( "RespawnEquippedRestoreDone" )
                                   
		
		//front left
		dropshipAnimData dataForPlayerA
		dataForPlayerA.idleAnim = "Classic_MP_flyin_exit_playerA_idle"
		dataForPlayerA.idlePOVAnim = "Classic_MP_flyin_exit_povA_idle"
		dataForPlayerA.jumpAnim = "Classic_MP_flyin_exit_playerA_jump"
		dataForPlayerA.jumpPOVAnim = "Classic_MP_flyin_exit_povA_jump"
		dataForPlayerA.viewConeFunc = ViewConeWide
		dataForPlayerA.yawAngle = -18.0
		dataForPlayerA.firstPersonJumpOutSound = "commander_sequence_soldier_a_jump"

		//back right
		dropshipAnimData dataForPlayerB
		dataForPlayerB.idleAnim = "Classic_MP_flyin_exit_playerB_idle"
		dataForPlayerB.idlePOVAnim = "Classic_MP_flyin_exit_povB_idle"
		dataForPlayerB.jumpAnim = "Classic_MP_flyin_exit_playerB_jump"
		dataForPlayerB.jumpPOVAnim = "Classic_MP_flyin_exit_povB_jump"
		dataForPlayerB.viewConeFunc = ViewConeWide
		dataForPlayerB.yawAngle = 8.0
		dataForPlayerB.firstPersonJumpOutSound = "commander_sequence_soldier_b_jump"

		//front right
		dropshipAnimData dataForPlayerC
		dataForPlayerC.idleAnim = "Classic_MP_flyin_exit_playerC_idle"
		dataForPlayerC.idlePOVAnim = "Classic_MP_flyin_exit_povC_idle"
		dataForPlayerC.jumpAnim = "Classic_MP_flyin_exit_playerC_jump"
		dataForPlayerC.jumpPOVAnim = "Classic_MP_flyin_exit_povC_jump"
		dataForPlayerC.viewConeFunc = ViewConeWide
		dataForPlayerC.yawAngle = 8.0
		dataForPlayerC.firstPersonJumpOutSound = "commander_sequence_soldier_c_jump"

		//back left
		dropshipAnimData dataForPlayerD
		dataForPlayerD.idleAnim = "Classic_MP_flyin_exit_playerD_idle"
		dataForPlayerD.idlePOVAnim = "Classic_MP_flyin_exit_povD_idle"
		dataForPlayerD.jumpAnim = "Classic_MP_flyin_exit_playerD_jump"
		dataForPlayerD.jumpPOVAnim = "Classic_MP_flyin_exit_povD_jump"
		dataForPlayerD.viewConeFunc = ViewConeWide
		dataForPlayerD.yawAngle = -16.0
		dataForPlayerD.firstPersonJumpOutSound = "commander_sequence_soldier_d_jump"

		file.dropshipAnimDataList = [ dataForPlayerA, dataForPlayerB, dataForPlayerC, dataForPlayerD ]
		// END from CLASSIC MP

		if ( GetRespawnStyle() == eRespawnStyle.RESPAWN_CHAMBERS )
		{
			AddCallback_OnDeathBoxSpawned( OnDeathBoxSpawned )
			AddCallback_OnGetBestObserverTarget( RespawnBeacon_GetBestObserverTarget )
			AddCallback_OnPlayerKilled( OnPlayerKilled )
		}

		                            
		AddCallback_OnQuickchatEvent( eCommsAction.MARK_MY_LAST_DEATHBOX,  PingMyLastDeathbox )
        
	#endif
}

void function RespawnBeacons_RegisterNetworking()
{
	RegisterNetworkedVariable( "respawnsRemaining", SNDC_PLAYER_GLOBAL, SNVT_INT, GetStartingRespawnCount() )
	RegisterNetworkedVariable( "respawnStatus", SNDC_PLAYER_GLOBAL, SNVT_INT, eRespawnStatus.NONE )
	RegisterNetworkedVariable( "respawnStatusEndTime", SNDC_PLAYER_GLOBAL, SNVT_TIME, -1 )
	RegisterNetworkedVariable( "respawnBannerPickedUpTime", SNDC_PLAYER_GLOBAL, SNVT_TIME, -1 )

	#if CLIENT
		RegisterNetVarIntChangeCallback( "respawnStatus", RespawnStatusChanged )
	#endif
}

void function ShRespawnBeacon_RegisterAinAnalysisFuncs()
{
	AddDropshipFlightAnalysis( eFlightPathAnalysisIndex.RESPAWN_DROPSHIP_FLYIN_MOVE, RESPAWN_DROPSHIP_MODEL, ANIM_FLYIN_MOVE, AnaylsisFuncDropshipTestJumpout, "dropship_deploy" )
}

#if CLIENT
void function RegisterMinimapPackages()
{
	if ( GetRespawnStyle() == eRespawnStyle.RESPAWN_CHAMBERS || RespawnBeacons_ShouldEnableBeaconsInNonBeaconRespawnMode() )
	{
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.RESPAWN_CHAMBER, MINIMAP_OBJECT_RUI, MinimapPackage_RespawnChamber, FULLMAP_OBJECT_RUI, MinimapPackage_RespawnChamber )
		RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.RESPAWN_DNA, $"ui/minimap_square_respawn_dna_pickup.rpak", MinimapPackage_RespawnDNA, $"ui/in_world_minimap_respawn_dna.rpak", MinimapPackage_RespawnDNA )
	}
}

void function RespawnStatusChanged( entity player, int new )
{
	if ( !GetCurrentPlaylistVarBool( "mrb_show_ingame_ui", true ) )
		return

	if ( player == GetLocalClientPlayer() )
		UpdateRespawnStatus( new )

	if ( new == eRespawnStatus.WAITING_FOR_DROPPOD )
		FlashGameWindow()

	entity viewPlayer = GetLocalViewPlayer()

	if ( !IsValid( viewPlayer ) )
		viewPlayer = GetLocalClientPlayer()

	if ( !IsValid( viewPlayer ) )
		return

	bool waitingToBeRespawned = HasTeammatesToRespawn( viewPlayer.GetTeam() )

	foreach ( rui in file.respawnChamberRuis )
	{
		UpdateRespawnChamberRuis( rui, waitingToBeRespawned )
	}

	foreach( rui in file.respawnChamberFullmapRuis )
	{
		RuiSetBool( rui, "hasSmallIcon", !waitingToBeRespawned )
	}

	ArrayRemoveInvalid( file.allStations )

	if ( GetRespawnStyle() != eRespawnStyle.NONE && !RespawnBeacons_ShouldEnableBeaconsInNonBeaconRespawnMode() )
	{
		int fxId = GetParticleSystemIndex( RESPAWN_BEACON_BEAM_FX )

		foreach ( ent in file.allStations )
		{
			if ( waitingToBeRespawned )
			{
				if ( !EffectDoesExist( file.chamberToBeamFX[ ent ] ) )
				{
					file.chamberToBeamFX[ ent ] = StartParticleEffectOnEntity( ent, fxId, FX_PATTACH_POINT_FOLLOW_NOROTATE, ent.LookupAttachment( "FX_EMITTER" ) )
				}
			}
			else
			{
				if ( EffectDoesExist( file.chamberToBeamFX[ ent ] ) )
				{
					EffectStop( file.chamberToBeamFX[ ent ], true, true )
				}

				file.chamberToBeamFX[ ent ] = -1
			}
		}
	}

	// can't create multiple callbacks for networked vars so I have to call the death screen script from here.
	DeathScreen_RespawnStatusChanged( player, new )
}

void function UpdateRespawnChamberRuis( var rui, bool waitingToBeRespawned )
{
	if ( waitingToBeRespawned )
	{
		RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_FAR )
		RuiSetBool( rui, "pinToEdge", true )
		RuiSetBool( rui, "showClampArrow", true )
	}
	else if ( file.mobileRespawnSpawnInProgress )
	{
		RuiSetFloat( rui, "distanceFade", MOBILE_RESPAWN_BEACON_ICON_FADE_DIST_ZERO )
		RuiSetBool( rui, "pinToEdge", false )
		RuiSetBool( rui, "showClampArrow", false )
	}
	else
	{
		RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_NEAR )
		RuiSetBool( rui, "pinToEdge", false )
		RuiSetBool( rui, "showClampArrow", false )
	}
}
#endif // CLIENT

bool function RespawnBeaconsAreEnabled()
{
	return GetCurrentPlaylistVarBool( "respawn_beacons_enabled", true )
}

int function GetStartingRespawnCount()
{
	return GetCurrentPlaylistVarInt( "respawns", 0 )
}

#if CLIENT||SERVER
bool function RespawnBeacons_PingFromMap_Enabled()
{
	return GetCurrentPlaylistVarBool( "respawnbeacons_pingfrommap_enabled", true )
}
#endif

#if CLIENT||SERVER
// This function is used to enable some beacon functionality ( like enabling the icons ) for modes that don't actually use them for respawning
bool function RespawnBeacons_ShouldEnableBeaconsInNonBeaconRespawnMode()
{
                    
                                                                           
              
       

	                            
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
			return true
                                   

	return false
}
#endif

bool function IsRespawnBeacon( entity ent )
{
	switch ( ent.GetTargetName() )
	{
		case RESPAWN_CHAMBER_TARGETNAME:
                         
                                    
      
		case MOBILE_RESPAWN_BEACON_TARGETNAME:
			return true
	}
	return false
}

bool function ShouldFastBannerPickup()
{
	return GetCurrentPlaylistVarBool( "fast_banner_pickup", true )
}

bool function HasInterruptableBannerPickup()
{
	return GetCurrentPlaylistVarBool( "cancelable_banner_pickup_enabled", true )
}

bool function ShouldRestoreKittedWeapons()
{
	bool isKittedWeaponsGameMode = false

	                            
		isKittedWeaponsGameMode = GetCurrentPlaylistVarBool( "is_gamemode_battle_rush", false )
                                  

	                            
		isKittedWeaponsGameMode = isKittedWeaponsGameMode || GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY )
       

                              
                                                                                                                          
       

	return isKittedWeaponsGameMode
}

void function RespawnEntitySpawned( entity ent )
{
	if ( !IsRespawnStationEnt( ent ) )
		return

	if ( !RespawnBeaconsAreEnabled() && ent.GetTargetName() != MOBILE_RESPAWN_BEACON_TARGETNAME )
	{
		//gets rid of the beacons without short-circuiting the script.
		//sh_respawn_beacon has a bunch of stuff we need to use elsewhere like dropship logic
		//that gets broken currently if we just change respawn_style.
		//dropship logic should get pulled into it's own black box when we get a chance

		if ( IsValid( ent ) )
			ent.Destroy()
		return
	}

	#if CLIENT
		if ( GetCurrentPlaylistVarBool( "mrb_show_ingame_ui", true ) )
		{
			AddEntityCallback_GetUseEntOverrideText( ent, RespawnChamber_TextOverride )
			var rui
			if ( ent.GetTargetName() == MOBILE_RESPAWN_BEACON_TARGETNAME )
				rui = AddOverheadIcon( ent, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_mobile_respawn_beacon.rpak" )
			else
				rui = AddOverheadIcon( ent, RESPAWN_BEACON_ICON, false, $"ui/overhead_icon_respawn_beacon.rpak" )
			RuiSetFloat2( rui, "iconSize", <80, 80, 0> )
			RuiSetFloat( rui, "distanceFade", RESPAWN_CHAMBER_ICON_FADE_DIST_NEAR )
			RuiSetBool( rui, "adsFade", true )
			RuiSetString( rui, "hint", "#RESPAWN_ALLCAPS" )

			thread ManageRespawnChamberData( ent, rui )

			if ( ent.GetTargetName() == RESPAWN_CHAMBER_TARGETNAME ) // if ( GetCurrentPlaylistVarBool( "enable_radar_on_respawn_beacons", true ) )
				thread RespawnBeacon_PlayHologramVFX( ent )
		}
		else if ( IsValid( ent ) && ent in file.chamberToBeamFX )
		{
			if ( EffectDoesExist( file.chamberToBeamFX[ ent ] ) )
				EffectStop( file.chamberToBeamFX[ ent ], true, true )
		}
	#elseif SERVER
		ent.DisableHibernation()
		ent.AllowMantle()
		ent.SetUsable()
		ent.SetUsableByGroup( "pilot" )
		ent.AddUsableValue( USABLE_BY_ALL | USABLE_CUSTOM_HINTS )
		ent.SetIgnorePredictedTriggerTypes( TT_JUMP_PAD | TT_GRAVITY_LIFT | TT_BLACKHOLE )

		ent.Minimap_SetAlignUpright( true )
		ent.Minimap_SetClampToEdge( false )
		ent.Minimap_SetCustomState( eMinimapObject_prop_script.RESPAWN_CHAMBER )
		ent.Minimap_SetZOrder( MINIMAP_Z_OBJECT )
	#endif

	AddBeaconEntToRespawnBeaconsArray( ent )

	SetCallback_CanUseEntityCallback( ent, IsNotBusy )
	SetCallback_ShouldUseBlockReloadCallback( ent, SimpleShouldNotBlockReloadCallback )

	AddCallback_OnUseEntity_ClientServer( ent, RespawnChamberOnUse )

	//#if SERVER
	//	ent.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY | ENTITY_VISIBLE_TO_OWNER
	//	ent.Hide()
	//	ent.Minimap_SetAlignUpright( true )
	//	ent.Minimap_SetClampToEdge( true )
	//	ent.Minimap_SetCustomState( eMinimapObject_prop_script.RESPAWN_DNA )
	//#endif
}

// Add valid beacons to an array of all the beacons that have spawned
// Made global so other script can add the beacons if they are spawned differently but still want to use the functions in this script
void function AddBeaconEntToRespawnBeaconsArray( entity beacon )
{
	if ( IsValid( beacon ) )
		file.allStations.append( beacon )
}

#if SERVER
void function SpawnPlayersInSkydive( array< entity > players, entity leaderPlayer, vector spawnLocation, vector spawnAngles, int matchState, vector initialVelocity = < 0, 0, 0 > )
{
	// We need to do the jumpmaster first so that everything works inside PlayerSkyDive
	if ( IsValid( leaderPlayer ) )
	{
		thread SpawnPlayerInSkydive_Thread( leaderPlayer, spawnLocation, spawnAngles, matchState, players, leaderPlayer )
	}

	foreach ( player in players )
	{
		if ( !IsValid( player ) || player == leaderPlayer )
			continue

		// Set the player to the jumpmaster if there isn't already one selected. Avoids errors due to invalid jumpmaster
		entity jumpmaster = leaderPlayer
		if ( !IsValid( leaderPlayer ) )
		{
			jumpmaster = player
		}

		thread SpawnPlayerInSkydive_Thread( player, spawnLocation, spawnAngles, matchState, players, jumpmaster, initialVelocity )
	}
}

void function SpawnPlayersInRespawnShipWithSkydive( array< entity > players, entity leaderPlayer, vector spawnLocation, vector spawnAngles, vector dropshipAngles, int matchState, vector initialVelocity = < 0, 0, 0 >  )
{
	// Put the jumpmaster at the front of the array
	for ( int i = 0; i < players.len(); i++ )
	{
		if ( players[i].GetPlayerNetBool( "isJumpmaster" ) )
		{
			entity jumpmaster = players[i]
			players[i] = players[0]
			players[0] = jumpmaster
			break
		}
	}

	if ( IsValid( leaderPlayer ) )
	{
		// We need to do the jumpmaster first so that everything works inside PlayerSkyDive
		thread SpawnPlayerInSkydive_Thread( leaderPlayer, spawnLocation, spawnAngles, matchState, players, leaderPlayer, initialVelocity, true )
	}

	foreach ( player in players )
	{
		if ( !IsValid( player ) ||  player == leaderPlayer )
			continue

		// Set the player to the jumpmaster if there isn't already one selected. Avoids errors due to invalid jumpmaster
		entity jumpmaster = leaderPlayer
		if ( !IsValid( leaderPlayer ) )
		{
			jumpmaster = player
		}

		thread SpawnPlayerInSkydive_Thread( player, spawnLocation, spawnAngles, matchState, players, jumpmaster, initialVelocity, true )
	}

	array< entity > edittedPlayers = clone players

	if ( edittedPlayers.len() > 2 )
	{
		// We need to swap the order to improve the flow of moving from the dropship to skydive. Code puts the first player on the
		// left of the jumpmaster in skydive, but script puts the first player on the right of the jumpmaster in the respawn ship,
		// and we want them to not swap sides out of nowhere
		entity tempPlayer = edittedPlayers[1]
		edittedPlayers[1] = edittedPlayers[2]
		edittedPlayers[2] = tempPlayer
	}

	thread RespawnPlayersInDropshipAtPoint( edittedPlayers, spawnLocation - < 0, 0, DROPSHIP_ANIM_HEIGHT_OFFSET >, dropshipAngles, true, true )
}

void function SpawnPlayerInSkydive_Thread( entity player, vector spawnLocation, vector spawnAngles, int playermMatchState, array< entity > teamPlayers = [], entity jumpMaster = null, vector initialVelocity = < 0, 0, 0 >, bool fromRespawnShip = false )
{
	DoCommonRespawnForPlayer( player )
	player.p.respawnPodLanded = false // this is weird but necessary
	player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.NONE )
	PlayerMatchState_Set( player, playermMatchState )

	if ( fromRespawnShip )
	{
		player.EndSignal( "OnDeath", "OnDestroy" )
		player.WaitSignal( "PlayerRedeployingFromDropship" )

		player.ClearParent()
	}
	else
	{
		player.SetAbsOrigin( spawnLocation )
		player.SetAbsAngles( spawnAngles )
	}

	// Use the quieter skydive sounds.
	thread PlayerSkyDive( player, < 0, 0, -1 >, teamPlayers, jumpMaster, true, true, initialVelocity, true, true )
}


void function DoCommonRespawnForPlayer( entity player )
{
	player.StopObserverMode()
	ClearPlayerEliminated( player )
	player.p.respawnPodLanded = true
	ResetPlayerInventory( player )

	if ( !IsAlive( player ) )
		DecideRespawnPlayer( player, false )
	else
	{
		MakePlayerVisible( player, true )
	}
}

void function MakePlayerVisible( entity player, bool isVisible )
{
	if( !IsValidPlayer( player ) )
		return

	if( isVisible )
	{
		player.UnhidePlayer()
		player.SetNameVisibleToFriendly( true )
		player.Solid()
		player.MakeVisible()
	}
	else
	{
		player.HidePlayer()
		player.SetNameVisibleToFriendly( false )
		player.NotSolid()
		player.MakeInvisible()
	}
}

array<vector> function GetRespawnBeaconLocations()
{
	if ( file.respawnBeaconLocations.len == 0 )
		Warning( "%s() -- Respawn Beacon locations not defined yet", FUNC_NAME() )

	return file.respawnBeaconLocations
}

void function AddRespawnBeaconLocation( vector location )
{
	if( file.respawnBeaconLocations.contains( location ) )
	{
		Warning( FUNC_NAME() + "(): Duplicate Respawn Location at " + location )
		return
	}

	file.respawnBeaconLocations.append( location )
}

void function OnRespawnChamberSpawned( entity ent )
{
	asset model = ent.GetModelName()

	vector origin = ent.GetOrigin()
	vector angles = ent.GetAngles()

	//useful for other modes that may not use beacons but want to know the safe locations where they would spawn
	AddRespawnBeaconLocation( origin )

	array<entity> links = ent.GetLinkEntArray()
	entity link

	if ( links.len() > 0 )
	{
		link = links[0]
	}

	entity par = ent.GetParent()
	ent.Destroy()



	if ( GetRespawnStyle() != eRespawnStyle.RESPAWN_CHAMBERS && !RespawnBeacons_ShouldEnableBeaconsInNonBeaconRespawnMode() )
		return

	// spawn a new one with the correct targetname
	entity respawnChamber = CreatePropScript_NoDispatchSpawn( model, origin, angles, 6 )
	SetTargetName( respawnChamber, RESPAWN_CHAMBER_TARGETNAME )
	                   
	respawnChamber.SetScriptName( RESPAWN_CHAMBER_SCRIPTNAME )
       
	respawnChamber.SetCanBeMeleed( false )

	DispatchSpawn( respawnChamber )
	respawnChamber.SetFadeDistance( 15000 )

	if ( IsValid( link ) )
	{
		respawnChamber.e.hasBomb = true
		respawnChamber.e.lastBouncePosition = link.GetOrigin()
		respawnChamber.e.goalAngles = link.GetAngles()
		link.Destroy()
	}

	if ( IsValid( par ) )
		ent.SetParent( par )
}

void function RespawnBeacon_OnClientConnected( entity player )
{
	                           
		RespawnEquipped_Register( player )
                                  
}

void function RespawnBeacon_OnClientDisconnected( entity player )
{
	if ( IsValid( player.p.respawnBeacon ) )
		player.p.respawnBeacon.Destroy()

	                           
		RespawnEquipped_Unregister( player )
		RemoveCallback_OnResetPlayerInventory( player )
                                  
}

                           

void function RespawnEquipped_Register( entity player )
{
	if( !( player in file.brRespawnLoadouts ) )
	{
		respawnLoadout newLoadout
		file.brRespawnLoadouts[ player ] <- newLoadout
	}

	// Last Time Enemy Damaged Player Check: Setup tracking for the Last time an enemy damaged this player
	if( !( player in file.lastCombatEncounterVsEnemy ) )
	{
		file.lastCombatEncounterVsEnemy[ player ] <- -1
	}
	if ( !player.e.entPostDamageCallbacks.contains( RespawnEquipped_OnPlayerDamaged ) )
	{
		AddEntityCallback_OnPostDamaged( player, RespawnEquipped_OnPlayerDamaged )
	}
}

void function RespawnEquipped_Unregister( entity player )
{
	if( player in file.brRespawnLoadouts )
	{
		delete file.brRespawnLoadouts[ player ]
	}

	// Last Time Enemy Damaged Player Check: Remove tracking of last time an enemy damaged this player
	if ( player.e.entDamageCallbacks.contains( RespawnEquipped_OnPlayerDamaged ) )
	{
		RemoveEntityCallback_OnPostDamaged( player, RespawnEquipped_OnPlayerDamaged )
	}
	if( player in file.lastCombatEncounterVsEnemy ) 
	{
		delete file.lastCombatEncounterVsEnemy[ player ] 
	}
}

void function RespawnEquipped_Save( entity player, bool wasDeath_Suicide = false )
{
	if( !IsValid( player ) )
		return

	if( !( player in file.brRespawnLoadouts ) )
		return

	RespawnEquipped_MarkRestored_Set( player, false )

	file.brRespawnLoadouts[ player ].restoreWeaponInfos = []

	bool checkSuicide = RespawnEquipped_SuicidesProhibited()

	// --- Save Weapons.
	_RespawnEquipped_Save_Weapons( player )

	// --- Save Shield Info
	_RespawnEquipped_Save_Armor( player, wasDeath_Suicide )


}

              
                                                                
 
                        
                                           
  
                                                
                           
           
  
                                                                                                                                                                                    
                          
  

               
 
                    

void function _RespawnEquipped_Save_Weapons( entity player )
{
	array< entity > primaryWeapons = SURVIVAL_GetPrimaryWeapons( player )
	file.brRespawnLoadouts[ player ].restoreWeaponInfos = _RestoreWeaponInfos_From_WeaponEnts( primaryWeapons )
	
               
                                           
   
                                                                  
                                                                                                            
   
                     
}

array< sRestoreWeaponInfo > function _RestoreWeaponInfos_From_WeaponEnts( array< entity > weaponEntsArray, bool debug = false )
{
	array< sRestoreWeaponInfo > results
	foreach( weaponEnt in weaponEntsArray )
	{
		if( IsValid( weaponEnt ) )
		{
			sRestoreWeaponInfo restoreWeapInfo
			restoreWeapInfo.ent = weaponEnt
			string weaponClassName
			if( ShouldRestoreKittedWeapons() )
			{
				weaponClassName = GetWeaponClassNameWithLockedSet( weaponEnt )
			}
			else
			{
				weaponClassName = weaponEnt.GetWeaponClassName()
			}
			restoreWeapInfo.weaponRef = weaponClassName
			restoreWeapInfo.modRefs = weaponEnt.GetMods()

			#if DEV
				if( debug )
				{
					printt( FUNC_NAME() + "(): Weapon Saved for entity " + weaponEnt )
					printt( format( "%s(): Weapon Class Name == %s", FUNC_NAME(), restoreWeapInfo.weaponRef ) )
					foreach ( mod in restoreWeapInfo.modRefs )
					{
						printt( format( "%s(): Weapon attachment == %s", FUNC_NAME(), mod ) )
					}
					printt( "---------------------" )
				}
			#endif
			results.append( restoreWeapInfo )
		}
	}
	return results
}

void function _RespawnEquipped_Save_Armor( entity player, bool wasDeath_Suicide = false )
{
	LootData helmet
	helmet.ref = "helmet_pickup_lv1"
	ArmorData armorData
                     
		armorData.armorLevel = UpgradeCore_ArmorTiedToUpgrades() ? "armor_core_pickup_lv1" : "armor_pickup_lv1_evolving"
      
                                                    
                           
	armorData.evoProgress = 0

	bool checkSuicide = RespawnEquipped_SuicidesProhibited()
	
	if( !checkSuicide || !wasDeath_Suicide )
	{
		armorData = ArmorData_Get( player )
		helmet = EquipmentSlot_GetEquippedLootDataForSlot( player, "helmet" )
	}

	file.brRespawnLoadouts[ player ].armorData.armorLevel 	= armorData.armorLevel
	file.brRespawnLoadouts[ player ].armorData.evoProgress 	= armorData.evoProgress
	file.brRespawnLoadouts[ player ].helmetRef 	= helmet.ref

	file.brRespawnLoadouts[ player ].wasDeath_Suicide = wasDeath_Suicide

	#if DEV
		printt( format( "%s(): Player %s armor 	== %s", FUNC_NAME(), player.GetPlayerName(), file.brRespawnLoadouts[ player ].armorData.armorLevel ) )
		printt( format( "%s(): Player %s helmet	== %s", FUNC_NAME(), player.GetPlayerName(), file.brRespawnLoadouts[ player ].helmetRef ) )
	#endif // DEV
}

