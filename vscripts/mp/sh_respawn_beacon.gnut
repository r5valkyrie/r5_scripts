// Returns the weaponInfo matching the weaponRef, and moves that weaponInfo to the back of the weaponInfos array in case there are 2 weapons of the same type.
sRestoreWeaponInfo function RespawnEquipped_RestoreWeaponInfo_Pop_ByRef( entity player, string ref )
{
	sRestoreWeaponInfo result
	array< sRestoreWeaponInfo > restoreWeaponInfos = RespawnEquipped_RestoreWeaponInfos_Get( player )

	if( restoreWeaponInfos.len() == 0 )
		return result

	foreach( weaponInfo in restoreWeaponInfos )
	{
		if( weaponInfo.weaponRef == ref )
		{
			result = weaponInfo
			restoreWeaponInfos.removebyvalue( weaponInfo )
			restoreWeaponInfos.append( weaponInfo )
		}
	}

	return result
}

