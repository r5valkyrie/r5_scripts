// ---
// These functions prevent multiple erroneous restores that may cause other issues.

void function RespawnEquipped_MarkRestored_Set( entity player, bool marked )
{
	if( !IsValidPlayer( player ) )
	{
		if( player in file.playerRecentlyRespawnEquipped )
		{
			delete file.playerRecentlyRespawnEquipped[ player ]
		}

		file.playerRecentlyRespawnEquipped[ player ] <- marked
	}
}

bool function RespawnEquipped_MarkRestored_Get( entity player )
{
	bool result = false

	if( !IsValidPlayer( player ) )
		return result

	if( !( player in file.playerRecentlyRespawnEquipped ) )
		return result

	result = file.playerRecentlyRespawnEquipped[ player ]
	return result
}

// ---

// RespawnEquipped_Restore- Restores weapons, armor as allowed by playlist vars:
//		- has_br_respawn_withweapons
//		- has_br_respawn_witharmor
void function RespawnEquipped_Restore( entity player, bool skipWeapons = false, bool skipArmor = false, bool forceArmorFX = true )
{
	if( !IsValidPlayer( player ) )
		return

	//if( RespawnEquipped_MarkRestored_Get( player ) )
	//	return

	RespawnEquipped_MarkRestored_Set( player, true )

	// If we don't restore equipment on respawn, exit the function
	if ( !Has_BR_Respawn_WithWeapons() && !Has_BR_Respawn_WithArmor() )
	{
		player.Signal( "RespawnEquippedRestoreDone" )
		return
	}

	bool dontResetInventory = RespawnEquipped_DontResetInventory()
	if( !dontResetInventory )
	{
		if( Has_BR_Respawn_WithWeapons() && !skipWeapons )
		{
			_RespawnEquipped_Restore_Weapons( player )
		}
	}

	// If Legend Upgrades are on, check the XP to grant the proper armor level instead of using the saved armor.
	if( Has_BR_Respawn_WithArmor() && !skipArmor )
	{
                      
			bool ugradeCoreEnabled = UpgradeCore_IsEnabled()
			bool armorCoreItemsEnabled = UpgradeCore_ArmorTiedToUpgrades()
			#if DEV
				printt( format( "%s(): Upgrade Cores Enabled? ", FUNC_NAME(), string( ugradeCoreEnabled ) ) )
			#endif // DEV
			if( ugradeCoreEnabled && armorCoreItemsEnabled )
			{
				_RespawnEquipped_Restore_Armor_UsingUpgradeCore( player, forceArmorFX )
			}
			else
			{
				_RespawnEquipped_Restore_Armor( player, forceArmorFX )
			}
       
                                                         
                            
	}

	// Enable inventory if disabled.
	if( IsInventoryDisabled( player ) )
	{
		EnableInventory( player )
	}

	if( Has_Respawn_ChargeTac() )
	{
		entity tacAbility = player.GetOffhandWeapon( OFFHAND_TACTICAL )
		if( IsValid( tacAbility ) )
		{
			tacAbility.SetWeaponPrimaryClipCount( tacAbility.GetWeaponPrimaryClipCountMax() )
		}
	}

	// Remove Mythics.
	RespawnLoadout_RemoveMythics( player )

	// If suicide, remove weapons.
	RespawnLoadout_RemoveWeaponsIfSuicide( player )

	// Make sure the player has the minimal stuff.
	RespawnEquipped_Ensure_Min_Loadout( player )

	player.Signal( "RespawnEquippedRestoreDone" )
}

void function _RespawnEquipped_Restore_Weapons( entity player )
{
	_RespawnEquipped_Restore_Weapons_Primary( player )

               
                                           
   
                                                    
   
                     
}

void function _RespawnEquipped_Restore_Weapons_Primary( entity player )
{
	Remove_Weapons( player )

	array< LootData > weaponDatas
	int weaponDataIndex = 0

	//int numSlots = 2
	int numSlots = file.brRespawnLoadouts[ player ].restoreWeaponInfos.len()
	for( int i = 0; i < numSlots; i++ )
	{
		sRestoreWeaponInfo weaponInfo = file.brRespawnLoadouts[ player ].restoreWeaponInfos[ i ]
		string weaponRef = weaponInfo.weaponRef
		if( weaponRef != "" )
		{
			// Don't restore crate weapons.
			LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( weaponRef )
			if( weaponData.tier == eLootTier.MYTHIC )
				continue

			// Restore the weapon. Had to write a few extra lines to allow restoration of kitted weapons.
			entity newActiveWeapon = SpawnGenericLoot( weaponRef, player.GetOrigin(), player.GetAngles(), -1 )
			array<string> lootTags = weaponData.lootTags
			array< string > attachments = []
			bool shouldRestoreAttachments = Should_Restore_Attachments( player )

			// TODO: We could move this to the save function.
			if( shouldRestoreAttachments )
			{
				// Add only mods that are attachments.
				foreach( mod in weaponInfo.modRefs )
				{
					if( !SURVIVAL_Loot_IsRefValid( mod ) )
						continue

					LootData data = SURVIVAL_Loot_GetLootDataByRef( mod )
					if ( data.lootType == eLootType.ATTACHMENT )
					{
						attachments.append( mod )
					}
				}
			}

			SURVIVAL_GiveMainWeapon( player, newActiveWeapon, lootTags, null, false, null, false, false, attachments, true )
			newActiveWeapon.Destroy()
			weaponDatas.append( weaponData )

			string weaponIndexNetIntName = "playerPrimaryWeapon" + string( weaponDataIndex++ )
			player.SetPlayerNetInt( weaponIndexNetIntName, weaponData.index )
		}
	}
}

              
                                                                      
 
                               
                                      
  
                                           
  

                                                                                                        

                                       
  
                              
           

                                                                                                        
                                                                                                
                        
  
 
                    

