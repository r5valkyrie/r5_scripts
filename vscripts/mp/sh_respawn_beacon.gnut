void function ClientToServer_CancelBannerPickupAnim( entity player )
{
	if ( !IsValid( player ) )
		return

	if ( !player.IsPlayer() )
		return

	if ( IsPlayingBannerPickupAnim( player ) )
	{
		StopPlayingAnimation( player )
	}
}

void function OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	// Things are a bit twisted up right now. So to clarify:
	// : Respawn style for the mode is set to eRespawnStyle.RESPAWN_CHAMBERS. Some pretzel logic currently requires this.
	// : But we've actually removed all respawn chambers.
	// : So we need to note that this player is eliminated, if their whole squad hasn't been already.

	//// Uncomment to debug.
	//#if DEV
	//	printt( "Enemy Damage Window: OnPlayerKilled: " + victim.GetPlayerName() )
	//#endif

	PlayersWhoveDiedBefore_Add( victim )

	// TODO: If NoBanners, Change player's status to "Delivery to Beacon"
	#if DEV
		DEV_Player_RespawnStatus( victim )
	#endif // DEV


	                           
		// If player's death was not enemy-caused, then they don't get their gear restored.
		bool wasDeath_Suicide = false
		if( RespawnEquipped_SuicidesProhibited())
		{
			wasDeath_Suicide = LastDeathSuicideStatus_Analyze( victim, attacker, damageInfo )
		}

		RespawnEquipped_Save( victim, wasDeath_Suicide )
                                  

	if ( RespawnBeaconsAreEnabled() && ( SURVIVAL_Loot_IsRefDisabled( "mp_ability_mobile_respawn_beacon" ) || SURVIVAL_Loot_IsRefValid( "mp_ability_mobile_respawn_beacon" ) ) )
		return
	if ( victim.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.SQUAD_ELIMINATED )
		return

	if ( IsPVEMode() && (MissionCheckpoints_GetRespawnsLeftForPlayer( victim ) > 0) )
		return

	victim.SetPlayerNetInt( "respawnStatus", eRespawnStatus.PLAYER_ELIMINATED )
}

void function PlayersWhoveDiedBefore_Add( entity player )
{
	if( !file.playersWhoveDiedBefore.contains( player ) )
	{
		file.playersWhoveDiedBefore.append( player )
	}
}

void function PlayersWhoveDiedBefore_Remove( entity player )
{
	if( file.playersWhoveDiedBefore.contains( player ) )
	{
		file.playersWhoveDiedBefore.fastremovebyvalue( player )
	}
}

bool function PlayersWhoveDiedBefore_Check( entity player )
{
	return( file.playersWhoveDiedBefore.contains( player ) )
}

// ---

void function DeathBoxThink_RespawnBeacon( entity box, entity dna )
// todo(dh) rename?
{
	box.EndSignal( "OnDestroy" )
	dna.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( box, dna )
		{
			if ( !IsValid( dna ) )
			{
				if ( IsValid( box ) )
				{
					SetTeam( box, TEAM_UNASSIGNED )
					UpdateDeathBoxHighlight( box )
				}
			}
		}
	)

	box.e.utilityEnt = dna
	AddCallback_OnUseEntity_ClientServer( box, DeathBoxOnUse )

	WaitForever()
}

void function DeathBoxOnUse( entity box, entity playerUser, int useFlags )
{
	entity dna = box.e.utilityEnt
	if ( !IsValid( dna ) )
		return

	if ( !ShouldPickupDNAFromDeathBox( box, playerUser ) )
		return

	entity owner = box.GetOwner()
	Assert( IsValid( owner ) )

	if ( GetCurrentPlaylistVarBool( "respawn_beacon_fp_gladiator_card", true ) )
	{
		playerUser.SetPlayerNetEnt( "gladCardPlayer", owner )
		if ( !playerUser.ContextAction_IsInVehicle() )
			thread HandleRespawnBannerPickup_Thread( playerUser )
	}

	owner.SetPlayerNetInt( "respawnStatus", eRespawnStatus.WAITING_FOR_DELIVERY )
	owner.SetPlayerNetTime( "respawnStatusEndTime", 0 )
	owner.SetPlayerNetTime( "respawnBannerPickedUpTime", Time() )
	Remote_CallFunction_Replay( playerUser, "ServerCallback_RespawnDNAHint" )
	SetTeam( box, TEAM_UNASSIGNED )

	PingNearestRespawnBeacon( owner, playerUser.GetOrigin() )

	                    
		UpgradeCore_OnBannerPickup( playerUser, owner )
       

	PlayBattleChatterLineToSpeakerAndTeam( playerUser, "bc_gotFriendlyBanner" )

	PIN_PlayerBannerPickup( playerUser, dna )

	if( IsValid(dna) )
		dna.Destroy()

	// OBSERVER LIVE LOGS
	LiveAPI_SendTwoPlayerEvent( eLiveAPI_EventTypes.bannerCollected, playerUser, owner )
}

void function HandleRespawnBannerPickup_Thread( entity playerUser )
{
	if ( !ShouldFastBannerPickup() )
	{
		PlayFirstPersonAnimation( playerUser, PICKING_UP_RESPAWN_BANNER_ANIM )
	}
	else
	{
		EndSignal( playerUser, "OnDeath" )
		Signal( playerUser, "pickingUpRespawnBanner" )
		EndSignal( playerUser, "pickingUpRespawnBanner" )

		OnThreadEnd(
			function() : ( playerUser )
			{
				if ( IsValid( playerUser ) )
				{
					if( IsPlayingFirstPersonAnimation( playerUser ) )
						StopPlayingAnimation( playerUser )
				}
			}
		)

		PlayFirstPersonAnimation( playerUser, PICKING_UP_RESPAWN_BANNER_ANIM )

		WaittillAnimDone( playerUser )
	}
}

