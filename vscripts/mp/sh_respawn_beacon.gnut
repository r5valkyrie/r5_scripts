void function RespawnBeacons_OnSquadEliminated( int team )
{
	#if DEV
		printt( FUNC_NAME() + "(): ----- " )
	#endif // DEV

	array<entity> squadMembers = GetPlayerArrayOfTeam( team )

	foreach ( player in squadMembers )
