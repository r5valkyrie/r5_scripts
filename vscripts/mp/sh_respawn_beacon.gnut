void function RespawnPlayersInDropship( array<entity> players, entity beacon )
{
	Point p

	if ( beacon.e.hasBomb )
	{
		p.origin = beacon.e.lastBouncePosition
		p.angles = beacon.e.goalAngles
	}
	else if ( beacon.GetLinkEntArray().len() == 0 )
	{
		p = GetClosestRespawnDropoff( beacon.GetOrigin() )
	}
	else
	{
		entity link = beacon.GetLinkEntArray()[0]
		p.origin = link.GetOrigin()
		p.angles = link.GetAngles()
	}

	// Test to see if there may be an overlap with origins of another dropship
	// Note: these origins are not accurate. They aren't where the character will
	// respawn from.  That position occqrurs at the end of the entry animation which
	// we don't have until after the animation.  This gives a rough approximation.
	const float RadiusTestSqr = 900*900
	const float MoveUpOffset = 700 // Even at this height there is still a chance for some of the lower plane to clip into the higher plane when the lower one takes off, but it doesn't seem too common. This scenario is already very rare.

	foreach( key, value in file.activeDropshipOrigins ) //offsetting the Z position of the dropship iteratively as long as there are multiple dropships active at once.
	{
		if ( IsValid( key ) )
		{
			if ( Distance2DSqr( value, p.origin ) < RadiusTestSqr )
			{
				if(file.dropshipVerticalOffsetCount > file.activeDropshipOrigins.len())  //reseting offset if the active dropships have reset because time has passed and the offset is not longer accurate
				{
					file.dropshipVerticalOffsetCount = 0
				}
				else
				{
					++file.dropshipVerticalOffsetCount
				}
				break;
			}
		}
	}

	float heightmod = RespawnDropship_GetHeightMod()
	p.origin = < p.origin.x, p.origin.y, p.origin.z + file.dropshipVerticalOffsetCount*MoveUpOffset + heightmod >

	bool isDropshipRedeploy = !IsEliminationBased()

	                            
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
			isDropshipRedeploy = false
                                   

	thread RespawnPlayersInDropshipAtPoint( players, p.origin, AnglesCompose( p.angles, <0, 0, 0> ), false, isDropshipRedeploy )
}

float function RespawnDropship_GetHeightMod()
{
	float heightmod = GetCurrentPlaylistVarFloat( "respawn_dropship_heightmod", 0.0 )

	#if DEV
		heightmod += file.debug_additional_dropship_heightmod
	#endif // DEV

	return( heightmod )
}

void function RespawnPlayersInDropshipAtPoint( array<entity> players, vector origin, vector angles, bool isFirstSpawn, bool isDropshipRedeploy = false, string dropshipAISettings = "npc_dropship_respawn", DropshipAltFlyinData ornull altDataRaw = null )
{
	if( players.len() < 1 )
		return

	float idleTimeOverride = 0.0
	bool useAlt            = false
	vector startOrigin
	vector startAngles

	if ( altDataRaw != null )
	{
		DropshipAltFlyinData data = expect DropshipAltFlyinData( altDataRaw )
		origin = data.startPos
		angles = VectorToAngles( data.endPos - data.startPos )
		startOrigin = origin
		startAngles = angles
		useAlt = true

		idleTimeOverride = data.timeToTake
		dropshipAISettings = data.dropshipAISettings
	}

	entity dropship = CreateEntity( "npc_dropship" )
	file.activeDropshipOrigins[dropship] <- origin

	OnThreadEnd(
		function() : ( dropship )
		{
			if ( dropship in file.activeDropshipOrigins )
			{
				delete file.activeDropshipOrigins[dropship]
			}
		})

	if ( IsPVEMode() )
		SetTeam( dropship, eNpcTeam.FRIENDLY )
	else if ( IsValid( players[0] ) )
		SetTeam( dropship, players[0].GetTeam() )

	SetSpawnOption_AISettings( dropship, dropshipAISettings )
	SetTargetName( dropship, RESPAWN_DROPSHIP_TARGETNAME )
	dropship.SetScriptName( RESPAWN_DROPSHIP_TARGETNAME )
	DispatchSpawn( dropship )
	dropship.SetInvulnerable()
	dropship.DisableHibernation()
	dropship.DisableGrappleAttachment()
	dropship.SetOrigin( origin )
	dropship.SetAngles( angles )
	//dropship.SetNetworkDistanceCullEnabled( false )
	Warning("SetNetworkDistanceCullEnabled is missing!")

	dropship.EnableIdLights()

	// reskining happening in sh_prop_override.nut
	//if ( dropship.GetSkinIndexByName( "lights_on" ) != -1 )
	//	dropship.SetSkin( dropship.GetSkinIndexByName( "lights_on" ) )

	if ( !useAlt )
		EmitSoundOnEntity( dropship, "goblin_imc_evac_hover" )
	thread JetwashFX( dropship )

	if ( useAlt )
		(expect DropshipAltFlyinData( altDataRaw )).dropship = dropship

	foreach ( int index, entity player in players )
	{
		if ( IsValid( player ) )
		{
			int positionIndex = index
                    
                                                            
                                                                
     
                      
                       
         
                       
     
         

			bool useCameraDownAnims = false
			                           
				// Spawn respawning player at this point so if respawn caller dies, the game is not over.
				if( Has_BR_Respawn_WithArmor() || Has_BR_Respawn_WithWeapons() )
				{
					DoCommonRespawnForPlayer(player)
					DisableInventory( player )

					// [ R5DEV-505718 ] Hide Player until PutPlayerInDropship, where they get the unhide.
					MakePlayerVisible( player, false )

					// [ R5DEV-514718 ] Put the player at the spawn loc so no erroneous "Outside of Ring" messages show.
					player.SetAbsOrigin( origin )

					useCameraDownAnims = true
				}
         
			thread PutPlayerInDropship( player, dropship, positionIndex, idleTimeOverride, isFirstSpawn, isDropshipRedeploy, useCameraDownAnims )
		}
	}

	EndSignal( dropship, "OnDestroy" )

	if ( !useAlt )
		thread PlayAnim( dropship, ANIM_FLYIN_IDLE, origin, angles )

	dropship.MakeInvisible()

	entity altMoveNode
	if ( useAlt )
	{
		altMoveNode = CreateScriptMover( RESPAWN_BEACON_ALTMOVENODE_MOVER_SCRIPTNAME, dropship.GetOrigin(), dropship.GetAngles() )
		dropship.SetParent( altMoveNode, "REF" )
	}
	else
	{
		Attachment attachResult = dropship.Anim_GetAttachmentAtTime( ANIM_FLYIN_MOVE, "ORIGIN", 0.0 )
		startOrigin = attachResult.position
		startAngles = attachResult.angle
	}
	waitthread __WarpInEffectShared( startOrigin, startAngles, "dropship_warpin", dropship, 0.0 )

	dropship.MakeVisible()

	foreach ( callbackFunc in file.Callbacks_OnRespawnDropshipCreated )
		callbackFunc( dropship )

	thread DropshipAttractLeviathan( dropship ) //should use Survival_AddCallback_OnRespawnDropshipCreated

	if ( useAlt )
	{
		thread PlayAnim( dropship, "dropship_closed_idle_alt", altMoveNode )

		DropshipAltFlyinData data = expect DropshipAltFlyinData( altDataRaw )
		data.dropship = dropship
		altMoveNode.NonPhysicsMoveTo( data.endPos, data.timeToTake, 0.0, (data.timeToTake * 0.25) )
		wait (data.timeToTake - 4.0)
		altMoveNode.NonPhysicsRotateTo( FlattenAngles( dropship.GetAngles() ), (4.0 + 3.0), 3.5, 3.5 )
		wait 3.0
		thread PlayAnim( dropship, "s2s_rampdown_idle", altMoveNode )
		wait 5.0
		altMoveNode.NonPhysicsMoveTo( (altMoveNode.GetOrigin() + <0, 0, 100.0>), 5.0, 0.0, 5.0 )
		altMoveNode.NonPhysicsRotateTo( VectorToAngles( data.startPos - altMoveNode.GetOrigin() ), 5.0, 2.5, 2.5 )
		wait 5.0
		float departureTime = (data.timeToTake * 0.7)
		altMoveNode.NonPhysicsMoveTo( data.startPos, departureTime, 1.0, 0.0 )
		wait departureTime
	}
	else
	{
		waitthread PlayAnim( dropship, ANIM_FLYIN_MOVE, origin, angles )
	}

	dropship.Destroy()
}

int function RespawnBeacon_GetNumRemainingPositionsOnDropship( entity dropship )
{
	int currentPlayerCount = 0
	if ( dropship in file.dropshipToNumPlayersOnDropshipTable )
	{
		currentPlayerCount = file.dropshipToNumPlayersOnDropshipTable[ dropship ]
	}

	return RESPAWN_BEACON_MAX_NUM_POSITIONS_ON_DROPSHIP - currentPlayerCount
}

vector function GetActiveDropshipOrigin( entity dropship )
{
	if ( dropship in file.activeDropshipOrigins )
		return file.activeDropshipOrigins[ dropship ]

	return <0,0,0>
}

array< vector > function GetAllActiveDropshipOrigins()
{
	array< vector > origins
	foreach ( ent, origin in file.activeDropshipOrigins )
	{
		origins.append( origin )
	}
	return origins
}

void function DropshipAttractLeviathan( entity dropship )
{
	dropship.EndSignal( "OnDestroy" )

	Leviathan_ConsiderLookAtEnt( dropship, RandomFloatRange( 5, 25 ), 0.7 )
	wait 5.0 // wait for the dropship to move, potentially into the leviathan's field of view
	Leviathan_ConsiderLookAtEnt( dropship, RandomFloatRange( 5, 25 ), 0.7 )
}

void function DelayedDestroyDNA( entity ent, entity deathbox, float lifetime )
{
	ent.EndSignal( "OnDestroy" )

	entity player = ent.GetOwner()
	                   
	thread DestroyDNAOnRemoteBannerPickup( ent, player )
       
	wait lifetime

	if ( IsValid( player ) )
	{
		player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.PICKUP_DESTROYED )
		foreach ( callbackFunc in file.callbacks_OnDNAPickupDestroyed )
		{
			callbackFunc( player )
		}

		                   
		// check if the player has a teammate that can recover expired banners
		// if they do set the banner as expired. if they don't destroy the banner as usual
		if( Perk_ExpiredBannerRecovery_Enabled() )
		{
			int team = player.GetTeam()

			array<entity> teammates = GetPlayerArrayOfTeam( team )
			foreach ( entity teammate in teammates )
			{
				if ( Perks_DoesPlayerHavePerk( teammate, ePerkIndex.BANNER_CRAFTING ) )
				{
					deathbox.SetNetBool( DEATH_BOX_BANNER_EXPIRED_NETVAR, true )
					return
				}
			}
		}
        
	}

	ent.Destroy()
}

                   
void function DestroyDNAOnRemoteBannerPickup( entity ent, entity player )
{
	EndSignal( ent, "OnDestroy" )
	EndSignal( player, "RecoveredExpiredDNA" ) //If we recover the Banner remotely, via crafting etc. destroy the DNA WP

	OnThreadEnd(
		function() : ( ent )
		{
			if ( IsValid( ent ) )
				ent.Destroy()
		}
	)

	WaitForever()
}
      

void function AddCallback_OnDNAPickupDestroyed( void functionref(entity) callbackFunc )
{
	Assert( !file.callbacks_OnDNAPickupDestroyed.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with AddCallback_OnDNAPickupDestroyed" )
	file.callbacks_OnDNAPickupDestroyed.append( callbackFunc )
}

