void function RespawnEquipped_Ensure_Min_Loadout( entity player )
{
	if( !IsValidPlayer( player ) )
		return

	if( RespawnEquipped_PLV_EnsureMin_Weapon() )
	{
		Ensure_Min_Weapon( player )
