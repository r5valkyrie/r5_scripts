bool function RespawnUserTeam_Common( entity ent, entity playerUser )
{
                                 
                                                        
                                         
       

                    
                                                                           
                           
       

	if ( !HasTeammatesToRespawn( playerUser.GetTeam() ) )
		return false

	thread RespawnTeamPlayers( ent, playerUser.GetTeam(), playerUser, RespawnPlayersInDropship )

	return true
}

void function RespawnUserTeam( entity ent, entity playerUser, ExtendedUseSettings settings )
{
	if ( !RespawnUserTeam_Common( ent, playerUser ) )
		return

	PIN_Interact( playerUser, "respawn_beacon", ent.GetOrigin() )

	int fxId = GetParticleSystemIndex( RESPAWN_BEACON_SCAN_FX )

	asset model        = ent.GetModelName()
	vector origin      = ent.GetOrigin()
	vector angles      = ent.GetAngles()

	entity newEnt = CreatePropDynamicLightweight( model, origin, angles, 6 )
	StartParticleEffectOnEntity( newEnt, fxId, FX_PATTACH_POINT_FOLLOW_NOROTATE, newEnt.LookupAttachment( "FX_EMITTER" ) )
	//newEnt.Anim_Play( "mh_active_2_inactive" )
	//newEnt.Dissolve( ENTITY_DISSOLVE_CORE )

	array<entity> childrenOfOldEntity		= ent.GetChildren()

	foreach (entity child in childrenOfOldEntity)
	{
		if ( IsValid ( child ) )
			child.SetParent ( newEnt )
	}

	ent.Destroy()
}

void function RespawnTeamPlayers( entity ent, int team, entity respawnCaller, void functionref( array<entity> players, entity beacon ) RespawnPlayerFromBeaconFunc )
{
	array<entity> playersToSpawn = GetPlayersToRespawn( team )
	foreach ( p in playersToSpawn )
	{
		Survival_PlayerRespawnedTeammate( respawnCaller, p )
	}

	foreach ( func in file.Callbacks_OnTeammatesRespawned )
	{
		func( respawnCaller, ent, playersToSpawn )
	}

	DeadPeriodChecker_PlayerDeadPeriodEnd( respawnCaller, eDeadPeriodEndReason.RESPAWNED_TEAMMATES )

	thread RespawnPlayerFromBeaconFunc( playersToSpawn, ent )
}

void function RespawnBeacon_StartUse_Pulsate( entity ent, entity player, ExtendedUseSettings settings )
{
	//// Uncomment to debug:
	//#if DEV
	//	printt( FUNC_NAME() + "()" )
	//#endif // DEV

	thread RespawnBeacon_Interact_Pulsate_Thread( ent, player, settings.duration )

	RespawnBeaconStartUse_Common( ent, player, settings )
}

void function RespawnBeacon_StopUse_Pulsate( entity ent, entity player, ExtendedUseSettings settings )
{
	float useTime = Time() - settings.serverStartTime

	//// Uncomment to debug:
	//#if DEV
	//	printt( "*****" + FUNC_NAME() + "()" )
	//	printt( "     " + FUNC_NAME() + "(): Current Time ==  " + Time() )
	//	printt( "     " + FUNC_NAME() + "(): settings.serverStartTime ==  " + settings.serverStartTime )
	//	printt( "     " + FUNC_NAME() + "(): settings.duration ==  " + settings.duration )
	//	printt( "     " + FUNC_NAME() + "(): Use Time ==  " + useTime )
	//#endif // DEV

	ent.Signal( "StopBeaconPulsate" )

	if( useTime < settings.duration )
	{
		StopSoundAtPosition( ent.GetOrigin(), RESPAWN_INTERACT_PULSATE_SOUND )
	}

	RespawnBeaconStopUse_Common( ent, player )
}

void function RespawnBeacon_Interact_Pulsate_Thread( entity ent, entity player, float duration )
{
	ent.Signal( "StopBeaconPulsate" )
	ent.EndSignal( "OnDestroy", "StopBeaconPulsate" )

	int fxId = GetParticleSystemIndex( RESPAWN_BEACON_PULSATE_FX )

	PassByReferenceEntity fx

	OnThreadEnd( function () : ( ent, fx )
	{
		//STOP FX.
		if( IsValid( fx.value ) )
		{
			EffectStop( fx.value )
		}
	}
	)

	EmitSoundAtPosition( TEAM_ANY, ent.GetOrigin(), RESPAWN_INTERACT_PULSATE_SOUND, ent )

	const float PULSATEDURATION = 0.5
	while( true )
	{
		//Prevents a warning when the entity is destroyed and its model briefly becomes null
		if ( !IsValid( ent ) )
			break

		fx.value = StartParticleEffectOnEntity_ReturnEntity( ent, fxId, FX_PATTACH_POINT_FOLLOW_NOROTATE, ent.LookupAttachment( "FX_EMITTER" ) )
		wait( PULSATEDURATION )
		if( IsValid( fx.value ) )
		{
			EffectStop( fx.value )
		}
	}
}

#endif // SERVER

/*
----- UTILITY -----
*/

array< entity > function GetPlayersToRespawn( int team )
{
	array<entity> playersToSpawn
	foreach ( p in GetPlayerArrayOfTeam( team ) )
	{
		if ( !IsAlive( p ) && p.GetPlayerNetInt( "respawnStatus" ) == eRespawnStatus.WAITING_FOR_DELIVERY )
		{
			playersToSpawn.append( p )
		}
	}

	return playersToSpawn
}

int function CountTeammatesWaitingToBeRespawned( int team )
{
	array< entity > playersToRespawn = GetPlayersToRespawn( team )
	return playersToRespawn.len()
}

bool function HasTeammatesToRespawn( int team )
{
	return CountTeammatesWaitingToBeRespawned( team ) > 0
}


