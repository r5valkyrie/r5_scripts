		Ensure_Min_Consumables( player )
	}
}

                    
void function _RespawnEquipped_Restore_Armor_UsingUpgradeCore( entity player, bool forceArmorFX )
{
	if ( !IsValidPlayer( player ) )
		return

	string ref = UpgradeCore_GetPlayerShieldCoreRef( player )
	Inventory_SetPlayerEquipment( player, ref, "armor" )
	if( forceArmorFX )
	{
		Remote_CallFunction_Replay( player, "ServerCallback_PlayFPEvoShieldUpgradeFX", player )
	}
	player.SetShieldHealth( player.GetShieldHealthMax())

	// --- Restore Helm & Incapshields
	_RespawnEquipped_Restore_Gear( player )
}
                          

void function _RespawnEquipped_Restore_Armor( entity player, bool forceArmorFX = true )
{
	// --- Restore Shields
	bool resetEvo = file.brRespawnLoadouts[ player ].wasDeath_Suicide
	ArmorData_Set( player, file.brRespawnLoadouts[ player ].armorData, resetEvo )

	if( forceArmorFX )
	{
		Remote_CallFunction_Replay( player, "ServerCallback_PlayFPEvoShieldUpgradeFX", player )
	}

	// --- Restore Helm & Incapshields
	_RespawnEquipped_Restore_Gear( player )
}

void function _RespawnEquipped_Restore_Gear( entity player, bool skipHelm = false, bool skipIncap = false, bool skipConsumables = true )
{
	// --- Restore Helmet
	if( !skipHelm )
	{
		string helmetRef = file.brRespawnLoadouts[ player ].helmetRef
		if( helmetRef == "" )
		{
			helmetRef = "helmet_pickup_lv1"
		}

		SURVIVAL_GivePlayerEquipment( player, helmetRef, 0, null, "", false )
	}
	
	// --- Give White Incap Shield
	if( !skipIncap )
	{
		array<string> defaultEquipment = ParseEquipmentLoadoutText( GetBREquipmentLoadoutString(), false, [] )
		foreach ( equipmentString in defaultEquipment )
		{
			if ( SURVIVAL_Loot_IsRefValid( equipmentString ) )
			{
				LootData data  = SURVIVAL_Loot_GetLootDataByRef( equipmentString )

				// We restored armor and helmet, only give what we don't restore
				if ( data.lootType != eLootType.HELMET && data.lootType != eLootType.ARMOR )
					SURVIVAL_GivePlayerEquipment( player, equipmentString, 0, null, "", false )
			}
		}
	}

	// If in Turbo BR/Battle Rush/Straight Shot, restore the default backpack as dictated by CharacterLoadouts_GetDefaultEquipmentLoadoutArray().
	                            
		if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_BATTLE_RUSH ) )
		{
			array< string > defaultLoadout = CharacterLoadouts_GetDefaultEquipmentLoadoutArray()
			foreach( defaultGear in defaultLoadout )
			{
				if( defaultGear.find( "backpack" ) >= 0 )
				{
					SURVIVAL_GivePlayerEquipment( player, defaultGear )
					break
				}
			}
		}
                                   

	// --- Ensure the player has at least the default consumables.
	if( !skipConsumables && !RespawnEquipped_DontResetInventory() )
	{
		string consumablesRef = GetBRConsumableLoadoutString()
		array<string> defaultConsumables = ParseConsumableLoadoutText( consumablesRef, false )
		CharacterLoadouts_GiveConsumableLoadoutToPlayer( player, defaultConsumables )
	}
}

void function RespawnLoadout_RemoveWeaponsIfSuicide( entity player )
{
	if( !Has_BR_Respawn_Restore_NoSuicide())
		return

	if( !LastDeathSuicideStatus_Get( player ) )
		return

	Remove_Weapons( player )
}

void function RespawnLoadout_RemoveMythics( entity player )
{
	entity weaponSlot0 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
	entity weaponSlot1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
	LootData primaryWeaponData        = SURVIVAL_GetLootDataFromWeapon( weaponSlot0 )
	LootData secondaryWeaponData      = SURVIVAL_GetLootDataFromWeapon( weaponSlot1 )
	string activePrimaryWeaponRef     = primaryWeaponData.ref
	string activeSecondaryWeaponRef   = secondaryWeaponData.ref
	bool isActivePrimaryCrateWeapon   = (primaryWeaponData.tier == eLootTier.MYTHIC)
	bool isActiveSecondaryCrateWeapon = (secondaryWeaponData.tier == eLootTier.MYTHIC)

	if ( isActivePrimaryCrateWeapon )
		player.TakeWeaponNow( activePrimaryWeaponRef )

	if ( isActiveSecondaryCrateWeapon )
		player.TakeWeaponNow( activeSecondaryWeaponRef )
}

                                 

