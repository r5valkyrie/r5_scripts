void function OnDeathBoxSpawned( entity deathbox, entity attacker, int damageSourceID )
{
	deathbox.SetIgnorePredictedTriggerTypes( TT_JUMP_PAD )

	entity player = deathbox.GetOwner()

	if ( !IsValid( player ) )
		return

	if ( Survival_IsPlayerSquadEliminated( player ) )
		return

	//switch ( damageSourceID )
	//{
	//	case eDamageSourceId.fall:
	//	case eDamageSourceId.splat:
	//	case eDamageSourceId.invalid:
	//		return
	//}

                              
                                                                                                                                                               
        
      

	entity respawnBeacon = CreateWaypoint_RespawnBanner( player, deathbox )
	player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.WAITING_FOR_PICKUP )
	player.SetPlayerNetTime( "respawnStatusEndTime", Time() + RESPAWN_DNA_LIFETIME )
	player.SetPlayerNetTime( "hackStartTime", Time() )

	Remote_CallFunction_NonReplay( player, "ServerCallback_DisplayWaitingForRespawn", respawnBeacon, Time(), player.GetPlayerNetTime( "respawnStatusEndTime" ) )
	thread DelayedDestroyDNA( respawnBeacon, deathbox, RESPAWN_DNA_LIFETIME )
	thread DeathBoxThink_RespawnBeacon( deathbox, respawnBeacon )

	if( !Player_Banners_Enabled() )
	{
		DeathBox_NoBanner_Resolve( deathbox, attacker, damageSourceID )
	}

	#if AUTO_PLAYER
	AutoPlayer_RespawnDeathboxSpawned( player )
#endif // AUTO_PLAYER
}

// Automatically assigns banner to an alive player. Derived from AutoGrabBanners() in Turbo game mode.
void function DeathBox_NoBanner_Resolve( entity deathbox, entity attacker, int damageSourceID )
{
	if( !IsValid( deathbox ) )
		return

	entity owner = deathbox.GetOwner()
	entity dna = deathbox.e.utilityEnt

	if ( !IsValid( dna ) )
		return

	if ( !IsValid( owner ) )
		return

	array < entity > teammates = GetPlayerArrayOfTeam_Alive( owner.GetTeam() )
	if ( teammates.len() != 0 )
	{
		entity squadMember = teammates[0]
		owner.SetPlayerNetInt( "respawnStatus", eRespawnStatus.WAITING_FOR_DELIVERY )
		owner.SetPlayerNetTime( "respawnStatusEndTime", 0 )
		owner.SetPlayerNetTime( "respawnBannerPickedUpTime", Time() )
		SetTeam( deathbox, TEAM_UNASSIGNED )

		PingNearestRespawnBeacon( owner, squadMember.GetOrigin() )

		// TODO: Deletion the dna below is causing trouble with _smoke_test.gnut... what happens if we DON'T do this?
		//if( IsValid( dna ) )
		//{
		//	dna.Destroy()
		//}
	}
}

bool function Was_Damage_FromEnemy( entity victim, entity attacker )
{
	if ( !IsValidPlayer( victim ) )
		return false

	if ( !IsValid( attacker ))
		return false

	if ( !attacker.IsPlayer() )
		return false

	return !IsFriendlyTeam( victim.GetTeam(), attacker.GetTeam() )
}

// Save the latest time a player damaged or was damaged by an enemy, ( i.e. had an enemy encounter ).
void function RespawnEquipped_OnPlayerDamaged( entity player, var damageInfo )
{
	if( !IsValidPlayer( player ) )
		return
	
	// Last Time Enemy Damaged Player Check: Check if damage was from an enemy and if so, save time of damage.
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( !IsValid( attacker ) )
		return

	if ( !attacker.IsPlayer() )
		return

	if( Was_Damage_FromEnemy( player, attacker ) )
	{
		file.lastCombatEncounterVsEnemy[ player ] <- Time()
		file.lastCombatEncounterVsEnemy[ attacker ] <- Time()
	}
}

float function PLV_RespawnEquipped_EnemyDamaged_NotSuicide_TimeWindow()
{
	return( GetCurrentPlaylistVarFloat( "respawnequipped_enemydamage_notsuicide_timewindow", 15.0 ) )
}

// --- Last Death Suicide Status Functions

bool function LastDeathSuicideStatus_Analyze( entity victim, entity attacker, var damageInfo )
{
	// Returns TRUE if last death was a suicide.
	// A death is considered a suicide if ( time of death - time of last enemy engagement ) > threshold.
	bool wasSuicide = true
	if( !IsValidPlayer( victim ) )
		return wasSuicide

	float timeSinceLastEnemyEncounter = Time() - file.lastCombatEncounterVsEnemy[ victim ]

	int damageType = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	switch( damageType )
	{
		// Death by bleedout will check whether the last enemy encounter was within the Bleedout time + some tolerance.
		case eDamageSourceId.bleedout:
			float bleedOutTime = Bleedout_GetBleedoutTime( victim )
			const bleedout_RespawnEquippedTolerance = 5.0
			float bleedOutTimeThreshold = bleedOutTime + bleedout_RespawnEquippedTolerance 
			printt( "Respawn Equipped: Death by Bleedout. Bleedout Time == " + bleedOutTime )
			wasSuicide = timeSinceLastEnemyEncounter > bleedOutTimeThreshold
			break
		//case eDamageSourceId.burn:
		//case eDamageSourceId.crushed:
		//case eDamageSourceId.fall:
		//case eDamageSourceId.outOfBounds:
		//case eDamageSourceId.splat:
		//case eDamageSourceId.submerged:
		//case eDamageSourceId.turbine:
		//	wasSuicide = true
		//	break
		default:
			wasSuicide = timeSinceLastEnemyEncounter > PLV_RespawnEquipped_EnemyDamaged_NotSuicide_TimeWindow()
			break
	}

	// TODO: If we need more specific death criteria, we can evaluate those here.
	//else
	//{
	//	int damageType = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	//	switch( damageType )
	//	{
	//		// Environmental deaths are counted as suicides.
	//		case eDamageSourceId.burn:
	//		case eDamageSourceId.crushed:
	//		case eDamageSourceId.fall:
	//		case eDamageSourceId.outOfBounds:
	//		case eDamageSourceId.splat:
	//		case eDamageSourceId.submerged:
	//		case eDamageSourceId.turbine:
	//			wasSuicide = true
	//			break
	//		default:
	//			break
	//	}
	//}
	#if DEV
		string resultStr = wasSuicide ? "suicide" : "not suicide"
		printt( FUNC_NAME() + "(): player " + victim.GetPlayerName() + " death was " + resultStr )
	#endif // DEV

	LastDeathSuicideStatus_Set( victim, wasSuicide )
	return wasSuicide
}

void function LastDeathSuicideStatus_Set( entity player, bool wasSuicide )
{
	if( !IsValidPlayer( player ) )
		return

	file.lastDeathSuicideStatus_ByPlayer[ player ] <- wasSuicide
}

bool function LastDeathSuicideStatus_Get( entity player )
{
	bool result = true

	if( player in file.lastDeathSuicideStatus_ByPlayer )
	{
		result = file.lastDeathSuicideStatus_ByPlayer[ player ]
	}
	return result
}

