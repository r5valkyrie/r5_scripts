void function DEV_Player_RespawnStatus_ForDuration_Thread( entity player, float duration = 10 )
{
	float startTime = Time()
	float timeSlice = 0.5
	while(( Time() - startTime  ) < duration )
	{
		DEV_Player_RespawnStatus( player )
		wait( timeSlice )
	}
}

void function DEV_Player_RespawnStatus( entity player )
{
	string respawnStatusStr = Get_RespawnStatus_String_ForPlayer( player )
	printt( "Player " + player.GetPlayerName() + " respawnStatus: " + respawnStatusStr )
}

