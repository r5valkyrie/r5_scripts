void function MpSpaceElevator_Init()
{
	SPACEELEVATOR_1P_SCREEN_FX_ID = PrecacheParticleSystem( SPACEELEVATOR_1P_SCREEN_FX )

	PrecacheParticleSystem( ELEVATOR_IGNITION_FX )
	PrecacheParticleSystem( ELEVATOR_BASE_FX )
	PrecacheParticleSystem( ELEVATOR_TOP_FX )
	//PrecacheParticleSystem( ELEVATOR_NEWT_FX )
	PrecacheParticleSystem( SPACEELEVATOR_SHAFT_FX )
	PrecacheParticleSystem( FX_PROJECTILE_DESTROYED )

	PrecacheParticleSystem( HORIZON_FINISHER_REPULSOR_FLASH )

	PrecacheModel( SPACEELEVATOR_SHAFT_MDL_ASSET )
	PrecacheModel( SPACEELEVATOR_REPULSOR_MODEL )
	//PrecacheScriptString( SPACE_ELEVATOR_SCRIPTNAME )

	RegisterSignal( "SpaceElevator_StopVisualBlend" )

	Remote_RegisterClientFunction( "ServerToClient_SpaceElevatorTacProgressRuiStart", "entity" )

	#if SERVER
		RegisterDynamicEntCleanupItem_Parented_Scriptname( SPACE_ELEVATOR_SCRIPTNAME )
		RegisterDynamicEntCleanupItem_Area_Scriptname( SPACE_ELEVATOR_SCRIPTNAME )
	#endif

	#if CLIENT
		RegisterSignal( "SpaceElevator_StopSignal" )

		StatusEffect_RegisterEnabledCallback( eStatusEffect.in_space_elevator, SpaceElevatorTac_1PFX_Start )
		StatusEffect_RegisterDisabledCallback( eStatusEffect.in_space_elevator, SpaceElevatorTac_1PFX_Stop )
	#endif //CLIENT
}

                    
int function GetUpgradedSpaceElevatorHeight()
{
	return GetCurrentPlaylistVarInt( "horizon_lift_upgraded_height", 600 )
}

float function GetUpgradedSpaceElevatorCombineDistance()
{
	return GetCurrentPlaylistVarFloat( "horizon_lift_upgraded_combine_dist", 100 )
}

float function GetUpgradedSpaceElevatorLifetime()
{
	return GetCurrentPlaylistVarFloat( "horizon_lift_upgraded_lifetime", 5 )
}
      
int function GetSpaceElevatorHeight( entity player )
{
	int result = SPACEELEVATOR_TUNING_HEIGHT
	return result
}

float function GetSpaceElevatorLifetime( entity player )
{
	float result = SPACEELEVATOR_TUNING_LIFETIME
	return result
}

#if SERVER
void function SpaceElevator_PropDeployAtPosition( vector origin, vector angles, entity parentTo = null )
{
	SpaceElevator_PropDeploy( null, origin, angles, parentTo )
}
#endif

#if SERVER
void function SpaceElevator_PropDeploy( entity owner, vector origin, vector angles, entity parentTo )
{
	bool ownerIsValid = IsValid( owner )

	entity elevatorProp = CreatePropScript( EMPTY_MODEL, origin, angles, 0, 320000 )
	elevatorProp.kv.collisionGroup = TRACE_COLLISION_GROUP_NONE

	if ( ownerIsValid )
	{
		EndThreadOn_PlayerChangedClass( owner )
		elevatorProp.SetOwner( owner )
		elevatorProp.SetBossPlayer( owner )
		elevatorProp.e.noFriendlyFireProtection = true
		SetTeam( elevatorProp, owner.GetTeam() )
	}

	elevatorProp.DisableHibernation()
	elevatorProp.SetTakeDamageType( DAMAGE_NO )
	elevatorProp.SetDamageNotifications( false )
	elevatorProp.SetDeathNotifications( false )
	elevatorProp.SetScriptName( SPACE_ELEVATOR_SCRIPTNAME )
	SetTargetName( elevatorProp, SPACE_ELEVATOR_SCRIPTNAME )

	if ( ownerIsValid )
	{
		elevatorProp.RemoveFromAllRealms()
		elevatorProp.AddToOtherEntitysRealms( owner )
		AddToUltimateRealm( owner, elevatorProp )
	}

	elevatorProp.EndSignal( "OnDestroy" )

	entity mover
	if ( parentTo != null )
	{
		mover = CreateScriptMover_NEW( SPACE_ELEVATOR_MOVER_SCRIPTNAME, origin, angles + <-90, 0, 0> )
		mover.SetParent( parentTo )
		elevatorProp.SetParent( mover )
	}
	else
	{
		mover = elevatorProp
	}

	entity wp = null
	if ( ownerIsValid )
	{
		//TrackingVision_CreatePOI( eTrackingVisionNetworkedPOITypes.PLAYER_ABILITY_SPACE_ELEVATOR, owner, elevatorProp.GetOrigin(), owner.GetTeam(), owner )
	}

	int elevatorHeight = GetSpaceElevatorHeight( owner )

	                    
	if( IsValid( owner ) )
	{
		if( !( owner in file.playerToActiveLifts ) )
			file.playerToActiveLifts[owner] <- []

		file.playerToActiveLifts[owner].append( elevatorProp )
	}
	file.elevatorHeights[elevatorProp] <- elevatorHeight
       

	//Vortex cylinder for detecting grenades
	entity vortexCylinder = CreateElevatorVortex( elevatorProp, owner, SPACEELEVATOR_TUNING_RADIUS, float( elevatorHeight ) )

	entity traceBlocker = CreateTraceBlockerVolume( elevatorProp.GetOrigin(), 24.0, true, CONTENTS_BLOCK_PING, elevatorProp.GetTeam(), SPACE_ELEVATOR_SCRIPTNAME )
	vector boxMin = <-SPACEELEVATOR_TUNING_RADIUS/2, -SPACEELEVATOR_TUNING_RADIUS/2, 0>
	vector boxMax =  <SPACEELEVATOR_TUNING_RADIUS/2, SPACEELEVATOR_TUNING_RADIUS/2, elevatorHeight/2>
	traceBlocker.SetBox( boxMin,boxMax )

	//NEWT START UP SOUNDS
	if ( ownerIsValid )
	{
		EmitSoundOnEntityToTeam( elevatorProp, SPACEELEVATOR_SOUND_NEWT_START_FRIENDLY, owner.GetTeam() )
		EmitSoundOnEntityToEnemies( elevatorProp, SPACEELEVATOR_SOUND_NEWT_START_ENEMY, owner.GetTeam() )
	}
	else
	{
		EmitSoundOnEntity( elevatorProp, SPACEELEVATOR_SOUND_NEWT_START_FRIENDLY )
	}

	//NEWT LOOP SOUND
	entity loopAG = CreateEntity( "ambient_generic" )
	SetTeam( loopAG, elevatorProp.GetTeam() )
	loopAG.SetOrigin( elevatorProp.GetOrigin() + <0, 0, SPACEELEVATOR_SOUND_NEWT_IDLE_Z_START> )
	loopAG.SetSegmentEndpoints( elevatorProp.GetOrigin() + <0, 0, SPACEELEVATOR_SOUND_NEWT_IDLE_Z_START>, elevatorProp.GetOrigin() + <0, 0, SPACEELEVATOR_SOUND_NEWT_IDLE_Z_END> )
	loopAG.RemoveFromAllRealms()
	loopAG.AddToOtherEntitysRealms( elevatorProp )
	loopAG.SetParent( elevatorProp )
	loopAG.SetSoundName( SPACEELEVATOR_SOUND_NEWT_IDLE_LOOP )
	loopAG.SetEnabled( true )

	array<entity> newtSpaceElevatorFXArray
	array<entity> newtSpaceElevatorCyclinderFXArray

	entity ignitionFX = StartParticleEffectOnEntityWithPos_ReturnEntity ( elevatorProp, GetParticleSystemIndex( ELEVATOR_IGNITION_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, <0, 0, 2>, ZERO_VECTOR )
	entity idleAtomFX = StartParticleEffectOnEntityWithPos_ReturnEntity ( elevatorProp, GetParticleSystemIndex( ELEVATOR_BASE_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, <0, 0, 2>, ZERO_VECTOR )

	newtSpaceElevatorFXArray.append( ignitionFX )
	newtSpaceElevatorFXArray.append( idleAtomFX )


	int shaftDivisions = int((elevatorHeight - SPACEELEVATOR_SHAFT_BOTTOM_SPACING) / SPACEELEVATOR_SHAFT_SPACING)
	vector offset      = <0, 0, SPACEELEVATOR_SHAFT_BOTTOM_SPACING>

	array<entity> newtCylinderArray
	entity cylinderEntity
	entity shaftFXEntity
	for ( int i = 0; i < shaftDivisions; i++ )
	{
		shaftFXEntity = StartParticleEffectOnEntityWithPos_ReturnEntity ( elevatorProp, GetParticleSystemIndex( SPACEELEVATOR_SHAFT_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, offset, <0, 0, 0> )
		newtSpaceElevatorFXArray.append( shaftFXEntity )
		newtSpaceElevatorCyclinderFXArray.append( shaftFXEntity )

		EffectSetControlPointVector( shaftFXEntity, 2, <1, 0, 0> )

		offset.z += SPACEELEVATOR_SHAFT_SPACING
	}      
		{
			entity elevatorTopFX = StartParticleEffectOnEntityWithPos_ReturnEntity ( elevatorProp, GetParticleSystemIndex( ELEVATOR_TOP_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, <0, 0, GetSpaceElevatorHeight( owner ) - 150>, ZERO_VECTOR )
			newtSpaceElevatorFXArray.append( elevatorTopFX )
			newtSpaceElevatorCyclinderFXArray.append( elevatorTopFX )
		}

	OnThreadEnd(
		function() : ( owner, elevatorProp, mover, vortexCylinder, loopAG, newtSpaceElevatorFXArray, wp, traceBlocker)
		{
			delete file.inElevatorRefCount[elevatorProp]
			delete file.inElevatorObjects[elevatorProp]
			delete file.inElevatorHistoryObjects[elevatorProp]

			if ( IsValid( wp ) )
				wp.Destroy()

			if ( IsValid( loopAG ) )
				loopAG.Destroy()

			foreach ( fx in newtSpaceElevatorFXArray )
			{
				if ( IsValid( fx ) )
				{
					EffectStop( fx )
					fx.Destroy()
				}
			}
			newtSpaceElevatorFXArray.clear()

			if ( IsValid_ThisFrame( elevatorProp ) )
				elevatorProp.Destroy()

			if ( IsValid( mover ) )
				mover.Destroy()

			if ( IsValid( vortexCylinder ) )
				vortexCylinder.Destroy()

			if ( IsValid( traceBlocker ) )
				traceBlocker.Destroy()

			                    
			delete file.elevatorHeights[elevatorProp]
			if( owner in file.playerToActiveLifts && file.playerToActiveLifts[owner].contains( elevatorProp ) )
				file.playerToActiveLifts[owner].fastremovebyvalue( elevatorProp )
         
		}
	)

	//wait lifetime
	file.inElevatorRefCount[elevatorProp] <- 0
	file.inElevatorObjects[elevatorProp] <- []
	file.inElevatorHistoryObjects[elevatorProp] <- []
	thread SPACEELEVATOR_CreateTrigger( elevatorProp, elevatorHeight )
	thread SPACEELEVATOR_KeepUprightThread( elevatorProp , <0,0,0>)


	float gravityLiftLifetime = GetCurrentPlaylistVarFloat( "gravity_lift_lifetime", GetSpaceElevatorLifetime( owner ) )

	wait gravityLiftLifetime
	waitthread SPACEELEVATOR_KeepAliveThread( elevatorProp )
}

void function SPACEELEVATOR_KeepUprightThread( entity elevator, vector angles )
{
	elevator.EndSignal( "OnDestroy" )
	//This seems horrible but something is setting the angles of the projectile AFTER its planted.
	while ( true )
	{
		elevator.SetAbsAngles( angles )
		wait 0.1
	}
}

void function SPACEELEVATOR_KeepAliveThread( entity elevator )
{
	elevator.EndSignal( "OnDestroy" )
	float timeInKeepAlive = 0.0
	float TICK_RATE = 0.1
	if ( elevator in file.inElevatorRefCount )
	{
		while ( file.inElevatorRefCount[elevator] > 0 )
		{
			//Lets confirm
			int numObjectsMidElevator = 0
			if ( elevator in file.inElevatorObjects )
			{
				foreach ( player in file.inElevatorObjects[elevator] )
				{
					if ( IsValid( player ) )
					{
						//If a player is at the top then we can consider them out
						float playerElevatorPct       = GetPlayerElevatorProgress( elevator, player )
						float playerSmootherZVelocity = player.GetSmoothedVelocity().z  // We check this because if we just get the velocity, it sometimes comes back as the velocity we set this frame and we might not be at that velocity
						if ( playerSmootherZVelocity > (SPACEELEVATOR_TUNING_UP_SPEED / 2) && playerElevatorPct < SPACEELEVATOR_TUNING_HOVER_HEIGHT_PCT )
						{
							numObjectsMidElevator++
						}
					}
				}
			}

			float gravityLiftKeepAliveTime = GetCurrentPlaylistVarFloat( "gravity_lift_keep_alive_time", SPACEELEVATOR_TUNING_KEEP_ALIVE_MAX_TIME )

			if ( numObjectsMidElevator == 0 || timeInKeepAlive > gravityLiftKeepAliveTime )
			{
				break
			}

			timeInKeepAlive += TICK_RATE
			wait TICK_RATE
		}
	}
}


entity function CreateElevatorVortex( entity elevatorProp, entity owner, float radius, float height )
{
	entity vortexSphere = CreateEntity( "vortex_sphere" )
	vortexSphere.kv.spawnflags = SF_ABSORB_CYLINDER | SF_BLOCK_OWNER_WEAPON | SF_ABSORB_BULLETS
	vortexSphere.kv.enabled = 0
	vortexSphere.kv.radius = radius
	vortexSphere.kv.bullet_fov = 360
	vortexSphere.kv.physics_pull_strength = 25
	vortexSphere.kv.physics_side_dampening = 6
	vortexSphere.kv.physics_fov = 360
	vortexSphere.kv.physics_max_mass = 2
	vortexSphere.kv.physics_max_size = 6
	vortexSphere.SetAngles( <0, 0, 0> )
	vortexSphere.SetOrigin( elevatorProp.GetOrigin() )
	vortexSphere.SetMaxHealth( 100 )
	vortexSphere.SetHealth( 100 )
	vortexSphere.SetInvulnerable()
	vortexSphere.kv.height = fabs( height )

	DispatchSpawn( vortexSphere )


	vortexSphere.RemoveFromAllRealms()
	vortexSphere.AddToOtherEntitysRealms( elevatorProp )

	if ( IsValid( owner ) )
		AddToUltimateRealm( owner, vortexSphere )
	vortexSphere.SetOwner( elevatorProp )
	vortexSphere.SetParent( elevatorProp, "", true, 0.0 )

	Vortex_ConvertToVortexTriggerArea( vortexSphere )
	SetCallback_VortexSphereTriggerOnBulletHit( vortexSphere, SPACEELEVATOR_VortexTriggerOnBulletHit )
	SetCallback_VortexSphereTriggerOnProjectileHit( vortexSphere, SPACEELEVATOR_VortexTriggerOnProjectileHit )
	VortexFireEnable( vortexSphere )


	return vortexSphere
}

#if SERVER
void function SPACEELEVATOR_VortexTriggerOnBulletHit( entity weapon, entity vortexSphere, var damageInfo )
{
	if ( SPACEELEVATOR_VORTEX_DEBUG )
	{
		printt( "SPACEELEVATOR_VortexTriggerOnBulletHit" )
	}
}
#endif

void function SPACEELEVATOR_VortexTriggerOnProjectileHit( entity weapon, entity vortexSphere, entity attacker, entity projectile, vector contactPos )
{
	if ( SPACEELEVATOR_VORTEX_DEBUG )
	{
		printt( "SPACEELEVATOR_VortexTriggerOnProjectileHit" )
		printt( "ELEVATOR HIT " + projectile.GetClassName() )
	}

	bool forceIgnore         = false
	bool forceAllow          = false
	var allowGravityOverride = projectile.ProjectileGetWeaponInfoFileKeyField( "affected_by_gravity_lift" )

	if ( allowGravityOverride != null )
	{
		expect int( allowGravityOverride )
		if ( allowGravityOverride == 1 )
			forceAllow = true
		else
			forceIgnore = false
	}

	                    
	entity elevatorProp = vortexSphere.GetOwner()
	entity playerOwner = IsValid( elevatorProp ) ? elevatorProp.GetOwner() : null

	if ( projectile.GetClassName() == "grenade" || forceAllow && !forceIgnore )
	{
		//Cut down the horizontal and add a big upwards boost.
		float currentFriction = 1 //projectile.GetCurrentFlightFriction()
		float frictionScalarPercent = (SPACEELEVATOR_MAX_FRICTION_SCALE - currentFriction) / SPACEELEVATOR_MAX_FRICTION_SCALE
		float frictionScale = 1.0 - (max( frictionScalarPercent, 0.0 ) * 0.75)
		vector oldVelocity = projectile.GetVelocity()
		vector newVelocity = (FlattenVec( oldVelocity ) * frictionScale) + <0, 0, 1000>
		projectile.SetVelocity( newVelocity )
	}
}

void function SPACEELEVATOR_CreateTrigger( entity projectile, int aboveHeight )
{
	entity owner    = projectile.GetOwner()
	vector origin   = projectile.GetOrigin()
	int radius      = int(SPACEELEVATOR_TUNING_RADIUS)
	int belowHeight = 0

	entity trigger = CreateEntity( "trigger_cylinder" )
	trigger.SetRadius( radius )
	trigger.SetAboveHeight( aboveHeight )
	trigger.SetBelowHeight( belowHeight )
	trigger.kv.triggerFilterNpc = "all"
	trigger.kv.triggerFilterPlayer = "all"
	trigger.kv.triggerFilterNonCharacter = 1
	trigger.SetOrigin( origin )
	DispatchSpawn( trigger )


	trigger.RemoveFromAllRealms()
	trigger.AddToOtherEntitysRealms( projectile )

	trigger.SetParent( projectile )
	trigger.SetOwner( owner )
	trigger.SetAbsAngles( projectile.GetAngles() )


	trigger.SetEnterCallback( SPACEELEVATOR_TriggerEnter )
	trigger.SearchForNewTouchingEntity()  // set this to catch an entity in the trigger right away


	EndSignal( trigger, "OnDestroy" )

	if ( SPACEELEVATOR_DEBUG )
	{
		printt( "BLACKHOLE_CreateTrigger thread started" )
	}
	OnThreadEnd(
		function () : ( trigger )
		{
			if ( SPACEELEVATOR_DEBUG )
			{
				printt( "BLACKHOLE_CreateTrigger thread ENDED" )
			}
			if ( IsValid( trigger ) )
				trigger.Destroy()
		}
	)

	if ( SPACEELEVATOR_DEBUG )
	{
		DebugDrawCylinder( trigger.GetOrigin(), <-90, 0, 0>, SPACEELEVATOR_TUNING_RADIUS, trigger.GetAboveHeight(), 0, 200, 0, true, GetSpaceElevatorLifetime( owner ) )
		//DebugDrawCylinder( trigger.GetOrigin(), < -90, 0, 0 >, radius, trigger.GetAboveHeight(), 0, 165, 255, true, 9999.9 )
		DebugDrawCylinder( trigger.GetOrigin(), <-90, 0, 0>, SPACEELEVATOR_TUNING_AWAY_FROM_CENTER_DIST, trigger.GetAboveHeight(), 0, 200, 200, true, GetSpaceElevatorLifetime( owner ) )
	}

	WaitForever()
}
#endif //SERVER

void function SPACEELEVATOR_TriggerEnter( entity trigger, entity ent )
{
	if ( !ent.DoesShareRealms( trigger ) )
		return

#if SERVER
	if ( ent.GetScriptName() == DEPLOYABLE_MEDIC_SCRIPT_NAME  )
	{
		if ( !StatusEffect_HasSeverity( ent, eStatusEffect.in_space_elevator ) )
		{
			if ( SPACEELEVATOR_DRONE_DEBUG )
			{
				printt( "ELEVATOR: Drone enter" )
			}
			thread SPACEELEVATOR_DroneInTriggerThread( trigger, ent )
		}
		return
	}
#endif //SERVER
	if ( !ent.IsPlayer() )
		return

	thread SPACEELEVATOR_InTriggerThread( trigger, ent )
}

#if SERVER
float function GetPlayerElevatorProgress( entity elevator, entity player )
{
	float progress = 1.0
	if ( IsValid( player ) )
	{
		vector playerPos = player.GetOrigin()

		vector elevatorPos = elevator.GetOrigin()

		vector triggerToPlayer = playerPos - elevatorPos

		vector elevatorDirection = elevator.GetUpVector()
		float distanceAlongLine  = DotProduct( triggerToPlayer, elevatorDirection )

		float elevatorHeight = float(GetSpaceElevatorHeight( player ))

		                    
			if( elevator in file.elevatorHeights )
				elevatorHeight = float(file.elevatorHeights[elevator])
        
		progress = distanceAlongLine / elevatorHeight
	}
	return progress
}

void function SPACEELEVATOR_DroneEjectedWaitForGround( entity drone )
{
	EndSignal( drone, "OnDestroy" )

	const float GROUND_TRACE = 25
	TraceResults trace
	trace.fraction = 1.0

	while ( trace.fraction >= 1.0 )
	{
		trace = TraceLine( drone.GetOrigin(), drone.GetOrigin() - <0, 0, GROUND_TRACE>, null, TRACE_MASK_NPCWORLDSTATIC, TRACE_COLLISION_GROUP_NONE, drone )
		WaitFrame()
	}

	if ( IsValid( drone ) )
	{
		drone.SetAbsOrigin( drone.GetOrigin() )
		if ( !IsValid( drone.GetParent() ) )
		{
			drone.SetPhysics( MOVETYPE_VPHYSICS )
		}
	}
}

void function SPACEELEVATOR_DroneInTriggerThread( entity trigger, entity drone )
{
	EndSignal( trigger, "OnDestroy" )
	EndSignal( drone, "OnDestroy" )

	entity elevatorProp = trigger.GetParent()

	int cachedPhysicsType =  drone.GetPhysics()
	OnThreadEnd(
		function() : ( drone, elevatorProp, cachedPhysicsType )
		{
			if ( IsValid( drone ) )
			{
				vector ejectVelocity = drone.GetForwardVector() * SPACEELEVATOR_TUNING_EJECT_HORIZ_SPEED * 0.75 + <0, 0, -SPACEELEVATOR_TUNING_EJECT_UP_SPEED/1.5>

				drone.SetVelocity( ejectVelocity )

				StatusEffect_StopAllOfType( drone, eStatusEffect.in_space_elevator )
				StatusEffect_AddTimed( drone, eStatusEffect.in_space_elevator, 1.0, 1.0, 0.0 )
				if ( drone.GetScriptName() == DEPLOYABLE_MEDIC_SCRIPT_NAME )
				{
					thread SPACEELEVATOR_DroneEjectedWaitForGround( drone )
				}
				else
				{
					drone.SetPhysics( cachedPhysicsType )
				}
			}
		}
	)

	EmitSoundAtPosition( TEAM_ANY, drone.GetOrigin(), SPACEELEVATOR_SOUND_PLAYER_ENTER_3P, drone )


	StatusEffect_AddEndless( drone, eStatusEffect.in_space_elevator, 1.0 )

	while( trigger.IsTouching( drone ) && !IsValid( drone.GetParent() ) )
	{
		//Set velocity
		vector objectPos = drone.GetOrigin()
		vector triggerPos = trigger.GetOrigin()

		float elevatorSpeed = SPACEELEVATOR_TUNING_UP_SPEED

		vector triggerToObject = objectPos - triggerPos

		vector elevatorDirection = trigger.GetUpVector()
		float distanceAlongLine = DotProduct(triggerToObject, elevatorDirection)

		vector closestPointOnLine = distanceAlongLine*elevatorDirection + triggerPos + <0,0,-SPACEELEVATOR_TUNING_PLAYER_VIEWPOINT_OFFSET>

		vector objectToCenter = closestPointOnLine - objectPos


		vector toCenterOfElevatorVelocity = ZERO_VECTOR
		if ( Length( objectToCenter ) >= SPACEELEVATOR_TUNING_AWAY_FROM_CENTER_DIST )// Im away from the center
		{
			toCenterOfElevatorVelocity = Normalize( objectToCenter ) * SPACEELEVATOR_TUNING_TO_CENTER_SPEED
		}

		vector elevatorVelocity = elevatorSpeed*elevatorDirection
		vector finalNewVelocity = elevatorVelocity + toCenterOfElevatorVelocity

		drone.SetPhysics( MOVETYPE_FLY )

		WaitFrame()
	}
}
#endif //SERVER

bool function ShouldSpaceElevatorAffectPlayer( entity player )
{
	if ( !IsAlive( player ) )
	{
		return false
	}
	if ( player.IsGrappleAttached() || player.IsZiplining() )
	{
		return false
	}
	if ( player.ContextAction_IsBusy() )
	{
		return false
	}

	if ( player.IsPhaseShiftedOrPending() )
	{
		return false
	}

	return true
}

void function ApplyElevatorEffects( entity player, entity trigger, array<entity> player3PEffectsArray, ElevatorEffectData data, bool shouldApply )
{
	if ( shouldApply )
	{
		StatusEffect_AddEndless( player, eStatusEffect.in_space_elevator, 1.0 )

		#if SERVER
			GiveExtraWeaponMod( player, "elevator_shooter" )

			if ( !Bleedout_IsBleedingOut( player ) )
			{
				player.ForceStand()
			}
			DisableMantle( player )

			if ( IsValid( trigger ) )
			{
				SpaceElevator_3PPlayerFX_Start( trigger, player, player3PEffectsArray )
				entity newtEntity = trigger.GetParent()
				if ( IsValid( newtEntity ) )
				{
					if ( newtEntity in file.inElevatorRefCount )
					{
						file.inElevatorRefCount[newtEntity] += 1
					}
					if ( newtEntity in file.inElevatorObjects )
					{
						if ( !file.inElevatorObjects[newtEntity].contains( player ) )
						{
							file.inElevatorObjects[newtEntity].push( player )
						}
					}
					if ( newtEntity in file.inElevatorHistoryObjects )
					{
						if ( !file.inElevatorHistoryObjects[newtEntity].contains( player ) )
						{
							file.inElevatorHistoryObjects[newtEntity].push( player )
						}
					}
				}
			}
		#endif
	}
	else
	{
		StatusEffect_StopAllOfType( player, eStatusEffect.in_space_elevator )

		#if SERVER
			SpaceElevator_3PPlayerFX_Stop( player3PEffectsArray )

			TakeExtraWeaponMod( player, "elevator_shooter" )

			player.UnforceStand()
			EnableMantle( player )

			if ( IsValid( trigger ) )
			{
				entity newtEntity = trigger.GetParent()
				if ( IsValid( newtEntity ) )
				{
					if ( newtEntity in file.inElevatorRefCount )
					{
						file.inElevatorRefCount[newtEntity] -= 1
					}

					if ( newtEntity in file.inElevatorObjects )
					{
						if ( file.inElevatorObjects[newtEntity].contains( player ) )
						{
							file.inElevatorObjects[newtEntity].removebyvalue( player )
						}
					}
				}
			}
		#endif
	}
}

void function SPACEELEVATOR_InTriggerThread( entity trigger, entity player )
{
	EndSignal( trigger, "OnDestroy" )
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDeath" )

	array<entity> player3PSpaceElevatorFXArray
	ElevatorEffectData data
	
	data.hoverStartTime = -1.0

	OnThreadEnd(
		function() : (player, player3PSpaceElevatorFXArray, trigger, data )
		{
			if ( IsValid( player ) )
			{
				if ( StatusEffect_HasSeverity( player, eStatusEffect.in_space_elevator ) )
				{
					ApplyElevatorEffects( player, trigger, player3PSpaceElevatorFXArray, data, false )
				}

				if ( ShouldSpaceElevatorAffectPlayer( player ) )
				{
					SPACEELEVATOR_EjectPlayer( player, trigger, false )
				}
			}
		}
	)

	if ( ShouldSpaceElevatorAffectPlayer( player ) )
	{
		#if SERVER
			EmitSoundAtPositionOnlyToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_ENTER_1P )
			if ( player.GetTeam() == trigger.GetTeam() )
			{
				EmitSoundAtPositionExceptToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_ENTER_3P )
			}
			else
			{
				EmitSoundAtPositionExceptToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_ENTER_3P_ENEMY )
			}
		#endif
	}

	while( trigger.IsTouching( player ) )
	{
		if ( ShouldSpaceElevatorAffectPlayer( player ) )
		{
			if ( !StatusEffect_HasSeverity( player, eStatusEffect.in_space_elevator ) )
			{
				ApplyElevatorEffects( player, trigger, player3PSpaceElevatorFXArray, data, true )
			}

			#if SERVER
				vector playerPos = player.GetOrigin()
				vector liftPos = trigger.GetOrigin()
				float liftMaxHeight = trigger.GetAboveHeight()
				float currentHeight = playerPos.z - liftPos.z

				vector curVel = player.GetVelocity()

				vector diff = liftPos - playerPos
				diff.z = 0 
				
				if ( Length(diff) > 20.0 )
				{
					vector dir = Normalize(diff)
					
					float newX = (curVel.x * MANUAL_AIR_FRICTION) + (dir.x * SPACEELEVATOR_TUNING_TO_CENTER_SPEED)
					float newY = (curVel.y * MANUAL_AIR_FRICTION) + (dir.y * SPACEELEVATOR_TUNING_TO_CENTER_SPEED)
					
					player.SetVelocity( <newX, newY, curVel.z> )
					curVel = <newX, newY, curVel.z>
				}

				if ( currentHeight >= (liftMaxHeight - 50.0) )
				{
					if ( data.hoverStartTime < 0 )
						data.hoverStartTime = Time()
					
					if ( currentHeight > liftMaxHeight )
					{
						player.SetVelocity( <curVel.x, curVel.y, -100.0> )
					}
					else
					{
						player.SetVelocity( <curVel.x, curVel.y, 0.0> )
					}
					
					if ( Time() - data.hoverStartTime > SPACEELEVATOR_TUNING_MAX_HOVER_TIME )
					{
						SPACEELEVATOR_EjectPlayer( player, trigger, true )
						return
					}
				}
				else
				{
					data.hoverStartTime = -1.0
					player.SetVelocity( <curVel.x, curVel.y, SPACEELEVATOR_TUNING_UP_SPEED> )
				}
			#endif
		}
		WaitFrame()
	}
}

void function SPACEELEVATOR_EjectPlayer( entity player, entity trigger, bool isTopEject )
{
	#if SERVER
		if ( !IsValid(player) ) return
		if ( player.p.totemRecallTime + 2.0 > Time() )
			return

		vector velocity = player.GetVelocity()
		
		if ( isTopEject )
		{
			vector viewForward = player.GetViewVector()
			viewForward.z = 0
			viewForward = Normalize(viewForward)
			
			player.SetVelocity( (viewForward * SPACEELEVATOR_TUNING_EJECT_HORIZ_SPEED) + <0, 0, SPACEELEVATOR_TUNING_EJECT_UP_SPEED> )
		}
		else
		{
			player.SetVelocity( velocity + <0, 0, SPACEELEVATOR_TUNING_EJECT_UP_SPEED> )
		}

		EmitSoundAtPositionOnlyToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_EXIT_1P )
		if ( player.GetTeam() ==  trigger.GetTeam() )
		{
			EmitSoundAtPositionExceptToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_EXIT_3P )
		}
		else
		{
			EmitSoundAtPositionExceptToPlayer( TEAM_ANY, player.GetOrigin(), player, SPACEELEVATOR_SOUND_PLAYER_EXIT_3P_ENEMY )
		}
	#endif
}

#if SERVER
void function SpaceElevator_3PPlayerFX_Start( entity trophy, entity player, array<entity> spaceElevatorFXArray )
{
	// Add any desired 3p fx here
}

void function SpaceElevator_3PPlayerFX_Stop( array<entity> spaceElevatorFXArray )
{
	if ( SPACEELEVATOR_DEBUG )
	{
		printt( "DestroyPlayerSpaceElevatorFX" )
	}

	foreach ( fx in spaceElevatorFXArray )
	{
		if ( IsValid( fx ) )
			fx.Destroy()
	}
	spaceElevatorFXArray.clear()
}
