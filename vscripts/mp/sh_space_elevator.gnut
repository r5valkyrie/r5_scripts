const float SPACEELEVATOR_TUNING_UP_SPEED = 450   //Speed the player moves up
const float SPACEELEVATOR_TUNING_UP_ACCEL = 100000
const float SPACEELEVATOR_TUNING_HORIZ_SPEED = 170 
const float SPACEELEVATOR_TUNING_HORIZ_ACCEL = 2000
const float SPACEELEVATOR_TUNING_TO_CENTER_SPEED = 30 //How hard the player is pulled towards the center
const float SPACEELEVATOR_TUNING_TO_CENTER_ACCEL = 0
const float SPACEELEVATOR_TUNING_INPUT_THRESHOLD = 0.2

const float SPACEELEVATOR_TUNING_EJECT_UP_SPEED = 450 //Speed the player is ejected up
const float SPACEELEVATOR_TUNING_EJECT_HORIZ_SPEED = 400 //Speed the player is ejected out
const float SPACEELEVATOR_TUNING_MAX_EJECT_TIME = 2
const float SPACEELEVATOR_TUNING_MAX_HOVER_TIME = 2 //Wait time before the player force ejects

const float SPACEELEVATOR_TUNING_PLAYER_VIEWPOINT_OFFSET = 33
const float SPACEELEVATOR_TUNING_AWAY_FROM_CENTER_DIST = 40
const float SPACEELEVATOR_TUNING_HOVER_HEIGHT_PCT = 0.9

const float SPACEELEVATOR_TUNING_LIFETIME = 10
const float SPACEELEVATOR_TUNING_KEEP_ALIVE_MAX_TIME = 5

