const asset SPACEELEVATOR_SHAFT_FX = $"p_wpn_grav_lift_column"
const float SPACEELEVATOR_SHAFT_SPACING = 160
const float SPACEELEVATOR_SHAFT_BOTTOM_SPACING = 150

const float SPACEELEVATOR_MAX_FRICTION_SCALE = 2500


