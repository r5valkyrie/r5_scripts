global const string LOOT_CEREMONY_MUSIC_P2 = "Music_LootCeremony_Pt2"

global array<string> WORKAROUND_UI_MUSIC_SOUND_LIST = [
	"Music_FrontEnd",
	"mainmenu_music_Event1", "Music_Lobby_Event1", // ??? itemflav\musicpack\season01_event in bakery doesn't seem to be part of the game. Was it ever?
