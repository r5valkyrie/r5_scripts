#if SERVER
void function PlayMusicToPlayer( entity player, string musicTrack, float seekTime = 0.0 )
{
	if ( GetCurrentPlaylistVarBool( "disable_default_music", false ) )
		return

	if ( IsTestMap() )
		return

	if ( IsMusicPlayingToPlayer( player, musicTrack ) )
	{
		printt( "Music Warning: Already playing music track " + musicTrack + " on player " + player )
		return
	}

	if ( !(player in fileLevel.musicTracksPlayingForPlayer) )
		fileLevel.musicTracksPlayingForPlayer[ player ] <- []
	fileLevel.musicTracksPlayingForPlayer[ player ].append( musicTrack )

	printt( "Music: Starting", musicTrack, "on", player )

	if ( seekTime == 0.0 )
		EmitSoundOnEntityOnlyToPlayer( player, player, musicTrack )
	else
		EmitSoundOnEntityOnlyToPlayerWithSeek( player, player, musicTrack, seekTime )
}
#endif


#if SERVER
bool function IsMusicPlayingToPlayer( entity player, string musicTrack )
{
	if ( !(player in fileLevel.musicTracksPlayingForPlayer) )
		return false
	return fileLevel.musicTracksPlayingForPlayer[ player ].contains( musicTrack )
}
#endif


#if SERVER
void function StopAllMusicOnPlayer( entity player )
{
	if ( !(player in fileLevel.musicTracksPlayingForPlayer) )
		return

	array<string> musicListCloneForPlayer = clone fileLevel.musicTracksPlayingForPlayer[ player ]

	foreach( string musicTrack in musicListCloneForPlayer )
	{
		StopMusicOnPlayer( player, musicTrack )
	}
}
#endif


#if CLIENT
void function ServerCallback_PlayMatchEndMusic()
{
	// ideally we would have a server side music system that could play music not just on the view player but on the clientplayer.
	// but since that isn't the case we'll have to do something special for this case.

	entity clientPlayer = GetLocalClientPlayer()
	if ( clientPlayer.GetTeam() == GetWinningTeam() && GetWinningTeam() >= TEAM_MULTITEAM_FIRST )
	{
		EmitSoundOnEntity( clientPlayer, MusicPack_GetWinMusic( GetMusicPackForPlayer( clientPlayer ) ) )
	}
	else
	{
		StopSoundOnEntity( clientPlayer, MusicPack_GetLossMusic( GetMusicPackForPlayer( clientPlayer ) ) )
		EmitSoundOnEntity( clientPlayer, MusicPack_GetLossMusic( GetMusicPackForPlayer( clientPlayer ) ) )
	}
}
#endif


#if SERVER
void function MusicPack_OnClientConnected( entity player )
{
	thread _OnClientConnected( player )
}

void function _OnClientConnected( entity player )
{
	player.EndSignal( "OnDestroy" )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	ItemFlavor music = __GetMusicPackForPlayer_RollTheRandom( player )

	//player.SetNonRewindMusicPack( ItemFlavor_GetGUID( music ) )
}
#endif


#if SERVER || CLIENT || UI
ItemFlavor function __GetMusicPackForPlayer_RollTheRandom( entity player )
{
	ItemFlavor music = WaitForMusicPackForPlayer( player )

	if ( GRX_IsInventoryReady( player ) && ItemFlavor_IsTheRandom( music ) )
	{
		LoadoutEntry musicSlot  = Loadout_MusicPack()
		array<ItemFlavor> items = clone GetValidItemFlavorsForLoadoutSlot( ToEHI( player ), musicSlot )

		foreach ( item in clone items )
		{
			if (
				( ItemFlavor_GetGRXMode( item ) != GRX_ITEMFLAVORMODE_NONE && !GRX_IsItemOwnedByPlayer( item, player ) )
				|| ItemFlavor_IsTheRandom( item )
				)
				items.fastremovebyvalue( item )
		}

		if ( items.len() > 0 )
		{
			music = items.getrandom()
		}
	}

	return music
}
#endif


