{
	//if( door.GetDoorIsReinforced() )
	//	return

	thread ResinDoorThread2( door, team, duration )

	entity oppositeDoor = door.GetOppositeDoor()
	if ( IsValid( oppositeDoor )  )
	{
		//if ( !oppositeDoor.GetDoorIsReinforced()  && !oppositeDoor.IsDoorOpen() && !door.IsDoorOpen() )
		{
		//	thread ResinDoorThread2( oppositeDoor, team, duration )
		}
	}
}

void function ResinDoorThread( entity door, int team, float duration )
{
	Assert ( IsNewThread(), "Must be threaded off" )

	door.EndSignal( "OnDestroy" )

	vector angles = door.GetAngles()
	vector goalAngles = angles
	bool destroyed = false
	vector position = door.GetOrigin() - ( door.GetRightVector() * RESIN_DOOR_HALF_WIDTH ) + < 0, 0, RESIN_DOOR_Z_OFFSET >

	entity resin = CreateResinShard( RESIN_DOOR_SHARD_MODEL, position, goalAngles, team )
	resin.SetParent( door )
	resin.NotSolid()
	resin.SetCanBeMeleed( false )
	resin.SetCollisionAllowed( false )

	EmitSoundOnEntity( resin, RESIN_HARDEN_3P_SOUND )

	//Freezing a door is similar to locking the door.  This is the easiest way to make it not work while frozen.  No status effect required.
	ReinforceDoor( door )

	resin.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function () : ( resin, door, destroyed )
		{
			if ( IsValid( resin ) )
			{
				resin.Destroy()
			}

			if ( IsValid( door ) )
			{
				if ( !destroyed )
				{
					EmitSoundOnEntity( door, RESIN_CRUMBLE_3P_SOUND )
				}
				UnReinforceDoor( door )
			}
		}
	)

	if( duration > 0 )
		wait duration
	else
		WaitForever()

	destroyed = true
	resin.Dissolve( ENTITY_DISSOLVE_CORE, <0,0,0>, 500 )
	EmitSoundOnEntity( door, RESIN_CRUMBLE_3P_SOUND )
}

void function ResinDoorThread2( entity door, int team, float duration )
{
	Assert ( IsNewThread(), "Must be threaded off" )

	door.EndSignal( "OnDestroy" )

	entity endFX = StartParticleEffectOnEntityWithPos_ReturnEntity( door, GetParticleSystemIndex( RESIN_REINFORCE_DOOR_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, < 0, 30, 48 >, ZERO_VECTOR )

	EmitSoundOnEntity( door, RESIN_HARDEN_3P_SOUND )

	SetReinforced( door )
	ReinforceDoor( door )

	door.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function () : ( endFX, door)
		{
			if ( IsValid( endFX ) )
			{
				EffectStop( endFX )
			}

			if ( IsValid( door ) )
			{
				UnReinforceDoor( door )
			}
		}
	)

	if( duration > 0 )
		wait duration
	else
		WaitForever()

	EmitSoundOnEntity( door, RESIN_CRUMBLE_3P_SOUND )
}

entity function CreateResinShard( asset model, vector position, vector angles, int team, float health = RESIN_HEALTH_MAX, int contents = CONTENTS_SOLID, bool createUI = true, float destroyDelay = -1, entity owner = null, bool highlight = RESIN_HIGHLIGHT_ENABLED )
{
	entity resin = CreateFerroProp( model, position, angles, SOLID_VPHYSICS, 100000 )
	resin.SetTakeDamageType( DAMAGE_EVENTS_ONLY )
	resin.e.isDoorBlocker = true
	resin.e.noOwnerFriendlyFire = false
	resin.e.noFriendlyFireProtection = true
	resin.e.canBurn = true
	resin.SetTouchTriggers( true )
	resin.SetMaxHealth( health )
	resin.SetHealth( health )
	resin.SetPhysics( MOVETYPE_NONE )
	resin.SetScriptName( RESIN_SHARD_SCRIPT_NAME )
	resin.SetDamageNotifications( true )
	resin.kv.contents = contents
	AddToScriptManagedEntArray( file.resinScriptManagedArray, resin )
	resin.Solid()
	resin.AllowMantle()
	resin.SetForceVisibleInPhaseShift( true )
	if( team > TEAM_INVALID )
	{
		SetTeam( resin, team )
		if( team in file.resinTeamArray )
		{
			file.resinTeamArray[ team ].append( resin )
		}
		else
		{
			file.resinTeamArray[ team ] <- [ resin ]
		}
	}

	//if( createUI )
	//	SetTargetName( resin, RESIN_SHARD_SCRIPT_NAME )

	PlayerObjects_CommonInit( owner, resin, false, highlight ? "sp_friendly_hero" : "", false, false, false )

	//AddEntityCallback_OnPostDamaged( resin, OnResinDamaged )
	//EmitSoundOnEntity( resin, RESIN_HARDEN_3P_SOUND )

	resin.e.trapSetTeamFunc = Resin_SetTeam

	return resin
}

entity function CreateFerroProp( asset model, vector ornull origin = null, vector ornull angles = null, int solidType = 0, float fadeDist = -1, bool dispatchSpawn = true )
{
	entity prop_script = CreateEntity( "prop_ferro_prop" )
	prop_script.SetValueForModelKey( model )
	prop_script.kv.fadedist = fadeDist
	prop_script.kv.renderamt = 255
	prop_script.kv.rendercolor = "255 255 255"
	prop_script.kv.solid = solidType // 0 = no collision, 2 = bounding box, 6 = use vPhysics, 8 = hitboxes only
	if ( origin )
	{
		// hack: Setting origin twice. SetOrigin needs to happen before DispatchSpawn, otherwise the prop may not touch triggers
		prop_script.SetOrigin( expect vector( origin ) )
		if ( angles )
			prop_script.SetAngles( expect vector( angles ) )
	}

	if ( dispatchSpawn )
		DispatchSpawn( prop_script )

	if ( origin )
	{
		// hack: Setting origin twice. SetOrigin needs to happen after DispatchSpawn, otherwise origin is snapped to nearest whole unit
		prop_script.SetOrigin( expect vector( origin ) )
		if ( angles )
			prop_script.SetAngles( expect vector( angles ) )
	}

	prop_script.SetFadeDistance( fadeDist )

	return prop_script
}


