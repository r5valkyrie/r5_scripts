// -----

bool function CheckFRSettingsBroadcastDebounce( int SCBType )
{
	if( !( SCBType in file.lastFRSettingsBroadcastTimes ) )
	{
		file.lastFRSettingsBroadcastTimes[ SCBType ] <- 0
		return true
	}

	return( Time() - file.lastFRSettingsBroadcastTimes[ SCBType ] >= SCB_MININTERVAL )
}
                               

bool function FiringRange_IsCharacterSwitchingEnabled()
{
	return file.characterSwitchingEnabled
}

void function FiringRange_CharacterMenuOpened()
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		entity player = GetLocalClientPlayer()

		if( PlayerHasPassive( player, ePassives.PAS_VALK ) )
		{
			Remote_ServerCallFunction( "ClientToServer_FiringRange_StopValkPassive" )
		}
		if( PlayerHasPassive( player, ePassives.PAS_CRYPTO ) )
		{
			Remote_ServerCallFunction( "ClientToServer_FiringRange_MenuIsOn" )
		}
	}

}

void function FiringRange_CharacterMenuClosed()
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		entity player = GetLocalClientPlayer()

		if ( PlayerHasPassive( player, ePassives.PAS_CRYPTO ) )
		{
			Remote_ServerCallFunction( "ClientToServer_FiringRange_MenuIsOff" )
		}
	}
}


void function FiringRange_ResolutionChanged()
{
	SCB_FiringRange_EnableCharacterChange( file.characterSwitchingEnabled )
}

void function SCB_FiringRange_EnableCharacterChange( bool enable )
{
	file.characterSwitchingEnabled = enable
	if ( !enable )
		CloseCharacterSelectMenu()
	RunUIScript( "EnableCharacterChangeInFiringRange", enable )
}

void function SCB_FiringRange_SetPlayerInFinale( bool inFinale )
{
	file.inFinale = true
	SCB_FiringRange_EnableCharacterChange ( false )
}

bool function FiringRange_IsPlayerInFinale()
{
	return file.inFinale
}

                    
void function SCB_Restore_UpgradeCore_Rui()
{
	entity viewPlayer = GetLocalViewPlayer()

	                    
		if( UpgradeCore_IsEnabled() && UpgradeCore_ShowHudUpgradeSelection() )
		{
			thread UpgradeCore_RuiThread( viewPlayer )
		}
                           
}
                          

#endif // CLIENT

#if SERVER
void function UCB_SV_FRSetting_FriendlyFire( entity player, bool value, bool indicateChange )
{
	if ( !FiringRangeHasFriendlyFire() )
	{
		Warning( "%s() - Ignoring command from player '%s' because friendly-fire toggling is not enabled.", FUNC_NAME(), string( player ) )
		return
	}

	int team                  = player.GetTeam()
	array< entity > teamPlayers = ReadyPVarPlayers_Get_ByPlayer( player )

	bool canHurtTeammates = value
	if ( teamPlayers.len() == 1 )
	{
		canHurtTeammates = false
	}

	printf( "%s() - player '%s' setting canHurtTeammates: %s", FUNC_NAME(), string( player ), string( canHurtTeammates ) )
	SetTeamIsRabid( team, canHurtTeammates )

	string ffSound = value ? "HUD_center_announcement_warning_1P" : "HUD_center_announcement_calm_1P"

	foreach( entity teamPlayer in teamPlayers )
	{
		if( IsValid( teamPlayer ) )
		{
			                         
				FRS_NetVar_Set_Bool( teamPlayer, eFRSettingType.FRIENDLYFIRE, canHurtTeammates )
				if( indicateChange )
					EmitSoundAtPositionOnlyToPlayer( teamPlayer.GetTeam(), teamPlayer.GetOrigin(), teamPlayer, ffSound )
                                  
			if( indicateChange )
				Remote_CallFunction_NonReplay( teamPlayer, "SCB_Broadcast_FRSetting_FriendlyFire_Change", player )
		}
	}
}

void function UCB_SV_FRSetting_FriendlyFire_Toggle( entity player )
{
	if ( !FiringRangeHasFriendlyFire() )
	{
		Warning( "%s() - Ignoring command from player '%s' because friendly-fire toggling is not enabled.", FUNC_NAME(), string( player ) )
		return
	}

	int team = player.GetTeam()
	array<entity> teamPlayers = GetPlayerArrayOfTeam( player.GetTeam() )
	if ( teamPlayers.len() <= 1 )
	{
		Warning( "%s() - Ignoring command from player '%s' because team population is only [%d].", FUNC_NAME(), string( player ), teamPlayers.len() )
		return
	}

	bool canHurtTeammates = !IsTeamRabid( team )
	printf( "%s() - player '%s' setting canHurtTeammates: %s", FUNC_NAME(), string( player ), string( canHurtTeammates ) )
	SetTeamIsRabid( team, canHurtTeammates )

	foreach( entity teamPlayer in teamPlayers )
	{
		if( IsValid( teamPlayer ) )
		{
			                         
				FRS_NetVar_Set_Bool( teamPlayer, eFRSettingType.FRIENDLYFIRE, canHurtTeammates )
                                  
			Remote_CallFunction_NonReplay( teamPlayer, "SCB_Broadcast_FRSetting_FriendlyFire_Change", player )
		}
	}
}

void function UCB_SV_FRSetting_DummieHelmetMatchShields( entity player, bool value, bool indicateChange )
{
	if( !IsValid( player ) )
		return

	int realm = GetCombatRangeRealm( player )
	int team                  = player.GetTeam()
	array< entity > teamPlayers = ReadyPVarPlayers_Get_ByPlayer( player )
	foreach( entity teamPlayer in teamPlayers )
	{
		if( IsValid( teamPlayer ) )
		{
			FRS_NetVar_Set_Bool( teamPlayer, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS, value )
			if( indicateChange )
				Remote_CallFunction_NonReplay( teamPlayer, "SCB_Broadcast_FRSetting_Changed_Bool", player, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS, value )
		}
	}
	FRS_PVar_Set_Bool( player, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS, value )
	FRSetting_DummieHelmetMatchShields_Set( realm, value )
	thread Dummies_DelayedReset_Thread( realm, true )
}

                   
void function UCB_SV_FRsetting_DynamicDummiesOn_Changed( entity player, bool value, bool indicateChange )
{
	if( !IsValid( player ) )
		return

	int team                  = player.GetTeam()
	array< entity > teamPlayers = ReadyPVarPlayers_Get_ByPlayer( player )
	foreach( entity teamPlayer in teamPlayers )
	{
		if( IsValid( teamPlayer ) )
		{
			FRS_NetVar_Set_Bool( teamPlayer, eFRSettingType.DYNAMICDUMMIESON, value )
			if( indicateChange )
				Remote_CallFunction_NonReplay( teamPlayer, "SCB_Broadcast_FRSetting_Changed_Bool", player, eFRSettingType.DYNAMICDUMMIESON, value )
		}
