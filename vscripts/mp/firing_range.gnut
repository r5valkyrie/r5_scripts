void function OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	// [ R5DEV-489904 ] Close Character Select if player dies.
	Remote_CallFunction_NonReplay( victim, "SCB_CloseCharacterSelectMenu" )

	#if DEVELOPER
	Debug_PlayerWeapons( victim )
	#endif
	ResetPlayerInventory( victim )
	victim.FreezeControlsOnServer()

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	PIN_CustomizeRangeSettings_ForPlayerKilled( victim, damageInfo, damageSourceId, victim.GetOrigin() )

	if( damageSourceId == eDamageSourceId.damagedef_unknown || damageSourceId == eDamageSourceId.outOfBounds || damageSourceId == eDamageSourceId.fall) //if any of these cases occur, put the player at the top of the hill
		return

	if( damageSourceId == eDamageSourceId.human_execution )
	{
		if( IsValid( attacker ) )
		{
			thread PlayKillQuipThread( victim, ToEHI( attacker ), null, 2.0 )
		}
	}

	EncodedEHandle victimHandle = EHIToEncodedEHandle( victim )

	//since gold ko shields were removed, allowing respawns at player death location in firing range
	if( !( victimHandle in file.playerRespawnData) )
	{
		PlayerDeathLocData pdld

		pdld.respawnPos = NavMesh_GetClosestPoint( victim.GetOriginOutOfTraversal())

		// If killed by dummie, put the player at the starting area. They should have a starting area saved from OnSpawned.
		if( attacker.IsNPC() && ( victimHandle in file.playerStartSpawnData ))
		{
			#if DEVELOPER
				printt( victim.GetPlayerName() + " was killed by an NPC. Dummie!" )
			#endif

			pdld.respawnPos 	= file.playerStartSpawnData[ victimHandle ].respawnPos
			pdld.respawnAngles 	= file.playerStartSpawnData[ victimHandle ].respawnAngles
		}
		else if( victim.IsMantling() )
		{
			pdld.respawnPos = victim.GetMantlingEndPosition()

			#if DEVELOPER
				if ( DEBUG_MANTLING )
				{
					printt( format( "%s(): Mantling detected", FUNC_NAME() ) )
					DebugDrawSphere( pdld.respawnPos, 48, 255, 0, 0, true, 60 )
				}
			#endif
		}
		else if(  damageSourceId == eDamageSourceId.human_execution )
		{
			#if ASSERTS
				string errMsg = format( "ERROR in %s(): player %s not in file.executionStartVictimOrigins", FUNC_NAME(), victim.GetPlayerName() )
				Assert( victim in file.executionStartVictimOrigins, errMsg )
			#endif
			pdld.respawnPos = file.executionStartVictimOrigins[ victim ]
		}
		else if (( damageSourceId == eDamageSourceId.crushed ) || ( damageSourceId == eDamageSourceId.damagedef_crush ))
		{
			pdld.respawnPos = victim.GetOrigin()
		}

		vector ornull testSafeSpot = CanPutPlayerInSafeSpot( victim, null, null, true, true, pdld.respawnPos, pdld.respawnPos )
		if( testSafeSpot != null )
		{
			expect vector( testSafeSpot )
			pdld.respawnPos = testSafeSpot
		}
		pdld.respawnPos = NavMesh_GetClosestPoint( pdld.respawnPos )

		#if DEVELOPER
			if( DEBUG_RESPAWNING )
			{
				DebugDrawSphere( pdld.respawnPos, 40, 255, 0, 0, true, 30 )
			}
		#endif

		pdld.respawnAngles = victim.GetAngles()
		file.playerRespawnData[ victimHandle ] <- pdld
	}
}

void function OnPlayerBleedoutChanged( entity player, int newState )
{
	if( newState > BS_NOT_BLEEDING_OUT )
	{
		Remote_CallFunction_NonReplay( player, "SCB_CloseCharacterSelectMenu" )
	}
}

void function PIN_CustomizeRangeSettings_ForPlayerKilled( entity player, var damageInfo, int damageSourceId, vector deathLocation )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	entity weapon = DamageInfo_GetWeapon( damageInfo )

	int contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYNONPLAYER
	string attackerName = ""
	if( IsValid( attacker ) )
	{
		if( attacker.IsPlayer() )
		{
			attackerName = attacker.GetPlayerName()

			if( damageSourceId == eDamageSourceId.human_execution )
			{
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYPLAYEREXECUTION
			}
			else
			{
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYPLAYER
			}
		}
		else
		{
			attackerName = attacker.GetScriptName()
		}
	}
	else
	{
		switch( damageSourceId )
		{
			case eDamageSourceId.crushed:
			case eDamageSourceId.damagedef_crush:
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYCRUSH
				break
			case eDamageSourceId.outOfBounds:
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYOOB
				break
			case eDamageSourceId.fall:
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYFALL
				break
			default:
				contextID = eFiringRangeSettingsPINRecordContext.PLAYERDEATHBYUNKNOWN
				break
		}
	}

	string weaponName = ""
	if( IsValid( weapon ) )
	{
		weaponName = weapon.GetWeaponClassName()
	}

	PIN_Record_CustomizeRangeSettings( attacker, contextID, attackerName, weaponName, deathLocation )
}

void function FiringRange_CleanUpPlayerPermanents( entity player )
{
	if ( player.IsPhaseShifted() )
		CancelPhaseShift( player )

	DoCleanupPlayerPermanents( player )

	if ( player in s_permDeployablesPerPlayer )
	{
		array<entity> perms = s_permDeployablesPerPlayer[player]
		foreach( perm in perms )
		{
			if ( IsValid( perm ) )
			{
				perm.Destroy()
			}
		}
		s_permDeployablesPerPlayer[player].clear()
	}
}

                         
