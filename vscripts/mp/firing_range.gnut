// ----- Customize Range Menu State Tracking Functions

void function UCB_CustomizeRangeMenu_TrackState( entity player, bool isOn )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	if( !( player in file.customizeRangeMenuIsOpen ) )
		return

	#if DEVELOPER
		printt( format( "Customize Range Menu ON State for %s set to %s", player.GetPlayerName(), string( isOn ) ) )
	#endif

	file.customizeRangeMenuIsOpen[ player ] <- isOn
}

void function CustomizeRangeMenu_StateTracking_Add( entity player, bool isOn = false )
{
	file.customizeRangeMenuIsOpen[ player ] <- false
}

void function CustomizeRangeMenu_StateTracking_Remove( entity player )
{
	if( player in file.customizeRangeMenuIsOpen )
	{
		delete( file.customizeRangeMenuIsOpen[player] )
	}
}

bool function CustomizeRangeMenu_IsOpen( entity player )
{
	if( !( player in file.customizeRangeMenuIsOpen ) )
		return false

	// Uncomment to debug.
	//#if DEVELOPER
	//	printt( format( "%s(): Customize Range Menu State Open == %s", FUNC_NAME(), string( file.customizeRangeMenuIsOpen[ player ] )) )
	//#endif

	return( file.customizeRangeMenuIsOpen[ player ] )
}

// ----- Execution Special Handling

void function ExecutionWatch_Thread( entity player )
{
	player.Signal( "FRExecutionWatch" )
	player.EndSignal( "OnDestroy", "FRExecutionWatch" )

	while( true )
	{
		// Save the victim player's origin at the START of the execution, to be used for respawning after death.
		player.WaitSignal( "OnSyncedMeleeVictim" )
		file.executionStartVictimOrigins[ player ] <- player.GetOrigin()
	}
}


