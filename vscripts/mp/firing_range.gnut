bool function ClientCommand_ToggleFriendlyFire( entity player, array<string> args )
{
	toggledFriendlyFire = !toggledFriendlyFire
	SetTeamIsRabid( player.GetTeam(), toggledFriendlyFire )
	foreach( targetPlayer in GetPlayerArray() )
		Remote_CallFunction_NonReplay( targetPlayer, "SCB_BroadcastFriendlyFireChange", player )

	return true
}

void function SpawnDummy(vector origin, vector angles)
{
    entity npc = CreateEntity( "npc_dummie" )
    SetSpawnOption_AISettings( npc, "npc_training_dummy" )
    npc.SetOrigin( origin )
    npc.SetAngles( angles )
	npc.kv.spawnflags = (SF_NPC_ALLOW_SPAWN_SOLID | SF_NPC_NO_PLAYER_PUSHAWAY)
	DispatchSpawn( npc )
	npc.SetTitle( "" )
	npc.SetShieldHealthMax( 100 )
	npc.SetShieldHealth( 100 )
	npc.SetMaxHealth( 100 )
	npc.SetHealth( 100 )
	npc.SetTakeDamageType( DAMAGE_YES )
	npc.SetDamageNotifications( true )
	npc.SetDeathNotifications( true )
	npc.SetValidHealthBarTarget( true )
	SetObjectCanBeMeleed( npc, true )
	npc.SetSkin(1)
	npc.SetScriptName( "npc_dummie" )
	npc.DisableHibernation()
	npc.GiveWeapon( "mp_weapon_rspn101", WEAPON_INVENTORY_SLOT_PRIMARY_0, [] )
	npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )
    SetTeam(npc, 99)
	thread DummieFX_Spawn_Thread( npc )

	thread OnDummyKilled(npc)
}

void function OnDummyKilled(entity dummy)
{
	//printt("Flowstate DEBUG - Dummy killed, spawning it.")
	vector pos = dummy.GetOrigin()
	vector angles = dummy.GetAngles()
	dummy.WaitSignal( "OnDeath" )
	wait 2
	//StartParticleEffectInWorld( GetParticleSystemIndex( FIRINGRANGE_ITEM_RESPAWN_PARTICLE ), pos, angles )
	thread SpawnDummy( pos, angles)
}

void function DummieFX_Spawn_Thread( entity dummie, bool doSpawnFX = true  )
{
	EndSignal( dummie, "OnDestroy" )

	if( IsValid( dummie ) )
	{
		dummie.Highlight_Enable()
		vector dummiePos = dummie.GetOrigin()

		if( doSpawnFX )
		{
			//StartParticleEffectInWorld( GetParticleSystemIndex( DUMMIE_FX_SPAWN ), dummiePos, <0, 1, 0> )
			//PlayImpactFXTable( dummiePos, dummie, DUMMIE_FX_SPAWN ) //this is a particle system refernce, we can add impact table if we want terrain reaction/splash etc

			EmitSoundOnEntity( dummie, DUMMIE_SOUND_SPAWN )
		}
	}
}

