		if( notify )
			Remote_CallFunction_NonReplay( pl, "SCB_Broadcast_FRSetting_Changed_Bool", player, settingType, value )
	}

	int realm = GetFiringRangeRealm( player )
	FRBoolSetting_Set( realm, settingType, value )
}

