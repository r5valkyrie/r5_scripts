void function FRSetting_SetOnAllPlayers_Int( entity player, int settingType, int value, bool notify = false )
{
	if( !IsValid( player ) || !player.IsPlayer() )
		return

	array< entity > playersInRealm = GetAllPlayersInRealm_ByPlayer( player )
	foreach( pl in playersInRealm )
	{
		// [ R5DEV-442189 ] Safeguard
		if( !IsValid( pl ) )
			continue

		FRSetting_SetOnPlayer_Int( pl, settingType, value )
		if( notify )
			Remote_CallFunction_NonReplay( pl, "SCB_Broadcast_FRSetting_Changed_Int", player, settingType, value )
	}

	int realm = GetFiringRangeRealm( player )
	FRIntSetting_Set( realm, settingType, value )

	switch( settingType )
	{
		case eFRSettingType.TARGETSPEED:
			FRSetting_TargetSpeed_Set( realm, value )
			break
		case eFRSettingType.FRDUMMIESHIELDLVL:
			break
		case eFRSettingType.FRDUMMIESPEED:
			FRSetting_DummieSpeed_Set( realm, value )
			break
		case eFRSettingType.FRDUMMIEMOVEMENT:
			FRSetting_DummieMovement_Set( realm, value )
			break
		case eFRSettingType.FRDUMMIESTANCE:
			FRSetting_DummieStance_Set( realm, value )
			break

		case eFRSettingType.FRDUMMIESHOOTING:
			FRSetting_DummieShooting_Set( realm, value )
			break

		default:
			break
	}
}

