void function PIN_Record_CustomizeRangeSettings_ForMenuClose( entity player )
{
	PIN_Record_CustomizeRangeSettings( player, eFiringRangeSettingsPINRecordContext.MENUCLOSE, "", "", player.GetOrigin() )
}

void function PIN_Record_CustomizeRangeSettings( entity player, int contextID, string attackerName = "", string weaponRef = "", vector location = < 0, 0, 0 > )
{
	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	int team = player.GetTeam()

	bool dynStatsOn 	= FRS_NetVar_Get_Bool( player, eFRSettingType.SHOWDYNSTATS )
	bool dynTimerOn 	= FRS_NetVar_Get_Bool( player, eFRSettingType.SHOWDYNTIMER )
	bool infReloadsOn 	= FRS_NetVar_Get_Bool( player, eFRSettingType.INFINITEMAGS )
	bool hitMarksOn		= FRS_NetVar_Get_Bool( player, eFRSettingType.SHOWHITMARKS )
	bool show3rdPerson	= FRS_NetVar_Get_Bool( player, eFRSettingType.SHOW3RDPERSON )
	                    
		bool legendUpgradesEnabled = FRS_NetVar_Get_Bool( player, eFRSettingType.LEGENDUPGRADESENABLED )
                           

	bool friendlyFireOn	= IsTeamRabid( team )

	int targetSpeed		= FRS_NetVar_Get_Int( player, eFRSettingType.TARGETSPEED )

	int dummieShields	= FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIESHIELDLVL )
	int dummieMovement	= FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIEMOVEMENT )
	int dummieStances	= FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIESTANCE )
	int dummieSpeed		= FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIESPEED )

                    
		int dummieShoot		= FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIESHOOTING )
		int dummieSpawnDist = FRS_NetVar_Get_Int( player, eFRSettingType.FRDUMMIESPAWNDISTS )
		bool dynamicSpawnsOn = FRS_NetVar_Get_Bool( player, eFRSettingType.DYNAMICDUMMIESON )
		bool dummieHighlightsOn = FRS_NetVar_Get_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON )
      
                       
                          
                           
                              
       

	PIN_FiringRange_Settings( 	player, contextID, dynStatsOn, dynTimerOn, infReloadsOn, hitMarksOn, show3rdPerson, legendUpgradesEnabled, friendlyFireOn, targetSpeed,
								dummieShields, dummieMovement, dummieStances,dummieSpeed, dummieShoot, dummieSpawnDist,
								dynamicSpawnsOn, dummieHighlightsOn, attackerName, weaponRef, location )
}

void function PIN_CCB_Record_DynamicStats_TimeBetweenResets( entity player, int timeDelta )
{
	PIN_FiringRange_DynamicStats_TimeBetweenResets( player, timeDelta )
}

