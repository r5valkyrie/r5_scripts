	Dummies_Reset( realm, spawnInPlace )
}

                   
void function Handle_DummieShooting_Setting( entity player, int setting )
{
	if ( setting == eDummie_Selector_Shooting.FULLCOMBAT )
	{
		FullCombatDummies_Start_ByPlayer( player )
	}
	else
	{
		FullCombatDummies_Stop_ByPlayer( player )
	}
}
                         

