// ----- Unified function for all UCB_SV_<INT SETTING>_Change functions.
void function UCB_SV_FRSetting_Change_Int( entity player, int settingType, int value )
{
	if ( !IsValid( player ) )
		return

	if ( !player.IsPlayer() )
		return

	if ( FRC_IsChallengeActive( player.GetRealms()[0] ) ) //Prevent toggling in firing range challenge
		return

	// Server crash exploit prevention: If settingType is out of range, return.
	if(( settingType < frIntSettings_NDX_Start ) || ( settingType >= frIntSettings_NDX_End ))
		return

	int realm = GetPlayerSquadRealm( player )
	int activeValue = value
	int oldValue = FRS_NetVar_Get_Int( player, settingType )
	bool isUp = oldValue < value

	int min = frIntSettings_Mins[ settingType ]
	int max = frIntSettings_Maxs[ settingType ]

	if( activeValue > max )
		activeValue = min

	if( activeValue < min  )
		activeValue = max

	// Assign all players in realm the same shared value.
	FRSetting_SetOnAllPlayers_Int( player, settingType, activeValue, true )

	// Resolve any special calls needed.
	bool spawnInPlace = true
	bool resetDummies = true

	switch( settingType )
	{
		case eFRSettingType.TARGETSPEED:
			resetDummies = false
			FRSetting_TargetSpeed_Set( realm, activeValue )
			break
		case eFRSettingType.FRDUMMIESPEED:
			FRSetting_DummieSpeed_Set( realm, activeValue )
			break
		case eFRSettingType.FRDUMMIEMOVEMENT:
			FRSetting_DummieMovement_Set( realm, activeValue )
			FRDummie_Movements_Set_FromSelection( realm, activeValue )
			break
		case eFRSettingType.FRDUMMIESTANCE:
			FRSetting_DummieStance_Set( realm, activeValue )
			FRDummie_Stances_Set_FromSelection( realm, activeValue )
			break
		case eFRSettingType.FRDUMMIESHIELDLVL:
			FRSetting_DummieShieldLvl_Set( realm, activeValue )
			break
	                   
		case eFRSettingType.FRDUMMIESHOOTING:
			FRSetting_DummieShooting_Set( realm, activeValue )
			Handle_DummieShooting_Setting( player, activeValue )

			bool isFCOn = activeValue == eDummie_Selector_Shooting.FULLCOMBAT
			if ( isFCOn )
				Remote_CallFunction_NonReplay( player, "FR_Settings_HUD_SetFCDummies_On" )
			else
				Remote_CallFunction_NonReplay( player, "FR_Settings_HUD_SetFCDummies_Off" )
			break
		case eFRSettingType.FRDUMMIESPAWNDISTS:
			spawnInPlace = false
			FRSetting_DummieSpawnDists_Set( realm, activeValue )
			break
                          
 		default:
			break
	}

	if( resetDummies )
	{
		// We have to wait a little bit to reset the Dummies so that the netvars can propagate.
		thread Dummies_DelayedReset_Thread( realm, spawnInPlace )
	}
}

