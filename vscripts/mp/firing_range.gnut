bool function FRSetting_ShouldSave_ToPVar( entity player, int settingType )
{
	if( !IsValid( player ) )
		return false

	if( !player.IsPlayer() )
		return false

	if (!frSetting_ShouldBeSaved[ settingType ])
		return false

	bool leaderOnly = frSetting_IsShared[ settingType ]
	
	if( leaderOnly )
	{
		return( RangeMaster_Check( player ) )
	}

	return true
}

void function FRSetting_SetOnPlayer_Bool( entity player, int settingType, bool isOn )
{
	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	string errorStr = format( "%s(): settingType out of range.", FUNC_NAME()  )
	Assert( (( settingType >= 0 ) && ( settingType < eFRSettingType.COUNT_ )), errorStr )

	FRS_NetVar_Set_Bool( player, settingType, isOn )
	#if DEVELOPER
		printt( format( "%s(): Friendly Fire for %s to be set == %s", FUNC_NAME(), player.GetPlayerName(), string( isOn ) ))
	#endif

	// Save Setting to Persistent Var:
	//	- If not Leader-Only.
	//	- If Leader-Only and this player is a leader.
	if( FRSetting_ShouldSave_ToPVar( player, settingType ) )
	{
		FRS_PVar_Set_Bool( player, settingType, isOn )
	}
}

void function FRSetting_SetOnPlayer_Int( entity player, int settingType, int value )
{
	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	string errorStr = format( "%s(): settingType out of range.", FUNC_NAME()  )
	Assert( (( settingType >= frIntSettings_NDX_Start ) && ( settingType < frIntSettings_NDX_End )), errorStr )

	FRS_NetVar_Set_Int( player, settingType, value )

	// Save Setting to Persistent Var:
	// 	- If is a ShouldSave setting.
	//	- If not Leader-Only, or if Leader-Only and this player is a leader.
	if( FRSetting_ShouldSave_ToPVar( player, settingType ) )
	{
		FRS_PVar_Set_Int( player, settingType, value )
	}
}

