void function Create_FiringRange_WeaponsAndLoot()
{
	CLootV2_Create_AllWeapons()
	CreateAttachmentsForRealm()
}

void function Create_VendingMachines_ForAllRealms()
{
	if( !file.vendingMachinesCreated )
	{
		array< entity > gearStationNodes = GetEntArrayByScriptName( "gear_vending" )
		foreach( _gearStationNode in gearStationNodes )
		{
			if ( IsValid( _gearStationNode ) )
			{
				VendingMachine_CreateSimple( _gearStationNode.GetOrigin(), _gearStationNode.GetAngles() )
			}
		}
		file.vendingMachinesCreated = true
	}
}

void function CLootV2_InitLootInfo()
{
	printt("CLootV2_InitLootInfo: Initializing...")
	
	// Get all weapons and group by ammo type
	array<string> weaponRefs = SURVIVAL_GetAllRefsInLootGroup("firing_range_all_weapons")
	array<LootData> weaponData = LootRefs_To_LootDatas(weaponRefs)
	
	table<string, array<LootData> > weaponDataByAmmoType
	array<string> ammoTypesUsed
	
	foreach (LootData ld in weaponData)
	{
		string ammoType = ld.ammoType
		if (!GetWeaponInfoFileKeyField_GlobalBool(ld.baseWeapon, "uses_ammo_pool"))
			ammoType = "_none"
		
		// Override bow to use sniper ammo type in firing range
		if (ld.baseWeapon == "mp_weapon_bow")
			ammoType = "sniper"
		
		if (!(ammoType in weaponDataByAmmoType))
		{
			weaponDataByAmmoType[ammoType] <- []
			ammoTypesUsed.append(ammoType)
		}
		weaponDataByAmmoType[ammoType].append(ld)
	}
	
	file.weaponDataByAmmoType = weaponDataByAmmoType
	file.ammoTypesUsed = ammoTypesUsed
	
	printt("CLootV2_InitLootInfo: Found " + ammoTypesUsed.len() + " ammo types")
}

void function CLootV2_Create_AllWeapons()
{
	foreach (string ammoType in file.ammoTypesUsed)
	{
		CLootV2_Spawn_AllWeapons_ByAmmoType(ammoType)
	}
}

void function CLootV2_Spawn_AllWeapons_ByAmmoType(string ammoType)
{
	string nodeName = "guns_" + ammoType + "_start"
	
	array<entity> startNodes = GetEntArrayByScriptName(nodeName)
	printt("CLootV2: Looking for nodes: " + nodeName + ", found: " + startNodes.len())
	
	foreach (entity startNode in startNodes)
	{
		thread CLootV2_Spawn_WeaponRowAndAmmo(ammoType, startNode)
	}
}

void function CLootV2_Spawn_WeaponRowAndAmmo(string ammoType, entity startNode)
{
	if (!IsValid(startNode))
		return

	array<LootData> lootData = file.weaponDataByAmmoType[ammoType]

	if (lootData.len() == 0)
		return

	// Get the end node
	entity endNode = startNode.GetLinkEnt()
	if (!IsValid(endNode))
	{
		printt("ERROR: No end node linked to " + startNode.GetScriptName())
		return
	}

	// Prepare parameters to spawn a row of weapons
	array<string> lootRefs
	foreach (LootData ld in lootData)
	{
		if (SURVIVAL_Loot_IsRefDisabled(ld.ref))
			continue
		if (ld.ref.find(WEAPON_SUFFIX_NONCOMBAT) > 0)
			continue
		lootRefs.append(ld.ref)
	}

	vector rowStart = startNode.GetOrigin()
	float rowWidth = Distance(endNode.GetOrigin(), startNode.GetOrigin())
	vector defaultAngles = <0, 0, -90> + startNode.GetAngles()
	vector nextItemDir = startNode.GetRightVector()

	printt("CLootV2: Spawning " + lootRefs.len() + " weapons for ammo type: " + ammoType)
	printt("  Row start: " + rowStart + ", width: " + rowWidth)

	// Spawn weapons in a row
	int spawnCount = 500
	array<entity> spawnedWeapons = _SpawnLootRow(lootRefs, spawnCount, rowStart, rowWidth, nextItemDir, defaultAngles)

	// Spawn ammo
	if (ammoType != "_none")
	{
		LootData ammoLootData = SURVIVAL_Loot_GetLootDataByRef(ammoType)
		array<entity> ammoNodes = GetEntArrayByScriptName("ammo_" + ammoType)
		
		printt("CLootV2: Found " + ammoNodes.len() + " ammo nodes for " + ammoType)
		
		foreach (entity ammoNode in ammoNodes)
		{
			vector pos = ammoNode.GetOrigin()
			vector ang = ammoNode.GetAngles()
			
			entity ammoEnt = SpawnGenericLoot(ammoType, pos, ang, ammoLootData.countPerDrop)
			ammoEnt.SetNetworkDistanceCull(false)
			ammoEnt.e.recreateLootOnPickup = true
			
			thread OnPickupGenericThread(ammoEnt, ammoType, ammoLootData.countPerDrop)
		}
	}
}

array<entity> function _SpawnLootRow(array<string> lootRefs, int spawnCount, vector rowStart, float rowWidth, vector nextItemDir, vector defaultAngles)
{
	array<entity> result
	
	int numItems = lootRefs.len()
	if (numItems == 0)
		return result
	
	float spacing = rowWidth / numItems
	
	for (int i = 0; i < numItems; i++)
	{
		vector pos = rowStart + (nextItemDir * spacing * i)
		vector ang = defaultAngles
		
		// Special angle adjustments
		if (lootRefs[i] == "mp_weapon_bow" || lootRefs[i] == "mp_weapon_throwingknife")
			ang = AnglesCompose(ang, <85, 0, 0>)
		
		entity lootEnt = SpawnGenericLoot(lootRefs[i], pos, ang, spawnCount)
		lootEnt.SetNetworkDistanceCull(false)
		lootEnt.e.recreateLootOnPickup = true
		
		thread OnPickupGenericThread(lootEnt, lootRefs[i])
		
		result.append(lootEnt)
	}
	
	return result
}

array<LootData> function LootRefs_To_LootDatas(array<string> refs)
{
	array<LootData> result
	foreach (string ref in refs)
	{
		LootData data = SURVIVAL_Loot_GetLootDataByRef(ref)
		result.append(data)
	}
	return result
}

