// CLootV4 - Attachments, Gear, Health Items
// ==================================================

void function CLootV4_InitLootInfo()
{
	printt("CLootV4_InitLootInfo: Starting...")
	
	// Get all gear from loot group
	array<string> gearRefs_Raw = SURVIVAL_GetAllRefsInLootGroup("loot_roller_contents_03")
	array<string> gearRefs_All = []
	array<string> gearRefs = []
	
	// Remove duplicates
	foreach (_ref in gearRefs_Raw)
	{
		if (gearRefs_All.contains(_ref))
			continue
		gearRefs_All.append(_ref)
	}
	
	gearRefs_All.sort()
	
	// Remove disabled items
	foreach (ref in gearRefs_All)
	{
		if (SURVIVAL_Loot_IsRefDisabled(ref))
			continue
		gearRefs.append(ref)
	}
	
	array<LootData> equipmentData_All = LootRefs_To_LootDatas(gearRefs)
	
	// Build gear lists
	foreach (item in equipmentData_All)
	{
		// Skip weapons
		if (item.lootType == eLootType.MAINWEAPON)
			continue
			
		// Skip attachments for now
		if (item.lootType == eLootType.ATTACHMENT)
			continue
			
		if (!(item.lootType in file.gearDataByType))
			file.gearDataByType[item.lootType] <- []
		if (!(item.lootType in file.gearRefsByType))
			file.gearRefsByType[item.lootType] <- []
			
		if (!file.gearDataByType[item.lootType].contains(item))
			file.gearDataByType[item.lootType].append(item)
			
		if (!file.gearRefsByType[item.lootType].contains(item.ref))
			file.gearRefsByType[item.lootType].append(item.ref)
	}
	
	// Attachments
	array<string> allAttachRefs_Unfiltered = []
	allAttachRefs_Unfiltered.extend(SURVIVAL_GetAllRefsInLootGroup("Attachment_L1"))
	allAttachRefs_Unfiltered.extend(SURVIVAL_GetAllRefsInLootGroup("Attachment_L2"))
	allAttachRefs_Unfiltered.extend(SURVIVAL_GetAllRefsInLootGroup("Attachment_L3"))
	allAttachRefs_Unfiltered.extend(SURVIVAL_GetAllRefsInLootGroup("Attachment_L4"))
	
	// why are these missing
	allAttachRefs_Unfiltered.append("optic_sniper")
	allAttachRefs_Unfiltered.append("optic_sniper_variable")
	allAttachRefs_Unfiltered.append("optic_sniper_threat")
	
	// Remove duplicates
	array<string> allAttachRefs_Unfiltered_unique = []
	foreach (ref in allAttachRefs_Unfiltered)
	{
		if (!allAttachRefs_Unfiltered_unique.contains(ref))
			allAttachRefs_Unfiltered_unique.append(ref)
	}
	allAttachRefs_Unfiltered = allAttachRefs_Unfiltered_unique
	
	printt("CLootV4: Found " + allAttachRefs_Unfiltered.len() + " attachment refs (unfiltered)")
	
	array<string> allAttachRefs = []
	foreach (ref in allAttachRefs_Unfiltered)
	{
		if (SURVIVAL_Loot_IsRefDisabled(ref))
			continue
		allAttachRefs.append(ref)
	}
	
	printt("CLootV4: Found " + allAttachRefs.len() + " attachment refs (after disabled filter)")
	
	array<LootData> allAttaches = LootRefs_To_LootDatas(allAttachRefs)
	
	printt("CLootV4: Converted to " + allAttaches.len() + " LootData objects")
	
	// Don't sort by attachmentType (it's -1), just collect all attachments
	// The ItemRefsTableBySubType_Build function will sort them by ref name later
	file.scopes_LootData = []
	file.mags_LootData = []
	file.stocks_LootData = []
	file.barrels_LootData = []
	file.hopUps_LootData = LootRefs_To_LootDatas(SURVIVAL_GetAllRefsInLootGroup("attachments_hopups_only"))
	
	foreach (ld in allAttaches)
	{
		if (!LootIsSpawnable(ld))
			continue
			
		// Sort by ref name patterns
		if (ld.ref.find("optic_") != -1)
			file.scopes_LootData.append(ld)
		else if (ld.ref.find("_mag_") != -1)
			file.mags_LootData.append(ld)
		else if (ld.ref.find("stock_") != -1)
			file.stocks_LootData.append(ld)
		else if (ld.ref.find("barrel_") != -1 || ld.ref.find("laser_") != -1 || ld.ref.find("shotgun_bolt") != -1)
			file.barrels_LootData.append(ld)
	}
	
	printt("CLootV4_InitLootInfo: Scopes:" + file.scopes_LootData.len() + " Mags:" + file.mags_LootData.len() + " Stocks:" + file.stocks_LootData.len() + " Barrels:" + file.barrels_LootData.len())
	printt("CLootV4_InitLootInfo: Complete")
}

bool function LootIsSpawnable( LootData lootData )
{
	if ( WeaponLootRefIsLockedSet( lootData.ref ) )
		return false

	if ( lootData.ref.find( WEAPON_SUFFIX_NONCOMBAT ) > 0 ) // don't spawn pets/noncombat weapons
		return false

	if ( SURVIVAL_Loot_IsRefDisabled( lootData.ref ) )
		return false

	return true
}

void function CLootV4_Create_AllStuff()
{
	table<string, array<entity> > startNodesTable
	table<string, array<string> > lootRefsTable
	table<string, array<int> > lootCountsTable
	
	array<string> startNodeNames = [
		"cloot4_scopes_basic_start",
		"cloot4_scopes_advanced_start",
		"cloot4_scopes_sniper_start",
		"cloot4_mags_energy_start",
		"cloot4_mags_heavy_start",
		"cloot4_mags_light_start",
		"cloot4_mags_sniper_start",
		"cloot4_stocks_basic_start",
		"cloot4_stocks_sniper_start",
		"cloot4_barrels_start",
		"cloot4_lasers_start",
		"cloot4_shotgunbolts_start",
		"cloot4_hopups_start",
		"cloot4_bodyarmor_start",
		//"cloot4_evoarmor_start",
		"cloot4_helmets_start",
		"cloot4_incaps_start",
		"cloot4_ordinances_start",
		"cloot4_batts_start",
		"cloot4_health_start",
		"cloot4_specialgear_start",
		"cloot4_backpacks_start"
	]
	
	// Get all start nodes
	string missingStartNodes = ""
	foreach (_startNodeName in startNodeNames)
	{
		startNodesTable[_startNodeName] <- GetEntArrayByScriptName(_startNodeName)
		printt("CLootV4: Checking node '" + _startNodeName + "' - found " + startNodesTable[_startNodeName].len() + " nodes")
		if (startNodesTable[_startNodeName].len() == 0)
		{
			missingStartNodes = _startNodeName
			break
		}
	}
	
	if (missingStartNodes != "")
	{
		printt("CLootV4_Create_AllStuff: Missing start nodes: " + missingStartNodes + " - skipping CLootV4 spawn")
		return
	}
	
	// Build scopes refs
	table<string, array<string> > scopesRefs = ItemRefsTableBySubType_Build(file.scopes_LootData, ["optic_cq", "optic_ranged", "optic_sniper"])
	array<string> scopesRefs_cq = scopesRefs["optic_cq"]
	array<string> scopesRefs_advanced = scopesRefs["optic_ranged"]
	
	printt("CLootV4: Scopes found - CQ:" + scopesRefs_cq.len() + " Advanced:" + scopesRefs_advanced.len() + " Sniper:" + scopesRefs["optic_sniper"].len())
	
	// Move digi scope to advanced
	if (scopesRefs_cq.len() > 0)
	{
		string digiscope = scopesRefs_cq[scopesRefs_cq.len() - 1]
		scopesRefs_advanced.append(digiscope)
		scopesRefs_cq.remove(scopesRefs_cq.len() - 1)
	}
	
	lootRefsTable["cloot4_scopes_basic_start"] <- scopesRefs_cq
	lootRefsTable["cloot4_scopes_advanced_start"] <- scopesRefs_advanced
	lootRefsTable["cloot4_scopes_sniper_start"] <- scopesRefs["optic_sniper"]
	
	lootCountsTable["cloot4_scopes_basic_start"] <- CLootV4_InitLootSpawnCount(scopesRefs_cq)
	lootCountsTable["cloot4_scopes_advanced_start"] <- CLootV4_InitLootSpawnCount(scopesRefs_advanced)
	lootCountsTable["cloot4_scopes_sniper_start"] <- CLootV4_InitLootSpawnCount(scopesRefs["optic_sniper"])
	
	// Mags
	table<string, array<string> > magsRefs = ItemRefsTableBySubType_Build(file.mags_LootData, ["bullets_mag", "highcal_mag", "energy_mag", "sniper_mag"])
	printt("CLootV4: Mags found - Light:" + magsRefs["bullets_mag"].len() + " Heavy:" + magsRefs["highcal_mag"].len() + " Energy:" + magsRefs["energy_mag"].len() + " Sniper:" + magsRefs["sniper_mag"].len())
	
	lootRefsTable["cloot4_mags_energy_start"] <- magsRefs["energy_mag"]
	lootRefsTable["cloot4_mags_heavy_start"] <- magsRefs["highcal_mag"]
	lootRefsTable["cloot4_mags_light_start"] <- magsRefs["bullets_mag"]
	lootRefsTable["cloot4_mags_sniper_start"] <- magsRefs["sniper_mag"]
	
	lootCountsTable["cloot4_mags_energy_start"] <- CLootV4_InitLootSpawnCount(magsRefs["energy_mag"])
	lootCountsTable["cloot4_mags_heavy_start"] <- CLootV4_InitLootSpawnCount(magsRefs["highcal_mag"])
	lootCountsTable["cloot4_mags_light_start"] <- CLootV4_InitLootSpawnCount(magsRefs["bullets_mag"])
	lootCountsTable["cloot4_mags_sniper_start"] <- CLootV4_InitLootSpawnCount(magsRefs["sniper_mag"])
	
	// Stocks
	table<string, array<string> > stocksRefs = ItemRefsTableBySubType_Build(file.stocks_LootData, ["stock_tactical", "stock_sniper"])
	lootRefsTable["cloot4_stocks_basic_start"] <- stocksRefs["stock_tactical"]
	lootRefsTable["cloot4_stocks_sniper_start"] <- stocksRefs["stock_sniper"]
	
	lootCountsTable["cloot4_stocks_basic_start"] <- CLootV4_InitLootSpawnCount(stocksRefs["stock_tactical"])
	lootCountsTable["cloot4_stocks_sniper_start"] <- CLootV4_InitLootSpawnCount(stocksRefs["stock_sniper"])
	
	// Barrels/Lasers/Shotgun Bolts
	table<string, array<string> > gunEndRefs = ItemRefsTableBySubType_Build(file.barrels_LootData, ["barrel_stabilizer", "shotgun_bolt", "laser_sight"])
	lootRefsTable["cloot4_barrels_start"] <- gunEndRefs["barrel_stabilizer"]
	lootRefsTable["cloot4_lasers_start"] <- gunEndRefs["laser_sight"]
	lootRefsTable["cloot4_shotgunbolts_start"] <- gunEndRefs["shotgun_bolt"]
	
	lootCountsTable["cloot4_barrels_start"] <- CLootV4_InitLootSpawnCount(gunEndRefs["barrel_stabilizer"])
	lootCountsTable["cloot4_lasers_start"] <- CLootV4_InitLootSpawnCount(gunEndRefs["laser_sight"])
	lootCountsTable["cloot4_shotgunbolts_start"] <- CLootV4_InitLootSpawnCount(gunEndRefs["shotgun_bolt"])
	
	// Hopups
	lootRefsTable["cloot4_hopups_start"] <- SURVIVAL_GetAllRefsInLootGroup("attachments_hopups_only")
	lootCountsTable["cloot4_hopups_start"] <- CLootV4_InitLootSpawnCount(SURVIVAL_GetAllRefsInLootGroup("attachments_hopups_only"))
	
	// Armors - filter to only valid refs
	array<string> armorRefs_All = ["armor_pickup_lv1", "armor_pickup_lv2", "armor_pickup_lv3", "armor_pickup_lv4_all_fast"]
	array<string> evoShieldRefs_All = ["armor_pickup_lv1_evolving", "armor_pickup_lv2_evolving", "armor_pickup_lv3_evolving", "armor_pickup_lv4_all_fast", "armor_pickup_lv5_evolving"]
	
	array<string> armorRefs = []
	foreach (ref in armorRefs_All)
	{
		if (!SURVIVAL_Loot_IsRefDisabled(ref))
			armorRefs.append(ref)
	}
	
	/*array<string> evoShieldRefs = []
	foreach (ref in evoShieldRefs_All)
	{
		if (!SURVIVAL_Loot_IsRefDisabled(ref))
			evoShieldRefs.append(ref)
	}*/
	
	lootRefsTable["cloot4_bodyarmor_start"] <- armorRefs
	lootCountsTable["cloot4_bodyarmor_start"] <- CLootV4_InitLootSpawnCount(armorRefs)
	//lootRefsTable["cloot4_evoarmor_start"] <- evoShieldRefs
	//lootCountsTable["cloot4_evoarmor_start"] <- CLootV4_InitLootSpawnCount(evoShieldRefs)
	
	// Helmets
	array<string> helmetRefs = []
	if (eLootType.HELMET in file.gearDataByType)
		helmetRefs = LootDatas_To_LootRefs(file.gearDataByType[eLootType.HELMET])
	if (!helmetRefs.contains("helmet_pickup_lv1"))
		helmetRefs.insert(0, "helmet_pickup_lv1")
	lootRefsTable["cloot4_helmets_start"] <- helmetRefs
	lootCountsTable["cloot4_helmets_start"] <- CLootV4_InitLootSpawnCount(helmetRefs)
	
	// Knockdown shields
	array<string> incapShieldRefs = []
	if (eLootType.INCAPSHIELD in file.gearDataByType)
		incapShieldRefs = LootDatas_To_LootRefs(file.gearDataByType[eLootType.INCAPSHIELD])
	if (!incapShieldRefs.contains("incapshield_pickup_lv1"))
		incapShieldRefs.insert(0, "incapshield_pickup_lv1")
	lootRefsTable["cloot4_incaps_start"] <- incapShieldRefs
	lootCountsTable["cloot4_incaps_start"] <- CLootV4_InitLootSpawnCount(incapShieldRefs)
	
	// Ordinances
	lootRefsTable["cloot4_ordinances_start"] <- SURVIVAL_GetAllRefsInLootGroup("ordnance_drops")
	lootCountsTable["cloot4_ordinances_start"] <- CLootV4_InitLootSpawnCount(SURVIVAL_GetAllRefsInLootGroup("ordnance_drops"))
	
	// Batteries
	lootRefsTable["cloot4_batts_start"] <- ["health_pickup_combo_full", "health_pickup_combo_large", "health_pickup_combo_small", "health_pickup_combo_small"]
	lootCountsTable["cloot4_batts_start"] <- [1, 1, 1, 1]
	
	// Health
	lootRefsTable["cloot4_health_start"] <- ["health_pickup_health_large", "health_pickup_health_small", "health_pickup_health_small"]
	lootCountsTable["cloot4_health_start"] <- [1, 2, 2]
	
	// Special Gear
	array<string> gadgetRefs = []
	if (eLootType.SURVIVAL in file.gearDataByType)
		gadgetRefs = LootDatas_To_LootRefs(file.gearDataByType[eLootType.SURVIVAL])
	
	// Add beacons cuz we are pepega
	if (!gadgetRefs.contains("mp_ability_mobile_respawn_beacon"))
		gadgetRefs.append("mp_ability_mobile_respawn_beacon")
	
	lootRefsTable["cloot4_specialgear_start"] <- gadgetRefs
	lootCountsTable["cloot4_specialgear_start"] <- CLootV4_InitLootSpawnCount(gadgetRefs)
	
	// Backpacks
	array<string> backpackRefs = []
	if (eLootType.BACKPACK in file.gearDataByType)
		backpackRefs = LootDatas_To_LootRefs(file.gearDataByType[eLootType.BACKPACK])
	if (!backpackRefs.contains("backpack_pickup_lv1"))
		backpackRefs.insert(0, "backpack_pickup_lv1")
	lootRefsTable["cloot4_backpacks_start"] <- backpackRefs
	lootCountsTable["cloot4_backpacks_start"] <- CLootV4_InitLootSpawnCount(backpackRefs)
	
	// Spawn all the stuff
	foreach (category in startNodeNames)
	{
		CLootV4_Spawn_LootRows_For_ArrayOfStartNodes(startNodesTable[category], lootRefsTable[category], lootCountsTable[category])
	}
	
	printt("CLootV4_Create_AllStuff: Complete")
}

array<int> function CLootV4_InitLootSpawnCount(array<string> lootRefs)
{
	array<int> results = []
	foreach (_lref in lootRefs)
	{
		results.append(1)
	}
	return results
}

void function CLootV4_Spawn_LootRows_For_ArrayOfStartNodes(array<entity> allStartNodes, array<string> lootRefs, array<int> lootCountsParm)
{
	foreach (startNode in allStartNodes)
	{
		entity endNode = startNode.GetLinkEnt()
		if (!IsValid(endNode))
		{
			printt("CLootV4_Spawn: Missing end node for " + startNode.GetScriptName())
			continue
		}
		
		array<int> lootCounts = []
		if (lootCountsParm.len() > 0)
		{
			lootCounts = lootCountsParm
		}
		else
		{
			lootCounts = CLootV4_InitLootSpawnCount(lootRefs)
		}
		
		CLootV4_SpawnLootRow(lootRefs, lootCounts, startNode, endNode)
	}
}

void function CLootV4_SpawnLootRow(array<string> lootRefsParm, array<int> lootCounts, entity startNode, entity endNode)
{
	// Filter out empty refs
	array<string> lootRefs = []
	foreach (item in lootRefsParm)
	{
		if (item != "")
			lootRefs.append(item)
	}
	
	if (!IsValid(startNode) || !IsValid(endNode))
		return
		
	if (lootRefs.len() == 0)
		return
	
	vector rowStartEdge = startNode.GetOrigin()
	vector rowEndEdge = endNode.GetOrigin()
	float rowWidth = Distance(rowStartEdge, rowEndEdge)
	vector nextItemDir = Normalize(rowEndEdge - rowStartEdge)
	vector itemAnglesDefault = startNode.GetAngles()
	
	// Calculate spacing
	vector itemPos
	float distBtwnItems
	if (lootRefs.len() >= 2)
	{
		distBtwnItems = rowWidth / (lootRefs.len() - 1)
		itemPos = rowStartEdge
	}
	else
	{
		// Single item - spawn in middle
		distBtwnItems = rowWidth / lootRefs.len()
		itemPos = rowStartEdge + (nextItemDir * rowWidth / 2)
	}
	vector nextItemDelta = Normalize(nextItemDir) * distBtwnItems
	
	// Spawn each item
	for (int i = 0; i < lootRefs.len(); i++)
	{
		string _lootRef = lootRefs[i]
		int howMany = lootCounts[i]
		
		if (_lootRef != "")
		{
			// Use default node angles (no rotation adjustment for attachments/gear)
			vector itemAngles = itemAnglesDefault
			
			// Kral: Nodes are rotated for some reason? Gotta manually fix the sight rotation
			if (_lootRef.find("optic") != -1)
			{
				itemAngles = <0, 0, 0>
			}
			
			entity lootEnt = SpawnGenericLoot(_lootRef, itemPos, itemAngles, howMany)
			
			if (IsValid(lootEnt))
			{
				lootEnt.SetNetworkDistanceCull(false)
				lootEnt.e.recreateLootOnPickup = true
				thread OnPickupGenericThread(lootEnt, _lootRef, howMany)
			}
			
			itemPos = itemPos + nextItemDelta
		}
	}
}

table<string, array<string> > function ItemRefsTableBySubType_Build(array<LootData> items, array<string> subTypes)
{
	table<string, array<LootData> > itemsByType = ItemsTableBySubType_Build(items, subTypes)
	
	table<string, array<string> > itemRefsByType
	foreach (sType in subTypes)
	{
		itemRefsByType[sType] <- LootDatas_To_LootRefs(itemsByType[sType])
	}
	
	return itemRefsByType
}

table<string, array<LootData> > function ItemsTableBySubType_Build(array<LootData> items, array<string> subTypes)
{
	table<string, array<LootData> > itemsByType
	foreach (sType in subTypes)
	{
		itemsByType[sType] <- []
	}
	
	// Split into subgroups
	foreach (item in items)
	{
		if (!LootIsSpawnable(item))
			continue
			
		foreach (sType in subTypes)
		{
			if (item.ref.find(sType) != -1)
			{
				itemsByType[sType].append(item)
				continue
			}
		}
	}
	
	return itemsByType
}

array<string> function LootDatas_To_LootRefs(array<LootData> lootDatas)
{
	array<string> refs = []
	foreach (ld in lootDatas)
	{
		refs.append(ld.ref)
	}
	return refs
}

