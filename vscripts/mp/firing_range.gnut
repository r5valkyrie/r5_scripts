void function Dummies_Reset( int realm, bool CRDummies_InPlace = true )
{
	FR_ResidentDummies_DestroyInRealm( realm )

	                   
	if( DynDummie_Spawns_IsEnabled( realm ) )
	{
		if( CRDummies_InPlace )
		{
			CRDummies_RespawnInPlace( realm )
		}
		else
		{
			CRDummies_SpawnNew( realm )
		}
	}
                          
}

                               

const int MY_RANDOM_DUMMIE_TEAM = 97

const int MAX_PERM_DEPLOYABLES_PER_PLAYER = 4
table<entity, array<entity> > s_permDeployablesPerPlayer
table<entity, array<entity> > s_charChangeCleanupDeployablesPerPlayer
bool s_firingRangeLogicIsActive = false

void function OnPlayerConnected( entity player )
{
	file.dynDummiesAutoStarted[ player ] <- false

	s_permDeployablesPerPlayer[player] <- []
	s_charChangeCleanupDeployablesPerPlayer[player] <- []

	if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		Remote_CallFunction_NonReplay( player, "SCB_FiringRange_EnableCharacterChange", true )
		file.sessionStartTime[ player ] <- Time()

		thread ExecutionWatch_Thread( player )
	}
}

                         
// --------------------------------------
// ------------------- START: SERVER RANGEMASTER FUNCTIONS
// -------------------

// A RANGEMASTER ( RangeLeader )  is either the Team Leader or the team player whose PersistentVars were ready earliest.
entity function RangeMaster_Get_ByPlayer( entity player )
{
	if( !IsValid( player ) )
		return null

	int team = player.GetTeam()
	return( RangeMaster_Get( team ) )
}

entity function RangeMaster_Get( int team )
{
	if( !( team in file.readyPVarPlayers ))
		return null

	if( file.readyPVarPlayers[ team ].len() == 0 )
		return null

	array< entity > readiedPlayers = file.readyPVarPlayers[ team ]

	// Remove stale entries in the readied players array
	while(( readiedPlayers.len() > 0 ) && !IsValid( readiedPlayers[0] )  )
	{
		readiedPlayers.remove( 0 )
	}

	entity result

	if( readiedPlayers.len() > 0 )
	{
		result = readiedPlayers[0]

		foreach( readiedPlayer in readiedPlayers )
		{
			// readiedPlayer.IsPartyLeader() // S22 entity method, not in S3
			if( IsValid( readiedPlayer ) )
			{
				result = readiedPlayer
				break
			}
		}
	}

	return result
}

// Adds player to readied players array and returns TRUE if player is earliest connector according to the array.
bool function RangeMaster_Check( entity player )
{
	if( !IsValid( player ) || !player.IsPlayer())
		return false

	int team = player.GetTeam()

	ReadyPVarPlayers_Add( player )

	RangeMaster_Update( team )

	// Check for RangeMaster.
	return( player == RangeMaster_Get( team ) )
}

int function RangeMaster_Update( int team )
{
	// New Team? Add to table.
	if( !( team in file.rangeMasterEHIs ) )
		file.rangeMasterEHIs[ team ] <- -1

	array< entity > readiedPlayers = file.readyPVarPlayers[ team ]

	// Remove stale entries in the readied players array
	while(( readiedPlayers.len() > 0 ) && !IsValid( readiedPlayers[0] )  )
	{
		readiedPlayers.remove( 0 )
	}

	int result

	// Check the Range Master, and notify if there's a new one.
	result = eRangeMasterUpdateType.INVALID
	if( readiedPlayers.len() == 0 )
	{
		file.rangeMasterEHIs[ team ] <- -1
	}
	else
	{
		entity rangeMaster = RangeMaster_Get( team )

		if( IsValid( rangeMaster ) )
		{
			result = eRangeMasterUpdateType.SAME

			// Apply Skins based on this Range Leader.
			if ( GetCurrentPlaylistVarBool( "survival_staging_gun_skins", true ) )
			{
				thread SetWeaponSkinsByPlayer( rangeMaster )
			}

			// Check: is this the same guy as before?
			int rMasterEHI = rangeMaster.GetEncodedEHandle()
			if( rMasterEHI != file.rangeMasterEHIs[ team ] )
			{
				printt( format( "%s(): RangeMaster for team %s is now %s.", FUNC_NAME(), string( team ), rangeMaster.GetPlayerName() ) )
				RangeMaster_EHI_Set_OnAllPlayers( team, rMasterEHI )
				result = eRangeMasterUpdateType.NEW
			}
		}
		else
		{
			file.rangeMasterEHIs[ team ] <- -1
		}
	}

	RangeMaster_Code_Sync_Netvars( team )
	FriendlyFire_Validate( team )
	FiringRange_Banners_Init( team )

	return result
}

void function FriendlyFire_Validate( int team )
{
	// If there's only one player left, turn off Friendly Fire.
	array< entity > readiedPlayers = file.readyPVarPlayers[ team ]
	if( readiedPlayers.len() == 1 )
	{
		UCB_SV_FRSetting_FriendlyFire( readiedPlayers[0], false, false )
	}
}

void function RangeMaster_EHI_Set_OnAllPlayers( int team, int rMasterEHI )
{
	array< entity > teamPlayers = GetPlayerArrayOfTeam( team )
	foreach( player in teamPlayers )
	{
		if( IsValid( player ) )
		{
			player.SetPlayerNetInt( NETVAR_FR_RANGEMASTER_EHI, rMasterEHI )
			file.rangeMasterEHIs[ team ] <- rMasterEHI
			//Remote_CallFunction_NonReplay( player, "SCB_Broadcast_RangeMaster_Change" )
		}
	}
}

void function RangeMaster_Notify_AllPlayers( int team )
{
	array< entity > teamPlayers = GetPlayerArrayOfTeam( team )
	foreach( player in teamPlayers )
	{
		if ( IsValid( player ) )
		{
			RangeMaster_Notify_Player( player )
		}
	}
}

void function RangeMaster_Notify_Player( entity player )
{
	Remote_CallFunction_NonReplay( player, "SCB_Broadcast_RangeMaster_Change" )
}

void function RangeMaster_Code_Sync_Netvars( int team )
{
	foreach( player in file.readyPVarPlayers[ team ])
	{
		if( IsValid( player ) )
		{
			player.SetPlayerNetInt( NETVAR_FR_RANGEMASTER_EHI, file.rangeMasterEHIs[ team ] )
		}
		else
		{
			file.readyPVarPlayers[ team ].removebyvalue( player )
		}
	}
}

void function RangeMaster_PassToNext( entity player )
{
	if( !IsValid( player ) )
		return

	FRS_NetVar_Set_Bool( player, eFRSettingType.FRIENDLYFIRE, false )
	int team = player.GetTeam()
	ReadyPVarPlayers_Remove( player )
	int result = RangeMaster_Update( team )

	RangeMaster_Notify_AllPlayers( team )

	thread RangeMaster_New_UpdateDummieParms_Thread( team, result )
}

void function RangeMaster_New_UpdateDummieParms_Thread( int team, int rangeMasterUpdateState )
{
	wait( 0.1 ) // Give New RangeMaster notification time to show first.

	// New RangeMaster, turn off Shooting
	if( rangeMasterUpdateState == eRangeMasterUpdateType.NEW )
	{
		entity rangeMaster = RangeMaster_Get( team )
		if( IsValid( rangeMaster ) )
		{
			//thread UCB_SV_FRSetting_Change_Int( rangeMaster, eFRSettingType.FRDUMMIESHOOTING, eDummie_Selector_Shooting.OFF )

			// Set the Dynamic Dummie Shooting Setting to match what's already set.
			int realm = GetFiringRangeRealm( rangeMaster )
			int value = FRSetting_DummieShooting_Get( realm )
			UCB_SV_FRSetting_Change_Int( rangeMaster, eFRSettingType.FRDUMMIESHOOTING, value )
		}
	}
}

void function ReadyPVarPlayers_Add( entity player )
{
	if( !IsValid( player ) || !player.IsPlayer())
		return

	int team = player.GetTeam()

	// Empty readyPVarPlayers? Then this player is the first and is thus RangeMaster.
	if( !( team in file.readyPVarPlayers ))
	{
		file.readyPVarPlayers[ team ] <- []
	}

	if( !( file.readyPVarPlayers[ team ].contains( player ) ) )
	{
		file.readyPVarPlayers[ team ].append( player )
	}
}

void function ReadyPVarPlayers_Remove( entity player )
{
	// IsInvalidButMemberVarsStillValid() // S22 function, not in S3
	if( !IsValid( player ) || !player.IsPlayer() )
		return

	int team = player.GetTeam()

	// Empty readyPVarPlayers? Then this player is the first and is thus RangeMaster.
	if( !( team in file.readyPVarPlayers ))
	{
		file.readyPVarPlayers[ team ] <- []
	}

	if( file.readyPVarPlayers[ team ].contains( player ) )
		file.readyPVarPlayers[ team ].removebyvalue( player )
}

array< entity > function ReadyPVarPlayers_Get_ByPlayer( entity player )
{
	return ReadyPVarPlayers_Get( player.GetTeam() )
}

array< entity > function ReadyPVarPlayers_Get( int team )
{
	if( !( team in file.readyPVarPlayers ))
	{
		file.readyPVarPlayers[ team ] <- []
	}

	return ( file.readyPVarPlayers[ team ] )
}

// -----

void function PersistentDataReady_AddPlayer( entity player )
{
	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	if( !file.persistentDataReadiedPlayers.contains( player ) )
		file.persistentDataReadiedPlayers.append( player )
}

void function PersistentDataReady_RemovePlayer( entity player )
{
	if( file.persistentDataReadiedPlayers.contains( player ) )
		file.persistentDataReadiedPlayers.fastremovebyvalue( player )
}

bool function PersistentData_IsReady_ForPlayer( entity player )
{
	return( file.persistentDataReadiedPlayers.contains( player ) )
}

// -------------------
// ------------------- END: SERVER RANGEMASTER FUNCTIONS
// --------------------------------------
                               

                         
void function OnPlayerReadiedInRealm( entity player )
{
	if ( !IsValid (player) )
		return

	int realm = GetFiringRangeRealm ( player )
	// FR_ManageNessiesForRealm( realm ) // S22 Nessie easter egg, not in S3

	// Wait until the player's persistent data is ready.
	while( !PersistentData_IsReady_ForPlayer( player ) )
		wait( 0.1 )

	// For Tracking Menu State
	CustomizeRangeMenu_StateTracking_Add( player )

	                   
		DummieTargeting_RegisterPlayer( player )
                          

	// Init or Restore FR Settings.
	bool persistenceready = expect bool ( player.GetPersistentVar( PERSISTENCEREADY_VAR ))

	int settingType
	int team = player.GetTeam()
	int realmDirect = player.GetRealms()[0]
	string playerName = player.GetPlayerName()

	                   
	CRParticipant_Add( player )
                          

	#if DEVELOPER
		printt( FUNC_NAME() + " " + playerName + " team == " + player.GetTeam() )
		printt( FUNC_NAME() + " " + playerName + " teamMemberIndex == " + player.GetTeamMemberIndex() )
		printt( FUNC_NAME() + " " + playerName + " realm == " + realm )
		printt( FUNC_NAME() + " " + playerName + " realmDirect == " + realmDirect )
	#endif

	RealmInfoEntity_Signal( realm, "StartFRDummies" )
	if( !persistenceready )
	{
		// New user with no saved settings. Initialilze the settings by reading them from the game.

		// Personal Settings. Set to Defaults.
		FRSetting_SetOnPlayer_Bool( player, eFRSettingType.SHOWRUI, true )
		FRSetting_DynStats_Set_OnPlayer( player, FRSETTING_DEFAULT_SHOWDYNSTATS )
		FRSetting_DynTimer_Set_OnPlayer( player, FRSETTING_DEFAULT_SHOWDYNTIMER )
		FRSetting_InfiniteReloads_Set_OnPlayer( player, FRSETTING_DEFAULT_INFINITERELOADS )
		FRSetting_HitMarks_Set_OnPlayer( player, FRSETTING_DEFAULT_SHOWHITMARKS, false )
		FRSetting_3rdPerson_Set_OnPlayer( player, FRSETTING_DEFAULT_SHOW3RDPERSON, false )

		                    
			FRSetting_LegendUpgradesEnabled_Set_OnPlayer( player, FRSETTING_DEFAULT_LEGENDUPGRADESENABLED, false )
                            

		// Shared Settings.
		// --- Friendly Fire is not restore based on leader. 2 or more players need to be in the fr realm to trigger it.
		FRSetting_SetOnPlayer_Bool( player, eFRSettingType.FRIENDLYFIRE, false )

		int value
		bool boolVal

		// --- Get shared Target Speed
		value = FRSetting_TargetSpeed_Get( realm )
		FRIntSetting_TargetSpeed_Set_OnPlayer( player, value )

		// --- Get shared Dummie Shield Level
		value = FRSetting_ShieldLevel_Get( realm )
		FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESHIELDLVL, value )

		boolVal = FRSetting_DummieHelmetMatchShields_Get( realm )
		FRSetting_SetOnPlayer_Bool( player, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS, boolVal )

		// --- Get shared Dummie Speed
		value = FRSetting_DummieSpeed_Get( realm )
		FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESPEED, value )

		// --- Get shared Dummie Movement
		value = FRSetting_DummieMovement_Get( realm )
		FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIEMOVEMENT, value )

		// --- Get shared Dummie STATE
		value = FRSetting_DummieStance_Get( realm )
		FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESTANCE, value )

		                   
			value = FRSetting_DummieShooting_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESHOOTING , value )

			// --- Get shared Dummie Spawn Distances
			value = FRSetting_DummieSpawnDists_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESPAWNDISTS , value )

			// --- Dynamic Spawning
			// If there is only 1 participant and their persistent data is not initialized, set Dynamic Spawning to TRUE.
			bool dynSpawnDefault = 	frBoolSettings_Defaults[ eFRSettingType.DYNAMICDUMMIESON ]
			FRS_PVar_Set_Bool( player, eFRSettingType.DYNAMICDUMMIESON, dynSpawnDefault )
			array< entity > participants = Get_CombatRange_Participants( realm )
			if( participants.len() > 1 )
			{
				FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DYNAMICDUMMIESON, DynDummie_Spawns_IsEnabled( realm ) )
			}
			else
			{
				FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DYNAMICDUMMIESON, dynSpawnDefault )
			}

			// --- Dummie Highlights
			bool dummieHighlightsOnDefault = frBoolSettings_Defaults[ eFRSettingType.DUMMIEHIGHLIGHTSON ]
			FRS_PVar_Set_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON, dummieHighlightsOnDefault )
			FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON, dummieHighlightsOnDefault )

                           

		// Marked this player as having saved before.
		player.SetPersistentVar( PERSISTENCEREADY_VAR, true )
	}
	else // Returning user with saved settings. Read and apply settings.
	{

		bool savedSetting_Bool
		int savedSetting_Int

		// Restore Personal Settings
		savedSetting_Bool = FRS_PVar_Get_Bool( player, eFRSettingType.SHOWDYNSTATS )
		FRSetting_DynStats_Set_OnPlayer( player, savedSetting_Bool )
		FRSetting_DynTimer_Set_OnPlayer( player, false )

		savedSetting_Bool = FRS_PVar_Get_Bool( player, eFRSettingType.INFINITEMAGS )
		FRSetting_InfiniteReloads_Set_OnPlayer( player, savedSetting_Bool )

		savedSetting_Bool = FRS_PVar_Get_Bool( player, eFRSettingType.SHOWHITMARKS )
		FRSetting_HitMarks_Set_OnPlayer( player, savedSetting_Bool, false )
		savedSetting_Bool = FRS_PVar_Get_Bool( player, eFRSettingType.SHOW3RDPERSON )
		FRSetting_3rdPerson_Set_OnPlayer( player, savedSetting_Bool, false )

		                    
			// Legend Upgrade Enabled is initially based on the locked state. !Locked == Enabled.
			savedSetting_Bool = !UpgradeCore_ProgressionLocked_ForPlayer_Get( player )
			FRSetting_LegendUpgradesEnabled_Set_OnPlayer( player, savedSetting_Bool, false )
                            

		// Shared Settings
		bool playerIsRangeMaster = RangeMaster_Check( player )

		if(( playerIsRangeMaster ) || ( ReadyPVarPlayers_Get_ByPlayer( player ).len() == 1 ))
		{
			#if DEVELOPER
				printt( format( "%s(): %s is the Range Master. Applying settings from this player. ", FUNC_NAME(), player.GetPlayerName() ) )
			#endif
			// Get and apply this player's shared settings.

			int intSettingType
			// --- Target Speed
			FRSettings_Int_Propagate( player, eFRSettingType.TARGETSPEED )

			// --- Dummie Shield Levels
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIESHIELDLVL )

			// --- Dummie Helmet Match Shields
			FRSettings_Bool_Propagate( player, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS )

			// --- Dummie Speeds
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIESPEED )

			// --- Dummie Movements & Dummie States
			int movementSaved 	= FRS_PVar_Get_Int( player, eFRSettingType.FRDUMMIEMOVEMENT )
			int stateSaved		= FRS_PVar_Get_Int( player, eFRSettingType.FRDUMMIESTANCE )
			FRDummie_BehaviorData_Set_ByPlayerSelectors( player, movementSaved, stateSaved )
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIEMOVEMENT )
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIESTANCE )

		                   
			// --- Dummie Shooting
			if( !file.dynDummiesAutoStarted[ player ] )
			{
				FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESHOOTING, eDummie_Selector_Shooting.OFF )
			}
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIESHOOTING )

			// --- Dummie Spawn Distances
			FRSettings_Int_Propagate( player, eFRSettingType.FRDUMMIESPAWNDISTS )

			// --- Dynamic Spawning
			//FRSettings_Bool_Propagate( player, eFRSettingType.DYNAMICDUMMIESON )
			FRSettings_DynDummies_Propagate( player )

			// --- Dummie Highlights
			bool dummieHighlightsOnDefault = frBoolSettings_Defaults[ eFRSettingType.DUMMIEHIGHLIGHTSON ]
			FRS_PVar_Set_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON, dummieHighlightsOnDefault )
			FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON, dummieHighlightsOnDefault )
			FRSettings_DummieHighlightsOn_Propagate( player )

                           

			// Reset all the dummies after all the dummie settings are restored from the player.
			Dummies_Reset( realm )
		}
		else // NOT RangeMaster
		{
			#if DEVELOPER
				printt( format( "%s(): %s is NOT Range Master. Applying settings to this player. ", FUNC_NAME(), player.GetPlayerName() ) )
			#endif

			//// Read shared settings and set them to this player.
			//// --- Friendly Fire: Read team rabid status and set friendly fire netvar accordingly.
			//bool isRabid = IsTeamRabid( team )
			//FRS_NetVar_Set_Bool( player, eFRSettingType.FRIENDLYFIRE, isRabid )

			// Shared Int Settings
			// --- Target Speed
			savedSetting_Int = FRSetting_TargetSpeed_Get( realm )
			FRIntSetting_TargetSpeed_Set_OnPlayer( player, savedSetting_Int )

			// --- Dummie Speed
			savedSetting_Int = FRSetting_DummieSpeed_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESPEED, savedSetting_Int )

			// --- Dummie Movemenets
			savedSetting_Int = FRSetting_DummieMovement_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIEMOVEMENT, savedSetting_Int )

			// --- Dummie States
			savedSetting_Int = FRSetting_DummieStance_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESTANCE, savedSetting_Int )

			// --- Shield Levels
			savedSetting_Int = FRSetting_ShieldLevel_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESHIELDLVL, savedSetting_Int )

			savedSetting_Bool = FRSetting_DummieHelmetMatchShields_Get( realm )
			FRSetting_SetOnPlayer_Bool( player, eFRSettingType.FRDUMMIEHELMETMATCHSHIELDS, savedSetting_Bool )

		                   
			// --- Dummie Shooting
			savedSetting_Int = FRSetting_DummieShooting_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESHOOTING , savedSetting_Int )

			// --- Spawn Dists
			savedSetting_Int = FRSetting_DummieSpawnDists_Get( realm )
			FRSetting_SetOnPlayer_Int( player, eFRSettingType.FRDUMMIESPAWNDISTS , savedSetting_Int )

			// --- Dynamic Dummies On?
			savedSetting_Bool = FRSetting_DynamicDummiesOn_Get( realm )
			FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DYNAMICDUMMIESON , savedSetting_Bool )

			// --- Dummie Highlights On?
			savedSetting_Bool = FRSetting_DummieHighlightsOn_Get( realm )
			FRSetting_SetOnPlayer_Bool( player, eFRSettingType.DUMMIEHIGHLIGHTSON , savedSetting_Bool )

                           
		}
	}
	// --- Friendly Fire: Set the status based on Team rabidity.
	bool ffOn = ( ReadyPVarPlayers_Get_ByPlayer( player ).len() > 1 ) ? IsTeamRabid( team ) : false
	UCB_SV_FRSetting_FriendlyFire( player, ffOn, false )

	                   
		// [ R5DEV-480546 ] AutoStart Dynamic Spawning only once.
		if( !file.dynDummiesAutoStarted[ player ] )
		{
			file.dynDummiesAutoStarted[ player ] <- true
			if( !DynDummie_Spawns_IsEnabled( realm ) )
			{
				DynSpawns_AutoStart( player )
			}
		}
                          

	Remote_CallFunction_NonReplay( player, "FRSettings_Client_Update" )
}

void function FRSettings_Int_Propagate( entity player, int intSettingType )
{
	string errStr = format( "%s(): Int Setting Type out of range.", FUNC_NAME() )
	Assert( (( intSettingType >= frIntSettings_NDX_Start ) && ( intSettingType < frIntSettings_NDX_End )), errStr )
	
	int min = frIntSettings_Mins[ intSettingType ]
	int max = frIntSettings_Maxs[ intSettingType ]
	int default_value = frIntSettings_Defaults[ intSettingType ]
	
	int intSetting_Saved = FRS_PVar_Get_Int( player, intSettingType  )
	if(( intSetting_Saved < min ) || ( intSetting_Saved > max ))
		intSetting_Saved = default_value 
	
	switch( intSettingType )
	{
		case eFRSettingType.TARGETSPEED:
			FRIntSetting_TargetSpeed_Set_OnAllPlayers( player, intSetting_Saved )
			break
		case eFRSettingType.FRDUMMIESPEED:
			FRIntSetting_DummieSpeed_Set_OnAllPlayers( player, intSetting_Saved )
			break
		case eFRSettingType.FRDUMMIEMOVEMENT:
			FRSetting_SetOnAllPlayers_Int( player, eFRSettingType.FRDUMMIEMOVEMENT, intSetting_Saved )
			break
		case eFRSettingType.FRDUMMIESTANCE:
			FRSetting_SetOnAllPlayers_Int( player, eFRSettingType.FRDUMMIESTANCE, intSetting_Saved )
			break
		case eFRSettingType.FRDUMMIESHIELDLVL:
			FRSetting_SetOnAllPlayers_Int( player, eFRSettingType.FRDUMMIESHIELDLVL, intSetting_Saved )
			break
	                   
		case eFRSettingType.FRDUMMIESHOOTING:
			FRSetting_SetOnAllPlayers_Int( player, eFRSettingType.FRDUMMIESHOOTING, intSetting_Saved )
			break
		case eFRSettingType.FRDUMMIESPAWNDISTS :
			FRSetting_SetOnAllPlayers_Int( player, eFRSettingType.FRDUMMIESPAWNDISTS, intSetting_Saved )
			break
                          
	}
}

void function FRSettings_Bool_Propagate( entity player, int boolSettingType )
{
	string errStr = format( "%s(): Int Setting Type out of range.", FUNC_NAME() )
	Assert( (( boolSettingType >= frBoolSettings_NDX_Start ) && ( boolSettingType < frBoolSettings_NDX_End )), errStr )

	bool boolSetting_Saved = FRS_PVar_Get_Bool( player, boolSettingType  )

	if( frSetting_ShouldBeSaved[ boolSettingType ] )
	{
		FRSetting_SetOnAllPlayers_Bool( player, boolSettingType, boolSetting_Saved )
	}
	else
	{
		FRS_PVar_Set_Bool( player, boolSettingType, frBoolSettings_Defaults[ boolSettingType ]  )
		FRSetting_SetOnAllPlayers_Bool( player, boolSettingType, frBoolSettings_Defaults[ boolSettingType ] )
	}
}

void function FRSettings_DynDummies_Propagate( entity player )
{
	int boolSettingType = eFRSettingType.DYNAMICDUMMIESON

	bool boolSetting_Saved
	if( file.dynDummiesAutoStarted[ player ] )
	{
		boolSetting_Saved = FRS_NetVar_Get_Bool( player, boolSettingType )
	}
	else
	{
		boolSetting_Saved = frBoolSettings_Defaults[ boolSettingType ]
	}

	FRS_PVar_Set_Bool( player, boolSettingType, boolSetting_Saved  )
	FRSetting_SetOnAllPlayers_Bool( player, boolSettingType, boolSetting_Saved )
}

void function FRSettings_DummieHighlightsOn_Propagate( entity player )
{
	int boolSettingType = eFRSettingType.DUMMIEHIGHLIGHTSON

	bool boolSetting_Saved = FRS_NetVar_Get_Bool( player, boolSettingType )

	FRS_PVar_Set_Bool( player, boolSettingType, boolSetting_Saved  )
	FRSetting_SetOnAllPlayers_Bool( player, boolSettingType, boolSetting_Saved )
}

bool function FR_IsPartyLeaderOrEarliestConnector( entity player )
{
	bool result = player == FR_GetTeamPartyLeaderOrEarliestConnector( player )
	#if DEVELOPER
		string resultStr
		if( result  )
			printt( format( "%s(): %s is the leader", FUNC_NAME(), string( player ) ))
		else
			printt( format( "%s(): %s is NOT leader", FUNC_NAME(), string( player ) ))
	#endif
	return( result )
}

entity function FR_GetTeamPartyLeaderOrEarliestConnector( entity player )
{
	int leaderIndex = player.GetPartyLeaderClientIndex()

	// Uncomment to debug
	#if DEVELOPER
		printt( format( "%s(): %s Leader Index == %s", FUNC_NAME(), player.GetPlayerName(), string( leaderIndex ) ) )
	#endif

	array< entity > allPlayersOnTeam = GetPlayersInParty( player )
	int playerIndex
	entity result

	if( leaderIndex == -1 )
	{
		result = allPlayersOnTeam[ 0 ]
		foreach( pl in allPlayersOnTeam )
		{
			playerIndex = pl.GetPlayerIndex()

			// Uncomment to debug
			#if DEVELOPER
				printt( format( "   %s(): %s Index == %s", FUNC_NAME(), pl.GetPlayerName(), string( playerIndex ) ) )
			#endif
			if( playerIndex <= result.GetPlayerIndex() )
				result = pl
		}
	}
	else
	{
		foreach( pl in allPlayersOnTeam )
		{
			playerIndex = pl.GetPlayerIndex()
			// Uncomment to debug
			#if DEVELOPER
				printt( format( "   %s(): %s Index == %s", FUNC_NAME(), pl.GetPlayerName(), string( playerIndex ) ) )
			#endif
			if( playerIndex == leaderIndex )
				result = pl
			break
		}
	}
	// Uncomment to debug
	#if DEVELOPER
		if( IsValid( result ) )
			printt( format( "   %s(): Result == %s", FUNC_NAME(),string( result ) ) )
	#endif
	return result
}
                               

void function OnPlayerDisconnected_FR( entity player )
{
	printf( "%s() - for player: %s", FUNC_NAME(), string( player ) )

	// Remove saved start spawn entry for disconnected player.
	EncodedEHandle playerHandle = EHIToEncodedEHandle( player )
	if( playerHandle in file.playerStartSpawnData )
	{
		delete file.playerStartSpawnData[ playerHandle ]
	}

	if ( player in file.dynDummiesAutoStarted )
	{
		delete file.dynDummiesAutoStarted[ player ]
	}

	PersistentDataReady_RemovePlayer( player )

	CustomizeRangeMenu_StateTracking_Remove( player )

	player.Signal( "FRExecutionWatch" )

	if( player in file.executionStartVictimOrigins )
	{
		delete( file.executionStartVictimOrigins[ player ] )
	}

	int team = player.GetTeam()
	int realm = GetFiringRangeRealm( player )

	// PIN Session length.
	if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) && ( player in file.sessionStartTime ))
	{
		float duration = Time() - file.sessionStartTime[ player ]

		if( duration > FIRINGRANGE_MAX_SESSIONDURATION )
		{
			duration = FIRINGRANGE_MAX_SESSIONDURATION
		}

		PIN_FiringRange_SessionDuration( player, duration)
		delete( file.sessionStartTime[ player ] )
	}
	RangeMaster_PassToNext( player )

	// If last to leave, clean up all remaining dummies.
	array< entity > playersInRealm = GetAllPlayersInRealm( realm )
	bool lastToLeave = playersInRealm.len() == 0
	if( lastToLeave )
	{
		#if DEVELOPER
			printt( format( "%s was the last to leave realm %s", player.GetPlayerName(), string( realm ) ) )
		#endif

		                   
			// Shut off dynamic spawning so no new dummies are created to replaced dummies about to be deleted.
			DynDummie_Spawns_Stop( realm )
                           

		// Clear out remaining old dummies from this realm.
		RealmInfoEntity_Signal( realm, "PermanentlyDestroyFRDummyTarget" )
		array< entity > leftOverDummies = GetEntArrayByScriptName( FIRING_RANGE_DUMMIE_SCRIPT_NAME )
		leftOverDummies.extend( GetEntArrayByScriptName( FIRING_RANGE_COMBAT_DUMMIE_SCRIPT_NAME ) )
		foreach( dummie in leftOverDummies)
		{
			if( IsValid( dummie ) && ( dummie.GetRealms()[ 0 ] == realm ))
			{
				dummie.Destroy()
			}
		}
	}

	//
	DoCleanupPlayerPermanents( player )

	//
	if ( player in s_permDeployablesPerPlayer )
	{
		array<entity> perms = s_permDeployablesPerPlayer[player]
		foreach( perm in perms )
		{
			if ( IsValid( perm ) )
			{
				printf( "%s() - destroying '%s' for '%s'. [disconnect]", FUNC_NAME(), string( perm ), string( player ) )
				perm.Destroy()
			}
		}
		delete( s_permDeployablesPerPlayer[player] )
	}

	//
	if ( player in s_charChangeCleanupDeployablesPerPlayer )
		delete( s_charChangeCleanupDeployablesPerPlayer[player] )

	//

	int teamCount = GetPlayerArrayOfTeam_Connected( team ).len()
	if ( teamCount == 1 )
	{
		entity rangeMaster = RangeMaster_Get( team )
		if( IsValid( rangeMaster ) )
		{
			UCB_SV_FRSetting_FriendlyFire( rangeMaster, false, false )
		}
	}
	else if ( teamCount == 0 )
	{
		SURVIVAL_ResetAllDoorsInRealm( realm )
		// FR_CleanupNessieForRealm( realm ) // S22 Nessie easter egg, not in S3
	}
}

void function FiringRange_PrePlayerChangedCharacterSetup( entity player, ItemFlavor character )
{
	if ( !s_firingRangeLogicIsActive )
		return

	if ( player.IsPhaseShifted() )
		CancelPhaseShift( player )

	if ( player in s_charChangeCleanupDeployablesPerPlayer )
	{
		array<entity> deps = s_charChangeCleanupDeployablesPerPlayer[player]
		foreach( dep in deps )
		{
			if ( IsValid( dep ) )
			{
				printf( "%s() - destroying '%s' for '%s'. [character change]", FUNC_NAME(), string( dep ), string( player ) )
				dep.Destroy()
			}
		}
		deps.clear()
	}
}

void function CleanOutAnyInvalidEnts( array<entity> ents )
{
	array<int> deadEntries
	foreach( int index, entity ent in ents )
	{
		if ( !IsValid( ent ) )
			deadEntries.append( index )
	}

	int deadCount = deadEntries.len()
	for( int idx = 0; idx < deadCount; ++idx )
	{
		int indexToRemove = deadEntries[deadCount - 1 - idx]
		ents.remove( indexToRemove )
	}
}

void function FiringRange_AddToPermanentDeployableQuota( entity ent, entity player )
{
	if ( !s_firingRangeLogicIsActive )
		return

	Assert( !ent.IsPlayer() )

	array<entity> perms = s_permDeployablesPerPlayer[player]
	CleanOutAnyInvalidEnts( perms )
	if ( perms.len() >= MAX_PERM_DEPLOYABLES_PER_PLAYER )
	{
		entity perm = perms.remove( 0 )
		printf( "%s() - destroying '%s' for '%s'. [too many exist]", FUNC_NAME(), string( perm ), string( player ) )
		perm.Destroy()
	}

	perms.append( ent )
}

void function FiringRange_AddToRemoveOnCharacterChange( entity ent, entity player )
{
	if ( !s_firingRangeLogicIsActive )
		return

	if(!IsValid(player))
		return

	Assert( !ent.IsPlayer() )

	array<entity> deps = s_charChangeCleanupDeployablesPerPlayer[player]
	CleanOutAnyInvalidEnts( deps )
	deps.append( ent )
}

void function OnPlayerSpawned( entity player )
{
	thread function() : ( player )
	{
		if( !IsValid( player ) )
			return

		player.Signal( "FRPlayerSpawned" )
		player.EndSignal( "FRPlayerSpawned" )
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "OnDeath" )
		player.UnfreezeControlsOnServer()

		int realm = GetFiringRangeRealm( player )

		EncodedEHandle playerHandle = EHIToEncodedEHandle( player )
		if( playerHandle in file.playerRespawnData )
		{
			
			//player.ClearParent() // Fix for R5DEV-383498?

			player.SetAngles( file.playerRespawnData[playerHandle].respawnAngles )

			vector safeSpot = file.playerRespawnData[ playerHandle ].respawnPos
			vector safeSpotOnNavmesh = NavMesh_GetClosestPoint( safeSpot )

			#if DEVELOPER
				if( DEBUG_RESPAWNING )
				{
					DebugDrawSphere( safeSpotOnNavmesh, 48, 0, 0, 255, true, 30 )
				}
			#endif

			// Teleport to new location because SetOrigin() and PutPlayerInSafeSpot() don't do the job for mantles.
			// player.StartTeleport() // S22 entity method, not in S3
			WaitFrame()
			if( !IsValid( player ) )
				return

			bool success = TeleportPlayerNoInterp( player, safeSpotOnNavmesh )

			// player.EndTeleport() // S22 entity method, not in S3

			if( !success )
			{
				PutPlayerInSafeSpot( player, null, null, safeSpotOnNavmesh, safeSpotOnNavmesh )
				#if DEVELOPER
					if( DEBUG_RESPAWNING )
					{
						DebugDrawSphere( safeSpotOnNavmesh, 48, 0, 255, 0, true, 30 )
					}
				#endif
			}
		}

		// Save start position if new player.
		if( !( playerHandle in file.playerStartSpawnData ))
		{
			PlayerDeathLocData startPos 
			startPos.respawnPos = player.GetOrigin()
			startPos.respawnAngles = player.GetAngles()
			
			file.playerStartSpawnData[ playerHandle ] <- startPos
		}

		HolsterAndDisableWeapons( player )

		WaitFrame()

		DeployAndEnableWeapons( player )

                           

			// Give Armor if player doesn't have one already.
			string equipSlot = "armor"
			LootData existingArmor = EquipmentSlot_GetEquippedLootDataForSlot( player, "armor" )
			LootData existingHelmet = EquipmentSlot_GetEquippedLootDataForSlot( player, "helmet" )

			// If player has no armor and no helmet, give them basic body shield and helmet.
			if(( existingArmor.ref == "" ) && ( existingHelmet.ref == "" ) )
			{
				array<string> equipmentLoadout = ParseEquipmentLoadoutText( FR_GetArmorLoadoutString(), false, [] )
				foreach( equipment in equipmentLoadout )
				{
					if( equipment.find( "armor" ) > -1 )
					{
						Give_Appropriate_StartingArmor( player )
					}
					else
					{
						SURVIVAL_GivePlayerEquipment( player, equipment, 0, null, "", false )
					}
				}
				string itemRef = EquipmentSlot_GetLootRefForSlot( player, "armor" )
				if ( SURVIVAL_Loot_IsRefValid( itemRef ) )
				{
					LootData data = SURVIVAL_Loot_GetLootDataByRef( itemRef )
					player.SetShieldHealthMax( SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, data ) )
					player.SetShieldHealth( SURVIVAL_GetCharacterShieldHealthMaxForArmor( player, data ) )
				}
			}

			// Give Consumables if player doesn't have any already.
			if( SURVIVAL_GetPlayerInventory( player ).len() == 0 )
			{
				array<string> defaultConsumables = ParseConsumableLoadoutText( FR_GetConsumableLoadoutString(), false )
				CharacterLoadouts_GiveConsumableLoadoutToPlayer( player, defaultConsumables )
			}

			// Initialize settings if it doesn't already exist.
			FRDummie_BehaviorData_InitForPlayer( player )

			// Show the HUD overlay if it's set to show.
			Remote_CallFunction_NonReplay( player, "ServerCallback_FRSettings_Restore_RUI" )

			SURVIVAL_AutoEquipOrdnanceFromInventory( player, false )
			Remote_CallFunction_NonReplay( player, "ServerCallback_RefreshInventoryAndWeaponInfo" )
			Remote_CallFunction_NonReplay( player, "SCB_DynStats_ResetStats" )

			FRSetting_InfiniteReloads_Restore_From_NetVar( player )

			                   
				if( FullCombatDummies_IsEnabled( realm  ) )
					Dummies_Reset( realm )
                            

       
                                                               
    
                                              
                                   
    
                                 

		if( playerHandle in file.playerRespawnData )
			delete file.playerRespawnData[ playerHandle ]

		                    
			Remote_CallFunction_NonReplay( player, "SCB_Restore_UpgradeCore_Rui" )
                            
	}()
}

void function Give_Appropriate_StartingArmor( entity player )
{
	                    
		if( UpgradeCore_ArmorTiedToUpgrades())
		{
			SURVIVAL_GivePlayerEquipment( player, "armor_core_pickup_lv1", 0, null, "", false )
		}
		else
                           
	{
		SURVIVAL_GivePlayerEquipment( player, "armor_pickup_lv1", 0, null, "", false )
	}

}


