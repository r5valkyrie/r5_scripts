void function UCB_SV_FRsetting_DummieHighlightsOn_Changed( entity player, bool value, bool indicateChange )
{
	if( !IsValid( player ) )
		return

	int team                  = player.GetTeam()
	array< entity > teamPlayers = ReadyPVarPlayers_Get_ByPlayer( player )
	foreach( entity teamPlayer in teamPlayers )
	{
