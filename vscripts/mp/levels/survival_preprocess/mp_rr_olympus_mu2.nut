global function mp_rr_olympus_mu2_SurvivalPreprocess
global function RunMySurvivalPreprocess

void function RunMySurvivalPreprocess()
{
	mp_rr_olympus_mu2_SurvivalPreprocess()
}

void function mp_rr_olympus_mu2_SurvivalPreprocess()
{
	if ( Dev_CommandLineHasParm( "-survival_preprocess" ) )
		return

	//Pathfinder TT Assets
	PrecacheModel( $"mdl/test/davis_test/pathfinder_tt_ring_shield.rmdl" )

	//Lifeline TT Assets
	PrecacheModel( $"mdl/olympus/olympus_ll_tt_prop_wall_drums_01.rmdl" )
	PrecacheModel( $"mdl/olympus/olympus_ll_tt_building_interior_medbay_eye_01.rmdl" )
	PrecacheModel( $"mdl/olympus/olympus_ll_tt_building_interior_medbay_eye_02.rmdl" )
	PrecacheModel( $"mdl/fx/LifelineTT_medbay_ring.rmdl" )

	PrecacheParticleSystem( $"P_heal_loop_screen" )
	PrecacheParticleSystem( $"P_LifelineTT_medbay_platform" )
	PrecacheParticleSystem( $"P_lifelineTT_medbay_sparks" )
	PrecacheParticleSystem( $"P_LifelineTT_medbay_cross" )
	PrecacheParticleSystem( $"P_LifelineTT_medbay_cross_pulse" )

	AddZone_0()
	AddZone_1()
	AddZone_2()
	AddZone_3()
	AddZone_4()
	AddZone_5()
	AddZone_6()
	AddZone_7()
	AddZone_8()
	AddZone_9()
	AddZone_10()
	AddZone_11()
	AddZone_12()
	AddZone_13()
	AddZone_14()
	AddZone_15()
	AddZone_16()
	AddZone_17()
	AddZone_18()
	AddZone_19()
	AddZone_20()
	AddZone_21()
	AddZone_22()
	AddZone_23()
	AddZone_24()
	AddZone_25()
	AddZone_26()
	AddZone_27()
	AddZone_28()
	AddZone_29()
	AddZone_30()
	AddZone_31()
	AddZone_32()
	AddZone_33()
	AddZone_34()
	AddZone_35()
	AddZone_36()
	AddZone_37()
	AddZone_38()
	AddZone_39()
	AddZone_40()
	AddZone_41()
	AddZone_42()
	AddZone_43()
	AddZone_44()

	SURVIVAL_MarkLevelAsPreProcessed()
}

