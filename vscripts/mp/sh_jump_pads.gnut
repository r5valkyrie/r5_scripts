	//jumpPad.propScript.recentActivateCount++

/*	if ( jumpPad.propScript.recentActivateCount >= GetCurrentPlaylistVarInt( "jump_pad_debounce_count", 5 ) )
	{
		// To many recent activations, destroy the jump pad
		jumpPad.Destroy()
	}*/
