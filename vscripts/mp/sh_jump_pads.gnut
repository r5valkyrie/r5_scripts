	{
		printt( "Usage: SetGravityCannonVerticalMult <multiplier>" )
		printt( "Current: GRAVITY_CANNON_VERTICAL_MULTIPLIER = " + GRAVITY_CANNON_VERTICAL_MULTIPLIER )
		return
	}

	float mult = float( args[0] )
	GRAVITY_CANNON_VERTICAL_MULTIPLIER = mult
	printt( "GRAVITY_CANNON_VERTICAL_MULTIPLIER set to: " + mult )
}
