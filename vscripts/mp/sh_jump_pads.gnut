#if CLIENT
void function OnGravityCannonCreated( entity trigger )
{
	if ( GRAVITY_CANNON_DEBUG )
		printt( "CL OnGravityCannonCreated: trigger = " + trigger + ", scriptname = " + trigger.GetScriptName() )

	if ( trigger.GetScriptName() == "gravity_cannon" )
	{
		if ( GRAVITY_CANNON_DEBUG )
			printt( "\nCL GRAVITY CANNON CREATED: Setting client enter callback\n" )

		trigger.SetClientEnterCallback( GravityCannon_OnEnterTrigger_Client )
	}
}

void function GravityCannon_TravelSound_1p( entity player )
{
	if ( GRAVITY_CANNON_DEBUG )
		printt( "CL GRAVITY CANNON: GravityCannon_TravelSound_1p started" )

	if ( !player.IsPlayer() )
		return

	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )

	if ( GRAVITY_CANNON_DEBUG )
		printt( "CL GRAVITY CANNON: Emitting 1p sound" )

	EmitSoundOnEntity( player, "GravityCannon_Travel_1p" )

	OnThreadEnd(
		function() : ( player )
		{
			if ( IsValid( player ) )
				StopSoundOnEntity( player, "GravityCannon_Travel_1p" )
		}
	)

	WaitFrame()
	wait 0.1

	while( !player.IsOnGround() )
		WaitFrame()
}

void function GravityCannon_OnEnterTrigger_Client( entity trigger, entity ent )
{
	if ( GRAVITY_CANNON_DEBUG )
		printt( "CL GRAVITY CANNON: OnEnterTrigger_Client called, ent = " + ent + ", local = " + GetLocalViewPlayer() )

	if ( !IsValid( trigger ) )
	{
		if ( GRAVITY_CANNON_DEBUG )
			printt( "CL GRAVITY CANNON: trigger not valid" )
		return
	}

	if ( !ent.IsPlayer() )
	{
		if ( GRAVITY_CANNON_DEBUG )
			printt( "CL GRAVITY CANNON: ent is not player" )
		return
	}

	if ( ent != GetLocalViewPlayer() )
	{
		if ( GRAVITY_CANNON_DEBUG )
			printt( "CL GRAVITY CANNON: ent is not local view player" )
		return
	}

	entity launcher = trigger.GetParent()
	if ( GRAVITY_CANNON_DEBUG )
		printt( "CL GRAVITY CANNON: launcher = " + launcher )

	if ( IsValid( launcher ) && launcher.GetModelName().tolower() == GRAVITY_CANNON_MODEL.tolower() )
	{
		if ( GRAVITY_CANNON_DEBUG )
			printt( "CL GRAVITY CANNON: Starting 1p sound thread" )

		thread GravityCannon_TravelSound_1p( ent )
		Chroma_UsedJumpPad()
	}
	else if ( GRAVITY_CANNON_DEBUG )
	{
		if ( IsValid( launcher ) )
			printt( "CL GRAVITY CANNON: Launcher model mismatch: " + launcher.GetModelName() )
		else
			printt( "CL GRAVITY CANNON: Launcher not valid" )
	}
}

void function GravityCannon_OnTouchTrigger_Client( entity trigger, entity ent )
{
}
