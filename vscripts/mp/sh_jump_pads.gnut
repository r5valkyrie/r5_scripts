void function JumpPad_PlayLaunchAnim( entity jumpPad )
{
	jumpPad.Anim_Stop()
	jumpPad.EndSignal( "OnDestroy" )
	jumpPad.Signal( "ScriptAnimStop" )
	jumpPad.EndSignal( "ScriptAnimStop" )

	jumpPad.Anim_PlayOnly( "prop_octane_jump_pad_deploy_trans" )
	WaittillAnimDone( jumpPad )

	jumpPad.Anim_PlayOnly( "prop_octane_jump_pad_deploy_idle" )
}

void function RemoveDoubleJump ( entity player )
{
	Remote_CallFunction_Replay( player, "ServerCallback_HideJumpPadHint" )

	                    
		if( HasPlayerSettingMod( player, "enable_doublejump_aircontrol" ) )
		{
			TakePlayerSettingsMods( player, [ "enable_doublejump_aircontrol" ] )
			if( HasPlayerMovementEventCallback( player, ePlayerMovementEvents.DOUBLE_JUMP, PlayUpgradedDoubleJumpFx ) )
			{
				RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.DOUBLE_JUMP, PlayUpgradedDoubleJumpFx  )
			}
		}
		else
       
			TakePlayerSettingsMods( player, [ "enable_doublejump" ] )
}

                    
void function PlayUpgradedDoubleJumpFx( entity player )
{
	int vent_CenterAttachID_3P = player.LookupAttachment( "vent_Center" )
	StartParticleEffectOnEntity( player, GetParticleSystemIndex( DOUBLE_JUMP_FX ), FX_PATTACH_POINT_FOLLOW, vent_CenterAttachID_3P )
}
      

void function JumpPad_EndSoundGeneric( entity ent, string soundName )
{
	if ( !IsValid( ent ) )
		return

	ent.EndSignal( "OnDeath" )
	ent.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( ent, soundName )
		{
			if ( IsValid( ent ) )
				StopSoundOnEntity( ent, soundName )
		}
	)

	WaitFrame()

	while( IsValid( ent ) && !ent.IsOnGround() )
	{
		WaitFrame()
	}
}

void function JumpJetsWhileAirborne( entity player, entity trigger, bool gravityCannonLaunch )
{
	if ( !IsPilot( player ) )
		return

	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.Signal( "JumpPadStart" )
	player.EndSignal( "JumpPadStart" )
	player.EnableSlowMo()

	if( gravityCannonLaunch )
	{
		EmitSoundOnEntityExceptToPlayer( player, player, "GravityCannon_Travel_3p" )
	}
	else
	{
		//EmitSoundOnEntityOnlyToPlayer_PredictedByPlayer( player, player, JumpPad_GetLaunchSFX_1p( trigger ) ) // for spectators

		EmitSoundOnEntityExceptToPlayer( player, player, JumpPad_GetLaunchSFX_3p( trigger ) )
		EmitSoundOnEntityExceptToPlayer( player, player, "JumpPad_AirborneMvmt_3p" )
	}

	if ( PlayerHasPassive( player, ePassives.PAS_OCTANE ) )
	{
		PlayBattleChatterLineToSpeakerAndTeamWithDebounceTime( player, "bc_octane_jumppad_launch", 30.0, 60.0 )
	}

	array<entity> jumpJetFXs
	array<string> attachments = [ "vent_left", "vent_right" ]

	//CreateJumpJetEffects( player, jumpJetFXs, attachments )

	OnThreadEnd(
		function() : ( jumpJetFXs, player, gravityCannonLaunch )
		{
			//DestroyJumpJetEffects( jumpJetFXs )

			if ( IsValid( player ) )
			{
				player.DisableSlowMo()
				if ( gravityCannonLaunch )
					StopSoundOnEntity( player, "GravityCannon_Travel_3p" )
				else
					StopSoundOnEntity( player, "JumpPad_AirborneMvmt_3p" )
			}
		}
	)

	WaitFrame()

	wait 0.1

	while( !player.IsOnGround() )
	{
		/*if ( player.IsPhaseShifted() )
			DestroyJumpJetEffects( jumpJetFXs )
		else if ( jumpJetFXs.len() <= 0 )
			CreateJumpJetEffects( player, jumpJetFXs, attachments )*/

		WaitFrame()
	}
}

#if JUMP_PAD_USES_VORTEX_SPHERE
void function JumpPad_CreateVortexSphereEntity( entity jumpPad, entity owner )
{
	Assert( IsValid( jumpPad ) )

	entity vortexSphere = CreateEntity( "vortex_sphere" )

	vortexSphere.kv.spawnflags = SF_BLOCK_OWNER_WEAPON
	vortexSphere.kv.enabled = 0
	vortexSphere.kv.radius = JUMP_PAD_PUSH_PROJECTILE_RADIUS
	vortexSphere.kv.height = JUMP_PAD_PUSH_PROJECTILE_RADIUS
	vortexSphere.kv.bullet_fov = 360
	vortexSphere.kv.physics_pull_strength = 0//25
	vortexSphere.kv.physics_side_dampening = 0//6
	vortexSphere.kv.physics_fov = 360
	vortexSphere.kv.physics_max_mass = 0//2
	vortexSphere.kv.physics_max_size = 0//6

	vortexSphere.SetAngles( <0, 0, 0> ) // viewvec?
	vortexSphere.SetOrigin( jumpPad.GetOrigin() )
	vortexSphere.SetMaxHealth( 100 )
	vortexSphere.SetHealth( 100 )

	vortexSphere.RemoveFromAllRealms()
	vortexSphere.AddToOtherEntitysRealms( jumpPad )

	DispatchSpawn( vortexSphere )

	//HACK: Until we get a better way to do this use the vortex's target name to specify that it is a vortex trigger that
	//will run a set callback when a projectile or bullet hits it instead of preforming its normal vortex logic.
	Vortex_ConvertToVortexTriggerArea( vortexSphere )
	SetCallback_VortexSphereTriggerOnBulletHit( vortexSphere, JumpPad_OnBulletHitVortexTrigger )
	SetCallback_VortexSphereTriggerOnProjectileHit( vortexSphere, JumpPad_OnProjectileHitVortexTrigger )

	VortexFireEnable( vortexSphere )
	vortexSphere.SetInvulnerable() // make particle wall invulnerable to weapon damage. It will still drain over time
	vortexSphere.SetOwner( jumpPad )
	vortexSphere.SetParent( jumpPad, "", true, 0.0 )
	if ( IsValid( owner ) )
		AddToUltimateRealm( owner, vortexSphere )
}

void function JumpPad_OnBulletHitVortexTrigger( entity weapon, entity vortexSphere, var damageInfo )
{
}

void function JumpPad_OnProjectileHitVortexTrigger( entity weapon, entity vortexSphere, entity attacker, entity projectile, vector contactPos )
{
	entity jumpPad = vortexSphere.GetOwner()

	if ( !IsValid( jumpPad ) )
		return

	if ( !JumpPad_ShouldLaunchProjectile( projectile ) )
		return

	vector origin = jumpPad.GetOrigin()

	float timeSinceLastBounce = Time() - projectile.proj.lastVortexBounceTime
	//Don't push planted projectiles
	if ( projectile.proj.isPlanted || timeSinceLastBounce < GetCurrentPlaylistVarFloat( "jump_pad_debounce_time", 1.0 ) )
		return

	//push projectiles
	vector posToTarget = Normalize( projectile.GetOrigin() - origin )

	//printt( projectile )

	//DebugDrawLine( origin, origin + ( posToTarget * JUMP_PAD_PUSH_PROJECTILE_RADIUS ), COLOR_RED, true, 5.0 )
	//DebugDrawLine( origin, origin + ( surfaceNormal * JUMP_PAD_PUSH_PROJECTILE_RADIUS ), COLOR_GREEN, true, 5.0 )

	//printt( dot )
	//printt( accuracyScalar )

	vector velocity = projectile.GetVelocity()
	velocity.z = 0
	velocity = Normalize( velocity )
	vector pushNormal = Normalize( (<0, 0, 1.25> + velocity) )

	JumpPad_PushProjectileAway( projectile, pushNormal * JumpPad_GetPushVelocity( jumpPad.GetOwner() ) )
	EmitSoundOnEntity( projectile, JumpPad_GetLaunchSFX_3p( vortexSphere ) )
	int fxId = GetParticleSystemIndex( JUMP_PAD_LAUNCH_FX )
	StartParticleEffectOnEntity( jumpPad, fxId, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )

	projectile.proj.lastVortexBounceTime = Time()
}

bool function JumpPad_ShouldLaunchProjectile( entity projectile )
{
	string weaponClassName = projectile.ProjectileGetWeaponClassName()
	if ( weaponClassName == "mp_weapon_deployable_medic" )
		return false

	bool isGrenade = IsABaseGrenade( projectile )
	return isGrenade
}
#endif // #if JUMP_PAD_USES_VORTEX_SPHERE

bool function JumpPad_EntityTriggerFilter( entity target )
{
	if ( target.GetNetworkedClassName() == "phys_bone_follower" )
		return false

	if ( target.GetNetworkedClassName() == "prop_death_box" )
		return false

	if ( target.GetNetworkedClassName() == "prop_dynamic" )
		return false

	if( target.GetNetworkedClassName() == "prop_dynamic_lightweight" )
		return false

	if ( target.GetNetworkedClassName() == "prop_script" )
		return false

	if ( target.GetNetworkedClassName() == "func_brush" )
		return false

	if ( target.GetNetworkedClassName() == "func_brush_lightweight" )
		return false

	if ( target.GetNetworkedClassName() == "trace_volume" )
		return false

	if( target.GetNetworkedClassName() == "prop_material_harvester" )
		return false

	//if( target.IsPlayerVehicle() )
	//	return false

	                        
	if ( GetEditorClass( target ) == "control_flag_prop" )
		return false
       

	//if ( target.IsNPC() && !IsTrainingDummie( target ) )
	//	return false

	if ( IsDropship( target ) )
		return false

	//if ( IsEnvDecoy( target ) )
		//return false

	//if ( target.e.ignoreJumpPad )
		//return false

	//if (target.IsPlayer())
		//if (target.Player_IsSkywardLaunching() || target.Player_IsSkywardFollowing())
			//return false

	return true
}

void function JumpPad_PushProjectileAway( entity projectile, vector velocity )
{
	Assert ( projectile.IsProjectile() )

	//Don't push planted projectiles.
	if ( projectile.proj.isPlanted )
		return

	vector result = velocity // + projectile.GetVelocity()
	//result.z = max( 200, fabs( velocity.z ) )
	projectile.SetVelocity( result )
	//DebugDrawLine( projectile.GetOrigin(), projectile.GetOrigin() + result * 5, COLOR_RED, true, 5.0 )
}
