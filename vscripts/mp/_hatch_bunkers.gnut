#if CLIENT
string functionref( entity panel ) function CreateHatchPanelOverrideTextFunc( HatchData data )
{
	return string function( entity panel ) : ( data )
	{
		if ( data.hatchState == eHatchState.UNLOCKED )
		{
			return "#BUNKER_PANEL_UNLOCKED_HINT"
		}
		else if ( data.hatchState == eHatchState.COUNTDOWN )
		{
			int currentUnixTime  = GetUnixTimestamp()
			int timeDelta        = file.countdownTargetUnixTime - currentUnixTime
			string timeString    = GetDaysHoursMinutesSecondsString( timeDelta )
			string displayString = Localize( "#BUNKER_PANEL_COUNTDOWN_HINT", timeString )

			return displayString
		}

		return "#BUNKER_PANEL_DISABLED_HINT"
	}
}
#endif // CLIENT


#if SERVER || CLIENT
void functionref( entity panel, entity player, int useInputFlags ) function CreateHatchPanelFunc( HatchData data )
{
	return void function( entity panel, entity player, int useInputFlags ) : ( data )
	{
		thread OnHatchPanelActivate( data )

		#if SERVER
			PIN_Interact( player, "hb_open", data.doorModel.GetOrigin() )
		#endif
	}
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
void function OnHatchPanelActivate( HatchData data )
{
	#if SERVER
		data.panelModel.UnsetUsable()
		data.panelModel.SetSkin( 1 )
	#endif

	data.hatchState = eHatchState.OPEN

	#if SERVER
		// create auxillary ziplines
		foreach ( vector ziplineStartOrigin in data.specialZiplineStartOrigins )
			thread CreateHatchZipline( ziplineStartOrigin , data.panelModel)

		OpenCanyonlandsBunkerHatch( data, true )
	#endif // SERVER
}
#endif // SERVER || CLIENT


#if SERVER
void function OpenCanyonlandsBunkerHatch( HatchData data, bool createZiplines )
{
	// fx
	asset particleAsset = data.isEntranceHatch ? FX_HATCH_STEAM : FX_HATCH_STEAM_SMALL
	vector fxOffset     = data.isEntranceHatch ? < 0, 0, -128 > : < 0, 0, -64 >

	StartParticleEffectOnEntityWithPos( data.doorModel, GetParticleSystemIndex( particleAsset ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, fxOffset, < 0, 0, 0 > )

	// animate hatch open
	PlayAnim( data.doorModel, "bunker_hatch_open" )
	data.doorModel.Anim_PlayWithRefPoint( "bunker_hatch_open_idle", data.doorModel.GetOrigin(), data.doorModel.GetAngles(), 0.0 )

	// deploy zipline from hatch itself
	if ( createZiplines )
	{
		string attachment   = data.isEntranceHatch ? ZIPLINE_ATTACHMENT_ENTRANCE : ZIPLINE_ATTACHMENT_LEAVE
		int ropeAttachIndex = data.doorModel.LookupAttachment( attachment )
		vector attachOrg    = data.doorModel.GetAttachmentOrigin( ropeAttachIndex )
		thread CreateHatchZipline( attachOrg, data.doorModel )
	}
}
#endif


#if SERVER
void function CreateHatchZipline( vector startPoint, entity panelModel )
{
	vector endPos
	TraceResults tr = TraceLine( startPoint + < 0, 0, -16 >, startPoint + < 0, 0, -10000 >, null, TRACE_MASK_NPCWORLDSTATIC, TRACE_COLLISION_GROUP_NONE )
	endPos = startPoint + < 0, 0, -16 > + < 0, 0, -10000 * tr.fraction >
	float dropTime = (startPoint.z - endPos.z) / ZIPLINE_FALL_SPEED
	thread DeployZipline( dropTime, startPoint, endPos + < 0, 0, 64 >, false, <0,0,0> )
	EmitSoundAtPosition( TEAM_ANY, startPoint, ZIPLINE_DEPLOY_SFX, panelModel )
}
#endif // SERVER


#if SERVER || CLIENT
array<HatchData> function GetHatchDataGroupsById( string zoneId )
{
	Assert( zoneId in file.hatchIdDataGroups, "Zone id not contained in any hatch data." )

	return file.hatchIdDataGroups[ zoneId ]
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
HatchData function GetHatchDataGroupByDoorModel( entity model )
{
	Assert( model in file.hatchModelDataGroups, "Model not contained in any hatch data." )

	return file.hatchModelDataGroups[ model ]
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
table <string, array<HatchData> > function GetAllHatchDataGroups()
{
	return file.hatchIdDataGroups
}
#endif // SERVER || CLIENT


#if SERVER || CLIENT
bool function IsCanyonlandsBunkersEnabled()
{
	if ( GetCurrentPlaylistVarBool( "canyonlands_bunkers_enabled", true ) )
	{
		foreach ( string zoneId in HATCH_ZONE_IDS )
		{
			array<entity> entranceHatches = GetEntArrayByScriptName( format( HATCH_DOOR_ENTRANCE_SCRIPTNAME, zoneId ) )
			array<entity> leaveHatches    = GetEntArrayByScriptName( format( HATCH_DOOR_LEAVE_SCRIPTNAME, zoneId ) )

			if ( zoneId != "12_treasure" && entranceHatches.len() != 1 )
				return false

			if ( leaveHatches.len() != 1 )
				return false
		}

		return true
	}

	return false
}

bool function IsHatchBunkerUnlocked( string hatchId )
{
	if ( hatchId == "12_treasure" )
		return false

	return file.hatchIdsUnlocked.contains( hatchId )
}
#endif // SERVER || CLIENT␀