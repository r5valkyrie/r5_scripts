#if SERVER || CLIENT
void function InitHatchBunkers()
{
	#if SERVER
		PrecacheParticleSystem( FX_HATCH_STEAM )
		PrecacheParticleSystem( FX_HATCH_STEAM_SMALL )
	#endif

	file.hatchIdsUnlocked = HATCH_ZONE_IDS

	AddCallback_EntitiesDidLoad( EntitiesDidLoad )
}
#endif // SERVER || CLIENT

#if SERVER || CLIENT
void function EntitiesDidLoad()
{
	if ( !IsCanyonlandsBunkersEnabled() )
		return

	// gather data for entrance and exit hatches
	array<HatchData> hatchEntranceDatas
	array<HatchData> hatchLeaveDatas
	foreach ( int hatchIndex, string id in HATCH_ZONE_IDS )
	{
		HatchData entranceHatchData
		HatchData leaveHatchData
		bool isQuestHatch = id == "12_treasure"

		if ( !isQuestHatch )
		{
			entranceHatchData.doorModel = GetEntByScriptName( format( HATCH_DOOR_ENTRANCE_SCRIPTNAME, id ) )
			entranceHatchData.zoneId = id
			entranceHatchData.isEntranceHatch = true
		}

		leaveHatchData.doorModel = GetEntByScriptName( format( HATCH_DOOR_LEAVE_SCRIPTNAME, id ) )
		leaveHatchData.zoneId = id
		leaveHatchData.isEntranceHatch = false

		#if SERVER
			leaveHatchData.doorModel.SetSkin( 1 )
		#endif

		if ( !isQuestHatch )
			hatchEntranceDatas.append( entranceHatchData )

		hatchLeaveDatas.append( leaveHatchData )

		#if SERVER
			// Spawn unique treasure
			if ( (!isQuestHatch && file.hatchIdsUnlocked.contains( id )) || id == "16" )
			{
				entity lootSpawnTarget = GetEntByScriptName( format( "hb_loot_spawn_%s", id ) )
				array<string> itemRefsToSpawn
				// One hopup
				itemRefsToSpawn.append( SURVIVAL_GetWeightedItemFromGroup( "attachments_hopups_only" ) )

				// One POI_High item
				itemRefsToSpawn.append( SURVIVAL_GetWeightedItemFromGroup( "POI_High" ) )

				// Each bunker gets a corresponding item from the gold_weapons table. Should be the same weapon/bunker combo through the season.

				array<string> goldWeaponRefs = SURVIVAL_GetAllRefsInLootGroup( "gold_weapons" )
				string weaponRef = goldWeaponRefs[ hatchIndex % goldWeaponRefs.len() ]

				if ( SURVIVAL_Loot_IsRefDisabled( weaponRef ) )
					weaponRef = SURVIVAL_GetWeightedItemFromGroup( "gold_weapons" )

				vector weaponRefOrigin = OriginToGround( lootSpawnTarget.GetOrigin() + < 0, 0, 16 > )
				SpawnWeaponAndAmmo( weaponRef, weaponRefOrigin )

				foreach ( string ref in itemRefsToSpawn )
					SURVIVAL_ThrowLootFromPoint( lootSpawnTarget.GetOrigin(), RandomVecInDomeWithFOV( < 0, 1, 0 >, 45 ), ref )
			}
		#endif // SERVER

		array<HatchData> hatchDataArray
		file.hatchIdDataGroups[ id ] <- hatchDataArray
	}

	array<HatchData> allHatchDatas
	allHatchDatas.extend( hatchEntranceDatas )
	allHatchDatas.extend( hatchLeaveDatas )

	// setup all the hatches and their linked ents
	foreach ( HatchData data in allHatchDatas )
	{
		// set the initial closed animation
		#if SERVER
		data.doorModel.Anim_PlayWithRefPoint( "bunker_hatch_close_idle", data.doorModel.GetOrigin(), data.doorModel.GetAngles(), 0.0 )
		#endif

		array<entity> linkEnts = data.doorModel.GetLinkEntArray()

		foreach ( entity doorLinkEnt in linkEnts )
		{
			string linkEntScriptName = doorLinkEnt.GetScriptName()

			if ( linkEntScriptName == HATCH_PANEL_SCRIPTNAME )
			{
				data.panelModel = doorLinkEnt
			}
			else if ( linkEntScriptName == ZIPLINE_TARGET_SCRIPTNAME )
			{
				#if SERVER
					data.specialZiplineStartOrigins.append( doorLinkEnt.GetOrigin() )
					doorLinkEnt.Destroy()
				#endif
			}
		}

		if ( IsValid( data.panelModel ) )
		{
			#if SERVER
				data.panelModel.SetSkin( 1 )
				data.panelModel.AllowMantle()
				data.panelModel.SetForceVisibleInPhaseShift( true )
				data.panelModel.SetUsable()
				data.panelModel.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_BY_OWNER | USABLE_BY_PILOTS | USABLE_BY_ENEMIES )
				data.panelModel.SetUsablePriority( USABLE_PRIORITY_LOW )

				if ( !data.isEntranceHatch )
					data.panelModel.SetModelScale( 1.25 )
			#endif

			if ( data.isEntranceHatch )
			{
				if ( file.hatchIdsUnlocked.contains( data.zoneId ) )
				{
					data.hatchState = eHatchState.UNLOCKED

					#if SERVER
						data.panelModel.SetSkin( 0 )
					#endif
				}
				else if ( file.hatchIdsToCountdown.contains( data.zoneId ) )
				{
					data.hatchState = eHatchState.COUNTDOWN
				}
				else
				{
					data.hatchState = eHatchState.LOCKED
				}
			}
			else
			{
				data.hatchState = eHatchState.UNLOCKED

				#if SERVER
					data.panelModel.SetSkin( 0 )
				#endif
			}

			#if CLIENT
				AddEntityCallback_GetUseEntOverrideText( data.panelModel, CreateHatchPanelOverrideTextFunc( data ) )
			#endif

			if ( data.hatchState == eHatchState.UNLOCKED )
				AddCallback_OnUseEntity_ClientServer( data.panelModel, CreateHatchPanelFunc( data ) )
		}

		file.hatchIdDataGroups[ data.zoneId ].append( data )
		file.hatchModelDataGroups[ data.doorModel ] <- data
	}
}
#endif // SERVER || CLIENT


