void function CodeCallback_OnPlayerForfeit( entity player )
{
	// Happens when the player leaves the match, either intentionally via player.Forfeit() or reconnect times out
	if ( player.GetTeam() == TEAM_SPECTATOR )
	{
		printt( FUNC_NAME(), "Skip for Spectator", player )
		return
	}

	printt( FUNC_NAME(), player )

	// Prevent players reconnecting to the game and exploiting game state
	//ConnectionTempBanPlayer( player )

	if ( !player.hasConnected )
		return

	                      
		if ( MatchBehaviorPlayer_HasStarted( player ) && !MatchBehaviorPlayer_HasEnded( player ) )
			MatchBehaviorPlayer_Ended( player, false )
       

	if ( player.p.hasMatchParticipationStarted && !player.p.hasMatchParticipationEnded )
		OnPlayerMatchParticipationEnded( player, false )

	if ( player.IsConnectionActive() )
		Remote_CallFunction_NonReplay( player, "ServerCallback_ResetReconnectParametersAsync" )

	player.SetPersistentVar( "reconnectTime", 0 )
	player.SetPersistentVar( "reconnectParams", "" )
}

