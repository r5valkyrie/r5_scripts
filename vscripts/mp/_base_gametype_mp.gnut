void function OnPlayerKilled_DeathNotify( entity player, entity attacker, var damageInfo )
{
	entity originalAttacker = DamageInfo_GetAttacker( damageInfo )
	Assert( IsValid( originalAttacker ) || IsValid( attacker ) )

	entity creditedAttacker = attacker
	if ( IsValid( originalAttacker ) && (originalAttacker.IsPlayer() || originalAttacker.IsNPC()) )
		creditedAttacker = originalAttacker

	int scriptDamageType = DamageInfo_GetCustomDamageType( damageInfo )
	int damageSourceId   = DamageInfo_GetDamageSourceIdentifier( damageInfo )

	if ( IsBitFlagSet( scriptDamageType, DF_VORTEX_REFIRE ) )
		damageSourceId = eDamageSourceId.damagedef_unknownBugIt

	entity attackerEnt       = null
	float attackerHealth     = 0.0
	float recentHealthDamage = 0.0
	if ( creditedAttacker.IsPlayer() || creditedAttacker.IsNPC() )
	{
		attackerEnt = creditedAttacker
		attackerHealth = GetHealthFrac( creditedAttacker )
		recentHealthDamage = DamageHistory_GetDamageFromEntity( creditedAttacker, player )
	}

	if ( attackerEnt != null )
		Remote_CallFunction_NonReplay( player, "ServerCallback_YouDied", attackerEnt, attackerHealth, damageSourceId, recentHealthDamage )
	else
		Remote_CallFunction_NonReplay( player, "ServerCallback_YouDiedNoAttacker", attackerHealth, damageSourceId, recentHealthDamage )
}


bool functionref( entity ) s_playerEliminationCheck = null
void function SetPlayerEliminationCheck( bool functionref( entity player ) func )
{
	s_playerEliminationCheck = func
}


bool function ShouldPlayerBeEliminated( entity player )
{
	#if DEV
		bool ornull devRespawnOverride = DevRespawnGetPlayerEliminationOverride( player )
		if ( devRespawnOverride != null )
		{
			return expect bool( devRespawnOverride )
		}
	#endif

	if ( s_playerEliminationCheck != null )
	{
		return s_playerEliminationCheck( player )
	}
	return DefaultEliminationCheck( player )
}


bool function DefaultEliminationCheck( entity player )
{
	if ( IsPilotEliminationBased() )
	{
		if ( player.p.respawnCount != 0 )
			return true

		if ( GameTime_PlayingTime() >= ELIM_FIRST_SPAWN_GRACE_PERIOD )
			return true
	}

	int currentGameState = GetGameState()
	if ( currentGameState > eGameState.Resolution )
		return true

	if ( currentGameState == eGameState.Resolution )
	{
		float resolutionRespawnTimeLimit = GetGameEndTime() + GAME_RESOLUTION_PLAYER_RESPAWN_LEEWAY
		if ( Time() > resolutionRespawnTimeLimit )
		{
			if ( IsAlive( player ) )
				return true

			if ( player.p.postDeathThreadStartTime == 0 )
				//Player is not alive and hasn't died yet, i.e. is just connecting. Set him as eliminated in this case
				return true

			if ( player.p.postDeathThreadStartTime >= resolutionRespawnTimeLimit )
				// allow players who died before the game ended and may still be watching kill replay a chance to respawn
				return true

			return false
		}
	}

	return false
}


bool function Player_WouldAbandonMatch( entity player )
{
	if ( IsPrivateMatch() )
		return false

	if ( svGlobal.gameModeAbandonPenaltyApplies == null )
		return false

	if ( !svGlobal.gameModeAbandonPenaltyApplies( player ) )
		return false

	return true
}


