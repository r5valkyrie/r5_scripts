void function ThreatDetection_AddGrenade( entity grenade )
{
	if ( IsValid( grenade ) && grenade.IsProjectile() )
	{
		entity projOwner = grenade.GetOwner()

		if ( !IsValid( projOwner ) )
			return

		if ( !projOwner.IsPlayer() )
			return

		thread Delay_AddGrenade( grenade )
	}
}

void function Delay_AddGrenade( entity grenade )
{
	grenade.EndSignal( "OnDestroy" )

	wait 0.1

	if ( grenade.GetProjectileWeaponSettingInt( eWeaponVar.explosion_damage ) > 0 )
	{
		int id = ThreatDetection_CreateThreatZoneForGrenade( grenade, grenade.GetOrigin(), grenade.GetTeam() )

		OnThreadEnd(
			function () : ( id )
			{
				ThreatDetection_RemoveThreatZone( id )
			}
		)

		while ( IsValid( grenade ) )
		{
			ThreatDetection_UpdateThreatZoneOrigin( id, grenade.GetOrigin() )
			wait 0.1
		}
	}
}

void function ThreatDetection_OnPlayerRespawned( entity player )
{
	//Spin up player ambush detection logic.
	//thread ThreatDetection_PlayerAmbushUpdate( player )
}

void function ThreatDetection_OnPlayerKilled( entity victim, entity attacker, var damageInfo  )
{
	if ( !IsValid( attacker ) )
		return

	if ( !IsValid( victim ) )
		return

	vector origin = victim.GetOrigin()
	int team = attacker.GetTeam()
	ThreatDetection_CreateThreatZoneForKillzone( victim, origin, team )
}

