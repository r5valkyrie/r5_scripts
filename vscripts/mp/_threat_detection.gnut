int function ThreatDetection_CreateThreatZone( entity realmsEntity, entity owner, vector origin, float radius, int type, int team, float duration = THREAT_DETECTION_THREAT_ZONE_DURATION_INFINITE )
{
	return ThreatDetection_CreateThreatZoneCylinder( type, origin, THREAT_DETECTION_THREAT_ZONE_HEIGHT, radius, 0.5, 1.0, team, duration, owner )
}

int function ThreatDetection_CreateThreatZoneForTrap( entity realmsEntity, entity owner, vector origin, int team )
{
	//int sourceActorID = IsValid( owner ) ? ThreatDetection_GetEntityThreatActorID( owner ) : THREAT_DETECTION_THREAT_ACTOR_WORLD_ID
	int zoneID = ThreatDetection_CreateThreatZone( realmsEntity, owner, origin, THREAT_DETECTION_THREAT_ZONE_RADIUS_TRAP, eThreatDetectionZoneType.TRAP, team, THREAT_DETECTION_THREAT_ZONE_DURATION_INFINITE )
	return zoneID
}

void function ThreatDetection_CreateThreatZoneForPing( entity realmsEntity, entity owner, vector origin, int team )
{
	//int sourceActorID = IsValid( owner ) ? ThreatDetection_GetEntityThreatActorID( owner ) : THREAT_DETECTION_THREAT_ACTOR_WORLD_ID
	int zoneID = ThreatDetection_CreateThreatZone( realmsEntity, owner, origin, THREAT_DETECTION_THREAT_ZONE_RADIUS_PING, eThreatDetectionZoneType.PING, team, 1.0 )
	ThreatDetection_ThreatZoneOverrideSourceOrigin( zoneID, owner.GetOrigin() )

	// If we are in a mode where we allow communication between players near each other that are on the same team (but not the same squad); show the icon to nearby teammates
	if ( AllianceProximity_ShouldTryToTransmitPingOrIconToAlliance( false ) && !MiniMapIsDisabled() )
	{
		foreach ( allianceTeam in AllianceProximity_GetLivingPlayerTeamsInSameAllianceAsTeam( team ) )
		{
			zoneID = ThreatDetection_CreateThreatZone( realmsEntity, owner, origin, THREAT_DETECTION_THREAT_ZONE_RADIUS_PING, eThreatDetectionZoneType.PING, allianceTeam, 1.0 )
			ThreatDetection_ThreatZoneOverrideSourceOrigin( zoneID, owner.GetOrigin() )
		}
	}
}

void function ThreatDetection_CreateThreatZoneForBombardment( entity realmsEntity, entity owner, vector origin, int team, float radius, float duration )
{
	ThreatDetection_CreateThreatZone( realmsEntity, owner, origin, radius, eThreatDetectionZoneType.BOMBARDMENT, team, duration )
}

void function ThreatDetection_CreateThreatZoneForKillzone( entity realmsEntity, vector origin, int team )
{
	ThreatDetection_CreateThreatZone( realmsEntity, null, origin, THREAT_DETECTION_THREAT_ZONE_RADIUS_KILLZONE, eThreatDetectionZoneType.KILLZONE, team, 15.0 )
}

int function ThreatDetection_CreateThreatZoneForGrenade( entity realmsEntity, vector origin, int team )
{
	return ThreatDetection_CreateThreatZone( realmsEntity, null, origin, THREAT_DETECTION_THREAT_ZONE_RADIUS_GRENADE, eThreatDetectionZoneType.GRENADE, team, THREAT_DETECTION_THREAT_ZONE_DURATION_INFINITE )
}

//This function tells the threat zone of the given ID to use the given vector as the source of its threat events when it is calculating threat flags.
void function ThreatDetection_ThreatZoneOverrideSourceOrigin( int zoneID, vector sourceOrigin )
{
	// ThreatDetection_UpdateThreatZoneSourceOrigin( zoneID, sourceOrigin )
}

void function ThreatDetection_MoveThreatZone( int zoneID, vector origin )
{
	ThreatDetection_UpdateThreatZoneOrigin( zoneID, origin )
}

void function ThreatDetection_DestroyThreatZone( int zoneID )
{
	ThreatDetection_RemoveThreatZone( zoneID )
}

int function ThreatDetection_GetUniqueThreatZoneID()
{
	int zoneID = file.nextThreatZoneID
	file.nextThreatZoneID++
	return zoneID
}

