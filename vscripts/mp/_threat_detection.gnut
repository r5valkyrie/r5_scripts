//NOTE: Any callbacks added for a player are removed when we stop threat tracking on that player.
void function AddCallback_OnThreatEventActivation( entity player, int type, void functionref( entity, ThreatEventCallbackData ) callbackFunc )
{
	if (!( type in file.playerThreatEvents[ player ].threatActivationCallbacks ) )
	{
		file.playerThreatEvents[ player ].threatActivationCallbacks[ type ] <- []
	}

	file.playerThreatEvents[ player ].threatActivationCallbacks[ type ].append( callbackFunc )
}

void function AddCallback_OnThreatEventStateChange( entity player, int type, int startTypeState, int endTypeState, void functionref( entity, ThreatEventCallbackData ) callbackFunc  )
{
	if (!( type in file.playerThreatEvents[ player ].threatStateChangeCallbacks ) )
	{
		file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ] <- {}
	}

	if (!( startTypeState in file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ] ) )
	{
		file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ][ startTypeState ] <- {}
	}

	if (!( endTypeState in file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ][ startTypeState ] ) )
	{
		file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ][ startTypeState ][ endTypeState ] <- []
	}

	file.playerThreatEvents[ player ].threatStateChangeCallbacks[ type ][ startTypeState ][ endTypeState ].append( callbackFunc )
}

