void function CodeCallback_ThreatDetection_OnNewSource( entity player, int threatType, int threatFlags, int newThreatState, int oldThreatState )
{
	if (!( player in file.playerThreatEvents ))
		return

	ThreatEventCallbackData data
	data.type = threatType
	data.typeState = newThreatState
	data.threatFlags = threatFlags

	 //printt( "CodeCallback_ThreatDetection_OnNewSource " + player )
	 //printt( "threatType " + threatType )
	 //printt( "threatFlags " + threatFlags )
	 //printt( "newThreatState " + newThreatState )
	 //printt( "oldThreatState " + oldThreatState )

	if ( threatType in file.playerThreatEvents[ player ].threatActivationCallbacks )
	{
		foreach ( func in file.playerThreatEvents[ player ].threatActivationCallbacks[ threatType ] )
		{
			func( player, data )
		}
	}
}

void function CodeCallback_ThreatDetection_OnStateChange( entity player, int threatType, int threatFlags, int newThreatState, int oldThreatState )
{
	if (!( player in file.playerThreatEvents ))
		return

	ThreatEventCallbackData data
	data.type = threatType
	data.typeState = newThreatState
	data.threatFlags = threatFlags

	// printt( "CodeCallback_ThreatDetection_OnStateChange " + player )
	// printt( "threatType " + threatType )
	// printt( "threatFlags " + threatFlags )
	// printt( "newThreatState " + newThreatState )
	// printt( "oldThreatState " + oldThreatState )

	if ( threatType in file.playerThreatEvents[ player ].threatStateChangeCallbacks )
		if ( oldThreatState in file.playerThreatEvents[ player ].threatStateChangeCallbacks[ threatType ] )
			if ( newThreatState in file.playerThreatEvents[ player ].threatStateChangeCallbacks[ threatType ][ oldThreatState ] )
				foreach ( func in file.playerThreatEvents[ player ].threatStateChangeCallbacks[ threatType ][ oldThreatState ][ newThreatState ] )
					func( player, data )
}

void function CodeCallback_ThreatDetection_OnSourcesCeased( entity player, int threatType, int threatFlags, int newThreatState, int oldThreatState )
{

}

void function OnSpawnedNPC( entity npc )
{
	if ( GetCurrentPlaylistVarBool( "wraith_npc_threat_detection_enabled", false ) )
		thread TrackEnemySpotted( npc )
}

void function TrackEnemySpotted( entity guy )
{
	guy.EndSignal( "OnDeath" )

	while ( true )
	{
		table results = WaitSignal( guy, "OnSeeEnemy" )

		if ( !IsValid( results.activator ) )
			return

		entity target = expect entity( results.activator )

		if ( target.IsPlayer() )
		{
			float distance = Distance( target.GetOrigin(), guy.GetOrigin() )

			int threatFlag = TDS_VIEW_WATCH
			if ( distance > 6000 )			// GetConVarFloat( "threat_detection_view_dist_snipe" ) )
				threatFlag = TDS_VIEW_SNIPE
			else if ( distance > 4000 )		//GetConVarFloat( "threat_detection_view_dist_aim" ) )
				threatFlag = TDS_VIEW_AIM

			CodeCallback_ThreatDetection_OnNewSource( target, TDT_HOSTILE_ENTITY_VIEW, threatFlag, threatFlag, threatFlag )
		}
	}
}