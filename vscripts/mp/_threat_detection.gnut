//This value is used to specify that the source actor of a threat is the world and not a specific entity.
const int THREAT_DETECTION_THREAT_ACTOR_WORLD_ID = -1

//THREAT ZONE VARS
const float THREAT_DETECTION_THREAT_ZONE_DURATION_INFINITE = 0.0
const float THREAT_DETECTION_THREAT_ZONE_HEIGHT = 96.0
const float THREAT_DETECTION_THREAT_ZONE_RADIUS_TRAP = 512.0
const float THREAT_DETECTION_THREAT_ZONE_RADIUS_PING = 512.0
const float THREAT_DETECTION_THREAT_ZONE_RADIUS_KILLZONE = 256.0
const float THREAT_DETECTION_THREAT_ZONE_RADIUS_GRENADE = 256.0
const float THREAT_DETECTION_THREAT_ZONE_RADIUS_AMBUSH = 512.0

global enum eThreatDetectionZoneType // Start enum at TDT_FIRST_ZONE so it aligns with code threat zones
{
	TRAP = TDT_FIRST_ZONE,		//Threat Zone around class placeable traps.
	AMBUSH,						//Threat Zone around player who is not moving for long period of time.
	BOMBARDMENT,				//Threat Zone around bombardment mortar impact zone.
	PING,						//Threat Zone around enemy ping location.
	KILLZONE,					//Threat Zone around recent player death.
	GRENADE,					//Threat Zone around a live grenade.
	SONAR,						//Threat Zone around sonar pulse.
}

//Data defines a danger zone that triggers threat event logic.
struct ThreatDetectionZoneData
{
	vector origin
	float  radius
	int    type
	int    team
	int    threatZoneID
	int	   zoneSourceActorID  //Threat Actor ID for zone itself.
	int    zoneFlags = 0
	vector zoneFlagsOrigin //When calculating threat event flags, this vector can be used to specify a position other than zone's world origin as the source position of the threat.
	float  duration = -1 //-1 is an infinite duration that must be manually removed.
	float  endTime
}

struct ThreatDetectionSourceActorStateData
{
	float                               startTime	//The time at which this source actor first started interacting with the threat event.
	float                               checkInTime	//The time at which this source actor should time out as an active threat.
	int                                 typeStateNext = -1	//This threat actor's active type state
	int                                 typeStatePrev = -1	//This threat actor's previous type state.
	//D-Bounce Storage: oldTypeState -> newTypeState -> D-Bounce Time
	table < int, table < int, float > > typeStateDBounce //Table to store D-Bounce times for state change callbacks specifically for this threat source.

	float activationDelay 	//Specifies the time to delay the active threat callback after this source interacts with the threat event.
	bool  shouldActivate 	= false		//Specifies that this threat source should fire its activation callback this frame.
	bool  active 			= false 	//Specifies if this threat source has fired it's threat activation callback.
}

struct ThreatDetectionEventData
{
	float startTime				//The Time at which this threat event began.
	float timeOutTime			//The Time at which this threat should time out and end.
	int   type					//The Event Type of this event.
	int   typeStateNext = -1	//The active state for this event.
	int	  typeStatePrev	= -1	//The previous state for this event.
	int   threatFlags 			//Flags that specify additional information about the nature of this threat.

	//D-Bounce Storage: oldTypeState -> newTypeState -> D-Bounce Time
	table < int, table < int, float > > typeStateGlobalDBounce //Table to store D-Bounce times for state change callbacks

	float activationDelay 			//Specifies the time to delay the active threat callback after this event is created.
	bool  active = false 			//Specifies if this event has fired it's threat activation callback.
	float lastEventActivationTime 	//The last time this event fired its activation callbacks

	//Identifiers
	int                threatEventID	//The Unique ID for this event.

	//Threat Source State Info
	table < int, ThreatDetectionSourceActorStateData > sourceActorStateData	//Source actor state data for this threat event stored by source actor ID.
}

struct ThreatDetectionEventSnapshot
{
	int                   type
	int                   threatFlags = 0
	table < int, int > 	  sourceActorTypeStatesByID
	bool                  needsUpdate = false
}

global struct ThreatEventCallbackData
{
	int type
	int typeState = -1
	int threatFlags
}

struct PlayerThreatEventData
{
	float threatCallbackDBounceTime //The next time across all threat events that a callback can be fired.
	float threatLastGrenadeTime //The last time player vortex triggered for a grenade.
	table < int, ThreatDetectionEventData > threatEvents //Threat events stored by threat event ID.
	table < int, int > threatEventIDByTypeID //Threat event IDs stored by event type ID.
	//Activation Callback Storage: type -> array of callback functions
	table < int, array< void functionref( entity, ThreatEventCallbackData ) > > threatActivationCallbacks
	//State Change Callback Storage: type -> old type state -> new type state -> array of callback functions
	table < int, table < int, table < int, array< void functionref( entity, ThreatEventCallbackData ) > > > > threatStateChangeCallbacks
}

struct PlayerThreatMovementHistoryData
{
	array< vector > movementHistory
	vector movementTrend = < 0, 0, 0 >
}

struct
{
	int                                     nextThreatActorID = 0 	//The next available ID that can be used to uniquely identify the source or target of a threat.
	int										nextThreatZoneID  = 0	//The next available ID that can be used to uniquely identify a threat zone.
	int                                     nextThreatEventID = 0 	//The next available ID that can be used to uniquely identify a threat event between two actors.
	table< entity, int > 					entityThreatActorIDs	//Table of threat actor IDs for previously registered entities.
	table< int, ThreatDetectionZoneData > 	threatZones 			//Table of active threat zones.
	table< int,	PlayerThreatMovementHistoryData > threatMovementHistory	//Table of actor movment histories stored by threat actor ID
	table< entity, PlayerThreatEventData > 	playerThreatEvents 		//Table of threat event data for registered players.
} file

void function ThreatDetection_Init()
{
	RegisterSignal( "ThreatDetection_StopDetection" )
	RegisterSignal( "ThreatDetection_StopAmbush" )
	AddCallback_OnClientConnected( ThreatDetection_ClientConnected )
	AddCallback_OnClientDisconnected( ThreatDetection_ClientDisconnected )
	AddCallback_OnPlayerRespawned( ThreatDetection_OnPlayerRespawned )
	AddCallback_OnPlayerKilled( ThreatDetection_OnPlayerKilled )

	AddCallback_GameStateEnter( eGameState.Playing, ThreatDetection_OnGamePlaying )

	AddSpawnCallback( "grenade", ThreatDetection_AddGrenade )

	AddSpawnCallback( "npc_soldier", OnSpawnedNPC )
	AddSpawnCallback( "npc_spectre", OnSpawnedNPC )
	AddSpawnCallback( "npc_stalker", OnSpawnedNPC )
	AddSpawnCallback( "npc_goliath", OnSpawnedNPC )
	AddSpawnCallback( "npc_prowler", OnSpawnedNPC )
	AddSpawnCallback( "npc_dummie", OnSpawnedNPC )
	                         
		AddSpawnCallback( "npc_spider_ranged", OnSpawnedNPC )
       
	AddSpawnCallback( "npc_drone", OnSpawnedNPC )
	AddSpawnCallback( "npc_super_spectre", OnSpawnedNPC )
	AddSpawnCallback( "npc_frag_drone", OnSpawnedNPC )
}

void function ThreatDetection_StartForPlayer( entity player, array<int> threatTypesToMonitor = [] )
{
	ThreatDetection_StopForPlayer( player )

	PlayerThreatEventData threatEventData
	threatEventData.threatCallbackDBounceTime = Time()
	threatEventData.threatLastGrenadeTime = Time()

	file.playerThreatEvents[ player ] <- threatEventData

	ThreatDetection_StartMonitoringPlayer( player, threatTypesToMonitor )
}

void function ThreatDetection_StopForPlayer( entity player )
{
	if ( !( player in file.playerThreatEvents ) )
		return

	delete file.playerThreatEvents[ player ]

	ThreatDetection_StopMonitoringPlayer( player )
}

