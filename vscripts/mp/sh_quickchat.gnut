#if SERVER
void function ClientCallback_Quickchat_UI( entity player, int index, int commFlags, int equipSlotType )
{
	if ( EquipmentSlot_IsValidEquipmentSlotType( equipSlotType ) == false )
		return

	EquipmentSlot e = Survival_GetEquipmentSlotDataByType( equipSlotType )
	string equipSlot = e.ref
	entity subject = null
	int itemIndex = -1
	LootData lData
	if ( equipSlot in EquipmentSlot_GetAllEquipmentSlots() )
	{
		lData = EquipmentSlot_GetEquippedLootDataForSlot( player, equipSlot )

		if ( EquipmentSlot_IsAttachmentSlot( equipSlot ) )
			equipSlot = EquipmentSlot_GetAttachmentWeaponSlot( equipSlot )

		if ( EquipmentSlot_IsMainWeaponSlot( equipSlot ) && lData.ref == "" )
		{
			lData = EquipmentSlot_GetEquippedLootDataForSlot( player, equipSlot )
			EquipmentSlot es = Survival_GetEquipmentSlotDataByRef( equipSlot )
			subject = player.GetNormalWeapon( es.weaponSlot )
		}

		itemIndex = lData.index
	}

	ClientCallback_QuickchatInternal( player, index, commFlags, subject, itemIndex )
}

void function ClientCallback_Quickchat( entity player, int index, int commFlags )
{
	ClientCallback_QuickchatInternal( player, index, commFlags, null, -1 )
}

void function ClientCallback_QuickchatSubject_Player( entity player, int index, int commFlags, entity subject )
{
	// Drop the whole call if the subject is not valid.
	if ( !IsValid( subject ) )
		return

	ClientCallback_QuickchatInternal( player, index, commFlags, subject, -1 )
}

void function ClientCallback_QuickchatInternal( entity player, int index, int commFlags, entity subject, int itemIndex )
{
	if ( !(index in file.actions) )
		return

	if ( SURVIVAL_Loot_IsLootIndexValid( itemIndex ) == false && itemIndex != -1 )
		return

	string itemRef = ""
	if ( SURVIVAL_Loot_IsLootIndexValid( itemIndex ) == false )
	{
		// pass
	}
	else
	{
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( itemIndex )
		itemRef = data.ref
	}

	//printt( "ClientCallback_Quickchat, player: " + player + ", index: " + index + ", commFlags: " + commFlags + ", subject: " + subject + ", itemRef: " + itemRef  )

	BroadcastCommsActionToTeam( player, index, subject, player.GetOrigin(), commFlags, itemRef )
}

void function BroadcastCommsActionToTeam( entity playerSpeaking, int commsAction, entity subjectEnt, vector subjectPos, int commsFlags, string itemRef )
{
	int secondaryCommsAction = 0

                   
                                             
                                                                 
       

	if ( file.disabledCommsActions.contains( commsAction ) )
	{
		printf( "QUICKCHAT: Comm action " + commsAction + " is disabled but still being triggered" )
		return
	}

	int itemIndex = -1
	if( itemRef != "" )
	{
		if( SURVIVAL_Loot_IsRefValid( itemRef ) == false )
		{
			return // cancel on incorrect data
		}
		else
		{
			LootData lootData = SURVIVAL_Loot_GetLootDataByRef( itemRef )
			itemIndex = lootData.index
		}
	}

	array<entity> players = GetPlayerArrayOfTeam_Alive( playerSpeaking.GetTeam() )

	// If we are in a mode where we allow communication between players near each other that are on the same team (but not the same squad); show kill feed text for the comms action
	if ( AllianceProximity_IsUsingAllianceProximity() )
	{
		if ( IsValid( playerSpeaking ) )
		{
			foreach ( proximityPlayer in AllianceProximity_GetLivingAllianceMembersInProximity( playerSpeaking.GetTeam(), playerSpeaking.GetOrigin() ) )
			{
				players.append( proximityPlayer )
			}
		}
	}

	                        
		// ToDo: R5DEV-567005 : Complete refactor to support Capture Objective Pings using Alliances
		if ( GameMode_IsActive( eGameModes.CONTROL ) )
		{
			// If the player pinged an objective, trigger a comms action for the entire alliance
			if ( commsAction == eCommsAction.PING_CONTROL_OBJECTIVE_ATTACK || commsAction == eCommsAction.PING_CONTROL_OBJECTIVE_DEFEND )
			{
				if ( IsValid( subjectEnt ) && IsValid( subjectEnt.GetOwner() ) && subjectEnt.GetOwner().GetClassName() == PLAYER_WAYPOINT_CLASSNAME && subjectEnt.GetOwner().GetWaypointType() == eWaypoint.CONTROL_OBJECTIVE && IsValid( playerSpeaking ) )
				{
					players.clear()
					int alliance = AllianceProximity_GetAllianceFromTeam( playerSpeaking.GetTeam() )
					foreach( alliancePlayer in GetPlayerArray() )
					{
						if ( IsValid( alliancePlayer ) && AllianceProximity_GetAllianceFromTeam( alliancePlayer.GetTeam() ) == alliance )
							players.append( alliancePlayer )
					}
				}
			}
		}
       

	// Get ultimate entity for GetSubjectCountForCommsAction..
	switch ( commsAction )
	{
		case eCommsAction.QUICKCHAT_ULTIMATE_READY_FULL:
		case eCommsAction.QUICKCHAT_ULTIMATE_READY_ALMOST:
		case eCommsAction.QUICKCHAT_ULTIMATE_READY_NOT:
	                            
		case eCommsAction.PING_I_ULTIMATE:
       
		{
			subjectEnt = playerSpeaking.GetOffhandWeapon( OFFHAND_ULTIMATE )
			if ( !IsValid( subjectEnt ) )
				return

			#if CLIENT
			PIN_UltimateReadyPing( playerSpeaking, GetEnumString( "eCommsAction", commsAction ).tolower(), true )
			#endif
			break
		}
		default:
			break
	}

	RunQuickChatCallbacks( playerSpeaking, commsAction, subjectEnt )

                   
	int subjectCount
	if ( commsAction == eCommsAction.REPLY_CAREPACKAGE_INSIGHT_FUTURE && IsValid( subjectEnt ) && subjectEnt.GetNetworkedClassName() == PLAYER_WAYPOINT_CLASSNAME )
	{
		subjectCount = int( subjectEnt.GetWaypointGametime( 0 ) - Time() )
		subjectEnt = null
	}
	else
	{
		subjectCount = GetSubjectCountForCommsAction( playerSpeaking, commsAction, subjectEnt )
	}
     
                                                                                            
      

	if ( IsBitFlagSet( commsFlags, eCommsFlags.INCLUDE_DEAD ) )
	{
		players = GetPlayerArrayOfTeam( playerSpeaking.GetTeam() )

		foreach ( player in players )
			QuickChat_SendServerToClient_BroadcastCommsActionToTeam( player, playerSpeaking,
				commsAction, commsFlags, subjectCount, secondaryCommsAction, subjectEnt, subjectPos, itemIndex )

		return
	}

	if ( IsBitFlagSet( commsFlags, eCommsFlags.BROADCAST_TO_WAYPOINT_OWNER ) )
	{
		entity subjToUse = subjectEnt

		if ( IsValid( subjToUse ) )
		{
			if ( !subjToUse.IsPlayer() )
				subjToUse = subjToUse.GetOwner()

			if ( IsValid( subjToUse ) )
			{
				if ( subjToUse.IsPlayer() )
				{
					QuickChat_SendServerToClient_BroadcastCommsActionToTeam( subjToUse, playerSpeaking,
						commsAction, commsFlags, subjectCount, secondaryCommsAction, subjectEnt, subjectPos, itemIndex )
				}
			}
		}

		return
	}

	foreach ( player in players )
		QuickChat_SendServerToClient_BroadcastCommsActionToTeam( player, playerSpeaking,
			commsAction, commsFlags, subjectCount, secondaryCommsAction, subjectEnt, subjectPos, itemIndex  )
}

void function QuickChat_SendServerToClient_BroadcastCommsActionToTeam( entity player, entity playerSpeaking, int commsAction,
		int commsFlags, int subjectCount, int secondaryCommsAction, entity subjectEnt, vector subjectPos, int itemIndex  )
{
	int itemIndexToSend = SURVIVAL_Loot_IsLootIndexValid( itemIndex ) == false ? -1 : itemIndex

	CommsOptions opt
	opt.isFirstPerson = player == playerSpeaking
	opt.isFar = false
	opt.isUrgent = false

	// note: this is not ideal, but we need to pick one variant.. assumes most things won't be far/urgent.
	// The far / urgent variants are not guaranteed to have matching selector layouts.
	// In the case that the evaluated selector isn't compatible, miles will just run the evaluation on the client.
	// This means that urgent/far variants are not 100% guaranteed to have working selector sync right now.
	string sound = GetPlayerDialogSound( playerSpeaking, player, GetCommsAction( commsAction ), opt )
	int selector = EvaluateSoundSelector( sound )

	if ( IsValid( subjectEnt ) )
		Remote_CallFunction_Replay( player, "ServerToClient_BroadcastCommsActionToTeam", playerSpeaking,
			commsAction, commsFlags,
			subjectCount, secondaryCommsAction, subjectEnt, subjectPos, itemIndexToSend, selector )
	else
		Remote_CallFunction_Replay( player, "ServerToClient_BroadcastSubjectlessCommsActionToTeam", playerSpeaking,
			commsAction, commsFlags,
			subjectCount, secondaryCommsAction, subjectPos, itemIndexToSend, selector )
}


void function QuickChat_RegisterDisabledCommsActions( array<int> disabledComms )
{
	foreach( commAction in disabledComms )
	{
		if ( !file.disabledCommsActions.contains( commAction ) )
			file.disabledCommsActions.append( commAction )
	}
}

int function GetSubjectCountForCommsAction( entity player, int commsAction, entity subjectEnt )
{
	// Note: not all comms actions that display counts need to be listed here
	// Only "quickchat" style comms need to be listed (i.e. comms that aren't from pings being created)
	// In-world pings should be setting the quantity on the waypoint ent to pass it to the client

	int count = -1

	if ( !IsValid( player ) )
		return count

	switch ( commsAction )
	{
		case eCommsAction.INVENTORY_NEED_AMMO_BULLET:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_BULLET:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.bullet )

		case eCommsAction.INVENTORY_NEED_AMMO_SPECIAL:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_SPECIAL:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.special )

		case eCommsAction.INVENTORY_NEED_AMMO_HIGHCAL:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_HIGHCAL:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.highcal )

		case eCommsAction.INVENTORY_NEED_AMMO_SHOTGUN:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_SHOTGUN:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.shotgun )

		case eCommsAction.INVENTORY_NEED_AMMO_SNIPER:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_SNIPER:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.sniper )

		case eCommsAction.INVENTORY_NEED_AMMO_ARROWS:
	                         
		case eCommsAction.INVENTORY_NO_AMMO_ARROWS:
       
			return player.AmmoPool_GetCount( eAmmoPoolType.arrows )

		case eCommsAction.QUICKCHAT_ULTIMATE_READY_ALMOST:
		case eCommsAction.QUICKCHAT_ULTIMATE_READY_NOT:
	                            
		case eCommsAction.PING_I_ULTIMATE:
       
			if ( IsValid( subjectEnt ) && subjectEnt.IsWeaponX() )
				return int( ceil( float( subjectEnt.GetWeaponPrimaryClipCount() ) / float (subjectEnt.GetWeaponPrimaryClipCountMax() ) * 100 ) )
			else
				return count
                         
		case eCommsAction.FIRING_RANGE_TARGET_SPEED_CHANGE:
			return GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) ? GetCurrentTargetSpeedForPlayerRealm( player ) : count
      
	}

	return count
}
#endif


#if SERVER || CLIENT
void function RunQuickChatCallbacks( entity player, int commsAction, entity subjectEnt )
{
	if ( commsAction in file.onQuickchatCallbacks )
	{
		foreach ( func in file.onQuickchatCallbacks[ commsAction ] )
		{
			func( player, commsAction, subjectEnt )
		}
	}
}
#endif

