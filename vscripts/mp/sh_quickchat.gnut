		StatsHook_OnPlayerSaidThanks( player )
}
#endif

#if CLIENT
void function ServerCallback_BroadcastPlayerKicked( int entIdx, bool isAnonymous )
{
	string name = GetPlayerNameByEntIndex( entIdx )
	if ( isAnonymous )
		name = GetCachedObsfuscatedNameByName( name )

	Obituary_Print_Localized( Localize( "#ANTICHEAT_REMOVED_FROM_MATCH", name ), <255, 255, 255> )
}
#endif

#if (CLIENT || SERVER) && ASSERTS
void function CheckCommsActionValidity( int commsAction )
{
	Assert( commsAction >= 0 )
	Assert( commsAction < eCommsAction._count )

	string enumString = IsValidEnumValue( "eCommsAction", commsAction ) ? GetEnumString( "eCommsAction", commsAction ) : "Unknown eCommsAction!"
	Assert( commsAction in file.actions, "Unhandled commsAction " + enumString + " (" + commsAction + ")" ) // If we are hitting this assert unexpectedly - make sure ePingType has all DEV-only enums at the end of the enum list.
}
#endif
