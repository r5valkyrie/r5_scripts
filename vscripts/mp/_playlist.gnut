
global function GetLastServerMap
global function GetLastServerGameMode
global function GetServerMapHistory
global function GetServerModeHistory

#if DEVELOPER
	//global function PrintPlayerMapHistory
	//global function PrintPlayerModeHistory
#endif


string function GetLastServerMap()
{
	string lastMap
	int index = 1 // 0 is the current and 1 is the last map

	for ( ;; )
	{
		lastMap = GameRules_GetRecentMap( index )
		index++

		if ( lastMap == "" )
			return ""

		if ( !IsLobbyMapName( lastMap ) )
			return lastMap
	}

	unreachable
}

string function GetLastServerGameMode()
{
	string lastMode
	string lastMap
	int index = 1 // 0 is the current and 1 is the last map

	for ( ;; )
	{
		lastMode = GameRules_GetRecentGameMode( index )
		lastMap = GameRules_GetRecentMap( index )
		index++

		if ( lastMode == "" )
			return ""

		if ( !IsLobbyMapName( lastMap ) )
			return lastMode
	}

	unreachable
}

// Returns a list of played maps, limited to the map count of the current playlist, or available maps in the case of private match
array<string> function GetServerMapHistory( int mapCount = MAX_GAME_HISTORY )
{
	array<string> mapNames
	string mapName
	int index = 0

	for ( ;; )
	{
		mapName = GameRules_GetRecentMap( index )

		if ( mapName == "" )
			break

		if ( !IsLobbyMapName( mapName ) )
		{
			mapNames.append( mapName )
			//printl( "Appending Map: " + mapName )

			if ( mapNames.len() >= mapCount )
				break
		}

		index++
	}

	return mapNames
}

// Returns a list of played modes, limited to the mode count of the current playlist, or available modes in the case of private match
array<string> function GetServerModeHistory( int modeCount = MAX_GAME_HISTORY )
{
	string mapName

	array<string> modeNames
	string modeName
	int index = 0

	for ( ;; )
	{
		mapName = GameRules_GetRecentMap( index )
		modeName = GameRules_GetRecentGameMode( index )

		if ( mapName == "" )
			break

		if ( !IsLobbyMapName( mapName ) )
		{
			modeNames.append( modeName )
			//printl( "Appending Mode: " + modeName )

			if ( modeNames.len() >= modeCount )
				break
		}

		index++
	}

	return modeNames
}