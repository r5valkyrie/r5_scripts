}

struct PINPlayerData
{
	float                                               joinTime
	float                                               spawnTime
	float                                               spawnOrReviveTime
	table 												damageDealt // <string, float>
	table												damageTaken // <string, float>
	float[ABILITY_TYPE._COUNT]                          abilityReadyTime
	table<entity, float>                                tookDamageFromPlayers
	table												previousLoadout
	float												lastLoadoutUpdateTime
	int													abandonStatus
	table												ringTimes // <string, float>

	int													gamepadUsageCount = 0
	int													keyboardUsageCount = 0
}

struct WeaponSummaryData
{
	string category						// weapon category
	float damageDealtToPlayers 			// total damage dealt to players, including downed players
	float downedDamageDealtToPlayers	// damage dealt only to downed players
	int numDowningShots 				// total downing shots
	int numFatalShots 					// total fatal shots
	int firstEquipTime 					// game time - pin start time
	int numHeadshots 					// number of headshots
	int numShotsFired 					// number of shots fired
	int numShotsHitPlayers 				// number of shots that hit a player
	table weaponAttributes 				// additional info (not sure what yet)
	float weaponEquipDuration			// Duration the weapon was set as primary
	array<string> weaponMods 			// weapon modifications/attachments (probably whatever they eneded with)
}

struct
{
	float  gameStartTime
	float  roundStartTime
	int    playerCount
	bool   gameOver
	bool   isCrossPlayGame = false

	table< entity, PINPlayerData > playerData
	table< entity, table< string, WeaponSummaryData > > playerWeaponData

	string championPID = ""

	entity  networkWaypoint
} PIN

