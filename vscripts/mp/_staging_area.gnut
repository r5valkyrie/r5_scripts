array<entity> function GetRackNodesArray( vector rackOrigin = < 0, 0, 0 > )
{
                           
	const MAXDISTFROMORIGIN = 2000
	if( IsUsingConsolidatedLoot() )
	{

		s_rackNodes = ArrayClosest( GetEntArrayByScriptName( CONSOLIDATEDLOOT_WEAPONRACK_NAME ), rackOrigin )
	}
	else
	{
		if ( s_rackNodes.len() == 0 )
		{
			s_rackNodes = ArrayClosest( GetEntArrayByScriptName( "weapon_racks" ), rackOrigin )
			s_rackNodes.append( CreateInfoTarget( <30820.0, -5544.0, -29164>, <0, 90, 0> ) )
			s_rackNodes.append( CreateInfoTarget( <31030.0, -5544.0, -29164.0>, <0, 90, 0> ) )
		}
	}
     
                              
  
                                                                                     
                                                                                  
                                                                                    
  
      
	return s_rackNodes
}

void function CreateWeaponRacksForRealm( int realm, entity ornull consolidatedLootOriginNode = null )
{
	array< entity > rackNodes
	vector racKOrigin = < 0, 0, 0 >
                            
		if( IsUsingConsolidatedLoot() && ( consolidatedLootOriginNode != null ) )
		{
			expect entity( consolidatedLootOriginNode )
			rackNodes = ConsolidatedLoot_GetNodesArray( consolidatedLootOriginNode, eConsolidatedLootNodeType.WEAPONRACK )
		}
			else
		{
			rackNodes = GetRackNodesArray()
		}
      
                                 
       

	array< string > weaponRefs = SURVIVAL_GetAllRefsInLootGroup( "firing_range_all_weapons" )

	                                              
		if ( IsGoldenHorse_FR() )
			weaponRefs.append( TITAN_SWORD_WEAPON_REF )
       

	array< LootData > lootData = LootRefs_To_LootDatas( weaponRefs )

	table< string, array<LootData> > lootDataByAmmoType

	foreach ( int i, LootData _lootData in lootData )
	{
		string ammoType = _lootData.ammoType
		if ( !GetWeaponInfoFileKeyField_GlobalBool( _lootData.baseWeapon, "uses_ammo_pool" ) )
			ammoType = "_none"

		if ( !( ammoType in lootDataByAmmoType ) )
			lootDataByAmmoType[ ammoType ] <- []
		lootDataByAmmoType[ ammoType ].append( _lootData )
	}

	int rackIndex = 0
	// Make sure "_none" is last
	foreach( string ammoType, array<LootData> _lootDataArray in lootDataByAmmoType )
	{
		if ( rackIndex >= rackNodes.len() )
			break
		if ( ammoType == "_none" )
			continue
                            
		if( IsUsingConsolidatedLoot() )
		{
			ConsolidatedLoot_CreateWeaponRacksForLoot( rackNodes[rackIndex], _lootDataArray, ammoType, realm )
		}
		else
		{
			CreateWeaponRacksForLoot( rackNodes[rackIndex], _lootDataArray, ammoType, realm )
		}
      
                                                                                   
       
		rackIndex++
	}
	// Now do "_none"
	foreach( string ammoType, array<LootData> _lootDataArray in lootDataByAmmoType )
	{
		if ( rackIndex >= rackNodes.len() )
			break
		if ( ammoType != "_none" )
			continue

                            
		if( IsUsingConsolidatedLoot() )
		{
			ConsolidatedLoot_CreateWeaponRacksForLoot( rackNodes[rackIndex], _lootDataArray, ammoType, realm )
		}
		else
		{
			CreateWeaponRacksForLoot( rackNodes[rackIndex], _lootDataArray, ammoType, realm )
		}
      
                                                                                   
       
		rackIndex++
	}

	if ( !file.hasSpawnedWeaponRacks )
	{
		file.hasSpawnedWeaponRacks = true
	}

	                         
		FRSettings_InitDefaults( realm )
       
}

void function CreateAttachmentNodeForBowRack( entity node )
{
	if( s_attachmentNodeForBowCreated )
		return

	AddAttachmentNode( CreateInfoTarget( <30675.0, -5900.0, -29164.0>, <0, 90, 0> ), node )
	s_attachmentNodeForBowCreated = true
}

// TODO: CLEANUP. Old function.
void function CreateWeaponRacksForLoot( entity node, array<LootData> _lootDataArray, string ammoType, int realm )
{
	int numRacks = _lootDataArray.len()
	if ( numRacks == 0 )
		return

	vector rackAngles = node.GetAngles()
	vector forward = node.GetForwardVector()
	vector right = node.GetRightVector()
	vector up = node.GetUpVector()
	vector racksStart = (node.GetOrigin() + (right * STAGING_GUNRACK_SPACING * -3.0))

	file.attachmentPileFilters[ node ] <- []

	if ( ammoType == ARROWS_AMMO )
		CreateAttachmentNodeForBowRack( node )

	int rackIndex = 0
	foreach ( int i, LootData _lootData in _lootDataArray )
	{
		vector lootAngles = AnglesCompose( rackAngles, <-85, 180, 0> )

		if ( !LootIsSpawnable( _lootData ) )
			continue

		vector rackOrigin = racksStart + ( right * ( STAGING_GUNRACK_SPACING * rackIndex ) )
		if ( !file.hasSpawnedWeaponRacks )
		{
			// Spawn the rack
			entity rack = CreatePropDynamic( GUNRACK_MODEL, rackOrigin, rackAngles, SOLID_VPHYSICS )
		}

		// Spawn the weapon

		vector lootOrigin = rackOrigin + forward * 2 + up * 47
		if ( _lootData.ref == "mp_weapon_bow" || _lootData.ref == "mp_weapon_throwingknife" )
			lootAngles = AnglesCompose( lootAngles, <85, 0, 0> )

		                          
			if ( TitanSword_WeaponRefIsTitanSword( _lootData.ref ) )
				lootAngles = AnglesCompose( lootAngles, <270, 180, 0> )
        

		entity lootEnt = SpawnGenericLoot( _lootData.ref, lootOrigin , lootAngles, 500 )

		lootEnt.SetNetworkDistanceCull( false )
		lootEnt.e.recreateLootOnPickup = true
		file.attachmentPileFilters[ node ].append( _lootData.ref )

		lootEnt.RemoveFromAllRealms()
		lootEnt.AddToRealm( realm )

		AddStagingCleanupEnt( lootEnt )

		rackIndex++
	}

	if ( ammoType != "_none" )
	{
		const int AMMO_BOX_COUNT = 6
		const int AMMO_BOX_PER_ROW = 3

		LootData ammoLootData = SURVIVAL_Loot_GetLootDataByRef( ammoType )

		if ( ammoType == ARROWS_AMMO )
			right *= -1

		for ( int idx = 0 ; idx < AMMO_BOX_COUNT ; ++idx )
		{
			int rowIdx = (idx % AMMO_BOX_PER_ROW)
			int colIdx = (idx / AMMO_BOX_PER_ROW)
			vector ammoBasePos = (racksStart + (right * ((STAGING_GUNRACK_SPACING) * rackIndex - 5.0)))
			vector pos = (ammoBasePos + (forward * rowIdx * 16.0) + (right * colIdx * 25.0))

			vector ang = <0, 90, 0>
			entity ammoLootEnt = SpawnGenericLoot( ammoType, pos, ang, ammoLootData.countPerDrop )
			ammoLootEnt.SetNetworkDistanceCull( false )
			ammoLootEnt.e.recreateLootOnPickup = true

			ammoLootEnt.RemoveFromAllRealms()
			ammoLootEnt.AddToRealm( realm )

			AddStagingCleanupEnt( ammoLootEnt )
		}

		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			vector ordnanceBasePos = (racksStart + (right * ((STAGING_GUNRACK_SPACING) * rackIndex + 45.0)))
			CreateOrdnanceForRealmNode( realm, node, ordnanceBasePos )
		}
	}
}

                           
array< LootData > function CLoot2_Get_SpawnedWeaponData()
{
	array< LootData > result
	foreach( ammoType in file.ammoTypesUsed )
	{
		result.extend( file.weaponDataByAmmoType[ ammoType ] )
	}
	return result
}

void function ConsolidatedLoot_CreateWeaponRacksForLoot( entity node, array<LootData> _lootDataArray, string ammoType, int realm )
{
	int numRacks = _lootDataArray.len()
	if ( numRacks == 0 )
		return

	vector rackAngles = node.GetAngles()
	vector forward = node.GetForwardVector()
	vector right = node.GetRightVector()

	// if the Node's name == CONSOLIDATEDLOOT_WEAPONRACK_NAME2, then we're going LEFT and need to reverse the right vector.
	#if DEVELOPER
		printt( format( "%s(): node name == %s", FUNC_NAME(), node.GetScriptName() ) )
	#endif
	float spacingMultiplier = -3.0
	if( node.GetScriptName() == CONSOLIDATEDLOOT_WEAPONRACK_NAME2 )
	{
		right = -1 * right
		spacingMultiplier = 3.0
	}

	vector racksStart = node.GetOrigin()
	//vector racksStart = (node.GetOrigin() + (right * STAGING_GUNRACK_SPACING * spacingMultiplier))

	file.attachmentPileFilters[ node ] <- []

	if ( ammoType == ARROWS_AMMO )
		CreateAttachmentNodeForBowRack( node )

	int rackIndex = 0
	foreach ( int i, LootData _lootData in _lootDataArray )
	{
		vector lootAngles = AnglesCompose( rackAngles, <-85, 180, 0> )

		if ( !LootIsSpawnable( _lootData ) )
			continue

		// Spawn the rack
		const int STAGING_GUNRACK_CONSOLIDATED_SPACING = 24 // default was 28
		vector rackOrigin = racksStart + ( right * ( STAGING_GUNRACK_CONSOLIDATED_SPACING * rackIndex ) )
		entity rack = CreatePropDynamic( GUNRACK_MODEL, rackOrigin, rackAngles, SOLID_VPHYSICS )

		rack.RemoveFromAllRealms()
		rack.AddToRealm( realm )

		AddStagingCleanupEnt( rack )

		// Spawn the weapon
		vector lootOrigin = PositionOffsetFromEnt( rack, 2, 0, 47 )
		if ( _lootData.ref == "mp_weapon_bow" || _lootData.ref == "mp_weapon_throwingknife" )
			lootAngles = AnglesCompose( lootAngles, <85, 0, 0> )

		                          
			if ( TitanSword_WeaponRefIsTitanSword( _lootData.ref ) )
				lootAngles = AnglesCompose( lootAngles, <270, 180, 0> )
        

		entity lootEnt = SpawnGenericLoot( _lootData.ref, lootOrigin , lootAngles, 500 )

		lootEnt.SetNetworkDistanceCull( false )
		lootEnt.e.recreateLootOnPickup = true
		file.attachmentPileFilters[ node ].append( _lootData.ref )

		lootEnt.RemoveFromAllRealms()
		lootEnt.AddToRealm( realm )

		AddStagingCleanupEnt( lootEnt )

		if ( ammoType != "_none" )
		{
			LootData ammoLootData = SURVIVAL_Loot_GetLootDataByRef( ammoType )

			if ( ammoType == ARROWS_AMMO )
				right *= -1

			vector pos = rackOrigin + (forward * STAGING_AMMO_OFFSET_FROM_GUNRACK)

			vector ang = < 0, 90, 0 >
			entity ammoLootEnt = SpawnGenericLoot( ammoType, pos, ang, ammoLootData.countPerDrop )
			ammoLootEnt.SetNetworkDistanceCull( false )
			ammoLootEnt.e.recreateLootOnPickup = true

			ammoLootEnt.RemoveFromAllRealms()
			ammoLootEnt.AddToRealm( realm )

			AddStagingCleanupEnt( ammoLootEnt )
		}

		rackIndex++
	}
}
      

                         

void function FRSettings_InitDefaults( int realm )
{
	FRIntSettings_InitDefaults( realm )
	FRBoolSettings_InitDefaults( realm )
}

void function FRIntSettings_InitDefaults( int realm )
{
	// If Realm doesn't have a IntSettings table, create one with defaults in it.
	if( !( realm in file.frIntSettings ) )
	{
		table< int, int > newIntSettings = FRIntSettings_CreateDefault()
		file.frIntSettings[ realm ] <- newIntSettings
	}
}

table< int, int > function FRIntSettings_CreateDefault()
{
	table< int, int > newSettings
	for( int intSettingNDX = frIntSettings_NDX_Start; intSettingNDX < frIntSettings_NDX_End; intSettingNDX++ )
	{
		newSettings[ intSettingNDX ] <- frIntSettings_Defaults[ intSettingNDX ]
	}
	return newSettings
}

// ---

void function FRBoolSettings_InitDefaults( int realm )
{
	// If Realm doesn't have a IntSettings table, create one with defaults in it.
	if( !( realm in file.frBoolSettings ) )
	{
		table< int, bool > newSettings = FRBoolSettings_CreateDefault()
		file.frBoolSettings[ realm ] <- newSettings
	}
}

table< int, bool > function FRBoolSettings_CreateDefault()
{
	table< int, bool > newSettings
	for( int SettingNDX = frBoolSettings_NDX_Start; SettingNDX < frBoolSettings_NDX_End; SettingNDX++ )
	{
		newSettings[ SettingNDX ] <- frBoolSettings_Defaults[ SettingNDX ]
	}
	return newSettings
}

      

