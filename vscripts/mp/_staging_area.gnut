void function AddStagingCleanupEnt( entity ent )
{
	file.stagingCleanupEnts.append( ent )
}

void function AddStagingCleanupEnts( array<entity> ents )
{
	file.stagingCleanupEnts.extend( ents )
}

void function OnPlayerLootPickedUp( entity player, entity ent, string ref, int unitsPickedUp, bool willDestroy, entity deathBox, int pickupFlags )
{
	if ( !willDestroy )
		return

	if ( !ent.e.recreateLootOnPickup )
	{
		return
	}

	if ( GetGameState() >= eGameState.Playing )
		return

	//if ( PlayerMatchState_GetFor( player ) != ePlayerMatchState.STAGING_AREA )
	//	return

	//LootData lootData = SURVIVAL_Loot_GetLootDataByRef( ref )

	// Give ammo to the player that picked up the weapon
	/*
	LootData lootData = SURVIVAL_Loot_GetLootDataByRef( ref )
	if ( lootData.lootType == eLootType.MAINWEAPON )
	{
		//foreach ( ammoRef, value in eAmmoPoolType )
		for ( int i = 0 ; i < eAmmoPoolType._count ; i++ )
			player.AmmoPool_SetCount( i, 100 )
	}
	*/

	// Store off some info about the loot before it goes away
	vector origin = ent.GetOrigin()
	vector angles = ent.GetAngles()
	array<int> realms = ent.GetRealms()
	string pstr = "| Looted " + ref + " in realms:"
	foreach( int realm in realms )
		pstr += " " + realm
	//printt( pstr )

	float waitTime = ITEM_RESPAWN_TIME

	                   
		int lootSrc = eFRLootSource.GROUND
		string lootSrcStr = "GROUND"

		if ( IsVendingMachine( deathBox ) )
		{
			waitTime = 0.0
			lootSrc = eFRLootSource.SUPPLYBOX
			lootSrcStr = "SUPPLYBOX"
		}
		else if ( IsValid( deathBox ))
		{
			string ornull deathBoxType = deathBox.GetNetworkedClassName()
			if( deathBoxType == null )
			{
				expect string( deathBoxType )
				deathBoxType = "ERROR"
			}
			expect string( deathBoxType )

			string errMsg = format( "%s(): Death Box %s does not have a networked classname.", FUNC_NAME(), string( deathBox ) )
			Assert( deathBoxType != "ERROR", errMsg )

			switch( deathBoxType )
			{
				case "prop_loot_grabber":
					lootSrc = eFRLootSource.BLACKMARKET
					lootSrcStr = "BLACKMARKET"
					break
				default:
					lootSrc = eFRLootSource.OTHERSOURCE
					lootSrcStr = "OTHERSOURCE"
					break
			}
		}
		PIN_FiringRange_Loot_Pickup_Source( player, ref, lootSrc, lootSrcStr, origin )
		#if DEVELOPER
			DEV_Print( format( "%s(): %s Picked up %s from source == %s at %s", FUNC_NAME(), player.GetPlayerName(), ref, lootSrcStr, string( origin ) ) )
		#endif // DEVELOPER
       

	thread ReplenishLoot( ref, origin, angles, realms, waitTime, player )
}

                   
void function FRReplenishLootFromBlackMarketMerge( entity ent, bool isVendingMachine )
{
	Assert( IsValid(ent), "Passing null loot ent!" )

	LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )
	string ref = data.ref
	vector origin = ent.GetOrigin()
	vector angles = ent.GetAngles()
	array<int> realms = ent.GetRealms()

	float waitTime = isVendingMachine ? 0.0 : ITEM_RESPAWN_TIME

	thread ReplenishLoot( ref, origin, angles, realms, waitTime, null )
}


void function FRReplenishAmmoBrick( entity ent, int initialCount, entity deathbox )
{
	Assert( IsValid(ent), "Passing null loot ent!" )
	Assert( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ), "This should only be used in the firing range!" )

	bool isVendingMachine = false
	if ( IsVendingMachine( deathbox ) )
	{
		isVendingMachine = true
	}

	float waitTime = isVendingMachine ? 0.0 : ITEM_RESPAWN_TIME

	thread FRReplenishAmmoBrick_Thread( ent, initialCount, waitTime )
}

void function FRReplenishAmmoBrick_Thread( entity ent, int initialCount, float waitTime )
{
	EndSignal( ent, "OnDestroy", "fr_ammo_respawn_now" )

	OnThreadEnd(
		function() : ( ent, initialCount )
		{
			ent.SetClipCount( initialCount )
		}
	)

	if ( waitTime > 0.0 )
	{
		wait waitTime
	}
	else
	{
		WaitFrame()
	}
}
                         

void function ReplenishLoot( string ref, vector origin, vector angles, array<int> realms, float waitTime, entity player )
{
	if ( waitTime > 0.0 )
	{
		wait waitTime
	}

	if ( GetGameState() >= eGameState.Playing )
		return

	// Recreate the loot
	int clipCount = -1
	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )

	if ( data.lootType != eLootType.MAINWEAPON )
	{
		clipCount = data.countPerDrop
	}

	entity lootEnt = SpawnGenericLoot( ref, origin, angles, clipCount )
	lootEnt.e.recreateLootOnPickup = true
	lootEnt.SetNetworkDistanceCull( false )

	if ( GetCurrentPlaylistVarBool( "survival_staging_gun_skins", true ) && data.lootType == eLootType.MAINWEAPON )
	{
		entity rangeLeader = RangeMaster_Get_ByPlayer( player )
		ApplySkinToWeapon( lootEnt, rangeLeader )
	}

	lootEnt.RemoveFromAllRealms()
	foreach( int realm in realms )
		lootEnt.AddToRealm( realm )
	AddStagingCleanupEnt( lootEnt )
}

void function ApplySkinToWeapon( entity weapon, entity player )
{
	ItemFlavor ornull weaponItemOrNull = GetWeaponItemFlavorByClass( weapon.GetWeaponName() )
	ItemFlavor ornull weaponSkinOrNull = null
	ItemFlavor ornull weaponCharmOrNull = null

	if ( weaponItemOrNull != null )
	{
		weaponSkinOrNull = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_WeaponSkin( expect ItemFlavor( weaponItemOrNull ) ) )
		weaponCharmOrNull = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_WeaponCharm( expect ItemFlavor(weaponItemOrNull) ) )
	}

	if ( weaponSkinOrNull != null || weaponCharmOrNull != null )
		WeaponCosmetics_Apply( weapon, weaponSkinOrNull, weaponCharmOrNull )
}

void function Staging_OnLootSpawn( entity ent, LootData data, int count )
{
	if ( GetGameState() >= eGameState.Playing )
		return

	EndSignal( ent, "OnDestroy" )

	WaitFrame()

	if ( ent.e.spawnSource != eSpawnSource.PLAYER_DROP )
		return

	entity owner = ent.GetOwner()
	if ( IsValid( owner ) )
	{
		int ownerRealm = GetFiringRangeRealm( owner )
		ent.RemoveFromAllRealms()
		ent.AddToOtherEntitysRealms( owner )
		AddStagingCleanupEnt ( ent )
		if ( FRC_IsChallengeActive( ownerRealm ) )
		{
			ent.UnsetUsable()
		}

	}
	                  
	if ( data.lootType == eLootType.COLLECTABLE_NESSIE )
	{
		return
	}
       

	wait 0.5
	ent.Dissolve( ENTITY_DISSOLVE_CORE, <0,0,0>, 500 )
	wait 1.0
	ent.Destroy()
}

void function StagingCleanup()
{
	AddStagingCleanupEnts( GetRackNodesArray() )
	AddStagingCleanupEnts( GetAttachmentNodesArray() )
	AddStagingCleanupEnts( GetEntArrayByScriptName( "shooting_range_rotating_target" ) )
	AddStagingCleanupEnts( GetEntArrayByScriptName( "shooting_range_folding_target" ) )

	Loot_RemoveCallback_OnPlayerLootPickup( OnPlayerLootPickedUp )

	foreach( entity ent in file.stagingCleanupEnts )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}
}

void function RemoveStagingAreaEntsForRealm( int realm )
{
	foreach( entity ent in file.stagingCleanupEnts )
	{
		if ( !IsValid( ent ) )
			continue

		if ( !ent.IsInRealm( realm ) )
			continue

		ent.Destroy()
	}
}

void function SetWeaponSkinsByPlayer( entity player )
{
	if( !IsValid( player ) )
		return

	foreach ( entity ent in file.stagingCleanupEnts )
	{
		if ( !IsValid( ent ) )
			continue

		if ( ent.GetNetworkedClassName() != "prop_survival" )
			continue

		if ( !ent.DoesShareRealms( player ) )
			continue

		int lootIndex = ent.GetSurvivalInt()
		LootData ld = SURVIVAL_Loot_GetLootDataByIndex( lootIndex )
		bool isWeapon = ld.lootType == eLootType.MAINWEAPON

		if ( !isWeapon )
			continue

		ApplySkinToWeapon( ent, player )
	}
}

void function FinalizeRealmWhenPopulated_Thread( int realm )
{
	while( GetAllPlayersByTeamOrRealm( realm, realm ).len() == 0 )
	{
		WaitFrame()
	}

	// TODO: Space intentionally left blank for any initialization that needs to be done once realm is populated.
}

// Create the Resident Dummies for the realm.
void function FR_ResidentDummies_CreateInRealm( int realm )
{
	if( !( realm in file.residentDummiesSpawned ) )
	{
		file.residentDummiesSpawned[ realm ] <- false
	}

	if( file.residentDummiesSpawned[ realm ] )
		return

	bool isPotentialCombatDummie = true
	bool overrideShields = false
	int shieldLevel = FRSetting_ShieldLevel_Get( realm )

	array< entity > dummypts = GetEntArrayByScriptName( "spawnpoint_frdummy" )
	foreach( dummypt in dummypts)
	{
		CreateRespawningTrainingDummyInRealm( realm, dummypt.GetOrigin(), dummypt.GetAngles(), isPotentialCombatDummie, overrideShields, shieldLevel )
	}

	file.residentDummiesSpawned[ realm ] <- true
}

////////////////////////////

void function FullCombatDummies_Start_ByPlayer( entity player )
{
	int realm = GetPlayerSquadRealm( player )
	if ( realm < 0 )
		return

	// TODO: CLEANUP
	//RegisterSignal( "FullCombatDummies_Start_ByPlayer" )
	if ( s_combatRealms.contains( realm ) )
	{
		                         
			file.stagingRealm_combatDummiesEnabled[ realm ] <- true
        
		player.Signal( "FullCombatDummies_Start_ByPlayer" )
		return
	}

	thread function() : (player, realm)
	{
		                         
			file.stagingRealm_combatDummiesEnabled[ realm ] <- true
        
		s_combatRealms.append( realm )
		OnThreadEnd( function() : (realm)
		{
			s_combatRealms.fastremovebyvalue( realm )
			Dummies_Reset( realm )
			                         
				file.stagingRealm_combatDummiesEnabled[ realm ] <- false
         
		} )

		player.EndSignal( "OnDestroy" )
		player.EndSignal( "FullCombatDummies_Start_ByPlayer" )
		Dummies_Reset( realm )

		WaitForever()
	}()
}

bool function FullCombatDummies_IsEnabled( int realm )
{
	if( !( realm in file.stagingRealm_combatDummiesEnabled ) )
	{
		file.stagingRealm_combatDummiesEnabled[ realm ] <- false
	}

	return( file.stagingRealm_combatDummiesEnabled[ realm ] )
}

                         
void function FullCombatDummies_Stop_ByPlayer( entity player )
{
	int realm = GetPlayerSquadRealm( player )
	if ( realm < 0 )
		return

	file.stagingRealm_combatDummiesEnabled[ realm ] <- false

	// TODO: CLEANUP
	//RegisterSignal( "FullCombatDummies_Start_ByPlayer" )
	if ( s_combatRealms.contains( realm ) )
	{
		s_combatRealms.fastremovebyvalue( realm )
		FR_ResidentDummies_DestroyInRealm( realm )

		// TODO: Tell All realm players' UI that FullCombatDummies are off.
	}
}

// Destroy all FR dummies so they will auto-respawn.
void function UICallback_FRDummies_Reset( entity player )
{
	if( !IsValid( player ) )
		return

	if( !player.IsPlayer() )
		return

	int realm = GetPlayerSquadRealm( player )
	//FRDummies_Reset( realm )
	FR_ResidentDummies_DestroyInRealm( realm )
}
      

void function FR_ResidentDummies_DestroyInRealm( int realm, bool endRespawnThreads = false)
{
	if ( !( realm in s_FRDummiesInRealm) )
		return

	if ( endRespawnThreads )
	{
		RealmInfoEntity_Signal( realm, "PermanentlyDestroyFRDummyTarget" )
	}

	array<entity> npcs = clone( s_FRDummiesInRealm[realm] )
	foreach( entity npc in npcs )
	{
		DummieDespawn( npc )
	}

	if ( endRespawnThreads )
	{
		s_FRDummiesInRealm[realm].clear()
		file.residentDummiesSpawned[ realm ] <- false
	}
}

// TODO: Figure out how to ensure they spawn in their home points upon being killed.
void function CreateRespawningTrainingDummyInRealm( int realm, vector spawnOrigin, vector spawnAngles, bool isPotentialCombatDummie, bool overrideShieldLevel, int shieldLevel )
{
	if ( !( realm in s_FRDummiesInRealm) )
		s_FRDummiesInRealm[realm] <- []

	thread Respawning_FRDummy_Thread( realm, spawnOrigin, spawnAngles, isPotentialCombatDummie, overrideShieldLevel, shieldLevel )
}

void function Respawning_FRDummy_Thread( int realm, vector spawnOrigin, vector spawnAngles, bool isPotentialCombatDummie, bool overrideShieldLevel, int shieldLevel )
{
	RealmInfoEntity_EndSignal( realm, "PermanentlyDestroyFRDummyTarget" )

	for( ;; )
	{
		wait RandomFloatRange( 1.0, 2.0 )
		int thisShieldLevel = shieldLevel
		entity npc
		bool doCombat = s_combatRealms.contains( realm )

		if ( doCombat && isPotentialCombatDummie )
		{
                            
			if ( !overrideShieldLevel )
			{
				thisShieldLevel = FRSetting_ShieldLevel_Get( realm )
			}
        
                                    
         
			npc = SpawnNPCCombatDummie( spawnOrigin, spawnAngles, thisShieldLevel )
		}
		else
		{
			                         
				if ( !overrideShieldLevel )
				{
					thisShieldLevel = FRSetting_ShieldLevel_Get( realm )
				}
         

			npc = SpawnNPCTrainingDummy( spawnOrigin, spawnAngles, thisShieldLevel )
		}

		if ( !IsValid( npc ) )
			continue

		s_FRDummiesInRealm[realm].append( npc )
		npc.RemoveFromAllRealms()
		npc.AddToRealm( realm )
		// npc.SetNetworkDistanceCullEnabled( false ) // S3: entity method not available at compile time

		                         
			// Spawn FX for the FR Dummie.
			thread DummieFX_Spawn_Thread( npc )

			if ( FRSetting_DummieHighlightsOn_Get( realm ) )
			{
				Highlight_SetEnemyHighlight( npc, COMBATRANGE_DUMMIE_HIGHLIGHT )
			}

			// Do a behavior based on Behavior Bools.
			table< int, bool > behaviorSettings = FRDummie_BehaviorData_Get( realm )
			thread Dummie_Choose_And_Perform_Behavior( npc, behaviorSettings )
        

		npc.WaitSignal( "OnDestroy" )
		s_FRDummiesInRealm[realm].fastremovebyvalue( npc )

		if ( doCombat )
		{
			while ( s_FRDummiesInRealm[realm].len() > 0 )
			{
				WaitFrame()
			}
			wait RandomFloatRange( 4.0, 5.0 )
		}
	}
}

array< entity > function FRDummies_Get( int realm )
{
	if( !( realm in s_FRDummiesInRealm ) )
	{
		s_FRDummiesInRealm[ realm ] <- []
	}

	return( s_FRDummiesInRealm[ realm ] )
}

void function StagingArea_AddLootDataRefToNotSpawn( string lootDataRef )
{
	file.lootDataRefsToNotSpawn.append( lootDataRef )
}


array<LootData> function FilterLootDataByRefsToNotSpawn( array<LootData> lootData )
{
	array<LootData> clonedLootData = clone( lootData )
	foreach ( LootData data in lootData )
	{
		if ( file.lootDataRefsToNotSpawn.contains( data.ref ) )
			clonedLootData.fastremovebyvalue( data )
	}

	return clonedLootData
}

                         
int function GetCurrentTargetSpeedForPlayerRealm( entity player )
{
	// Returns the current Target Speed SETTING, not the speed itself.
	int realm = GetPlayerSquadRealm( player )

	return( FRSetting_TargetSpeed_Get( realm ) )
}
      

