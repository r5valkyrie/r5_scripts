void function InitializeAttachmentNodes()
{
	s_attachmentNodes.clear()
                           
	if( IsUsingConsolidatedLoot() )
	{
		s_attachmentNodes = GetEntArrayByScriptName( "attachments_consolidated" )
	}
	else
	{
		s_attachmentNodes = GetEntArrayByScriptName( "attachments" )
	}
     
                                                             
      
}


array<entity> function GetAttachmentNodesArray()
{
	return s_attachmentNodes
}


void function AddAttachmentNode( entity attachmentNode, entity parentNode )
{
	s_attachmentNodes.append( attachmentNode )

	parentNode.LinkToEnt( attachmentNode )
}


void function CreateAttachmentsForRealm( int realm )
{
	array<entity> attachmentNodes = GetAttachmentNodesArray()
	vector areaMins = < -45, -180, 0 >
	vector areaMaxs = < 160, 180, 0 >

	foreach( entity node in attachmentNodes )
	{
		array<LootData> lootData = GetAttachmentsForPile( node )
		int numAttachments = lootData.len()
		vector forward = node.GetForwardVector()
		vector right = node.GetRightVector()

		for ( int i = 0 ; i < numAttachments ; i++ )
		{
			const int ITEMS_PER_ROW = 5
			const float DIST_PER_ITEM_FORWARD = 28.0
			const float DIST_PER_ITEM_RIGHT = 28.0
			const float OFFSET_FORWARD = 380.0
			const float OFFSET_RIGHT = 80.0

			int rowIdx = (i % ITEMS_PER_ROW)
			int colIdx = (i / ITEMS_PER_ROW)
			vector pos = node.GetOrigin() + (forward * (-DIST_PER_ITEM_FORWARD * colIdx + OFFSET_FORWARD) ) + (right * (DIST_PER_ITEM_RIGHT * rowIdx + OFFSET_RIGHT) )
			vector ang = < 0, 90, 0 >

			entity lootEnt = SpawnGenericLoot( lootData[i].ref, pos, ang )
			lootEnt.SetNetworkDistanceCull( false )
			lootEnt.e.recreateLootOnPickup = true

			lootEnt.RemoveFromAllRealms()
			lootEnt.AddToRealm( realm )

			AddStagingCleanupEnt( lootEnt )
		}
	}
}

void function CreateOrdnanceForRealmNode( int realm, entity node, vector basePos )
{
	array<LootData> lootData = SURVIVAL_Loot_GetByType( eLootType.ORDNANCE )

	{
		vector forward = node.GetForwardVector()
		vector right = node.GetRightVector()
		foreach( int index, LootData ld in lootData )
		{
			if ( ld.conditional && !SURVIVAL_Loot_RunConditionalCheck( ld.ref, null ) )
				continue
			if ( ld.ref.find( WEAPON_SUFFIX_NONCOMBAT ) > 0 ) // don't spawn pets/noncombat weapons
				continue

			const int ITEMS_PER_ROW = 1
			const float DIST_PER_ITEM_FORWARD = 15.0
			const float DIST_PER_ITEM_RIGHT = 10.0
			const float OFFSET_FORWARD = 0.0
			const float OFFSET_RIGHT = 0.0
			const vector EXTRA_BUMP = <0.0, 0.0, 3.0>

			int rowIdx = index

			for ( int colIdx = 0; colIdx < 2; ++colIdx )
			{
				vector pos = basePos + (forward * (DIST_PER_ITEM_FORWARD * rowIdx + OFFSET_FORWARD) ) + (right * (DIST_PER_ITEM_RIGHT * colIdx + OFFSET_RIGHT)) + EXTRA_BUMP
				vector ang = < 0, 0, 0 >

				entity lootEnt = SpawnGenericLoot( ld.ref, pos, ang )
				lootEnt.SetNetworkDistanceCull( false )
				lootEnt.e.recreateLootOnPickup = true
				lootEnt.RemoveFromAllRealms()
				lootEnt.AddToRealm( realm )
				AddStagingCleanupEnt( lootEnt )
			}
		}
	}
}

array<LootData> function GetLootDataToUse_Shields()
{
	// Wants to be: SURVIVAL_Loot_GetByType( eLootType.ARMOR )

	array<LootData> results

	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv1_evolving" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv2_evolving" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv3_evolving" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv4_all_fast" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv5_evolving" ) )

	// Bringing back EVO shields per request from R5DEV-393409
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv1" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv2" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv3" ) )
	results.append( SURVIVAL_Loot_GetLootDataByRef( "armor_pickup_lv4_all_fast" ) )

	return results
}

array<LootData> function GetLootDataToUse_Helmets()
{
	array< LootData > results = SURVIVAL_Loot_GetByType( eLootType.HELMET )
	return results
}


void function CreateGearForRealm( int realm )
{
	array<array<LootData> > lootDataRows
	lootDataRows.append( GetLootDataToUse_Shields() )
	lootDataRows.append( SURVIVAL_Loot_GetByType( eLootType.HELMET ) )
	lootDataRows.append( SURVIVAL_Loot_GetByType( eLootType.BACKPACK ) )
	lootDataRows.append( SURVIVAL_Loot_GetByType( eLootType.INCAPSHIELD ) )
	
	array<array<LootData> > clonedData = clone lootDataRows
	foreach( int rowIndex, array<LootData> ldRow in clonedData )
	{
		foreach( int colIdx, LootData ld in ldRow )
		{
			if ( SURVIVAL_EquipmentPretendsToBeBlank( ld.ref ) )
				lootDataRows[rowIndex].removebyvalue( ld )
		}
	}
	
	array<entity> attachmentNodes = GetAttachmentNodesArray()
	foreach( int index, entity node in attachmentNodes )
	{
		if ( (index < 1) || (index > 3) )
			continue

		vector forward = node.GetForwardVector()
		vector right = node.GetRightVector()

		foreach( int rowIndex, array<LootData> ldRow in lootDataRows )
		{
			foreach( int colIdx, LootData ld in ldRow )
			{
				if ( ld.conditional && !SURVIVAL_Loot_RunConditionalCheck( ld.ref, null ) )
					continue

				const int ITEMS_PER_ROW = 1
				const float DIST_PER_ITEM_FORWARD = 30.0 // was 32.0
				const float DIST_PER_ITEM_RIGHT = -32.0
				const float OFFSET_FORWARD = -130.0
				const float OFFSET_RIGHT = 195.0
				const vector EXTRA_BUMP = <0.0, 0.0, 0.0>

				vector pos = node.GetOrigin() + (forward * (DIST_PER_ITEM_FORWARD * rowIndex + -1.0 * colIdx + OFFSET_FORWARD) ) + (right * (DIST_PER_ITEM_RIGHT * colIdx + OFFSET_RIGHT)) + EXTRA_BUMP
				vector ang = < 0, 0, 0 >

				entity lootEnt = SpawnGenericLoot( ld.ref, pos, ang )
				lootEnt.SetNetworkDistanceCull( false )
				lootEnt.e.recreateLootOnPickup = true
				lootEnt.RemoveFromAllRealms()
				lootEnt.AddToRealm( realm )
				AddStagingCleanupEnt( lootEnt )
			}
		}
	}
}

void function CreateHealthItemsForRealm( int realm )
{
	array<array<LootData> > lootDataRows
	lootDataRows.append( SURVIVAL_Loot_GetByType( eLootType.HEALTH ) )

	array<entity> attachmentNodes = GetAttachmentNodesArray()
	foreach( int index, entity node in attachmentNodes )
	{
		if ( (index < 1) || (index > 3) )
			continue

		vector forward = node.GetForwardVector()
		vector right = node.GetRightVector()

		foreach( int rowIndex, array<LootData> ldRow in lootDataRows )
		{
			foreach( int colIdx, LootData ld in ldRow )
			{
				if ( ld.conditional && !SURVIVAL_Loot_RunConditionalCheck( ld.ref, null ) )
					continue

				const int ITEMS_PER_ROW = 1
				const float DIST_PER_ITEM_FORWARD = 22.0
				const float DIST_PER_ITEM_RIGHT = -22.0
				const float OFFSET_FORWARD = -130.0
				const float OFFSET_RIGHT = -80.0 // was - 50.0
				const vector EXTRA_BUMP = <0.0, 0.0, 0.0>

				vector pos = node.GetOrigin() + (forward * (DIST_PER_ITEM_FORWARD * rowIndex + -1.0 * colIdx + OFFSET_FORWARD) ) + (right * (DIST_PER_ITEM_RIGHT * colIdx + OFFSET_RIGHT)) + EXTRA_BUMP
				vector ang = < 0, 0, 0 >

				LootData data = SURVIVAL_Loot_GetLootDataByRef( ld.ref )
				int clipCount = data.countPerDrop

				entity lootEnt = SpawnGenericLoot( ld.ref, pos, ang, clipCount )
				lootEnt.SetNetworkDistanceCull( false )
				lootEnt.e.recreateLootOnPickup = true
				lootEnt.RemoveFromAllRealms()
				lootEnt.AddToRealm( realm )
				AddStagingCleanupEnt( lootEnt )
			}
		}
	}
}

array<LootData> function GetAttachmentsForPile( entity node )
{
	array<string> weaponFilters = []
	entity parentNode = node.GetLinkParent()
	if ( IsValid( parentNode ) && parentNode in file.attachmentPileFilters )
		weaponFilters = file.attachmentPileFilters[ parentNode ]

	array<LootData> lootData = FilterLootDataByRefsToNotSpawn( SURVIVAL_Loot_GetByType_InLevel( eLootType.ATTACHMENT, -1 ) )
	if ( weaponFilters.len() == 0 )
		return lootData

                           
	if( IsUsingConsolidatedLoot() )
		return lootData
	else
		return( GetValidAttachments( lootData, weaponFilters ) )
     
                                                         
      

	unreachable
}

array< LootData > function GetValidAttachments( array< LootData > lootData, array< string > weaponFilters )
{
                           
	if( IsUsingConsolidatedLoot() )
	{
		return lootData
	}
	else
	{
		array<LootData> validAttachments
		foreach( LootData data in lootData )
		{
			foreach( string weapon in weaponFilters )
			{
				if ( CanAttachToWeapon( data.ref, weapon ) && !validAttachments.contains( data ) )
				{
					validAttachments.append( data )
				}
			}
		}
		return validAttachments
	}

     
                                 
                                     
  
                                           
   
                                                                                     
    
                                   
    
   
  
                        
      

	unreachable
}


