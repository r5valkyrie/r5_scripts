#if DEVELOPER
bool devPrint = false
void function DEV_Print( string toPrint )
{
	if( devPrint )
	{
		printt( format( "%s(): %s", FUNC_NAME(), toPrint ))
	}
}

void function DEV_PrintEnable( bool isOn )
{
	devPrint = isOn
}
                   
void function DEV_Record_Training_Bloodhound_Hillslide()
{
	vector startPos = <-10795.7422, 506.074341, 1581.24622>
	vector startAng = <-5.36441803e-05, -0.343279809, -5.36441803e-05>
	vector endPos = <-7312.84717, 405.521118, -19.9930382>
	vector endAng = <-0.00253736973, 179.997314, -0.000686645508>

	entity player = GetPlayerArray()[0]
	string name = "training_bloodhound_hillslide_mu1"

	player.SetOrigin( startPos )
	player.SetAngles( startAng )

	DebugDrawSphere( endPos, 25, 0, 255, 0, true, 100 )

	int length = 10
	thread AnimRecordPlayer_Thread( length, name )
}

