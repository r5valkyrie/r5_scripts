void function Survival_SetStagingAreaSettings( entity player )
{
	if ( IsPVEMode() )
		return

	printt( "Survival_SetPrematchSettings", player )

	if ( !file.stagingAreaEnabled && !IsEventFinale() )
	{
		Survival_SetInventoryEnabled( player, false )
		player.FreezeControlsOnServer()
		AddCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD )
	}

	player.EndSignal( "OnDeath" )

	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		PlayerMatchState_Set( player, ePlayerMatchState.STAGING_AREA )

	if ( file.stagingAreaEnabled )
		PutPlayerInRealms( player )

	player.Minimap_Hide( player.GetTeam(), null )

	if ( !player.p.hasStagingAreaDamageProtection && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		AddEntityCallback_OnDamaged( player, StagingAreaPlayerTookDamageCallback )
		player.p.hasStagingAreaDamageProtection = true
	}

	if ( GetGameState() < eGameState.Playing && !IsEventFinale() ) //Survival_SetPrematchSettings is still called on late connecting players, however the clean-up script isn't.
			PlayMusicToPlayer( player, GetLobbyToCharacterSelectMusicTrack( player ) )

	// Refill offhand weapons
	foreach ( entity weapon in player.GetOffhandWeapons() )
	{
		if ( weapon.GetWeaponPrimaryClipCountMax() > 0 )
			weapon.SetWeaponPrimaryClipCount( weapon.GetWeaponPrimaryClipCountMax() )
	}

	entity ultimateWeapon = player.GetOffhandWeapon( OFFHAND_ULTIMATE )
	if ( IsValid( ultimateWeapon ) )
	{
		if ( GetCurrentPlaylistVarBool ( "staging_auto_ultimates", true ) && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		{
			int ammoMax = ultimateWeapon.GetWeaponPrimaryClipCountMax()

			ultimateWeapon.SetWeaponPrimaryClipCountNoRegenReset( ammoMax )
			Ultimates_OnPlayerUltIsReady( player, ultimateWeapon )
			StatusEffect_AddTimed( player, eStatusEffect.emp, 0.3, 0.3, 0.3 )
		}
		else
		{
			ultimateWeapon.SetWeaponPrimaryClipCount( 0 )
		}
	}
}

string function GetLobbyToCharacterSelectMusicTrack( entity player )
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return "Music_StagingArea"

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return MusicPack_GetFiringRangeMusic( GetMusicPackForPlayer( player ) )

	return MusicPack_GetLobbyIntoCharacterSelectMusic( GetMusicPackForPlayer( player ) )
}

void function Survival_ClearStagingAreaSettings( entity player )
{
	if ( IsPVEMode() )
		return

	printt( "Survival_ClearPrematchSettings", player )

	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	RemoveCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD )

	// Don't do anything while we're fading to black because you'll see pops and weapons being removed. Do it the moment we do character select screen instead
	//this doesn't seem to be needed? - JH 7.8.21
	//wait 3.0

	printf( "Clearing the rest of the prematch settings for player: " + player + "\n" )

	Survival_SetInventoryEnabled( player, true )
	ResetPlayerInventory( player )
	CharacterLoadouts_GiveCurrentCharacterLoadoutToPlayer( player, GetCurrentPlaylistVarBool( "dev_loadout_bypass_match_state", false )  )

	player.RemoveFromAllRealms()
	PutPlayerInDefaultRealms( player )

	player.Minimap_AlwaysShow( player.GetTeam(), null )
	player.Solid()
	player.Zipline_Stop()
	Signal( player, "ScriptAnimStop" )

	StopMusicOnPlayer( player, GetLobbyToCharacterSelectMusicTrack( player ) )
}

void function StagingAreaPlayerTookDamageCallback( entity ent, var damageInfo )
{
	Assert( GetGameState() < eGameState.Playing, "Player took damage and ran a damage callback that should only happen before Playing GameState" )

	entity attacker = DamageInfo_GetAttacker( damageInfo )
	bool attackerIsPlayer = false
	if ( IsValid( attacker ) )
		attackerIsPlayer = attacker.IsPlayer()

	if ( attackerIsPlayer )
	{
		int shieldDamage = 0

		// if ( ent.IsPlayer() && ent.IsShadowForm() ) // S3: shadow form not available
		// 	ShadowHealthUpdate( ent, damageInfo )
		// else
			shieldDamage = PilotShieldHealthUpdate( ent, damageInfo )

		PlayerDamageFeedback( ent, damageInfo, shieldDamage )
	}

	DamageInfo_SetDamage( damageInfo, 0 )
}


