void function CreateGunRangeTargetsForRealm( int realm, bool autoReset = true, bool doBling = false )
{
	                         
		FRSettings_InitDefaults( realm )
       

	fr_MovingTargets[ realm ] <- []
	foreach ( ent in GetEntArrayByScriptName( "shooting_range_rotating_target" ) )
	{
                     
			if ( Has_SkinnedTargets() )
			{
				CreateSkinnedGunRangeTarget( ent, eGunRangeTargetTypes.SPINNING, realm, autoReset, doBling )
			}
			else
			{
				thread CreateGunRangeTarget( ent, eGunRangeTargetTypes.SPINNING, realm, autoReset, doBling )
			}
       
                                                                                               
        
		if ( doBling )
			WaitFrame()
	}

	foreach ( ent in GetEntArrayByScriptName( "shooting_range_folding_target" ) )
	{
		thread CreateGunRangeTarget( ent, eGunRangeTargetTypes.FOLDING, realm, autoReset, doBling )
		if ( doBling )
			WaitFrame()
	}
}

entity function CreateGunRangeTarget( entity ent, int type, int realm, bool autoReset, bool doBling )
{
	entity targetMover
	entity targetGeo
	vector anglesReady  = < 0, 0, 0 >
	vector anglesShot   = < 0, 0, 0 >
	float rotateDuration = 0.0
	float resetDuration = autoReset ? 3.0 : -1.0
	vector origin = ent.GetOrigin()

	entity slideTarget = ent.GetLinkEnt()

	if ( type == eGunRangeTargetTypes.FOLDING )
	{
		//printt( "| Creating Gun Range Target (Folding) Realm:", realm )

		targetMover = CreateScriptMover_NEW( TARGET_MOVER_SCRIPTNAME, origin, ent.GetAngles() )

		origin = OffsetPointRelativeToVector( origin, < 26, 2, 0 >, ent.GetForwardVector() )
		targetGeo = CreatePropDynamic( TARGET_FOLDING_MODEL, origin, ent.GetAngles(), SOLID_OBB, 50000 )
		targetGeo.SetScriptName( FIRING_RANGE_TARGET_FOLD_SCRIPTNAME )
		// targetGeo.SetNeverCrush( true ) // S3: entity method not available at compile time

		entity collision = CreatePropDynamic( TARGET_FOLDING_MODEL, origin, ent.GetAngles(), SOLID_VPHYSICS, 50000, false )
		collision.kv.collisionGroup = TRACE_COLLISION_GROUP_PLAYER

		DispatchSpawn( collision )

		collision.SetParent( targetGeo )
		collision.Hide()
		collision.RemoveFromAllRealms()
		collision.AddToRealm( realm )

		anglesReady = targetMover.GetAngles()
		anglesShot = AnglesCompose( anglesReady, < -85, 0, 0 > )
		rotateDuration = 0.1

		// collision.SetNeverCrush( true ) // S3: entity method not available at compile time

	}
	else if ( type == eGunRangeTargetTypes.SPINNING )
	{
		//printt( "| Creating Gun Range Target (Spinning) Realm:", realm )

		entity targetBase
                     
			if( Has_SkinnedTargets() )
			{
				targetBase = CreateScriptMoverModel( TARGET_SKINNED_BASE, origin, ent.GetAngles(), SOLID_VPHYSICS, 50000 )
			}
			else
			{
				targetBase = CreateScriptMoverModel( TARGET_SPINNING_BASE, origin, ent.GetAngles(), SOLID_VPHYSICS, 50000 )
			}

       
                                                                                                              
                           

		AddStagingCleanupEnt( targetBase )
		targetBase.RemoveFromAllRealms()
		targetBase.AddToRealm( realm )

		origin = OffsetPointRelativeToVector( origin, < 0, 0, 128 >, ent.GetForwardVector() )

		targetMover = CreateScriptMover_NEW( TARGET_MOVER_SCRIPTNAME, origin, ent.GetAngles() )
		targetMover.NonPhysicsSetRotateModeLocal( true )

                     
			if( Has_SkinnedTargets() )
			{
				targetGeo = CreatePropDynamic( TARGET_SKINNED_MODEL, origin, ent.GetAngles(), SOLID_OBB, 50000 )
			}
			else
			{
				targetGeo = CreatePropDynamic( TARGET_SPINNING_MODEL, origin, ent.GetAngles(), SOLID_OBB, 50000 )
			}
       
                                                                                                    
                           

		targetGeo.SetScriptName( FIRING_RANGE_TARGET_FLIP_SCRIPTNAME )
		// targetGeo.SetNeverCrush( true ) // S3: entity method not available at compile time

		entity collision
                     
			if( Has_SkinnedTargets() )
			{
				collision = CreatePropDynamic( TARGET_SKINNED_MODEL, origin, ent.GetAngles(), SOLID_VPHYSICS, 50000, false )
			}
			else
			{
				collision = CreatePropDynamic( TARGET_SPINNING_MODEL, origin, ent.GetAngles(), SOLID_VPHYSICS, 50000, false )
			}
       
                                                                                                                
                           

		collision.kv.collisionGroup = TRACE_COLLISION_GROUP_PLAYER
		DispatchSpawn( collision )

		collision.SetParent( targetGeo )
		collision.Hide()
		collision.RemoveFromAllRealms()
		collision.AddToRealm( realm )

		anglesReady = targetMover.GetLocalAngles()
		anglesShot = AnglesCompose( targetMover.GetLocalAngles(), < 180, 0, 0 > )
		rotateDuration = 0.0

		if ( IsValid( slideTarget ) )
		{
			targetMover.SetParent( targetBase, "", true )

			// Save slideTarget to do Instant Speed Change upon speed change via a signal.
			sMovingTarget newMovingTarget = MovingTarget_Register( targetBase, slideTarget, realm )
			thread MovingGunRangeTargetThink( newMovingTarget, realm )
		}
		else // Not sliding target, so we don't need scripted base.
		{
			targetBase.Destroy()
		}
	}

	Assert( IsValid( targetGeo ) )
	Assert( IsValid( targetMover ) )

	if ( doBling )
	{
		Highlight_SetNeutralHighlight( targetGeo, "staging_gun_range_target_appear" )
	}

	targetGeo.SetParent( targetMover, "", true )
	targetMover.SetPusher( true )

	AddStagingCleanupEnt( targetGeo )
	AddStagingCleanupEnt( targetMover )

	targetGeo.RemoveFromAllRealms()
	targetGeo.AddToRealm( realm )
	targetMover.RemoveFromAllRealms()
	targetMover.AddToRealm( realm )

	AddEntityCallback_OnPostDamaged( targetGeo, StagingAreaEntity_OnDamaged )
                  
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		AddEntityCallback_OnPostDamaged( targetGeo, FR_Nessie_OnDamagedEntity )
	}

	targetGeo.e.preventStickyEnts = true

	thread GunRangeTargetThink( targetGeo, targetMover, type, anglesReady, anglesShot, rotateDuration, resetDuration )

	return targetGeo
}

                   
entity function CreateSkinnedGunRangeTarget( entity ent, int type, int realm, bool autoReset, bool doBling )
{
	entity targetGeo
	vector sliderOrigin = ent.GetOrigin()

	Assert( Has_SkinnedTargets(), "trying to create skinned targets when they don't exist" )

	entity slideTarget = ent.GetLinkEnt()

	if ( type == eGunRangeTargetTypes.FOLDING )
	{
		Assert(false, "Folding targets no longer exist")
	}
	//printt( "| Creating Gun Range Target (Spinning) Realm:", realm )


	vector origin = OffsetPointRelativeToVector( sliderOrigin, < 0, 0, 128 >, ent.GetForwardVector() )

	targetGeo = CreatePropDynamic( TARGET_SKINNED_MODEL, origin, ent.GetAngles(), SOLID_OBB, 50000, false )
	targetGeo.kv.collisionGroup = TRACE_COLLISION_GROUP_NONE
	targetGeo.SetScriptName( FIRING_RANGE_TARGET_FLIP_SCRIPTNAME )
	// targetGeo.SetNeverCrush( true ) // S3: entity method not available at compile time
	DispatchSpawn( targetGeo )

	targetGeo.RemoveFromAllRealms()
	targetGeo.AddToRealm( realm )

	if ( IsValid( slideTarget ) )
	{
		entity targetBase = CreateScriptMoverModel( TARGET_SKINNED_BASE, sliderOrigin, ent.GetAngles(), SOLID_VPHYSICS, 50000 )

		AddStagingCleanupEnt( targetBase )
		targetBase.RemoveFromAllRealms()
		targetBase.AddToRealm( realm )

		targetBase.SetPusher( true )

		targetGeo.SetParent( targetBase, "", true )

		// Save slideTarget to do Instant Speed Change upon speed change via a signal.
		sMovingTarget newMovingTarget = MovingTarget_Register( targetBase, slideTarget, realm )
		thread MovingGunRangeTargetThink( newMovingTarget, realm )
	}

	Assert( IsValid( targetGeo ) )

	if ( doBling )
	{
		Highlight_SetNeutralHighlight( targetGeo, "staging_gun_range_target_appear" )
	}

	AddStagingCleanupEnt( targetGeo )

	AddEntityCallback_OnPostDamaged( targetGeo, StagingAreaEntity_OnDamaged )
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		{
			AddEntityCallback_OnPostDamaged( targetGeo, FR_Nessie_OnDamagedEntity )
		}

	thread GunRangeTargetSkinnedThink( targetGeo )

	return targetGeo
}
      

bool function Has_SkinnedTargets()
{
	return( GetCurrentPlaylistVarBool( "has_skinnedtargets", false ))
}

sMovingTarget function MovingTarget_Register( entity targetBase, entity slideTarget,  int realm )
{
	if( !( realm in fr_MovingTargets ) )
		fr_MovingTargets[ realm ] <- []

	sMovingTarget newTarget
	newTarget.targetBase = targetBase
	newTarget.slideTarget = slideTarget
	newTarget.headedTowardEnd = true
	newTarget.start = targetBase.GetOrigin()
	newTarget.end = slideTarget.GetOrigin()

	// Add as a sMovingTarget if not already in fr_MovingTargets
	if( !MovingTarget_AlreadyRegistered( targetBase, realm ) )
	{
		fr_MovingTargets[ realm ].append( newTarget )
	}

	return newTarget
}

bool function MovingTarget_AlreadyRegistered( entity targetBase, int realm )
{
	foreach( movingTarget in fr_MovingTargets[ realm ] )
	{
		if( movingTarget.targetBase == targetBase )
			return true
	}
	
	return false
}

                   
void function GunRangeTargetSkinnedThink( entity targetGeo )
{
	int TargetHealth = 100 // 10000
	targetGeo.SetTakeDamageType( DAMAGE_EVENTS_ONLY )
	targetGeo.SetDamageNotifications( true )
	targetGeo.SetMaxHealth( 10000 )
	targetGeo.SetHealth( 10000 )

	EndSignal( targetGeo, "OnDestroy" )

	Assert(Has_SkinnedTargets(), "Doing skinned target think without skinned targets!")

	while( true )
	{
		WaitFrame()
		table data = WaitSignal( targetGeo, "GunRangeTargetDamaged" )
		entity attacker = expect entity( data.attacker )

		if ( IsValid( attacker ) && attacker.IsPlayer() )
		{
			EmitSoundOnEntityExceptToPlayer( targetGeo, attacker, "Canyonlands_Scr_RangeTarget_Hit_3P" )
		}
		else
		{
			EmitSoundOnEntity( targetGeo, "Canyonlands_Scr_RangeTarget_Hit_3P" )
		}

		thread Target_Do_HitSkin_Thread( targetGeo, data  )
	}
}
      

void function GunRangeTargetThink( entity targetGeo, entity targetMover, int type, vector anglesReady, vector anglesShot, float rotateDuration, float resetDuration )
{
	int TargetHealth = 100 // 10000
	targetGeo.SetTakeDamageType( DAMAGE_EVENTS_ONLY )
	targetGeo.SetDamageNotifications( true )
	targetGeo.SetMaxHealth( 10000 )
	targetGeo.SetHealth( 10000 )

	EndSignal( targetGeo, "OnDestroy" )
	EndSignal( targetMover, "OnDestroy" )

	bool hasSkinnedTargets = Has_SkinnedTargets()

	vector readyPos =  targetMover.GetOrigin()
	vector anglesShotFromBack = AnglesCompose( anglesReady, < 85, 0, 0 > ) // fall the other way.

	while( true )
	{
		WaitFrame()
		table data = WaitSignal( targetGeo, "GunRangeTargetDamaged" )
		entity attacker = expect entity( data.attacker )

		if ( IsValid( attacker ) && attacker.IsPlayer() )
		{
			EmitSoundOnEntityExceptToPlayer( targetGeo, attacker, "Canyonlands_Scr_RangeTarget_Hit_3P" )
		}
		else
		{
			EmitSoundOnEntity( targetGeo, "Canyonlands_Scr_RangeTarget_Hit_3P" )
		}

		targetGeo.e.isDisabled = true
		if ( rotateDuration > 0 )
		{
			vector collapsePos = targetMover.GetOrigin()
			vector anglesShotToUse = anglesShot
			if( IsValid( attacker ) )
			{
			 	vector ToAttacker = attacker.GetOrigin() - targetMover.GetOrigin()
				ToAttacker.z = 0
				if( DotProduct( ToAttacker, targetMover.GetForwardVector() ) < 0 )
				{
					// Slighter angle collapse and upward displacement if shot from behind to prevent clipping.
					anglesShotToUse = anglesShotFromBack
					collapsePos = collapsePos + < 0, 0, 11 > // Shift up slightly so target doesn't clip.
				}
			}
			// targetMover.SetNeverCrush( true ) // S3: entity method not available at compile time
			targetMover.NonPhysicsRotateTo( anglesShotToUse, rotateDuration, 0.0, 0.0 )
			targetMover.NonPhysicsMoveTo( collapsePos, rotateDuration, 0.0, 0.0 )
			wait rotateDuration
		}
		else
		{
                      
				if( hasSkinnedTargets )
					thread Target_Do_HitSkin_Thread( targetGeo, data  )
				else
					targetMover.SetLocalAngles( anglesShot )
        
                                            
               
                            
		}

		if(( !hasSkinnedTargets ) && ( type == eGunRangeTargetTypes.SPINNING ))
		{
			EmitSoundOnEntity( targetGeo, "Canyonlands_Scr_RangeTarget_Spin" )
		}

		if ( resetDuration < 0 )
			return

                     
			if( !Has_SkinnedTargets() )
				wait resetDuration
       
                     
        

		if(( !hasSkinnedTargets ) && ( type == eGunRangeTargetTypes.SPINNING ))
		{
			EmitSoundOnEntity( targetGeo, "Canyonlands_Scr_RangeTarget_Spin" )
		}

		if ( rotateDuration > 0 )
		{
			// targetMover.SetNeverCrush( true ) // S3: entity method not available at compile time
			targetMover.NonPhysicsRotateTo( anglesReady, rotateDuration, 0.0, 0.0 )
			targetMover.NonPhysicsMoveTo( readyPos, rotateDuration, 0.0, 0.0 )
			wait rotateDuration
		}
		else
		{
			                   
				if( !Has_SkinnedTargets() )
				{
					targetMover.SetLocalAngles( anglesReady )
					WaitFrame()
				}
         
		}

		targetGeo.e.isDisabled = false
	}
}

                   
void function Target_Do_HitSkin_Thread( entity target, table data )
{
	if( !IsValid( target ) )
		return

	int hitSkin_Current = target.GetSkin()

	// Let hits and crit hits already playing play out entirely.
	if( hitSkin_Current >= TARGETSKIN_HIT )
		return

	target.Signal( "TargetHit" )
	target.EndSignal( "TargetHit" )
	target.EndSignal( "OnDestroy" )

	// Determine which skin to switch to through the data given.
	int hitSkin_New = TARGETSKIN_HIT
	int hitGroup = expect int( data[ "hitgroup" ] )
	switch( hitGroup )
	{
		case HITGROUP_LEFTLEG:
			hitSkin_New = TARGETSKIN_MINORHIT
			break
		case HITGROUP_CHEST:
			hitSkin_New = TARGETSKIN_HIT
			break
		case HITGROUP_HEAD:
			hitSkin_New = TARGETSKIN_CRIT
			break
	}

	if( hitSkin_New != hitSkin_Current )
	{
		target.SetSkin( hitSkin_New )
	}

	const float HITSKIN_TIME = 0.75
	wait HITSKIN_TIME

	if( IsValid( target ) )
	{
		target.SetSkin( TARGETSKIN_IDLE )
	}
}
                         

                         
