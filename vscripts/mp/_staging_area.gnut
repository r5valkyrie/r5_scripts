void function Staging_Area_Init()
{

	ITEM_RESPAWN_TIME = GetCurrentPlaylistVarFloat( "firing_range_item_respawn_time", ITEM_RESPAWN_TIME_DEFAULT )

	file.stagingAreaEnabled = GetCurrentPlaylistVarBool( "survival_staging_area_enabled", false )

	printt( "STAGING AREA ENABLED:", file.stagingAreaEnabled )
	
	PrecacheScriptString( FIRING_RANGE_TARGET_FOLD_SCRIPTNAME )

	if ( file.stagingAreaEnabled )
	{
		PrecacheModel( GUNRACK_MODEL )
		PrecacheModel( TARGET_FOLDING_MODEL )
		PrecacheModel( TARGET_SPINNING_BASE )
		PrecacheModel( TARGET_SPINNING_MODEL )
		                   
			PrecacheModel( TARGET_SKINNED_BASE )
			PrecacheModel( TARGET_SKINNED_MODEL )
        
		                         
		PrecacheModel( SPEED_SHIFT_PANEL )
		PrecacheModel( DUMMY_WALL_PANEL )
        

		AddSpawnCallback_ScriptName( "staging_loot_bin", OnLootBinSpawned )
		Loot_AddCallback_OnLootSpawn( Staging_OnLootSpawn ) // S3: callback not available

		AddCallback_GameStateEnter( eGameState.WaitingForPlayers, Survival_OnEnterWaitingForPlayers )
		AddCallback_GameStateEnter( eGameState.Playing, StagingCleanup )

		RegisterSignal( "FullCombatDummies_Start_ByPlayer" )
		RegisterSignal("PermanentlyDestroyFRDummyTarget")
		RegisterSignal( "StartFRDummies" )
		RegisterSignal( "SlideTargetSpeedReset" )
		RegisterSignal( "SlideTargetThinkStart" )
		RegisterSignal( "SlideTargetWaitForReset" )
		RegisterSignal( "TargetHit" )

		                   
		RegisterSignal( "fr_ammo_respawn_now" )
        

			if ( !IsNessieDisabled( NessieSkinIndexes.RED_NESSIE ) )
			{
				file.redNessieWeaponRefs.extend( FR_Nessie_GetRedNessieWeapons() )
			}
	}
}

int function StagingArea_PrePlayerChangedCharacterSetup( entity player, ItemFlavor character )
{
	if ( !file.stagingAreaEnabled )
		return 0

	thread function() : ( player )
	{
		WaitFrame()
		if ( !IsAlive( player ) )
			return

		array<entity> weapons = SURVIVAL_GetPrimaryWeaponsSorted( player )
		if ( weapons.len() > 0 )
			player.SetActiveWeaponByName( eActiveInventorySlot.mainHand, weapons[0].GetWeaponClassName() )
	}()

	return PerspectiveCleanup( player )
}

void function Survival_OnEnterWaitingForPlayers()
{
	Loot_AddCallback_OnPlayerLootPickup( OnPlayerLootPickedUp )
	thread TurnOnStagingEffectsDelayed()
	thread CreateStagingAreaGunRange()
}

void function CreateStagingAreaGunRange()
{
	FlagWait( "EntitiesDidLoad" )

	OutOfBoundsEnable()

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return

	thread Staging_SpawnChargePylons_Thread()

	                   
		thread Staging_SpawnJumpPads_Thread()
                          

	InitializeAttachmentNodes()

                           
	if( IsUsingConsolidatedLoot() )
	{
		ConsolidatedLoot_CreateWeaponsAndLootForStaging()
	}
	else
	{
		Create_WeaponsAndLoot_ForStaging()
	}
     
                                   
      
}

void function Create_WeaponsAndLoot_ForStaging()
{
	array<int> allCommonPlayerRealms = GetAllPlayerCommonRealms()
	foreach( int realm in allCommonPlayerRealms )
	{
		thread Create_FiringRange_WeaponsAndLoot_ForRealm( realm )
		WaitFrame() // Can only create range one realm per frame or we run out of physics jobs on the movers
	}
}

void function Create_FiringRange_WeaponsAndLoot_ForRealm( int realm )
{
	CreateWeaponRacksForRealm( realm )
	CreateAttachmentsForRealm( realm )
	CreateGearForRealm( realm )
	CreateHealthItemsForRealm( realm )
	CreateGunRangeTargetsForRealm( realm )

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		thread FinalizeRealmWhenPopulated_Thread( realm ) // TODO: Wait for a player to connect to this  realm before spawning.
	}
}

bool function LootIsSpawnable( LootData lootData )
{
	if ( WeaponLootRefIsLockedSet( lootData.ref ) )
		return false

	if ( lootData.ref.find( WEAPON_SUFFIX_NONCOMBAT ) > 0 ) // don't spawn pets/noncombat weapons
		return false

	if ( SURVIVAL_Loot_IsRefDisabled( lootData.ref ) )
		return false

	return true
}

                           
bool function PlaylistVar_HasExpandedConsolidatedLoot()
{
	return( GetCurrentPlaylistVarBool( "has_expanded_consolidatedloot", true ))
}

array< entity > function ConsolidatedLoot_GetNodesArray( entity originNode, int nodeType )
{
	array< entity > linkedNodes = originNode.GetLinkEntArray()
	array< entity > resultNodes = []

	// Apped the relevant node.
	foreach( node in linkedNodes )
	{
		string nodeName = node.GetScriptName()
		switch( nodeType )
		{
			case eConsolidatedLootNodeType.WEAPONRACK:
				if(( nodeName == CONSOLIDATEDLOOT_WEAPONRACK_NAME ) || ( nodeName == CONSOLIDATEDLOOT_WEAPONRACK_NAME2 ))
				{
					resultNodes.append( node )
				}
				break
			case eConsolidatedLootNodeType.LOOT:
				if( nodeName == CONSOLIDATEDLOOT_LOOTSTARTNODE_NAME )
				{
					resultNodes.append( node )
				}
				break
		}
	}

	return resultNodes
}

void function ConsolidatedLoot_CreateWeaponsAndLootForStaging()
{
	CLootV2_InitLootInfo()

	// Create Vending Machines.
	Create_VendingMachines_ForAllRealms()

	array<int> allCommonPlayerRealms = GetAllPlayerCommonRealms()
	foreach( int realm in allCommonPlayerRealms )
	{
		ConsolidatedLoot_Create_FiringRange_WeaponsAndLoot_ForRealm( realm )
		WaitFrame() // Can only create range one realm per frame or we run out of physics jobs on the movers
	}
}

void function ConsolidatedLoot_Create_FiringRange_WeaponsAndLoot_ForRealm( int realm )
{
	CLootV2_Create_AllWeapons_ForRealm( realm )

	CLootV4_Create_AllStuff_ForRealm( realm )

	//CLootV2_Create_AllAttachments_ForRealm( realm )
	//CLootV3_Create_AllShieldsAndGear_ForRealm( realm )

	CreateGunRangeTargetsForRealm( realm )

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		thread FinalizeRealmWhenPopulated_Thread( realm ) // TODO: Wait for a player to connect to this  realm before spawning.
	}
}

array< LootData > barrels_LootData
array< LootData > hopUps_LootData
array< LootData > mags_LootData
array< LootData > scopes_LootData
array< LootData > stocks_LootData
void function CLootV2_InitLootInfo()
{
	// --- Weapons need to be LootData so we could look at their ammoType.
	//array<LootData> lootData = FilterLootDataByRefsToNotSpawn( SURVIVAL_Loot_GetByType_InLevel( eLootType.MAINWEAPON ) )
	array< string > weaponRefs = SURVIVAL_GetAllRefsInLootGroup( "firing_range_all_weapons" )
	                                              
		if ( IsGoldenHorse_FR() )
			weaponRefs.append( TITAN_SWORD_WEAPON_REF )
       
	array< LootData > lootDatas = LootRefs_To_LootDatas( weaponRefs )

	foreach ( int i, LootData _lootData in lootDatas )
	{
		string ammoType = _lootData.ammoType
		if ( !GetWeaponInfoFileKeyField_GlobalBool( _lootData.baseWeapon, "uses_ammo_pool" ) )
			ammoType = "_none"

		if ( !( ammoType in file.weaponDataByAmmoType ) )
			file.weaponDataByAmmoType[ ammoType ] <- []

		if ( !LootIsSpawnable( _lootData ) )
			continue

		#if DEVELOPER
			DEV_Print( format( "%s(): Adding weapon of ammo type: %s", FUNC_NAME(), ammoType ))
		#endif

		if( !file.ammoTypesUsed.contains( ammoType ))
			file.ammoTypesUsed.append( ammoType )

		if( !file.weaponDataByAmmoType[ ammoType ].contains( _lootData ) )
			file.weaponDataByAmmoType[ ammoType ].append( _lootData )
	}

	// --- Grab Loot Data.
	array< string > gearRefs_Raw = SURVIVAL_GetAllRefsInLootGroup( "loot_roller_contents_03" ) // May include dupes.
	array< string > gearRefs_All = []
	array< string > gearRefs = []

	// Remove duplicates.
	foreach( _ref in gearRefs_Raw )
	{
		if( gearRefs_All.contains( _ref ) )
			continue

		gearRefs_All.append( _ref )
	}

	gearRefs_All.sort()

	// Remove Disabled Items.
	foreach( ref in gearRefs_All )
	{
		if( SURVIVAL_Loot_IsRefDisabled( ref ) )
			continue

		gearRefs.append( ref )
	}

	array< LootData > equipmentData_All = LootRefs_To_LootDatas( gearRefs )
	// --- Build Gear lists.
	foreach( item in equipmentData_All )
	{
		// Skip weapons
		if( item.lootType == eLootType.MAINWEAPON )
			continue

		// Skip attachments. We'll do this later.
		if( item.lootType == eLootType.ATTACHMENT )
		{
			//allAttaches.append( item )
			continue
		}

		if( !( item.lootType in file.gearDataByType  ) )
			file.gearDataByType[ item.lootType ] <- []
		if( !( item.lootType in file.gearRefsByType ) )
			file.gearRefsByType[ item.lootType ] <- []

		// Append the LootData of the gear if not already in the table.
		if( !file.gearDataByType[ item.lootType ].contains( item ) )
			file.gearDataByType[ item.lootType ].append( item )

		// Append the Loot Ref of the gear if not already in the table.
		if( !file.gearRefsByType[ item.lootType ].contains( item.ref ) )
			file.gearRefsByType[ item.lootType ].append( item.ref )
	}

	// --- Attachments
	array< string > allAttachRefs_Unfiltered // Includes disabled refs.
	allAttachRefs_Unfiltered.extend( SURVIVAL_GetAllRefsInLootGroup( "Attachment_L1" ) )
	allAttachRefs_Unfiltered.extend( SURVIVAL_GetAllRefsInLootGroup( "Attachment_L2" ) )
	allAttachRefs_Unfiltered.extend( SURVIVAL_GetAllRefsInLootGroup( "Attachment_L3" ) )
	allAttachRefs_Unfiltered.extend( SURVIVAL_GetAllRefsInLootGroup( "Attachment_L4" ) )

	array< string > allAttachRefs
	foreach( ref in allAttachRefs_Unfiltered )
	{
		if( SURVIVAL_Loot_IsRefDisabled( ref ) )
			continue

		allAttachRefs.append( ref )
	}

	array < LootData > allAttaches = LootRefs_To_LootDatas( allAttachRefs )

	barrels_LootData = []
	hopUps_LootData  = LootRefs_To_LootDatas( SURVIVAL_GetAllRefsInLootGroup( "attachments_hopups_only" ) )
	mags_LootData    = []
	scopes_LootData  = []
	stocks_LootData  = []

	// Sort into different arrays by attach type and desired groupings.
	foreach ( ld in allAttaches  )
	{
		if( !LootIsSpawnable( ld ) )
			continue

		switch( ld.attachmentType )
		{
			case eWeaponAttachmentType.BARREL:
				barrels_LootData.append( ld )
				break
			case eWeaponAttachmentType.HOPUP:
				// hopUps_LootData should use the loot group so the proto ones don't get spawned.
				break
			case eWeaponAttachmentType.MAG:
				// Move the bolts to barrels_LootData list via string compare in spite of their their attachmentType being "mag"
				if( ld.ref.find( "shotgun_bolt"  ) != -1 )
				{
					barrels_LootData.append( ld )
				}
				else
				{
					mags_LootData.append( ld )
				}
				break
			case eWeaponAttachmentType.SCOPE:
				scopes_LootData.append( ld )
				break
			case eWeaponAttachmentType.STOCK:
				stocks_LootData.append( ld )
				break
		}
	}

	// There are some attachments missing from the above method.
	// Let's look at the entire LootData set and add any missing items.
	array< LootData > recheckAttaches = SURVIVAL_Loot_GetByType( eLootType.ATTACHMENT )
	foreach( ld in recheckAttaches )
	{
		if( !LootIsSpawnable( ld ) )
			continue

		switch( ld.attachmentType )
		{
			case eWeaponAttachmentType.SCOPE:
				if ( !scopes_LootData.contains( ld ) )
				{
					scopes_LootData.append( ld )
				}
				break
		}
	}

	// Sort attachments by substrings, sort by tier, then put subsets back together.
	array< LootData > barrels_LootData_Sorted 	= SortNSpace_LootDatas( barrels_LootData, [ "barrel_stabilizer_", "shotgun_bolt", "laser_sight" ] )
	array< LootData > mags_Sorted 		= SortNSpace_LootDatas( mags_LootData, [ "bullets_mag", "highcal_mag", "energy_mag", "sniper_mag" ] )
	array< LootData > scopes_Sorted 	= SortNSpace_LootDatas( scopes_LootData, [ "optic_cq", "optic_ranged", "optic_sniper" ] )
	array< LootData > stocks_Sorted 	= SortNSpace_LootDatas( stocks_LootData, [ "stock_tactical", "stock_sniper" ] )

	file.attachmentDataByType[ eWeaponAttachmentType.BARREL ] 	<- barrels_LootData_Sorted
	file.attachmentDataByType[ eWeaponAttachmentType.HOPUP ] 	<- hopUps_LootData
	file.attachmentDataByType[ eWeaponAttachmentType.MAG ] 		<- mags_Sorted
	file.attachmentDataByType[ eWeaponAttachmentType.SCOPE ] 	<- scopes_Sorted
	file.attachmentDataByType[ eWeaponAttachmentType.STOCK ] 	<- stocks_Sorted

	file.attachmentRefsByType[ eWeaponAttachmentType.BARREL ] 	<- LootDatas_To_LootRefs( barrels_LootData )
	file.attachmentRefsByType[ eWeaponAttachmentType.HOPUP ] 	<- LootDatas_To_LootRefs( hopUps_LootData )
	file.attachmentRefsByType[ eWeaponAttachmentType.MAG ] 		<- LootDatas_To_LootRefs( mags_LootData )
	file.attachmentRefsByType[ eWeaponAttachmentType.SCOPE ] 	<- LootDatas_To_LootRefs( scopes_LootData )
	file.attachmentRefsByType[ eWeaponAttachmentType.STOCK ] 	<- LootDatas_To_LootRefs( stocks_LootData )

	#if DEVELOPER
		foreach( item in file.attachmentDataByType[ eWeaponAttachmentType.MAG ] )
			printt( format( "%s(): Mag == %s", FUNC_NAME(), item.ref ))

		foreach( item in file.attachmentDataByType[ eWeaponAttachmentType.BARREL ] )
			printt( format( "%s(): Barrel == %s", FUNC_NAME(), item.ref ))
	#endif // DEVELOPER
}

// -----
table< string, array< string > > function ItemRefsTableBySubType_Build( array< LootData > items, array< string > subTypes )
{
	table< string, array< LootData > > itemsByType = ItemsTableBySubType_Build( items, subTypes )
	ItemsTableBySubType_Sort( itemsByType, subTypes )
	
	table< string, array< string > > itemRefsByType
	
	foreach( sType in subTypes )
	{
		itemRefsByType[ sType ] <- LootDatas_To_LootRefs( itemsByType[ sType ] )
	}
	
	return itemRefsByType
}

table< string, array< LootData > > function ItemsTableBySubType_Build( array< LootData > items, array< string > subTypes )
{
	table< string, array< LootData > > itemsByType
	foreach( sType in subTypes )
	{
		itemsByType[ sType ] <- []
	}

	// split into subgroups.
	foreach( item in items )
	{
		if( !LootIsSpawnable( item ) )
			continue

		foreach( sType in subTypes )
		{
			if( item.ref.find( sType ) != -1 )
			{
				itemsByType[ sType ].append( item )
				continue
			}
		}
	}
	return itemsByType
}

void function ItemsTableBySubType_Sort( table< string, array< LootData > > itemsByType, array< string > subTypes )
{
	for( int i = 0; i < subTypes.len(); i++ )
	{
		string sType	= subTypes[ i ]
		array< LootData > subList = itemsByType[ sType ]
		subList.sort( CompareLootDataByTier )
	}
}

// -----

// Returns array< LootData > of all items broken down by subtype and sorted by tier within each subtype, separated by
// a blank LootData between subtypes.
array< LootData > function SortNSpace_LootDatas( array< LootData > items, array< string > subTypes )
{
	array< LootData > results

	table< string, array< LootData > > itemsByType = ItemsTableBySubType_Build( items, subTypes )

	for( int i = 0; i < subTypes.len(); i++ )
	{
		string sType = subTypes[ i ]
		array< LootData > subList = itemsByType[ sType ]
		subList.sort( CompareLootDataByTier )

		// Add a space after each subtype Except the last one, so everything is still centered within the space.
		if( i < subTypes.len() - 1 )
		{
			LootData blankData
			subList.append( blankData )
			subList.append( blankData )
		}
		results.extend( subList )
	}

	#if DEVELOPER
		foreach( item in results )
			printt( format( "%s(): result item == ", FUNC_NAME(), item.ref ) )
	#endif // DEVELOPER
	return results
}



int function CompareLootDataByTier( LootData item1, LootData item2 )
{
	if ( item1.tier > item2.tier ) return 1
	else if ( item1.tier < item2.tier ) return -1
	return 0
}

int function CompareLootDataByRef( LootData item1, LootData item2 )
{
	if ( item1.ref > item2.ref ) return 1
	else if ( item1.ref < item2.ref ) return -1
	return 0
}

// -------------------
// ----- CLoot2 Creation Functions 
// -------------------

void function CLootV2_Create_AllWeapons_ForRealm( int realm )
{
	// TODO: May need to initialize ammoTypes used for MU1 training.

	// Create All Weapons That Spawn for the given realm.
	foreach( string ammo in file.ammoTypesUsed )
	{
		CLootV2_Spawn_AllWeapons_ByAmmoType_ForRealm( realm, ammo )
	}
}

void function CLootV2_Create_AllAttachments_ForRealm( int realm )
{
	array< entity > startNodes = GetEntArrayByScriptName( "cloot2_attachments_start" )

	foreach( startNode in startNodes )
	{
		CLootV2_Create_Attachments_ForRealm( realm, startNode )
	}
}

void function CLootV2_Create_Attachments_ForRealm( int realm, entity startNode )
{
	if( !IsValid( startNode ) )
		return

	array< array< string > > rowsOfItemRefs = []
	array< vector > angleOffsets

	// TODO: Run those LootData lists through a function that spaces out each subcategory of loot by comparing tiers.

	// Explicitly construct the rowsOfItemRefs and construct an array of angleOverrides to go with each row.
	// Order the scopes closest to the guns ( last row )
	rowsOfItemRefs.append( LootDatas_To_LootRefs( file.attachmentDataByType[ eWeaponAttachmentType.HOPUP ] ) )
	angleOffsets.append( < 0,0,0 > )
	rowsOfItemRefs.append( LootDatas_To_LootRefs( file.attachmentDataByType[ eWeaponAttachmentType.STOCK ] ) )
	angleOffsets.append( < 0,90,0 > )
	rowsOfItemRefs.append( LootDatas_To_LootRefs( file.attachmentDataByType[ eWeaponAttachmentType.BARREL ] ) )
	angleOffsets.append( < 0,45,0 > )
	rowsOfItemRefs.append( LootDatas_To_LootRefs( file.attachmentDataByType[ eWeaponAttachmentType.MAG ] ) )
	angleOffsets.append( < 0,180,0 > )
	rowsOfItemRefs.append( LootDatas_To_LootRefs( file.attachmentDataByType[ eWeaponAttachmentType.SCOPE ] ) )
	angleOffsets.append( < 0,45,0 > )

	thread _SpawnLoot_InArea_ForRealm_Thread( realm, startNode, rowsOfItemRefs, 1, angleOffsets )
}

void function CLootV3_Create_AllShieldsAndGear_ForRealm( int realm )
{
	array< entity > startNodes = GetEntArrayByScriptName( "cloot3_gear_start" )
	if( startNodes.len() == 0 )
		startNodes = GetEntArrayByScriptName( "cloot2_gear_start" )

	foreach( startNode in startNodes )
	{
		CLootV3_Create_ShieldsAndGear_ForRealm( realm, startNode )
	}
}

void function CLootV3_Create_ShieldsAndGear_ForRealm( int realm, entity startNode )
{
	if( !IsValid( startNode ) )
		return

	array< array< string > > rowsOfItemRefs = []
	array< vector > angleOverrides

	// Combine Body Shields, helmets,incapshields, and evo shields into 1 row.
	array< string > bodyShieldRefs = []
	array< string > helmetRefs
	array< string > incapShieldRefs
	array< string > evoShieldRefs

	// --- Body Shields: armor_pickup_lv1, 2, 3, 4_all_fast
	                    
	bool useArmorCores = UpgradeCore_ArmorTiedToUpgrades()
	#if DEVELOPER
		printt( format( "%s(): useArmorCores == %s", FUNC_NAME(), string( useArmorCores ) ) )
	#endif

	if( !useArmorCores )
       
	{
		bodyShieldRefs = [ "armor_pickup_lv1", "armor_pickup_lv2", "armor_pickup_lv3", "armor_pickup_lv4_all_fast" , "" ]
	}

	// --- Helmets: helmet_pickup_lv1, 2, 3, 4_abilities.
	helmetRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.HELMET ] )
	if( !helmetRefs.contains( "helmet_pickup_lv1" ) )
		helmetRefs.insert( 0, "helmet_pickup_lv1" )
	helmetRefs.append( "" )

	// --- Knockdown Shields: incapshield_pickup_lv1, 2, 3, 4_selfrevive.
	incapShieldRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.INCAPSHIELD ] )
	if( !incapShieldRefs.contains( "incapshield_pickup_lv1" ) )
		incapShieldRefs.insert( 0, "incapshield_pickup_lv1" )
	incapShieldRefs.append( "" )

	// --- Evo Shields: armor_pickup_lv1_evolving, lv2_evolving, lv3_evolving, lv4_all_fast
	                    
	if( !useArmorCores )
       
	{
		evoShieldRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.ARMOR ] )
		if( !( evoShieldRefs.contains( "armor_pickup_lv5_evolving" ) ) )
			evoShieldRefs.append( "armor_pickup_lv5_evolving" )
		if( evoShieldRefs.contains( "armor_pickup_lv4_all_fast" ) )
			evoShieldRefs.removebyvalue( "armor_pickup_lv4_all_fast" )
		evoShieldRefs.sort()
		evoShieldRefs.append( "" )
	}
	                    
	else
	{
		evoShieldRefs = [ "armor_core_pickup_lv1", "armor_core_pickup_lv2", "armor_core_pickup_lv3", "armor_core_pickup_lv5", "" ]
	}
       

	// Add BackPacks & ordnances as next row:
	array< string > ordnanceRefs = SURVIVAL_GetAllRefsInLootGroup( "ordnance_drops" )
	array< string > backpackRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.BACKPACK ] )
	array< string > backpackAndOrdnanceRefs = []
	for( int i = 0; i < backpackRefs.len() - 1; i++ )
	{
		backpackAndOrdnanceRefs.append( backpackRefs[ i ] )
		backpackAndOrdnanceRefs.append( "" )
		backpackAndOrdnanceRefs.extend( ordnanceRefs )
		backpackAndOrdnanceRefs.append( "" )
	}
	backpackAndOrdnanceRefs.append( backpackRefs[ backpackRefs.len() - 1 ] )

	rowsOfItemRefs.append( backpackAndOrdnanceRefs )
	angleOverrides.append( < 0, 90, 0 > )

	// Consumables
	string ultAccelerant = "health_pickup_ultimate"
	string syringe = "health_pickup_health_small"
	string medkit = "health_pickup_health_large"
	string batcell = "health_pickup_combo_small"
	string battery = "health_pickup_combo_large"
	string phoenix = "health_pickup_combo_full"
	array< string > consumableRefs = [ phoenix, battery, medkit, batcell,  syringe, ultAccelerant, syringe, batcell, medkit, battery, phoenix ]
	rowsOfItemRefs.append( consumableRefs )
	angleOverrides.append( < 0, 0, 0 > )

	bool armorAtGunRackEnds = CLootV3_CreateShieldsAtGunRackEnds( realm, bodyShieldRefs, evoShieldRefs )
	array< string > protectiveStuff

	if( armorAtGunRackEnds  )
	{
		// TODO: Put the helmets and incapshields by the armors. ( one set for each side. )
		protectiveStuff.extend( helmetRefs )
		protectiveStuff.extend( incapShieldRefs )
	}
	else
	{
		// if the nodes for the gunrack-end armor configuration aren't found, combine all armor pieces.
		protectiveStuff.extend( bodyShieldRefs )
		protectiveStuff.extend( helmetRefs )
		protectiveStuff.extend( incapShieldRefs )
		protectiveStuff.extend( evoShieldRefs )
		rowsOfItemRefs.append( protectiveStuff )
	}

	angleOverrides.append( < 0, 180, 0 > + startNode.GetAngles())
	thread _SpawnLoot_InArea_ForRealm_Thread( realm, startNode, rowsOfItemRefs, 1, angleOverrides )
}

// Spawn the body armor and evo armor at the ends of the middle gun racks.
bool function CLootV3_CreateShieldsAtGunRackEnds( int realm, array< string > bodyShieldRefs, array< string > evoShieldRefs )
{
	array< entity > bodyarmor_startNodes = GetEntArrayByScriptName( "cloot3_bodyarmor_start" )

	array< entity > evoarmor_startNodes = GetEntArrayByScriptName( "cloot3_evoarmor_start" )

	if(( bodyarmor_startNodes.len() == 0 ) || ( evoarmor_startNodes.len() == 0 ))
	{
		return false
	}

	// Otherwise, spawn body armor and evo armor at the ends of the middle gun racks.
	bool result
	result = _CLootV3_ShieldsAtGunRackEnds( realm, bodyarmor_startNodes, bodyShieldRefs )
	result = result && _CLootV3_ShieldsAtGunRackEnds( realm, evoarmor_startNodes, evoShieldRefs )

	return result
}

bool function _CLootV3_ShieldsAtGunRackEnds( int realm, array< entity > allStartNodes, array< string > lootRefs )
{
	//foreach( startNode in allStartNodes )
	//{
	//	entity endNode = startNode.GetLinkEnt() // There should only be one end.
	//	if( !IsValid( endNode ) )
	//		return false
	//
	//	// Prepare parameters to spawn a row of weapons.
	//	float rowWidth = Distance( endNode.GetOrigin(), startNode.GetOrigin() )
	//	float itemDelta = rowWidth / lootRefs.len()
	//	vector nextItemDir = startNode.GetForwardVector()
	//	vector rowStart = startNode.GetOrigin() + nextItemDir * itemDelta / 2
	//	vector defaultAngles = < 0, 180, 0 > + startNode.GetAngles()
	//
	//	// Angle Adjust itemRefs.
	//	int spawnWeaponHowMany = 1
	//	array< entity > spawnedItems = _SpawnLootRow_ForRealm( realm, lootRefs, spawnWeaponHowMany, rowStart, rowWidth, nextItemDir, defaultAngles )
	//}
	//
	//return true
	return ( CLootV4_Spawn_LootRows_For_ArrayOfStartNodes( realm, allStartNodes, lootRefs, [], < 0, 180, 0 > ))
}

// ----- Loot V4: Spawn Individual rows for maximum flexibility.

void function CLootV4_Create_AllStuff_ForRealm( int realm )
{
	if( !( GetCurrentPlaylistVarBool( "has_clootv4", false ) ) )
	{
		thread CLootV2_Create_AllAttachments_ForRealm( realm )
		thread CLootV3_Create_AllShieldsAndGear_ForRealm( realm )
		return
	}

	table< string, array< entity > > startNodesTable
	table< string, array< string > > lootRefsTable
	table< string, array< int > > 	 lootCountsTable

	string missingStartNodes = ""
	array< string > startNodeNames =
	[
		"cloot4_scopes_basic_start",
		"cloot4_scopes_advanced_start",
		"cloot4_scopes_sniper_start",
		"cloot4_mags_energy_start",
		"cloot4_mags_heavy_start",
		"cloot4_mags_light_start",
		"cloot4_mags_sniper_start",
		"cloot4_stocks_basic_start",
		"cloot4_stocks_sniper_start",
		"cloot4_barrels_start",
		"cloot4_lasers_start",
		"cloot4_shotgunbolts_start",
		"cloot4_hopups_start",
		"cloot4_bodyarmor_start",
		"cloot4_evoarmor_start",
		"cloot4_helmets_start",
		"cloot4_incaps_start",
		"cloot4_ordinances_start",
		"cloot4_batts_start",
		"cloot4_health_start",
		"cloot4_specialgear_start",
		"cloot4_backpacks_start"
	]

	// --- GET ALL THE START NODES. IF ANY OF THEM ARE MISSING, DEFAULT TO CLootV3_Create_AllShieldsAndGear_ForRealm()
	foreach( _startNodeName in startNodeNames )
	{
		startNodesTable[ _startNodeName ] <- GetEntArrayByScriptName( _startNodeName )
		if( startNodesTable[ _startNodeName ].len() == 0 )
		{
			missingStartNodes = _startNodeName
			break
		}
	}

	if( missingStartNodes != "" )
	{
		#if DEVELOPER
			printt( format( "%s(): Start Nodes Not Found: %s", FUNC_NAME(), missingStartNodes ) )
		#endif
		thread CLootV2_Create_AllAttachments_ForRealm( realm )
		thread CLootV3_Create_AllShieldsAndGear_ForRealm( realm )
		return
	}

	// --- Gather all the item lootRefs.
	// ----- Scopes:
	table< string, array< string > > scopesRefs = ItemRefsTableBySubType_Build( scopes_LootData, [ "optic_cq", "optic_ranged", "optic_sniper" ] )
	// Adjust a little bit... put the digi scope in the advanced scopes row.
	array< string > scopesRefs_cq 		= scopesRefs[ "optic_cq" ]
	array< string > scopesRefs_advanced	= scopesRefs[ "optic_ranged" ]
	string digiscope = scopesRefs_cq[ scopesRefs_cq.len() - 1 ]
	scopesRefs_advanced.append( digiscope )
	scopesRefs_cq.remove( scopesRefs_cq.len() - 1 )

	lootRefsTable[ "cloot4_scopes_basic_start" ] 	<- scopesRefs_cq
	lootRefsTable[ "cloot4_scopes_advanced_start" ] <- scopesRefs_advanced
	lootRefsTable[ "cloot4_scopes_sniper_start" ] 	<- scopesRefs[ "optic_sniper" ]

	lootCountsTable[ "cloot4_scopes_basic_start" ] 		<- CLootV4_InitLootSpawnCount( scopesRefs_cq )
	lootCountsTable[ "cloot4_scopes_advanced_start" ] 	<- CLootV4_InitLootSpawnCount( scopesRefs_advanced )
	lootCountsTable[ "cloot4_scopes_sniper_start" ] 		<- CLootV4_InitLootSpawnCount( scopesRefs[ "optic_sniper" ] )

	// -----  Mags:
	table< string, array< string > > magsRefs = ItemRefsTableBySubType_Build( mags_LootData, [ "bullets_mag", "highcal_mag", "energy_mag", "sniper_mag" ] )
	lootRefsTable[ "cloot4_mags_energy_start" ] 	<- magsRefs[ "energy_mag" ]
	lootRefsTable[ "cloot4_mags_heavy_start" ] 		<- magsRefs[ "highcal_mag" ]
	lootRefsTable[ "cloot4_mags_light_start" ] 		<- magsRefs[ "bullets_mag" ]
	lootRefsTable[ "cloot4_mags_sniper_start" ] 	<- magsRefs[ "sniper_mag" ]

	lootCountsTable[ "cloot4_mags_energy_start" ] 	<- CLootV4_InitLootSpawnCount( magsRefs[ "energy_mag" ] )
	lootCountsTable[ "cloot4_mags_heavy_start" ] 	<- CLootV4_InitLootSpawnCount( magsRefs[ "highcal_mag" ] )
	lootCountsTable[ "cloot4_mags_light_start" ] 	<- CLootV4_InitLootSpawnCount( magsRefs[ "bullets_mag" ] )
	lootCountsTable[ "cloot4_mags_sniper_start" ] 	<- CLootV4_InitLootSpawnCount( magsRefs[ "sniper_mag" ] )

	// -----  Stocks:
	table< string, array< string > > stocksRefs = ItemRefsTableBySubType_Build( stocks_LootData, [ "stock_tactical", "stock_sniper" ] )
	lootRefsTable[ "cloot4_stocks_basic_start" ] 	<- stocksRefs[ "stock_tactical" ]
	lootRefsTable[ "cloot4_stocks_sniper_start" ] 	<- stocksRefs[ "stock_sniper" ]

	lootCountsTable[ "cloot4_stocks_basic_start" ] 	<- CLootV4_InitLootSpawnCount( stocksRefs[ "stock_tactical" ] )
	lootCountsTable[ "cloot4_stocks_sniper_start" ]	<- CLootV4_InitLootSpawnCount( stocksRefs[ "stock_sniper" ] )

	// -----  Gun Ends:
	table< string, array< string > > gunEndRefs = ItemRefsTableBySubType_Build( barrels_LootData, [ "barrel_stabilizer", "shotgun_bolt", "laser_sight" ] )
	lootRefsTable[ "cloot4_barrels_start" ] 		<- gunEndRefs[ "barrel_stabilizer" ]
	lootRefsTable[ "cloot4_lasers_start" ] 			<- gunEndRefs[ "laser_sight" ]
	lootRefsTable[ "cloot4_shotgunbolts_start" ] 	<- gunEndRefs[ "shotgun_bolt" ]

	lootCountsTable[ "cloot4_barrels_start" ] 		<- CLootV4_InitLootSpawnCount( gunEndRefs[ "barrel_stabilizer" ] )
	lootCountsTable[ "cloot4_lasers_start" ] 		<- CLootV4_InitLootSpawnCount( gunEndRefs[ "laser_sight" ] )
	lootCountsTable[ "cloot4_shotgunbolts_start" ] 	<- CLootV4_InitLootSpawnCount( gunEndRefs[ "shotgun_bolt" ] )

	// -----  Hopups:
	lootRefsTable[ "cloot4_hopups_start" ] <- SURVIVAL_GetAllRefsInLootGroup( "attachments_hopups_only" )
	lootCountsTable[ "cloot4_hopups_start" ] 	<- CLootV4_InitLootSpawnCount( SURVIVAL_GetAllRefsInLootGroup( "attachments_hopups_only" ) )

	// -----  Armors:
	array< string > armorRefs = []
	                    
	bool useArmorCores = UpgradeCore_ArmorTiedToUpgrades()
	if( !useArmorCores )
       
	{
		armorRefs = [ "armor_pickup_lv1", "armor_pickup_lv2", "armor_pickup_lv3", "armor_pickup_lv4_all_fast" ]
		lootRefsTable[ "cloot4_bodyarmor_start" ] <- armorRefs
		lootCountsTable[ "cloot4_bodyarmor_start" ] <- CLootV4_InitLootSpawnCount( armorRefs )
	}

	array< string >evoShieldRefs = []

	                    
	if( useArmorCores )
	{
		evoShieldRefs.append( "armor_core_pickup_lv1" )
		evoShieldRefs.append( "armor_core_pickup_lv2" )
		evoShieldRefs.append( "armor_core_pickup_lv3" )
		evoShieldRefs.append( "armor_core_pickup_lv5" )
		lootRefsTable[ "cloot4_bodyarmor_start" ] <- evoShieldRefs
		lootCountsTable[ "cloot4_bodyarmor_start" ] <- CLootV4_InitLootSpawnCount( evoShieldRefs )
		lootRefsTable[ "cloot4_evoarmor_start" ] <- []
		lootCountsTable[ "cloot4_evoarmor_start" ] 	<- []
	}
	else
       
	{
		evoShieldRefs.append( "armor_pickup_lv1_evolving" )
		evoShieldRefs.append( "armor_pickup_lv2_evolving" )
		evoShieldRefs.append( "armor_pickup_lv3_evolving" )
		evoShieldRefs.append( "armor_pickup_lv4_all_fast" )
		evoShieldRefs.append( "armor_pickup_lv5_evolving" )

		lootRefsTable[ "cloot4_evoarmor_start" ] <- evoShieldRefs
		lootCountsTable[ "cloot4_evoarmor_start" ] 	<- CLootV4_InitLootSpawnCount( evoShieldRefs )
	}

	array< string >helmetRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.HELMET ] )
	if( !helmetRefs.contains( "helmet_pickup_lv1" ) )
	{
		helmetRefs.insert( 0, "helmet_pickup_lv1" )
	}
	lootRefsTable[ "cloot4_helmets_start" ] <- helmetRefs
	lootCountsTable[ "cloot4_helmets_start" ] 	<- CLootV4_InitLootSpawnCount( helmetRefs )

	array< string >incapShieldRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.INCAPSHIELD ] )
	if( !incapShieldRefs.contains( "incapshield_pickup_lv1" ) )
	{
		incapShieldRefs.insert( 0, "incapshield_pickup_lv1" )
	}
	lootRefsTable[ "cloot4_incaps_start" ] <- incapShieldRefs
	lootCountsTable[ "cloot4_incaps_start" ] 	<- CLootV4_InitLootSpawnCount( incapShieldRefs )

	// -----  Ordinances
	lootRefsTable[ "cloot4_ordinances_start" ] <- SURVIVAL_GetAllRefsInLootGroup( "ordnance_drops" )
	lootCountsTable[ "cloot4_ordinances_start" ] 	<- CLootV4_InitLootSpawnCount( SURVIVAL_GetAllRefsInLootGroup( "ordnance_drops" ) )

	// ----- Consumables
	// Consumables
	string ultAccelerant = "health_pickup_ultimate"
	string syringe = "health_pickup_health_small"
	string medkit = "health_pickup_health_large"
	string batcell = "health_pickup_combo_small"
	string battery = "health_pickup_combo_large"
	string phoenix = "health_pickup_combo_full"

	// Batteries
	lootRefsTable[ "cloot4_batts_start" ] <- [ phoenix, battery, batcell, batcell ]
	lootCountsTable[ "cloot4_batts_start" ] <- [ 1, 1, 1, 1 ]

	// Health
	lootRefsTable[ "cloot4_health_start" ] <- [ medkit, syringe, syringe ]
	lootCountsTable[ "cloot4_health_start" ] <- [ 1, 2, 2 ]

	                    
		if( UpgradeCore_IsEnabled())
		{
			lootRefsTable[ "cloot4_batts_start" ]. append( "mp_pickup_xp_cache_dynamic" )
			lootCountsTable[ "cloot4_batts_start" ].append( 1 )
		}
                           

	// Special Gear
                              
		string evacballoon = "mp_ability_redeploy_balloon"
		lootRefsTable[ "cloot4_specialgear_start" ] <- [ ultAccelerant, evacballoon ]
		lootCountsTable[ "cloot4_specialgear_start" ] <- [ 1, 1 ]
      
                                                                  
                                                        
                                    

	// Backpacks
	array< string > backpackRefs = LootDatas_To_LootRefs( file.gearDataByType[ eLootType.BACKPACK ] )
	if( !( backpackRefs.contains( "backpack_pickup_lv1" ) ) )
	{
		backpackRefs.insert( 0, "backpack_pickup_lv1" )
	}
	lootRefsTable[ "cloot4_backpacks_start" ] <- backpackRefs
	lootCountsTable[ "cloot4_backpacks_start" ] <- CLootV4_InitLootSpawnCount( backpackRefs )

	// Spawn all the stuff.
	foreach( category in startNodeNames )
	{
		thread CLootV4_Spawn_LootRows_For_ArrayOfStartNodes( realm, startNodesTable[ category ], lootRefsTable[ category ], lootCountsTable[ category ] )
	}
}

array< int > function CLootV4_InitLootSpawnCount( array< string > lootRefs )
{
	array< int > results = []
	foreach( _lref in lootRefs )
	{
		results.append( 1 )
	}

	return results
}

// -----

void function Create_VendingMachines_ForAllRealms()
{
	if( !file.vendingMachinesCreated )
	{
		array< entity > gearStationNodes = GetEntArrayByScriptName( "gear_vending" )
		foreach( _gearStationNode in gearStationNodes )
		{
			if ( IsValid( _gearStationNode ) )
			{
				VendingMachine_CreateSimple( _gearStationNode.GetOrigin(), _gearStationNode.GetAngles() )
			}
		}
		file.vendingMachinesCreated = true
	}
}

// -------------------
// ----- CLoot2 Spawn Functions 
// -------------------

void function CLootV2_Spawn_AllWeapons_ByAmmoType_ForRealm( int realm, string ammoType )
{
	string nodeName = "guns_" + ammoType + "_start"

	array< entity > startNodes = GetEntArrayByScriptName( nodeName )
	foreach( entity startNode in startNodes)
	{
		thread CLootV2_Spawn_WeaponRowAndAmmo_ForRealm( realm, ammoType, startNode )
		WaitFrame()
	}

	WaitFrame()
}

void function CLootV2_Spawn_WeaponRowAndAmmo_ForRealm( int realm, string ammoType, entity startNode )
{
	if( !IsValid( startNode ) )
		return

	array< LootData > lootData = file.weaponDataByAmmoType[ ammoType ]

	if( lootData.len() == 0 )
		return

	// -------------------
	// ----- Spawn the Weapons
	// -------------------
	// Get the end node
	entity endNode = startNode.GetLinkEnt() // There should only be one end.
	if( !IsValid( endNode ) )
		return

	// Prepare parameters to spawn a row of weapons.
	array< string > lootRefs_Unfiltered = LootDatas_To_LootRefs( lootData )

	array< string > lootRefs
	foreach( ref in lootRefs_Unfiltered )
	{
		if( SURVIVAL_Loot_IsRefDisabled( ref ) )
			continue

		lootRefs.append( ref )
	}

	vector rowStart = startNode.GetOrigin()
	float rowWidth = Distance( endNode.GetOrigin(), startNode.GetOrigin() )
	//vector defaultAngles = AnglesCompose ( < 90, 0, 0 >, startNode.GetAngles())
	vector defaultAngles = < 0, 0, -90 > + startNode.GetAngles()
	vector nextItemDir = startNode.GetRightVector()

	// Angle Adjust itemRefs.
	array< string > angleAdjustItemRefs = [ "mp_weapon_bow", "mp_weapon_throwingknife" ]

	                          
		angleAdjustItemRefs.append( TITAN_SWORD_WEAPON_REF )
       

	vector itemAdjustAngles = < 85, 0, 0 >

	int spawnWeaponHowMany = 500
	array< entity > spawnedWeapons = _SpawnLootRow_ForRealm( realm, lootRefs, spawnWeaponHowMany, rowStart, rowWidth, nextItemDir, defaultAngles, angleAdjustItemRefs, itemAdjustAngles, true )

	// -------------------
	// --- Spawn ammo of ammoType
	// -------------------
	if( ammoType != "_none" )
	{
		LootData ammoLootData = SURVIVAL_Loot_GetLootDataByRef( ammoType )
		array< entity > ammoNodes = GetEntArrayByScriptName( "ammo_" + ammoType )
		foreach( ammoNode in ammoNodes )
		{
			vector pos = ammoNode.GetOrigin()
			vector ang = ammoNode.GetAngles()
			_SpawnItem_ForRealm( realm, ammoType, pos, ang, ammoLootData.countPerDrop * 1 )
		}
	}
}

// ----- Spawn Functions

entity function _SpawnItem_ForRealm( int realm, string lootRef, vector pos, vector ang, int count = 1, bool hideUsableHUD = false )
{

	entity item = SpawnGenericLoot( lootRef, pos, ang, count )

	if( IsValid( item ) )
	{
		item.SetNetworkDistanceCull( false )
		item.e.recreateLootOnPickup = true

		item.RemoveFromAllRealms()
		item.AddToRealm( realm )

		if( hideUsableHUD )
		{
			// TODO: Figure out a way to hide the vertical lines.
			// The scripting below does NOT do this.
			//item.RemoveUsableValue( USABLE_USE_VERTICAL_LINE )
			//item.RemoveUsableValue( USABLE_HORIZONTAL_FOV )
			//item.AddUsableValue( USABLE_USE_DISTANCE_OVERRIDE )
			//item.SetUsableDistanceOverride( 128.0 )
		}

		AddStagingCleanupEnt( item )
	}

	return item
}

bool function CLootV4_Spawn_LootRows_For_ArrayOfStartNodes( int realm, array< entity > allStartNodes, array< string > lootRefs, array< int > lootCountsParm, vector angleAdjust = < 0, 0, 0 > )
{
	foreach( startNode in allStartNodes )
	{
		entity endNode = startNode.GetLinkEnt() // There should only be one end.
		if( !IsValid( endNode ) )
			return false

		array< int > lootCounts = []
		if( lootCountsParm.len() > 0 )
		{
			lootCounts = lootCountsParm
		}
		else
		{
			lootCounts = CLootV4_InitLootSpawnCount( lootRefs )
		}

		array< entity > spawnedItems = CLootV4_SpawnLootRow_ForRealm( realm, lootRefs, lootCounts, startNode )
	}

	return true
}

array< entity > function CLootV4_SpawnLootRow_ForRealm( int realm, array< string > lootRefsParm, array< int > lootCounts, entity startNode, array< string > angleAdjustItemRefs = [], vector itemAdjustAngles = < 0, 0, 0>, bool hideUsableHUD = false  )
{
	// Spawns a line of Loot Centered between rowStartEdge going rowWidth in the given nextItemDir direction.
	// Parameters:
	//		- realm
	//		- lootRefs: Array of lootRefs to spawn in the line.
	//		- howMany: How many per item to spawn ( if ammo )
	//		- startNode: The starting edge of the line. This is used to get the following:
	//			- endNode:
	//			- rowStartEdge
	//			- rowEndEdge
	//			- rowWidth: How long the line of loot goes.
	//			- nextItemDir: The direction of the next item in the row.
	//			- itemAnglesDefault: The default orientation to spawn each item.
	//		- angleAdjustItemRefs: Items whose angles need to be adjusted.
	array< entity > result = []

	array< string > lootRefs
	foreach( item in lootRefsParm )
	{
		if ( item != "" )
		{
			lootRefs.append( item )
		}
	}

	if( !IsValid( startNode ) )
		return result

	if( lootRefs.len() == 0 )
		return result

	// Grab the end node
	entity endNode = startNode.GetLinkEnt()
	if( !IsValid( endNode ) )
		return result

	vector rowStartEdge = startNode.GetOrigin()
	vector rowEndEdge	= endNode.GetOrigin()
	float rowWidth = Distance( rowStartEdge, rowEndEdge )
	vector nextItemDir = Normalize( rowEndEdge - rowStartEdge )
	vector itemAnglesDefault = startNode.GetForwardVector()

	// Calculate the width and the spacing based on how many items in the lootData array.
	vector itemPos
	float distBtwnItems
	if( lootRefs.len() >= 2  )
	{
		distBtwnItems = rowWidth / ( lootRefs.len() - 1 )
		itemPos = rowStartEdge
	}
	else
	{
		// If only 1 item in the list, spawn it in the middle between the start and end points.
		distBtwnItems = rowWidth / lootRefs.len()
		itemPos = rowStartEdge + ( nextItemDir * rowWidth / 2 )
	}
	vector nextItemDelta = Normalize( nextItemDir ) * distBtwnItems

	for( int i = 0; i < lootRefs.len(); i++ )
	{
		string _lootRef = lootRefs[ i ]
		int howMany = lootCounts[ i ]

		vector itemAngles = itemAnglesDefault
		// Exception rotations
		if(( angleAdjustItemRefs.len() > 0 ) && ( angleAdjustItemRefs.contains( _lootRef ) ))
		{
			itemAngles = AnglesCompose( itemAngles, itemAdjustAngles )
		}

		// If it's not a blank ref, then we spawn the item.
		if( _lootRef != "" )
		{
			entity lootEnt = _SpawnItem_ForRealm( realm, _lootRef, itemPos, itemAngles, howMany, hideUsableHUD )
			result.append( lootEnt )

			// Advance to next position in the row.
			itemPos = itemPos + nextItemDelta
		}
	}

	return result
}

array< entity > function _SpawnLootRow_ForRealm( int realm, array< string > lootRefs, int howMany, vector rowStartEdge, float rowWidth, vector nextItemDir, vector itemAnglesDefault, array< string > angleAdjustItemRefs = [], vector itemAdjustAngles = < 0, 0, 0>, bool hideUsableHUD = false  )
{
	// Spawns a line of Loot Centered between rowStartEdge going rowWidth in the given nextItemDir direction.
	// Parameters:
	//		- realm
	//		- lootRefs: Array of lootRefs to spawn in the line.
	//		- rowStartEdge: The starting edge of the line.
	//		- rowWidth: How long the line of loot goes.
	//		- nextItemDir: The direction of the next item in the row.
	//		- itemAnglesDefault: The default orientation to spawn each item.
	//		- angleAdjustItemRefs: Items whose angles need to be adjusted.
	//		- itemAdjustAngles: The angles that the above items need to be adjusted.
	array< entity > result = []

	if( lootRefs.len() == 0 )
		return result

	// Calculate the width and the spacing based on how many items in the lootData array.

	// Old Version
	//float distBtwnItems = rowWidth / lootRefs.len()
	//vector nextItemDelta = Normalize( nextItemDir ) * distBtwnItems
	//
	//vector itemPos = rowStartEdge + nextItemDelta / 2

	// --- New Version
	vector itemPos
	float distBtwnItems
	if( lootRefs.len() >= 2  )
	{
		distBtwnItems = rowWidth / ( lootRefs.len() - 1 )
		itemPos = rowStartEdge
	}
	else
	{
		// If only 1 item in the list, spawn it in the middle between the start and end points.
		distBtwnItems = rowWidth / lootRefs.len()
		itemPos = rowStartEdge + ( nextItemDir * rowWidth / 2 )
	}
	vector nextItemDelta = Normalize( nextItemDir ) * distBtwnItems

	// ---

	foreach( _lootRef in lootRefs )
	{
		vector itemAngles = itemAnglesDefault
		// Exception rotations
		if(( angleAdjustItemRefs.len() > 0 ) && ( angleAdjustItemRefs.contains( _lootRef ) ))
		{
			                          
				if ( TitanSword_WeaponRefIsTitanSword( _lootRef ) )
					itemAngles = AnglesCompose( itemAngles, <270, 180, 0> )
				else
         
			itemAngles = AnglesCompose( itemAngles, itemAdjustAngles )
		}

		                  
			if( file.redNessieWeaponRefs.contains( _lootRef ) )
			{
				itemAngles = AnglesCompose( itemAngles, < 0, 0, 180 > )
			}
        



		// If it's not a blank ref, then we spawn the item. Otherwise, just skip spawning and provide a space.
		if( _lootRef != "" )
		{
			entity lootEnt = _SpawnItem_ForRealm( realm, _lootRef, itemPos, itemAngles, howMany, hideUsableHUD )
			result.append( lootEnt )
		}

		// Advance to next position in the row.
		itemPos = itemPos + nextItemDelta
	}

	return result
}

void function _SpawnLoot_InArea_ForRealm_Thread( int realm, entity startNode, array< array< string > > rowsOfLootRefs, int howMany = 1, array< vector > angleOverrides = [] )
{
	if( rowsOfLootRefs.len() < 1 )
		return

	if( !IsValid( startNode ) )
		return

	// Get the row end node
	entity rowEndNode = startNode.GetLinkEnt() // There should only be one end.
	if( !IsValid( rowEndNode ) )
		return

	// Get the Top End Node.
	entity topEndNode = rowEndNode.GetLinkEnt() // Linked from the rightNode.
	if( !IsValid( topEndNode ) )
		return

	// Calculate dimensions
	float areaWidth = Distance( rowEndNode.GetOrigin(), startNode.GetOrigin() )
	float areaHeight = Distance( rowEndNode.GetOrigin(), topEndNode.GetOrigin() )

	int numRows = rowsOfLootRefs.len()
	float distBtwnRows = areaHeight / numRows
	vector nextRowDir = startNode.GetForwardVector()
	vector nextRowDelta = Normalize( nextRowDir ) * distBtwnRows
	vector nextItemDir = startNode.GetRightVector()

	int currentRowNDX = 0
	vector startEdge = startNode.GetOrigin() + nextRowDelta / 2
	foreach( array< string > rowLootRefs in rowsOfLootRefs )
	{
		vector itemAngles = startNode.GetAngles()
		// Pass in an angle override for particular rows.
		if( rowsOfLootRefs.len() == angleOverrides.len() )
		{
			if( angleOverrides[ currentRowNDX ] != < 0, 0, 0> )
				itemAngles = angleOverrides[ currentRowNDX ]
		}

		vector currentRowEdge = startEdge + nextRowDelta * currentRowNDX
		thread _SpawnLootRow_ForRealm( realm, rowLootRefs, howMany, currentRowEdge, areaWidth, nextItemDir, itemAngles )
		WaitFrame()
		currentRowNDX++
	}
}

bool function IsUsingConsolidatedLoot()
{
	// Need the playlistvar to be true AND have elements from the consolidated loot platform to use consolidated loot.
	file.usingConsolidatedLoot = GetCurrentPlaylistVarBool( "firingrange_using_consolidatedloot", true )
	array< entity > consolidatedLootPlatformOrigins = GetEntArrayByScriptName( CONSOLIDATEDLOOT_ROOTNODE_NAME )
	file.usingConsolidatedLoot = file.usingConsolidatedLoot && ( consolidatedLootPlatformOrigins.len() > 0 )
	return( file.usingConsolidatedLoot )
}
                                 

// -------------------
// ----- Utility Functions
// -------------------

array< string > function LootDatas_To_LootRefs( array< LootData > lootData )
{
	array< string > lootRefs
	foreach( _lootData in lootData )
	{
		if( _lootData.ref != "" )
			lootRefs.append( _lootData.ref )
		else
			lootRefs.append( "" )
	}
	return lootRefs
}

array< LootData > function LootRefs_To_LootDatas( array< string > lootRefs )
{
	array< LootData > lootDatas
	foreach( _lootRef in lootRefs )
	{
		if( _lootRef != "" )
			lootDatas.append( SURVIVAL_Loot_GetLootDataByRef( _lootRef ) )
		else
		{
			LootData newLootData
			lootDatas.append( newLootData )
		}
	}
	return lootDatas
}

void function TurnOnStagingEffectsDelayed()
{
	wait 0.1 // Have to wait here so effects ents can be listening for the flag?
	if ( GetGameState() == eGameState.WaitingForPlayers )
		FlagSet( "staging_fx_enabled" )
}

int function PerspectiveCleanup( entity player )
{
	if ( !player.IsCrouched() )
		return 0

	if ( SURVIVAL_GetPrimaryWeaponsSorted( player ).len() > 0 )
		return 0

	if ( player.EyeAngles().x < 85.0 )
		return 0

	if ( GetCurrentPlaylistVarBool( "firingrange_disable_extras", false ) )
		return 0

                    
	if ( Distance( player.GetOrigin(), <-89.750946, -1107.061157, -83.833519> ) <= 120.0 )
      
                                                                            
       
	{
		if ( !GetCurrentPlaylistVarBool( "allow_third_person", false ) )
			return 0

		EmitSoundOnEntityOnlyToPlayer( player, player, "UI_CTF_1P_GrabFlag" )

		if ( player.IsThirdPersonShoulderModeOn() )
			return 1 //player.SetThirdPersonShoulderModeOff()
		else
			return 3 //player.SetThirdPersonShoulderModeOn()
	}

	if ( Distance( player.GetOrigin(), <26707.9297, -4898.70996, -27205.6367> ) <= 50.0 )
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, "UI_CTF_1P_GrabFlag" )
		EmitSoundOnEntityToTeamExceptPlayer( player, "UI_CTF_3P_TeamGrabFlag", player.GetTeam(), player )

		FullCombatDummies_Start_ByPlayer( player )

		return 0
	}

	return 0
}


