void function Staging_SpawnJumpPads_Thread()
{
	WaitEndFrame()

	// Get all leveled-spawned neutral srcJumpPads.
	array< entity > srcJumpPads = GetEntArrayByScriptName( JUMP_PAD_NEUTRAL_SCRIPTNAME )
	if( srcJumpPads.len() == 0 )
		return

	array<int> allCommonPlayerRealms = GetAllPlayerCommonRealms()
	foreach( realm in allCommonPlayerRealms )
	{
		foreach( jp in srcJumpPads )
		{

			entity newJumpPad = JumpPad_CreateAtLocation( jp.GetOrigin(), jp.GetAngles(), null )
			newJumpPad.RemoveFromAllRealms()
			newJumpPad.AddToRealm( realm )

			array< entity > jpChildren  = GetChildren(newJumpPad)
			foreach( child in jpChildren )
			{
				if( IsValid( child ) )
				{
					child.RemoveFromAllRealms()
					child.AddToRealm( realm )
				}
			}
		}
	}

	// destroy the src jumppads.
	foreach( _srcJP in srcJumpPads )
	{
		if( IsValid( _srcJP ) )
		{
			_srcJP.Destroy()
		}
	}
}

