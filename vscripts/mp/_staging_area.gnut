int function FRSetting_ShieldLevel_Get (int realm)
{
	int shieldSetting = FRIntSetting_Get( realm, eFRSettingType.FRDUMMIESHIELDLVL )

	const int FRDUMMIE_SHIELD_MIN = 1
	const int FRDUMMIE_SHIELD_MAX = 4

	int result = shieldSetting
	if( shieldSetting == FR_RANDOM_SHIELD_SETTING )
	{
		result = RandomIntRange( FRDUMMIE_SHIELD_MIN, FRDUMMIE_SHIELD_MAX + 1 )
		#if DEVELOPER
			printt( format( "%s(): Random Shield Level Selected: %s", FUNC_NAME(), string( result ) ))
		#endif
	}

	return( result )
}

