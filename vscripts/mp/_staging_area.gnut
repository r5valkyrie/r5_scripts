void function OnLootBinSpawned( entity lootbin )
{
	Point p
	p.origin = lootbin.GetOrigin()
	p.angles = lootbin.GetAngles()
	file.stagingLootBinLocations.append( p )
	lootbin.Destroy()
}

void function CreateLootBinsForRealm( int realm )
{
	foreach( Point p in file.stagingLootBinLocations )
	{
		entity lootBin = CreateCustomLootBin( p.origin, p.angles, GetRandomLootForLootBin() )
		lootBin.RemoveFromAllRealms()
		lootBin.AddToRealm( realm )
		AddStagingCleanupEnt( lootBin )
	}
}

array<string> function GetRandomLootForLootBin()
{
	array<int> lootTypes = [ eLootType.HEALTH, eLootType.ARMOR, eLootType.INCAPSHIELD, eLootType.ORDNANCE, eLootType.BACKPACK, eLootType.HELMET ]
	int numItems = CoinFlip() ? 3 : 4

	array<string> items
	for ( int i = 0 ; i < numItems ; i++ )
	{
		if ( lootTypes.len() == 0 )
			break

		int type = lootTypes.getrandom()
		lootTypes.fastremovebyvalue( type )

		array<LootData> lootDataForType = FilterLootDataByRefsToNotSpawn( SURVIVAL_Loot_GetByType_InLevel( type, 3 ) )
		if ( lootDataForType.len() == 0 )
			continue

		LootData data = lootDataForType.getrandom()
		items.append( data.ref )
	}

	return items
}

