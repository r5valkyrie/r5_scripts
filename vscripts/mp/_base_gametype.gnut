void function UpdateAttackerInfo( entity ent, entity attacker, float damage )
{
	entity attackerPlayer = GetPlayerFromEntity( attacker )
	if ( !attackerPlayer )
		return

	// cannot be your own last attacker
	if ( attackerPlayer == ent )
		return

	if ( damage <= 0 )
		return

	if ( !("attackerInfo" in ent.s) )
		ent.s.attackerInfo <- {}
	else if ( ent.GetHealth() == ent.GetMaxHealth() )
		ent.s.attackerInfo.clear()

	if ( !(attackerPlayer.weakref() in ent.s.attackerInfo) )
		ent.s.attackerInfo[attackerPlayer.weakref()] <- 0

	ent.s.attackerInfo[attackerPlayer.weakref()] += damage

	ent.e.lastAttacker = attackerPlayer
}


entity function GetAttackerPlayerOrBossPlayer( entity attacker )
{
	if ( !IsValid( attacker ) )
		return null

	if ( attacker.IsPlayer() )
		return attacker

	entity bossPlayer = attacker.GetBossPlayer()
	if ( !IsValid( bossPlayer ) )
		return null

	return bossPlayer
}

#if SERVER
entity function GetAttackerOrLastAttacker( entity ent, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( !ShouldGetLastAttacker( ent, attacker ) )
	{
		Assert( IsValid( attacker ) )
		return attacker
	}

	entity lastAttacker = GetLastAttacker( ent ) //Attacker doesn't work, get last attacker
	if ( IsValid( lastAttacker ) )
		return lastAttacker

	//last attacker doesn't work, get latestAssistingPlayerInfo
	AssistingPlayerStruct attackerInfo = GetLatestAssistingPlayerInfo( ent )
	if ( IsValid( attackerInfo.player ) )
		return attackerInfo.player

	if ( IsValid( attacker ) ) //No Last Attacker and No Lastest Assisting Player, e.g. when you suicide before taking damage. Just return the attacker if valid
		return attacker

	Assert( false, "" )
	return svGlobal.worldspawn
}
#endif //if SERVER

bool function ShouldGetLastAttacker( entity ent, entity attacker )
{
	if ( IsValid( attacker ) == false )
		return true

	if ( attacker == ent ) //suicide
		return true

	if ( attacker.IsPlayer() == false && attacker.IsNPC() == false ) //Environmental damage
		return true

	return false
}


void function ClearLastAttacker( entity ent )
{
	ent.e.lastAttacker = null
}


entity function GetLastAttacker( entity ent )
{
	if ( !IsValid( ent.e.lastAttacker ) )
		return null

	return ent.e.lastAttacker
}


void function PlayerOrNPCKilled( entity ent, var damageInfo )
{
	bool gamePlayingOrSuddenDeath = GamePlayingOrSuddenDeath() // Storing this off here, the game state can change in the callbacks below which may cause kills to not count

	int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	if ( damageSourceID == eDamageSourceId.round_end )
		return

	entity attackerRaw = GetAttackerOrLastAttacker( ent, damageInfo )
	entity attacker    = attackerRaw
	Assert( IsValid( attacker ) )

	if ( ent.IsPlayer() )
	{
		LogPlayerMatchStat_Death( ent )

		if ( attacker.IsPlayer() && (attacker != ent) )
			LogPlayerMatchStat_KilledAPilot( attacker )
	}

	if ( !attacker.IsPlayer() )
	{
		entity newAttacker = GetPlayerFromEntity( attacker )
		if ( IsValid( newAttacker ) )
			attacker = newAttacker
	}

	if ( ent.IsPlayer() )
	{
		//Do callbacks. Main reason we call this here as opposed to CodeCallback_OnPlayerKilled() is legacy script compatibility reasons.
		//For example: In script immediately above this we change the attacker to get the player behind the kill, e.g. owner of a pet titan, etc. Bunch of registered callbacks depends on this.
		foreach ( callbackFunc in svGlobal.onPlayerKilledCallbacks )
			callbackFunc( ent, attacker, damageInfo )
	}
	else if ( ent.IsNPC() )
	{
		//Do callbacks. Main reason we call this here as opposed to CodeCallback_OnNPCKilled() is legacy script compatibility reasons.
		//For example: In script immediately above this we change the attacker to get the player behind the kill, e.g. owner of a pet titan, etc. Bunch of registered callbacks depends on this.
		foreach ( callbackFunc in svGlobal.onNPCKilledCallbacks )
			callbackFunc( ent, attacker, damageInfo )
	}

	if ( !attacker.IsPlayer() )
	{
		// This gets the last player that did damage to the entity so that we can give him the kill
		AssistingPlayerStruct attackerInfo = GetLatestAssistingPlayerInfo( ent )
		if ( IsValid( attackerInfo.player ) )
		{
			attacker = attackerInfo.player
			// Hack - attacker history isn't on client to calculate if a player should get credit for a kill when AI steals the final killing shot while a player is damaging them.
			array<entity> playerArray = GetPlayerArray()
			foreach ( player in playerArray )
				Remote_CallFunction_Replay( player, "ServerCallback_SetAssistInformation", attackerInfo.damageSourceId, attacker, ent, attackerInfo.assistTime )
		}
	}

	if ( attacker.IsPlayer() )
		DoPlayerScoreEventsForKill( attacker, ent, damageInfo, gamePlayingOrSuddenDeath )
	else if ( ent.IsPlayer() )
		ent.p.numberOfDeathsByWorld++ //still want to track total deaths regardless of whether killed by a player or not
}

int function GetTotalNumberOfDeaths( entity player )
{
	//total number of deaths at the hands of other players or world damage (falls, rings, etc)
	return ( player.p.numberOfDeathsByWorld + player.p.numberOfDeaths )
}

void function DoPlayerScoreEventsForKill( entity player, entity victim, var damageInfo, bool gamePlayingOrSuddenDeath )
{
	PreScoreEventUpdateStats( player, victim )
	if ( IsEnemyTeam( victim.GetTeam(), player.GetTeam() ) )
	{
		if ( victim.IsPlayer() )
			ScoreEvent_PlayerKilled( victim, player, damageInfo )
	}
	PostScoreEventUpdateStats( player, victim )

	if ( IsFriendlyTeam( victim.GetTeam(), player.GetTeam() ) )
		return

	if ( gamePlayingOrSuddenDeath )
	{
		if ( victim.IsPlayer() )
		{
			if ( victim.IsTitan() )
			{
				//if we killed a player in a titan count two kills (one for the pilot, one for the titan )
				player.AddToPlayerGameStat( PGS_KILLS, 2 )
				player.AddToPlayerGameStat( PGS_TITAN_KILLS, 1 )
				player.AddToPlayerGameStat( PGS_PILOT_KILLS, 1 )
			}
			else
			{
				player.AddToPlayerGameStat( PGS_KILLS, 1 )
				player.AddToPlayerGameStat( PGS_PILOT_KILLS, 1 )
			}
		}
		else
		{
			if ( victim.IsTitan() )
				player.AddToPlayerGameStat( PGS_TITAN_KILLS, 1 )

			if ( !IsMarvin( victim ) && !victim.IsTitan() )
				player.AddToPlayerGameStat( PGS_NPC_KILLS, 1 )
		}
	}
}


void function UpdateNextRespawnTime( entity player, float time )
{
	Assert( IsValid( player ) )
	player.SetNonRewindRespawnTime( time )
}


bool function ShouldSetObserverTarget( entity attacker )
{
	if ( !IsValid( attacker ) )
		return false

	if ( !GetCurrentPlaylistVarBool( "deathcam_enabled", false ) )
		return false

	if ( !IsAlive( attacker ) )
		return false

	if ( attacker.IsPlayer() && attacker.IsObserver() )
		return false

	return true
}

                  
	float function CalculateLengthOfKillReplay( float attackerTimeSinceSpawning )
	{
		return GetKillReplayBeforeTime( attackerTimeSinceSpawning ) + GetKillReplayAfterTime()
	}

	float function CalculateReplayDelay( float currentTime, float timeOfDeath, float attackerTimeSinceSpawning )
	{
		return GetKillReplayBeforeTime( attackerTimeSinceSpawning ) + ( Time() - timeOfDeath )
	}

	float function GetKillReplayBeforeTime( float attackerTimeSinceSpawning )
	{
		float playlistTime
		if ( !GamePlayingOrSuddenDeath() )
		{
			playlistTime = GetCurrentPlaylistVarFloat( "killreplay_before_time_short", 3.5 )
		}
		else
		{
			playlistTime = GetCurrentPlaylistVarFloat( "killreplay_before_time", 3.5 )
		}

		return min( playlistTime, attackerTimeSinceSpawning )
	}

	float function GetKillReplayAfterTime()
	{
		if ( !GamePlayingOrSuddenDeath() )
			return GetCurrentPlaylistVarFloat( "killreplay_after_time_short", 1.0 )

		return GetCurrentPlaylistVarFloat( "killreplay_after_time", 1.0 )
	}

	bool function ShouldDoReplay( entity player, entity attacker, float replayTime, int methodOfDeath )
	{
		if ( !ShouldDoReplayForGameState() )
		{
			print( "ShouldDoReplay(): Not doing a replay because ShouldDoReplayForGameState returned false\n" )
			return false
		}

		switch ( methodOfDeath )
		{
			case eDamageSourceId.human_execution:
			case eDamageSourceId.titan_execution:
			{
				print( "ShouldDoReplay(): Not doing a replay because the player died from an execution.\n" )
				return false
			}
		}

		if ( Time() - player.p.connectTime <= replayTime ) //Bad things happen if we try to do a kill replay that lasts longer than the player entity existing on the server
		{
			print( "ShouldDoReplay(): Not doing a replay because the player is not old enough.\n" )
			return false
		}

		if ( player == attacker )
		{
			print( "ShouldDoReplay(): Not doing a replay because the attacker is the player.\n" )
			return false
		}

		if ( !player.IsConnectionActive() )
		{
			print( "ShouldDoReplay(): Not doing a replay because the player isn't connected to the server.\n" )
			return false
		}

		if ( player.IsBot() )
		{
			print( "ShouldDoReplay(): Not doing a replay because the player is a bot.\n" )
			return false
		}

		print( "ShouldDoReplay(): " + player + " is watching a replay" )
		return AttackerShouldTriggerReplay( attacker )
	}

	bool function ShouldDoReplayForGameState()
	{
		if ( !Replay_IsEnabled() )
		{
			print( "ShouldDoReplayForGameState(): Not Doing a replay because 'replay_enabled' is false\n" )
			return false
		}

		if ( ShouldDoReplayIsForcedByCode() )
		{
			print( "ShouldDoReplayForGameState(): Doing a replay because code forced it." )
			return true
		}

		if ( !GamemodeUtility_GetKillReplayActive() )
		{
			print( "ShouldDoReplayForGameState(): Not doing a replay because 'killreplay_enabled' is not enabled in the current playlist.\n" )
			return false
		}

		if ( !GamePlayingOrSuddenDeath() )
		{
			print( "ShouldDoReplayForGameState(): Not doing a replay because gamestate is invalid.\n" )
			return false
		}

		if ( GetReplayDisabled() )
		{
			print( "ShouldDoReplayForGameState(): Not doing a replay because replays are disabled for the level.\n" )
			return false
		}

		return true
	}

	// Don't let things like killbrushes show replays
	bool function AttackerShouldTriggerReplay( entity attacker )
	{
		if ( !IsValid( attacker ) )
		{
			print( "AttackerShouldTriggerReplay(): Not doing a replay because the attacker is not valid.\n" )
			return false
		}

		if ( attacker.IsPlayer() )
		{
			print( "AttackerShouldTriggerReplay(): Doing a replay because the attacker is a player.\n" )
			return true
		}

		if ( attacker.IsNPC() )
		{
			print( "AttackerShouldTriggerReplay(): Doing a replay because the attacker is an NPC.\n" )
			return true
		}

		print( "AttackerShouldTriggerReplay(): Not doing a replay by default.\n" )
		return false
	}

	// If the attacker in damageinfo is an NPC that is owned by a player, for replay we consider the attacker to be that player and the inflictor to be their owned NPC
	entity function GetAttackerForKillreplayFromDamageInfo( entity damageInfoAttacker )
	{
		if ( damageInfoAttacker.IsNPC() && IsValidPlayer( damageInfoAttacker.GetBossPlayer() ) )
		{
			return damageInfoAttacker.GetBossPlayer()
		}

		return damageInfoAttacker
	}

	// if the inflictor is a projectile shot by an NPC owned by a player, use the NPC as the inflictor
	entity function GetInflictorForKillreplayFromDamageInfo( entity damageInfoAttacker, entity damageInfoInflictor )
	{
		if ( damageInfoAttacker.IsNPC() && IsValidPlayer( damageInfoAttacker.GetBossPlayer() ) && damageInfoInflictor.IsProjectile() && damageInfoInflictor.GetOwner() == damageInfoAttacker )
		{
			return damageInfoAttacker
		}

		return damageInfoInflictor
	}
                            


void function DoRespawnPlayer( entity player, entity spawnPoint )
{
	player.p.lastSpawnPoint = spawnPoint
	player.RespawnPlayer( spawnPoint ) //This will send "OnRespawned" signal, killing the thread if started from PostDeathThread
}

bool function ShouldStartSpawn( entity player )
{
	//if ( Flag( "ForceStartSpawn" ) )
	//	return true

	//if ( Flag( "IgnoreStartSpawn" ) )
	//	return false

	if ( GetGameState() <= eGameState.Prematch )
		return true

	if ( player.p.respawnCount != 0 )
		return false

	return GameTime_PlayingTime() < START_SPAWN_GRACE_PERIOD
}


entity function CreateTitanDropCamera( vector origin, vector angles )
{
	entity viewControl = CreateEntity( "point_viewcontrol" )
	viewControl.kv.spawnflags = 56 // infinite hold time, snap to goal angles, make player non-solid

	viewControl.SetOrigin( origin )
	viewControl.SetAngles( angles )
	DispatchSpawn( viewControl )

	return viewControl
}


entity function CreateDropPodViewController( entity pod )
{
	entity viewControl = CreateEntity( "point_viewcontrol" )
	viewControl.kv.spawnflags = 56 // infinite hold time, snap to goal angles, make player non-solid

	viewControl.SetOrigin( pod.GetOrigin() + <44, -64, 520> )
	float yaw = pod.GetAngles().y
	viewControl.SetAngles( <90, yaw + 10, 0> )
	DispatchSpawn( viewControl )

	viewControl.SetParent( pod )

	return viewControl
}


void function ClearEntInUseOnDestroy( entity dropPoint, entity dropPod )
{
	dropPod.WaitSignal( "OnDestroy" )
	dropPoint.e.spawnPointInUse = false
}


float function GetPlayerLastRespawnTime( entity player )
{
	return expect float( player.s.respawnTime )
}


entity function GetEmbarkPlayer( entity titan )
{
	if ( "embarkingPlayer" in titan.s )
		return expect entity( titan.s.embarkingPlayer )

	return null
}


entity function GetDisembarkPlayer( entity titan )
{
	if ( "disembarkingPlayer" in titan.s )
		return expect entity( titan.s.disembarkingPlayer )

	return null
}


entity function GetEmbarkDisembarkPlayer( entity titan )
{
	entity result = GetEmbarkPlayer( titan )

	if ( IsValid( result ) )
		return result

	result = GetDisembarkPlayer( titan )
	if ( IsValid( result ) )
		return result

	return null
}


void function CodeCallback_OnNPCKilled( entity npc, var damageInfo )
{
	HandleDeathPackage( npc, damageInfo )

	if ( npc.IsTitan() )
	{
		// if a player is getting in, kill him too
		entity player = GetEmbarkPlayer( npc )
		if ( IsAlive( player ) )
		{
			// kill the embarking player
			//printt( "Killed embarking player" )
			KillFromInfo( player, damageInfo )
		}

		if ( !GetDoomedState( npc ) )
		{
			// Added via AddCallback_OnTitanDoomed
			foreach ( callbackFunc in svGlobal.onTitanDoomedCallbacks )
			{
				callbackFunc( npc, damageInfo )
			}
		}
	}

	PlayerOrNPCKilled( npc, damageInfo )
}


void function CodeCallback_OnEntityDestroyed( entity ent )
{
	array<void functionref( entity ent )> callbacks = clone(ent.e.onEntityDestroyedCallbacks)
	foreach ( callbackFunc in callbacks )
	{
		callbackFunc( ent )
	}
}


void function AddEntityDestroyedCallback( entity ent, void functionref( entity ) callbackFunc )
{
	ent.e.onEntityDestroyedCallbacks.append( callbackFunc )

	// set this or else the ent won't run CodeCallback_OnEntityDestroyed at all
	ent.SetDoDestroyCallback( true )
}


void function RemoveEntityDestroyedCallback( entity ent, void functionref( entity ) callbackFunc )
{
	ent.e.onEntityDestroyedCallbacks.removebyvalue( callbackFunc )
}

// Ex:  void function OnShieldBreak( entity ent, var damageinfo )
void function AddEntityCallback_OnShieldBreak( entity ent, void functionref( entity, var ) func )
{
	Assert( !ent.e.onShieldBreakFuncs.contains( func ) )
	ent.e.onShieldBreakFuncs.append( func )
}


bool function WeaponInterruptsCloak( entity weapon )
{
	if ( !IsValid( weapon ) )
		return false

	return weapon.GetWeaponInfoFileKeyField( "does_not_interrupt_cloak" ) != 1
}


void function CodeCallback_WeaponFireInCloak( entity player, entity firedWeapon )
{
	if ( !WeaponInterruptsCloak( firedWeapon ) )
		return

	if ( player.IsTitan() )  // Fix timing issue with auto-eject cloak and firing your weapon as a Titan cancelling it.  This assumes we never want cloaked titans!
		return

	// if ( player.cloakedForever )
	// {
	// 	player.SetCloakFlicker( 1.0, 2.0 )
	// 	return
	// }

	// // Check if we are allowed some cloaked shots based on ability selection
	// if ( player.s.cloakedShotsAllowed > 0 )
	// {
	// 	player.s.cloakedShotsAllowed--
	// 	return
	// }

	//player.SetCloakFlicker( 1.0, 2.0 )

	DisableCloak( player, 0.5 )
	entity weapon = player.GetOffhandWeapon( OFFHAND_LEFT )
	//printt( "weapon", weapon.GetWeaponClassName() )
	// JFS; need code feature to properly reset next attack time/cooldown stuff
	if ( IsValid( weapon ) && weapon.GetWeaponClassName() == "mp_ability_cloak" )
	{
		player.TakeOffhandWeapon( OFFHAND_LEFT )
		player.GiveOffhandWeapon( "mp_ability_cloak", OFFHAND_LEFT )
		weapon = player.GetOffhandWeapon( OFFHAND_LEFT )
		weapon.SetWeaponPrimaryClipCountAbsolute( 0 )
	}
}

// playerconnected Reload
// NOTE: When client player connects to a save game, these get called, NOT the OnClientConnectionCompleted callbacks
void function CodeCallback_OnClientReloadConnectionCompleted( entity player )
{
	FinishClientScriptInitialization( player )

	// Added via AddCallback_OnClientReloadConnected
	foreach ( callbackFunc in svGlobal.onClientReloadConnectedCallbacks )
	{
		callbackFunc( player )
	}
}


bool function ShouldPlayerHaveLossProtection( entity player )
{
	if ( IsPrivateMatch() )
		return false

	if ( !Is2TeamPvPGame() ) //TODO: Just give loss protection for multi-team games.
		return true

	int team           = player.GetTeam()
	int otherTeam      = GetOtherTeam( team )
	int teamScore      = IsRoundBased() ? GameRules_GetTeamScore2( team ) : GameRules_GetTeamScore( team )
	int otherTeamScore = IsRoundBased() ? GameRules_GetTeamScore2( otherTeam ) : GameRules_GetTeamScore( otherTeam )

	if ( teamScore < otherTeamScore )
		return true

	return false
}

// This server will receive this command from the client once they have loaded/run all of their scripts
// Any client hud initialization should be done here
void function FinishClientScriptInitialization( entity player )
{
	printt( "Player client script initialization complete: " + player )

	player.p.clientScriptInitialized = true

	SyncServerVars( player )
	SyncEntityVars( player )
	SyncUIVars( player )

	Remote_CallFunction_Replay( player, "ServerCallback_ClientInitComplete" )
}


int function CodeCallback_GetWeaponDamageSourceId( entity weapon )
{
	string classname = weapon.GetWeaponClassName()

	#if DEVELOPER
		if ( ("devWeapons" in level) && classname in level.devWeapons )
			return 0
	#endif

	if ( !(classname in eDamageSourceId) )
	{
		if ( weapon.HasBaseClass() )
		{
			string baseclass = weapon.GetWeaponClassName()

			if ( baseclass in eDamageSourceId )
				return eDamageSourceId[ baseclass ]
		}
		return damagedef_unknown
	}

	return eDamageSourceId[ classname ]
}

table<entity, table<entity, bool> > oob_triggerEntPairs //No references in script. Remove?

bool function IsOutOfBoundsTriggerAllowed( entity outOfBoundsTrigger )
{
	string key = "gamemode_" + GameRules_GetGameMode()
	if( outOfBoundsTrigger.HasKey( key ) )
		return outOfBoundsTrigger.GetValueForKey( key ) == "1"

	return true
}

void function OutOfBoundsSetup()
{
	file.outOfBoundsTriggers.extend( GetEntArrayByClass_Expensive( "trigger_out_of_bounds" ) )
	array<entity> clonedTriggers = clone file.outOfBoundsTriggers

	foreach ( trigger in clonedTriggers )
	{
		if( IsOutOfBoundsTriggerAllowed( trigger ) )
		{
			InitOutOfBoundsTriggerCallBacks( trigger )
		}
		else
		{
			file.outOfBoundsTriggers.fastremovebyvalue( trigger )
			trigger.Destroy()
		}
	}

	AddCallback_GameStateEnter( eGameState.Playing, OutOfBounds_OnGameStatePlaying )
	AddCallback_OnPlayerRespawned( ResetOutOfBoundsTimeOnPlayerRespawned )

	AddSpawnCallback( "trigger_networked_out_of_bounds", OnNetworkedTriggerOOBCreated )
}

void function OutOfBounds_OnGameStatePlaying()
{
	OutOfBoundsEnable()
	AddCallback_GameStateEnter( eGameState.WinnerDetermined, OutOfBoundsDisable )
}

void function OnNetworkedTriggerOOBCreated( entity ent )
{
	AddNewOutOfBoundsTrigger( ent )

	AddEntityDestroyedCallback( ent, OnNetworkedTriggerOOBDestroyed )
}

void function OnNetworkedTriggerOOBDestroyed( entity ent )
{
	file.outOfBoundsTriggers.fastremovebyvalue( ent )
}

void function AddNewOutOfBoundsTrigger( entity outOfBoundsTrigger )
{
	file.outOfBoundsTriggers.append( outOfBoundsTrigger )
	InitOutOfBoundsTriggerCallBacks( outOfBoundsTrigger )
}

void function InitOutOfBoundsTriggerCallBacks( entity outOfBoundsTrigger  )
{
	outOfBoundsTrigger.SetEnterCallback( OnEntEnterOutOfBounds )
	outOfBoundsTrigger.SetLeaveCallback( OnEntLeaveOutOfBounds )

	OutOfBoundsTriggerData triggerData
	file.outOfBoundsTriggerMap[ outOfBoundsTrigger ] <- triggerData
}


void function OutOfBoundsDisable()
{
	Assert( file.outOfBoundsEnabled )
	printt( "(R5DEV-477735) Disable Out of Bounds tests\nCallstack:\n" + GetStack() )

	file.outOfBoundsEnabled = false

	foreach ( trigger in file.outOfBoundsTriggers )
	{
		array<entity> touchingEnts = trigger.GetTouchingEntities()
		foreach ( ent in touchingEnts )
		{
			if ( !(ent in file.entOutOfBoundsMap) )
				continue

			UpdateEntOutOfBoundsStatus( ent )
		}
	}
}

void function OutOfBoundsEnable()
{
	Assert( !file.outOfBoundsEnabled )
	printt( "(R5DEV-477735) Enable Out of Bounds tests\nCallstack:\n" + GetStack() )

	file.outOfBoundsEnabled = true

	foreach ( trigger in file.outOfBoundsTriggers )
	{
		array<entity> touchingEnts = trigger.GetTouchingEntities()
		foreach ( ent in touchingEnts )
		{
			if ( !(ent in file.entOutOfBoundsMap) )
				continue

			UpdateEntOutOfBoundsStatus( ent )
		}
	}
}

bool function IsPointOutOfBounds( vector point )
{
	foreach ( trigger in file.outOfBoundsTriggers )
	{
		if ( trigger.ContainsPoint( point ) )
			return true
	}
	return false
}


void function DisableEntityOutOfBounds( entity ent )
{
	if ( !(ent in file.entOutOfBoundsMap) )
	{
		OutOfBoundsDataStruct oobData
		file.entOutOfBoundsMap[ent] <- oobData
	}

	file.entOutOfBoundsMap[ent].disabledCount += 1
	UpdateEntOutOfBoundsStatus( ent )
}


void function EnableEntityOutOfBounds( entity ent )
{
	if ( !(ent in file.entOutOfBoundsMap) )
		return

	Assert( file.entOutOfBoundsMap[ent].disabledCount > 0 )

	file.entOutOfBoundsMap[ent].disabledCount -= 1

	UpdateEntOutOfBoundsStatus( ent )
}


void function ResetOutOfBoundsTimeOnPlayerRespawned( entity player )
{
	if ( !(player in file.entOutOfBoundsMap) )
		return

	file.entOutOfBoundsMap[player].timeSpentOutOfBounds = 0
}

void function KillEntityOutOfBounds( entity ent, entity trigger )
{
	if ( GetGameState() < eGameState.Playing )
		return

	Assert( ent.GetOutOfBoundsDeadTime() != 0 )
	Assert( Time() <= ent.GetOutOfBoundsDeadTime() )

	ent.EndSignal( "OnDeath" )
	ent.Signal( "OutOfBounds" )
	ent.EndSignal( "OutOfBounds" )
	ent.EndSignal( "BackInBounds" )

	OnThreadEnd(
		function() : ( ent )
		{
			if ( IsValid( ent ) && !IsAlive( ent ) )
			{
				file.outOfBoundsTable[ ent ].outOfBoundsTriggersTouched = 0
				ent.SetOutOfBoundsDeadTime( 0 )
			}
		}
	)

	wait ent.GetOutOfBoundsDeadTime() - Time()

	if ( !IsValidOutOfBoundsEntity( ent, trigger ) )
		return

	if ( ent.GetOutOfBoundsDeadTime() == 0 )
		return

	ent.Die( svGlobal.worldspawn, svGlobal.worldspawn, { scriptType = DF_INSTANT, damageSourceId = eDamageSourceId.outOfBounds } )
}

bool function IsValidOutOfBoundsEntity( entity ent, entity trigger )
{
	if ( !IsValid( ent ) )
		return false

	if ( !IsAlive( ent ) )
		return false

	// S22: disable/enable OOB mechanism
	if ( (ent in file.outOfBoundsTable) && file.outOfBoundsTable[ent].disabledCount > 0 )
		return false

	int triggerTeam = expect int( trigger.kv.teamnumber.tointeger() )

	Assert( triggerTeam >= 0 )

	if ( triggerTeam != 0  && ent.GetTeam() != triggerTeam )
		return false

	// Temp hack for tday intro, might not keep this
	if ( "disableOutOfBounds" in level && level.disableOutOfBounds == true )
		return false

	if ( ent.IsPlayer() )
	{
		if ( ent.IsNoclipping() && !ent.Anim_IsActive() ) //Need to check for Anim_IsActive because PlayAnim() calls will set IsNoclipping() to true. This caused a bug with ejecting out of a OutOfBounds trigger
			return false

		entity parentEnt = ent.GetParent()
		if ( IsValid( parentEnt ) && IsDropship( parentEnt ) )
			return false

		return true
	}

	if ( ent.IsNPC() && ent.IsTitan() )
		return true

	return false
}

void function OnTitanBecomesPilot_OutOfBoundsCheck( entity pilot, entity npc_titan )
{
	if ( pilot.GetOutOfBoundsDeadTime() == 0 )
		return

	npc_titan.SetOrigin( npc_titan.GetOrigin() ) //Kinda a hack to force redetection of the Titan touching the out of bounds trigger
}

void function ManageAddEntToOutOfBoundsTable( entity ent, OutOfBoundsDataStruct dataStruct  ) //Might be overkill, but: suggested by Haggerty to avoid leak of constantly adding ents to the file table without removing them
{
	//First clean up dead references in table
	table< entity, OutOfBoundsDataStruct> tempTable = clone file.outOfBoundsTable

	foreach( ent0, dataStruct0 in tempTable )
	{
		if ( !IsValid( ent0 ) )
		{
			delete file.outOfBoundsTable[ ent0 ]
		}
	}

	//Now add the new ent

	file.outOfBoundsTable[ ent ] <- dataStruct
}

void function DisableEntityOutOfBounds( entity ent )
{
	if ( !(ent in file.outOfBoundsTable) )
	{
		OutOfBoundsDataStruct oobData
		ManageAddEntToOutOfBoundsTable( ent, oobData )
	}

	file.outOfBoundsTable[ent].disabledCount += 1

	if ( IsValid( ent ) && ent.IsPlayer() && ent.GetOutOfBoundsDeadTime() != 0 )
		ent.SetOutOfBoundsDeadTime( 0.0 )
}

void function EnableEntityOutOfBounds( entity ent )
{
	if ( !(ent in file.outOfBoundsTable) )
		return

	Assert( file.outOfBoundsTable[ent].disabledCount > 0 )
	file.outOfBoundsTable[ent].disabledCount -= 1
}

bool function IsEntityOutOfBoundsDisabled( entity ent )
{
	if ( !(ent in file.outOfBoundsTable) )
		return false

	return file.outOfBoundsTable[ent].disabledCount > 0
}

bool function PlayerCanSpawn( entity player )
{
	if ( IsAlive( player ) )
		return false

	return true
}


void function GetAndSetRespawnAvailableBits(int index, int mask)
{
	Assert( index >= 0 )
	Assert( index <= 3 )

	string key = "respawnAvailableBits" + index
	int baseValue = GetGlobalNetInt(key)
	baseValue = baseValue | mask

	SetGlobalNetInt(key, baseValue)
}

void function SetRespawnAvailable( entity player )
{
	int varIndex   = (player.GetEntIndex() - 1) / 32
	int shiftIndex = player.GetEntIndex() - 1 - (varIndex * 32)
	int elimMask   = (1 << shiftIndex)

	GetAndSetRespawnAvailableBits( varIndex, elimMask )
}

void function ClearRespawnAvailable( entity player )
{
	int varIndex   = (player.GetEntIndex() - 1) / 32
	int shiftIndex = player.GetEntIndex() - 1 - (varIndex * 32)
	int elimMask   = (1 << shiftIndex)
	elimMask = ~elimMask

	GetAndSetRespawnAvailableBits( varIndex, elimMask )
}


void function SetPlayerEliminated( entity player )
{
	player.SetPlayerNetBool( "isEliminated", true )
}


void function ClearPlayerEliminated( entity player )
{
	player.SetPlayerNetBool( "isEliminated", false )
}


bool function IsPlayerEliminated( entity player )
{
	bool rv = player.GetPlayerNetBool( "isEliminated" )
	return rv
}


bool function IsTeamEliminated( int team )
{
	array<entity> players = GetPlayerArrayOfTeam( team )

	foreach ( player in players )
	{
		if ( IsPlayerEliminated( player ) != true )
			return false
	}

	return true
}


bool function IsTeamAlive( int team )
{
	array<entity> players = GetPlayerArrayOfTeam_AliveConnected( team )

	if ( players.len() > 0 )
		return true

	return false
}


bool function ShouldShowLossProtectionOnEOG( entity player )
{
	if ( player.p.hasMatchLossProtection != true )
		return false

	if ( player.GetTeam() == GetWinningTeam() )
		return false

	if ( IsPrivateMatch() )
		return false

	return true
}


bool function GameModeRemove( entity ent )
{
	string gameMode = GetGameModeUsedForEntityRemoval()

	string gamemodeKey = "gamemode_" + gameMode
	if ( ent.HasKey( gamemodeKey ) && (ent.kv[gamemodeKey] == "0" || ent.kv[gamemodeKey] == "") )
	{
		if ( ent.IsZipline() && ent.Zipline_IsCurvedZipline() )
		{
			if ( IsValid( ent.GetNextZiplineEnt() ) )
				ent.GetNextZiplineEnt().Destroy()
		}
		else
		{
			foreach ( entLinked in ent.GetLinkEntArray() )
			{
				if ( GetEditorClass( entLinked ) == "func_brush_navmesh_separator" )
				{
					//This disables door collision / nav mesh separators
					ToggleNPCPathsForEntity( entLinked, true )
					entLinked.Hide()
					entLinked.NotSolid()
				}
				else
				{
					entLinked.Destroy()
				}
			}
		}

		ent.Destroy()
		return true
	}

	return false
}


void function OverrideGameModeUsedForEntityRemoval( string override )
{
	file.gameModeSpawnPointOverride = override
}


string function GetGameModeUsedForEntityRemoval()
{
	if ( file.gameModeSpawnPointOverride != "" )
		return file.gameModeSpawnPointOverride
	return GameRules_GetGameMode()
}


void function EntityFire( entity ent, string fire )
{
	ent.Fire( fire )
}


void function EntityFireDelayed( entity ent, string fire, string parm, float delay )
{
	ent.Fire( fire, parm, delay )
}


void function SetOutOfBoundsTimeLimit( float time = OUT_OF_BOUNDS_TIME_LIMIT )
{
	file.outOfBoundsTimeLimit = time
}


entity function CodeCallback_GetBestObserverTarget( entity observer, bool reverse )
{
	foreach ( func in file.getBestObserverTargetCallbacks )
	{
		entity ent = func( observer, reverse )
		if ( ent != null )
		{
			if ( IsPrivateMatch() && observer.GetTeam() == TEAM_SPECTATOR )
			{
				if ( ent.IsPlayer() )
					printf( "Observer: User %s switched to spectating %s", observer.GetPINNucleusPid(), ent.GetPINNucleusPid() )
			}

			return ent
		}
	}

	if ( file.defaultObserverBehavior != null )
	{
		entity defaultEnt = file.defaultObserverBehavior( observer, reverse )

		if ( IsPrivateMatch() && defaultEnt != null && observer.GetTeam() == TEAM_SPECTATOR )
		{
			if ( defaultEnt.IsPlayer() )
				printf( "Observer: User %s switched to spectating %s", observer.GetPINNucleusPid(), defaultEnt.GetPINNucleusPid() )
		}

		return defaultEnt
	}

	return null
}


void function SetDefaultObserverBehavior( entity functionref( entity, bool ) func )
{
	file.defaultObserverBehavior = func
}


void function AddCallback_OnGetBestObserverTarget( entity functionref( entity, bool ) func )
{
	Assert( !file.getBestObserverTargetCallbacks.contains( func ) )
	file.getBestObserverTargetCallbacks.append( func )
}

float function OOB_GetAllowedTimeInAir()
{
	return GetCurrentPlaylistVarFloat( "oob_time_allowed_in_air", 5.0 )
}

float function OOB_GetAllowedTimeInAirResetThreshold()
{
	return GetCurrentPlaylistVarFloat( "oob_time_allowed_in_air_reset_threshold", 15.0 )
}

void function OnEntEnterOutOfBounds( entity trigger, entity ent )
{
	if ( !ent.IsPlayer() )
		return

	printt( "OnEntEnterOutOfBounds", ent )

	// Lazy init
	if ( !(ent in file.entOutOfBoundsMap) )
	{
		OutOfBoundsDataStruct oobData
		file.entOutOfBoundsMap[ent] <- oobData
	}

	Assert( !file.entOutOfBoundsMap[ent].touchedTriggers.contains( trigger ) )
	file.entOutOfBoundsMap[ent].touchedTriggers.append( trigger )

	UpdateEntOutOfBoundsStatus( ent )
}


void function OnEntLeaveOutOfBounds( entity trigger, entity ent )
{
	if ( !(ent in file.entOutOfBoundsMap) )
		return

	printt( "OnEntLeaveOutOfBounds", ent )

	Assert( file.entOutOfBoundsMap[ent].touchedTriggers.contains( trigger ) )
	file.entOutOfBoundsMap[ent].touchedTriggers.fastremovebyvalue( trigger )

	UpdateEntOutOfBoundsStatus( ent )
}

void function OutOfBoundsHolster( entity player )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "BackInBounds" )

	OnThreadEnd(
		function() : ( player )
		{
			if ( player.p.isOutOfBoundsHolsterCheck && IsValid( player ) )
			{
				int lastActiveSlot = WEAPON_INVENTORY_SLOT_PRIMARY_0
				entity activeWeapon = player.p.outOfBoundsActiveWeapon

				if ( IsValid( activeWeapon ) )
				{
					array<int> slots = [ WEAPON_INVENTORY_SLOT_PRIMARY_0,
						WEAPON_INVENTORY_SLOT_PRIMARY_1,
						WEAPON_INVENTORY_SLOT_PRIMARY_2,
						WEAPON_INVENTORY_SLOT_ANTI_TITAN,
						WEAPON_INVENTORY_SLOT_GADGET,
					]

					foreach ( slot in slots )
					{
						entity baseWeapon = player.GetNormalWeapon( slot )

						if ( baseWeapon == activeWeapon )
						{
							lastActiveSlot = slot
							break
						}
					}
				}

				//player.EnableWeaponTypes ( WPT_ALL_EXCEPT_VIEWHANDS_OR_INCAP )
				// Need to equip ordnance for it to appear in the ordnance slot if it wasn't previously equipped ( like if a player is given their weapons while in a weapons disabled state )
				SURVIVAL_AutoEquipOrdnanceFromInventory( player, true )
				player.SetActiveWeaponBySlot( eActiveInventorySlot.mainHand, lastActiveSlot )
				player.p.isOutOfBoundsHolsterCheck = false
			}
		}
	)

	while( true )
	{
		entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

		if ( !IsValid( player ) )
			return

		if( player.IsOnGround() )
		{
			if ( (player in file.entOutOfBoundsMap) )
			{
				if ( IsAlive( player ) && !Bleedout_IsBleedingOut( player ) && !player.IsPhaseShifted() && IsValid( weapon ) && weapon.GetWeaponClassName() != "mp_ability_consumable" && weapon.GetWeaponClassName() != "mp_weapon_phase_tunnel" && player.p.isOutOfBoundsHolsterCheck == false && player.p.inThirdPersonTransition == false )
				{
					SwapToLastEquippedPrimary( player )
					player.p.outOfBoundsActiveWeapon   = weapon
					player.p.isOutOfBoundsHolsterCheck = true
					//player.DisableWeaponTypes( WPT_ALL_EXCEPT_VIEWHANDS_OR_INCAP )
				}
			}
		}

		WaitFrame()
	}
}

void function UpdateEntOutOfBoundsStatus( entity ent )
{
	OutOfBoundsDataStruct outOfBoundsData = file.entOutOfBoundsMap[ent]

	bool isOutOfBounds = false
	foreach ( trigger in outOfBoundsData.touchedTriggers )
	{
		if ( file.outOfBoundsTriggerMap[trigger].disabledCount > 0 )
			continue

		isOutOfBounds = true
		break
	}

	printt( "UpdateEntOutOfBoundsStatus", ent, isOutOfBounds, outOfBoundsData.disabledCount )

	bool canBeOutOfBounds = outOfBoundsData.disabledCount == 0 && file.outOfBoundsEnabled
	isOutOfBounds = isOutOfBounds && canBeOutOfBounds

	if ( isOutOfBounds && !outOfBoundsData.wasOutOfBounds ) // We've started being out of bounds
	{
		if ( GetCurrentPlaylistVarBool ( "oob_begin_on_touch_ground", true ) && !ent.IsOnGround() && outOfBoundsData.timeSpentOutOfBoundsInAir < OOB_GetAllowedTimeInAir() )
		{
			if ( !outOfBoundsData.isOutOfBoundsAndNotOnGround )
				thread Thread_UpdateEntOutOfBoundsStatusOnTouchedGround ( ent, outOfBoundsData )
			return
		}

		float gracePeriod = GetCurrentPlaylistVarFloat( "oob_grace_period", OUT_OF_BOUNDS_GRACE_PERIOD )
		float gracePeriodDelay = GetCurrentPlaylistVarFloat( "oob_grace_period_delay", OUT_OF_BOUNDS_GRACE_PERIOD_DELAY )

		float timeSinceOutOfBounds = Time() - outOfBoundsData.leaveTime
		if ( outOfBoundsData.timeSpentOutOfBounds > file.outOfBoundsTimeLimit - gracePeriod && timeSinceOutOfBounds > gracePeriodDelay )
			outOfBoundsData.timeSpentOutOfBounds = file.outOfBoundsTimeLimit - gracePeriod

		float deadTime = file.outOfBoundsTimeLimit - outOfBoundsData.timeSpentOutOfBounds

		ent.Signal( "OutOfBounds" )
		outOfBoundsData.enterTime = Time()
		// set the timeSpentOutOfBoundsInAir to the max to avoid people  bouncing in/out of bounds using Octane's Jump pad 
		outOfBoundsData.timeSpentOutOfBoundsInAir = OOB_GetAllowedTimeInAir()

		if( GetCurrentPlaylistVarBool( "out_of_bounds_holster_enabled", true ) )
		{
			if ( ( !ent.IsNPC() || !ent.IsBot() ) )
				thread OutOfBoundsHolster( ent )
		}

		thread KillEntOutOfBounds( ent, Time() + deadTime )
	}
	else if ( !isOutOfBounds &&  ( outOfBoundsData.wasOutOfBounds || outOfBoundsData.isOutOfBoundsAndNotOnGround ) ) // we've stopped being out of bounds
	{
		ent.Signal( "BackInBounds" )

		if ( outOfBoundsData.wasOutOfBounds )
		{
			outOfBoundsData.timeSpentOutOfBounds += Time() - outOfBoundsData.enterTime
			outOfBoundsData.leaveTime = Time()

			thread Thread_CheckForTimeInAirThreshold( ent, outOfBoundsData )
		}
	}

	outOfBoundsData.wasOutOfBounds = isOutOfBounds
}

void function Thread_CheckForTimeInAirThreshold( entity player, OutOfBoundsDataStruct outOfBoundsData )
{
	EndSignal(player, "OnDeath", "OnDestroy", "OutOfBounds" )

	#if DEVELOPER
	printt( "Thread_CheckForTimeInAirThreshold", player, outOfBoundsData.timeSpentOutOfBoundsInAir )
	#endif

	wait OOB_GetAllowedTimeInAirResetThreshold()

	#if DEVELOPER
	printt( "Thread_CheckForTimeInAirThreshold", player, " had their time in air threshold reset" )
	#endif

	outOfBoundsData.timeSpentOutOfBoundsInAir = 0
}

void function KillEntOutOfBounds( entity player, float killTime )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "BackInBounds" )

	player.SetOutOfBoundsDeadTime( killTime )

	OnThreadEnd(
		function() : ( player )
		{
			if ( IsValid( player ) )
				player.SetOutOfBoundsDeadTime( 0 )
		}
	)

	wait killTime - Time()

	player.Die( svGlobal.worldspawn, svGlobal.worldspawn, { scriptType = DF_INSTANT, damageSourceId = eDamageSourceId.outOfBounds } )
}

void function Thread_UpdateEntOutOfBoundsStatusOnTouchedGround ( entity player, OutOfBoundsDataStruct outOfBoundsData )
{
	outOfBoundsData.isOutOfBoundsAndNotOnGround = true

	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "BackInBounds" )

	#if DEVELOPER
		printt ( "Thread_UpdateEntOutOfBoundsStatusOnTouchedGround (" + player.GetPlayerName() + " is out of bounds, but not on the ground. Waiting for them to touch down or time out." )
	#endif

	OnThreadEnd (
		function () : ( player, outOfBoundsData )
		{
			#if DEVELOPER
				if ( IsValid(player) )
				{
					if ( !outOfBoundsData.wasOutOfBounds )
						printt ( "Thread_UpdateEntOutOfBoundsStatusOnTouchedGround (" + player.GetPlayerName() + " left OOB without touching down or timing out. They have " + ( OOB_GetAllowedTimeInAir() - outOfBoundsData.timeSpentOutOfBoundsInAir ) + " remaining on their OOB in-air timer." )
				}
				else if ( IsInvalidButMemberVarsStillValid( player ) )
					printt ( "Thread_UpdateEntOutOfBoundsStatusOnTouchedGround (" + player.GetPlayerName() + " was destroyed before touching down or leaving trigger." )
			#endif
			if ( IsValid(player) )
			{
				Assert ( outOfBoundsData.isOutOfBoundsAndNotOnGround, "Thread_UpdateEntOutOfBoundsStatusOnTouchedGround - Ended a thread on a player that was not out of bounds and waiting to touch down" )
				outOfBoundsData.isOutOfBoundsAndNotOnGround = false
			}
		}
	)

	float lastTimeStamp = Time()

	// wait for player to touch ground
	while ( IsValid(player) && !player.IsOnGround() )
	{
		outOfBoundsData.timeSpentOutOfBoundsInAir += Time() - lastTimeStamp

		if ( outOfBoundsData.timeSpentOutOfBoundsInAir > OOB_GetAllowedTimeInAir() )
			break

		lastTimeStamp = Time()
		WaitFrame()
	}

	// player is still out of bounds and has touched down
	if ( IsValid( player ) )
	{
		#if DEVELOPER
			printt ( "Thread_UpdateEntOutOfBoundsStatusOnTouchedGround (" + player.GetPlayerName() + " has touched ground out of bounds." )
		#endif
		UpdateEntOutOfBoundsStatus ( player )
	}
}

bool function IsEntOutOfBounds( entity ent )
{
	if ( ent in file.entOutOfBoundsMap )
	{
		return file.entOutOfBoundsMap[ent].wasOutOfBounds
	}
	return false
}


