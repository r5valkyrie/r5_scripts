const DEATH_CHAT_DELAY = 0.3

global struct OutOfBoundsDataStruct
//Have to globalize it because all functions are globalized in this file :/
{
	int   outOfBoundsTriggersTouched = 0
	float timeBackInBound = 0
	float timeLeftBeforeDyingFromOutOfBounds = OUT_OF_BOUNDS_TIME_LIMIT

	int           disabledCount = 0
	array<entity> touchedTriggers = []
	bool          wasOutOfBounds = false

	float enterTime
	float leaveTime = FLT_MAX
	float timeSpentOutOfBounds

	float timeSpentOutOfBoundsInAir

	bool isOutOfBoundsAndNotOnGround = false
}


global struct OutOfBoundsTriggerData
{
	int disabledCount = 0
}

global struct PostMatchSurveySettings
{
	string matchId = ""
	float sampleRateLowerBound = 1.0
}

struct
{
	array<entity>                        outOfBoundsTriggers = []
	float                                outOfBoundsTimeLimit = OUT_OF_BOUNDS_TIME_LIMIT
	string                               gameModeSpawnPointOverride

	array<entity functionref( entity observer, bool reverse )> getBestObserverTargetCallbacks
	entity functionref( entity observer, bool reverse )        defaultObserverBehavior

	table<entity, OutOfBoundsDataStruct>  entOutOfBoundsMap
	table<entity, OutOfBoundsTriggerData> outOfBoundsTriggerMap
	bool                                  outOfBoundsEnabled = false
	PostMatchSurveySettings        	      surveySettings
} file


void function BaseGametype_Init()
{
	if ( !reloadingScripts )
	{
		level.gameTypeText <- null
		level.classTypeText <- null

		level.titanAlwaysAvailableForTeam <- [ 0, 0, 0, 0 ]

		level.missingPlayersTimeout <- null

		AddCallback_NPCLeeched( OnNPCLeeched )
	}

	RegisterSignal( "OnDamageNotify" )
	RegisterSignal( "OnRespawned" )
	RegisterSignal( "ChoseToSpawnAsTitan" )
	RegisterSignal( "OutOfBounds" )
	RegisterSignal( "BackInBounds" )
	RegisterSignal( "PlayerKilled" )
	RegisterSignal( "SimulateGameScore" )
	RegisterSignal( "ObserverThread" )
	RegisterSignal( "CE_FLAGS_CHANGED" )
	RegisterSignal( "KillreplayFinished" )

	RegisterSignal( "Stop_OnStartTouch_EntityOutOfBounds" )
	RegisterSignal( "Stop_OnEndTouch_EntityBackInBounds" )

	RegisterSignal( "OnRespawnSelect" )

	AddCallback_EntitiesDidLoad( BaseGametypeEntitiesDidLoad )

	BaseGametype_Init_MP()
}


void function BaseGametypeEntitiesDidLoad()
{
	OutOfBoundsSetup()
}

const SOLDIER_SOUND_PAIN = "npc_grunt_pain"

void function CodeCallback_OnPrecache()
{
	PrecacheModel( $"mdl/error.rmdl" ) // model used when no model is provided

	if ( IsLobby() )
		return

	// these should be level specific in SP
	//PrecacheEntity( "npc_soldier" )
	//PrecacheEntity( "turret" )
	//PrecacheEntity( "npc_dropship", DROPSHIP_MODEL )

	PrecacheModel( $"mdl/dev/editor_ref.rmdl" )
	PrecacheModel( $"mdl/dev/empty_model.rmdl" )

	if ( !IsMenuLevel() )
	{
		thread delayedGameState()

		file.surveySettings.matchId = lstrip( rstrip( GameRules_GetUniqueMatchID() ) )
		file.surveySettings.sampleRateLowerBound = GetConVarBool( "match_forcePostMatchSurvey" ) ? 0.0 : RandomFloat( 1.0 )
		BaseGametype_Init_MP_SurveySettings( file.surveySettings )
	}

	level.ui.uiDisableDev = IsMatchmakingServer()
}

void function delayedGameState()
{
	wait 2
	SetGameState( eGameState.WaitingForPlayers )
	GameRules_BeginMatch()
}

void function AddFlinch( entity attackedEnt, var damageInfo )
{
	Assert( IsValid_ThisFrame( attackedEnt ) )

	//if ( !( "nextFlinchTime" in attackedEnt.s ) )
	//	attackedEnt.s.nextFlinchTime <- 0
	//if ( Time() < attackedEnt.s.nextFlinchTime )
	//	return
	//attackedEnt.s.nextFlinchTime = Time() + RandomFloatRange( 2.0, 4.0 )

	vector damageAngles = VectorToAngles( DamageInfo_GetDamageForceDirection( damageInfo ) )
	vector entAngles    = attackedEnt.EyeAngles()

	float damageYaw = (damageAngles.y + 180) - entAngles.y

	damageYaw = AngleNormalize( damageYaw )

	if ( damageYaw < 0 )
		damageYaw += 360

	if ( damageYaw < 45 )
		DamageInfo_SetFlinchDirection( damageInfo, FLINCH_DIRECTION_BACKWARDS )
	else if ( damageYaw < 135 )
		DamageInfo_SetFlinchDirection( damageInfo, FLINCH_DIRECTION_RIGHT )
	else if ( damageYaw < 225 )
		DamageInfo_SetFlinchDirection( damageInfo, FLINCH_DIRECTION_FORWARDS )
	else if ( damageYaw < 315 )
		DamageInfo_SetFlinchDirection( damageInfo, FLINCH_DIRECTION_LEFT )
	else
		DamageInfo_SetFlinchDirection( damageInfo, FLINCH_DIRECTION_BACKWARDS )
}


bool function ShouldPreventDamageDueToFriendlyFire( entity attacker, entity ent, var damageInfo )
{
	// no suicide protection
	if ( attacker == ent )
		return false

	int entTeam      = ent.GetTeam()
	int attackerTeam = attacker.GetTeam()
	if ( !IsFriendlyTeam( entTeam, attackerTeam ) )
		return false

	if ( damageInfo != null && DamageIgnoresFriendlyFire( damageInfo ) )
		return false

	if ( ent.e.noFriendlyFireProtection == true )
		return false

	if ( (ent.GetOwner() != attacker) && (ent.GetBossPlayer() != attacker) )
	{
		//DamageInfo_Print( damageInfo, "friendly & not owned (" + entTeam + " vs " + attackerTeam + ")" )
		return true
	}

	if ( ent.e.noOwnerFriendlyFire == true )
	{
		//DamageInfo_Print( damageInfo, "friendly noOwnerFriendlyFire (" + entTeam + " vs " + attackerTeam + ")" )
		return true
	}

	if ( ent.IsNPC() && ent.ai.preventOwnerDamage )
	{
		//DamageInfo_Print( damageInfo, "friendly ai.preventOwnerDamage (" + entTeam + " vs " + attackerTeam + ")" )
		return true
	}

	return false
}


bool function IsProtectedFromNPCFire( entity attacker, entity ent )
{
	if ( attacker == ent )
		return false
	if ( attacker.IsNPC() && ent.IsNPC() && ent.ai.invulnerableToNPC == true )
		return true
	return false
}


bool function DamageIgnoresFriendlyFire( var damageInfo )
{
	if ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS ) )
		return true

	int damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )

	switch ( damageSourceID )
	{
		case eDamageSourceId.switchback_trap:
		case eDamageSourceId.suicideSpectreAoE:
		case eDamageSourceId.mp_weapon_defensive_bombardment_weapon: // Defensive Bombardments are team agnostic when it comes to their shellshock effect. Preventing FF damage in callback.
                   
                                                                                                                                                                                           
                                                                
                                                                                                                                                                                    
      
                        
                                                                                                                                                                                     
      

		case eDamageSourceId.damagedef_defensive_bombardment: // Defensive Bombardments are team agnostic when it comes to their shellshock effect. Preventing FF damage in callback.

		case eDamageSourceId.mp_weapon_creeping_bombardment_weapon: // Creeping Bombardments are team agnostic when it comes to their shellshock effect. Preventing FF damage in callback.

		case eDamageSourceId.damagedef_creeping_bombardment_detcord_explosion: //Creeping Bombardements/Det Cords are team agnostic when it comes to their shellshock effect. Preventing FF damage in callback.

		case eDamageSourceId.mp_weapon_tesla_trap: // Tesla Traps are team agnostic when it comes to its emp effect. Preventing FF damage in callback.
                         
                                                                                                                                                        
      
		case eDamageSourceId.spider_poison:    //Spider poison is given attacker of who shot the spider for damage numbers purposes, but it is team agnostic for damage.
                
                                                                                                                                                        
      

		case eDamageSourceId.damagedef_wrecking_ball:    //Wrecking Ball is team agnostic when it comes to the shellshock and knockback effect.

		case eDamageSourceId.mp_ability_crypto_drone_emp_trap:

		case eDamageSourceId.mp_weapon_mortar_ring:    //Mortar ring is team agnostic when it comes to its blinding effect. Preventing FF damage in callback
                                  
                                              
                                       
      

			return true
	}

	return false
}


bool function ScriptCallback_ShouldEntTakeDamage( entity ent, var damageInfo )
{
	if ( ent.IsInvulnerable() )
	{
		DamageInfo_Print( damageInfo, "invuln" )
		return false
	}

	entity attacker  = DamageInfo_GetAttacker( damageInfo )
	entity inflictor = DamageInfo_GetInflictor( damageInfo )
	bool entIsPlayer = ent.IsPlayer()

	if ( !attacker )
	{
		DamageInfo_Print( damageInfo, "no attacker" )
		return false
	}

	if ( entIsPlayer && ent.ContextAction_IsMeleeExecutionTarget() )
	{
		DamageInfo_Print( damageInfo, "being executed" )
		DamageInfo_FlagTypicalCase( damageInfo )
		return false
	}

	int damageType = DamageInfo_GetCustomDamageType( damageInfo )

	if ( attacker == ent || IsValid( inflictor ) && inflictor == ent )
	{
		if ( (damageType & DF_NO_SELF_DAMAGE) > 0 )
		{
			DamageInfo_Print( damageInfo, "self dmg" )
			return false
		}
	}

	if ( ShouldPreventDamageDueToFriendlyFire( attacker, ent, damageInfo ) )
	{
		DamageInfo_Print( damageInfo, "friendly" )
		return false
	}

	if ( IsProtectedFromNPCFire( attacker, ent ) )
	{
		DamageInfo_Print( damageInfo, "npc protected fire" )
		return false
	}

	if ( !ShouldEntTakeDamage_SPMP( ent, damageInfo ) )
	{
		DamageInfo_Print( damageInfo, "spmp" )
		return false
	}

	if ( ent.IsTitan() )
	{
		const int BULLET_VORTEX_FLAGS = (DF_VORTEX_REFIRE | DF_BULLET)
		if ( ((damageType & BULLET_VORTEX_FLAGS) == BULLET_VORTEX_FLAGS) && (ent == attacker) )
		{
			DamageInfo_Print( damageInfo, "vortex self dmg" )
			return false    // don't let vortex-refiring titan hit themselves with bullet or bullet splash damage
		}

		if ( IsTitanWithinBubbleShield( ent ) && TitanHasBubbleShieldWeapon( ent ) && !IsBitFlagSet( damageType, DF_DOOMED_HEALTH_LOSS ) )
		{
			DamageInfo_Print( damageInfo, "titan in bubble shield" )
			return false
		}
	}

	if ( IsTitanCrushDamage( damageInfo ) )
	{
		if ( attacker.IsPhaseShifted() )
		{
			DamageInfo_Print( damageInfo, "phase shifted titan crush" )
			return false
		}
	}

	if ( (inflictor != null) )
	{
		if ( inflictor.IsProjectile() )
		{
			Assert( attacker == DamageInfo_GetAttacker( damageInfo ) )
			if ( attacker == ent )
			{
				bool shouldDamageOwner = inflictor.GetProjectileWeaponSettingBool( eWeaponVar.explosion_damages_owner )
				if ( !shouldDamageOwner )
				{
					DamageInfo_Print( damageInfo, "not damaging owner" )
					return false
				}

				if ( entIsPlayer )
				{
					array<string> mods = inflictor.ProjectileGetMods()
					foreach ( mod in mods )
					{
						if ( mod == "jump_kit" )
						{
							float damageAmount = DamageInfo_GetDamage( damageInfo )
							damageAmount *= 0.75
							DamageInfo_Print( damageInfo, "jump kit mod: " + damageAmount )
							DamageInfo_SetDamage( damageInfo, damageAmount )
							//	DamageInfo_SetDamageForce( damageInfo, DamageInfo_GetDamageForce( damageInfo ) * 2.0 )
						}
					}
				}
			}
		}

		if ( inflictor.e.onlyDamageEntitiesOnce == true && inflictor.e.damagedEntities.contains( ent ) )
		{
			DamageInfo_Print( damageInfo, "onlyDamageEntitiesOnce" )
			return false
		}

		if ( inflictor.e.onlyDamageEntitiesOncePerTick == true )
		{
			float currentTime = Time()
			if ( currentTime != inflictor.e.lastDamageTickTime )
			{
				inflictor.e.damagedEntities.clear()
				inflictor.e.lastDamageTickTime = currentTime
			}
			else if ( inflictor.e.damagedEntities.contains( ent ) )
			{
				DamageInfo_Print( damageInfo, "onlyDamageEntitiesOncePerTick" )
				return false
			}
		}
	}

	if ( ent.IsPlayer() )
	{
		return ShouldPlayerTakeDamage( ent, damageInfo )
	}

	return true
}


bool function ShouldPlayerTakeDamage( entity player, var damageInfo )
{
	if ( player.IsGodMode() )
	{
		DamageInfo_Print( damageInfo, "godmode" )
		return false
	}

	if ( player.IsPhaseShifted() )
	{
		int damageSource = DamageInfo_GetDamageSourceIdentifier( damageInfo )
		bool shouldTakeDamageInPhase = ( IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_DOOMED_HEALTH_LOSS )
										|| IsDamageFromDamageTrigger( damageSource )
										|| (StatusEffect_HasSeverity( player, eStatusEffect.phase_gate_tracking ) && damageSource == eDamageSourceId.deathField )
										|| ( EMP_ShouldAffectAlterTac() && player.GetPhaseShiftType() == eShiftStyle.PHASETYPE_DOOR && damageSource == eDamageSourceId.mp_ability_crypto_drone_emp ))

		if ( !shouldTakeDamageInPhase )
		{
			DamageInfo_Print( damageInfo, "phase shifted" )
			return false
		}
	}

	if ( player.IsInvulnerable() )
	{
		DamageInfo_Print( damageInfo, "invulnerable" )
		return false
	}

	return true
}


void function HandlePainSounds( entity ent, var damageInfo )
{
	//exit if the thing is dead
	if ( ent.GetHealth() < DamageInfo_GetDamage( damageInfo ) )
		return

	PlayPainSounds( ent, damageInfo )
}


float function GetHeadshotDamageMultiplierFromDamageInfo( var damageInfo )
{
	entity inflictor = DamageInfo_GetInflictor( damageInfo )
	if ( IsValid( inflictor ) && inflictor.IsProjectile() )
	{
		float result = inflictor.GetProjectileWeaponSettingFloat( eWeaponVar.damage_headshot_scale )
		return result
	}

	entity weapon = DamageInfo_GetWeapon( damageInfo )
	if ( weapon )
	{
		float result = weapon.GetWeaponSettingFloat( eWeaponVar.damage_headshot_scale )
		return result
	}

	return 1.0
}


float function GetLegDamageMultiplierFromDamageInfo( var damageInfo )
{
	entity inflictor = DamageInfo_GetInflictor( damageInfo )
	if ( IsValid( inflictor ) && inflictor.IsProjectile() )
		return inflictor.GetProjectileWeaponSettingFloat( eWeaponVar.damage_leg_scale )

	entity weapon = DamageInfo_GetWeapon( damageInfo )
	if ( IsValid( weapon ) )
		return weapon.GetWeaponSettingFloat( eWeaponVar.damage_leg_scale )

	return 1.0
}


void function HandleLocationBasedDamage( entity ent, var damageInfo )
{
	// Don't allow non-players to get headshots or any other location bonuses
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
		return

	bool debugPrints = false
	int hitGroup     = DamageInfo_GetHitGroup( damageInfo )

	if ( debugPrints )
	{
		printt( "---------------------" )
		printt( "LOCATION BASED DAMAGE" )
		printt( "HIDGROUP ID:", hitGroup )
		if ( hitGroup == HITGROUP_GENERIC )
			printt( "HITGROUP: HITGROUP_GENERIC" )
		else if ( hitGroup == HITGROUP_HEAD )
			printt( "HITGROUP: HITGROUP_HEAD" )
		else if ( hitGroup == HITGROUP_CHEST )
			printt( "HITGROUP: HITGROUP_CHEST" )
		else if ( hitGroup == HITGROUP_STOMACH )
			printt( "HITGROUP: HITGROUP_STOMACH" )
		else if ( hitGroup == HITGROUP_LEFTARM )
			printt( "HITGROUP: HITGROUP_LEFTARM" )
		else if ( hitGroup == HITGROUP_RIGHTARM )
			printt( "HITGROUP: HITGROUP_RIGHTARM" )
		else if ( hitGroup == HITGROUP_LEFTLEG )
			printt( "HITGROUP: HITGROUP_LEFTLEG" )
		else if ( hitGroup == HITGROUP_RIGHTLEG )
			printt( "HITGROUP: HITGROUP_RIGHTLEG" )
		else if ( hitGroup == HITGROUP_GEAR )
			printt( "HITGROUP: HITGROUP_GEAR" )
		else
			printt( "HITGROUP: UNKNOWN" )
	}

	bool isValidHeadShot = IsValidHeadShot( damageInfo, ent )
	if ( isValidHeadShot )
		DamageInfo_AddCustomDamageType( damageInfo, DF_HEADSHOT )

	float damageMult_location = 1.0

	var weaponName // TODO: If set to type string, will cause errors because weaponName can be ""
	if ( DamageInfo_GetWeapon( damageInfo ) )
		weaponName = DamageInfo_GetWeapon( damageInfo ).GetWeaponClassName()
	else if ( DamageInfo_GetInflictor( damageInfo ) && (DamageInfo_GetInflictor( damageInfo ) instanceof CProjectile) )
		weaponName = DamageInfo_GetInflictor( damageInfo ).ProjectileGetWeaponClassName()

	if ( ent.IsTitan() )
	{
		damageMult_location = GetCriticalScaler( ent, damageInfo )
	}
	else if ( IsSuperSpectre( ent ) )
	{
		if ( CritWeaponInDamageInfo( damageInfo ) && IsCriticalHit( attacker, ent, DamageInfo_GetHitBox( damageInfo ), DamageInfo_GetDamage( damageInfo ), DamageInfo_GetDamageType( damageInfo ) ) )
		{
			damageMult_location = GetCriticalScaler( ent, damageInfo )
			DamageInfo_AddCustomDamageType( damageInfo, DF_CRITICAL )
		}
	}
	else if ( IsStalker( ent ) )
	{
		// note: stalker location based damage is done in _ai_stalker.gnut.
		switch ( hitGroup )
		{
			case HITGROUP_GEAR:
				DamageInfo_AddCustomDamageType( damageInfo, DF_CRITICAL )
				break
		}
	}
	else if ( isValidHeadShot )
	{
		damageMult_location = GetHeadshotDamageMultiplierFromDamageInfo( damageInfo )
	}
	else if ( IsLegDamage( ent, damageInfo ) )
	{
		if ( ShouldTakeLegDamage( ent ) )
			damageMult_location = GetLegDamageMultiplierFromDamageInfo( damageInfo )
	}

	// modify damage value based on where we hit
	if ( damageMult_location != 1.0 )
	{
		if ( debugPrints )
		{
			printt( "Multiplier:", damageMult_location )
			printt( "---------------------" )
		}

		DamageInfo_ScaleDamage( damageInfo, damageMult_location )
		DamageInfo_Print( damageInfo, "loc " + damageMult_location + " -> " + DamageInfo_GetDamage( damageInfo ) )
	}

	if ( isValidHeadShot )
	{
		RunClassHeadshotCallbacks( ent, damageInfo )
	}
}


bool function ShouldTakeLegDamage( entity ent )
{
	if ( !ent.IsPlayer() )
		return true

	if ( GetCurrentPlaylistVarBool( "low_profile_no_leg_damage", true ) && PlayerHasPassive( ent, ePassives.PAS_LOWPROFILE ) )
		return false

	return true
}


void function PlayerDamageFeedback( entity ent, var damageInfo, int shieldDamage )
{
	//printt( "player damage feedback for " + ent )
	entity attacker = DamageInfo_GetAttacker( damageInfo )

	Assert( IsValid( attacker ) )
	
	if ( attacker.IsNPC() )
	{
		Assert( CanNPCDoDamageOnBehalfOfPlayer(attacker) )

		entity playerOwner = attacker.GetBossPlayer()
		if ( IsValid( playerOwner ) )
		{
			attacker = playerOwner
		}
		else
		{
			//player might have DC'd (or died)
			return
		}
	}

	int customDamageType = DamageInfo_GetCustomDamageType( damageInfo )

	if ( IsMaxRangeShot( damageInfo ) )
		customDamageType = customDamageType | DF_MAX_RANGE

	if ( ent.GetHealth() - DamageInfo_GetDamage( damageInfo ) <= 0 )
	{
		if ( (!ent.IsNPC() || ent.ai.killShotSound) && ShouldDoKillFeedback( ent ) )
			customDamageType = customDamageType | DF_KILLSHOT
	}

	DamageInfo_SetDidDamage( damageInfo, shieldDamage )

	if ( shieldDamage > 0 )
		attacker.NotifyDidDamage( ent, DamageInfo_GetHitBox( damageInfo ), DamageInfo_GetDamagePosition( damageInfo ), customDamageType, shieldDamage, DamageInfo_GetDamageFlags( damageInfo ), DamageInfo_GetHitGroup( damageInfo ), DamageInfo_GetWeapon( damageInfo ), DamageInfo_GetDistFromAttackOrigin( damageInfo ) )

	if ( DamageInfo_GetDamage( damageInfo ) > 0 )
		attacker.NotifyDidDamage( ent, DamageInfo_GetHitBox( damageInfo ), DamageInfo_GetDamagePosition( damageInfo ), ClearBitFlag( customDamageType, DF_SHIELD_DAMAGE ), DamageInfo_GetDamage( damageInfo ), DamageInfo_GetDamageFlags( damageInfo ), DamageInfo_GetHitGroup( damageInfo ), DamageInfo_GetWeapon( damageInfo ), DamageInfo_GetDistFromAttackOrigin( damageInfo ) )

	//attacker.NotifyDidDamage( ent, DamageInfo_GetHitBox( damageInfo ), DamageInfo_GetDamagePosition( damageInfo ), customDamageType, DamageInfo_GetDamage( damageInfo ), 0, DamageInfo_GetHitGroup( damageInfo ), DamageInfo_GetWeapon( damageInfo ), DamageInfo_GetDistFromAttackOrigin( damageInfo ) )
}


bool function ShouldDoKillFeedback( entity ent )
{
	if ( !ent.IsPlayer() )
		return true
	if ( ent.IsShadowForm() )
		return false
	return true
}


void function UpdateLastDamageTime( entity ent, entity attacker )
{
	if ( ent.IsPlayer() )
		ent.UpdateLastTimeDamaged( attacker )
	
	if ( ent.IsNPC() )
		ent.ai.lastDamageTime = Time()
}


