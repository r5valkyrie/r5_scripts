#endif


void function ShLoadouts_LevelInit_Begin()
{
	S3_InitValidCharacterLoadoutFields()

	// Note that this resets the state of the UI VM as well
	// Thus setting isInitialized to false whenever reinitialization is done
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	#if UI
		if ( IsConnected() ) // should always be true, but we have had weird transitional issues when going between servers in other cases...
			fileLevel.runHighPerfLoadouts = GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) // the UI might not be connected to a Server when fetching Loadscreen / Music, so we cache the playlist kill switch
	#endif

	#if SERVER || CLIENT
		Remote_RegisterServerFunction( "ClientCallback_loadouts_set", "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( "ClientCallback_favorites_set", "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( "ClientCallback_favorites_clear", "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( LOADOUT_CLIENT_CALLBACK_TOGGLE_DEATHBOX, "int", 0, INT_MAX, "int", 0, INT_MAX, "int", 0, INT_MAX ) // ItemFlavor.guid, ItemFlavor.guid, ItemFlavor.guid
	#endif

	#if SERVER
		#if DEVELOPER
			AddCallback_GeneratePDef( GenerateLoadoutsPDef )
			AddClientCommandCallback( "loadouts_devset", ClientCommand_loadouts_devset ) // dev
		#endif
	#endif

	// Initialize bot loadout data
	// bot_loadout datatables not available
	#if false // SERVER - disabled
	{
		var botLoadoutCharactersDataTable = GetDataTable( LOADOUT_BOT_CHARACTERS_DATATABLE )
		int characterAssetColumn = GetDataTableColumnByName( botLoadoutCharactersDataTable, "characterAsset" )
		int characterIsExcludedColumn = GetDataTableColumnByName( botLoadoutCharactersDataTable, "exclude" )
		int numOfRowsInCharacterDataTable = GetDataTableRowCount( botLoadoutCharactersDataTable )
		for ( int characterIndex = 0; characterIndex < numOfRowsInCharacterDataTable; characterIndex++ )
		{
			if ( GetDataTableBool( botLoadoutCharactersDataTable, characterIndex, characterIsExcludedColumn ) )
			{
				continue
			}

			asset characterAsset = GetDataTableAsset( botLoadoutCharactersDataTable, characterIndex, characterAssetColumn )
			if ( characterAsset == $"" )
			{
				continue
			}

			fileLevel.botLoadoutInfo.validCharacterAssetsForLoadout.append( characterAsset )
		}

		var botLoadoutBadgesDataTable = GetDataTable( LOADOUT_BOT_BADGES_DATATABLE )
		int badgeAssetPathTemplateColumn = GetDataTableColumnByName( botLoadoutBadgesDataTable, "badgeAssetPathTemplate" )
		int badgeMinValueColumn = GetDataTableColumnByName( botLoadoutBadgesDataTable, "badgeMinValue" )
		int badgeMaxValueColumn = GetDataTableColumnByName( botLoadoutBadgesDataTable, "badgeMaxValue" )
		int badgeIsRequiredColumn = GetDataTableColumnByName( botLoadoutBadgesDataTable, "isRequired" )
		int numOfRowsInBadgesDataTable = GetDataTableRowCount( botLoadoutBadgesDataTable )
		for ( int badgeIndex = 0; badgeIndex < numOfRowsInBadgesDataTable; badgeIndex++ )
		{
			string badgeAssetPathTemplate = GetDataTableString( botLoadoutBadgesDataTable, badgeIndex, badgeAssetPathTemplateColumn )
			if ( badgeAssetPathTemplate == "" )
			{
				continue
			}

			BotLoadoutInfoBadge newBotLoadoutInfoBadge
			newBotLoadoutInfoBadge.badgeAssetPathTemplate = badgeAssetPathTemplate
			newBotLoadoutInfoBadge.minBadgeValue = GetDataTableInt( botLoadoutBadgesDataTable, badgeIndex, badgeMinValueColumn )
			newBotLoadoutInfoBadge.maxBadgeValue = GetDataTableInt( botLoadoutBadgesDataTable, badgeIndex, badgeMaxValueColumn )

			if ( GetDataTableBool( botLoadoutBadgesDataTable, badgeIndex, badgeIsRequiredColumn ) )
			{
				fileLevel.botLoadoutInfo.requiredBadges.append( newBotLoadoutInfoBadge )
			}
			else
			{
				fileLevel.botLoadoutInfo.optionalBadges.append( newBotLoadoutInfoBadge )
			}
		}

		var botLoadoutStatTrackersDataTable = GetDataTable( LOADOUT_BOT_STATTRACKERS_DATATABLE )
		int statTrackerAssetPathTemplateColumn = GetDataTableColumnByName( botLoadoutStatTrackersDataTable, "statTrackerAssetPathTemplate" )
		int statTrackerMinValueColumn = GetDataTableColumnByName( botLoadoutStatTrackersDataTable, "statTrackerMinValue" )
		int statTrackerMaxValueColumn = GetDataTableColumnByName( botLoadoutStatTrackersDataTable, "statTrackerMaxValue" )
		int numOfRowsInStatTrackersDataTable = GetDataTableRowCount( botLoadoutStatTrackersDataTable )
		for ( int statTrackerIndex = 0; statTrackerIndex < numOfRowsInStatTrackersDataTable; statTrackerIndex++ )
		{
			string statTrackerAssetPathTemplate = GetDataTableString( botLoadoutStatTrackersDataTable, statTrackerIndex, statTrackerAssetPathTemplateColumn )
			if ( statTrackerAssetPathTemplate == "" )
			{
				continue
			}

			BotLoadoutInfoStatTracker newBotLoadoutInfoStatTracker
			newBotLoadoutInfoStatTracker.statTrackerAssetPathTemplate = statTrackerAssetPathTemplate
			newBotLoadoutInfoStatTracker.minStatValue = GetDataTableInt( botLoadoutStatTrackersDataTable, statTrackerIndex, statTrackerMinValueColumn )
			newBotLoadoutInfoStatTracker.maxStatValue = GetDataTableInt( botLoadoutStatTrackersDataTable, statTrackerIndex, statTrackerMaxValueColumn )

			fileLevel.botLoadoutInfo.optionalTrackers.append( newBotLoadoutInfoStatTracker )
		}

		var botLoadoutGenericAssetInfoDataTable = GetDataTable( LOADOUT_BOT_GENERIC_ASSET_INFO_DATATABLE )
		int loadoutCategoryColumn = GetDataTableColumnByName( botLoadoutGenericAssetInfoDataTable, "loadoutCategory" )
		int assetPathTemplateColumn = GetDataTableColumnByName( botLoadoutGenericAssetInfoDataTable, "assetPathTemplate" )
		int variationMinValueColumn = GetDataTableColumnByName( botLoadoutGenericAssetInfoDataTable, "variationMinValue" )
		int variationMaxValueColumn = GetDataTableColumnByName( botLoadoutGenericAssetInfoDataTable, "variationMaxValue" )
		int numOfRowsInGenericAssetInfoDataTable = GetDataTableRowCount( botLoadoutGenericAssetInfoDataTable )
		for ( int assetInfoIndex = 0; assetInfoIndex < numOfRowsInGenericAssetInfoDataTable; assetInfoIndex++ )
		{
			string loadoutCategoryName = GetDataTableString( botLoadoutGenericAssetInfoDataTable, assetInfoIndex, loadoutCategoryColumn )
			string assetPathTemplate   = GetDataTableString( botLoadoutGenericAssetInfoDataTable, assetInfoIndex, assetPathTemplateColumn )
			if ( (loadoutCategoryName == "") || (assetPathTemplate == "") )
			{
				continue
			}

			int minVariationValue = GetDataTableInt( botLoadoutGenericAssetInfoDataTable, assetInfoIndex, variationMinValueColumn )
			int maxVariationValue = GetDataTableInt( botLoadoutGenericAssetInfoDataTable, assetInfoIndex, variationMaxValueColumn )
			Assert( (maxVariationValue >= minVariationValue) && (maxVariationValue != 0), "Invalid Variation Info provided in bot_loadout_generic_asset_info DataTable" )

			BotLoadoutGenericAssetInfo newBotLoadoutGenericAsset
			newBotLoadoutGenericAsset.assetPathTemplate = assetPathTemplate
			newBotLoadoutGenericAsset.minVariationValue = minVariationValue
			newBotLoadoutGenericAsset.maxVariationValue = maxVariationValue

			int loadoutCategory = eLoadoutCategory[loadoutCategoryName]
			fileLevel.botLoadoutInfo.genericAssets[loadoutCategory].append( newBotLoadoutGenericAsset )
		}
	}
	#endif
}

void function ShLoadouts_LevelInit_Finish()
{
	#if SERVER || CLIENT
		Remote_RegisterClientFunction( "ServerToClient_LoadoutSlotDidChange", "entity", "int", 0, fileLevel.loadoutSlotEntries.len() )
		Remote_RegisterClientFunction( LOADOUT_SERVER_CALLBACK_DEATHBOX_TOGGLED, "int", 0, INT_MAX, "int", 0, INT_MAX, "int", 0, INT_MAX ) // ItemFlavor.guid, ItemFlavor.guid, ItemFlavor.guid
		int batchMax = fileLevel.loadoutSlotEntries.len() + 1
		Remote_RegisterClientFunction( "ServerToClient_LoadoutSlotDidChangeBatch", "entity",
			"int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax,
			"int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax, "int", 0, batchMax)
		Remote_RegisterClientFunction( "ServerToClient_LoadoutSlotSetFailed" )
	#endif

	foreach ( LoadoutEntry entry in fileLevel.loadoutSlotEntries )
	{
		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			// Guard against empty validItemFlavorList — asserts don't stop execution in release builds
			// so accessing defaultItemFlavor.guid after a failed assert would crash
			if ( entry.validItemFlavorList.len() == 0 )
			{
				printf( "WARNING: Entry '%s' has empty validItemFlavorList, skipping validation\n", entry.id )
				RegisterSignal( format( LOADOUT_ID_READY, entry.id ) )
				continue
			}
			Assert( entry.validItemFlavorList.len() > 0, "Entry " + entry.id + " had an empty validItemFlavorList" )
			Assert( IsItemFlavorStructValid( entry.defaultItemFlavor.guid, eValidation.DONT_ASSERT ), "entry.defaultValue must have a valid value." )
			#if ASSERTS
				if ( entry.associatedCharacterOrNull != null  )
				{
					ItemFlavor ornull character = entry.associatedCharacterOrNull
					expect ItemFlavor( character )
					if ( CharacterClass_GetIsShippingCharacter( character ) )
						Assert( ItemFlavor_GetGRXMode( entry.defaultItemFlavor ) == eItemFlavorGRXMode.NONE )
				}
			#endif // #if ASSERTS
		}
		else if ( entry.type == eLoadoutEntryType.INTEGER )
		{
			// Skip defaultItemFlavor.guid check — accessing NULL reference crashes
			// For INTEGER entries, defaultItemFlavor is expected to be invalid/unset anyway
			// Assert( !IsItemFlavorStructValid( entry.defaultItemFlavor.guid, eValidation.DONT_ASSERT ) )
			Assert( entry.validItemFlavorList.len() == 0 )
			Assert( entry.isItemFlavorUnlocked == null )
			#if SERVER
				Assert( entry.specialValidationFunc == null )
			#endif
		}

		array<string> ornull forceResetTo = GetLoadoutSlotForceResetTo( entry )
		if ( forceResetTo != null )
		{
			foreach ( string itemRef in expect array<string>(forceResetTo) )
			{
				if ( itemRef == "~default~" || itemRef == "~random~" )
					continue

				if ( !IsValidItemFlavorGUID( ConvertItemFlavorGUIDStringToGUID( itemRef ) ) )
				{
					Warning( "Playlist var 'loadout_slot_%s_force_reset_to' refers unknown to unknown item: '%s'", entry.id, itemRef )
					continue
				}

				ItemFlavor itemFlav = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( itemRef ) )
				if ( !entry.validItemFlavorList.contains( itemFlav ) )
				{
					printf( "Note: Playlist var 'loadout_slot_%s_force_reset_to' is causing loadout slot '%s' to have new valid item flavor: %s", entry.id, entry.id, itemRef )
					entry.validItemFlavorList.append( itemFlav )
				}
			}
		}

		RegisterSignal( format( LOADOUT_ID_READY, entry.id ) )

		if ( entry.networkTo == eLoadoutNetworking.PLAYER_GLOBAL )
		{
			#if SERVER || CLIENT
				int desiredNetworkVarType = SNVT_BIG_INT
			#endif

			Assert( entry.networkVarName != "", "LoadoutEntry.networkVarName must be provided if networkTo is set." )
			LoadoutNetworkVarInfo nvInfo
			string fullNetworkVarName = "Loadout_" + expect string(entry.networkVarName)
			entry.networkVarName = fullNetworkVarName
			if ( fullNetworkVarName in fileLevel.networkVars )
			{
				nvInfo = fileLevel.networkVars[fullNetworkVarName]
				#if SERVER || CLIENT
					Assert( nvInfo.type == desiredNetworkVarType )
				#endif
			}
			else
			{
				nvInfo.nvIndex = fileLevel.networkVars.len()
				nvInfo.fullNetworkVarName = fullNetworkVarName
				fileLevel.networkVars[fullNetworkVarName] <- nvInfo
				#if SERVER || CLIENT
					nvInfo.type = desiredNetworkVarType
					RegisterNetworkedVariableSafe(
						nvInfo.fullNetworkVarName, SNDC_PLAYER_GLOBAL,
						nvInfo.type, SLOT_CONTENTS_SENTINEL_NOTREADY
					)
				#endif

				#if CLIENT
					RegisterNetVarIntChangeCallback( fullNetworkVarName, void function( entity player, int new ) : ( nvInfo )
					{
						EHI playerEHI         = ToEHI( player )
						EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )

						#if LOADOUT_NETVAR_DEBUG_PRINTS
							printf( "### LOADOUT SLOT NV, %s (%s), %s --[%d]-> %d (=%d)",
								string(player), string(EHI_IsConnected( playerEHI )), nvInfo.fullNetworkVarName,
								ehiss.netVarsLastSeenValuesMap[nvInfo.nvIndex], new, player.GetPlayerNetInt( nvInfo.fullNetworkVarName ) )
						#endif

						new = player.GetPlayerNetInt( nvInfo.fullNetworkVarName ) // todo(dw): workaround for R5DEV-53709

						if ( !ehiss.isConnected )
							return

						if ( new == ehiss.netVarsLastSeenValuesMap[nvInfo.nvIndex] )
							return

						ehiss.netVarsLastSeenValuesMap[nvInfo.nvIndex] = new

						#if ASSERTS
							LoadoutEntry ornull found = null
						#endif
						foreach ( LoadoutEntry entry in nvInfo.usedByEntries )
						{
							if ( IsLoadoutSlotCurrentlyNetworked( playerEHI, entry ) )
							{
								#if ASSERTS
									Assert( found == null, "Attempted to network two loadout slots using the same network variable name at the same time"
									+ " (slot 1: \"" + expect LoadoutEntry(found).id + "\", slot 2: \"" + entry.id + "\")." )
									if ( found != null )
										continue
									found = entry
								#endif
								HandleLoadoutSlotNetworkVarChanged( playerEHI, entry, new )
								#if !ASSERTS
									break
								#endif
							}
						}
					} )
				#endif
			}

			entry.nvIndex = nvInfo.nvIndex
			nvInfo.usedByEntries.append( entry )
		}
		else
		{
			if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
			{
				if ( entry.networkTo == eLoadoutNetworking.PLAYER_EXCLUSIVE )
				{
					Assert( entry.networkVarName == "", "LoadoutEntry.networkVarName should only be provided if networkTo is PLAYER_GLOBAL." )
				}
				else Assert( false, "Invalid networkTo setting on loadout slot \"" + entry.id + "\": " + entry.networkTo )
			}
		}

		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			Assert( entry.validItemFlavorList.len() > 0, "No item flavors are registered that are valid for loadout slot '" + entry.id + "'" )

			// Disable favorites — pdef has no _fav fields
			entry.maxFavoriteCount = 0

			// Disable backups — pdef has no _bak fields
			entry.backupCount = 0
		}

		if ( entry.associatedCharacterOrNull != null )
		{
			ItemFlavor ornull character = entry.associatedCharacterOrNull
			expect ItemFlavor ( character )
			LoadoutEntry characterEntry = Loadout_Character()
			array< LoadoutEntry > dependentsForCharacter
			if ( character in characterEntry.dependentsByItemFlav )
				dependentsForCharacter = characterEntry.dependentsByItemFlav[ character ]
			else
				characterEntry.dependentsByItemFlav[ character ] <- dependentsForCharacter

			dependentsForCharacter.append( entry )
		}

	}

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			printt( "LoadoutsDbg: dev_loadouts_ignore_persistence is enabled" )
	#endif

	fileLevel.isInitialized = true
}


#if UI
void function ShLoadouts_LevelShutdown()
{
	// No longer need to set isInitialized to false as we reset in ShLoadouts_LevelInit_Begin
}
#endif


//////////////////////////
//////////////////////////
//// Global functions ////
//////////////////////////
//////////////////////////
LoadoutEntry function RegisterLoadoutSlot( int type, string id, int classId = -1 )
{
	Assert( !fileLevel.isInitialized, "Cannot call RegisterLoadoutSlot after initialization has finished." )
	Assert( type == eLoadoutEntryType.ITEM_FLAVOR || type == eLoadoutEntryType.INTEGER )

	#if ASSERTS
		foreach ( LoadoutEntry otherEntry in fileLevel.loadoutSlotEntries )
			Assert( id != otherEntry.id, "Found loadout slots with the same id: " + id )
	#endif

	LoadoutEntry entry
	entry.entryIndex        = fileLevel.loadoutSlotEntries.len()
	entry.id                = id
	entry.type              = type
	entry.loadoutEntryClass = classId
	entry.pdefKey           = Loadout_ComputePdefKey( id, classId )

	fileLevel.loadoutSlotEntries.append( entry )
	if ( classId == eLoadoutEntryClass.ACCOUNT || classId == eLoadoutEntryClass.WEAPON )
		fileLevel.accountLoadoutSlotEntries.append( entry )

	return entry
}

void function S3_InitValidCharacterLoadoutFields()
{
	S3_VALID_CHARACTER_LOADOUT_FIELDS["skin"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["execution"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["intro_quip"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["kill_quip"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["meleeskin"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_frame"] <- true
	S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_stance"] <- true
	for ( int i = 0; i < 8; i++ )
	{
		S3_VALID_CHARACTER_LOADOUT_FIELDS["quips_" + i] <- true
		S3_VALID_CHARACTER_LOADOUT_FIELDS["skydive_emote_" + i] <- true
	}
	for ( int i = 0; i < 3; i++ )
	{
		S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_badge_" + i] <- true
		S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_badge_" + i + "_tier"] <- true
		S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_tracker_" + i] <- true
		S3_VALID_CHARACTER_LOADOUT_FIELDS["gcard_tracker_" + i + "_value"] <- true
	}
	for ( int i = 0; i < 4; i++ )
	{
		S3_VALID_CHARACTER_LOADOUT_FIELDS["favoredQuip_" + i] <- true
	}
}

// Compute the correct persistence key for a loadout slot.
// Pdef uses "character_loadouts[GUID].fieldName" for character entries
// and "loadouts.<id>" for account/weapon entries.
// Returns "" if the pdef field doesn't exist.
string function Loadout_ComputePdefKey( string id, int classId )
{
	if ( classId == eLoadoutEntryClass.CHARACTER )
	{
		// Parse GUID and field name from id format: "<prefix>_for_SAID<digits>"
		int ornull forIdx = id.find( "_for_" )
		if ( forIdx != null )
		{
			expect int( forIdx )
			string fieldName = id.slice( 0, forIdx )
			string guid = id.slice( forIdx + 5 ) // skip "_for_"

			// Strip "character_" prefix to match pdef field names
			// e.g. "character_skin" -> "skin", "character_execution" -> "execution"
			if ( fieldName.find( "character_" ) == 0 )
				fieldName = fieldName.slice( 10 )

			// Validate field exists in pdef
			if ( !(fieldName in S3_VALID_CHARACTER_LOADOUT_FIELDS) )
			{
				printf( "S3 WARNING: Character loadout field '%s' not in S3 pdef (entry: %s)\n", fieldName, id )
				return "" // Mark as no-persistence
			}

			return "character_loadouts[" + guid + "]." + fieldName
		}
	}

	// Account/weapon entries: "loadouts.<id>"
	return LOADOUT_PDEF_PREFIX + id
}


bool function LoadoutSlot_IsReady( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if CLIENT
		if ( !IsLocalClientEHIValid() )
			return false
	#endif

	#if CLIENT || UI
		if ( !IsLoadoutSlotCurrentlyAccessible( playerEHI, entry ) )
			return false
	#endif

	return GetLoadoutSlotContentsIndexInternal( playerEHI, entry ) != SLOT_CONTENTS_SENTINEL_NOTREADY
}


ItemFlavor function LoadoutSlot_GetItemFlavor( EHI playerEHI, LoadoutEntry entry, bool ignoreFavoriting = false )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	int slotContentsIndex = SLOT_CONTENTS_SENTINEL_NOTREADY
#if CLIENT || UI
	if ( IsLoadoutSlotCurrentlyAccessible( playerEHI, entry ) )
#endif
	{
		slotContentsIndex = GetLoadoutSlotContentsIndexInternal( playerEHI, entry, ignoreFavoriting )
	}


	//Assert( slotContentsIndex != SLOT_CONTENTS_SENTINEL_NOTREADY, "LoadoutSlot_GetItemFlavor used on a loadout slot that was not ready." )

	if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID || slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY )
	{
		// Check validItemFlavorList first — defaultItemFlavor may be NULL
		if ( entry.validItemFlavorList.len() > 0 )
			return entry.validItemFlavorList[0]
		return entry.defaultItemFlavor
	}

	ItemFlavor flav = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )

	if ( !ignoreFavoriting )
	{
		Assert( !ItemFlavor_IsTheFavoriteSentinel( flav ) )
	}

	return flav
}


ItemFlavor function LoadoutSlot_GetItemFlavor_ForValidation( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	int slotContentsIndex = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, entry, eValidation.DONT_ASSERT )
	if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID || slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY )
	{
		// Check validItemFlavorList first — defaultItemFlavor may be NULL
		if ( entry.validItemFlavorList.len() > 0 )
			return entry.validItemFlavorList[0]
		return entry.defaultItemFlavor
	}
	return ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
}


int function LoadoutSlot_GetInteger( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.INTEGER )

	int slotContentsIndex = GetLoadoutSlotContentsIndexInternal( playerEHI, entry )
	Assert( slotContentsIndex != SLOT_CONTENTS_SENTINEL_NOTREADY, "LoadoutSlot_GetItemFlavor used on a loadout slot that was not ready." )

	return (slotContentsIndex - SLOT_CONTENTS_INTEGER_OFFSET)
}

array<ItemFlavor> function LoadoutSlot_GetFavorites( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if CLIENT || UI
		Assert( playerEHI == LocalClientEHI() )
	#endif

	array<ItemFlavor> items

	if ( entry.favoritePdefKeys == null )
		return items

	array<string> ornull favorites = entry.favoritePdefKeys
	expect array<string>( favorites )
	foreach ( key in favorites )
	{
		#if SERVER || CLIENT
			#if CLIENT
				Assert( playerEHI == LocalClientEHI() )
			#endif
			entity player = FromEHI( playerEHI )
			int guid      = expect int(player.GetPersistentVar( LOADOUT_PDEF_PREFIX + key ))
		#endif

		#if UI
			Assert( playerEHI == LocalClientEHI() )
			int guid = expect int(GetPersistentVar( LOADOUT_PDEF_PREFIX + key ))
		#endif

		if ( guid != 0 && IsValidItemFlavorGUID( guid, eValidation.DONT_ASSERT ) )  // If guid doesn't exist, the underlying asset may have changed.  No biggie. Just no favorite.
		{
			ItemFlavor flav = GetItemFlavorByGUID( guid )
			if ( IsItemFlavorGRXUnlockedForLoadoutSlot( playerEHI, flav ) )
				items.append( flav )
		}
	}

	return items
}

array<ItemFlavor> function LoadoutSlot_GetBackups( EHI playerEHI, LoadoutEntry entry )
{
	array<ItemFlavor> items
	// Backups disabled (no bak pdef fields)
	if ( entry.backupPdefKeys == null )
		return items
	array<string> ornull backups = entry.backupPdefKeys
	expect array<string>( backups )
	foreach ( key in backups )
	{
		#if SERVER || CLIENT
			#if CLIENT
				Assert( playerEHI == LocalClientEHI() )
			#endif
			entity player = FromEHI( playerEHI )
			int guid      = expect int(player.GetPersistentVar( LOADOUT_PDEF_PREFIX + key ))
		#endif

		#if UI
			Assert( playerEHI == LocalClientEHI() )
			int guid = expect int(GetPersistentVar( LOADOUT_PDEF_PREFIX + key ))
		#endif

		if ( guid != 0 && IsValidItemFlavorGUID( guid, eValidation.DONT_ASSERT ) )  // If guid doesn't exist, the underlying asset may have changed.  No biggie. Just no favorite.
		{
			ItemFlavor flav = GetItemFlavorByGUID( guid )
			if ( IsItemFlavorGRXUnlockedForLoadoutSlot( playerEHI, flav ) )
				items.append( flav )
		}
	}

	return items
}

array<ItemFlavor> function LoadoutSlot_GetUsableFavorites( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	array<ItemFlavor> items = LoadoutSlot_GetFavorites( playerEHI, entry )

	if ( items.len() == 0 )
	{
		// Check validItemFlavorList first — defaultItemFlavor may be NULL
		if ( entry.validItemFlavorList.len() > 0 )
			items.append( entry.validItemFlavorList[0] )
		else
			items.append( entry.defaultItemFlavor )
	}

	return items
}


ItemFlavor function LoadoutSlot_WaitForItemFlavor( EHI playerEHI, LoadoutEntry entry )
{
	#if SERVER
		EndSignal( playerEHI, "OnDestroy" )
	#endif

	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	int slotContentsIndex
	while ( true )
	{
#if CLIENT || UI
		if ( IsLoadoutSlotCurrentlyAccessible( playerEHI, entry ) )
#endif
		{
			slotContentsIndex = GetLoadoutSlotContentsIndexInternal( playerEHI, entry )
			if ( IsValidLoadoutSlotContentsIndexForItemFlavor( entry, slotContentsIndex ) )
				break
		}

		WaitSignal( WaitForEHISignalDummy( playerEHI ), format( LOADOUT_ID_READY, entry.id ) )
	}

	return ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
}


int function LoadoutSlot_GetRawStorageContents( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	int slotContentsIndex = GetLoadoutSlotContentsIndexInternal( playerEHI, entry )

	// TODO - R5DEV-350895: START - Loadouts Perf Improvements
	#if CLIENT || SERVER
		if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) )
	#elseif UI
		if ( fileLevel.runHighPerfLoadouts ) // the UI might not be connected to a Server because of Loadscreens
	#endif
	{
		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR && slotContentsIndex != SLOT_CONTENTS_SENTINEL_NOTREADY && slotContentsIndex != SLOT_CONTENTS_SENTINEL_INVALID )
		{
			ItemFlavor flav = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
			return ItemFlavor_GetGUID( flav )
		}
	}
	else // END - Loadouts Perf Improvements
	{
		Assert( slotContentsIndex != SLOT_CONTENTS_SENTINEL_NOTREADY, "LoadoutSlot_GetRawStorageContents used on a loadout slot that was not ready." )

		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			ItemFlavor flav = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
			return ItemFlavor_GetGUID( flav )
		}
	}

	return slotContentsIndex // eLoadoutEntryType.INTEGER
}


void function AddCallback_ItemFlavorLoadoutSlotDidChange_AnyPlayer( LoadoutEntry entry, ItemFlavorLoadoutSlotDidChangeFuncType callback, bool shouldCheckRegistered = true )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	if ( shouldCheckRegistered )
		Assert( !entry.changeCallbacks_ItemFlavor.contains( callback ), "Tried to add a callback that was already added" )
	else if ( entry.changeCallbacks_ItemFlavor.contains( callback ) )
		return

	entry.changeCallbacks_ItemFlavor.append( callback )
}


void function AddCallback_IntegerLoadoutSlotDidChange_AnyPlayer( LoadoutEntry entry, IntegerLoadoutSlotDidChangeFuncType callback )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.INTEGER )
	Assert( !entry.changeCallbacks_Integer.contains( callback ), "Tried to add a callback that was already added" )

	entry.changeCallbacks_Integer.append( callback )
}


void function RemoveCallback_ItemFlavorLoadoutSlotDidChange_AnyPlayer( LoadoutEntry entry, ItemFlavorLoadoutSlotDidChangeFuncType callback, bool shouldCheckRegistered = true )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	if ( shouldCheckRegistered )
		Assert( entry.changeCallbacks_ItemFlavor.contains( callback ), "Tried to remove a callback that was not added" )
	else if ( !entry.changeCallbacks_ItemFlavor.contains( callback ) )
		return

	entry.changeCallbacks_ItemFlavor.fastremovebyvalue( callback )
}


void function RemoveCallback_IntegerLoadoutSlotDidChange_AnyPlayer( LoadoutEntry entry, IntegerLoadoutSlotDidChangeFuncType callback )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.INTEGER )
	Assert( entry.changeCallbacks_Integer.contains( callback ), "Tried to remove a callback that was not added" )

	entry.changeCallbacks_Integer.fastremovebyvalue( callback )
}


void function AddCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( EHI playerEHI, LoadoutEntry entry, ItemFlavorLoadoutSlotDidChangeFuncType callback, bool shouldCheckRegistered = true )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )

	array<ItemFlavorLoadoutSlotDidChangeFuncType> changeCallbacks
	if ( entry.entryIndex in ehiss.itemFlavorLoadoutSlotChangedCallbacksMap )
		changeCallbacks = ehiss.itemFlavorLoadoutSlotChangedCallbacksMap[entry.entryIndex]
	else
		ehiss.itemFlavorLoadoutSlotChangedCallbacksMap[entry.entryIndex] <- changeCallbacks

	if ( shouldCheckRegistered )
		Assert( !changeCallbacks.contains( callback ), "Tried to add a callback that was already added" )
	else if ( changeCallbacks.contains( callback ) )
		return

	changeCallbacks.append( callback )
}


void function RemoveCallback_ItemFlavorLoadoutSlotDidChange_SpecificPlayer( EHI playerEHI, LoadoutEntry entry, ItemFlavorLoadoutSlotDidChangeFuncType callback, bool shouldCheckRegistered = true )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )

	array<ItemFlavorLoadoutSlotDidChangeFuncType> changeCallbacks
	if ( entry.entryIndex in ehiss.itemFlavorLoadoutSlotChangedCallbacksMap )
		changeCallbacks = ehiss.itemFlavorLoadoutSlotChangedCallbacksMap[entry.entryIndex]
	else
		ehiss.itemFlavorLoadoutSlotChangedCallbacksMap[entry.entryIndex] <- changeCallbacks

	if ( shouldCheckRegistered )
		Assert( changeCallbacks.contains( callback ), "Tried to remove a callback that was not added" )
	else if ( !changeCallbacks.contains( callback ) )
		return

	changeCallbacks.fastremovebyvalue( callback )
}


