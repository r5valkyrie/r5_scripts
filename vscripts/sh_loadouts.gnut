global enum eLoadoutEntryClass
{
	CHARACTER, // skins, etc
	WEAPON, // skins & charms
	ACCOUNT, // base character selection, musicpacks, loadscreens, skydive trails, etc
}

global enum eTristate
{
	TRUE,
	FALSE,
	UNKNOWN,
}

global enum eLoadoutSortPriority
{
	HAS_SOURCE_ICON = ( 1 << 0 ),

	COMMON = ( 1 << 1 ),
	RARE = ( 1 << 2 ),
	EPIC = ( 1 << 3 ),
	LEGENDARY = ( 1 << 4 ),
	ICONIC = ( 1 << 5 ),
	MYTHIC = ( 1 << 6 ),

	WEAPON_REACTIVE = ( 1 << 7 ),
	RANDOM = ( 1 << 8 ),
	DEFAULT = ( 1 << 9 ),
	SENTINEL = ( 1 << 10 ),
	FAVORITE = ( 1 << 11 ),

	EQUIPPED = ( 1 << 12 ),
}

// lots of these could also be ornull to save space
// the actual ItemFlavor GUID is saved in persistence. Note that this can mean that we save TheEmpty or TheFavorite - both "sentinel" values - rather than 0
// on favorite slots can have an actual 0 value saved
global struct LoadoutEntry
{
	int entryIndex = -1 // used for indexing into the EHISS callbacks itemFlavorLoadoutSlotChangedCallbacksMap
	int nvIndex // this is used to access caches values on the Client EHISS where we store loadout values, this is so after a player dies, we can still show the correct gladiator card...
	// not entirely clear why we don't just use the id here rather than fabricating a value that could _possibly_ get out of sync between server and client

	string id = "" // this with `loadouts.` prefix is the actual persistence var
	string pdefKey = "" // computed persistence key (character_loadouts[GUID].field or loadouts.id)
	int    type = -1 // ITEM_FLAVOR or INTEGER
	int    loadoutEntryClass = eLoadoutEntryClass.ACCOUNT
	int    category = eLoadoutCategory.OTHER
	int    stryderCharDataArrayIndex = ePlayerStryderCharDataArraySlots.INVALID // for sh_social.gnut

	string DEV_name       = "?" // used by DEV menu (moved outside #if DEVELOPER for compat)
	string DEV_category   = ""
	#if DEVELOPER
		string pdefSectionKey = LOADOUT_TREE_TOP_TIER // needed by PDEF autogen
		#if SERVER
			LoadoutEntry_IsCurrentlyRelevantFuncType isCurrentlyRelevant = null // optional, default = is relevant (currently only used for dev-menu!)
		#endif
	#endif // DEVELOPER

	int maxFavoriteCount = 0 // this is always 8 currently, though it doesn't need to be. Could also be set by category in a table and removed. MOST entries this is zero; only applies to - skin, loadscreen, music pack, skydive emote
	// note that we also have "favored" quips (up to four) --> DELETE THESE! (eventually...)
	int backupCount = 0 // similar to favorites, but we don't rotate through; we just use these as storage
	array<string> ornull backupPdefKeys = null // for slots that have backups. ornull to save space

	// NETWORKING
	int           networkTo = eLoadoutNetworking.PLAYER_EXCLUSIVE
	string ornull networkVarName = ""

	// REFACTOR - too generic; only really difference here is character select vs everything else
	LoadoutEntry_IsSlotLocked      isSlotLocked = null // optional, default = unlocked IsLobby() for EVERYTHING other than CharacterSelection. Used by skins but deprecated (skin selection at runtime)
	bool           isAllowedToChangeDuringMatch = false // only true for Character selection slot
	ItemFlavor ornull associatedCharacterOrNull = null // the associated character if there is one

	ItemFlavor& defaultItemFlavor // optional, any valid item flavor or an error if none found
	ItemFlavor& favoriteItemFlavor // optional, any valid item flavor or an error if none found - stores "THE FAVORITE" (sentinel value) BUT ONLY FOR SLOTS THAT SUPPORT FAVORITING - skins, music, loadscreen

	array<ItemFlavor> validItemFlavorList = [] // used for validation. Leave empty except in Lobby?
	array<string> ornull favoritePdefKeys = null // for slots that have favorites. ornull to save space
	// The way favoriting works is that the player selects "Random Favorite." A random skin from the favorite list (though it actually seems sequential in practice) is then assigned to the skin slot, but with a negative value to indicate that we're in "favoriting" mode.
	// but it seems like we could just store TheFavorite (sentinel ItemFlavor) and _then_ pick a random skin from the favorites list...

	LoadoutEntry_IsItemFlavorUnlockedFuncType     isItemFlavorUnlocked       = null // optional func ref, default = unlocked | usuaully unused. Needed for badges (which typically do not use GRX)
	array<ItemFlavorLoadoutSlotDidChangeFuncType> changeCallbacks_ItemFlavor = [] // important for notifying UI, etc. But could also attach watchers to the netvars
	table<ItemFlavor, array<LoadoutEntry> >       dependentsByItemFlav       = {} // the ItemFlavor here is "character" (or weapon). Things that have "sub" loadouts. I.e., weapon skin / charm per weapon. should be ornull

	#if SERVER
		LoadoutEntry_SpecialValidationFuncType specialValidationFunc = null // used for Weapon Charms & Badges ONLY. could move to fileLevel by category
	#endif

	// stuff for integer item flavor loadout slots only
	array<IntegerLoadoutSlotDidChangeFuncType> changeCallbacks_Integer = [] // this ONLY updates gladiator card trackers - just check if it's gladitator card category, if yes, call OnGladiatorCardStatTrackerValueChanged should be ornull
	// could just store this at fileLevel.
}

global const int NUM_BADGE_LOADOUT_SLOTS = 3
global const int NUM_TRACKER_LOADOUT_SLOTS = 3

