#if SERVER && DEVELOPER
void function GenerateLoadoutsPDef()
{
	DEV_PDefGen_BeginStruct( "sLoadoutsData", "All loadout fields registered by script-func RegisterLoadoutSlot." )
	array<string> sectionKeyList                            = []
	table<string, array<LoadoutEntry> > sectionEntryListMap = {}
	foreach ( LoadoutEntry entry in fileLevel.loadoutSlotEntries )
	{
		if ( !(entry.pdefSectionKey in sectionEntryListMap) )
		{
			sectionKeyList.append( entry.pdefSectionKey )
			sectionEntryListMap[entry.pdefSectionKey] <- []
		}
		sectionEntryListMap[entry.pdefSectionKey].append( entry )
	}
	foreach ( string sectionKey in sectionKeyList )
	{
		DEV_PDefGen_AddFieldSection( sectionKey )
		foreach ( LoadoutEntry entry in sectionEntryListMap[sectionKey] )
		{
			DEV_PDefGen_AddField_GUID( entry.id )
			for ( int i = 0; i < entry.maxFavoriteCount; i++ )
			{
				Assert( entry.favoritePdefKeys != null )
				array<string> ornull favorites = entry.favoritePdefKeys
				expect array<string>( favorites )
				DEV_PDefGen_AddField_GUID( favorites[ i ] )
			}

			for ( int i = 0; i < entry.backupCount; i++ )
			{
				Assert( entry.backupPdefKeys != null )
				array<string> ornull backups = entry.backupPdefKeys
				expect array<string>( backups )
				DEV_PDefGen_AddField_GUID( backups[ i ] )
			}
		}
	}
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "loadouts" )
	DEV_PDefGen_AddField_Struct( "sLoadoutsData", "loadouts" )
	DEV_PDefGen_EndFieldGroup()
}
#endif


#if SERVER && DEVELOPER
void function OnBotRecordStart( entity player )
{
	fileLevel.botRecord_loadoutValues.resize( fileLevel.loadoutSlotEntries.len() )
	foreach ( int entryIdx, LoadoutEntry entry in fileLevel.loadoutSlotEntries )
	{
		if ( entry.pdefKey != "" )
			fileLevel.botRecord_loadoutValues[entryIdx] = player.GetPersistentVarAsInt( entry.pdefKey )
		else
			fileLevel.botRecord_loadoutValues[entryIdx] = 0
	}
}
#endif


#if SERVER || CLIENT || UI
void function ShLoadouts_OnPlayerEHICreated( EHI player, bool thisCallIsHappeningBecauseTheUIVMReset = false )
{
	EHIScriptStruct ehiss = GetEHIScriptStruct( player )
	#if SERVER || CLIENT
		fileLevel.allowLoadoutSlotOverridesByPlaylist = GetCurrentPlaylistVarBool( "allow_loadout_slot_overrides", false )
	#elseif UI
		fileLevel.allowLoadoutSlotOverridesByPlaylist = false // the server will force this if it needs to be changed
	#endif

#if SERVER
	#if DEVELOPER
		if ( IsLobby() && player.IsBot() )
			return // for ezlaunch

		if ( player.IsPlayback() )
		{
			foreach ( int entryIdx, LoadoutEntry entry in fileLevel.loadoutSlotEntries )
			{
				if ( entryIdx < fileLevel.botRecord_loadoutValues.len() && entry.pdefKey != "" )
					player.SetPersistentVar( entry.pdefKey, fileLevel.botRecord_loadoutValues[entryIdx] )
			}
		}
	#endif

	bool isInitialValidation = true
	if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) )
		thread ValidatePlayerLoadoutThreaded( player, fileLevel.accountLoadoutSlotEntries, isInitialValidation )
	else
		thread ValidatePlayerLoadoutThreaded( player, fileLevel.loadoutSlotEntries, isInitialValidation )
#endif

	#if CLIENT
		ehiss.netVarsLastSeenValuesMap.resize( fileLevel.networkVars.len(), SLOT_CONTENTS_SENTINEL_NOTREADY )
	#elseif UI
		ehiss.loadoutSlotsLastSeenContentsMap.resize( fileLevel.loadoutSlotEntries.len(), SLOT_CONTENTS_SENTINEL_NOTREADY )
	#endif

	#if CLIENT
		if ( thisCallIsHappeningBecauseTheUIVMReset )
		{
			foreach ( LoadoutEntry entry in fileLevel.loadoutSlotEntries )
			{
				if ( !IsLoadoutSlotCurrentlyNetworked( player, entry ) )
					continue

				int slotContentsIndex = GetLoadoutSlotContentsIndexInternal( player, entry )
				RunUIScript( "ClientToUI_RefreshLoadoutSlot", player, entry.entryIndex, slotContentsIndex )
			}
		}
	#endif
}
#endif


#if SERVER
void function ValidatePlayerLoadoutThreaded( entity player, array<LoadoutEntry> loadoutSlots, bool isInitialValidation )
{
	EndSignal( player, "OnDestroy" )

	OnThreadEnd( function() : ( player, isInitialValidation ) {
		if ( !IsValid( player ) )
			return

		if ( isInitialValidation )
		{
			ValidateGRXPlayerLoadoutFirstTimeClean( player )

			if ( IsLobby() )
			{
				Artifacts_Loadouts_ClearComponentChange( player )
				Lobby_OnClientConnectionCompleted( player )
			}
		}
	} )

	if ( IsLobby() ) // IsLobby is mostly for smoke test because of 10X
		WaitFrame() // sometimes this doesn't spin off onto a new frame.

	bool forceReset    = false
	bool resetToRandom = false

	if ( player.IsBot() && !player.IsPlayback() )
	{
		forceReset = true
		resetToRandom = true
	}

	waitthread ValidateAndFixAllLoadoutSlots( ToEHI( player ), loadoutSlots, isInitialValidation, forceReset, resetToRandom )
}
#endif


#if SERVER
void function ValidateGRXPlayerLoadoutFirstTimeClean( entity player )
{
	if ( IsLowCostBot( player ) )
		return

	if ( GetGameState() >= eGameState.Playing )
	{
		if ( !player.IsBot() )
			printt( "LoadoutsDbg: Player loadouts were not validated against their GRX data because it did not arrive in time." )
		return
	}

	if ( GRX_IsInventoryValidated( player ) )
		return

	ValidateGRXPlayerLoadout( player )
}
#endif

#if SERVER
void function ValidateGRXPlayerLoadout( entity player )
{
	EHIScriptStruct ehiss = GetEHIScriptStruct( player )
	if ( !ehiss.isValidated )
		return

	array<LoadoutEntry> entriesToVerifyGRX
	if ( IsLobby() )
	{
		if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) )
			entriesToVerifyGRX = fileLevel.accountLoadoutSlotEntries
		else
			entriesToVerifyGRX = fileLevel.loadoutSlotEntries
	}
	else if ( GetCurrentPlaylistVarBool( "grx_validate_loadouts_in_matches", true ) || GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) == false )
	{
		entriesToVerifyGRX = [ Loadout_Character() ]
	 }

	bool isInitialValidation = false
	thread ValidatePlayerLoadoutThreaded( player, entriesToVerifyGRX, isInitialValidation )

	GRX_SetInventoryValidated( player )
}
#endif

#if SERVER
void function ValidateGRXSpecificLoadoutSlotsForItemFlavors( entity player, array< ItemFlavor > itemsToVerify )
{
	EHIScriptStruct ehiss = GetEHIScriptStruct( player )
	if ( !ehiss.isValidated )
		return

	if ( !IsLobby() )
	{
		Assert( false, "ValidateGRXSpecificLoadoutSlotsForItemFlavors called while player was NOT in the Lobby" )
		return
	}

	array< LoadoutEntry > entriesToCheckForFix
	foreach ( ItemFlavor flav in itemsToVerify )
	{
		foreach ( LoadoutEntry entry in GetAllLoadoutSlots() )
		{
			if ( entry.type != eLoadoutEntryType.ITEM_FLAVOR )
				continue

			if ( IsItemFlavorValidForLoadoutSlot( ToEHI( player ), entry, flav ) )
				entriesToCheckForFix.append( entry )
		}
	}

	bool isInitialValidation = false
	thread ValidatePlayerLoadoutThreaded( player, entriesToCheckForFix, isInitialValidation )
}
#endif

#if CLIENT
void function HandleLoadoutSlotNetworkVarChanged( EHI playerEHI, LoadoutEntry entry, int new )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( !fileLevel.isInitialized )
		return

	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
}
#endif


bool function IsValidLoadoutSlotContentsIndex( LoadoutEntry entry, int slotContentsIndex, int validationBehavior = eValidation.DONT_ASSERT )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR && IsValidItemFlavorGUID( slotContentsIndex ) )
	{
		return true
	}


	if ( entry.type == eLoadoutEntryType.INTEGER )
	{
		int value = slotContentsIndex - SLOT_CONTENTS_INTEGER_OFFSET
		if ( value >= 0 && value <= INT_MAX )
		{
			return true
		}
	}

	Assert( validationBehavior != eValidation.ASSERT, "Invalid loadout slot contents index " + slotContentsIndex + " for " + entry.id )
	return false
}


bool function IsValidLoadoutSlotContentsIndexForItemFlavor( LoadoutEntry entry, int slotContentsIndex )
{

	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID || slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY )
		return false

	return ( IsValidItemFlavorGUID( slotContentsIndex ) )
}


ItemFlavor function ConvertLoadoutSlotContentsIndexToItemFlavor( LoadoutEntry entry, int slotContentsIndex )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	// Defensive check — return default for invalid/missing items
	if ( slotContentsIndex < 0 || slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID || slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY || !IsValidItemFlavorGUID( slotContentsIndex ) )
	{
		// Check validItemFlavorList FIRST — accessing defaultItemFlavor crashes if NULL
		// This happens when no items are registered for a loadout slot (e.g., empty loadscreen list)
		if ( entry.validItemFlavorList.len() > 0 )
			return entry.validItemFlavorList[0]
		// Fallback to defaultItemFlavor only if we know the list had items (meaning default was set)
		// WARNING: If we reach here, defaultItemFlavor is likely NULL and will crash
		printf( "WARNING: Loadout entry '%s' has no valid items - crash imminent\n", entry.id )
		return entry.defaultItemFlavor
	}

	return GetItemFlavorByGUID( slotContentsIndex )
}


int function ConvertItemFlavorToLoadoutSlotContentsIndex( LoadoutEntry entry, ItemFlavor itemFlavor )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )

	Assert( entry.validItemFlavorList.contains( itemFlavor ) )
	return ItemFlavor_GetGUID( itemFlavor )
}


int function GetLoadoutSlotContentsIndexInternal( EHI playerEHI, LoadoutEntry entry, bool ignoreFavoriting = false )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if SERVER
		if ( !EHIHasValidScriptStruct( playerEHI ) )
			return SLOT_CONTENTS_SENTINEL_NOTREADY

		EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )

		if ( !ehiss.isValidated )
		{
			if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) ) // TODO - R5DEV-350895: Loadouts Perf Improvements
			{
				if ( IsLobby() )
					return SLOT_CONTENTS_SENTINEL_NOTREADY
			}
			else // TODO - R5DEV-350895: Loadouts Perf Improvements - Unoptimized Flow
			{
				return SLOT_CONTENTS_SENTINEL_NOTREADY
			}
		}

		return GetLoadoutSlotContentsIndexFromPersistence( playerEHI, entry, eValidation.ASSERT, ignoreFavoriting )
	#elseif CLIENT || UI
		if ( !EHIHasValidScriptStruct( playerEHI ) )
			return SLOT_CONTENTS_SENTINEL_NOTREADY

		int slotContentsIndex

		if ( entry.networkTo == eLoadoutNetworking.PLAYER_GLOBAL && playerEHI != LocalClientEHI() )
		{
			#if CLIENT
				slotContentsIndex = GetLoadoutSlotContentsIndexFromNetworkVar( playerEHI, entry )
			#elseif UI
				slotContentsIndex = GetLoadoutSlotContentsIndexFromCache( playerEHI, entry )
			#endif

			// Guard against NULL defaultItemFlavor — check validItemFlavorList.len() > 0 first
			if ( !IsLobby() && entry.validItemFlavorList.len() > 0 && entry.defaultItemFlavor.guid == DEFAULT_MELEE_WEAPON_SKIN_GUID && IsValidItemFlavorGUID( slotContentsIndex ) && ItemFlavor_GetType( GetItemFlavorByGUID( slotContentsIndex ) ) == Artifacts_Loadouts_GetMeleeSkinNetVarOverrideType( false ) )
		{
			return slotContentsIndex // the fact that another user has an ItemFlavor config pointer isn't useful; but a specific component GUID is during matches; Lobby we need pointer to update to trigger customization UI
		}
		}
		else
		{
			Assert( playerEHI == LocalClientEHI(), "Tried to access a loadout slot of a different client (LoadoutEntry.networkTo on '" + entry.id + "' is not PLAYER_GLOBAL)" )
			slotContentsIndex = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, entry, eValidation.DONT_ASSERT, ignoreFavoriting )
		}

		if ( !IsContentsIndexValidForLoadoutSlot( playerEHI, entry, slotContentsIndex ) )
		{
			#if CLIENT || SERVER
				if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) )
			#elseif UI
				if ( fileLevel.runHighPerfLoadouts ) // the UI might not be connected to a Server because of Loadscreens
			#endif
			{
				if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
				{
					ItemFlavor defaultFlav = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
					return ConvertItemFlavorToLoadoutSlotContentsIndex( entry, defaultFlav )
				}
				else if ( entry.type == eLoadoutEntryType.INTEGER )
				{
					return SLOT_CONTENTS_INTEGER_OFFSET
				}
			}
			else // TODO - R5DEV-350895: Loadouts Perf Improvements - Unoptimized Flow
			{
				return SLOT_CONTENTS_SENTINEL_NOTREADY
			}
		}
		return slotContentsIndex
	#endif
}


#if SERVER || CLIENT || UI
int function GetLoadoutSlotContentsIndexFromPersistence( EHI playerEHI, LoadoutEntry entry, int validationBehavior = eValidation.ASSERT, bool ignoreFavoriting = false )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

#if DEVELOPER
	if ( DEV_ShouldIgnorePersistence() )
	{
		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			ItemFlavor defaultItemFlavor = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
			return ConvertItemFlavorToLoadoutSlotContentsIndex( entry, defaultItemFlavor )
		}
		else if ( entry.type == eLoadoutEntryType.INTEGER )
		{
			return SLOT_CONTENTS_INTEGER_OFFSET
		}
	}
#endif

	// Entries with empty pdefKey have no persistence backing
	if ( entry.pdefKey == "" )
		return SLOT_CONTENTS_SENTINEL_INVALID

	#if SERVER || CLIENT
		entity player         = FromEHI( playerEHI )
		int slotContentsIndex = expect int(player.GetPersistentVar( entry.pdefKey ))
	#elseif UI
		if ( !IsPersistenceAvailable() )
			return SLOT_CONTENTS_SENTINEL_NOTREADY

		Assert( playerEHI == LocalClientEHI() )
		int slotContentsIndex = expect int(GetPersistentVar( entry.pdefKey ))
	#endif


	if ( slotContentsIndex < 0 ) // negative means favorites mode
	{
		if ( ignoreFavoriting )
			return ConvertItemFlavorToLoadoutSlotContentsIndex( entry, entry.favoriteItemFlavor )
		else
			slotContentsIndex *= -1
	}

	if ( slotContentsIndex == PERSISTENT_DATA_INVALID_SENTINEL )
	{
		#if SERVER
			if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) ) // TODO - R5DEV-350895: Loadouts Perf Improvements
			{
				#if LOADOUTS_DBG
					if ( IsLobby() )
						printt( "LoadoutsDbg: persistent loadout slot " + entry.id + " was not initalized - 0-value!" )
				#endif
			}
			else // TODO - R5DEV-350895: Loadouts Perf Improvements - Unoptimized Flow
			{
				Assert( false || validationBehavior != eValidation.ASSERT, "Persistent loadout slot " + entry.id + " was set to invalid value! (" + slotContentsIndex + ")" )
			}
		#endif // #if SERVER
		return SLOT_CONTENTS_SENTINEL_INVALID
	}

	if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
	{
		if ( !IsValidItemFlavorGUID( slotContentsIndex ) )
		{
			#if SERVER
				if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) ) // TODO - R5DEV-350895: Loadouts Perf Improvements
				{
					if ( IsLobby() )
						printt( "LoadoutsDbg: persistent loadout slot " + entry.id + " was set to invalid value! (" + slotContentsIndex + ")" )
				}
				else // TODO - R5DEV-350895: Loadouts Perf Improvements - Unoptimized Flow
				{
					Assert( false || validationBehavior != eValidation.ASSERT, "Persistent loadout slot " + entry.id + " was set to invalid value! (" + slotContentsIndex + ")" )
				}
			#endif // #if SERVER
			return SLOT_CONTENTS_SENTINEL_INVALID
		}

		return slotContentsIndex
	}
	else if ( entry.type == eLoadoutEntryType.INTEGER )
	{
		return slotContentsIndex
	}

	return SLOT_CONTENTS_SENTINEL_INVALID
}
#endif


#if SERVER || CLIENT
int function GetLoadoutSlotContentsIndexFromNetworkVar( EHI playerEHI, LoadoutEntry entry, int validationBehavior = eValidation.ASSERT )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if SERVER
		entity player = FromEHI( playerEHI )
		return player.GetPlayerNetInt( expect string( entry.networkVarName ) )
	#elseif CLIENT
		return GetEHIScriptStruct( playerEHI ).netVarsLastSeenValuesMap[entry.nvIndex]
	#endif
}
#endif


#if UI
int function GetLoadoutSlotContentsIndexFromCache( EHI playerEHI, LoadoutEntry entry, int validationBehavior = eValidation.ASSERT )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	return GetEHIScriptStruct( playerEHI ).loadoutSlotsLastSeenContentsMap[entry.entryIndex]
}
#endif


#if SERVER
int function SetItemFlavorLoadoutSlotFavoritesInternal( EHI playerEHI, LoadoutEntry entry, ItemFlavor itemFlavor, int index )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( index < entry.maxFavoriteCount )

	int itemFlavorPDefInt = ItemFlavor_GetGUID( itemFlavor )

	Assert ( !ItemFlavor_IsTheFavoriteSentinel( itemFlavor ) )

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
		{
			printt( "LoadoutsDbg: loadouts_ignore_persistence is set. Persistent var \"loadouts." + entry.id + "\" will not be saved." )
			return itemFlavorPDefInt
		}
	#endif

	entity player = FromEHI( playerEHI )
	Assert( entry.favoritePdefKeys != null )
	array<string> ornull favorites = entry.favoritePdefKeys
	expect array<string>( favorites )
	player.SetPersistentVar( LOADOUT_PDEF_PREFIX + favorites[ index ], itemFlavorPDefInt )

	ValidateFromFavoritesList( playerEHI, entry )
	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )

	return itemFlavorPDefInt
}

int function SetItemFlavorLoadoutSlotContentsInternal( EHI playerEHI, LoadoutEntry entry, ItemFlavor itemFlavor )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	// returns the new slot contents index
	#if DEVELOPER
		if ( IsLobby() )
		{
			entity player = FromEHI( playerEHI )
			if ( IsValid( player ) && player.p.connectTime + 1.0 < Time() )
			{
				printt( "SetItemFlavorLoadoutSlotContentsInternal " + string(ItemFlavor_GetAsset( itemFlavor )) )
			}
		}
	#endif

	int itemFlavorPDefInt = ItemFlavor_GetGUID( itemFlavor )

	if ( ItemFlavor_IsTheFavoriteSentinel( itemFlavor ) )
	{
		array<ItemFlavor> favorites = clone LoadoutSlot_GetUsableFavorites( playerEHI, entry )
		ItemFlavor fav              = favorites.getrandom()

		if ( favorites.len() > 1 )
		{
			ItemFlavor currentEquipped = LoadoutSlot_GetItemFlavor( playerEHI, entry, false )
			if ( favorites.contains( currentEquipped ) )
			{
				int index    = favorites.find( currentEquipped )
				int newIndex = (index + 1) % favorites.len()

				fav = favorites[ newIndex ]
			}
		}

		itemFlavorPDefInt = ItemFlavor_GetGUID( fav ) * -1
	}

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
		{
			Warning( "loadouts_ignore_persistence is set. Persistent var \"loadouts." + entry.id + "\" will not be saved." )
			return itemFlavorPDefInt
		}
	#endif

	int itemType = ItemFlavor_GetType( itemFlavor )
	if ( itemType == eItemType.melee_skin )
		Loadout_EquipSavedMeleeSkinAndDeathboxPair( playerEHI, entry, itemFlavor )

	if ( IsLobby() && entry != Artifacts_Loadouts_ComponentChangeSlot() )
	{
		if ( itemType == eItemType.artifact_component_power_source || itemType == eItemType.artifact_component_activation_emote )
			Artifacts_Loadouts_AutoEquipActivationEmoteAndPowerSourcePair( playerEHI, entry, itemFlavor )

		if ( itemType == eItemType.artifact_component_blade || itemType == eItemType.artifact_component_power_source )
			Artifacts_Loadouts_RegisterComponentChange( playerEHI, itemFlavor )
	}

	entity player = FromEHI( playerEHI )
	if ( entry.pdefKey != "" )
		player.SetPersistentVar( entry.pdefKey, itemFlavorPDefInt )

	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )

	return itemFlavorPDefInt
}

void function ClearItemFlavorLoadoutSlotFavoritesInternal( EHI playerEHI, LoadoutEntry entry, int index )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	Assert( index < entry.maxFavoriteCount )

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
		{
			Warning( "loadouts_ignore_persistence is set. Persistent var \"loadouts." + entry.id + "\" will not be saved." )
			return
		}
	#endif

	entity player = FromEHI( playerEHI )

	array<int> favs
	for ( int i = 0; i < entry.maxFavoriteCount; i++ )
	{
		Assert( entry.favoritePdefKeys != null )
		array<string> ornull favorites = entry.favoritePdefKeys
		expect array<string>( favorites )
		favs.append( player.GetPersistentVarAsInt( LOADOUT_PDEF_PREFIX + favorites[ i ] ) )
	}

	favs[ index ] = 0

	array<int> collapsedFavs
	for ( int i = 0; i < favs.len(); i++ )
	{
		if ( favs[i] != 0 )
			collapsedFavs.append( favs[i] )
	}

	for ( int i = 0; i < entry.maxFavoriteCount; i++ )
	{
		int guid = 0

		if ( i < collapsedFavs.len() )
		{
			guid = collapsedFavs[i]
		}

		Assert( entry.favoritePdefKeys != null )
		array<string> ornull favorites = entry.favoritePdefKeys
		expect array<string>( favorites )
		player.SetPersistentVar( LOADOUT_PDEF_PREFIX + favorites[ i ], guid )
	}

	ValidateFromFavoritesList( playerEHI, entry )
	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
}

bool function ValidateFromFavoritesList( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	ItemFlavor favoritesTest = LoadoutSlot_GetItemFlavor( playerEHI, entry, true )

	if ( favoritesTest != entry.favoriteItemFlavor )
		return true

	ItemFlavor equipped = LoadoutSlot_GetItemFlavor( playerEHI, entry )

	array<ItemFlavor> favs = LoadoutSlot_GetFavorites( playerEHI, entry )

	if ( favs.contains( equipped ) )
		return true

	SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, favoritesTest )

	return false
}

bool function LoadoutSlot_RefreshFavoritesIfEquipped( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( !IsLobby() )
		return false

	ItemFlavor favoritesTest = LoadoutSlot_GetItemFlavor( playerEHI, entry, true )

	if ( favoritesTest != entry.favoriteItemFlavor )
		return false

	SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, favoritesTest )

	return true
}
#endif


#if SERVER
void function SetIntegerLoadoutSlotContentsInternal( EHI playerEHI, LoadoutEntry entry, int slotContentsIndex )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
		{
			Warning( "loadouts_ignore_persistence is set. Persistent var \"loadouts." + entry.id + "\" will not be saved." )
			return
		}
	#endif

	Assert( slotContentsIndex >= SLOT_CONTENTS_INTEGER_OFFSET )

	int integerPDefInt = slotContentsIndex

	entity player = FromEHI( playerEHI )
	if ( entry.pdefKey != "" )
		player.SetPersistentVar( entry.pdefKey, integerPDefInt )

	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
}
#endif


#if SERVER || CLIENT || UI
void function RefreshLoadoutSlotInternal( EHI playerEHI, LoadoutEntry entry, table<LoadoutEntry, bool> ornull refreshedSlotsSet, array<int> ornull queuedSlotsIndicesForRpc, bool isDependent )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( refreshedSlotsSet != null )
	{
		expect table<LoadoutEntry, bool>(refreshedSlotsSet)
		if ( entry in refreshedSlotsSet )
			return
		refreshedSlotsSet[entry] <- true
	}
	#if CLIENT || UI
		LocalClientEHI() // this will assert that the local player is valid, and also send it to the UI
	#endif

	#if SERVER
		EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )
		if ( !ehiss.isValidated )
			return
	#endif

	int slotContentsIndex = GetLoadoutSlotContentsIndexInternal( playerEHI, entry )

	#if SERVER
		entity player = FromEHI( playerEHI )

		if ( IsLoadoutSlotCurrentlyNetworked( playerEHI, entry ) )
		{
			if ( entry.networkTo == eLoadoutNetworking.PLAYER_GLOBAL )
			{
				#if ASSERTS
					// this is a very costly check that skews DEV RPROF and also is largely redundant
					if ( GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) == false )
					{
						foreach ( LoadoutEntry otherEntry in fileLevel.networkVars[expect string(entry.networkVarName)].usedByEntries )
							Assert( otherEntry == entry || !IsLoadoutSlotCurrentlyNetworked( playerEHI, otherEntry ),
								"Attempted to network two loadout slots using the same network variable name at the same time"
								+ " (var: \"" + expect string(entry.networkVarName) + "\", slot 1: \"" + entry.id + "\", slot 2: \"" + otherEntry.id + "\")." )
					}
				#endif

				Assert( slotContentsIndex != 0 )

				int savedVal = player.GetPlayerNetInt( expect string(entry.networkVarName) )

				// Guard against NULL defaultItemFlavor — check validItemFlavorList.len() > 0 first
				if ( !IsLobby() && entry.validItemFlavorList.len() > 0 && entry.defaultItemFlavor.guid == DEFAULT_MELEE_WEAPON_SKIN_GUID && Artifacts_Loadouts_IsConfigPointerGUID( slotContentsIndex ) )
				{
					int configIdx = Artifacts_Loadouts_GetConfigIndex( GetItemFlavorByGUID( slotContentsIndex ) )
					LoadoutEntry overrideSlot = Artifacts_Loadouts_GetEntryForConfigIndexAndType( configIdx, Artifacts_Loadouts_GetMeleeSkinNetVarOverrideType( true ) )
					int overrideGUID = LoadoutSlot_GetItemFlavor( playerEHI, overrideSlot ).guid
					player.SetPlayerNetInt( expect string(entry.networkVarName), overrideGUID ) // the fact that another user has an ItemFlavor config pointer isn't useful; but a specific component GUID is *during matches*
				}
				else
				{
					player.SetPlayerNetInt( expect string(entry.networkVarName), slotContentsIndex )
				}

				/* this *SEEMS* wrong, but it's actually correct. The reason this hits is because of favoriting. In the event that we actually have changed a "actual" loadout slot
				 * the client already knows that, because it initiated it. But when we set a favorite, we aren't setting an "actual" loadout slot, we're just setting a persistence
				 * var in the favorites array. In that case, the Client doesn't actually know if anything has changed. So, in that case, we need to force an update that will cause
				 * a UI acknowledgement. There's no actual downside (other than a slight performance penalty) to triggering this callback in the case that they are NOT equal,
				 * just as we in the case of player-exclusive slots. So this is perhaps unneeded complexity. But it's really confusing why you'd only trigger a change if the
				 * value were received was equal to the saved value. And there was no explanation. So this is why. It's to trigger a change that's not actual visual to the player,
				 * which is the addition of a skin to the favorites array. But this really could just always get called...
				 */
				if ( savedVal == slotContentsIndex && !isDependent && entry.entryIndex >= 0 )
				{
					if( queuedSlotsIndicesForRpc == null )
						Remote_CallFunction_NonReplay( player, "ServerToClient_LoadoutSlotDidChange", player, entry.entryIndex )
					else
						( expect array<int>( queuedSlotsIndicesForRpc ) ).append( entry.entryIndex )
				}
			}
			else if ( entry.networkTo == eLoadoutNetworking.PLAYER_EXCLUSIVE && !isDependent && entry.entryIndex >= 0 )
			{
				// inform the client that their persistent data changed
				if( queuedSlotsIndicesForRpc == null )
					Remote_CallFunction_NonReplay( player, "ServerToClient_LoadoutSlotDidChange", player, entry.entryIndex )
				else
					( expect array<int>( queuedSlotsIndicesForRpc ) ).append( entry.entryIndex )
			}
		}
	#elseif CLIENT
		entity player = FromEHI( playerEHI )
		if ( entry.entryIndex >= 0 )
			RunUIScript( "ClientToUI_RefreshLoadoutSlot", playerEHI, entry.entryIndex, slotContentsIndex )
	#endif

	if ( slotContentsIndex != SLOT_CONTENTS_SENTINEL_NOTREADY && slotContentsIndex != SLOT_CONTENTS_SENTINEL_INVALID )
	{
		Signal( GetEHISignalDummy( playerEHI ), format( LOADOUT_ID_READY, entry.id ) )
	}

	// Guard against negative indices (e.g., -1 from missing persistence data)
	if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY || slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID || slotContentsIndex < 0 )
	{
		//
	}
	else if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
	{
		ItemFlavor slotContents = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )

		// TODO - R5DEV-356547: this could be made much more performant since this is very generic when it's really only valid for characters. But we limit this by only calling the
		// initial refresh for the active character anyway, so this is not called repeatedly even though it seems like it might be. And was before we limited the set passed in.
		if ( IsLoadoutSlotActive( playerEHI, entry ) )
		{
			CallItemFlavorLoadoutSlotDidChangeCallbacks( playerEHI, entry, slotContents )

			#if SERVER || CLIENT // not required in UI because CLIENT will call ClientToUI_RefreshLoadoutSlot for each dependent anyway
				if ( slotContents in entry.dependentsByItemFlav )
				{
					foreach ( LoadoutEntry dependentEntry in entry.dependentsByItemFlav[slotContents] )
					{
						if ( IsLoadoutSlotActive( playerEHI, dependentEntry, entry ) )
						{
							RefreshLoadoutSlotInternal( playerEHI, dependentEntry, refreshedSlotsSet, null, true )
						}
					}
				}
			#endif
		}
	}
	else if ( entry.type == eLoadoutEntryType.INTEGER )
	{
		int value = (slotContentsIndex - SLOT_CONTENTS_INTEGER_OFFSET)
		if ( IsLoadoutSlotActive( playerEHI, entry ) )
			CallIntegerLoadoutSlotDidChangeCallbacks( playerEHI, entry, value )
	}
}
#endif


#if CLIENT
void function ServerToClient_LoadoutSlotDidChange( entity player, int entryIndex )
{
	EHI playerEHI = player.GetEncodedEHandle()
	Assert( playerEHI == LocalClientEHI() )

	LoadoutEntry entry = fileLevel.loadoutSlotEntries[entryIndex]

	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
}

void function LoadoutSlotDidChangeBatchInternal( EHI playerEHI, int entryIndex )
{
	if( entryIndex < fileLevel.loadoutSlotEntries.len() )
	{
		LoadoutEntry entry = fileLevel.loadoutSlotEntries[entryIndex]
		RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
	}
}

void function ServerToClient_LoadoutSlotDidChangeBatch( entity player,
		int entryIndex1, int entryIndex2, int entryIndex3, int entryIndex4, int entryIndex5, int entryIndex6, int entryIndex7, int entryIndex8,
		int entryIndex9, int entryIndex10, int entryIndex11, int entryIndex12, int entryIndex13, int entryIndex14, int entryIndex15 )
{
	EHI playerEHI = player.GetEncodedEHandle()
	Assert( playerEHI == LocalClientEHI() )

	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex1 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex2 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex3 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex4 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex5 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex6 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex7 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex8 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex9 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex10 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex11 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex12 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex13 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex14 )
	LoadoutSlotDidChangeBatchInternal( playerEHI, entryIndex15 )
}
#endif

#if CLIENT
void function ServerToClient_LoadoutSlotSetFailed()
{
	RunUIScript( "ClientToUI_PlayLootCeremonySound", "menu_deny" )
	return
}
#endif


#if UI
void function ClientToUI_RefreshLoadoutSlot( EHI playerEHI, int entryIndex, int slotContentsIndex )
{
	if ( !fileLevel.isInitialized )
		return // (dw): this can happen if the UI VM hits an error

	LoadoutEntry entry    = fileLevel.loadoutSlotEntries[entryIndex]
	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )
	ehiss.loadoutSlotsLastSeenContentsMap[entryIndex] = slotContentsIndex

	if ( IsLobby() && playerEHI == LocalClientEHI() && IsTopLevelCustomizeContextValid() && entry.type == eLoadoutEntryType.ITEM_FLAVOR )
	{
		Assert( IsValidItemFlavorGUID( slotContentsIndex ) )
		if ( IsValidItemFlavorGUID( slotContentsIndex ) )
		{
			if ( entry.category == eLoadoutCategory.CHARACTER_FAVORED_QUIPS ) // favored quips are explicit slots, not sub-slots like favorites
			{
				ItemFlavor favored = GetItemFlavorByGUID( slotContentsIndex )
				favored.loadoutSortPriority = favored.loadoutSortPriority | eLoadoutSortPriority.FAVORITE
			}
			else
			{
				// since the callback may have been in response to setting a favorite; we need what's actually in the slot ( not the item from the guid ).
				ItemFlavor equipped = LoadoutSlot_GetItemFlavor( playerEHI, entry, true )
				equipped.loadoutSortPriority = equipped.loadoutSortPriority | eLoadoutSortPriority.EQUIPPED

				// when we favorite, the callback hits with the equipped item - guid in persistence - *always*; we then need to derive favorites manually.
				if ( entry.maxFavoriteCount > 0 )
				{
					foreach( favorite in LoadoutSlot_GetFavorites( playerEHI, entry ) )
						favorite.loadoutSortPriority = favorite.loadoutSortPriority | eLoadoutSortPriority.FAVORITE
				}
			}
		}
	}

	RefreshLoadoutSlotInternal( playerEHI, entry, null, null, false )
}


array<ItemFlavor> function TEMP_FilterItemsForGRX( EHI playerEHI, array<ItemFlavor> items )
{
	// UNLOCK ALL COSMETICS - Don't filter out any GRX items
	return items

	/*
	array<ItemFlavor> filteredItems

	foreach ( itemFlavor in items )
	{
		if ( ItemFlavor_GetGRXMode( itemFlavor ) == eItemFlavorGRXMode.REGULAR || ItemFlavor_GetGRXMode( itemFlavor ) == eItemFlavorGRXMode.OWNERSHIP_TARGET )
		{
			if ( !GRX_AreOffersReady() )
				continue

			bool shouldShow = false
			if ( GRX_IsItemCraftable( itemFlavor ) )
				shouldShow = true

			if ( GRX_IsItemOwnedByPlayer( itemFlavor ) )
				shouldShow = true

			array<GRXScriptOffer> offers = GRX_GetItemDedicatedStoreOffers( itemFlavor, "recolor" )
			foreach ( offer in offers )
			{
				ItemFlavor ornull prereqFlav = offer.prereq
				if ( prereqFlav == null )
					continue

				expect ItemFlavor( prereqFlav )

				if ( offer.prices.len() != 1 )
					continue

				ItemFlavorBag price = offer.prices[0]
