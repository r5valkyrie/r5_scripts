}


array<ItemFlavor> function FilterItemsForVisibility( EHI playerEHI, array<ItemFlavor> items )
{
	array<ItemFlavor> filteredItems

	entity player = FromEHI( playerEHI )

	foreach ( item in items )
	{
		if ( ItemFlavor_ShouldBeVisible( item, player ) )
		{
			filteredItems.append( item )
		}
	}

	return filteredItems
}

void function Loadouts_SetSortPriorityForItemFlavor( ItemFlavor item )
{
	int priority = 0

	// these are all mutually exclusive, so the if/else if is for perf
	if ( ItemFlavor_GetSourceIcon( item ) != $"" ) // there are very few "special" (Sentinel/Favorite/Random) items
		priority = priority | eLoadoutSortPriority.HAS_SOURCE_ICON
	else if ( ItemFlavor_IsTheFavoriteSentinel( item ) )
		priority = priority | eLoadoutSortPriority.SENTINEL
	else if ( ItemTypeHasDefault( ItemFlavor_GetType( item ) ) && ItemFlavor_IsTheDefault( item ) )
		priority = priority | eLoadoutSortPriority.DEFAULT
	else if ( ItemTypeHasRandom( ItemFlavor_GetType( item ) ) && ItemFlavor_IsTheRandom( item ) )
		priority = priority | eLoadoutSortPriority.RANDOM

	if ( ItemFlavor_HasQuality( item ) )
	{
		// reactives *always* have quality
		if( ItemFlavor_GetType( item ) == eItemType.weapon_skin && WeaponSkin_DoesReactToKills( item ) )
			priority = priority | eLoadoutSortPriority.WEAPON_REACTIVE

		switch ( ItemFlavor_GetQuality( item ) )
		{
			case eRarityTier.COMMON:
				priority = priority | eLoadoutSortPriority.COMMON
				break

			case eRarityTier.RARE:
				priority = priority | eLoadoutSortPriority.RARE
				break

			case eRarityTier.EPIC:
				priority = priority | eLoadoutSortPriority.EPIC
				break

			case eRarityTier.LEGENDARY:
				priority = priority | eLoadoutSortPriority.LEGENDARY
				break

			case eRarityTier.ICONIC:
				priority = priority | eLoadoutSortPriority.ICONIC // this is how we show Iconic below Mythic even though for gameplay reasons it must be a higher eRarityTier
				break

			case eRarityTier.MYTHIC:
				priority = priority | eLoadoutSortPriority.MYTHIC
				break
		}
	}

	item.loadoutSortPriority = priority
}

array<ItemFlavor> function GetLoadoutItemsSortedForMenu( array<LoadoutEntry> loadoutEntries, int functionref( ItemFlavor ) sortOrdinalFunc, bool functionref( ItemFlavor ) isEmptyFunc = null, array<int> filterTypes = [] )
{
	LoadoutEntry entry = loadoutEntries[0]

	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	EHI playerEHI           = LocalClientEHI()
	array<ItemFlavor> items = clone GetValidItemFlavorsForLoadoutSlot( playerEHI, entry )

	// the ordering of the loops that slim down the items array are ordered for optimal perf. We run the simplest checks first.
	// we try to delay all additional checks - and to avoid as much branched logic as possible since we have no compiler optimizations - as some of the items lists are very large
	// we ultimately want to ensure that whatever is passed to qsort is slimmed down with as many O(N) operations as possible first
	// be mindful of this if you need to insert additional checks or when reordering the below

	// the type filter is really only for "quips" - which encompasses verbal quips and holosprays and standing emotes
	// but that is the largest set in the game, so this check should run first
	if ( filterTypes.len() > 0 )
	{
		foreach ( item in clone items )
		{
			if ( !filterTypes.contains( ItemFlavor_GetType( item ) ) )
				items.fastremovebyvalue( item )
		}
	}

	// this is the next biggest system to chop items; this helps further slim down quips and is the biggest reducer of charms
	if ( GetCurrentPlaylistVarBool( "filter_uncraftable_items", true ) )
		items = TEMP_FilterItemsForGRX( playerEHI, items )

	if ( isEmptyFunc != null )
	{
		foreach ( item in items )
		{
			if ( isEmptyFunc( item ) )
			{
				items.fastremovebyvalue( item )
				break // there's only one empty for any given set, which is also why we don't need to clone
			}
		}
	}

	// checks for Playlist disabling, which is unlikely but possible, and also GRX edition, which is deprecated/unused
	items = FilterItemsForVisibility( playerEHI, items )

	foreach ( item in items ) // reset equipped and favorites so they bubble to the top after changing menus
	{
		item.loadoutSortPriority = item.loadoutSortPriority & ~eLoadoutSortPriority.EQUIPPED
		item.loadoutSortPriority = item.loadoutSortPriority & ~eLoadoutSortPriority.FAVORITE
	}

	array<ItemFlavor> favs
	if ( loadoutEntries.len() == 1 )
		favs = LoadoutSlot_GetFavorites( LocalClientEHI(), entry )
	else if ( loadoutEntries.len() > 1 && Loadout_IsCharacterQuipLoadoutEntry( entry) )
		favs = ItemFlavor_GetFavoredQuipArrayForCharacter( GetTopLevelCustomizeContext() )

	foreach ( item in favs )
		item.loadoutSortPriority = item.loadoutSortPriority | eLoadoutSortPriority.FAVORITE

	array<ItemFlavor> equippedItems
	foreach ( loadoutEntry in loadoutEntries )
	{
		if ( LoadoutSlot_IsReady( playerEHI, loadoutEntry ) )
			equippedItems.append( LoadoutSlot_GetItemFlavor( playerEHI, loadoutEntry, true ) )
	}

	foreach ( item in equippedItems )
		item.loadoutSortPriority = item.loadoutSortPriority | eLoadoutSortPriority.EQUIPPED

	items.sort( int function( ItemFlavor a, ItemFlavor b ) : ( sortOrdinalFunc ) {
		if ( a.loadoutSortPriority > b.loadoutSortPriority )
			return -1
		else if ( a.loadoutSortPriority < b.loadoutSortPriority )
			return 1

		if ( IsBitFlagSet( a.loadoutSortPriority, eLoadoutSortPriority.HAS_SOURCE_ICON ) && IsBitFlagSet( b.loadoutSortPriority, eLoadoutSortPriority.HAS_SOURCE_ICON ) )
		{
			string aTag = string(ItemFlavor_GetSourceIcon( a ))
			string bTag = string(ItemFlavor_GetSourceIcon( b ))
			if ( aTag > bTag )
				return -1
			else if ( aTag < bTag )
				return 1
		}

		if ( ItemTypeAlphabetizable( ItemFlavor_GetType( a ) ) ) // avoid alphabetizing if possible; it's slow
			return SortStringAlphabetize( Localize( ItemFlavor_GetLongName( a ) ), Localize( ItemFlavor_GetLongName( b ) ) )

		if ( sortOrdinalFunc != null )
			return sortOrdinalFunc( a ) - sortOrdinalFunc( b )

		return 0
	} )

	return items
}
#endif // UI

// TODO - R5DEV-356547: this is called repeatedly - often within the same function, especially for dependencies. Cache dependent character rather than repeatedly checking
// basically, it's a tree that goes up from every node rather than top-down. the key to realtime loadout validation is to only worry about the current active character.
bool function IsLoadoutSlotActive( EHI playerEHI, LoadoutEntry entry, LoadoutEntry ornull entryToNotCheck = null )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if CLIENT || UI
		if ( playerEHI != LocalClientEHI() && entry.networkTo != eLoadoutNetworking.PLAYER_GLOBAL )
			return false
	#endif

	#if LOADOUTS_DBG
		string func = expect string( expect table( getstackinfos( 1 ) ).func )
		string func2 = expect string( expect table( getstackinfos( 2 ) ).func )
		if ( func == "IsLoadoutSlotActive" )
			printt("LoadoutsDebug: " + func2 + " checking dependency IsLoadoutSlotActive for " + entry.DEV_name )
		else
			printt("LoadoutsDebug: func " + func + "is checking loadout slot " + entry.DEV_name)
	#endif

	// this is really just a very complex way of asking "is the character this slot is for the current character"
	if ( entry.associatedCharacterOrNull != null )
	{
		ItemFlavor currentCharacter = LoadoutSlot_GetItemFlavor( playerEHI, Loadout_Character() )
		ItemFlavor ornull associatedCharacter = entry.associatedCharacterOrNull
		expect ItemFlavor ( associatedCharacter )
		if ( currentCharacter != associatedCharacter )
			return false
	}

	return true
}

// TODO - R5DEV-356547: there is a ton of recursion between is-networked and is-active...
bool function IsLoadoutSlotCurrentlyNetworked( EHI playerEHI, LoadoutEntry entry, LoadoutEntry ornull entryToNotCheck = null )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if CLIENT || UI
		if ( playerEHI != LocalClientEHI() && entry.networkTo != eLoadoutNetworking.PLAYER_GLOBAL )
			return false
	#endif

	return IsLoadoutSlotActive( playerEHI, entry, entryToNotCheck )
}


bool function IsLoadoutSlotCurrentlyAccessible( EHI playerEHI, LoadoutEntry entry, LoadoutEntry ornull entryToNotCheck = null )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	#if SERVER
		return true
	#elseif CLIENT || UI
		if ( playerEHI == LocalClientEHI() )
		{
			return true
		}

		if ( entry.networkTo != eLoadoutNetworking.PLAYER_GLOBAL )
		{
			return false
		}

		return IsLoadoutSlotActive( playerEHI, entry, entryToNotCheck )
	#endif
}


void function CallItemFlavorLoadoutSlotDidChangeCallbacks( EHI playerEHI, LoadoutEntry entry, ItemFlavor slotContents )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	foreach ( ItemFlavorLoadoutSlotDidChangeFuncType callback in entry.changeCallbacks_ItemFlavor )
		callback( playerEHI, slotContents )

	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )
	if ( entry.entryIndex in ehiss.itemFlavorLoadoutSlotChangedCallbacksMap )
	{
		foreach ( ItemFlavorLoadoutSlotDidChangeFuncType callback in ehiss.itemFlavorLoadoutSlotChangedCallbacksMap[entry.entryIndex] )
			callback( playerEHI, slotContents )
	}
}


void function CallIntegerLoadoutSlotDidChangeCallbacks( EHI playerEHI, LoadoutEntry entry, int value )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	foreach ( IntegerLoadoutSlotDidChangeFuncType callback in entry.changeCallbacks_Integer )
		callback( playerEHI, value )
}


ItemFlavor function GetDefaultItemFlavorForLoadoutSlot( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	// Check validItemFlavorList first - defaultItemFlavor may be NULL reference
	if ( entry.validItemFlavorList.len() > 0 )
		return entry.validItemFlavorList[0]
	return entry.defaultItemFlavor
}


#if SERVER || CLIENT || UI
bool function IsContentsIndexValidForLoadoutSlot( EHI playerEHI, LoadoutEntry entry, int slotContentsIndex, int validationBehavior = eValidation.DONT_ASSERT )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_INVALID )
	{
		Assert( false || validationBehavior != eValidation.ASSERT, "Tried to assign invalid value to loadout slot." )
		return false
	}
	else if ( slotContentsIndex == SLOT_CONTENTS_SENTINEL_NOTREADY )
	{
		Assert( false || validationBehavior != eValidation.ASSERT, "Tried to assign invalid value to loadout slot." )
		return false
	}
	else
	{
		if ( !IsValidLoadoutSlotContentsIndex( entry, slotContentsIndex, validationBehavior ) )
		{
			// func asserts for us
			return false
		}

		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			ItemFlavor itemFlavor = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
			if ( !IsItemFlavorValidForLoadoutSlot( playerEHI, entry, itemFlavor ) )
			{
				Assert( false || validationBehavior != eValidation.ASSERT, "Tried to assign invalid item value to loadout slot." )
				return false
			}
			return true
		}
		else if ( entry.type == eLoadoutEntryType.INTEGER )
		{
			return true
		}
	}

	Assert( false || validationBehavior != eValidation.ASSERT, "Value is invalid for loadout slot." )
	return false
}
#endif


#if SERVER
void function ValidateAndFixAllLoadoutSlots( EHI playerEHI, array<LoadoutEntry> loadoutSlots, bool isInitialValidation, bool forceReset, bool resetToRandom )
{
	EndSignal( FromEHI( playerEHI ), "OnDestroy" )
	EndSignal( FromEHI( playerEHI ), "OnDisconnecting" )

	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )
	ehiss.isValidated = false

	bool runHighPerfLoadouts = GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true )

	array<LoadoutEntry> fixedList = [] // only used iff isInitialValidation == false
	if ( IsLobby() == false && isInitialValidation == false && GetCurrentPlaylistVarBool( "grx_validate_loadouts_in_matches", true ) == false )
	{
		ehiss.isValidated = true
		return // only run double validation in the Lobby
	}

	foreach ( LoadoutEntry entry in loadoutSlots )
	{
		bool entryWasFixed = ValidateAndFixLoadoutSlot( playerEHI, entry, isInitialValidation, forceReset, resetToRandom )
		if ( !isInitialValidation && entryWasFixed )
			fixedList.append( entry )
	}

	if ( FromEHI( playerEHI ).IsBot() )
	{
		ApplyBotLoadout( playerEHI, loadoutSlots )
	}

	if ( runHighPerfLoadouts )
	{
		LoadoutEntry character = Loadout_Character()
		int characterSlotIndex = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, character )
		ItemFlavor characterFlav = ConvertLoadoutSlotContentsIndexToItemFlavor( character, characterSlotIndex )
		ValidateCharacterLoadoutDependents( playerEHI, characterFlav )
		fixedList.append( character ) // this ensures that we refresh the character loadout slot on secondary validation, because we MIGHT have fixed data during GRX validation
	}

	ehiss.isValidated = true

	if ( IsLobby() ) // this is really to get around the smoketest because of its 10X timescale
		wait 0.1

	ehiss.HACK_wasJustValidated = true // used to prevent triggering banner-was-updated logic in sh_stats
	table<LoadoutEntry, bool> refreshedSlotsSet = {}
	array<int> queuedSlotsIndicesForRpc
	foreach ( LoadoutEntry entry in (isInitialValidation ? loadoutSlots : fixedList) )
	{
		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			if ( LoadoutSlot_RefreshFavoritesIfEquipped( playerEHI, entry ) )
			{
				continue // LoadoutSlot_RefreshFavoritesIfEquipped already calls RefreshLoadoutSlotInternal if true
			}
		}
		// note that when we refresh the character slot, we *also* refresh every dependent
		RefreshLoadoutSlotInternal( playerEHI, entry, refreshedSlotsSet, queuedSlotsIndicesForRpc, false )
	}

	// Batch RPC has too many params for Remote system, use individual calls instead
	entity player = FromEHI( playerEHI )
	foreach ( int slotIndex in queuedSlotsIndicesForRpc )
	{
		Remote_CallFunction_NonReplay( player, "ServerToClient_LoadoutSlotDidChange", player, slotIndex )
	}

	// force a *potential* refresh of the Character Skin *only* (all other Favorites are handled at the Account level)
	if ( runHighPerfLoadouts && isInitialValidation )
	{
		LoadoutEntry character   = Loadout_Character()
		int characterSlotIndex   = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, character )
		ItemFlavor characterFlav = ConvertLoadoutSlotContentsIndexToItemFlavor( character, characterSlotIndex )
		LoadoutSlot_RefreshFavoritesIfEquipped( playerEHI, Loadout_CharacterSkin( characterFlav ) )
	}
	ehiss.HACK_wasJustValidated = false
}
#endif

#if SERVER
void function ValidateCharacterLoadoutDependents( EHI playerEHI, ItemFlavor character )
{
	array<LoadoutEntry> fixedList = []

	EHIScriptStruct ehiss = GetEHIScriptStruct( playerEHI )
	bool isInitialValidation = !(ehiss.isValidated)

	bool forceReset = false
	bool resetToRandom = false

	entity player = FromEHI( playerEHI )
	bool playerIsBot = player.IsBot()

	if ( playerIsBot && !player.IsPlayback() )
	{
		forceReset = true
		resetToRandom = true
	}

	// if this callback is hit *after* initial validation, fixing a slot will refresh it; refresh is also triggered when loadout data changes.
	LoadoutEntry characterEntry = Loadout_Character()
	if ( !(character in characterEntry.dependentsByItemFlav) )
		return
	foreach ( LoadoutEntry dependentEntry in characterEntry.dependentsByItemFlav[character] )
	{
		if ( dependentEntry.category == eLoadoutCategory.CHARACTER_MELEESKINS )
		{
			bool shouldReset = Artifacts_Loadouts_CheckAndFixMisconfigurations( playerEHI, character )
			if ( !IsLobby() )
				forceReset = forceReset || shouldReset
		}

		bool entryWasFixed = ValidateAndFixLoadoutSlot( playerEHI, dependentEntry, isInitialValidation, forceReset, resetToRandom )
		#if LOADOUTS_DBG
			printt("LoadoutsDebug: " + dependentEntry.DEV_name )
		#endif
	}

	if ( playerIsBot )
	{
		ApplyBotLoadout( playerEHI, characterEntry.dependentsByItemFlav[character] )
	}
}
#endif


#if SERVER
bool function ValidateAndFixLoadoutSlot( EHI playerEHI, LoadoutEntry entry, bool isInitialValidation, bool forceReset, bool resetToRandom )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	bool wasFixed = false

	entity player = FromEHI( playerEHI )

	int slotContentsIndex = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, entry, eValidation.DONT_ASSERT )

	array<string> ornull forceResetTo = GetLoadoutSlotForceResetTo( entry )

	bool shouldReset = forceReset || (forceResetTo != null)

	if ( !IsContentsIndexValidForLoadoutSlot( playerEHI, entry, slotContentsIndex ) )
	{
		if ( !shouldReset && GetCurrentPlaylistVarBool( "loadouts_performance_ops_v1", true ) == false )
			printt( "LoadoutsDbg: detected invalid persistent loadout slot contents (%s, %s)", string(player), DEV_DescribeLoadoutSlot( entry, slotContentsIndex ) )

		shouldReset = true
	}
	else if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
	{
		ItemFlavor itemFlavor = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )

		// note that from a practical standpoint, there really is no substantive difference between IsItemFlavorUnlocked and IsItemFlavorGRXUnlocked. One is typically just a wrapper around the other...
		// but the call to IsItemFlavorUnlockedForLoadoutSlot checks to see things about playlist and other stuff...
		if ( isInitialValidation )
		{
			if ( !IsItemFlavorUnlockedForLoadoutSlot( playerEHI, entry, itemFlavor, isInitialValidation ) )
			{
				if ( !shouldReset )
					printt( "LoadoutsDbg: detected locked persistent loadout slot contents (%s, %s)", string(player), DEV_DescribeLoadoutSlot( entry, slotContentsIndex ) )

				shouldReset = true
			}
		}
		else
		{
			// NOTE: this calls to the special unlock func if defined for the flav -- it's just not super clear on first reading.
			// TODO: review/clean up for 18.1 -- evaluate how we want this flow to look/work -- https://jiratf.rspn.ad.ea.com/browse/R5DEV-496755
			if ( !IsItemFlavorGRXUnlockedForLoadoutSlot( playerEHI, itemFlavor ) )
			{
				if ( !shouldReset )
					printt( "LoadoutsDbg: detected locked persistent loadout slot contents (%s, %s)", string(player), DEV_DescribeLoadoutSlot( entry, slotContentsIndex ) )

				shouldReset = true
			}
		}
	}

	if ( shouldReset )
	{
		array<ItemFlavor> exceptions = []
		if ( entry == Loadout_Character() )
		{
			if ( IsValidItemFlavorSettingsAsset( CHARACTER_RANDOM ) )
				exceptions.append( GetItemFlavorByAsset( CHARACTER_RANDOM ) )
			if ( IsValidItemFlavorSettingsAsset( CHARACTER_DUMMIE ) )
				exceptions.append( GetItemFlavorByAsset( CHARACTER_DUMMIE ) )
		}

		if ( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			ItemFlavor itemFlavor
			if ( forceResetTo != null )
			{
				array<ItemFlavor> items = []
				foreach ( string itemRef in expect array<string>(forceResetTo) )
				{
					if ( itemRef == "~default~" )
						items.append( GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry ) )
					else if ( itemRef == "~random~" )
						items.append( GetRandomGoodItemFlavorForLoadoutSlot( playerEHI, entry, !isInitialValidation, exceptions ) )
					else if ( !IsValidItemFlavorGUID( ConvertItemFlavorGUIDStringToGUID( itemRef ) ) )
					{
						continue
					}
					else
					{
						ItemFlavor itemFlav = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( itemRef ) )
						Assert( entry.validItemFlavorList.contains( itemFlav ) )
						items.append( itemFlav )
					}
				}
				itemFlavor = items.getrandom()
			}
#if DEVELOPER
			else if ( entry == Loadout_Character() && player.IsBot() && player.GetPlayerSettings() != SPECTATOR_SETTINGS )
			{
				//If it's a bot that was spawned with a specific class, let's try sticking to that class
				asset botClassSettings = player.GetPlayerSettings()

				array< ItemFlavor > characterItemFlavors = GetValidItemFlavorsForLoadoutSlot( player, entry )

				bool foundItemFlavor = false

				//Let's find the ItemFlavor that refers to this class setting
				foreach ( ItemFlavor characterItemFlavor in characterItemFlavors )
				{
					if ( CharacterClass_GetSetFile( characterItemFlavor ) == botClassSettings )
					{
						itemFlavor = characterItemFlavor
						foundItemFlavor = true
						break
					}
				}

				if ( !foundItemFlavor )
					itemFlavor = GetRandomGoodItemFlavorForLoadoutSlot( playerEHI, entry, !isInitialValidation, exceptions )
			}
			else if ( resetToRandom )
			{
				if ( !Dev_CommandLineHasParm( "-smoketest" ) )
				    itemFlavor = GetRandomGoodItemFlavorForLoadoutSlot( playerEHI, entry, !isInitialValidation, exceptions )
                else
                    itemFlavor = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
			}
#endif
			else
			{
				if ( entry == Loadout_Character() )
				{
					ItemFlavor ornull randomChar = CharacterClass_GetRandomNonGRXCharacter()
					if ( randomChar != null )
						itemFlavor = expect ItemFlavor(randomChar)
					else
						itemFlavor = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
				}
				else
					itemFlavor = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
			}

			SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, itemFlavor )
			slotContentsIndex = ConvertItemFlavorToLoadoutSlotContentsIndex( entry, itemFlavor )
			wasFixed = true
		}
		else if ( entry.type == eLoadoutEntryType.INTEGER )
		{
			int newSlotContentsIndex
			if ( forceResetTo != null )
			{
				array<int> choices = []
				foreach ( string choiceRef in expect array<string>(forceResetTo) )
					choices.append( int(choiceRef) )
				newSlotContentsIndex = choices.getrandom()
			}
#if DEVELOPER
			else if ( resetToRandom )
			{
				int value = RandomIntRangeInclusive( 0, INT_MAX )
				newSlotContentsIndex = SLOT_CONTENTS_INTEGER_OFFSET + value
			}
#endif
			else
			{
				newSlotContentsIndex = SLOT_CONTENTS_INTEGER_OFFSET
			}

			slotContentsIndex = newSlotContentsIndex
			SetIntegerLoadoutSlotContentsInternal( playerEHI, entry, newSlotContentsIndex )
			wasFixed = true
		}
	}

	if ( entry.specialValidationFunc != null )
	{
		Assert( entry.type == eLoadoutEntryType.ITEM_FLAVOR )
		ItemFlavor currFlav                = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
		ItemFlavor specialValidationResult = entry.specialValidationFunc( playerEHI, currFlav, isInitialValidation )
		if ( specialValidationResult != currFlav )
		{
			SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, specialValidationResult )
			wasFixed = true
		}
	}

	return wasFixed
}
#endif

#if SERVER
void function ApplyBotLoadout( EHI playerEHI, array<LoadoutEntry> loadoutSlots )
{
	if ( !GetConVarBool( "bot_use_loadout_datatables" ) )
	{
		return
	}

	entity player = FromEHI( playerEHI )
	Assert( IsValid( player ) && player.IsBot(), "Attempting to ApplyBotLoadout on Non-Bot Player" )

	LoadoutEntry characterEntry = Loadout_Character()
	int characterSlotIndex = GetLoadoutSlotContentsIndexFromPersistence( playerEHI, characterEntry )
	ItemFlavor character = ConvertLoadoutSlotContentsIndexToItemFlavor( characterEntry, characterSlotIndex )
	asset characterAsset = ItemFlavor_GetAsset( character )
	if ( !fileLevel.botLoadoutInfo.validCharacterAssetsForLoadout.contains( characterAsset ) )
	{
		return
	}

	BotLoadoutInfoBadge[NUM_BADGE_LOADOUT_SLOTS] botLoadoutBadges
	BotLoadoutInfoStatTracker[NUM_TRACKER_LOADOUT_SLOTS] botLoadoutTrackers

	int assignedBadgesCount = 0
	array<BotLoadoutInfoBadge> requiredBadges = clone( fileLevel.botLoadoutInfo.requiredBadges )
	while ( (assignedBadgesCount < NUM_BADGE_LOADOUT_SLOTS) && (requiredBadges.len() > 0) )
	{
		BotLoadoutInfoBadge randomBadgeInfo = requiredBadges.getrandom()
		botLoadoutBadges[assignedBadgesCount].badgeAssetPathTemplate = randomBadgeInfo.badgeAssetPathTemplate
		botLoadoutBadges[assignedBadgesCount].minBadgeValue = randomBadgeInfo.minBadgeValue
		botLoadoutBadges[assignedBadgesCount].maxBadgeValue = randomBadgeInfo.maxBadgeValue
		requiredBadges.fastremovebyvalue( randomBadgeInfo )
		++assignedBadgesCount
	}

	array<BotLoadoutInfoBadge> optionalBadges = clone( fileLevel.botLoadoutInfo.optionalBadges )
	while ( (assignedBadgesCount < NUM_BADGE_LOADOUT_SLOTS) && (optionalBadges.len() > 0) )
	{
		BotLoadoutInfoBadge randomBadgeInfo = optionalBadges.getrandom()
		botLoadoutBadges[assignedBadgesCount].badgeAssetPathTemplate = randomBadgeInfo.badgeAssetPathTemplate
		botLoadoutBadges[assignedBadgesCount].minBadgeValue = randomBadgeInfo.minBadgeValue
		botLoadoutBadges[assignedBadgesCount].maxBadgeValue = randomBadgeInfo.maxBadgeValue
		optionalBadges.fastremovebyvalue( randomBadgeInfo )
		++assignedBadgesCount
	}

	int assignedTrackersCount = 0
	array<BotLoadoutInfoStatTracker> optionalTrackers = clone( fileLevel.botLoadoutInfo.optionalTrackers )
	while ( (assignedTrackersCount < NUM_TRACKER_LOADOUT_SLOTS) && (optionalTrackers.len() > 0) )
	{
		BotLoadoutInfoStatTracker randomStatTrackerInfo = optionalTrackers.getrandom()
		botLoadoutTrackers[assignedTrackersCount].statTrackerAssetPathTemplate = randomStatTrackerInfo.statTrackerAssetPathTemplate
		botLoadoutTrackers[assignedTrackersCount].minStatValue = randomStatTrackerInfo.minStatValue
		botLoadoutTrackers[assignedTrackersCount].maxStatValue = randomStatTrackerInfo.maxStatValue
		optionalTrackers.fastremovebyvalue( randomStatTrackerInfo )
		++assignedTrackersCount
	}

	string characterName = ItemFlavor_GetCharacterRef( character )
	characterName = characterName.slice( 10 )			// characterName is of the form character_gibraltar, we slice the first 10 characters in order to remove the character_ prefix from it

	assignedTrackersCount = minint( assignedTrackersCount, RandomIntRangeInclusive(1, NUM_TRACKER_LOADOUT_SLOTS) )
	int appliedTrackersCount = 0
	int appliedTrackerValuesCount = 0
	assignedBadgesCount = minint( assignedBadgesCount, RandomIntRangeInclusive(1, NUM_BADGE_LOADOUT_SLOTS) )
	int appliedBadgesCount = 0
	int appliedBadgesTierCount = 0
	foreach ( LoadoutEntry loadoutEntry in loadoutSlots )
	{
		if ( loadoutEntry.type == eLoadoutEntryType.ITEM_FLAVOR )
		{
			ItemFlavor itemFlavor
			bool applySlotContents = false

			if ( loadoutEntry.category == eLoadoutCategory.GCARD_TRACKERS )
			{
				if ( appliedTrackersCount < assignedTrackersCount )
				{
					string statTrackerAssetPath = replace( botLoadoutTrackers[appliedTrackersCount].statTrackerAssetPathTemplate, "%char%", characterName )
					Assert( statTrackerAssetPath != "", "Invalid asset path for Stat Tracker in Bot Loadout Info" )

					asset statTrackerAsset = GetAssetFromString( statTrackerAssetPath )
					itemFlavor = GetItemFlavorByAsset( statTrackerAsset )
				}
				else
				{
					itemFlavor = loadoutEntry.defaultItemFlavor
				}

				applySlotContents = true
				++appliedTrackersCount
			}
			else if ( loadoutEntry.category == eLoadoutCategory.GCARD_BADGES )
			{
				if ( appliedBadgesCount < assignedBadgesCount )
				{
					string badgeAssetPath = replace( botLoadoutBadges[appliedBadgesCount].badgeAssetPathTemplate, "%char%", characterName )
					Assert( badgeAssetPath != "", "Invalid asset path for Badge in Bot Loadout Info" )

					asset badgeAsset = GetAssetFromString( badgeAssetPath )
					itemFlavor = GetItemFlavorByAsset( badgeAsset )
				}
				else
				{
					itemFlavor = loadoutEntry.defaultItemFlavor
				}

				applySlotContents = true
				++appliedBadgesCount
			}
			else if ( fileLevel.botLoadoutInfo.genericAssets[loadoutEntry.category].len() > 0 )
			{
				// if the GenericAssets array is not empty for this loadout category, then we can randomly apply one to the bot
				BotLoadoutGenericAssetInfo assetInfo = fileLevel.botLoadoutInfo.genericAssets[loadoutEntry.category].getrandom()

				int assetVariation = RandomIntRangeInclusive( assetInfo.minVariationValue, assetInfo.maxVariationValue )
				string assetVariationString = assetVariation < 10 ? "0" + assetVariation : string( assetVariation )
				string assetPath = replace( assetInfo.assetPathTemplate, "%char%", characterName )
				assetPath = replace( assetPath, "%variation%", assetVariationString )

				asset retrievedAsset = GetAssetFromString( assetPath )
				itemFlavor = GetItemFlavorByAsset( retrievedAsset )

				applySlotContents = true
			}

			if ( applySlotContents )
			{
				Assert( IsItemFlavorStructValid( itemFlavor.guid, eValidation.ASSERT ) )
				SetItemFlavorLoadoutSlotContentsInternal( playerEHI, loadoutEntry, itemFlavor )
			}
		}
		else if ( loadoutEntry.type == eLoadoutEntryType.INTEGER )
		{
			int slotContentsInt = SLOT_CONTENTS_INTEGER_OFFSET
			bool applySlotContents = false

			if( loadoutEntry.category == eLoadoutCategory.GCARD_TRACKER_TIER )
			{
				if ( appliedTrackerValuesCount < assignedTrackersCount )
				{
					int statTrackerValue = RandomIntRangeInclusive( botLoadoutTrackers[appliedTrackerValuesCount].minStatValue, botLoadoutTrackers[appliedTrackerValuesCount].maxStatValue )
					slotContentsInt += statTrackerValue
					applySlotContents = true
					++appliedTrackerValuesCount
				}
			}
			else if ( loadoutEntry.category == eLoadoutCategory.GCARD_BADGE_TIER )
			{
				if( appliedBadgesTierCount < assignedBadgesCount )
				{
					int badgeTier = RandomIntRangeInclusive( botLoadoutBadges[appliedBadgesTierCount].minBadgeValue, botLoadoutBadges[appliedBadgesTierCount].maxBadgeValue )
					slotContentsInt += badgeTier
					applySlotContents = true
					++appliedBadgesTierCount
				}
			}

			if ( applySlotContents )
			{
				SetIntegerLoadoutSlotContentsInternal( playerEHI, loadoutEntry, slotContentsInt )
			}
		}
	}
}
#endif

#if SERVER || CLIENT || UI
array<string> ornull function GetLoadoutSlotForceResetTo( LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( fileLevel.allowLoadoutSlotOverridesByPlaylist == false )
		return null

	//loadout_slot_weapon_skin_for_SAID00048783537_force_reset_to "SAID01234567890" // SAID for ItemFlavor of reset-to
	string playlistVarVal = GetCurrentPlaylistVarString( format( "loadout_slot_%s_force_reset_to", entry.id ), "" )

	if ( playlistVarVal == "" )
		playlistVarVal = GetCurrentPlaylistVarString( format( "loadout_slot_%s_force_reset_to", LOADOUT_CATEGORIES_TO_NAMES_MAP[entry.category] ), "" ) // let more specific var take priority

	array<string> refs = split( playlistVarVal, WHITESPACE_CHARACTERS )
	if ( refs.len() == 0 )
		return null

	printf( "LoadoutsDbg: loadout slot '%s' is being force reset to one of '%s'.", entry.id, playlistVarVal )
	return refs
}
#endif


bool function IsLoadoutSlotLocked( EHI playerEHI, LoadoutEntry entry )
{
	#if LOADOUTS_DBG
		DEV_LoadoutsDebug( entry )
	#endif

	if ( entry.isSlotLocked == null )
		return false

	#if DEVELOPER
		if ( GetCurrentPlaylistVarBool( "dev_loadout_changeable_at_any_time", false ) )
			return false
	#endif

	// R5DEV-391261 hack, this explicit behavior has to go in hand with the explicit playlist vars below.
	// We should properly handle each loadout slot for each scenario in their callbacks.
	if ( !entry.isAllowedToChangeDuringMatch )
	{
		                      
		if ( GetCurrentPlaylistVarBool( "winter_express_loadout_changeable_at_anytime", false ) )
			return false
        

		                        
		if ( GetCurrentPlaylistVarBool( "control_loadout_changeable_at_anytime", false ) )
			return false
        

		                       
		if ( GetCurrentPlaylistVarBool( "freedm_loadout_changeable_at_anytime", false ) )
			return false
        
	}

	return entry.isSlotLocked( playerEHI )
}


#if SERVER
void function ClientCallback_favorites_clear( entity player, int favIndex, int entryIndex )
{
	EHI playerEHI = ToEHI( player )

	if ( !(entryIndex >= 0 && entryIndex < fileLevel.loadoutSlotEntries.len()) )
	{
		Assert( false, "'favorites_set' had invalid entry index (got " + entryIndex + ", valid range 0-" + (fileLevel.loadoutSlotEntries.len() - 1) + ")." )
		return
	}
	LoadoutEntry entry = fileLevel.loadoutSlotEntries[entryIndex]

	// returns the new slot contents index
	if ( entry.maxFavoriteCount <= favIndex )
		return

	ClearItemFlavorLoadoutSlotFavoritesInternal( playerEHI, entry, favIndex )
}

void function ClientCallback_favorites_set( entity player, int favIndex, int entryIndex, int slotContentsIndex )
{
	EHI playerEHI = ToEHI( player )

	if ( !(entryIndex >= 0 && entryIndex < fileLevel.loadoutSlotEntries.len()) )
	{
		Assert( false, "'favorites_set' had invalid entry index (got " + entryIndex + ", valid range 0-" + (fileLevel.loadoutSlotEntries.len() - 1) + ")." )
		return
	}
	LoadoutEntry entry = fileLevel.loadoutSlotEntries[entryIndex]

	if ( IsLoadoutSlotLocked( playerEHI, entry ) )
	{
		Assert( false, "Attempted to use 'favorites_set' on locked loadout slot \"" + entry.id + "\")." )
		return
	}

	if ( !IsContentsIndexValidForLoadoutSlot( playerEHI, entry, slotContentsIndex, eValidation.ASSERT ) )
	{
		// func asserts for us in dev
		return
	}

	ItemFlavor itemFlavor = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
	if ( !IsItemFlavorUnlockedForLoadoutSlot( playerEHI, entry, itemFlavor ) )
	{
		// This could happen if two people try to select the same character at the same time
		printt( "LoadoutsDbg: 'favorites_set' received item flavor \"" + DEV_DescItemFlavor( itemFlavor ) + "\" which is locked for this player (loadout slot \"" + entry.id + "\")." )
		return
	}

	// returns the new slot contents index
	if ( entry.maxFavoriteCount <= favIndex )
		return

	SetItemFlavorLoadoutSlotFavoritesInternal( playerEHI, entry, itemFlavor, favIndex )

	return
}

void function ClientCallback_loadouts_set( entity player, int entryIndex, int slotContentsIndex )
{
	EHI playerEHI = ToEHI( player )

	if ( !(entryIndex >= 0 && entryIndex < fileLevel.loadoutSlotEntries.len()) )
	{
		Assert( false, "'loadouts_set' had invalid entry index (got " + entryIndex + ", valid range 0-" + (fileLevel.loadoutSlotEntries.len() - 1) + ")." )
		return
	}
	LoadoutEntry entry = fileLevel.loadoutSlotEntries[entryIndex]

	if ( entry.type != eLoadoutEntryType.ITEM_FLAVOR )
	{
		RecordServerAbuseForAntiCheat( player, eRSALabels.NonItemFlavorLoadoutSet )
		return
	}

	if ( IsLoadoutSlotLocked( playerEHI, entry ) )
	{
		Assert( false, "Attempted to use 'loadouts_set' on locked loadout slot \"" + entry.id + "\")." )
		return
	}

	if ( !IsContentsIndexValidForLoadoutSlot( playerEHI, entry, slotContentsIndex, eValidation.ASSERT ) )
	{
		// func asserts for us in dev
		return
	}

	if ( entry != Loadout_Character() && !GRX_IsInventoryReady( player ) )
	{
		Remote_CallFunction_NonReplay( player, "ServerToClient_LoadoutSlotSetFailed" )
		return
	}

	ItemFlavor itemFlavor = ConvertLoadoutSlotContentsIndexToItemFlavor( entry, slotContentsIndex )
	if ( !IsItemFlavorUnlockedForLoadoutSlot( playerEHI, entry, itemFlavor ) )
	{
		// This could happen if two people try to select the same character at the same time
		printt( "LoadoutsDbg: 'loadouts_set' received item flavor \"" + DEV_DescItemFlavor( itemFlavor ) + "\" which is locked for this player (loadout slot \"" + entry.id + "\")." )
		return
	}

	SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, itemFlavor )
}
#endif

#if DEVELOPER
void function DEV_LoadoutsDebug( LoadoutEntry entry )
{
		string func1 = expect string( expect table( getstackinfos( 3 ) ).func ) // one higher than expected because we're calling to this debug func
		string func0 = expect string( expect table( getstackinfos( 2 ) ).func )
		printt("LoadoutsDebug: " + func1 + " called " + func0 + " for LoadoutEntry "+ entry.DEV_name)
}
#endif

#if SERVER && DEVELOPER
bool function ClientCommand_loadouts_devset( entity commandPlayer, array<string> args )
{
	// loadouts_devset
	// 1: [loadout slot entry id string]
	// 2: [slot contents item flavor ref string]
	//
	// example: loadouts_devset character_selection character_gibraltar

	const int EXPECTED_ARG_COUNT_MIN = 2
	const int EXPECTED_ARG_COUNT_MAX = 3
	if ( args.len() < EXPECTED_ARG_COUNT_MIN || args.len() > EXPECTED_ARG_COUNT_MAX )
	{
		Warning( "Incorrect number of arguments to client command 'loadouts_devset' (got \"" + DEV_ArrayConcat( args, " " ) + "\", expected " + EXPECTED_ARG_COUNT_MIN + "-" + EXPECTED_ARG_COUNT_MAX + " arguments)." )
		return true
	}

	array<entity> playersToAffect = ((args.len() < 3 || args[2] != "all") ? [commandPlayer] : GetPlayerArray())
	foreach ( entity player in playersToAffect )
	{
		EHI playerEHI = ToEHI( player )

		string entryId = args[0]
		array<LoadoutEntry> relevantEntries
		foreach ( LoadoutEntry possibleEntry in fileLevel.loadoutSlotEntries )
		{
			bool selected = false
			if ( possibleEntry.id == entryId )
				selected = true
			if ( !selected && LOADOUT_CATEGORIES_TO_NAMES_MAP[possibleEntry.category]  == entryId )
			{
				if ( possibleEntry.isCurrentlyRelevant != null )
					selected = possibleEntry.isCurrentlyRelevant( playerEHI )
				else
					selected = IsLoadoutSlotActive( playerEHI, possibleEntry )
			}

			if ( selected )
			{
				relevantEntries.clear()
				relevantEntries.append( possibleEntry )
				break
			}
		}
		if ( relevantEntries.len() == 0 )
		{
			Warning( "Tried to use 'loadouts_devset' with invalid entry id \"" + entryId + "\"." )
			continue
		}

		//IsLoadoutSlotLocked( playerEHI, entry )

		string slotContentsString = args[1]

		foreach ( LoadoutEntry entry in relevantEntries )
		{
			int slotContentsIndex
			ItemFlavor itemFlavor
			if ( slotContentsString == "~default~" )
			{
				itemFlavor = GetDefaultItemFlavorForLoadoutSlot( playerEHI, entry )
			}
			else if ( slotContentsString == "~random~" )
			{
				array<ItemFlavor> random = clone entry.validItemFlavorList
				random.randomize()
				itemFlavor = random[0]
			}
			else if ( slotContentsString == "~next~" || slotContentsString == "~prev~" )
			{
				int dir = (slotContentsString == "~next~" ? 1 : -1)

				array<ItemFlavor> possibleChoices = clone entry.validItemFlavorList
				foreach ( flav in possibleChoices )
				{
					if ( !ItemFlavor_IsTheFavoriteSentinel( flav ) )
						continue

					possibleChoices.removebyvalue( flav )
					break
				}

				ItemFlavor currentChoice = LoadoutSlot_GetItemFlavor( playerEHI, entry )
				itemFlavor = possibleChoices[real_int_modulo( possibleChoices.find( currentChoice ) + dir, possibleChoices.len() )]
			}
			else if ( DEV_IsValidItemFlavorHumanReadableRef_Slow( slotContentsString ) )
			{
				itemFlavor = DEV_GetItemFlavorByHumanReadableRef_Slow( slotContentsString )
			}
			else
			{
				Warning( "Tried to use 'loadouts_devset' with unknown item flavor ref string \"" + slotContentsString + "\"." )
				continue
			}

			if ( !entry.validItemFlavorList.contains( itemFlavor ) )
				slotContentsIndex = SLOT_CONTENTS_SENTINEL_INVALID
			else
				slotContentsIndex = ConvertItemFlavorToLoadoutSlotContentsIndex( entry, itemFlavor )

			if ( !IsContentsIndexValidForLoadoutSlot( playerEHI, entry, slotContentsIndex, eValidation.DONT_ASSERT ) )
			{
				Warning( "Tried to use 'loadouts_devset' with item flavor \"" + slotContentsString + "\" which is not valid for loadout slot \"" + entryId + "\"." )
				continue
			}

			// IsItemFlavorUnlockedForLoadoutSlot( playerEHI, entry, itemFlavor ) )

			if ( ItemFlavor_GetType( itemFlavor ) == eItemType.melee_skin && Artifacts_Loadouts_IsConfigPointerItemFlavor( itemFlavor ) )
			{
				// we need to manually set the actual PDEF value to avoid callbacks triggering
				if ( entry.pdefKey != "" )
					FromEHI( playerEHI ).SetPersistentVar( entry.pdefKey, itemFlavor.guid )

				Artifacts_StoreLoadoutDataOnPlayerEntityStruct( FromEHI( playerEHI ), null, true )
				Artifacts_DEV_SetupDaggerForLoadouts( playerEHI, entry )

				if ( itemFlavor == LoadoutSlot_GetItemFlavor( playerEHI, entry ) )
					return true
			}

			SetItemFlavorLoadoutSlotContentsInternal( playerEHI, entry, itemFlavor )

			printt( player, "loadouts_devset", entry.id, DEV_ItemFlavor_GetCleanedAssetPath( itemFlavor ) )
		}
	}
	return true
}
#endif

#if DEVELOPER
void function DEV_DumpLoadoutEntries()
{
	string fmtStr = "%s,%s,%s,%s,%s"

	printt( format( fmtStr,
		"DEV_name",
		"id",
		"networkVarName",
		"category",
		"class"
	) )
	foreach ( LoadoutEntry entry in fileLevel.loadoutSlotEntries )
	{
		printt( format( fmtStr,
			entry.DEV_name,
			entry.id,
			entry.networkVarName,
			LOADOUT_CATEGORIES_TO_NAMES_MAP[entry.category],
			DEV_GetClassName( entry )
		) )
	}
}

string function DEV_GetClassName( LoadoutEntry entry )
{
	if ( entry.loadoutEntryClass == eLoadoutEntryClass.ACCOUNT )
		return "ACCOUNT"
	if ( entry.loadoutEntryClass == eLoadoutEntryClass.WEAPON )
		return "WEAPON"
	if ( entry.loadoutEntryClass == eLoadoutEntryClass.CHARACTER )
		return "CHARACTER"

	return "UNKNOWN"
}
#endif

