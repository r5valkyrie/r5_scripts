void function AddCallback_Lobby_OnClientConnected( void functionref( entity ) func )
{
	// these run following Loadout validation (runs threaded), so should *NOT* be timing-sensitive
	Assert( !file.callbacks_lobby_onClientConnected.contains( func ) )
	file.callbacks_lobby_onClientConnected.append( func )
}