bool function ReadyToStart()
{
	if ( IsPrivateMatch() )
		return false

	if ( IsCoopMatch() )
		return IsTeamReady( TEAM_MILITIA )

	int maxTeams = GetCurrentPlaylistVarInt( "max_teams", 2 )
	if ( maxTeams > 2 )
	{
		int minPlayers        = GetCurrentPlaylistVarInt( "min_players", 2 )
		array<entity> players = GetPlayerArray()
		if ( players.len() < minPlayers )
			return false
	}
	else
	{
		if ( !IsTeamReady( TEAM_IMC ) )
			return false
		if ( !IsTeamReady( TEAM_MILITIA ) )
			return false
	}

	return true
}

void function ClientCallback_MarkBattlePassPopupAsSeen( entity player, int markerLevel )
{
	if ( !IsLobby() )
		return

	string bpString = GetActiveBattlePassGUID()
	if ( bpString.len() == 0 )
	{
		Warning( "ClientCallback_MarkBattlePassPopupAsSeen: current active battle pass string guid was empty." )
		return
	}

	player.SetPersistentVar( format( "battlePasses[%s].lastPopupLevel", bpString ), markerLevel )
}

