void function PrintServerGameHistory()
{
	printt( "==============================================" )
	printt( "Server Game History" )

	int mapHistoryCount  = GetServerMapHistory().len()
	int modeHistoryCount = GetServerModeHistory().len()

	array<string> mapHistory = GetServerMapHistory( mapHistoryCount )
	mapHistory.reverse()
	foreach ( map in mapHistory )
		printt( map )

	array<string> modeHistory = GetServerModeHistory( modeHistoryCount )
	modeHistory.reverse()
	foreach ( mode in modeHistory )
		printt( mode )
}


MapModeCombo function GetRecentMapModeCombo()
{
	MapModeCombo mapModeCombo
	for ( int i = 1; i < 5; i++ )
	{
		string map  = GameRules_GetRecentMap( i )
		string mode = GameRules_GetRecentGameMode( i )

		if ( IsLobbyMapName( map ) )
			continue

		mapModeCombo.mapName = map
		mapModeCombo.modeName = mode
		break
	}

	return mapModeCombo
}


MapModeCombo function GetNextComboInOrder()
{
	int numModes = GetCurrentPlaylistGamemodesCount()
	Assert( numModes != 0 )

	MapModeCombo currentCombo = GetRecentMapModeCombo()
	MapModeCombo nextCombo
	for ( int modeIdx = 0; modeIdx < numModes; ++modeIdx )
	{
		string modeName = GetCurrentPlaylistGamemodeByIndex( modeIdx )
		if ( modeName != currentCombo.modeName )
			continue

		int numMaps = GetCurrentPlaylistGamemodeByIndexMapsCount( modeIdx )
		for ( int mapIdx = 0; mapIdx < numMaps; ++mapIdx )
		{
			string mapName = GetCurrentPlaylistGamemodeByIndexMapByIndex( modeIdx, mapIdx )
			if ( mapName != currentCombo.mapName )
				continue

			if ( mapIdx == (numMaps - 1) )
			{
				// there are no more maps in this mode; use the next mode's map
				mapIdx = 0
				if ( modeIdx == (numModes - 1) )
				{
					// there are no more modes; wrap around
					modeIdx = 0
				}
			}

			nextCombo.mapIdx = mapIdx
			nextCombo.mapName = GetCurrentPlaylistGamemodeByIndexMapByIndex( modeIdx, mapIdx )
			nextCombo.modeIdx = modeIdx
			nextCombo.modeName = GetCurrentPlaylistGamemodeByIndex( modeIdx )
			break
		}

		if ( nextCombo.mapIdx != -1 )
			break
	}

	printt( "Selecting next map/mode: " + nextCombo.mapName + "/" + nextCombo.modeName )
	return nextCombo
}


MapModeCombo function GetNextComboRandom()
{
	int numModes = GetCurrentPlaylistGamemodesCount()
	Assert( numModes != 0 )

	int modeIdx = RandomInt( numModes )
	int numMaps = GetCurrentPlaylistGamemodeByIndexMapsCount( modeIdx )
	Assert( numMaps != 0 )

	int mapIdx      = RandomInt( numMaps )
	string mapName  = GetCurrentPlaylistGamemodeByIndexMapByIndex( modeIdx, mapIdx )
	string modeName = GetCurrentPlaylistGamemodeByIndex( modeIdx )
	printt( "Selecting random map/mode: " + mapName + "/" + modeName )

	MapModeCombo mapModeCombo
	mapModeCombo.mapIdx = mapIdx
	mapModeCombo.mapName = mapName
	mapModeCombo.modeIdx = modeIdx
	mapModeCombo.modeName = modeName
	return mapModeCombo
}

struct ScheduleTimes
{
	int start
	int end
}

ScheduleTimes function GetFNFScheduleTimes()
{
	int startTime = GetCurrentPlaylistVarInt( "fnf_schedule_start_time", -1 )
	int endTime   = GetCurrentPlaylistVarInt( "fnf_schedule_end_time", -1 )

	if ( startTime < 0 || endTime < 0 )
	{
		startTime = 1420243200 //+ ( 1 * SECONDS_PER_HOUR ) // 1/2/2015 05:00:00PM PST // This does not account for Daylight Saving Time
		int resetTime = startTime + FNF_SCHEDULE_RESET_SECONDS

		int currentTimeStamp = GetUnixTimestamp()

		while ( resetTime < currentTimeStamp )
		{
			startTime += SECONDS_PER_WEEK
			resetTime = startTime + FNF_SCHEDULE_RESET_SECONDS
		}

		endTime = startTime + 5400 // 1.5 hours
	}

	Assert( endTime > startTime )

	ScheduleTimes times
	times.start = startTime
	times.end = endTime

	return times
}

struct MapModeSchedule
{
	MapModeCombo mapModeCombo
	int          startTime
	int          endTime
}

array<MapModeSchedule> function GetFNFSchedule()
{
	ScheduleTimes fnfScheduleTimes = GetFNFScheduleTimes()
	int scheduleStartTime          = fnfScheduleTimes.start
	int scheduleEndTime            = fnfScheduleTimes.end

	int numMapsInPlaylist = GetCurrentPlaylistMapsCount()
	int chunkTime         = int( (scheduleEndTime - scheduleStartTime) / (numMapsInPlaylist + 0.5) ) // using numMapsInPlaylist + 0.5 so last map gets a larger time chunk

	array<MapModeSchedule> fnfSchedule
	fnfSchedule.resize( numMapsInPlaylist )

	int comboIdx = 0
	int numModes = GetCurrentPlaylistGamemodesCount()
	Assert( numModes != 0 )
	for ( int modeIdx = 0; modeIdx < numModes; ++modeIdx )
	{
		string modeName = GetCurrentPlaylistGamemodeByIndex( modeIdx )
		int numMaps     = GetCurrentPlaylistGamemodeByIndexMapsCount( modeIdx )
		Assert( numMaps != 0 )
		for ( int mapIdx = 0; mapIdx < numMaps; ++mapIdx )
		{
			string mapName = GetCurrentPlaylistGamemodeByIndexMapByIndex( modeIdx, mapIdx )
			fnfSchedule[comboIdx].mapModeCombo.mapIdx = mapIdx
			fnfSchedule[comboIdx].mapModeCombo.mapName = mapName
			fnfSchedule[comboIdx].mapModeCombo.modeIdx = modeIdx
			fnfSchedule[comboIdx].mapModeCombo.modeName = modeName
			fnfSchedule[comboIdx].startTime = scheduleStartTime + chunkTime * comboIdx
			++comboIdx
			fnfSchedule[comboIdx].endTime = scheduleStartTime + chunkTime * comboIdx
		}
	}

	return fnfSchedule
}


MapModeCombo function GetNextFNFScheduledMap()
{
	array<MapModeSchedule> fnfSchedule = GetFNFSchedule()

	int scheduleIdx      = 0
	int currentTimeStamp = GetUnixTimestamp()

	for ( int i = 1; i < fnfSchedule.len(); i++ )
	{
		if ( fnfSchedule[ i ].startTime > currentTimeStamp )
			break

		scheduleIdx++
	}

	MapModeCombo mapModeCombo = fnfSchedule[scheduleIdx].mapModeCombo
	printt( "Selecting scheduled map/mode: " + mapModeCombo.mapName + "/" + mapModeCombo.modeName )
	return mapModeCombo
}


void function PrintFNFSchedule()
{
	printt( "Schedule for playlist: " + GetCurrentPlaylistName() + "\n" )

	array<MapModeSchedule> fnfSchedule = GetFNFSchedule()

	foreach ( schedule in fnfSchedule )
	{
		TimeParts timeParts = GetUnixTimeParts( schedule.startTime + (PST_TIME_ZONE_OFFSET - 1) * SECONDS_PER_HOUR )

		string date = timeParts.month + "/" + timeParts.day + "/" + timeParts.year
		date = PadString( date, 12 )

		string minute = string( timeParts.minute )
		if ( minute.len() == 1 )
			minute = "0" + minute

		string time = timeParts.hour % 12 + ":" + minute
		time = PadString( time, 7 )

		string mode = PadString( schedule.mapModeCombo.modeName, 6 )
		string map  = schedule.mapModeCombo.mapName

		printt( date + time + mode + map )
	}
}


MapModeCombo function Lobby_PickNextMapModeCombo()
{
	if ( GetCurrentPlaylistVarInt( "play_in_order", 0 ) != 0 )
	{
		return GetNextComboInOrder()
	}

	if ( GetCurrentPlaylistVarInt( "fnf_schedule_enabled", 0 ) == 1 )
	{
		ScheduleTimes fnfSchedule = GetFNFScheduleTimes()
		int currentTimeStamp      = GetUnixTimestamp()
		int buffer                = 10 * SECONDS_PER_MINUTE

		// start schedule 10 minutes early, end 10 minutes later than actual times
		if ( (currentTimeStamp > fnfSchedule.start - buffer) &&
						(currentTimeStamp < fnfSchedule.end + buffer) )
			return GetNextFNFScheduledMap()
	}

	return GetNextComboRandom()
}


void function SelectNextMap()
{
	file.nextMapModeCombo = Lobby_PickNextMapModeCombo()
	printt( "Next map: " + file.nextMapModeCombo.mapName )
	printt( "Next mode: " + file.nextMapModeCombo.modeName )
}


void function ClearNextMap()
{
	file.nextMapModeCombo.mapIdx = -1
	file.nextMapModeCombo.modeIdx = -1
}


