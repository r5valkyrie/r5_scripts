void function MarkStoryEventPopupAsSeen( entity player, int itemGuid, int index, string groupId, string persistenceNameId )
{
	if ( index < 0 )
		return

	asset itemAsset = GetSettingsAssetForUniqueId( itemGuid )
	if( itemAsset == $"" )
		return

	array<var> blocks = IterateSettingsAssetArray( itemAsset, groupId )
	if( blocks.len() == 0 || blocks.len() < index )
		return

	var block                        = blocks[ index ]
	string persistenceVarNameHasSeen = GetSettingsBlockString( block, persistenceNameId )
	if( persistenceVarNameHasSeen == "" )
		return

	player.SetPersistentVar( persistenceVarNameHasSeen, 1 )
}
#endif

