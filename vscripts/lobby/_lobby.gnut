const float historyClearRate = 21600 //6 hours

struct MapModeCombo
{
	int    mapIdx = -1
	string mapName = ""
	int    modeIdx = -1
	string modeName = ""
}

struct
{
	int minTeamSize = 0
	int maxTeamSize = 0

	table<int, float> teamMinPlayersTime = {
		[TEAM_IMC] = 0.0,
		[TEAM_MILITIA] = 0.0
	}

	table<int, bool> teamReady = {
		[TEAM_IMC] = false,
		[TEAM_MILITIA] = false
	}

	MapModeCombo& nextMapModeCombo

	float nextLaunchCommandValid = 0.0

	bool anyoneHere = false
	bool bothTeamsHere = false

	float lobbyStartTime
	float hadBothTeamsTime

	table<entity, int> playerForcedMatchmakingMap

	array<void functionref( entity )> callbacks_lobby_onClientConnected
	table< string, array < string > > userReportHistory
	float lastHistoryClearTime
} file


const string REV_CONVEYOR_MODEL = $"mdl/props/lobby_revenant_prop1/lobby_revenant_prop1.rmdl"

void function Lobby_Init()
{
	RegisterSignal( "end_lobby_logic" )

	RegisterSignal( "_disconnectedInternal" )
	RegisterSignal( "CountDownTimerStopped" )
	RegisterSignal( "UpdateLastSeenPremiumCurrency" )
	RegisterSignal( "PlayerDidSpawn" )

	FlagInit( "private_lobby_logic" )
	FlagInit( "CountDownTimerStarted" )

	//ConveyorInit( REV_CONVEYOR_MODEL, "", 5, 20, <0, 0, 0>, "revenant_teaser_lobby_hanging_torso")

	//PrivateLobby_Init()

	AddCallback_OnUpdatingPlayerStryderCharDataArray( Stryder_UpdatePlayerInMatchState )

	#if SERVER
	AddCallback_OnPersistentDataReady( Lobby_OnPersistentDataReady )
	#endif

	GameRules_EnableGlobalChat( true )

	if ( IsMatchmakingServer() )
	{
		printt( "============================================" )
		printt( "Using matchmaking" )
		printt( "============================================" )

		thread ControlMatchmakingServerLobbyLogic()
	}
	else
	{
		printt( "============================================" )
		printt( "NOT using matchmaking" )
		printt( "============================================" )

		//thread LocalServerLobbyLogic()
	}

	AddCallback_EntitiesDidLoad( OnEntitiesDidLoad )

	StatsHook_LobbyStart()

	file.lastHistoryClearTime = Time()
	thread WatchTeamStates()
}


#if SERVER
void function CodeCallback_LobbyReportPlayerCustomerService( entity player, int hardwareID, string uid, string eaid, string reason )
{

	string hardware = GetNameFromHardware( hardwareID )

	if ( !GetCurrentPlaylistVarBool( "eac_report_enable", true ) )
	{
		printt( "LobbyReportPlayerCustomerService: eac_report_enable false" )
		return
	}

	//Every historyClearRate seconds clear the table to prevent too much memory usage
	if( Time() > file.lastHistoryClearTime + historyClearRate )
	{
		file.userReportHistory.clear()
		file.lastHistoryClearTime = Time()
	}

	bool isReportReasonValid                 = false
	array<string> validFriendlyReportReasons = GetReportReasons( player.GetHardware() )
	isReportReasonValid = isReportReasonValid || validFriendlyReportReasons.contains( reason )

	array<string> validEnemyReportReasons = GetReportReasons( player.GetHardware()  )
	isReportReasonValid = isReportReasonValid || validEnemyReportReasons.contains( reason )

	if ( !isReportReasonValid )
	{
		printt( "LobbyReportPlayerCustomerService: Report reason is invalid" )
		return
	}
	string reporterUID      = player.GetPlayerName()
	string reporterHardware = player.GetHardware()
	string reporter = reporterUID + "_" + reporterHardware

	if(!(reporter in file.userReportHistory))
		file.userReportHistory[reporter] <- [] //Add new player to list

	if ( file.userReportHistory[reporter].contains( hardware + "-" + uid + "_" + reason ) )
	{
		printt( "LobbyReportPlayerCustomerService: The reporter already reported this player for this reason" )
		return
	}

	if ( file.userReportHistory[reporter].len() >= GetCurrentPlaylistVarInt( "eac_report_player_max", 12 ) )
	{
		printt( "LobbyReportPlayerCustomerService: Player has spammed the report in this session" )
		return
	}

	switch ( reason )
	{
		case "#REPORT_PLAYER_REASON_OFFENSIVE":
		case "#REPORT_PLAYER_REASON_STALKING":
		case "#REPORT_PLAYER_REASON_SUICIDE":
		case "#REPORT_PLAYER_REASON_DRUGSFIREARMS":
		case "#REPORT_PLAYER_REASON_NAME":
		case "#REPORT_PLAYER_REASON_TAG":
		case "#REPORT_PLAYER_REASON_CONTENT":
		case "#REPORT_PLAYER_REASON_SPAM":
		case "#REPORT_PLAYER_REASON_ILLEGAL_HATE_SPEECH":
		case "#REPORT_PLAYER_REASON_ILLEGAL_SEXUAL_CONTENT":	
		case "#REPORT_PLAYER_REASON_ILLEGAL_CHILD_SOLICITATION":
		case "#REPORT_PLAYER_REASON_ILLEGAL_SUICIDE_THREAT":
		case "#REPORT_PLAYER_REASON_ILLEGAL_LEWDNESS":
		case "#REPORT_PLAYER_REASON_ILLEGAL_TERRORIST_THREAT":
		case "#REPORT_PLAYER_REASON_ILLEGAL_VIOLENT":
			printt( "LobbyReportPlayerCustomerService: ReportAbusiveChat", player.GetPlayerName() + " reported player " + hardware + "-" + uid + " for " + reason )
			ReportAbusiveChat( uid, hardware, reason )
			break

		default:
			printt( "LobbyReportPlayerCustomerService: ReportCheater", player.GetPlayerName() + " reported player " + hardware + "-" + uid + "/" + eaid + " for " + reason  )
			ReportCheater( uid, hardware, reason )
	}

	file.userReportHistory[reporter].append( hardware + "-" + uid + "_" + reason )
}

array<string> function GetReportReasons( string platform )
{
	array<string> prefixes
	array<string> reportReasons = []

	if ( platform.tolower() == "pc" || platform.tolower() == "pc_steam" )
	{
		prefixes.append( "report_player_reason_pc_" + "cheat" + "_" )
		prefixes.append( "report_player_reason_pc_" + "gameplay" + "_" )
		prefixes.append( "report_player_reason_pc_" + "harassment" + "_" )
		prefixes.append( "report_player_reason_pc_" + "content" + "_" )
	}
	else
	{
		prefixes.append( "report_player_reason_console_" + "cheat" + "_" )
		prefixes.append( "report_player_reason_console_" + "gameplay" + "_" )
		prefixes.append( "report_player_reason_console_" + "harassment" + "_" )
		prefixes.append( "report_player_reason_console_" + "content" + "_" )
	}

	foreach ( playlistVarPrefix in prefixes )
	{
		int numReasons = GetCurrentPlaylistVarInt( playlistVarPrefix + "count", 0 )
		for ( int index = 0; index < numReasons; index++ )
		{
			reportReasons.append( GetCurrentPlaylistVarString( playlistVarPrefix + (index + 1), "#UNAVAILABLE" ) )
		}
	}

	return reportReasons
}
#endif

void function OnEntitiesDidLoad()
{
	#if DEV
		SetGlobalNetBool( "isOptInServer", AnyOptInPlaylists() )
	#endif
}

bool function AnyOptInPlaylists()
{
	int numPlaylists = GetPlaylistCount()

	for ( int i = 0; i < numPlaylists; i++ )
	{
		string name    = string( GetPlaylistName( i ) )

		if ( GetPlaylistVarBool( name, "opt_in_only", false ) )
			return true
	}

	return false
}


void function Lobby_OnClientConnectionStarted( entity player )
{
	Assert( IsLobby() )

	printl( "!!! Player connect started: " + player.GetPlayerName() + " | " + player )

	table results
	results.player <- player
	svGlobal.levelEnt.Signal( "PlayerDidSpawn", results )

	                          
		if ( IsPrivateMatchLobby() )
			PrivateMatch_OnPlayerConnecting( player )
       
}

void function Lobby_OnClientConnectionCompleted( entity player )
{
	// Finalize Script's player connection state following initial Loadout validation
	//printl( "Lobby - player connect complete: " + player.GetPlayerName() + " | " + player )

	SaveDateLoggedIn( player )

	player.FreezeControlsOnServer()
	player.hasConnected = true

	UpdateBadRepPresent()

	player.SetPersistentVar( "privateMatchState", 0 )

	QueueUpdateStryderWithPlayersStryderCharDataArray( player )

	                      
		if ( MatchBehavior_Enabled() )
			MatchBehaviorPlayer_OnClientConnected( player )
       

	                          
		if ( IsPrivateMatchLobby() )
			PrivateMatch_OnPlayerConnected( player )
       

	Ranked_SetStatsForRankedSeasonTwo( player  )

	// these run following Loadout validation (threaded), so should *NOT* be timing-sensitive
	foreach ( func in file.callbacks_lobby_onClientConnected )
	{
		func( player )
	}
}

#if SERVER
void function Lobby_OnPersistentDataReady( entity player )
{
	if ( IsValid (player) )
	{
                         
		int currentSeasonGUID = GetLatestSeason( GetUnixTimestamp() ).guid
		if ( player.GetPersistentVarAsInt( "gamemodeSelectorInitializedSeasonGUID" ) != currentSeasonGUID )
		{
			for ( int i = 0; i <= GAMEMODE_MAX_SEEN_INDEX; i++ )
				player.SetPersistentVar( format("gamemodeSelectorSeenIndex[%d]", i ), false )
			player.SetPersistentVar( "gamemodeSelectorInitializedSeasonGUID", currentSeasonGUID )
		}

		//Remote_CallFunction_UI( player, "ServerCallback_GamemodeSelectorInitialize" )
      
	}
}
                         
void function ClientCallback_GamemodeSelectorDismiss( entity player, int gamemodeSelectorIndex )
{
	if ( gamemodeSelectorIndex < 0 || gamemodeSelectorIndex > GAMEMODE_MAX_SEEN_INDEX )
		return
	player.SetPersistentVar( format("gamemodeSelectorSeenIndex[%d]", gamemodeSelectorIndex ), true )
}
      
#endif

void function CancelMatchmakingForPenalty( entity player )
{
	if ( !(player in file.playerForcedMatchmakingMap) )
		file.playerForcedMatchmakingMap[player] <- 0

	file.playerForcedMatchmakingMap[player]++

	RunClientCommandOnPlayer( player, "matchmake_cancel" )
	if ( player.WantsMatchmaking() && file.playerForcedMatchmakingMap[player] > 1 )
		DisconnectWithMessage( player, "#DISCONNECT_PENALTY_MATCHMAKING" )
}


void function CodeCallback_OnPlayerMatchmakingChanged( entity player )
{
	if ( !IsValid( player ) )
	{
		printt( "invalid player in CodeCallback_OnPlayerMatchmakingChanged - not doing anything!" )
		return
	}

	bool isAllowedToMatchmake = IsLobby() || GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) || GameMode_IsActive( eGameModes.FREELANCE )

                            
	isAllowedToMatchmake = isAllowedToMatchmake || IsMatchmakingFromMatchAllowed( player )
      

	if ( isAllowedToMatchmake )
	{
		isAllowedToMatchmake = ( player.IsPlayer() )
		if ( !isAllowedToMatchmake && player.WantsMatchmaking() )
			Warning( "Player " + player.GetPlayerName() + " tried to search a custom match playlist but isn't allowed." )
	}

	if ( player.WantsMatchmaking() && isAllowedToMatchmake )
	{
		printt( "Starting matchmaking for player " + player.GetPlayerName() )
		MatchmakePlayer( player )
	}
	else
	{
		if ( player.WantsMatchmaking() && !isAllowedToMatchmake )
			Warning( FUNC_NAME() + " GetLobbyType() = " + GetLobbyType() + " GetMapName() = " + GetMapName() + " where matchmaking is not allowed" )

		printt( "Stopping matchmaking for player " + player.GetPlayerName() )

		AbortMatchSearchesForPlayer( "player's matchmaking preference changed", player )
	}
}


void function ControlMatchmakingServerLobbyLogic()
{
	OnThreadEnd(
		function()
		{
			printl( "!!! ControlMatchmakingServerLobbyLogic ended" )
		}
	)

	printl( "!!! ControlMatchmakingServerLobbyLogic started" )

	bool prev_isPrivateeMatch = false
	bool isPrivateMatch       = false

	while ( true )
	{
		isPrivateMatch = IsPrivateMatch()

		if ( isPrivateMatch != prev_isPrivateeMatch )
		{
			if ( isPrivateMatch )
			{
				//thread PrivateMatchLobbyLogic()
			}
			else
			{
				svGlobal.levelEnt.Signal( "end_lobby_logic" )
			}

			prev_isPrivateeMatch = isPrivateMatch
		}

		WaitFrame()
	}
}


