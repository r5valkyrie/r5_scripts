void function ClientCallback_CancelMatchSearch( entity player )
{
	if ( GetLobbyType() != "party" )
	{
		printt( "Wrong lobby type for cancelMatchSearch command:", GetLobbyType() )
		return
	}

	AbortMatchSearchesForPlayer( "player canceled match search", player )
}

void function ClientCallback_SetSeasonalHubButtonClickedSeason( entity player )
{
	if ( !IsLobby() )
		return

	ItemFlavor currentSeason = GetLatestSeason( GetUnixTimestamp() )
	string season = ItemFlavor_GetCalEventRef( currentSeason )

	player.SetPersistentVar( "lastHubResetSeason", season )
}

void function ClientCallback_ValidateLoadout( entity player )
{
	// TODO - R5DEV-413775: validating loadouts has a massive server cost and should not be done lightly; should take TYPE(s) of item(s) to validate
	if ( !(GetCurrentPlaylistVarBool( "has_sv_op_v1_loadouts", true )) )
		ValidateGRXPlayerLoadout( player )
	ClientCallback_lastSeenPremiumCurrency( player )
}

void function ClientCallback_lastSeenPremiumCurrency( entity player )
{
	if ( !IsLobby() )
		return

	player.Signal( "UpdateLastSeenPremiumCurrency" )
	thread UpdateLastSeenPremiumCurrency( player )
}

void function ClientCallback_ViewedModes( entity player )
{
	player.SetPersistentVar( "newModeVersion", Playlist_GetNewModeVersion() )

	string currentLTM = Playlist_GetLTMSlotPlaylist()

	if ( currentLTM != "" )
	{
	player.SetPersistentVar( "lastSeenLobbyLTM", currentLTM )
}
	else
	{
		array<ItemFlavor> currentEvents = GetActiveBuffetEventArray( GetUnixTimestamp() )
		foreach ( event in currentEvents )
		{
			var sBlock         = ItemFlavor_GetSettingsBlock( event )
			string highlight = GetSettingsBlockString( sBlock, "highlightGamemodeSelectorSlot" )
			if ( highlight != "" )
			{
				player.SetPersistentVar( "lastSeenLobbyLTM", highlight )
				break
			}
		}
	}
}

void function UpdateLastSeenPremiumCurrency( entity player )
{
	player.EndSignal( "UpdateLastSeenPremiumCurrency" )
	player.EndSignal( "OnDestroy" )
	while ( !GRX_IsInventoryReady( player ) )
		wait 0.5

	int premiumBalance = GRXCurrency_GetPlayerBalance( player, GRX_CURRENCIES[GRX_CURRENCY_PREMIUM] )
	player.SetPersistentVar( "lastSeenPremiumCurrency", premiumBalance )

	//int exoticBalance = GRXCurrency_GetPlayerBalance( player, GRX_CURRENCIES[GRX_CURRENCY_EXOTIC] )
	//player.SetPersistentVar( "lastSeenExoticCurrency", exoticBalance )
}


