void function UpdateTeamStates()
{
	int imcPlayers = GetTeamPlayerCount( TEAM_IMC )
	int milPlayers = GetTeamPlayerCount( TEAM_MILITIA )

	bool anyoneHere    = (imcPlayers > 0 || milPlayers > 0)
	bool bothTeamsHere = (imcPlayers > 0 && milPlayers > 0)

	if ( anyoneHere && !file.anyoneHere )
		file.lobbyStartTime = Time()

	if ( bothTeamsHere && !file.bothTeamsHere )
		file.hadBothTeamsTime = Time()

	file.anyoneHere = anyoneHere
	file.bothTeamsHere = bothTeamsHere
}


void function WatchTeamStates()
{
	file.anyoneHere = false
	file.bothTeamsHere = false

	file.lobbyStartTime = Time()
	file.hadBothTeamsTime = Time()

	for ( ; ; )
	{
		UpdateTeamStates()
		wait 0.5
	}
}


void function StopCountDown()
{
	svGlobal.levelEnt.Signal( "CountDownTimerStopped" )

	level.ui.uiGameStartTime = -1.0

	FlagClear( "CountDownTimerStarted" )
	AllPlayersUnMuteAll()
}


void function ready()
{
	// dev command to start the server
	float time = Time() + 30
	level.ui.uiGameStartTime = time
}

// Used by dev-only dedicated server UI:
void function DevEndLobbyCountdown()
{
	if ( level.ui.uiGameStartTime == -1.0 )
		return
	level.ui.uiGameStartTime = Time() + 3
}


void function StartCountDown()
{
	int countdownDefault = GetCurrentPlaylistVarInt( "lobby_countdown", 60 )

	if ( IsPrivateMatch() || DevLobbyIsFrozen() )
	{
		level.ui.uiGameStartTime = Time() + countdownDefault
	}
	else
	{
		UpdateTeamStates()
		float endTime = file.hadBothTeamsTime + countdownDefault

		int countdownMin = GetCurrentPlaylistVarInt( "lobby_countdown_min", 30 )
		float delta      = (endTime - Time())
		if ( delta < countdownMin )
			endTime = (Time() + countdownMin)

		level.ui.uiGameStartTime = endTime
	}

	FlagSet( "CountDownTimerStarted" )

	int fadeTime = MUTEALLFADEIN
	float delay  = (expect float( level.ui.uiGameStartTime ) - Time()) - fadeTime

	thread MuteAllOnExitLobby( delay, fadeTime )
}


void function MuteAllOnExitLobby( float delay, int fadeTime )
{
	svGlobal.levelEnt.EndSignal( "CountDownTimerStopped" )

	wait delay

	AllPlayersMuteAll( fadeTime )
}
