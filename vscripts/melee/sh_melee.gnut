ItemFlavor function Deathbox_GetDefaultItemFlavor()
{
	Assert( IsValidItemFlavorGUID( DEFAULT_DEATHBOX_GUID ) )
	return GetItemFlavorByGUID( DEFAULT_DEATHBOX_GUID  )
}

ItemFlavor ornull function Deathbox_GetGoldenHorseDeathbox()
{
	if ( IsValidItemFlavorGUID( GOLDEN_HORSE_DEATHBOX_GUID ) )
		return GetItemFlavorByGUID( GOLDEN_HORSE_DEATHBOX_GUID  )

	return null
}
#endif // #if SERVER || CLIENT || UI

#if CLIENT || UI
void function RequestSetDeathboxEquipForMeleeSkin( EHI playerEHI, LoadoutEntry entry, ItemFlavor meleeSkin, ItemFlavor deathbox )
{
	Assert( playerEHI == LocalClientEHI(), "Tried to use RequestSetDeathboxEquipForMeleeSkin on a different player" )
	int slotContentsIndex = ConvertItemFlavorToLoadoutSlotContentsIndex( entry, meleeSkin )

	ItemFlavor ornull character = entry.associatedCharacterOrNull
	Assert( character != null )
	expect ItemFlavor( character )
	Remote_ServerCallFunction( LOADOUT_CLIENT_CALLBACK_TOGGLE_DEATHBOX, ItemFlavor_GetGUID( character ), slotContentsIndex, deathbox.guid )
}
#endif // #if CLIENT || UI

#if CLIENT || UI
ItemFlavor function Deathbox_GetEquipped( ItemFlavor character, ItemFlavor meleeSkin )
{
	EHI playerEHI = LocalClientEHI()

	if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkin ) )
	{
		int configIdx = Artifacts_Loadouts_GetConfigIndex( meleeSkin )
		LoadoutEntry loadoutSlot = Artifacts_Loadouts_GetEntryForConfigIndexAndType( configIdx, eArtifactComponentType.DEATHBOX )
		return LoadoutSlot_GetItemFlavor( playerEHI, loadoutSlot )
	}

	LoadoutEntry skinSlot = Loadout_MeleeSkin( character )
	LoadoutEntry boxSlot  = Loadout_Deathbox( character )
	array<ItemFlavor> skinBackups = LoadoutSlot_GetBackups( playerEHI, skinSlot )
	array<ItemFlavor> boxBackups  = LoadoutSlot_GetBackups( playerEHI, boxSlot )

	for ( int i = 0; i < skinBackups.len() && i < boxBackups.len(); i++ )
	{
		if ( skinBackups[i] == meleeSkin )
			return boxBackups[i]
	}

	return GetDefaultItemFlavorForLoadoutSlot( playerEHI, boxSlot )
}
#endif // #if CLIENT || UI

#if CLIENT
void function ServerCallback_Loadouts_DeathboxEquipForMeleeSkinToggled( int characterGUID, int skinGUID, int deathboxGUID )
{
	if ( !IsValidItemFlavorGUID( characterGUID ) || !IsValidItemFlavorGUID( skinGUID ) || !IsValidItemFlavorGUID( deathboxGUID ) )
		return

	ItemFlavor character = GetItemFlavorByGUID( characterGUID )
	ItemFlavor meleeSkin = GetItemFlavorByGUID( skinGUID )
	Assert( ItemFlavor_GetType( GetItemFlavorByGUID( characterGUID ) ) == eItemType.character && ItemFlavor_GetType( GetItemFlavorByGUID( skinGUID ) ) == eItemType.melee_skin )

	// TODO: make func names const
	RunUIScript( "MeleeCustomizationScreen_ClientToUI_UpdateDeathboxEquipState", characterGUID, skinGUID, deathboxGUID )
}
#endif // #if CLIENT

#if SERVER
void function ClientCallback_Loadouts_ToggleDeathboxEquipForMeleeSkin( entity player, int characterGUID, int meleeSkinGUID, int deathboxGUID )
{
	if ( !IsLobby() )
		return

	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	if ( !IsValidItemFlavorGUID( meleeSkinGUID ) )
		return

	ItemFlavor meleeSkin = GetItemFlavorByGUID( meleeSkinGUID )
	if ( ItemFlavor_GetType( meleeSkin ) != eItemType.melee_skin || Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkin ) )
		return

	if ( !IsValidItemFlavorGUID( deathboxGUID ) || ItemFlavor_GetType( GetItemFlavorByGUID( deathboxGUID ) ) != eItemType.artifact_component_deathbox )
		return

	if ( !IsValidItemFlavorGUID( characterGUID ) || ItemFlavor_GetType( GetItemFlavorByGUID( characterGUID ) ) != eItemType.character )
		return

	ItemFlavor character = GetItemFlavorByGUID( characterGUID )
	if ( !IsItemFlavorUnlockedForLoadoutSlot( ToEHI( player ), Loadout_Character(), character ) )
		return

	if ( !IsItemFlavorUnlockedForLoadoutSlot( ToEHI( player ), Loadout_MeleeSkin( character ), GetItemFlavorByGUID( meleeSkinGUID ) ) )
		return

	if ( !IsItemFlavorUnlockedForLoadoutSlot( ToEHI( player ), Loadout_Deathbox( character ), GetItemFlavorByGUID( deathboxGUID ) ) )
		return

	Loadout_EquipDeathboxToMeleeSkin( ToEHI( player ), character, meleeSkin, GetItemFlavorByGUID( deathboxGUID ) )
}
#endif // #if SERVER

#if SERVER
void function Loadout_EquipDeathboxToMeleeSkin( EHI playerEHI, ItemFlavor character, ItemFlavor meleeSkin, ItemFlavor deathbox )
{
	// deathbox field not in pdef
	return

	unreachable
	Assert( !Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkin ) )

	LoadoutEntry skinSlot = Loadout_MeleeSkin( character )
	LoadoutEntry boxSlot = Loadout_Deathbox( character )
	ItemFlavor currentSkinFlav = LoadoutSlot_GetItemFlavor( playerEHI, skinSlot )
	if ( meleeSkin == currentSkinFlav )
		SetItemFlavorLoadoutSlot( playerEHI, boxSlot, deathbox )

	// backup this data: either update existing or set in a new slot
	array<ItemFlavor> skinBackups = LoadoutSlot_GetBackups( playerEHI, skinSlot )

	Assert( boxSlot.backupPdefKeys != null )
	array<string> ornull boxes = boxSlot.backupPdefKeys
	expect array<string>( boxes )

	Assert( skinSlot.backupPdefKeys != null )
	array<string> ornull skins = skinSlot.backupPdefKeys
	expect array<string>( skins )

	entity player = FromEHI( playerEHI )
	bool found = false
	int insertAt = -1
	bool shouldClean = GetCurrentPlaylistVarBool( "artifacts_clean_loadout_backups", true )
	for ( int i = skinBackups.len() - 1; i >= 0; i-- )
	{
		if ( skinBackups[i] == meleeSkin )
		{
			if ( found )
			{
				if ( shouldClean )
				{
					player.SetPersistentVar( LOADOUT_PDEF_PREFIX + boxes[i], 0 )
					player.SetPersistentVar( LOADOUT_PDEF_PREFIX + skins[i], 0 )
					Assert( false, format( "Loadouts: duplicate backups found for melee skin %s", ItemFlavor_GetGUIDString( meleeSkin ) ) )
				}
			}
			else
			{
				int currentBoxGUID = FromEHI( playerEHI ).GetPersistentVarAsInt( LOADOUT_PDEF_PREFIX + boxes[i] )
				int guidToSet = ( currentBoxGUID == ItemFlavor_GetGUID( deathbox ) ) ? ItemFlavor_GetGUID( boxSlot.defaultItemFlavor ) : ItemFlavor_GetGUID( deathbox )
				player.SetPersistentVar( LOADOUT_PDEF_PREFIX + boxes[i], guidToSet )
				found = true
				if ( !shouldClean )
					break
			}
		}
		else if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( skinBackups[i] ) ) // fix for bug in 20.1 where Artifacts were getting saved in backup slots
		{
			skinBackups.remove( i )
			player.SetPersistentVar( LOADOUT_PDEF_PREFIX + skins[i], 0 )
			player.SetPersistentVar( LOADOUT_PDEF_PREFIX + boxes[i], 0 )
			insertAt = i
		}
	}

	if ( !found ) // save in the first open slot
	{
		int idx = insertAt == -1 ? skinBackups.len() : insertAt
		if ( idx >= NUM_LOADOUT_BACKUPS ) // don't crash Prod if someone somehow forgot to bump the backup count; remove the assert if we start to bloat on the number of backups. Even 4 (8x slots per legend) is likely already way excessive...
			return

		player.SetPersistentVar( LOADOUT_PDEF_PREFIX + skins[idx], ItemFlavor_GetGUID( meleeSkin ) )
		player.SetPersistentVar( LOADOUT_PDEF_PREFIX + boxes[idx], ItemFlavor_GetGUID( deathbox ) )
	}

	Remote_CallFunction_NonReplay( FromEHI( playerEHI ), LOADOUT_SERVER_CALLBACK_DEATHBOX_TOGGLED, character.guid, meleeSkin.guid, deathbox.guid )
}
#endif // #if SERVER

#if SERVER
void function Loadout_EquipSavedMeleeSkinAndDeathboxPair( EHI playerEHI, LoadoutEntry skinSlot, ItemFlavor meleeSkin )
{
	// deathbox field not in pdef
	return

	unreachable
	// this is called from Loadouts when a melee skin is equipped to equip the deathbox paired with that skin in the backups (if any)
	ItemFlavor ornull character = skinSlot.associatedCharacterOrNull
	Assert( character != null )
	expect ItemFlavor( character )
	LoadoutEntry boxSlot = Loadout_Deathbox( character )

	// if it's an artifact weapon, get the configured Deathbox and store that for consistency
	if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkin ) )
	{
		int artifactConfigIdx = Artifacts_Loadouts_GetConfigIndex( meleeSkin )
		LoadoutEntry artifactDeathboxSlot = Artifacts_Loadouts_GetEntryForConfigIndexAndType( artifactConfigIdx, eArtifactComponentType.DEATHBOX )
		ItemFlavor artifactDeathbox = LoadoutSlot_GetItemFlavor( playerEHI, artifactDeathboxSlot )
		FromEHI( playerEHI ).SetPersistentVar( LOADOUT_PDEF_PREFIX + boxSlot.id, ItemFlavor_GetGUID( artifactDeathbox ) )
		return
	}

	// backup this data: either update existing or set in a new slot
	array<ItemFlavor> skinBackups = LoadoutSlot_GetBackups( playerEHI, skinSlot )
	array<ItemFlavor> boxBackups  = LoadoutSlot_GetBackups( playerEHI, boxSlot )

	bool found = false
	for ( int i = 0; i < skinBackups.len(); i++ )
	{
		if ( skinBackups[i] == meleeSkin )
		{
			found = true
			if ( !(i >= 0 && i < boxBackups.len()) || !IsItemFlavorUnlockedForLoadoutSlot( playerEHI, boxSlot, boxBackups[i] ) )
			{
				// equip the default box & clear/set the backup slot to the default
				FromEHI( playerEHI ).SetPersistentVar( LOADOUT_PDEF_PREFIX + boxSlot.id, ItemFlavor_GetGUID( boxSlot.defaultItemFlavor ) )
				Assert( boxSlot.backupPdefKeys != null )
				array<string> ornull boxes = boxSlot.backupPdefKeys
				expect array<string>( boxes )
				FromEHI( playerEHI ).SetPersistentVar( LOADOUT_PDEF_PREFIX + boxes[i], ItemFlavor_GetGUID( boxSlot.defaultItemFlavor ) )
			}
			else
			{			
				FromEHI( playerEHI ).SetPersistentVar( LOADOUT_PDEF_PREFIX + boxSlot.id, ItemFlavor_GetGUID( boxBackups[i] ) )
			}
			break
		}
	}

	if ( !found ) // clear any currently active box if we're equipping a new melee skin for the first time
		FromEHI( playerEHI ).SetPersistentVar( LOADOUT_PDEF_PREFIX + boxSlot.id, ItemFlavor_GetGUID( boxSlot.defaultItemFlavor ) )
}
#endif // #if SERVER

#if SERVER
void function OnDeathboxSpawned( entity deathbox, entity attacker, int damageSourceID )
{
	if ( IsValid( deathbox ) )
	{
		entity victim = deathbox.GetOwner()
		if ( victim in fileLevel.victimToBleedoutAttackerMap )
		{
			entity bleedoutAttacker = fileLevel.victimToBleedoutAttackerMap[ victim ]
			if ( IsValid( bleedoutAttacker ) && bleedoutAttacker.IsPlayer() )
				attacker = bleedoutAttacker

			delete fileLevel.victimToBleedoutAttackerMap[ victim ]
		}

		if ( !IsValid( attacker ) )
			return

		bool attackerIsPlayer = attacker.IsPlayer()
		bool attackerIsNPC    = attacker.IsNPC()

		if ( !attackerIsPlayer && !attackerIsNPC )
			return

		if ( attackerIsNPC )
		{
			if ( CanNPCDoDamageOnBehalfOfPlayer( attacker ) )
			{
				entity boss = attacker.GetBossPlayer()
				if ( IsValid( boss ) && boss.IsPlayer() )
					attacker = boss
				else // can't get loadout from a nonvalid boss
					return
			}
			else // NPC can't do damage on behalf of player
			{
				return
			}
		}


		ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
		ItemFlavor meleeSkinFlavor   = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_MeleeSkin( attackerCharacter ) )
		ItemFlavor deathboxFlavor    = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Deathbox( attackerCharacter ) )

		bool hasSpecialBox  = false
		asset deathboxFX    = $""
		asset deathboxModel = $""
		string deathboxSFX  = ""

		if ( Artifacts_Loadouts_IsConfigPointerItemFlavor( meleeSkinFlavor ) )
		{
			int configIndex      = Artifacts_Loadouts_GetConfigIndex( meleeSkinFlavor )
			LoadoutEntry boxSlot = Artifacts_Loadouts_GetEntryForConfigIndexAndType( configIndex, eArtifactComponentType.DEATHBOX )
			deathboxFlavor       = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), boxSlot )

			if ( deathboxFlavor == Deathbox_GetDefaultItemFlavor() )
				return

			deathboxModel = Artifacts_GetDeathboxModel( deathboxFlavor )
			deathboxFX    = Artifacts_FX_GetDeathboxFX( deathboxFlavor )
			deathboxSFX   = Artifacts_FX_GetDeathboxSpawnSFX( deathboxFlavor )

			hasSpecialBox = true
		}
		else if ( deathboxFlavor != Deathbox_GetDefaultItemFlavor() )
		{
			deathboxModel = Artifacts_GetDeathboxModel( deathboxFlavor )
			deathboxFX    = Artifacts_FX_GetDeathboxFX( deathboxFlavor )
			deathboxSFX   = Artifacts_FX_GetDeathboxSpawnSFX( deathboxFlavor )

			hasSpecialBox = true
		}

		if ( hasSpecialBox )
		{
			if ( deathboxModel == $"" )
				return

			deathbox.SetModel( deathboxModel )

			if ( deathboxFX == $"" )
				return

			entity boxFX = StartParticleEffectOnEntity_ReturnEntity( deathbox, GetParticleSystemIndex( deathboxFX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
			boxFX.SetParent( deathbox, FX_CENTER )

			Assert( !( deathbox in fxTable ) )
			fxTable[deathbox] <- boxFX
			AddEntityDestroyedCallback( deathbox, OnDeathBoxDestroyed )

			if ( deathboxSFX != "" )
				EmitSoundOnEntity( deathbox, deathboxSFX )
		}
	}
}
#endif // #if SERVER

#if SERVER
void function OnDeathBoxDestroyed( entity deathbox )
{
	if( deathbox in fxTable )
	{
		delete fxTable[deathbox]
	}
}
#endif // #if SERVER

#if SERVER
void function OnLootUpdated( entity deathbox )
{
	if( !( deathbox in fxTable ) )
		return

	entity boxFX = fxTable[deathbox]
	array<entity> itemsInBox = deathbox.GetLinkEntArray()

	int maxTier = 0
	if ( itemsInBox.len() > 0 )
	{
		foreach ( loot in itemsInBox )
		{
			LootData data = SURVIVAL_Loot_GetLootDataByRef( loot.e.lootRef )
			if ( data.tier > maxTier )
				maxTier = data.tier
		}
	}

	EffectSetControlPointColorById( boxFX, 1, COLORID_FX_LOOT_TIER0 + maxTier )
}
#endif // #if SERVER

