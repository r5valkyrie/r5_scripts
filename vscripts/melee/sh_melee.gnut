#if SERVER
void function MeleeSkin_RemapSkinToDamageSourceId( var damageInfo, table<string, table< int, int > > heirloomSkinRemap )
{
	entity attacker      = DamageInfo_GetAttacker( damageInfo )
	string meleeSkinName = MeleeSkin_GetSkinNameFromPlayer( attacker )

	if ( meleeSkinName in heirloomSkinRemap )
	{
		int sourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
		if ( sourceId in heirloomSkinRemap[meleeSkinName] )
		{
			DamageInfo_SetDamageSourceIdentifier( damageInfo, heirloomSkinRemap[meleeSkinName][sourceId] )
		}
	}
}
#endif

#if CLIENT || SERVER
void function Melee_SetModsForLegendAbilities( entity player )
{
	#if CLIENT
		if ( !InPrediction() )
			return
	#endif

	// special case for Seer
	if ( IsValid( player ) )
	{
		entity offhand = player.GetOffhandWeapon( OFFHAND_EQUIPMENT )
		if ( IsValid( offhand ) && offhand.GetWeaponClassName() == HEARTBEAT_SENSOR_WEAPON_NAME && !offhand.HasMod( ARTIFACT_EQUIPPED_MOD ) )
			offhand.AddMod( ARTIFACT_EQUIPPED_MOD )
	}
}

void function Melee_RemoveModsForLegendAbilities( entity player )
{
	#if CLIENT
	if ( !InPrediction() )
		return
	#endif

	// special case for Seer
	if ( IsValid( player ) )
	{
		entity offhand = player.GetOffhandWeapon( OFFHAND_EQUIPMENT )
		if ( IsValid( offhand ) && offhand.GetWeaponClassName() == HEARTBEAT_SENSOR_WEAPON_NAME && offhand.HasMod( ARTIFACT_EQUIPPED_MOD ) )
			offhand.RemoveMod( ARTIFACT_EQUIPPED_MOD )
	}
}
#endif

