void function OnVehicleKilled( entity vehicle, var di )
{
	//PIN_VehicleDestruction( vehicle, di )

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( di )
                            
                                                                                                                                     
     
	int ejectMode = eHOVER_VEHICLE_EJECT_MODE.Skydive
      

	DestroyVehicle( vehicle, ejectMode )
}

void function DestroyVehicle( entity vehicle, int ejectMode )
{
	EjectAllFromVehicle( vehicle, ejectMode )

	file.vehicleArray.fastremovebyvalue( vehicle )

	vector explosionCenter = vehicle.GetOrigin()
	vector eplosionFXCenter = vehicle.GetAttachmentOrigin( vehicle.LookupAttachment( "FX_CENTER" ) )
	vector eplosionFXAngles = vehicle.GetAttachmentAngles( vehicle.LookupAttachment( "FX_CENTER" ) )
	StartParticleEffectInWorld( GetParticleSystemIndex( FX_VEHICLE_DEATH_FX ), eplosionFXCenter, eplosionFXAngles )
	EmitSoundAtPosition( TEAM_UNASSIGNED, explosionCenter, HOVER_VEHICLE_DESTROY_EXPLOSION_SOUND, vehicle )

	if ( ejectMode == eHOVER_VEHICLE_EJECT_MODE.Skydive )
	{
		float damage = 100
		float damageHeavyArmor = 100
		float innerRadius = 100
		float outerRadius = HOVER_VEHICLE_EXPLOSION_DAMAGE_OUTER_RADIUS
		float explosionForce  = 100
		int scriptDamageFlags = damageTypes.explosive
		int scriptDamageSourceIdentifier = eDamageSourceId.exploding_barrel
		string impactEffectTableName = "" // "exp_rocket_archer_burn", "superSpectre_groundSlam_impact"
		Explosion( explosionCenter, vehicle, vehicle, damage, damageHeavyArmor, innerRadius, outerRadius, 0, explosionCenter, explosionForce, scriptDamageFlags, scriptDamageSourceIdentifier, impactEffectTableName )
	}
}
#endif

