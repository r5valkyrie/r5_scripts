bool function CanWeaponInspect( entity player, int activity )
{
	if ( HoverVehicle_PlayerIsDriving( player ) )
		return false

	return true
}


///////////////
// Vehicle Horn

const string CMDNAME_VEHICLE_HORN = "ClientCallback_VehicleHorn"

void function InitVehicleHorn()
{
	Remote_RegisterServerFunction( CMDNAME_VEHICLE_HORN )

#if CLIENT
	RegisterConCommandTriggeredCallback( "+scriptCommand5", OnPressHornButton )
#endif // CLIENT
}

#if SERVER
const float HORN_LOCKOUT_TIME = 4.0
void function ClientCallback_VehicleHorn( entity player )
{
	ClientCommand_VehicleHorn_( player )
}
table<entity, float> s_mapPlayersToHornTimes
void function ClientCommand_VehicleHorn_( entity player  )
{
	if ( !IsAlive( player ) )
		return
	entity vehicle = GetHoverVehicleDrivenByPlayer( player )
	if ( !IsValid( vehicle ) )
		return

	// Manage lockout time:
	{
		if ( !(player in s_mapPlayersToHornTimes) )
			s_mapPlayersToHornTimes[player] <- 0.0
		float timeSinceHorn = (Time() - s_mapPlayersToHornTimes[player])
		if ( timeSinceHorn < HORN_LOCKOUT_TIME )
			return

		s_mapPlayersToHornTimes[player] = Time()
	}

	//
	printf( "%s() - Horn pressed: '%s', '%s'", FUNC_NAME(), string( player ), string( vehicle ) )

	// Horn sound:
	//EmitSoundOnEntity( vehicle, "survival_supplyship_station_alert" )

	if ( VehicleHasRoomForNormalOccupants( vehicle ) )
	{
		// dialog:
		//delaythread( RandomFloatRange( 0.1, 0.15 ) ) PlayBattleChatterLineToSpeakerAndTeam( player, "bc_skydive" )

		// ping:
		{
			entity wp = CreateWaypoint_Ping_Location( player, ePingType.HOVERVEHICLE_NAG, vehicle, vehicle.GetOrigin(), -1, false )
			if ( IsValid( wp ) )
			{
				wp.SetAbsOrigin( vehicle.GetOrigin() + <0, 0, 135> )
				wp.SetParent( vehicle )
			}
		}
	}
}
#endif // SERVER

#if CLIENT
void function OnPressHornButton( entity player )
{
	if ( !IsValid( player ) || !IsAlive( player ) )
		return
	if ( (player != GetLocalViewPlayer()) || (player != GetLocalClientPlayer()) )
		return

	if ( IsControllerModeActive() )
	{
		if ( TryOnscreenPromptFunction( player, "quickchat" ) )
			return
	}

	if ( !HoverVehicle_PlayerIsDriving( player ) )
		return
	Remote_ServerCallFunction( CMDNAME_VEHICLE_HORN )
}
#endif // CLIENT

#if SERVER
void function HoverVehicle_AddCallback_OnVehicleDisembarkFinished( void functionref(entity, entity) func )
{
	if ( !file.callbacks_OnVehicleDisembarkEnd.contains( func ) )
		file.callbacks_OnVehicleDisembarkEnd.append( func )
}

void function HoverVehicle_AddCallback_OnVehicleDisembarkStarted( void functionref(entity, entity) func )
{
	if ( !file.callbacks_OnVehicleDisembarkStart.contains( func ) )
		file.callbacks_OnVehicleDisembarkStart.append( func )
}
#endif

#if CLIENT
entity function GetVehicleUnderAim( vector worldPos, float worldRange )
{
	float closestDistSqr        = FLT_MAX
	float worldRangeSqr = worldRange * worldRange
	entity closestEnt = null

	if( MapPing_Modify_DistanceCheck_Enabled() )
	{
		float modifier = MapPing_DistanceCheck_GetModifier()

		if( worldRange >= MapPing_DistanceCheck_GetDistanceRange() )
			modifier *= 0.5

		worldRangeSqr = ( worldRange * modifier ) * ( worldRange * modifier )
	}

	foreach( entity spawnEnt, bool present in file.vehicleAtSpawnPlatform )
	{
		if ( !IsValid( spawnEnt ) )
			continue

		if ( !present )
			continue

		vector vehicleOrigin = spawnEnt.GetOrigin()

		float distSqr = Distance2DSqr( vehicleOrigin, worldPos )
		if ( distSqr < worldRangeSqr && distSqr < closestDistSqr  )
		{
			closestDistSqr = distSqr
			closestEnt     = spawnEnt
		}
	}

	if ( !IsValid( closestEnt ) )
	{
		return null
	}

	//return the object
	return closestEnt
}

bool function PingVehicleUnderAim( entity vehicle )
{
	entity player = GetLocalClientPlayer()

	if ( !IsValid( player ) || !IsAlive( player ) )
		return false

	if ( !IsPingEnabledForPlayer( player ) )
		return false

	if( !IsValid( vehicle ) )
		return false

	Remote_ServerCallFunction( FUNCNAME_PingVehicleFromMap, vehicle )

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )

	return true
}
#endif

#if SERVER
void function HoverVehicle_ClientToServer_PingVehicleFromMap( entity player, entity vehicle )
{
	if ( IsValid( player ) && IsValid( vehicle ) )
	{
		CreateWaypoint_Ping_Location( player, ePingType.HOVERVEHICLE, vehicle, vehicle.GetOrigin() + <0, 0, 50>, -1, false, false, pingWheelIndex.PING_MAP )
	}
}
#endif

#if CLIENT
void function HoverVehicle_ServerToClient_SetVehicleNotAtPlatformTracking( entity vehicle )
{
	if ( IsValid( vehicle ) )
	{
		if( file.vehicleAtSpawnPlatform[vehicle] )
		{
			file.vehicleAtSpawnPlatform[vehicle] <- false
		}
	}
}
#endif