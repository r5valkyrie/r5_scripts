	vehicle.SetScriptName( HOVER_VEHICLE_SCRIPTNAME )
	vehicle.DisableHibernation()
	vehicle.SetAimAssistAllowed( true )
	vehicle.SetOwner( null )
	vehicle.SetTouchTriggers( true )
	SetVisibleEntitiesInConeQueriableEnabled( vehicle, true )
	vehicle.VehicleSetViewOffset( < 0.0, 0.0, 105.0 > )
	vehicle.EnableAttackableByAI( AI_PRIORITY_NO_THREAT, 0, AI_AP_FLAG_NONE )

	// reskining happening in sh_prop_override.nut
	/*if ( vehicle.HasKey( "vehicle_skin" ) )
	{
		string skinName =  GetSkinNameForLevelEdInteger( int(vehicle.GetValueForKey( "vehicle_skin" ) ) )
		if ( vehicle.GetSkinIndexByName( skinName ) != -1 )
		{
			vehicle.SetSkin( vehicle.GetSkinIndexByName( skinName ) )
		}
	}

		if ( GetMapName().find( "tropic" ) != -1 ) // Eventually repace this with the leveled dropdown set values
		{
			int skinIndex = vehicle.GetSkinIndexByName( "Tropics Varient" )
			vehicle.SetSkin( skinIndex )
		}
	*/

	vehicle.SetForceVisibleInPhaseShift( true )

	vehicle.SetMaxHealth( 500 )
	vehicle.SetHealth( 500 )
	vehicle.SetTakeDamageType( DAMAGE_YES )
	vehicle.SetBlocksRadiusDamage( false )
	vehicle.SetCanBeMeleed( true )

	vehicle.SetDamageNotifications( false )
	vehicle.SetDeathNotifications( false )

	vehicle.kv.intensity = 0

	vehicle.SetUsable()
	//vehicle.SetUsePrompts( "#HOLD_USE_TO_RIDE_HOVER_VEHICLE", "#HOLD_USE_TO_RIDE_HOVER_VEHICLE" )
	vehicle.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_SHRINK_USEABLE_BOX )
	SetCallback_CanUseEntityCallback( vehicle, VehicleCanUseEntityCallback )

	vehicle.Highlight_Enable()
	HoverVehicle_SetEffects( vehicle )
	vehicle.e.canBurn = true

	AddNeurolinkDetectionForPropScript( vehicle )

	SetTeam( vehicle, TEAM_UNASSIGNED )
	file.vehicleArray.append( vehicle )

	AddEntityCallback_OnDamaged( vehicle, HoverVehicleOnDamaged )
                             
                                                                       
       
	AddEntityCallback_OnKilled( vehicle, OnVehicleKilled )

	Highlight_SetNeutralHighlight( vehicle, "hover_vehicle_highlight" )

	if ( Highlight_IsUsingGameModeEnemyVehicleHighlights() )
		Highlight_SetEnemyHighlight( vehicle, Highlight_GetGameModeEnemyVehicleHighlightString() )

	if ( Highlight_IsUsingGameModeFriendlyVehicleHighlights() )
		Highlight_SetFriendlyHighlight( vehicle, Highlight_GetGameModeFriendlyVehicleHighlightString() )
}
void function EditorSpawnCallbackForPlacedHoverVehicle( entity vehicle )
{
	//allow playlists to keep vehicles enabled but ignore all leveled placed ones
	if ( !HoverVehiclesAreEnabled() || !GetCurrentPlaylistVarBool( "should_spawn_placed_vehicles", true ) )
	{
		foreach( ent in vehicle.GetLinkEntArray() )
		{
			if ( ent.GetTargetName() == "vehicle_platform" )
			{
				ent.Destroy()
				break
			}
		}

		vehicle.Destroy()
		return
	}

	HoverVehicle_Spawn( vehicle )
	if ( !IsValid( vehicle ) )
		return

	RegisterGUIDForSpawnedVehicle( vehicle )

	ManageSpawnPointFX( vehicle )
}

int function QuantizeCoord( float coord, float range, int bits )
{
	int chunkCount = (1 << bits)
	float chunkSize = (range / chunkCount)
	float adjustedCoord = Clamp( (coord + (range * 0.5)), 0.0, range )
	return int( adjustedCoord / chunkSize )
}
table<entity, int> s_mapVehiclesToGUIDs
void function RegisterGUIDForSpawnedVehicle( entity vehicle )
{
	Assert( !(vehicle in s_mapVehiclesToGUIDs) )

	const float ENCODING_RANGE = 131072.0
	const int ENCODING_BITS = 12
	const int ENCODING_MASK = ((1 << ENCODING_BITS) - 1)

	vector org = vehicle.GetOrigin()
	int xPart = QuantizeCoord( org.x, ENCODING_RANGE, ENCODING_BITS )
	int yPart = QuantizeCoord( org.y, ENCODING_RANGE, ENCODING_BITS )
	int newGUID = ((xPart & ENCODING_MASK) | ((yPart & ENCODING_MASK) << ENCODING_BITS))
	s_mapVehiclesToGUIDs[vehicle] <- newGUID
}
int function HoverVehicle_GetGUIDForVehicle( entity vehicle )
{
	if ( !(vehicle in s_mapVehiclesToGUIDs) )
		return -1

	return s_mapVehiclesToGUIDs[vehicle]
}

void function ManageSpawnPointFX( entity vehicle )
{
	thread function() : (vehicle)
	{
		WaitFrame()
		if ( !IsValid( vehicle ) )
			return

		entity icon = HoverVehicle_CreateMinimapIconEnt( vehicle.GetOrigin() )
		entity beamFx = null
		//find attached hover platform if available
		entity platform
		foreach( ent in vehicle.GetLinkEntArray() )
		{
			if ( ent.GetTargetName() == "vehicle_platform" )
			{
				platform = ent
				beamFx = StartParticleEffectOnEntityWithPos_ReturnEntity( platform, GetParticleSystemIndex( FX_VEHICLE_SPAWN_POINT ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID, <0, 0, 128>, <-90, 0, 0> )

				break
			}
		}

		if ( IsValid( platform ) )
			platform.SetPusher( true )

		OnThreadEnd( function () : ( icon, beamFx, platform, vehicle ) {
			if ( IsValid( icon ) )
				icon.Destroy()
			if ( IsValid( beamFx ) )
				beamFx.Destroy()

			if ( IsValid( platform ) )
				platform.SetSkin( 1 )

			if( HoverVehicles_PingFromMap_Enabled() )
			{
				foreach( player in GetPlayerArray() )
				{
					Remote_CallFunction_NonReplay( player, FUNCNAME_SetVehiclePresenceAtPlatform, vehicle )
				}
			}
		} )

		EndSignal( vehicle, "OnDestroy" )
		EndSignal( vehicle, SIG_DRIVER_EMBARK_FINISHED )
		WaitForever()
	}()

	//
}

entity function HoverVehicle_CreateMinimapIconEnt( vector origin )
{
	entity ent = CreatePropScript( $"mdl/dev/empty_model.rmdl", origin, <0, -90, 0> )
	SetTargetName( ent, "hover_vehicle" )
	ent.Minimap_SetCustomState( eMinimapObject_prop_script.HOVER_VEHICLE_SPAWNPOINT )
	ent.Minimap_SetZOrder( MINIMAP_Z_OBJECT-1 )
	ent.Minimap_AlwaysShow( TEAM_UNASSIGNED, null )

	return ent
}

int function GetEffectiveTeamNumForVehicle( entity vehicle )
{
	array<entity> players = HoverVehicle_GetExtendedPlayerArray( vehicle )
	if ( players.len() == 0 )
		return TEAM_UNASSIGNED

	foreach( player in players )
	{
		if ( vehicle.VehicleIsDriver( player ) )
			return player.GetTeam()
	}
	return players[0].GetTeam()
}

void function HoverVehicleOnDamaged( entity vehicle, var di )
{
	float originalDamage = DamageInfo_GetDamage( di )
	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( di )
	//int damageFlags = DamageInfo_GetCustomDamageType( di )
	//printf( "%s() - damageSourceId:0x%x (%s)  damageFlags:0x%x (%s)", FUNC_NAME(), damageSourceId, DamageSourceIDToString( damageSourceId ), damageFlags, GetDescStringForDamageFlags( damageFlags ) )

	if ( damageSourceId == eDamageSourceId.fall )
	{
		printf( "%s() - Letting damage of '%.1f' go through, since: (damageSourceId == eDamageSourceId.fall)", FUNC_NAME(), originalDamage )

                              
                                           
        
		{
			OnVehicleKilled( vehicle, di )
			vehicle.Destroy()
		}
		return
	}

	//
	int vehTeam = GetEffectiveTeamNumForVehicle( vehicle )
	entity attacker = DamageInfo_GetAttacker( di )
	if ( IsValid( attacker ) && IsFriendlyTeam( attacker.GetTeam(), vehTeam ) )
	{
		DamageInfo_SetDamage( di, 0 )
		return
	}
	entity inflictor = DamageInfo_GetInflictor( di )
	if ( IsValid( inflictor ) && IsFriendlyTeam( inflictor.GetTeam(), vehTeam ) )
	{
		DamageInfo_SetDamage( di, 0 )
		return
	}

                            
                                         
  
                                                     
   
                                
         
   

                                
                                                             
                                                                         
    
                                 
          
    
        

  
     
      
	{
		DamageInfo_SetDamage( di, (originalDamage * GetCurrentPlaylistVarFloat( "hover_vehicle_damage_scale", 0.0 )) )

		array<entity> players = HoverVehicle_GetExtendedPlayerArray( vehicle )
		if ( players.len() == 0 )
			return

		//
		float occupentDamage
		if ( IsValid( attacker ) && attacker.IsNPC() && !(attacker.IsNonCombatAI() || attacker.GetClassName() == "npc_dummie") )
		{
			occupentDamage = (originalDamage * GetCurrentPlaylistVarFloat( "hover_vehicle_npc_damage_scale_passengers", 0.50 ))
		}
		else
		{
			occupentDamage = (originalDamage * GetCurrentPlaylistVarFloat( "hover_vehicle_damage_scale_passengers", 0.20 ))
			//fix for R5DEV-323573 - Maggie's Drill does not deal enough damage to the Vehicle to damage occupants
			//could standardize this for all damage incoming to the Vehicle, but unsure of fallout at the moment
			if ( DamageInfo_GetDamageSourceIdentifier( di ) == eDamageSourceId.mp_weapon_concussive_breach )
				occupentDamage = max( occupentDamage, 1.0 )
		}

		table dmgParams = GetDamageTableFromInfo( di )
		thread function() : (players, occupentDamage, attacker, inflictor, dmgParams)
		{
			WaitEndFrame()
			if ( !IsValid( attacker ) )
				return

			foreach ( player in players )
			{
				if ( !IsAlive( player ) )
					continue
				player.TakeDamage( occupentDamage, attacker, inflictor, dmgParams )
			}
		}()
	}
}

                            
                                                                         
 
                                                        
                                                         

                           
        

                            
        

                             
        

                                                           
                                                                            
        
                                                                              
        

                                                               
                                                     
                   
        

                                                            

                                                                     
  
                         
                                                            

                                                                                                                                 
                                                                                               
                                                                                                                               
  
 
      

array<entity> function GetHoverVehicleArrayEx( vector center, float radius )
{
	array<entity> result
	float radiusSquared = radius * radius
	foreach( vehicle in file.vehicleArray )
	{
		if ( !IsValid( vehicle ) )
			continue

		vector diff = vehicle.GetOrigin() - center
		if ( LengthSqr( diff ) <= radiusSquared )
			result.append( vehicle )
	}

	return result
}
