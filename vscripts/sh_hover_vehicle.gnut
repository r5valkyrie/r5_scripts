entity function GetClosestVehicle( vector origin )
{
	array<entity> vehicles = clone( file.vehicleArray )
	if ( vehicles.len() == 0 )
		return null

	vehicles.sort( int function( entity aa, entity bb ) : (origin)
	{
		float aaDist = DistanceSqr( aa.GetOrigin(), origin )
		float bbDist = DistanceSqr( bb.GetOrigin(), origin )
		if ( aaDist < bbDist )
			return -1
		if ( aaDist > bbDist )
			return 1
		return 0
	} )
	return vehicles[0]
}

