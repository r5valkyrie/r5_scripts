void function EjectAllFromVehicle( entity vehicle, int ejectMode )
{
	float ejectVelocityScale = 0.0
	float ejectVelocityUp = 0.0
	float ejectVelocityFromCenter = 0.0
	float ejectZOffset = 0.0
	switch( ejectMode )
	{
		case eHOVER_VEHICLE_EJECT_MODE.Skydive:
			ejectVelocityScale = 0.20
			ejectVelocityUp = 2500.0
			ejectZOffset = 300.0
			break
                            
                                           
                            
                          
                                  
                      
        
      
                 
                                          
                            
                          
                      
        
      
		default:
			Assert(false, "Invalid Eject Mode")
			return
	}

	vector vehicleOrigin = vehicle.GetOrigin()
	vector baseVel = (vehicle.GetVehicleVelocity() * ejectVelocityScale)
	vector ejectVelocity = <baseVel.x, baseVel.y, (max( baseVel.z, 0.0 ) + ejectVelocityUp)>
	float ejectZ = (vehicleOrigin.z + ejectZOffset)

	entity driver = vehicle.VehicleGetDriver()
	if ( IsValid( driver ) )
		vehicle.VehiclePlayReliableSoundOnEntityForOccupants( driver, HOVER_VEHICLE_EJECT_SOUND )

	array<entity> playersInVehicle = HoverVehicle_GetExtendedPlayerArray( vehicle )
	foreach( entity player in playersInVehicle )
	{
		if ( IsValid( player ) && !player.IsMarkedForDeletion() )
		{
			vector playerOrigin = player.GetOrigin()

			Vehicle_KickPlayer_ForAutoEject( player )

			vector ejectPosition = <playerOrigin.x, playerOrigin.y, ejectZ>
			vector playerEjectVelocity = ejectVelocity
                               
                                                           
     
                                                                                                
                                                                                

                                                                                       
     
         

			player.SetVelocity( ejectVelocity )

			if ( ejectMode == eHOVER_VEHICLE_EJECT_MODE.Skydive )
			{
				vector lowestTracePosition = < playerOrigin.x, playerOrigin.y, -MAP_EXTENTS >
				array< entity > ignoreEnts = [ vehicle ]
				ignoreEnts.extend( playersInVehicle )

				// Check if the trident blew up in mid air with nothing below it, if so overwrite the PutPlayerInSafeSpot call in code so the player
				// doesn't teleport to the nearest navmesh location and just gets shot upwards at the trident's location
				TraceResults checkForGroundTrace = TraceLine( ejectPosition, lowestTracePosition, ignoreEnts, TRACE_MASK_PLAYERSOLID, TRACE_COLLISION_GROUP_NONE )
				if ( !( checkForGroundTrace.startSolid ) && ( checkForGroundTrace.fraction >= 1.0 || checkForGroundTrace.hitSky ) )
				{
					player.ClearParent()
					player.SetAbsOrigin( playerOrigin )
				}

				HolsterAndDisableWeapons( player )

				entity fxEjectTrail = StartParticleEffectOnEntity_ReturnEntity( player, GetParticleSystemIndex( FX_VEHICLE_EJECT_PILOT_TRAILS ), FX_PATTACH_POINT_FOLLOW, player.LookupAttachment( "CHESTFOCUS" ) )
				//fxEjectTrail.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY | ENTITY_VISIBLE_TO_ENEMY
				fxEjectTrail.SetOwner( player )

				Remote_CallFunction_Replay( player, "SCB_EjectedFromHoverVehicleForSeldDestruct" )
				// skydive at zenith:
				thread function() : (player, fxEjectTrail )
				{
					const float Z_THRESHOLD = 500.0
					player.EndSignal( "OnDeath" )

					table<string, bool> myVars
					OnThreadEnd( function() : (player, myVars)
					{
						if ( IsValid( player ) && (myVars["didReEnable"] == false) )
							DeployAndEnableWeapons( player )
					} )
					myVars["didReEnable"] <- false

					for ( ;; )
					{
						WaitFrame()
						if ( player.GetVelocity().z < Z_THRESHOLD )
						{
							if ( IsValid( fxEjectTrail ) )
							{
								fxEjectTrail.ClearParent()
								EffectStop( fxEjectTrail )
							}
							break
						}
					}

					if ( Bleedout_IsBleedingOut( player ) )
						return
					if ( player.IsGrappleAttached() ||  player.IsZiplining() )
						return

					DeployAndEnableWeapons( player )
					myVars["didReEnable"] = true
					                        
						Control_PrintSkydiveDebug( player, " EjectAllFromVehicle going to trigger PlayerSkydiveFromCurrentPositionWithInitVelocity" )
                                   
					PlayerSkydiveFromCurrentPositionWithInitVelocity( player, player.GetVelocity() )
				}()
			}
		}
	}
}

table<entity, float> s_mapPlayerKickTimes
float function GetLatestKickTimeForPlayer( entity player )
{
	if ( !(player in s_mapPlayerKickTimes) )
		s_mapPlayerKickTimes[player] <- 0.0
	return s_mapPlayerKickTimes[player]
}
void function SetLatestKickTimeForPlayerToNow( entity player )
{
	if ( !(player in s_mapPlayerKickTimes) )
		s_mapPlayerKickTimes[player] <- 0.0
	s_mapPlayerKickTimes[player] = Time()
}
bool function HoverVehicle_IsPlayerInAnyVehicleOrRecentlyKicked( entity player )
{
	if ( HoverVehicle_IsPlayerInAnyVehicle( player ) )
		return true

	float delta = (Time() - GetLatestKickTimeForPlayer( player ))
	if ( delta < 1.0 )
		return true

	return false
}

bool function HoverVehicle_IsAnyPlayerOnVehicle( entity vehicle )
{
	array<entity> players = GetPlayerArray()
	foreach( player in players )
	{
		if( player.GetGroundEntity() == vehicle )
			return true
	}

	return false
}

void function Vehicle_KickPlayer_( entity player, int vehicleInteractLeaveReason )
{
	if ( !IsValid( player ) )
		return
	if ( !player.IsPlayer() )
		return
	entity vehicle = GetValidParentOrGrandparentHoverVehicle( player )
	if ( !IsValid( vehicle ) )
		return

	SetLatestKickTimeForPlayerToNow( player )
	//PIN_VehicleInteractLeave( player, vehicle, vehicleInteractLeaveReason )

	entity parentEnt = player.GetParent()
	//if ( parentEnt.IsTurretEnt() )
	//{
	//	parentEnt.ClearDriver()
	//	return
	//}

	//vehicle.HoverVehicle_RemovePlayerImmediate( player )
}
void function Vehicle_KickPlayer_ForOtherReason( entity player )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.OTHER )
}
void function Vehicle_KickPlayer_OnPlayerKilled( entity player, entity attacker, var damageInfo )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.KILLED )
}
void function Vehicle_KickPlayer_ForAutoEject( entity player )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.EJECTED )
}
void function Vehicle_KickPlayer_ForAbility( entity player )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.ABILITY )
}
void function Vehicle_KickPlayer_ForKilled( entity player )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.KILLED )
}
void function Vehicle_KickPlayer_ForBleedout( entity player )
{
	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.BLEEDOUT )
}

void function OnPlayerBleedoutStateChanged( entity player, int newState )
{
	if ( newState != BS_ENTERING_BLEEDOUT )
		return
	if ( !IsValid( player ) )
		return

	Vehicle_KickPlayer_( player, ePINVehicleInteractLeaveReason.BLEEDOUT )
}

int function GetVehicleLeaveReasonForTurret( int turretClearUserReason )
{
	switch ( turretClearUserReason )
	{
		case eTurretClearUserReason.TURRET_USE_FINISHED:
			return ePINVehicleInteractLeaveReason.VOLUNTARY
		case eTurretClearUserReason.TURRET_DESTROYED:
			return ePINVehicleInteractLeaveReason.TURRET_DESTROYED
		case eTurretClearUserReason.TURRET_DISABLED:
			return ePINVehicleInteractLeaveReason.TURRET_DISABLED
		case eTurretClearUserReason.DEPLOYTHREADFINISHED:
			return ePINVehicleInteractLeaveReason.TURRET_OTHER
	}

	Assert( turretClearUserReason == eTurretClearUserReason.OTHERREASON )
	return ePINVehicleInteractLeaveReason.TURRET_OTHER
}
void function Vehicle_KickPlayer_ForTurret( entity player, int turretClearUserReason )
{
	Vehicle_KickPlayer_( player, GetVehicleLeaveReasonForTurret( turretClearUserReason ) )
}

void function UpdateVehicleTeam( entity vehicle )
{
	int newTeam = GetEffectiveTeamNumForVehicle( vehicle )
	if( newTeam != vehicle.GetTeam() )
	{
		SetTeam( vehicle, newTeam )

		array<entity> players = GetPlayerArray()
		foreach ( clPlayer in players )
			Remote_CallFunction_Replay( clPlayer, "ServerCallback_VehicleOccupancyChange", vehicle )
	}
}
#endif







