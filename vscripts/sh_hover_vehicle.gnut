	return results
}


#if SERVER
void function CodeCallback_EmbarkVehicleStart( entity player, entity vehicle )
{
	UpdateVehicleTeam( vehicle )

	if ( !AllianceProximity_IsUsingAlliances() )
	{
		Highlight_ClearNeutralHighlight( vehicle )
	}

	Signal( player, SIG_VEHICLE_EMBARK_BEGIN )
	if ( vehicle.VehicleIsDriver( player ) )
	{
		if ( vehicle.VehicleGetPlayerCount() == 1 )
			delaythread( RandomFloatRange( 0.75, 1.25 ) ) TryPlayVehicleDialogue( player, "bc_tridentEnter" )
		else
			delaythread( RandomFloatRange( 0.75, 1.25 ) ) TryPlayVehicleDialogue( player, "bc_tridentEnter_Solo", null, true )

		thread PROTO_FadeModelIntensityOverTime( vehicle, 1.0, 0, 1)
	}
	else
	{
		entity driver = vehicle.VehicleGetDriver()
		if ( IsValid( driver ) && player != driver )
			delaythread( RandomFloatRange( 0.15, 0.65 ) ) TryPlayVehicleDialogue( player, "bc_tridentJoin", driver )
	}

	HoverVehicle_KeepStatsUpdatedForOccupant( player, vehicle )
}

void function TryPlayVehicleDialogue( entity player, string bcLine, entity driver = null, bool solo = false )
{
	if ( ! ( player in file.playerLastSaidVehicleLineTime ) )
	{
		table< string, float > curLineTime
		curLineTime[bcLine] <- 0.0
		file.playerLastSaidVehicleLineTime[player] <- curLineTime
	}
	else if ( ! ( bcLine in file.playerLastSaidVehicleLineTime[ player ] ) )
	{
		file.playerLastSaidVehicleLineTime[player][bcLine] <- 0.0
	}

	if ( Time() - file.playerLastSaidVehicleLineTime[player][bcLine] > VEHICLE_DIALOGUE_DEBOUNCE_TIME )
	{
		if ( solo )
			PlayBattleChatterLineToPlayer( bcLine, player, player )
		else
			PlayBattleChatterLineToSpeakerAndTeam( player, bcLine, driver )

		file.playerLastSaidVehicleLineTime[player][bcLine] <- Time()
	}
}

void function CodeCallback_EmbarkVehicleFinished( entity player, entity vehicle )
{
	if ( vehicle.VehicleIsDriver( player ) )
	{
		entity turretOperator = HoverVehicle_GetTurretOperator( vehicle )
		if (turretOperator != null && turretOperator.GetTeam() != player.GetTeam()) //Fix for R5DEV-405405
		{
			if ( IsValid( turretOperator ) )
			{
				vehicle.VehiclePlayReliableSoundOnEntityForOccupants( vehicle, HOVER_VEHICLE_EJECT_SOUND )

				Vehicle_KickPlayer_ForAutoEject ( turretOperator )
				Vehicle_KickPlayer_ForAutoEject ( player )
			}
		}

		Signal( vehicle, SIG_DRIVER_EMBARK_FINISHED )
	}
}

struct VehicleLocalStatsForPlayer
{
	float embarkTime
	float distanceTraveled
}
struct VehicleLocalStats
{
	table<entity, VehicleLocalStatsForPlayer> mapPlayersToStats
}
table<entity, VehicleLocalStats> s_mapVehiclesToLocalStats

VehicleLocalStatsForPlayer function GetLocalStatsForPlayerOnVehicle( entity player, entity vehicle )
{
	Assert( player.IsPlayer() )
	Assert( EntIsHoverVehicle( vehicle ) )

	if ( !(vehicle in s_mapVehiclesToLocalStats) )
	{
		VehicleLocalStats newStats
		s_mapVehiclesToLocalStats[vehicle] <- newStats
	}
	VehicleLocalStats vehStats = s_mapVehiclesToLocalStats[vehicle]

	if ( !( player in vehStats.mapPlayersToStats ) )
	{
		VehicleLocalStatsForPlayer newStats
		vehStats.mapPlayersToStats[player] <- newStats
	}
	VehicleLocalStatsForPlayer stats = vehStats.mapPlayersToStats[player]
	return stats
}

bool function PlayerHasLocalStatsForVehicle( entity player, entity vehicle )
{
	Assert( player.IsPlayer() )
	Assert( EntIsHoverVehicle( vehicle ) )

	if ( !(vehicle in s_mapVehiclesToLocalStats) )
		return false
	VehicleLocalStats vehStats = s_mapVehiclesToLocalStats[vehicle]
	if ( !( player in vehStats.mapPlayersToStats ) )
		return false

	return true
}

float function HoverVehicle_GetOccupantTimeOnVehicle( entity player, entity vehicle )
{
	if ( !PlayerHasLocalStatsForVehicle( player, vehicle ) )
		return 0.0

	VehicleLocalStatsForPlayer localStats = GetLocalStatsForPlayerOnVehicle( player, vehicle )
	return (Time() - localStats.embarkTime)
}

float function HoverVehicle_GetOccupantDistanceTraveled( entity player, entity vehicle )
{
	if ( !PlayerHasLocalStatsForVehicle( player, vehicle ) )
		return 0.0

	VehicleLocalStatsForPlayer localStats = GetLocalStatsForPlayerOnVehicle( player, vehicle )
	return localStats.distanceTraveled
}

void function HoverVehicle_KeepStatsUpdatedForOccupant( entity player, entity vehicle )
{
	Signal( player, SIG_HOVERVEHICLE_OCCUPANT_STATS_STARTED )

	thread function() : (player, vehicle)
	{
		const float MINIMUM_UPDATE_DELTA = 5000.0

		EndSignal( player, SIG_HOVERVEHICLE_OCCUPANT_STATS_STARTED )
		EndSignal( player, SIG_VEHICLE_EMBARK_BEGIN )
		EndSignal( player, "OnDeath" )
		EndSignal( vehicle, "OnDestroy" )

		VehicleLocalStatsForPlayer localStats = GetLocalStatsForPlayerOnVehicle( player, vehicle )
		localStats.embarkTime = Time()
		localStats.distanceTraveled = 0

		//PIN_VehicleInteractEnter( player, vehicle )

		vector lastPos = vehicle.GetOrigin()
		for( ;; )
		{
			if ( HoverVehicle_GetVehicleOccupiedByPlayer( player ) != vehicle )
				break

			vector newPos = vehicle.GetOrigin()
			float dist = Length2D( newPos - lastPos )
			if ( dist >= MINIMUM_UPDATE_DELTA )
			{
				localStats.distanceTraveled += dist
				StatsHook_HoverVehicle_OnDistanceTraveledAsOccupant( player, dist )
				lastPos = newPos
			}

			wait RandomFloatRange( 5.0, 6.0 )
		}
	}()
}

