bool function HoverVehicle_IsHostileToTeam( entity vehicle, int teamNum )
{
	foreach( entity player in HoverVehicle_GetExtendedPlayerArray( vehicle ) )
	{
		if ( IsEnemyTeam( player.GetTeam(), teamNum ) )
			return true
	}
	return false
}

