#if SERVER
void function UpgradePlayerXPPersistentData( entity player, int oldVersion, int newVersion )
{
	if ( oldVersion == 0 )
	{
		player.SetPersistentVar( "xp", 0 )
		player.SetPersistentVar( "previousXP", 0 )
		player.SetPersistentVar( "gen", 1 )
		player.XPChanged()
	}
}
