#if SERVER
// Determine if the player should be respawned
// Allow other modes to use their own criteria to determine this through a callback function
bool function ShouldRespawnPlayer( entity player )
{
	bool shouldRespawnPlayer = false

	if ( file.ShouldRespawnPlayer_Callback != null )
	{
		shouldRespawnPlayer = file.ShouldRespawnPlayer_Callback( player )
	}
	else
	{
		int deathFieldStage = SURVIVAL_GetCurrentDeathFieldStage()

		if ( !IsSpawnNearSquadActive() && GetRespawnShouldCheckSquadActive() )
		{
			player.SetPlayerNetInt( "respawnsRemaining", 0 )
			player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.PLAYER_ELIMINATED )
			return shouldRespawnPlayer
		}

		if ( !IsTeamAlive( player.GetTeam() ) && IsEliminationBased() )
		{
			player.SetPlayerNetInt( "respawnsRemaining", 0 )
			return shouldRespawnPlayer
		}

		                                                           
			if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) && AreTeammatesShadowZombies( player ) )
				return shouldRespawnPlayer
        

		int numRespawnsForMode = GetStartingRespawnCount() //-1 = infinite respawns
		if ( numRespawnsForMode == -1 )
		{
			player.SetPlayerNetInt( "respawnsRemaining", -1 )
			shouldRespawnPlayer = true
		}
		else if ( GetTotalNumberOfDeaths( player ) > ( numRespawnsForMode - 1 ) )
		{
			player.SetPlayerNetInt( "respawnsRemaining", 0 )
			player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.PLAYER_ELIMINATED )
			return shouldRespawnPlayer
		}
		else
		{
			player.SetPlayerNetInt( "respawnsRemaining", ( numRespawnsForMode - GetTotalNumberOfDeaths( player ) ) - 1 )
			shouldRespawnPlayer = true
		}
	}

	return shouldRespawnPlayer
}
#endif // SERVER

#if SERVER
// Allow other modes to set different functions to check if a player is ready to respawn
void function RespawnNearSquad_SetCallback_CanRespawnPlayer( bool functionref( entity ) func )
{
	Assert( file.ShouldRespawnPlayer_Callback == null )
	file.ShouldRespawnPlayer_Callback = func
}
#endif //SERVER

#if SERVER
void function SetupPlayerForSpawnNearSquad( entity player )
{
	if ( ShouldRespawnPlayer( player ) )
	{
		player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.WAITING_FOR_RESPAWN )
		thread PlayerSpawnsNearSquadAfterDelay( player )
	}
}
#endif // SERVER

#if SERVER
void function OnSquadEliminated( int team )
{
	foreach ( entity player in GetPlayerArrayOfTeam( team ) )
		player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.SQUAD_ELIMINATED )
}
#endif // SERVER

