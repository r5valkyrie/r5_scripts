	global function RespawnNearSquad_GetMinDistFromFriendlyForValidSpawn
	global function RespawnNearSquad_GetMaxDistFromFriendlyForValidSpawn
	global function RespawnNearSquad_GetMinDistFromEnemyForValidSpawn
	global function RespawnNearSquad_GetMaxDistFromEnemyForValidSpawn

