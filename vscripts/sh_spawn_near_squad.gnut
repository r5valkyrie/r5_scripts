#if SERVER
float function GetSpawnNearSquadCoolDown( entity player )
{
	if ( !IsValid( player ) )
		return 0

	if ( file.GetSpawnDelay_Callback != null )
		return file.GetSpawnDelay_Callback( player )

	int playerDeaths = GetTotalNumberOfDeaths( player )

	float baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown", 5.0 )
	float maxCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_max", 60 )
	float cooldownMultiplier = GetCurrentPlaylistVarFloat( "respawn_cooldown_perPlayerDeath", 5 )
	float additionalCooldown = 0

	int deathFieldStage = SURVIVAL_GetCurrentDeathFieldStage()

	if ( deathFieldStage < 1 )
		baseCooldown = baseCooldown

	// Increase cooldown depending on round
	if ( deathFieldStage == 1 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_1", baseCooldown )

	if ( deathFieldStage == 2 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_2", baseCooldown )

	if ( deathFieldStage == 3 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_3", baseCooldown )

	if ( deathFieldStage == 4 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_4", baseCooldown )

	if ( deathFieldStage == 5 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_5", baseCooldown )

	if ( deathFieldStage == 6 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_6", baseCooldown )

	if ( deathFieldStage == 7 )
		baseCooldown = GetCurrentPlaylistVarFloat( "respawn_cooldown_deathfield_7", baseCooldown )

	//increase cooldown based on player deaths so far
	if ( playerDeaths > 1 && cooldownMultiplier > 0 )
		additionalCooldown =  ( playerDeaths * cooldownMultiplier )

	if ( additionalCooldown > 0 )
		baseCooldown = ( baseCooldown + additionalCooldown )

	//dont allow cooldown to be ridiculous (if player has died a ton, cap it)
	if ( baseCooldown > maxCooldown )
		baseCooldown = maxCooldown


	return baseCooldown
}
#endif // SERVER

