#if SERVER
void function OnDeathFieldStartShrink( table<int,DeathFieldData> deathFieldData )
{
	UpdateMapSpawnPoints()

	// No more respawns in final stages
	if ( !IsSpawnNearSquadActive() )
		return

	int deathFieldStage = SURVIVAL_GetCurrentDeathFieldStage()
	if ( deathFieldStage == GetSpawnNearSquadEndingStage() || SURVIVAL_IsFinalDeathFieldStage() )
		file.isSpawnNearSquadActive = false
}
#endif //SERVER

#if SERVER
int function GetSpawnNearSquadEndingStage()
{
	return GetCurrentPlaylistVarInt( "respawn_round_to_stop", CIRCLE_STAGE_TO_STOP_RESPAWNS )
}
#endif //SERVER

