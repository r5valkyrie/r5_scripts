#if SERVER
void function InitMapSpawnPoints()
{
	//////////////////////////////////////////////////////////////////
	// generate a collection of spawns from loot and lootbin locations,
	// respawn beacons and manually placed resource_infantryspawns
	//////////////////////////////////////////////////////////////////

	AssertIsNewThread()
	Assert( file.spawnPoints.len() == 0, "Can only initialize spawnpoints once at the start of the match" )

	array <Point> spawnPoints
	float minDistFromOtherSpawns = 256

	//////////////////////////////////
	// spawnpoints - manually placed
	//////////////////////////////////

	//pilot spawn ents, info_spawnpoint_human, etc
	//NOTE: these aren't very useful in most maps as they are often just clumped together in one spot
	if( GetUseManuallyPlacedSpawnPoints() )
	{
		array<entity> spawnPointEntities = SpawnPoints_GetPilot()
		foreach ( ent in spawnPointEntities )
		{
			Point newPoint
			newPoint.origin = ent.GetOrigin()
			newPoint.angles = ent.GetAngles()
			spawnPoints.append( newPoint )
		}
	}

	//////////////////////////////////////
	// spawnpoints - pos in front of lootbins
	//////////////////////////////////////
	vector verticalOffset = <0, 0, 512>
	foreach ( bin in GetAllLootBins() )
	{
		Point spawnPoint
		spawnPoint.origin = PositionOffsetFromEnt( bin, 64, 0, 24 )
		spawnPoint.angles = <0, bin.GetAngles().y, 0>
		spawnPoints.append( spawnPoint )
	}

	/////////////////////////////////////////////////
	// spawnpoints - pos on respawn beacon locations
	//////////////////////////////////////////////////
	foreach( org in GetRespawnBeaconLocations() )
	{
		Point spawnPoint
		spawnPoint.origin = PositionOffsetFromOriginAngles( org, <0, 0, 0>, 0, 0, 96 )
		spawnPoint.angles = <0, 0, 0>
		spawnPoints.append( spawnPoint )
	}

	///////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Store off spawnpoints while remaining ones are built (from loot and script-only resources placed in LevelEd
	////////////////////////////////////////////////////////////////////////////////////////////////////////////
	file.spawnPoints = clone spawnPoints
	file.spawnPointsPets = clone spawnPoints

	/////////////////////////////////////////////////////////
	// spawnpoints - script-only resources placed in LevelEd
	//////////////////////////////////////////////////////////
	FlagWait( "ResourceSystemReady" )

	//these are efficient as they are zero entity count and can place as many as you need for large maps

	//grab the resource_group node(s) with this keyword targets all the resource_infantryspawnss we want
	array<ResourceGroup> resourceGroupsGamemodeSpawners = ORS_GetGroupsWithMatchingKeywords( ORS_GetGlobalGroup(), [ "spawners_generic" ] )
	array <InfantrySpawn> infantrySpawns = ORS_GetInfantrySpawnsFromGroups( resourceGroupsGamemodeSpawners )
	foreach( spawner in infantrySpawns )
	{
		Point newPoint
		newPoint.origin = spawner.core.spawnOrigin
		newPoint.angles = spawner.core.spawnAngles
		spawnPoints.append( newPoint )
	}

	//store off spawnpoints again while ground loot spawns (since it's slow as balls)
	file.spawnPoints = clone spawnPoints
	file.spawnPointsPets = clone spawnPoints

	////////////////////////////////////////////////////////////////
	// spawnpoints - ambient loot locations
	///////////////////////////////////////////////////////////////

	foreach( group, spawnList in SURVIVAL_GetGroupLootSpawnLocations() )
	{
		foreach( spawnPoint in spawnList )
		{
			if ( spawnPoint.bin )
			{
				//printf( "SPAWN NEAR SQUAD: " + spawnPoint.pos + " is actually a bin, skipping" )
				continue
			}

			vector org = spawnPoint.pos

			if ( SURVIVAL_GetMovingGeoLootOriginalLocations().contains( org ) )
				continue

			org = OriginToGround( spawnPoint.pos + <0, 0, 16> ) + <0, 0, 24>

			//Check in solid
			org = DropSpawnToFloor( org, HULL_HUMAN )
			if ( org == INVALID_DROP_RESULT )
			{
				//printf( "SPAWN NEAR SQUAD: " + org + " invalid drop result, skipping" )
				continue
			}

			//in leviathan feet, etc
			if ( IsOriginInNoSpawnArea( org, TEAM_ANY ) )
			{
				//printf( "SPAWN NEAR SQUAD: " + org + " in no spawn area, skipping" )
				continue
			}

			Point newPoint
			newPoint.origin = org

			//disregard if we're getting too clumped with other points
			if ( spawnPoints.len() > 0 && PointWithinDistOfAnyPoint( newPoint, spawnPoints, minDistFromOtherSpawns ) )
			{
				//printf( "SPAWN NEAR SQUAD: " + org + " too close to other spawns, skipping" )
				continue
			}


			if ( GetCurrentPlaylistVarBool( "respawn_spawnpoints_calculate_angles", false ) == true )
			{
				//use lifeline's shield check to get decent spawn angles for surrounding space
				WaitFrame() //generating good angles prob bad to do all on same frame
				vector ornull angles = GetBestShieldDeployAngles( org, <0, 0, 0> )
				if ( angles == null )
					continue

				newPoint.angles = expect vector( angles )
			}
			else
			{
				newPoint.angles = <0, 0, 0>
			}

			//All good, add it to the group
			spawnPoints.append( newPoint )
		}
	}

	FlagWait( "DeathFieldCalculationComplete" )


	////////////////////////////////////
	// Final in-solid check to be safe
	//////////////////////////////////////
	array<Point> spawnPointsVetted
	vector mins = GetBoundsMin( HULL_HUMAN )
	vector maxs = GetBoundsMax( HULL_HUMAN )
	int solidMask            = TRACE_MASK_PLAYERSOLID
	int collisionGroup       = TRACE_COLLISION_GROUP_PLAYER

	foreach( point in spawnPoints )
	{
		TraceResults result
		result = TraceHull( point.origin, point.origin + <0, 0, 1>, mins, maxs, [], solidMask, collisionGroup )

		if ( result.startSolid )
			continue

		spawnPointsVetted.append( point )
	}
	Assert( spawnPointsVetted.len() > 0 )
	spawnPointsVetted.randomize()

	file.spawnPoints = spawnPointsVetted

	if ( GetCurrentPlaylistVarBool( "squad_pet_use_all_spawnpoints", true ) )
		file.spawnPointsPets = spawnPointsVetted

	#if DEVELOPER
		//thread DEV_DrawSpawnNearSquadLocations()
	#endif
}
#endif // SERVER

#if SERVER
void function UpdateMapSpawnPoints()
{
	//exclude ones outside circle, etc
	array <Point> spawnPointsInsideCircle
	float minDistFromFrontier
	foreach ( Point point in file.spawnPoints  )
	{
		//outside circle
		if ( SURVIVAL_GetDistanceInsideDeathField( Survival_Loot_GetDefaultRealm(), point.origin ) < MIN_SPAWN_DIST_FROM_RING )
			continue

		spawnPointsInsideCircle.append( point )
	}

	file.spawnPoints = spawnPointsInsideCircle

	if ( GetCurrentPlaylistVarBool( "squad_pet_use_all_spawnpoints", true ) )
		file.spawnPointsPets = spawnPointsInsideCircle

}
#endif // SERVER


