#if SERVER
void function PlayerSpawnsNearSquadAfterDelay( entity player )
{
	if ( !IsValid( player ) )
		return

	player.EndSignal( "OnDestroy" )

	float respawnCooldown = GetSpawnNearSquadCoolDown( player )
	float respawnStatusEndTime = Time() + respawnCooldown
	player.SetPlayerNetTime( "respawnStatusEndTime", respawnStatusEndTime )
	player.SetPlayerNetTime( "hackStartTime", Time() )
	WaitFrame()

	if ( !IsValid( player ) )
		return

	if ( Bleedout_IsBleedingOut( player ) )
	{
		//Temp hack till permanent fix for R5DEV-157040
		Bleedout_ForceStop( player )
		BleedoutState_SetPlayerBleedoutState( player, BS_NOT_BLEEDING_OUT )
	}

	Remote_CallFunction_NonReplay( player, "ServerCallback_RespawnPodStarted", respawnStatusEndTime )

	wait respawnCooldown

	if ( GetCurrentPlaylistVarBool( "respawn_queue_active", true ) )
	{
		float timeout = GetCurrentPlaylistVarFloat( "respawn_wait_for_queue_timeout", 1.0 )
		waitthread WaitTillSpawnQueueFree( timeout )
	}

	// In modes that allow changing characters between spawns, wait to respawn until a character is selected
	waitthread _WaitForCharacterReselect( player )

	if ( !IsValid( player ) )
		return

	if ( !IsTeamAlive( player.GetTeam() ) && IsEliminationBased() )
		return

	if ( GetGameState() != eGameState.Playing )
		return

	vector deathPos = player.p.deathOrigin

	DoCommonRespawnForPlayer( player )
	player.p.respawnPodLanded = false // this is weird but necessary
	player.SetPlayerNetInt( "respawnStatus", eRespawnStatus.NONE )
	PlayerMatchState_Set( player, ePlayerMatchState.NORMAL )

	player.Signal( "SpawnNearSquad_PlayerRespawned" )

	vector posToSpawnOn = deathPos
	bool shouldOverrideBestTeammateSelection = false
	bool shouldSpawnOnVehicleIfPossible = false
	Point spawnPoint
	entity vehicle

	if ( shouldSpawnOnVehicleIfPossible )
	{
		if ( IsValid( vehicle )
			 && VehicleHasRoomForNormalOccupants( vehicle )
			 && !HoverVehicle_IsHostileToTeam( vehicle, player.GetTeam() )
			 && !HoverVehicle_IsPlayerInAnyVehicleOrRecentlyKicked( player ))
			//vehicle.HoverVehicle_AddPlayerImmediate( player, false )

		WaitFrame()

		if ( HoverVehicle_IsPlayerInAnyVehicle( player ) )
			return
	}

	// the above DoCommonRespawnForPlayer call should have respawned the player at a manually place
	// spawn point - if they exist, so we don't want to overwrite the position if we want the best manual location
	vector spawnOrigin = player.GetOrigin()
	if( !GetUseManuallyPlacedSpawnPoints() )
	{
		if ( file.GetBestAvailablePlayerRespawnPoint_Callback != null )
			spawnPoint = file.GetBestAvailablePlayerRespawnPoint_Callback( player, posToSpawnOn, shouldOverrideBestTeammateSelection )
		else
			spawnPoint = GetBestAvailablePlayerRespawnPoint( player, posToSpawnOn, shouldOverrideBestTeammateSelection )

		printf( "RespawnNearSquad: Attempting to spawn player at " + spawnPoint.origin )

		if ( spawnPoint.origin != <0, 0, 0> )
		{
			//////////////////////////////////////
			// Respawn at vetted ground position
			//////////////////////////////////////
			spawnOrigin = spawnPoint.origin
			PutPlayerInSafeSpot( player, null, null, spawnOrigin, spawnOrigin )
			player.SetAbsAngles( spawnPoint.angles )
		}
		else
		{
			/////////////////////////////////////////////////////////////
			// Failsafe skydive at circle edge if no decent respawn found
			/////////////////////////////////////////////////////////////

			Point skydiveSpawnPoint = GetSkydiveSpawnNearSquad( player )
			spawnOrigin = skydiveSpawnPoint.origin
			player.SetOrigin( skydiveSpawnPoint.origin )
			player.SetAbsAngles( skydiveSpawnPoint.angles )
			                        
				Control_PrintSkydiveDebug( player, " PlayerSpawnsNearSquadAfterDelay going to trigger PlayerSkydiveFromCurrentPosition" )
                                 
			PlayerSkydiveFromCurrentPosition( player )
		}
	}

	ScreenFadeFromBlack( player, 1.0, 0.5 )

	if ( !SURVIVAL_PosInsideDeathField( Survival_Loot_GetDefaultRealm(), spawnOrigin ) )
		Warning( "%s() - Respawn point outside deathfield: %s", FUNC_NAME(), VectorToString( spawnOrigin ) )

	if ( ShouldPlayRespawnBattlechatter( player ) )
		PlayBattleChatterLineToSpeakerAndTeam( player, "bc_returnFromRespawn" )
}
#endif // SERVER

#if SERVER
bool function ShouldPlayRespawnBattlechatter( entity player )
{
	                              
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
			return false
       

	return true
}
#endif // SERVER

#if SERVER
Point function GetSkydiveSpawnNearSquad( entity player )
{
	vector center = SURVIVAL_GetSafeZoneCenter( Survival_GetPlayerRealm( player ) )
	Assert( -MAX_WORLD_COORD_BUFFER < center.x && center.x < MAX_WORLD_COORD_BUFFER, "Center should be in world coord. center.x: " + center.x )
	Assert( -MAX_WORLD_COORD_BUFFER < center.y && center.y < MAX_WORLD_COORD_BUFFER, "Center should be in world coord. center.y: " + center.y )

	float skydiveHeight = SURVIVAL_GetPlaneHeight()
	float radius
	int deathFieldStage = SURVIVAL_GetCurrentDeathFieldStage()
	if ( deathFieldStage < 0 )
		radius = 10000
	else
		radius = SURVIVAL_GetSafeZoneRadius( Survival_Loot_GetDefaultRealm() )

	radius = max( 0, ( radius - 256 ) ) //don't want to be right at the edge of the circle

	// reduce radius if the circle is out of world coord
	if ( center.x + radius > MAX_WORLD_COORD_BUFFER )
		radius = MAX_WORLD_COORD_BUFFER - center.x
	if ( center.x - radius < -MAX_WORLD_COORD_BUFFER )
		radius = MAX_WORLD_COORD_BUFFER + center.x
	if ( center.y + radius > MAX_WORLD_COORD_BUFFER )
		radius = MAX_WORLD_COORD_BUFFER - center.y
	if ( center.y - radius < -MAX_WORLD_COORD_BUFFER )
		radius = MAX_WORLD_COORD_BUFFER + center.y

	Assert( radius > 0, "Spawn radius is 0 or smaller" )

	array<vector> spawnCandidates = GetPointsOnCircle( center + < 0, 0, skydiveHeight>, <0,0,0>, radius, 64 )
	array<entity> teamMates = GetPlayerArrayOfTeam_AliveConnected( player.GetTeam() )
	vector skydivePos = <0, 0, 0>
	if ( teamMates.len() > 1 )
	{
		foreach ( entity teammate in teamMates )
		{
			if ( teammate == player )
				continue

			int idx = GetClosestVectorIndex( spawnCandidates, teammate.GetOrigin() )
			skydivePos = spawnCandidates[ idx ]
			break
		}
	}

	if ( skydivePos == <0, 0, 0> )
		skydivePos = spawnCandidates.getrandom()

	skydivePos = <skydivePos.x, skydivePos.y, skydiveHeight>
	vector skydiveAng = VectorToAngles( SURVIVAL_GetSafeZoneCenter( Survival_GetPlayerRealm( player ) ) - skydivePos )
	skydiveAng = <88.0, skydiveAng.y, 0.0>

	Point skydiveRespawnPoint
	skydiveRespawnPoint.origin = skydivePos
	skydiveRespawnPoint.angles = skydiveAng

	return skydiveRespawnPoint
}
#endif // SERVER

#if SERVER
Point function GetBestAvailablePlayerRespawnPoint( entity player, vector deathPos, bool shouldOverrideBestTeammateSelection )
{
	Point spawnPoint

	array<entity> playersOnMyTeam = GetPlayerArrayOfTeam_Alive( player.GetTeam() )
	array<entity> teammates
	foreach ( entity guy in playersOnMyTeam )
	{
		if ( guy == player )
			continue

		teammates.append( guy )
	}

	////////////////////////////////////////////////////
	// No teammates...use deathpos to find a spawnpoint
	////////////////////////////////////////////////////
	if ( teammates.len() == 0 || shouldOverrideBestTeammateSelection )
		return GetRandomSpawnPointNearPos( player, deathPos )

	//////////////////////////////////////////////
	// OR - Spawn near teammate with most health
	//////////////////////////////////////////////
	if ( teammates.len() == 1 )
		return GetRandomSpawnPointNearPos( player, OriginToGround( teammates[ 0 ].GetOrigin() ) )

	entity bestTeammate
	int highestHealth = 0
	foreach( guy in teammates )
	{
		int health = ( guy.GetHealth() + guy.GetShieldHealth() )
		if ( health > highestHealth )
		{
			bestTeammate = guy
			highestHealth = health
		}
	}

	return GetRandomSpawnPointNearPos( player, OriginToGround( bestTeammate.GetOrigin() ) )
}
#endif // SERVER

