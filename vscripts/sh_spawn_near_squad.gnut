#if SERVER
bool function IsSpawnQueueBusy()
{
	return Flag( "SpawnQueueBusy" )
}
#endif //SERVER


#if SERVER
void function WaitTillSpawnQueueFree( float timeout = 2.0 )
{
	AssertIsNewThread()
	float startTime = Time()
	while( IsSpawnQueueBusy() || Time() > ( startTime + timeout ) )
		WaitFrame()

	if ( Time() > ( startTime + timeout ) )
		Warning( "%s() - Waiting too long for busy spawn queue, falling back on timeout: %s seconds", FUNC_NAME(), timeout )
}
#endif //SERVER

#if SERVER
void function _WaitForCharacterReselect( entity player )
{
	while( IsPlayerReselectingCharacter( player ) )
		wait 0.1
}
#endif //SERVER

#if SERVER
void function LockSpawnQueue()
{
	if ( !Flag( "SpawnQueueBusy" ) )
		FlagSet( "SpawnQueueBusy" )
}
#endif //SERVER


#if SERVER
void function UnlockSpawnQueue()
{
	if ( Flag( "SpawnQueueBusy" ) )
		FlagClear( "SpawnQueueBusy" )
}
#endif //SERVER


#if SERVER
Point function GetRandomSpawnPointNearPos( entity player, vector pos, int spawnType = eSpawnType.PLAYER )
{
	if ( GetCurrentPlaylistVarBool( "respawn_queue_active", true ) )
	{
		// if you want to call this func only one customer-at-a-time (for performance gains),
		// you'll need to check IsSpawnQueueBusy() before calling it or do waitthread WaitTillSpawnQueueFree()
		// not a rigid policy...may get instances of multiple customers but checking to see if it's busy reduces the potential load
		if ( Flag( "SpawnQueueBusy" ) )
			Warning( "%s() - Spawn queue is busy. Check IsSpawnQueueBusy() or WaitTillSpawnQueueFree() beforce calling", FUNC_NAME() )
	}

	LockSpawnQueue()

	int playerTeam = player.GetTeam()
	Point bestSpawnPoint
	bestSpawnPoint.origin = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN
	bestSpawnPoint.angles = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ANGLE

	array <Point> spawnPoints
	if ( spawnType == eSpawnType.PROWLER )
		spawnPoints = clone file.spawnPointsPets //fluctuating array based on circle
	else
		spawnPoints = clone file.spawnPoints //fluctuating array based on circle


	float minDistToFriendly
	float maxDistToFriendly
	float minDistToEnemy
	if ( spawnType == eSpawnType.PROWLER )
	{
		minDistToFriendly = GetCurrentPlaylistVarFloat( "pet_respawn_min_dist_from_friendly", MIN_PET_SPAWN_DIST_FROM_FRIENDLY )
		maxDistToFriendly = GetCurrentPlaylistVarFloat( "pet_respawn_max_dist_from_friendly", MAX_PET_SPAWN_DIST_FROM_FRIENDLY )
		minDistToEnemy = GetCurrentPlaylistVarFloat( "pet_respawn_min_dist_from_enemy", MIN_PET_SPAWN_DIST_FROM_ENEMY )
	}
	else
	{
		minDistToFriendly = RespawnNearSquad_GetMinDistFromFriendlyForValidSpawn()
		maxDistToFriendly = RespawnNearSquad_GetMaxDistFromFriendlyForValidSpawn()
		minDistToEnemy = RespawnNearSquad_GetMinDistFromEnemyForValidSpawn()
	}

	//PerfStart( PerfIndexServer.GetRandomSpawnPoint )

	if ( GetCurrentPlaylistVarBool( "spawnpoints_cull_by_dist", true ) )
	{
		//reduce the number of spawn points we will need to order from closest to furthest
		array<Point> spawnPointsCulled
		float maxDistCull = maxDistToFriendly
		float maxDistCullSq = maxDistCull * maxDistCull
		foreach( point in spawnPoints )
		{
			if ( Distance2DSqr( point.origin, pos ) < maxDistCullSq )
				spawnPointsCulled.append( point )
		}
		spawnPoints = spawnPointsCulled
	}

	if ( spawnPoints.len() == 0 )
	{
		Warning( "%s() - No respawn points available, returning SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN (skydive)", FUNC_NAME() )
		bestSpawnPoint.origin = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN
		bestSpawnPoint.angles = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ANGLE
		UnlockSpawnQueue()
		return bestSpawnPoint
	}

	//turn off sorting of spawnpoints from closest to furthest if we need performance gains
	bool sortSpawnPoints = true
	if ( spawnType == eSpawnType.PROWLER )
		sortSpawnPoints = GetCurrentPlaylistVarBool( "squad_pets_sort_spawnpoints", true )
	else
		sortSpawnPoints = GetCurrentPlaylistVarBool( "squad_sort_spawnpoints", true )

	if ( sortSpawnPoints )
		spawnPoints = ArrayClosestPoint( spawnPoints, pos )
	else
		spawnPoints.randomize()

	//create a temp spawnpoint to use to check validity of spawn candidate locations
	entity spawnPointDummy = CreateEntity( "info_player_teamspawn" )
	DispatchSpawn( spawnPointDummy )
	spawnPointDummy.SetOrigin( pos )
	spawnPointDummy.SetAngles( <0, 0, 0> )

	foreach( point in spawnPoints )
	{
		//outside ring? (or too close for comfort)
		if ( spawnType != eSpawnType.PROWLER && SURVIVAL_GetDistanceInsideDeathField( Survival_Loot_GetDefaultRealm(), point.origin ) < MIN_SPAWN_DIST_FROM_RING )
			continue

		//temp "info_player_teamspawn" to do validity checks on the spot
		spawnPointDummy.SetOrigin( point.origin )
		spawnPointDummy.SetAngles( point.angles )

		//spawnPointDummy.ForceUpdateTeamData( playerTeam ) //need to do this to allow spawn points to update multiple times in one frame

		//Use NearbyEnemyDistance and NearbyAllyDistance on the moving dummy spawnpoint

		//too close to an enemy?
		float nearEnemyDist = spawnPointDummy.NearbyEnemyDistance( playerTeam, "pilot" )
		if ( nearEnemyDist < minDistToEnemy )
			continue

		//too close/far from a friendly?
		float dist = spawnPointDummy.NearbyAllyDistance( playerTeam, "pilot" )

		if ( dist < minDistToFriendly )
			continue

		if ( dist > maxDistToFriendly )
			continue

		//occupied, near grenade, etc?
		if ( !IsSpawnpointValid( spawnPointDummy, playerTeam ) )
			continue

		bestSpawnPoint = point
		break
	}

	spawnPointDummy.Destroy()

	//PerfEnd( PerfIndexServer.GetRandomSpawnPoint )

	if ( bestSpawnPoint.origin != SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN )
	{
		if ( GetCurrentPlaylistVarBool( "respawn_point_faces_squad", true ) == true )
		{
			//generate better
			array<entity> squadMates = GetPlayerArrayOfTeam_AliveConnected( playerTeam )
			array<entity> squadMateCandidates
			vector squadMatePos
			foreach( squadMate in squadMates )
			{
				if ( !IsValid( squadMate ) )
					continue

				if ( squadMate == player )
					continue

				squadMateCandidates.append( squadMate )
			}

			if ( squadMateCandidates.len() > 0 )
			{
				entity closestSquadMate = GetClosest( squadMateCandidates, bestSpawnPoint.origin )
				if ( IsValid( closestSquadMate ) )
				{
					vector newSpawnPointAngles = VectorToAngles( closestSquadMate.GetOrigin() - bestSpawnPoint.origin )
					newSpawnPointAngles = <0.0, newSpawnPointAngles.y, 0.0>
					bestSpawnPoint.angles = newSpawnPointAngles
				}
			}
		}

		UnlockSpawnQueue()
		return bestSpawnPoint

	}

	////////////////////////////////////////////////////
	// Unable to find a decent spawn, return <0, 0, 0>
	////////////////////////////////////////////////////
	Warning( "%s() - Couldn't find a safe respawn point, returning SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN (skydive)", FUNC_NAME() )
	bestSpawnPoint.origin = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ORIGIN
	bestSpawnPoint.angles = SPAWN_NEAR_SQUAD_INVALID_SPAWN_POINT_ANGLE

	UnlockSpawnQueue()
	return bestSpawnPoint
}
#endif // SERVER

