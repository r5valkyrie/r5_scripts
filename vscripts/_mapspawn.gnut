void function ActivateSkyBox()
{
	const string SKYBOXLEVEL = "skybox_cam_level"
	entity skycam = GetEnt( SKYBOXLEVEL )
	if ( skycam )
		EntityFire( skycam, "ActivateSkybox" )
}

table< string, asset > geoFixAssetMap = {}

void function PlaylistGeoFix() //Note: This will work on playlists with multiple maps *ONLY* if they are set to use map vars, e.g. Arenas!
{
	Assert( GetGamemodeVarOrUseValue( "defaults", "geo_fix_count", "no" ) == "no", "Cannot define geo_fix variables in defaults gamemode vars" )
	Assert( GetGamemodeVarOrUseValue( "defaults", "geo_fix_0_model", "no" ) == "no", "Cannot define geo_fix variables in defaults gamemode vars" )

	int numGeoFixes = GetCurrentPlaylistVarInt( "geo_fix_count", 0 )

	for ( int index = 0; index < numGeoFixes; index++ )
	{
		string geoFixPrefix = "geo_fix_" + index + "_"
		string modelString = GetCurrentPlaylistVarString( geoFixPrefix + "model", "" )
		if ( modelString == "" )
			continue

		asset modelAsset
		if ( !(modelString in geoFixAssetMap) )
		{
			Warning( "map " + GetMapName() + " has not registered geo fix asset " + modelString )
			// Attempting to load an invalid model can take down servers.  The following is only for use
			// if there is a critical case that needs an immediate fix.
			if ( GetCurrentPlaylistVarBool( geoFixPrefix + "force", false ) )
				modelAsset = GetKeyValueAsAsset( { kn = modelString }, "kn" )
			else
				continue
		}
		else
		{
			modelAsset = geoFixAssetMap[modelString]
		}


		vector modelOrigin = StringToVector( GetCurrentPlaylistVarString( geoFixPrefix + "origin", "0 0 0" ) )
		vector modelAngles = StringToVector( GetCurrentPlaylistVarString( geoFixPrefix + "angles", "0 0 0" ) )
		float modelFadeDist = GetCurrentPlaylistVarFloat( geoFixPrefix + "fade", 15000 )

		CreatePropDynamic( modelAsset, modelOrigin, modelAngles, SOLID_VPHYSICS, modelFadeDist )
	}
}

void function RegisterGeoFixAsset( asset modelAsset )
{
	geoFixAssetMap[string( modelAsset )] <- modelAsset
}

void function PlaylistDeathTriggerFix() //Note: This will work on playlists with multiple maps *ONLY* if they are set to use map vars, e.g. Arenas!
{
	Assert( GetGamemodeVarOrUseValue( "defaults", "death_trigger_fix_count", "no" ) == "no", "Cannot define death_trigger_fix variables in defaults gamemode vars" )

	int numDeathTriggers = GetCurrentPlaylistVarInt( "death_trigger_fix_count", 0 )

	for ( int index = 0; index < numDeathTriggers; index++ )
	{
		string deathTriggerPrefix = "death_trigger_fix_" + index + "_"

		vector triggerOrigin = StringToVector( GetCurrentPlaylistVarString( deathTriggerPrefix + "origin", "0 0 0" ) )
		vector triggerAngles = StringToVector( GetCurrentPlaylistVarString( deathTriggerPrefix + "angles", "0 0 0" ) )
		float triggerRadius = GetCurrentPlaylistVarFloat( deathTriggerPrefix + "radius", 0.0  )
		float triggerAboveHeight = GetCurrentPlaylistVarFloat( deathTriggerPrefix + "aboveHeight", 0.0  )
		float triggerbelowHeight = GetCurrentPlaylistVarFloat( deathTriggerPrefix + "belowHeight", 0.0  )


		entity trig = CreateEntity( "trigger_cylinder" )
		trig.SetCylinderRadius( triggerRadius )
		trig.SetAboveHeight( triggerAboveHeight )
		trig.SetBelowHeight( triggerbelowHeight )
		trig.SetOrigin( triggerOrigin )
		trig.SetAngles( triggerAngles  )
		trig.SetPhaseShiftCanTouch( true )
		trig.SetEnterCallback( PlaylistDeathTrigger_OnEnter )
		DispatchSpawn( trig )
	}
}

void function PlaylistDeathTrigger_OnEnter( entity trigger, entity ent ) //Based off leviathan stomp trigger but simplified
{
	if ( !ent.IsPlayer() )
		return

	if ( !IsAlive( ent  )  )
		return

	if ( ent.IsPhaseShiftedOrPending() )
		ent.PhaseShiftCancel()

	if ( ent.IsPlayer() && ent.IsShadowForm() )
		ent.TakeDamage( 10000, svGlobal.worldspawn, trigger, { damageSourceId = eDamageSourceId.crushed, scriptType =  DF_BYPASS_SHIELD | DF_SKIPS_DOOMED_STATE }   )
	else
		ent.Die( trigger.GetOwner(), trigger, { damageSourceId = eDamageSourceId.crushed, scriptType =  DF_BYPASS_SHIELD | DF_SKIPS_DOOMED_STATE, damageType = DMG_CRUSH }  )

}

void function PlaylistOOBTriggerFix() //Note: This will work on playlists with multiple maps *ONLY* if they are set to use map vars, e.g. Arenas!
{
	Assert( GetGamemodeVarOrUseValue( "defaults", "oob_trigger_fix_count", "no" ) == "no", "Cannot define oob_trigger_fix_count variables in defaults gamemode vars" )

	int numOOBTriggers = GetCurrentPlaylistVarInt( "oob_trigger_fix_count", 0 )

	for ( int index = 0; index < numOOBTriggers; index++ )
	{
		string oobTriggerPrefix = "oob_trigger_fix_" + index + "_"

		vector triggerOrigin = StringToVector( GetCurrentPlaylistVarString( oobTriggerPrefix + "origin", "0 0 0" ) )
		vector triggerAngles = StringToVector( GetCurrentPlaylistVarString( oobTriggerPrefix + "angles", "0 0 0" ) )
		float triggerRadius = GetCurrentPlaylistVarFloat( oobTriggerPrefix + "radius", 0.0  )
		float triggerAboveHeight = GetCurrentPlaylistVarFloat( oobTriggerPrefix + "aboveHeight", 0.0  )
		float triggerbelowHeight = GetCurrentPlaylistVarFloat( oobTriggerPrefix + "belowHeight", 0.0  )

		CreateTriggerCylinderNetworked_OutOfBounds( triggerOrigin, triggerRadius, triggerAboveHeight, triggerbelowHeight, triggerAngles )
	}
}

bool function IsInForgedShadows( entity player )
{
	if ( !IsValid( player ) )
		return false

	if ( StatusEffect_HasSeverity( player, eStatusEffect.shadow_form ) )
		return true

	return false
}