//
// (dw): Remember to wrap your stuff in #if SERVER/#endif to prevent it from being shipped in client builds.

#if SERVER || CLIENT || UI
global function SneakPeek_Init
#endif

#if SERVER || CLIENT || UI
void function SneakPeek_Init()
{
	#if SERVER
	AddCallback_EntitiesDidLoad( OnEntitiesDidLoad )
	#endif
}
#endif


#if SERVER
void function OnEntitiesDidLoad()
{
	if ( WirelinePreviewEnabled() )
		CreateCharacterPreviewWirelines()
}
#endif


