//-----------------------------------------------------------
// CreatePropScript( model ) - create a generic prop_script with default properties
//------------------------------------------------------------
entity function CreatePropScript_NoDispatchSpawn( asset model, vector ornull origin = null, vector ornull angles = null, int solidType = 0, float fadeDist = -1 )
{
	return CreatePropScript( model, origin, angles, solidType, fadeDist, false )
}


entity function CreatePropScript( asset model, vector ornull origin = null, vector ornull angles = null, int solidType = 0, float fadeDist = -1, bool dispatchSpawn = true )
{
	entity prop_script = CreateEntity( "prop_script" )
	prop_script.SetValueForModelKey( model )
	prop_script.kv.fadedist = fadeDist
	prop_script.kv.renderamt = 255
	prop_script.kv.rendercolor = "255 255 255"
	prop_script.kv.solid = solidType // 0 = no collision, 2 = bounding box, 6 = use vPhysics, 8 = hitboxes only
	if ( origin )
	{
		// hack: Setting origin twice. SetOrigin needs to happen before DispatchSpawn, otherwise the prop may not touch triggers
		prop_script.SetOrigin( expect vector( origin ) )
		if ( angles )
		{
			vector checkAngles = expect vector( angles )
			if ( LegalAngles(checkAngles) )
				prop_script.SetAngles( expect vector( angles ) )
			#if DEVELOPER
			else
				Assert( false, "CreatePropScript: angles are not between valid -360.0 and 360.0 range. angles=" + checkAngles)
			#endif
		}
	}

	if ( dispatchSpawn )
		DispatchSpawn( prop_script )

	if ( origin )
	{
		// hack: Setting origin twice. SetOrigin needs to happen after DispatchSpawn, otherwise origin is snapped to nearest whole unit
		prop_script.SetOrigin( expect vector( origin ) )
		if ( angles )
			prop_script.SetAngles( expect vector( angles ) )
	}

	return prop_script
}

bool function TeleportPlayerNoInterp( entity player, vector pos, vector angles = <0,0,0> )
{
    if ( !IsValid( player ) || !player.IsPlayer() )
        return false

    bool success = PutPlayerInSafeSpot( player, null, null, pos, pos )

    // if ( success )
    // {
        player.SetVelocity( <0, 0, 0> )
        player.SetAbsOrigin( pos )
        player.SetAngles( angles )
        player.SnapEyeAngles( angles )
        player.SnapFeetToEyes()
    // }

    return success
}

void function PropCheckDamageFromDeathfield( entity ent, float damageScaleAmount )
{
	Assert ( IsNewThread(), "Must be started as new thread" )
	Assert( IsValid( ent ) )

	EndSignal( ent, "OnDestroy" )

	while( true )
	{
		wait DEATHFIELD_DAMAGE_CHECK_STEP_TIME

		DeathFieldData deathFieldData = SURVIVAL_GetDeathFieldData( 0 )
		bool insideSafeRing           = SURVIVAL_PosInsideDeathField( 0, ent.GetOrigin( ) )
		if ( !insideSafeRing )
		{
			int deathfieldDamage = int( deathFieldData.percentDamagePerTick * float( ent.GetMaxHealth() ) * damageScaleAmount )
			ent.TakeDamage( deathfieldDamage, null, null, { scriptType = DF_BYPASS_SHIELD | DF_DOOMED_HEALTH_LOSS, damageSourceId = eDamageSourceId.deathField } )
		}
	}
}


//-----------------------------------------------------------
// CreatePropPhysics( model ) - create a generic prop_physics with default properties
//------------------------------------------------------------
entity function CreatePropPhysics( asset model, vector origin, vector angles, int spawnFlags = 0 )
{
	entity prop_physics = CreateEntity( "prop_physics" )
	prop_physics.SetValueForModelKey( model )
	prop_physics.kv.spawnflags = spawnFlags
	prop_physics.kv.fadedist = -1
	prop_physics.kv.physdamagescale = 0.1
	prop_physics.kv.inertiaScale = 1.0
	prop_physics.kv.renderamt = 255
	prop_physics.kv.rendercolor = "255 255 255"
	SetTeam( prop_physics, TEAM_NPC_FRIENDLY_TO_PLAYERS )    // need to have a team other then 0 or it won't take impact damage

	prop_physics.SetOrigin( origin )
	prop_physics.SetAngles( angles )
	DispatchSpawn( prop_physics )

	return prop_physics
}

//-----------------------------------------------------------
// CreateTriggerCylinder( origin, radius, height ) - create a server only trigger_cylinder that can be triggerd by players only
//------------------------------------------------------------
entity function CreateTriggerCylinder( vector origin, int radius, int aboveHeight, int belowHeight )
{
	entity trigger = Entities_CreateByClassname( "trigger_cylinder" )
	trigger.SetCylinderRadius( radius )
	trigger.SetAboveHeight( aboveHeight )
	trigger.SetBelowHeight( belowHeight )
	trigger.kv.triggerFilterNpc = "none"
	trigger.kv.triggerFilterPlayer = "all"
	trigger.kv.triggerFilterNonCharacter = 0
	trigger.SetOrigin( origin )
	DispatchSpawn( trigger )

	return trigger
}

