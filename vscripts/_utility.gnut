bool function CheckPlayersIntersectingEntity( entity ent, int safeDist )
{
	Assert( safeDist > 0 )

	array<entity> playerList = GetPlayerArray()
	vector origin            = ent.GetOrigin()

	// Multiplying the bounds by 1.42 to ensure this encloses the droppod when it's rotated 45 degrees
	vector mins       = ent.GetBoundingMins() * 1.42 + origin
	vector maxs       = ent.GetBoundingMaxs() * 1.42 + origin
	int safeRadiusSqr = safeDist * safeDist

	foreach ( player in playerList )
	{
		vector playerOrigin = player.GetOrigin()

		if ( DistanceSqr( origin, playerOrigin ) > safeRadiusSqr )
			continue

		vector playerMins = player.GetBoundingMins() + playerOrigin
		vector playerMaxs = player.GetBoundingMaxs() + playerOrigin

		if ( BoxIntersectsBox( mins, maxs, playerMins, playerMaxs ) )
			return true
	}

	return false
}

void function Thread_CheckForGeoIntersection( entity ent, entity mover, float heightOffset = 0.0, int threadLifetime = 10 )
{
	Assert ( IsNewThread(), "Must be threaded off." )
	ent.EndSignal( "OnDestroy" )
	mover.EndSignal( "StopCheckingForIntersectingGeo" )

	vector mins = ent.GetBoundingMins()
	vector maxs = ent.GetBoundingMaxs()

	float startTime = Time()

	float hullDepth = max( maxs.x, 5 )
	float hullWidth = hullDepth
	float hullHeight = max( maxs.z, 20 ) + heightOffset

	vector lastOrigin

	#if DEV
	OnThreadEnd(
		function():(mover)
		{
			printt ( "Finished checking intersections for: " + mover.GetModelName() )
		}
	)
	#endif

	while ( Time() - startTime < threadLifetime )
	{
		array<entity> ignoreEnts = GetPlayerArray_Alive()
		ignoreEnts.append( ent )
		ignoreEnts.append( mover )

		vector pos = < ent.GetOrigin().x, ent.GetOrigin().y, ent.GetOrigin().z >

		TraceResults results = TraceHull( pos, pos, <-hullWidth, -hullDepth,0>, <hullWidth, hullDepth, hullHeight>, ignoreEnts, TRACE_MASK_PLAYERSOLID, TRACE_COLLISION_GROUP_PLAYER )
		//DebugDrawBox( pos, <-hullWidth,-hullDepth,0>, <hullWidth,hullDepth,hullHeight>, COLOR_GREEN, 1, 10.0 )
		//PrintTraceResults( results )

		if ( results.startSolid || results.fraction != 1 )
		{
			entity hitEnt = results.hitEnt
			if ( IsValid( hitEnt ) )
			{
				string hitEntClassname = hitEnt.GetClassName()

				if ( hitEntClassname == "worldspawn" || hitEntClassname == "phys_bone_follower" || hitEntClassname == "func_brush" || hitEntClassname == "script_mover" || hitEntClassname == "func_brush_lightweight" || hitEntClassname == "prop_dynamic" )
				{
					DeactivateDeployableAbility ( ent )
				}
			}
		}
		wait 0.1
	}

}
