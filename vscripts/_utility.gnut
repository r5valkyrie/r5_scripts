void function RefreshOrdnanceSlot( entity player, string item )
{
	entity heldOrdnance = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_ANTI_TITAN )

	if ( IsValid( heldOrdnance ) && heldOrdnance.GetWeaponClassName() == item )
	{
		int ammo = SURVIVAL_NumItemsInInventory( player, item )

		if ( ammo >= 0 )
		{
			int maxStockpile = heldOrdnance.GetWeaponSettingInt( eWeaponVar.ammo_stockpile_max )

			if ( maxStockpile <= 0 )
				heldOrdnance.SetWeaponPrimaryClipCount( ammo )
			else
			{
				int maxClip        = heldOrdnance.GetWeaponSettingInt( eWeaponVar.ammo_clip_size )
				int clipCount      = minint( ammo, maxClip )
				int stockpileCount = maxint( 0, ammo - clipCount )

				heldOrdnance.SetWeaponPrimaryClipCount( clipCount )
				heldOrdnance.SetWeaponPrimaryAmmoCount( AMMOSOURCE_STOCKPILE, stockpileCount )
			}
		}

		if ( ammo <= 0 )
		{
			bool shouldSwitch = heldOrdnance == player.GetActiveWeapon( eActiveInventorySlot.mainHand )
			SURVIVAL_AutoEquipOrdnanceFromInventory( player, shouldSwitch )
		}
	}
}

void function StoreUltimateChargeForPlayer( entity victim, entity attacker, var attackerDamageInfo)
{
	StoreChargeForPlayer( victim, eChargeStorageType.Ultimate )
}

void function StoreAllChargeForPlayer( entity victim, entity attacker, var attackerDamageInfo)
{
	StoreChargeForPlayer( victim, eChargeStorageType.All )
}

void function StoreChargeForPlayer( entity victim, int type)
{
	if ( victim in file.playerChargeValidation )
		file.playerChargeValidation[victim] = LoadoutSlot_GetItemFlavor( ToEHI( victim ), Loadout_Character() )
	else
		file.playerChargeValidation[victim] <- LoadoutSlot_GetItemFlavor( ToEHI( victim ), Loadout_Character() )

	if ( type & eChargeStorageType.Ultimate )
	{
		entity activeWeapon = victim.GetActiveWeapon( eActiveInventorySlot.mainHand )
		entity ultimateWeapon = victim.GetOffhandWeapon( OFFHAND_ULTIMATE )
		int ultimateCharge = 0

		if ( IsValid( ultimateWeapon ) )
		{
			ultimateCharge = ultimateWeapon.GetWeaponPrimaryClipCount()
			int ultimateAmmoPerShot = ultimateWeapon.GetAmmoPerShot()

			bool hasDropOnDeath = false // bool( GetWeaponInfoFileKeyField_GlobalInt_WithDefault( ultimateWeapon.GetWeaponClassName(), "drops_on_death", 0 ) ) //Revisit. Cafe

			if( IsValid( activeWeapon ) && activeWeapon == ultimateWeapon && hasDropOnDeath )
				ultimateCharge = ultimateCharge - ultimateAmmoPerShot
		}

		if ( victim in file.playerToStoredUltimateCharge )
			file.playerToStoredUltimateCharge[victim] = ultimateCharge
		else
			file.playerToStoredUltimateCharge[victim] <- ultimateCharge
	}

	if ( type & eChargeStorageType.Tactical )
	{
		entity offhandTacticalWeapon = victim.GetOffhandWeapon( OFFHAND_TACTICAL )
		int tacticalCharge = 0

		if ( IsValid( offhandTacticalWeapon ) )
		{
			tacticalCharge = offhandTacticalWeapon.GetWeaponPrimaryClipCount()
		}
		if ( victim in file.playerToStoredTacticalCharge )
			file.playerToStoredTacticalCharge[victim] = tacticalCharge
		else
			file.playerToStoredTacticalCharge[victim] <- tacticalCharge
	}
}

void function RestoreChargesForPlayer( entity player )
{
	if ( !IsValid( player ) )
		return

	if ( !IsAlive( player ) )
		return

	if ( player in file.playerChargeValidation && LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() ) == file.playerChargeValidation[player] )
	{
		if ( player in file.playerToStoredUltimateCharge )
		{
			entity ultWeapon = player.GetOffhandWeapon( OFFHAND_ULTIMATE )
			if ( IsValid( ultWeapon ) )
			{
				#if DEVELOPER
				Warning( "Restored ultimate charge for player " + player + " Stored:" + file.playerToStoredUltimateCharge[player] + " Max: " + ultWeapon.GetWeaponPrimaryClipCountMax() )
				#endif
				ultWeapon.SetWeaponPrimaryClipCount( minint( file.playerToStoredUltimateCharge[player], ultWeapon.GetWeaponPrimaryClipCountMax() ) )
				delete file.playerToStoredUltimateCharge[player]
			}
		}

		if ( player in file.playerToStoredTacticalCharge )
		{
			entity tacWeapon = player.GetOffhandWeapon( OFFHAND_TACTICAL )
			if ( IsValid( tacWeapon ) )
			{
				#if DEVELOPER
				Warning( "Restored tactical charge for player", player )
				#endif
				tacWeapon.SetWeaponPrimaryClipCount( minint( file.playerToStoredTacticalCharge[player], tacWeapon.GetWeaponPrimaryClipCountMax() ) )
				delete file.playerToStoredTacticalCharge[player]
			}
		}
	}
}

