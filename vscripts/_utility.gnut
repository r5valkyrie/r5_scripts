void function DEV_ToggleInfiniteAmmo( bool toggle = true )
{
	if( !GetConVarInt( "sv_cheats" ) )
	{
		printl( "ToggleInfiniteAmmo was called but sv_cheats is disabled. Try setting in console:  sv_cheats 1" )
		return
	}
		
	foreach( player in GetConnectedPlayers() )
		DEV_ToggleInfiniteAmmo_Internal( player, player.GetMainWeapons(), toggle, true )
	
	if( toggle )
		Loot_AddCallback_OnGiveMainWeapon( AutoGiveInfinite ) //Todo(mk): use AddCallback_OnPlayerWeaponActivated after code callback added.
	else
		Loot_RemoveCallback_OnGiveMainWeapon( AutoGiveInfinite ) //use RemoveCallback_OnPlayerWeaponActivated
}

void function DEV_ToggleInfiniteAmmo_Internal( entity player, array<entity> weapons, bool toggle, bool bMsg = false )
{
	foreach( weapon in weapons )
	{
		if( toggle )
		{
			if( weapon.HasMod( "survival_finite_ammo" ) )
				weapon.RemoveMod( "survival_finite_ammo" )
			
			if( !weapon.HasMod( "infinite_ammo" ) )
				weapon.AddMod( "infinite_ammo" )
				
			if( weapon.UsesClipsForAmmo() )
				weapon.SetWeaponPrimaryClipCount( weapon.GetWeaponPrimaryClipCountMax() )
			else
			{
				player.AmmoPool_SetCapacity( 65535 )
				player.AmmoPool_SetCount( weapon.GetWeaponAmmoPoolType(), 65535 )
			}
		}
		else 
		{			
			if( weapon.HasMod( "infinite_ammo" ) )
				weapon.RemoveMod( "infinite_ammo" )
				
			if( !weapon.HasMod( "survival_finite_ammo" ) )
				weapon.AddMod( "survival_finite_ammo" )
			
			SetupPlayerReserveAmmo( player, weapon )
		}
	}
}

void function AutoGiveInfinite( entity player, entity pickup, entity weapon )
{
	DEV_ToggleInfiniteAmmo_Internal( player, [ weapon ], true, false )
}

