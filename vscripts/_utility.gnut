const bool DEBUG_LIMITED_LEGEND_OBJECTS = false

void function AddNewLimitedLegendObject( entity player, entity object, int maxNum )
{
	string scriptName = object.GetScriptName()

	Assert( scriptName != "", "LimitedLegendObject: Object's Scriptname can't be blank. Player: " + player + " Object: " + object )

	if ( !( player in file.allLegendsLimitedObjects ) )
	{
		table< string, LimitedObjectList > emptyTable
		file.allLegendsLimitedObjects[player] <- emptyTable
	}

	OneLegendsLimitedObjects thisLegendsObjects = file.allLegendsLimitedObjects[player]
	if ( !(scriptName in thisLegendsObjects )  )
	{
		LimitedObjectList listOfObjects
		thisLegendsObjects[scriptName] <- listOfObjects
	}

	Assert( (scriptName in thisLegendsObjects ), "" )

	thisLegendsObjects[scriptName].max = maxNum

	thisLegendsObjects[scriptName].objects.insert( 0, object )

	if ( DEBUG_LIMITED_LEGEND_OBJECTS )
	{
		int newTotal = thisLegendsObjects[scriptName].objects.len()
		printt( "LimitedLegendObject: Adding new object " + object + " of type '" + scriptName + "', new total: " + newTotal + " max: " + maxNum )
		if ( newTotal > maxNum )
			printt( "\t-OverLimit, will be removing " + (newTotal-maxNum) + "" )
	}

	thread DestroyOverlimitObjectsThread( thisLegendsObjects, scriptName, player )
}

void function DestroyOverlimitObjectsThread( OneLegendsLimitedObjects thisLegendsObjects, string scriptName, entity player )
{
	int loops = 0
	while ( thisLegendsObjects[scriptName].objects.len() > thisLegendsObjects[scriptName].max )
	{
		entity entToDelete = thisLegendsObjects[scriptName].objects.top()
		if ( IsValid( entToDelete ) )
		{
			entToDelete.Destroy()
		}
		loops++
		if ( loops > 30 )
		{
			#if DEV
			ServerCommand( "edict_dump_distribution" )
			DEV_DumpAllLimitedLegendObjects( )
			Assert( false, "LimitedLegendObject: Too many iterations trying to remove extra elements from the list. Player: " + player )
			#endif
			break
		}
		WaitFrame()
	}
}


bool function RemoveLimitedLegendObject( entity player, entity object )
{
	bool ret = false
	Assert( ( player in file.allLegendsLimitedObjects ), "LimitedLegendObject: Player " + player + " hasnt added any Limited Objects. Must call 'AddNewLimitedLegendObject' first.")

	OneLegendsLimitedObjects thisLegendsObjects = file.allLegendsLimitedObjects[player]

	string scriptName = object.GetScriptName()

	//if ( scriptName == "" )
	//{
	//	Warning( "Attempting to remove a legend object but it has no Scriptname?? player: " + player + " object: " + object  )
	//	DEV_DumpLimitedLegendObjects(player)
	//	return ret
	//}
	Assert( scriptName != "", "LimitedLegendObject: Objects Scriptname can't be blank. Player: " + player + " Object: " + object )

	Assert( (scriptName in thisLegendsObjects ), "LimitedLegendObject: No array set up for Player: " + player + " for objects with ScriptName: " + scriptName )

	if ( thisLegendsObjects[scriptName].objects.contains( object ) )
	{
		ret = true
		thisLegendsObjects[scriptName].objects.removebyvalue( object )
	}
	return ret
}
#if DEV
void function DEV_DumpAllLimitedLegendObjects(  )
{
	printt( "---- LimitedLegendObjects PRINTING ALL ----")
	foreach( player, objectArray in file.allLegendsLimitedObjects )
	{
		DEV_DumpLimitedLegendObjects( player )
	}
	printt( "---- LimitedLegendObjects PRINTING DONE ----")

}
void function DEV_DumpLimitedLegendObjects( entity player )
{
	if (  player in file.allLegendsLimitedObjects )
	{
		printt( "LimitedLegendObjects for Player: " + player )
		OneLegendsLimitedObjects thisLegendsObjects = file.allLegendsLimitedObjects[player]
		foreach( scriptName, objectList in thisLegendsObjects )
		{
			printt( "-- ScriptName: " + scriptName + " Total: " + objectList.objects.len() )
			foreach( object in objectList.objects )
			{
				if ( IsValid(object) )
					printt("   - " + object + " pos: " + object.GetOrigin() )
				else
					printt( "   - " + object )
			}
		}
	}
}
#endif

