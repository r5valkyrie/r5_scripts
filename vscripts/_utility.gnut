void functionref( entity trigger, entity ent ) function PushOutOfTrigger( float strength = 350.0 )
//void function PushOutOfTrigger( entity trigger, entity ent )
{
	return void function( entity trigger, entity ent ) : ( strength )
	{
		if ( ent.DoesShareRealms( trigger ) )
			thread PushOutOfTriggerThread( trigger, ent, strength )
	}
}

void function PushOutOfTriggerThread( entity trigger, entity ent, float strength = 350.0 )
{
	EndSignal( trigger, "OnDestroy" )
	EndSignal( ent, "OnDestroy" )

	bool isSkywardLaunching = false

	if ( IsValid( ent ) && ent.IsPlayer() && ent.Player_IsSkywardLaunching() )
	{
		isSkywardLaunching = true
	}

	while( trigger.IsTouching( ent ) )
	{
		vector v = Normalize( ent.GetOrigin() - trigger.GetOrigin() )

		v = Normalize( <v.x,v.y,0> )

		if ( isSkywardLaunching && GetCurrentPlaylistVarBool( "pusher_push_out_skyward_launching_players", true ) )
		{
			vector rightVec               = CrossProduct( v, UP_VECTOR )
			array<vector> dirsToTry       = [ v, -v, rightVec, -rightVec ]

			//find where we are along the height of the cylinder
			vector projectionToCylinderVertical = GetClosestPointOnLineSegment( trigger.GetOrigin() - ( trigger.GetUpVector() * trigger.GetBelowHeight() ), trigger.GetOrigin() + ( trigger.GetUpVector() * trigger.GetAboveHeight() ), ent.GetOrigin() )

			#if DEVELOPER
			if ( SkywardLaunchPushTriggerDebug )
			{
				DebugDrawLine( trigger.GetOrigin() - ( trigger.GetUpVector() * trigger.GetBelowHeight() ), trigger.GetOrigin() + ( trigger.GetUpVector() * trigger.GetAboveHeight() ),COLOR_BLUE, true, 15.0 )
				DebugDrawMark( projectionToCylinderVertical, 10.0, COLOR_GREEN, true, 15.0 )
			}
			#endif

			foreach ( vector dir in dirsToTry )
			{
				//5% bonus to radius to hopefully ensure we always clear the geo
				vector traceEndPos = projectionToCylinderVertical + ( dir * ( trigger.GetRadius() * 1.05 ) )
				array<entity> ignoreEnts = [trigger, ent, trigger.GetParent(), trigger.GetOwner()]

				for ( int i = 0; i < ignoreEnts.len(); i++ )
				{
					if ( !IsValid( ignoreEnts[i] ) )
					{
						ignoreEnts.remove( i )
						i--
					}
				}

				TraceResults tr    = TraceHull( ent.GetOrigin(), traceEndPos, ent.GetPlayerStandingMins(), ent.GetPlayerStandingMaxs(), ignoreEnts, TRACE_MASK_PLAYERSOLID, TRACE_COLLISION_GROUP_PLAYER )

				#if DEV
				if ( SkywardLaunchPushTriggerDebug )
				{
					DebugDrawArrow( ent.GetOrigin(), traceEndPos, 5, COLOR_GREEN, true, 15.0 )
				}
				#endif

				if ( !tr.startSolid && !tr.allSolid && tr.fraction >= 0.99 )
				{
					#if DEV
					if ( SkywardLaunchPushTriggerDebug )
					{
						DebugDrawSphere( tr.endPos, 10.0, COLOR_GREEN, true, 15.0 )
					}
					#endif

					ent.SetOrigin( tr.endPos )
					break
				}
				else
				{
					#if DEV
					if ( SkywardLaunchPushTriggerDebug )
					{
						DebugDrawSphere( tr.endPos, 10.0, COLOR_RED, true, 5.0 )
					}
					#endif
				}
			}
		}

		else
		{
			if ( Length( v ) < 0.5 )
				v = <1,0,0>

			ent.SetVelocity( v * strength )
		}

		WaitFrame()
	}
}
