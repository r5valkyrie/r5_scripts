void function BunkerDoor_CreateZipline( vector startPos, vector endPos, bool pushOff, vector startAngles, float detatchDistanceOverride = -1, bool moveIt = true, float deployDuration = 1.0, )
{
	entity zip_start = CreateEntity("zipline")
	entity zip_end = CreateEntity("zipline_end")

	zip_start.SetOrigin( startPos )

	entity mover

	if( moveIt )
	{
		zip_end.SetOrigin( startPos - <0,0,1> )
		mover = CreateScriptMover( "", zip_start.GetOrigin(), zip_start.GetAngles())
		zip_end.SetParent(mover)
		EmitSoundOnEntity( zip_start, "Canyonlands_Scr_Bunker_Hatch_Zipline_Drop" )
	} else
	{
		zip_end.SetOrigin( endPos )
		zip_start.kv._zipline_rest_point_0 = startPos.x + " " + startPos.y + " " + startPos.z
		zip_start.kv._zipline_rest_point_1 = endPos.x + " " + endPos.y + " " + endPos.z
	}

	zip_start.kv.ZiplineAutoDetachDistance = "160"
	zip_end.kv.ZiplineAutoDetachDistance = "160"

	zip_start.LinkToEnt(zip_end)
	zip_start.kv.Material = "cable/zipline.vmt"
	zip_start.kv.ZiplineVertical = true
	zip_start.kv.ZiplinePreserveVelocity = true

	zip_start.Zipline_Disable()

	DispatchSpawn(zip_start)
	DispatchSpawn(zip_end)

	if( moveIt )
	{
		mover.NonPhysicsMoveTo( endPos, deployDuration, 1.0, 0.0  )
		wait deployDuration + 0.099
		zip_end.SetOrigin( endPos )
		zip_end.ClearParent()
		mover.Destroy()
		zip_start.Zipline_Enable()
		zip_start.Zipline_WakeUp()
	} else
	{
		zip_start.Zipline_Enable()
		zip_start.Zipline_WakeUp()
	}
}


array<entity> function CreateZipline( vector startPos, vector endPos, bool disableResting = false, float detatchDistanceOverride = -1, bool skin = false )
{
	vector delta     = startPos - endPos
	vector direction = Normalize( delta )
	float steepness  = fabs( direction.z )
	bool isSteep     = steepness > 0.7

	string detachDist = isSteep ? "0" : "160"

	if ( detatchDistanceOverride >= 0 )
		detachDist = string( detatchDistanceOverride )

	entity zipline_start = CreateEntity( "zipline" )
	if ( skin )
		zipline_start.kv.Material = "cable/cable_selfillum.vmt"
	else
		zipline_start.kv.Material = "cable/zipline.vmt"

	zipline_start.SetOrigin( startPos )
	zipline_start.kv.ZiplineAutoDetachDistance = detachDist
	zipline_start.kv._zipline_rest_point_0 = startPos.x + " " + startPos.y + " " + startPos.z
	zipline_start.kv._zipline_rest_point_1 = endPos.x + " " + endPos.y + " " + endPos.z
	zipline_start.kv.ZiplineVertical = isSteep
	zipline_start.kv.ZiplinePreserveVelocity = isSteep

	if ( disableResting )
		zipline_start.Zipline_DisableResting()

	entity zipline_end = CreateEntity( "zipline_end" )
	zipline_end.kv.ZiplineAutoDetachDistance = detachDist
	zipline_end.SetOrigin( endPos )

	zipline_start.LinkToEnt( zipline_end )

	DispatchSpawn( zipline_start )
	DispatchSpawn( zipline_end )

	array<entity> ziplineEnts = [ zipline_start, zipline_end ]
	return ziplineEnts
}


bool function ShouldZiplineUseShadowFogMaterial()
{
	if ( GetMapName() == "mp_rr_canyonlands_mu1_night" )
		return true

	return false
}

void function DeployZipline( float deployDuration, vector startPos, vector endPos, bool pushOff, vector startAngles, float detatchDistanceOverride = -1 )
{
	Assert ( IsNewThread(), "DeployZipline must be threaded off" )

	// have to create the zipline begin/end on top of each other,
	// otherwise you'll see the fully complete zipline a frame before it deploys
	vector delta     = startPos - endPos
	vector direction = Normalize( delta )
	float steepness  = fabs( direction.z )
	bool isSteep     = steepness > 0.7

	string detachDist = isSteep ? "0" : "160"

	if ( detatchDistanceOverride >= 0 )
		detachDist = string( detatchDistanceOverride )

	entity zipline_start = CreateEntity( "zipline" )
	if ( ShouldZiplineUseShadowFogMaterial() )
		zipline_start.kv.Material = "cable/zipline_w_shadows_fog"
	else
		zipline_start.kv.Material = "cable/zipline"

	zipline_start.SetOrigin( startPos )
	zipline_start.SetAngles( startAngles )
	zipline_start.kv.ZiplineAutoDetachDistance = detachDist
	zipline_start.kv._zipline_rest_point_0 = startPos.x + " " + startPos.y + " " + startPos.z
	zipline_start.kv._zipline_rest_point_1 = endPos.x + " " + endPos.y + " " + endPos.z
	zipline_start.kv.ZiplineVertical = isSteep
	zipline_start.kv.ZiplinePreserveVelocity = isSteep
	zipline_start.kv.ZiplinePushOffInDirectionX = pushOff

	// we're deploying, so we want this
	zipline_start.Zipline_DisableResting()

	entity zipline_end = CreateEntity( "zipline_end" )
	zipline_end.kv.ZiplineAutoDetachDistance = detachDist
	zipline_end.SetOrigin( startPos )

	zipline_start.LinkToEnt( zipline_end )

	DispatchSpawn( zipline_start )
	DispatchSpawn( zipline_end )

	array<entity> ziplineEnts = [ zipline_start, zipline_end ]

	entity ziplineStart = ziplineEnts[0]
	entity ziplineEnd = ziplineEnts[1]
	entity mover = CreateScriptMover_NEW( "zipline_script_mover", startPos )

	ziplineStart.Zipline_Disable()
	ziplineEnd.SetOrigin( startPos )
	ziplineEnd.SetParent( mover )
	mover.NonPhysicsMoveTo( endPos, deployDuration, 0.0, deployDuration * 0.4 )

	wait deployDuration + 0.099

	ziplineStart.Zipline_Enable()

	ziplineEnd.ClearParent();
	mover.Destroy()
}
