	}

	TakePrimaryWeapon( ent )
	ent.GiveWeapon( weaponName, WEAPON_INVENTORY_SLOT_ANY )
	ent.SetActiveWeaponByName( eActiveInventorySlot.mainHand, weaponName )
}

