/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Returns an array of all linked entities targeted one after the other down the chain, including the starting ent
array<entity> function GetEntityChain( entity startingEnt )
{
	array<entity> entityChain
	entity currentEnt = startingEnt
	entity nextEnt
	entityChain.append( startingEnt )

	while ( true )
	{
		nextEnt = currentEnt.GetLinkEnt()
		if ( !IsValid( nextEnt ) )
		{
			return entityChain
		}
		else if ( nextEnt == startingEnt )
		{
			printt( "Warning: GetEntityChain has a linked ent targeting the starting ent in a loop at " + startingEnt.GetOrigin() )
			return entityChain
		}
		else
		{
			entityChain.append( nextEnt )
		}

		currentEnt = nextEnt
	}

	unreachable
}


array<entity> function GetEntityChainOfType( entity startingEnt )
{
	array<entity> entityChain
	string curEntType = TryGetEditorClass_ElseGetEntityClass( startingEnt )
	string nextEntType
	entity currentEnt = startingEnt
	array<entity> nextEnts
	array<entity> processedEnts
	entityChain.append( startingEnt )

	while ( true )
	{
		nextEnts = currentEnt.GetLinkEntArray()
		int numNextEnts = nextEnts.len()
		for ( int i = numNextEnts - 1; i >= 0; i-- )
		{
			nextEntType = TryGetEditorClass_ElseGetEntityClass( nextEnts[ i ] )
			if ( nextEntType != curEntType )
				nextEnts.fastremove( i )
			// Handle bidirectional chains
			else if ( processedEnts.contains( nextEnts[ i ] ) )
				nextEnts.fastremove( i )
		}

		int numFilteredEnts = nextEnts.len()

		if ( numFilteredEnts > 1 )
		{
			Assert( false, "Warning! Cannot get entity chain of type: " + curEntType + ". Entity chain has branching paths of given type." )
			return entityChain
		}
		else if ( numFilteredEnts == 0 )
		{
			return entityChain
		}

		processedEnts.append( currentEnt )
		entity nextEnt = nextEnts[ 0 ]
		entityChain.append( nextEnt )
		currentEnt = nextEnt
	}

	unreachable
}




string function TryGetEditorClass_ElseGetEntityClass( entity ent )
{
	string result = GetEditorClass( ent )
	if ( result == "" )
		result = ent.GetClassName()

	return result
}

