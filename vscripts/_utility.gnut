void function Remote_CallFunction_QueueForNoKillCam( entity player, string functionName, ...  )
{
	//Remote_CallFunction_NonReplay( player, "ShGameMode_GlowZones_ServerCallback_AnnouncementSplash" )
	//void Remote_CallFunction_NonReplay( player, functionName, [param1], [param2], [param3], ... )    ParameterMask:[.es]

	array< var > params
	for ( int i = 0; i < vargc; i++ )
	{
		params.append( vargv[i] )
	}

	thread QueueForNoKillCam_thread( player, functionName, params )
}

void function QueueForNoKillCam_thread( entity player, string functionName, array< var > params )
{
	player.EndSignal( "OnDestroy" )

	if ( player.IsWatchingKillReplay() )
	{
		player.WaitSignal( "KillreplayFinished" )
	}
	
	QueueForNoKillCam_CallFunction( player, functionName, params )
}

void function QueueForNoKillCam_CallFunction( entity player, string functionName, array< var > params )
{
	switch( params.len() )
	{
		case 0:
			Remote_CallFunction_NonReplay( player, functionName )
			break

		case 1:
			Remote_CallFunction_NonReplay( player, functionName, params[0] )
			break

		case 2:
			Remote_CallFunction_NonReplay( player, functionName, params[0], params[1] )
			break

		case 3:
			Remote_CallFunction_NonReplay( player, functionName, params[0], params[1], params[2] )
			break

		default:
			Assert( false, "Remote_CallFunction_QueueForNoKillCam called with too many parameter, extend the switch statement in QueueForNoKillCam_CallFunction to handle this many. Num Params = " + params.len() )
	}
}


bool function GenericPropCanUse( entity player )
{
	if ( player.Anim_IsActive() )
		return false
	if ( player.ContextAction_IsBusy() )
		return false
	if ( player.ContextAction_IsActive() )
		return false
	if ( !player.IsOnGround() )
		return false
	if ( player.IsSliding() )
		return false
	if ( player.IsTraversing() )
		return false
	if ( player.IsMantling() )
		return false
	if ( player.IsWallRunning() )
		return false
	if ( player.IsWallHanging() )
		return false
	if ( player.IsPhaseShifted() )
		return false
	if ( player.Player_IsSkywardFollowing() )
		return false
	if ( player.Player_IsSkywardLaunching() )
		return false
	if ( StatusEffect_HasSeverity( player, eStatusEffect.placing_phase_tunnel ) )
		return false
	if ( player.GetParent() != null )
		return false
	if ( player.GetPlayerNetBool( "isHealing" ) )
		return false
	if ( player.IsUsingOffhandWeapon( eActiveInventorySlot.mainHand ) )
		return false
	if ( player.IsUsingOffhandWeapon( eActiveInventorySlot.altHand ) )
		return false
	if ( !IsAlive( player ) )
		return false
	if( Bleedout_IsBleedingOut( player ) )
		return false

	return true
}

