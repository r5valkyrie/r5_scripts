void function AvoidBeingPutInsideDoorFromCrush( entity door, entity pushed )
{
	if ( IsValid( door ) )
	{
		int doorType = GetDoorType( door )

		//Large sliding doors are classified as "PLAIN".  For those we want to move the pushed entity out of the way.
		//Any other door type should be a swing door, in which case we won't bother moving and just let us ignore the crush kill as part of setting up SetDoOnBeingCrushedEntityCallback() and AddCallback_OnEntityBeingCrushed()
		switch ( GetDoorType( door ) )
		{
			case eDoorType.PLAIN:
				#if DEVELOPER
				if ( AvoidCrushedByPlainDoorDebug )
				{
					//DebugDrawMark( door.GetOrigin(), 15, <255, 0, 0>, true, 15.0 )
					//DebugDrawArrow( door.GetOrigin(), (door.GetOrigin() + (door.GetForwardVector() * 30)), 10, <0, 0, 255>, true, 15.0 )
				}
				#endif

				vector doorToPushed = Normalize( pushed.GetOrigin() - door.GetOrigin() )
				float doorToPushedDotDoorForward = DotProduct( door.GetForwardVector(), doorToPushed )

				#if DEVELOPER
				if ( AvoidCrushedByPlainDoorDebug )
				{
					printt( FUNC_NAME() + " entToDoorToForwardDot: " + doorToPushedDotDoorForward )
				}
				#endif

				vector pushDir = ( doorToPushedDotDoorForward > 0.0 ) ? door.GetForwardVector() : -door.GetForwardVector()

				//ensure its square or else the trace will fail.  Seer ult has a non square mins/maxs, tech art could maybe fix?
				vector mins = pushed.GetBoundingMins()
				vector maxs = pushed.GetBoundingMaxs()

				float maxMinsXY = min( mins.x, mins.y )
				float maxMaxsXY = max( maxs.x, maxs.y )

				//half the bounding box since we're trying to get out of a tight position.
				mins = <maxMinsXY, maxMinsXY, mins.z> * 0.5
				maxs = <maxMaxsXY, maxMaxsXY, mins.z> * 0.5

				float fabsZ = fabs( mins.z ) + fabs( maxs.z )
				vector zOffSet = <0.0, 0.0, fabsZ>

				vector startPos = pushed.GetOrigin()
				vector targetPos = startPos + ( pushDir * maxMaxsXY )
				array<entity> ignoreList = [pushed, door]

				TraceResults trace = TraceHull( startPos, targetPos, mins, maxs, ignoreList, TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_NONE )

				#if DEVELOPER
				if ( AvoidCrushedByPlainDoorDebug )
				{
					//DebugDrawArrow( startPos, targetPos, 10, COLOR_DARK_BLUE, false, 15.0)
				}
				#endif

				int traceAttempts = 0

				while ( ( trace.startSolid || trace.allSolid )  && traceAttempts <= 5 )
				{
					startPos = targetPos
					targetPos = startPos + ( pushDir * maxMaxsXY )

					#if DEVELOPER
					if ( AvoidCrushedByPlainDoorDebug )
					{
						//DebugDrawArrow( startPos, targetPos, 10, COLOR_DARK_BLUE, false, 15.0)
					}
					#endif

					//check for ground so that our hullTrace doesn't just keep getting caught on the ground as we move along pushDir.
					trace = TraceHull( startPos + zOffSet, targetPos, mins, maxs, ignoreList, TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_NONE )

					#if DEVELOPER
						if ( AvoidCrushedByPlainDoorDebug )
						{
							//DebugDrawArrow( startPos, targetPos, 10, COLOR_DARK_BLUE, false, 15.0)
							//DebugDrawBoxSimple( startPos + zOffSet, mins, maxs, COLOR_LIGHT_BLUE, 25, 15.0 )
							//DebugDrawBoxSimple( targetPos, mins, maxs, <0, 0, 255>, 25, 15.0 )
						}
					#endif

					if ( !trace.startSolid && !trace.allSolid )
					{
						startPos.z = trace.endPos.z
						targetPos.z = trace.endPos.z

						#if DEVELOPER
						if ( AvoidCrushedByPlainDoorDebug )
						{
							//DebugDrawMark( trace.endPos, 10, <0, 255, 0>, true, 15.0 )
						}
						#endif
					}

					trace = TraceHull( startPos, targetPos, mins, maxs, ignoreList, TRACE_MASK_SOLID_BRUSHONLY, TRACE_COLLISION_GROUP_NONE )
					traceAttempts++
				}

				if ( !trace.startSolid && !trace.allSolid )
					pushed.SetOrigin( trace.endPos )

				break
			case eDoorType.UNKNOWN:
			case eDoorType.MODEL:
			case eDoorType.MOVER:
			case eDoorType.SLIDING:
			case eDoorType.BLOCKABLE:
			case eDoorType.CODE:
			default:
				break
		}
	}
}

void function CancelPlayerStates( entity player, CancelPlayerStatesData data )
{
	if ( !IsValid( player ) )
		return

	if ( data.cancelZipline )
	{
		if ( player.IsZiplining() )
			player.Zipline_Stop()
	}

	if ( data.cancelGrapple )
		player.GrappleDetach()

	if ( data.cancelPhaseTunnel && StatusEffect_HasSeverity( player, eStatusEffect.placing_phase_tunnel ) )
		player.Signal( "PhaseTunnel_CancelPlacement" )

	if ( data.cancelPhaseWalk && player.IsPhaseShiftedOrPending() )
		player.PhaseShiftCancel()

	if ( data.cancelRevive )
		Bleedout_ReviveForceStop( player )

	if ( data.cancelHuntMode )
		player.Signal("HuntMode_ForceAbilityStop")

	//if crypto in flying around in his drone, get out
	if ( data.cancelCryptoDrone && !player.IsBot() && IsValid( player.p.cryptoActiveCamera ) )
		player.p.cryptoActiveCamera.Destroy()

	if ( data.cancelTotem )
		CancelDeathTotemForPlayer( player )

                                
                        
                                       
      

	if( data.cancelBleedOut )
	{
		Bleedout_ForceStop( player )
		BleedoutState_SetPlayerBleedoutState( player, BS_NOT_BLEEDING_OUT )
	}

	// cancel any currently active ability
	array <entity> activeWeapons = player.GetAllActiveWeapons()

	if ( activeWeapons.len() > 0 && data.cancelMainOrAltHandAbility )
	{
		array<string> mainHandWeaponsToCheck
		mainHandWeaponsToCheck.append( CAUSTIC_DIRTY_BOMB_WEAPON_CLASS_NAME )
		mainHandWeaponsToCheck.append( "mp_weapon_grenade_gas" )
		mainHandWeaponsToCheck.append( "mp_weapon_grenade_creeping_bombardment" )
		mainHandWeaponsToCheck.append( "mp_weapon_grenade_defensive_bombardment" )
                     
                                                                             
                                                                
        
		mainHandWeaponsToCheck.append( "mp_weapon_deployable_medic" )
		mainHandWeaponsToCheck.append( "mp_ability_care_package" )
		mainHandWeaponsToCheck.append( "mp_weapon_zipline" )
		mainHandWeaponsToCheck.append( "mp_weapon_tesla_trap" )
		mainHandWeaponsToCheck.append( "mp_weapon_trophy_defense_system" )
		mainHandWeaponsToCheck.append( BUBBLE_BUNKER_WEAPON_NAME )
		//mainHandWeaponsToCheck.append( "mp_weapon_phase_tunnel" )
		//mainHandWeaponsToCheck.append( "mp_ability_phase_walk" )

		array<string> altHandWeaponsToCheck
		altHandWeaponsToCheck.append( "mp_weapon_grenade_bangalore" )
		altHandWeaponsToCheck.append( "mp_ability_silence" )
		altHandWeaponsToCheck.append( "mp_ability_gibraltar_shield" )
		altHandWeaponsToCheck.append( HEARTBEAT_SENSOR_WEAPON_NAME )

		bool shouldClearOffhand = false
		int inventorySlot = eActiveInventorySlot.mainHand
		entity mainWeapon = activeWeapons[0]

		if ( IsValid( mainWeapon ) )
		{
			foreach ( string weaponClassName in mainHandWeaponsToCheck )
			{
				if ( mainWeapon.GetWeaponClassName() == weaponClassName )
				{
					shouldClearOffhand = true
					inventorySlot = eActiveInventorySlot.mainHand
					break
				}
			}
		}

		if ( activeWeapons.len() > 1 && !shouldClearOffhand )
		{
			entity offhandWeapon = activeWeapons[1]

			if ( IsValid( offhandWeapon ) )
			{
				foreach ( string weaponClassName in altHandWeaponsToCheck )
				{
					if ( offhandWeapon.GetWeaponClassName() == weaponClassName )
					{
						shouldClearOffhand = true
						inventorySlot = eActiveInventorySlot.altHand
						break
					}
				}
			}
		}

		if ( shouldClearOffhand )
			player.ClearOffhand( inventorySlot )
	}
}

void function FlashBang_Flash( entity victim, float flashScalar, float duration, float fadeTime, float delay = 0.2 )
{
	victim.EndSignal( "OnDeath" )
	victim.EndSignal( "OnDestroy" )

	wait delay

	int flashAlpha = int ( 255 * flashScalar )
	ScreenFade( victim, 255, 255, 255, flashAlpha, fadeTime, duration, FFADE_IN | FFADE_PURGE )

	if ( flashScalar >= 0.5 )
	{
		int attachmentID = victim.LookupAttachment( "CHESTFOCUS" )
		int fxID = GetParticleSystemIndex( FLASH_BANG_BLIND_TEMP_FX )
		entity fx = StartParticleEffectOnEntity_ReturnEntity ( victim, fxID, FX_PATTACH_POINT_FOLLOW, attachmentID )

		OnThreadEnd(
			function() : ( fx )
			{
				if ( IsValid( fx ) )
					EffectStop( fx )
			}
		)
	}

	wait duration

}


