void function ForceAutoSprintOn( entity player )
{
	// printt( FUNC_NAME( 0 ) + " from " + FUNC_NAME( 1 ) )
	// printt( "Player = " + player.GetPlayerName() + ", current count = " + player.p.forceAutoSprintCount )
	Assert( player.p.forceAutoSprintCount >= 0 )

	player.p.forceAutoSprintCount += 1

	if ( player.p.forceAutoSprintCount == 1 )
	{
		player.ForceAutoSprintOn()
	}
}

void function ForceAutoSprintOff( entity player )
{
	// printt( FUNC_NAME( 0 ) + " from " + FUNC_NAME( 1 ) )
	// printt( "Player = " + player.GetPlayerName() + ", current count = " + player.p.forceAutoSprintCount )
	Assert( player.p.forceAutoSprintCount > 0 )

	player.p.forceAutoSprintCount -= 1

	if ( player.p.forceAutoSprintCount == 0 )
	{
		player.UnforceAutoSprint()
	}
}

entity function FindScriptNameInChildren ( entity ent, string scriptName )
{
	if (!IsValid(ent))
		return null
	else if ( ent.GetScriptName() == scriptName )
		return ent

	array<entity> children = GetChildren( ent )
	for ( int i = 0; i < children.len(); i++ )
	{
		entity result = FindScriptNameInChildren( children[i], scriptName )
		if ( result != null )
		{
			return result
		}
	}
	return null
}

entity function FindTargetNameInChildren ( entity ent, string targetName )
{
	if (!IsValid(ent))
		return null
	else if ( ent.GetTargetName() == targetName )
		return ent

	array<entity> children = GetChildren( ent )
	for ( int i = 0; i < children.len(); i++ )
	{
		entity result = FindTargetNameInChildren( children[i], targetName )
		if ( result != null )
		{
			return result
		}
	}
	return null
}


