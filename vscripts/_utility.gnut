#if SERVER
void function SpawnAmmoForCurrentWeapon( entity victim, var attackerDamageInfo = null, float ammoCountMultiplier = 1.0  )
{
	if ( SURVIVAL_Loot_IsAmmoSpawningDisabled() )
		return

	LootThrowData throwData
	throwData.throwAngle = 0
	throwData.throwScale = 1
	vector throwOrigin = victim.GetOrigin()

	if ( attackerDamageInfo != null )
	{
		entity attacker = DamageInfo_GetAttacker( attackerDamageInfo )
		if ( !IsValid( attacker ) )
		{
			return
		}
		entity damageWeapon = SURVIVAL_GetLastActiveWeapon( attacker )
		//entity damageWeapon = DamageInfo_GetWeapon( attackerDamageInfo )
		if ( IsValid( damageWeapon ) && damageWeapon.GetActiveAmmoSource() == AMMOSOURCE_POOL )
		{
			string ammoType = GetWeaponAmmoTypeFromWeaponEnt( damageWeapon )

			int dropCount = 1

			for ( int i = 0; i < dropCount; i++ )
			{
				int countPerDrop = int( floor( SURVIVAL_Loot_GetLootDataByRef( ammoType ).countPerDrop ) )
				countPerDrop = int ( countPerDrop * ammoCountMultiplier )

				entity itemEnt = SpawnGenericLoot( ammoType, throwOrigin, < -1, -1, -1 >, countPerDrop )

				if ( victim.IsPlayer() )
				{
					SetItemSpawnSource( itemEnt, eSpawnSource.PLAYER_DEATH, victim )
				}
				else {
					SetItemSpawnSource( itemEnt, eSpawnSource.NPC_DEATH, victim )
				}
				vector throwDir = <sin( throwData.throwAngle ), cos( throwData.throwAngle ), 0>
				float speed     = throwData.throwScale * sqrt( RandomFloatRange( 0.75, 1.0 ) ) * 150
				vector vel      = throwDir * speed
				thread FakePhysicsThrow( victim, itemEnt, <vel.x, vel.y, 200>, true )
				throwData = SURVIVAL_DropLoot_IncrementThrowAngle( throwData )
			}
		}
	}
}

void function SpawnAmmoForRandomWeapon( entity victim, var attackerDamageInfo = null, float ammoCountMultiplier = 1.0, bool spawnLootInSafeLocation = false )
{
	if ( SURVIVAL_Loot_IsAmmoSpawningDisabled() )
		return

	LootThrowData throwData
	throwData.throwAngle = RandomFloat( 360 )
	throwData.throwScale = 1
	vector throwOrigin = victim.GetOrigin()
	if ( spawnLootInSafeLocation )
	{
		throwOrigin = GetSafeLocation( throwOrigin )
		//adding in some vertical height, so that the ammo can disperse naturally
		throwOrigin += <0, 0, 32>
	}

	int stowedWeaponAmmoSpawnPct = GetPlaylistVarInt( GetCurrentPlaylistName(), "armory_second_ammo_stowed_weapon_pct", 75 )

	if ( attackerDamageInfo != null )
	{
		entity attacker = DamageInfo_GetAttacker( attackerDamageInfo )
		if ( !IsValidPlayer( attacker ) )
		{
			return
		}
		entity randomWeapon = SURVIVAL_GetLastActiveWeapon( attacker )
		entity otherWeapon = GetOtherWeapon ( randomWeapon, attacker )

		if( IsValid( otherWeapon ) && RandomInt( 100 ) > stowedWeaponAmmoSpawnPct )
		{
			randomWeapon = otherWeapon
		}

		//entity randomWeapon = DamageInfo_GetWeapon( attackerDamageInfo )
		// Shicks: Changed from Ammo Pool to anything BUT stockpile to enable Ballistic Ult'd legends to trigger this
		if ( IsValid( randomWeapon ) && randomWeapon.GetActiveAmmoSource() != AMMOSOURCE_STOCKPILE )
		{
			string ammoType = GetWeaponAmmoTypeFromWeaponEnt( randomWeapon )

			int dropCount = 1

			for ( int i = 0; i < dropCount; i++ )
			{
				int countPerDrop = int( floor( SURVIVAL_Loot_GetLootDataByRef( ammoType ).countPerDrop ) )
				countPerDrop = int ( countPerDrop * ammoCountMultiplier )

				entity itemEnt = SpawnGenericLoot( ammoType, throwOrigin, < -1, -1, -1 >, countPerDrop )

				if ( victim.IsPlayer() )
				{
					SetItemSpawnSource( itemEnt, eSpawnSource.PLAYER_DEATH, victim )
				}
				else {
					SetItemSpawnSource( itemEnt, eSpawnSource.NPC_DEATH, victim )
				}
				vector throwDir = <sin( throwData.throwAngle ), cos( throwData.throwAngle ), 0>
				float speed     = throwData.throwScale * sqrt( RandomFloatRange( 0.75, 1.0 ) ) * 150
				vector vel      = throwDir * speed
				thread FakePhysicsThrow( victim, itemEnt, <vel.x, vel.y, 200>, true )
				throwData = SURVIVAL_DropLoot_IncrementThrowAngle( throwData )
			}
		}
	}
}
// Spawn loot on an entity and return an array of the loot that got spawned
array <entity> function SpawnAndThrowItems_ReturnItems( entity itemSource, string itemName, int itemCount, float throwStrength, int spawnSource, vector throwOriginOffset = < 0, 0, 0 > )
{
	array < entity > spawnedItems = []
	if ( !IsValid( itemSource ) )
		return spawnedItems

	LootThrowData throwData
	throwData.throwAngle = 0
	throwData.throwScale = 1
	vector throwOrigin = itemSource.GetOrigin() + throwOriginOffset

	int countPerDrop = int( floor( SURVIVAL_Loot_GetLootDataByRef( itemName ).countPerDrop ) )
	for ( int i = 0; i < itemCount; i++ )
	{
		entity itemEnt = SpawnGenericLoot( itemName, throwOrigin, < -1, -1, -1 >, countPerDrop )

		SetItemSpawnSource( itemEnt, spawnSource, itemSource )
		throwData.throwAngle = RandomFloatRange( 0.0, 360.0 )
		vector throwDir = <sin( throwData.throwAngle ), cos( throwData.throwAngle ), 0>
		float speed     = throwData.throwScale * sqrt( RandomFloatRange( 0.75, 1.0 ) ) * throwStrength
		vector vel      = throwDir * speed
		thread FakePhysicsThrow( itemSource, itemEnt, <vel.x, vel.y, 200>, true )
		throwData = SURVIVAL_DropLoot_IncrementThrowAngle( throwData )
		spawnedItems.append( itemEnt )
	}

	return spawnedItems
}

#endif
//-----------------------------------------------------------
// SpawnBullseye() - creates a npc_bullseye and attaches it to an entity
//------------------------------------------------------------
entity function SpawnBullseye( int team, entity ent = null )
{
	entity bullseye = CreateEntity( "npc_bullseye" )
	bullseye.SetScriptName( UniqueString( "bullseye" ) )
	bullseye.kv.rendercolor = "255 255 255"
	bullseye.kv.renderamt = 0
	bullseye.kv.health = 9999
	bullseye.kv.max_health = -1
	bullseye.kv.spawnflags = 516
	bullseye.kv.FieldOfView = 0.5
	bullseye.kv.FieldOfViewAlert = 0.2
	bullseye.kv.AccuracyMultiplier = 1.0
	bullseye.kv.physdamagescale = 1.0
	bullseye.kv.WeaponProficiency = eWeaponProficiency.VERYGOOD
	bullseye.kv.minangle = "360"
	bullseye.SetModel( $"mdl/dev/empty_model.rmdl" )
	DispatchSpawn( bullseye )

	SetTeam( bullseye, team )

	if ( ent )
	{
		vector bounds = ent.GetBoundingMaxs()
		bullseye.SetOrigin( ent.GetOrigin() + < 0, 0, bounds.z * 0.5 > )
		bullseye.SetParent( ent )
	}

	return bullseye
}

void function CenterPrint( ... )
{
	string msg = ""
	for ( int i = 0; i < vargc; i++ )
		msg = ( msg + " " + string( vargv[ i ] ) )

	int words = expect int( vargc )
	if ( words < 1 )
		words = 1

	float delay = GraphCapped( float( words ), 2.0, 8.0, 2.1, 3.5 )

	entity ent = CreateGameText( msg, -1, 0.5, 10, "255 255 255", 0.25, 0.25, delay )
	EntFireByHandle( ent, "Display", "", 0, null, null )

	thread DestroyCenterPrint( ent, delay )
}

void function DestroyCenterPrint( entity ent, float delay )
{
	wait( delay )
	ent.Destroy()
}

bool function IsValidPlayer( entity player )
{
	if ( !IsValid( player ) )
		return false

	if ( !player.IsPlayer() )
		return false

	if ( IsDisconnected( player ) )
		return false

	return true
}

bool function IsDisconnected( entity player )
{
	return player.p.isDisconnected
}


#if !DEVELOPER
table function GetPlayerPos( entity player = null )
{
	if ( !player )
		player = gp()[0]

	vector org = player.GetOrigin()
	vector vec = player.GetViewVector()
	vector ang = VectorToAngles( vec )

	return { origin = org, angles = ang }
}


string function CreateOriginAnglesString( vector origin, vector angles )
{
	string returnStr = "< " + origin.x + ", " + origin.y + ", " + origin.z + " >, < " + angles.x + ", " + angles.y + ", " + angles.z + " >"
	return returnStr
}
#endif

string function CreateOriginAnglesString_CC( string name, vector origin, vector angles )
{		
	string returnStr = name + ": NewLocPair( < " + origin.x + ", " + origin.y + ", " + origin.z + " >, < " + angles.x + ", " + angles.y + ", " + angles.z + " > ),";
	return returnStr
}

