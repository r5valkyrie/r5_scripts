void function LockWeaponsAndMelee( entity player, string debug_source = "" )
{
	printt( FUNC_NAME( 0 ) + " from " + FUNC_NAME( 1 ) )
	printt( "Player = " + player.GetPlayerName() + ", current count = " + player.p.weaponsAndMeleeLockedCount )
	if (!( debug_source in player.p.weaponsAndMeleeLockedSources ))
	{
		player.p.weaponsAndMeleeLockedSources[ debug_source ] <- 0
	}
	player.p.weaponsAndMeleeLockedSources[ debug_source ] += 1

	if ( player.p.weaponsAndMeleeLockedCount == 0 )
	{
		player.LockWeaponChange()
		player.DisableWeaponTypes( WPT_MELEE )
	}
	player.p.weaponsAndMeleeLockedCount++
}

void function UnlockWeaponsAndMelee( entity player, string debug_source )
{
	#if DEVELOPER
		// printt( FUNC_NAME( 0 ) + " from " + FUNC_NAME( 1 ) )
		// printt( "Player = " + player.GetPlayerName() + ", current count = " + player.p.weaponsAndMeleeLockedCount )
	#endif
	//player.p.weaponsAndMeleeLockedSources[ debug_source ] -= 1
	//Assert( player.p.weaponsAndMeleeLockedSources[ debug_source ] >= 0, debug_source + " is calling UnlockWeaponsAndMelee too many times" )

	player.p.weaponsAndMeleeLockedCount--
	Assert( player.p.weaponsAndMeleeLockedCount >= 0, "< 0 can cause bugs" )
	if ( player.p.weaponsAndMeleeLockedCount == 0 )
	{
		player.UnlockWeaponChange()
		player.EnableWeaponTypes( WPT_MELEE )
	}
}


