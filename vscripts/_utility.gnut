vector function DropSpawnToFloor( vector point, int hullType )
{
	vector mins        = GetBoundsMin( hullType )
	vector maxs        = GetBoundsMax( hullType )
	vector startPoint  = (point + <0, 0, 50>)
	vector endPoint    = (point - <0, 0, 99999>)
	TraceResults trace = TraceHull( startPoint, endPoint, mins, maxs, null, TRACE_MASK_PLAYERSOLID, TRACE_COLLISION_GROUP_PLAYER )
	if ( trace.startSolid )
		return INVALID_DROP_RESULT
	if ( trace.fraction > 0.9999 )
		return INVALID_DROP_RESULT
	return trace.endPos
}


entity function CreateDeathBox( vector origin, vector angles, string targetName = DEATH_BOX_TARGETNAME, int fadeDistance = 100000 )
//Simple create deathbox function that just creates the prop_dynamic. Survivial, Training, etc all add functionality on top of this.
{
	entity box = CreateEntity( "prop_death_box" )
	box.SetValueForModelKey( DEATH_BOX )
	box.kv.renderamt = 255
	box.kv.rendercolor = "255 255 255"
	box.kv.solid = SOLID_VPHYSICS // 0 = no collision, 2 = bounding box, 6 = use vPhysics, 8 = hitboxes only
	box.SetOrigin( origin )
	box.SetAngles( angles )

	box.EnableRenderAlways()
	box.AllowMantle()
	SetTargetName( box, targetName )
	box.kv.fadedist = fadeDistance

	DispatchSpawn( box )
	return box
}


