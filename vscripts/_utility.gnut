void function RestockPlayerAmmo( entity onlyplayer = null, bool isSilent = false )
{
	array<entity> players
	if ( IsAlive( onlyplayer ) )
		players.append( onlyplayer )
	else
		players = GetPlayerArray_Alive()

	foreach ( player in players )
	{
		player.RefillAllAmmo()

		if ( !isSilent )
			EmitSoundOnEntityOnlyToPlayer( player, player, "Coop_AmmoBox_AmmoRefill" )
	}
}

