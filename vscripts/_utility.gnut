int function GiveHealthAndShieldToPlayer( entity player, int amountPossible )
{
	if ( !IsAlive( player ) )
		return 0

	int remain = amountPossible
	int gave   = 0

	// Health:
	if ( remain > 0 )
	{
		int stockOld  = player.GetHealth()
		int stockMax  = player.GetMaxHealth()
		int stockNeed = (stockMax - stockOld)
		if ( stockNeed > 0 )
		{
			int toGive = minint( remain, stockNeed )
			player.SetHealth( stockOld + toGive )
			remain -= toGive
			gave += toGive
		}
	}

	// Shield:
	if ( remain > 0 )
	{
		int stockOld  = player.GetShieldHealth()
		int stockMax  = player.GetShieldHealthMax()
		int stockNeed = (stockMax - stockOld)
		if ( stockNeed > 0 )
		{
			int toGive = minint( remain, stockNeed )
			player.SetShieldHealth( stockOld + toGive )
			remain -= toGive
			gave += toGive
		}
	}

	return gave
}

// Heal the specified health amount and shield amount at the same time. Unlike GiveHealthAndShieldToPlayer the amount of healing given to health does not affect the amount of healing given to shields.
// Returns the combined total of both health healing and shield healing that took place
int function GiveHealthAndShieldToPlayerSimultaneously( entity player, int healthAmount, int shieldAmount )
{
	if ( !IsAlive( player ) )
		return 0

	int healthHealed = 0
	int shieldHealed = 0

	// Health:
	if ( healthAmount > 0 )
	{
		int currentHealth  = player.GetHealth()
		int maxHealth  = player.GetMaxHealth()
		int missingHealth = maxHealth - currentHealth
		if ( missingHealth > 0 )
		{
			int healthToGive = minint( healthAmount, missingHealth )
			player.SetHealth( currentHealth + healthToGive )
			healthHealed = healthToGive
		}
	}

	// Shield:
	if ( shieldAmount > 0 )
	{
		int currentShield  = player.GetShieldHealth()
		int shieldMax  = player.GetShieldHealthMax()
		int missingShield = shieldMax - currentShield
		if ( missingShield > 0 )
		{
			int shieldToGive = minint( shieldAmount, missingShield )
			player.SetShieldHealth( currentShield + shieldToGive )
			shieldHealed = shieldToGive
		}
	}

	return healthHealed + shieldHealed
}

// Heal Health and Shield up to a set Percentage.
bool function SetHealthAndShieldByPercentage( entity player, float healthPercent, float shieldPercent, bool shouldAllowHealthLoss )
{
	bool didHeal = false

	if ( !IsValid( player ) )
		return didHeal

	if ( healthPercent >= 0.0 )
	{
		#if DEV
			if ( shouldAllowHealthLoss && healthPercent == 0.0 )
				printf( "SetHealthAndShieldByPercentage is being used to set health to 0; if players are dying unexpectedly this could be the cause." )
		#endif // DEV

		int healthMax = player.GetMaxHealth()
		int currentHealth = player.GetHealth()
		int targetHealth = int( healthMax * healthPercent )
		// If shouldAllowHealthLoss is true we don't care what the current health values are, otherwise we only use values that will increase health
		int setHealthAmount = shouldAllowHealthLoss ? targetHealth : maxint( targetHealth, currentHealth )

		if ( setHealthAmount != currentHealth )
		{
			player.SetHealth( setHealthAmount )
			didHeal = true
		}

	}

	if ( healthPercent > 0.0 && didHeal )
	{
		HealthRegen_OnPlayerHealingEnded( player )
	}

	if ( shieldPercent >= 0.0 )
	{
		int shieldMax = player.GetShieldHealthMax()
		int currentShield = player.GetShieldHealth()
		int targetShieldHealth = int( shieldMax * shieldPercent )
		// If shouldAllowHealthLoss is true we don't care what the current shield values are, otherwise we only use values that will increase shield
		int setShieldAmount = shouldAllowHealthLoss ? targetShieldHealth : maxint( targetShieldHealth, currentShield )

		if ( setShieldAmount != currentShield )
		{
			player.SetShieldHealth( setShieldAmount )
			didHeal = true
		}
	}

	return didHeal
}


void function DisableAllWeaponsExceptHandsOrIncap( entity player )
{
	// DumpStack()
	array<entity> weapons = player.GetMainWeapons()
	weapons.extend( player.GetOffhandWeapons() )
	weapons.extend( player.GetAllActiveWeapons() )

	entity utilityWeapon = player.GetNormalWeapon( KNOCKDOWN_SHIELD_SLOT )
	// entity hands = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 )

	foreach ( weaponEnt in weapons )
	{
		if( !IsValid( weaponEnt ) || IsValid( utilityWeapon ) && weaponEnt == utilityWeapon ) //|| IsValid( hands ) && weaponEnt == hands )
			continue
		
		weaponEnt.AllowUse( false )
	}
	
	if( IsValid( utilityWeapon ) )
		utilityWeapon.AllowUse( true )
	
	// if( IsValid( hands ) )
		// hands.AllowUse( true )
}

void function EnableAllWeaponsExceptHandsOrIncap( entity player )
{
	DumpStack()
	array<entity> weapons = player.GetMainWeapons()
	weapons.extend( player.GetOffhandWeapons() )
	weapons.extend( player.GetAllActiveWeapons() )

	entity utilityWeapon = player.GetNormalWeapon( KNOCKDOWN_SHIELD_SLOT )
	// entity hands = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 ) //idk

	foreach ( weaponEnt in weapons )
	{
		if( !IsValid( weaponEnt ) || IsValid( utilityWeapon ) && weaponEnt == utilityWeapon ) //|| IsValid( hands ) && weaponEnt == hands )
			continue
		
		weaponEnt.AllowUse( true )
	}
	
	if( IsValid( utilityWeapon ) )
		utilityWeapon.AllowUse( false )
	
	// if( IsValid( hands ) )
		// hands.AllowUse( true )
}

