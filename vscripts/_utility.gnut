	return script_mover
}

entity function CreateExpensiveScriptMoverModel( asset model, vector origin = <0, 0, 0>, vector angles = <0, 0, 0>, int solidType = 0, float fadeDist = -1 )
{
	entity script_mover = CreateScriptMover_BASE( origin, angles, solidType, model )
	return script_mover
