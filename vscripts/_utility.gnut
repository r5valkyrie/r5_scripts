void function MovementDisable( entity player )
{
	if ( player.p.movementDisabledCount == 0 )
		player.MovementDisable()
	player.p.movementDisabledCount++
}

void function MovementEnable( entity player )
{
	Assert( player.p.movementDisabledCount >= 0, "< 0 can cause bugs" )
	player.p.movementDisabledCount--
	if ( player.p.movementDisabledCount == 0 )
		player.MovementEnable()
}

