void function SetRandomStagingPositionForPlayer( entity player )
{
	array<entity> allHumanSpawnPoints = GetEntArrayByClass_Expensive( "info_spawnpoint_human" )
	if ( allHumanSpawnPoints.len() == 0 )
		return

	entity randomSpawnPoint = allHumanSpawnPoints.getrandom()

	player.SetOrigin( randomSpawnPoint.GetOrigin() )
	player.SetAngles( randomSpawnPoint.GetAngles() )
}

array<entity> function ArrayEntSphere(vector origin, float radius) {
    array<entity> entities
    entity ent = Entities_FindInSphere( null, origin, radius )

    for ( ;; )
    {
        if ( ent == null )
            break
		entities.append( ent )
		printt(ent.GetTargetName())
        ent = Entities_FindInSphere( ent, origin, radius)
    }
    return entities
}

void function RegisterDynamicEntCleanupItem_Parented_Scriptname( string scriptname, void functionref(entity) func = null )
{
	file.dynamicEntCleanupFuncs_Parented_Scriptname[ scriptname ] <- func
}

void function CleanUpPermanentsParentedToDynamicEnt( entity dynamicEnt )
{
	foreach ( entity ent in GetEntityAndAllChildren( dynamicEnt ) )
	{
		if ( !IsValid( ent ) )
			continue
		
		string targetName = ent.GetTargetName()
		string scriptName = ent.GetScriptName()

		if ( targetName in file.dynamicEntCleanupFuncs_Parented_Targetname )
		{
			if ( file.dynamicEntCleanupFuncs_Parented_Targetname[ targetName ] != null )
				file.dynamicEntCleanupFuncs_Parented_Targetname[ targetName ]( ent )
			else
				ent.Destroy()
		}
		else if ( scriptName in file.dynamicEntCleanupFuncs_Parented_Scriptname )
		{
			if ( file.dynamicEntCleanupFuncs_Parented_Scriptname[ scriptName ] != null )
				file.dynamicEntCleanupFuncs_Parented_Scriptname[ scriptName ]( ent )
			else
				ent.Destroy()
		}
	}
}

#if DEVELOPER 
void function Dev_GetMapCenterBasedOnNavmesh()
{
	vector navmeshMaxs, navmeshMins

	const float WORLD_COORD_DEV = 45000
	navmeshMaxs.x = Survival_GetPlaneJumpPointOverMap( < WORLD_COORD_DEV, 0, 5000 >, < -WORLD_COORD_DEV, 0, 5000 > ).x
	navmeshMaxs.y = Survival_GetPlaneJumpPointOverMap( < 0, WORLD_COORD_DEV, 5000 >, < 0, -WORLD_COORD_DEV, 5000 > ).y
	navmeshMins.x = Survival_GetPlaneJumpPointOverMap( < -WORLD_COORD_DEV, 0, 5000 >, < WORLD_COORD_DEV, 0, 5000 > ).x
	navmeshMins.y = Survival_GetPlaneJumpPointOverMap( < 0, -WORLD_COORD_DEV, 5000 >, < 0, WORLD_COORD_DEV, 5000 > ).y

	vector navmeshTopRight = < navmeshMaxs.x, navmeshMaxs.y, 0 >
	vector navmeshBottomRight = < navmeshMaxs.x, navmeshMins.y, 0 >
	vector navmeshBottomLeft = < navmeshMins.x, navmeshMins.y, 0 >
	vector navmeshTopLeft = < navmeshMins.x, navmeshMaxs.y, 0 >
	DebugDrawLine( navmeshTopRight, navmeshBottomRight, 255, 0, 255, true, 100.0 )
	DebugDrawLine( navmeshBottomRight, navmeshBottomLeft, 255, 0, 255, true, 100.0 )
	DebugDrawLine( navmeshBottomLeft, navmeshTopLeft, 255, 0, 255, true, 100.0 )
	DebugDrawLine( navmeshTopLeft, navmeshTopRight, 255, 0, 255, true, 100.0 )

	vector navmeshCenter = ( navmeshMaxs + navmeshMins ) * 0.5
	DebugDrawSphere( navmeshCenter, 1024, 255, 0, 255, true, 100.0, 64 )

	Warning( "Map center (from NAVMESH) coordinates in console! Look for the PINK sphere" )
	printt( "\tMap center (from NAVMESH):", navmeshCenter )
}
#endif 

float function GetWeaponReloadTime( entity weapon, int currentClipCount )
{
	if ( weapon.GetWeaponSettingBool( eWeaponVar.reload_is_segmented ) )
	{
		float totalReloadTime

		if ( currentClipCount > 0 )
			totalReloadTime = weapon.GetWeaponSettingFloat( eWeaponVar.reload_time ) + weapon.GetWeaponSettingFloat( eWeaponVar.reloadsegment_time_end )
		else
			totalReloadTime = weapon.GetWeaponSettingFloat( eWeaponVar.reloadempty_time ) + weapon.GetWeaponSettingFloat( eWeaponVar.reloadsegmentempty_time_end )

		totalReloadTime += (weapon.GetWeaponPrimaryClipCountMax() - currentClipCount) *weapon.GetWeaponSettingFloat( eWeaponVar.reloadsegment_time_loop )
		return totalReloadTime
	}
	else
	{
		return currentClipCount > 0 ? weapon.GetWeaponSettingFloat( eWeaponVar.reload_time ) : weapon.GetWeaponSettingFloat( eWeaponVar.reloadempty_time )
	}

	unreachable
}

