	WeaponStatsStorageWrite_OnUniversalCount( eCountTable.BREAK_INCAP_SHIELD, attacker, weaponEnt, damageInfo, player )

	//validate
	WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.BREAK_INCAP_SHIELD, attacker )
}

// eventKey can also support more logic, e.g. heal_health_or_restore_shield_start
void function WeaponStats_RecordIndependentEventTime( entity player, string eventKey )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	if ( !( player in fileLevel.independentEventTime ) )
		fileLevel.independentEventTime[player] <- {}

	fileLevel.independentEventTime[player][eventKey] <- Time()
}

void function WeaponStats_ClearIndependentEventTime( entity player, string eventKey )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	if ( player in fileLevel.independentEventTime && eventKey in fileLevel.independentEventTime[player] )
		delete fileLevel.independentEventTime[player][eventKey]
}

void function WeaponStatsHook_OnUseHealModStart( entity player, string modName )
{
	if ( IsWeaponStatsDeactivated() )
		return
	switch ( modName )
	{
		case "shield_small":
		case "shield_large":
			WeaponStats_RecordIndependentEventTime( player, RESTORE_SHIELD_START )
			break

		case "health_small":
		case "health_large":
			WeaponStats_RecordIndependentEventTime( player, HEAL_HEALTH_START )
			break

		case "phoenix_kit":
			WeaponStats_RecordIndependentEventTime( player, RESTORE_SHIELD_START )
			WeaponStats_RecordIndependentEventTime( player, HEAL_HEALTH_START )
			break
	}
}

void function WeaponStats_RecordInteractEventTime( entity player, entity playerInteracted, string eventKey, float overrideValue = -1 )
{
	if ( !IsValid( player ) || !player.IsPlayer() || !IsValid( playerInteracted ) || !playerInteracted.IsPlayer() )
		return

	if ( !( player in fileLevel.interactEvents ) )
	{
		fileLevel.interactEvents[player] <- {}
	}

	if ( !( playerInteracted in fileLevel.interactEvents[player] ) )
	{
		InteractEvents events
		fileLevel.interactEvents[player][playerInteracted] <- events
	}

	fileLevel.interactEvents[player][playerInteracted].times[eventKey] <- ( overrideValue == -1 ? Time() : overrideValue )
}

void function WeaponStatsHook_OnWeaponAttack( entity attacker, entity weaponEnt, string weaponName, int ammoUsed, vector attackOrigin, vector attackDir )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !( attacker in fileLevel.weaponStatsStorageSum ) )
		return

	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

#if WEAPON_STATS_DEBUG
	//printt( "WeaponStats:WeaponStatsHook_OnWeaponAttack", attacker, weaponEnt, weaponName, ammoUsed )
#endif

	//clear
	foreach ( si in fileLevel.currentStatInstance[attacker] )
		WeaponStatsUniversalClear( eClearConfig.WEAPON_ATTACK, attacker, si )

	//storage
	WeaponStatsStorageWrite_OnWeaponAttack( attacker, weaponEnt, ammoUsed )
	WeaponStatsStorageWrite_OnFireAmmo( attacker, weaponEnt, ammoUsed )

	//validation
	WeaponStatsValidateStorageCondition_OnFireAmmo( attacker, weaponEnt )

	//clear
	foreach ( si in fileLevel.currentStatInstance[attacker] )
		WeaponStatsUniversalClear( eClearConfig.POST_WEAPON_ATTACK, attacker, si )
}

void function WeaponStatsHook_OnCodeDoorBroken( entity door, entity attacker, vector direction, var damageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	WeaponStats_RecordIndependentEventTime( attacker, BREAK_DOOR )

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	switch ( damageSourceId )
	{
		case eDamageSourceId.mp_weapon_frag_grenade:
		case eDamageSourceId.mp_weapon_grenade_emp:
		case eDamageSourceId.mp_weapon_thermite_grenade:
			WeaponStats_RecordIndependentEventTime( attacker, BREAK_DOOR_WITH_GRENADE )
			break
		case eDamageSourceId.mp_weapon_dragon_lmg:
			WeaponStats_RecordIndependentEventTime( attacker, BREAK_DOOR_WITH_GUN_PREFIX + "mp_weapon_dragon_lmg" )
			break
	}
}

void function WeaponStatsHook_OnPlayerReceivingFirstAid( entity player, entity reviver )
{
	if ( IsWeaponStatsDeactivated() )
		return
	WeaponStats_RecordInteractEventTime( player, reviver, REVIVE_START )
}

void function WeaponStatsHook_OnPlayerGotRevived( entity injured, entity healer )
{
	if ( IsWeaponStatsDeactivated() )
		return
	WeaponStats_RecordIndependentEventTime( injured, REVIVED )
	if ( !IsValid( injured ) || !injured.IsPlayer() || !( injured in fileLevel.weaponStatsStorageSum ) )
		return
	WeaponStatsStorageClear_ReviveAndRespawn( injured )
}

void function WeaponStatsHook_OnZiplineStart( entity player, entity zipline )
{
	if ( IsWeaponStatsDeactivated() )
		return
	WeaponStats_RecordIndependentEventTime( player, START_ZIPLINE )
}

void function WeaponStatsHook_OnReload( entity player )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( player ) || !player.IsPlayer() || !( player in fileLevel.weaponStatsStorageSum ) )
		return
	foreach ( si in fileLevel.currentStatInstance[player] )
		WeaponStatsUniversalClear( eClearConfig.WEAPON_RELOAD, player, si )

	entity mainWeapon = fileLevel.weaponStatsStorageSum[player].mainHandActiveWeapon
	if ( IsValid( mainWeapon ) && mainWeapon.IsWeaponX() )
	{
		WeaponStatsStorageWrite_OnReloadStatistic( player, mainWeapon )
		WeaponStatsStorageWrite_OnUniversalCount( eCountTable.RELOAD, player, mainWeapon )
	}
}

void function WeaponStatsHook_OnRespawned( entity player )
{
	if ( IsWeaponStatsDeactivated() )
		return
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnRespawned:", player.GetPlayerName() )
	#endif
	WeaponStats_RecordIndependentEventTime( player, RESPAWNED )
	if ( !IsValid( player ) || !player.IsPlayer() || !( player in fileLevel.weaponStatsStorageSum ) )
		return
	WeaponStatsStorageClear_ReviveAndRespawn( player )
}

void function WeaponStatsHook_OnPreDamageEnemy( entity victim, entity attacker, var attackerDamageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !IsValid( victim ) || !victim.IsPlayer() )
		return

	//storage
	if ( attacker in fileLevel.weaponStatsStorageSum )
	{
		WeaponStatsStorageWrite_OnVictimExecutingEnemy( attacker, victim )
	}
}

void function WeaponStatsHook_OnDamageEnemy( entity victim, entity attacker, var attackerDamageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	//entity attacker = DamageInfo_GetAttacker( attackerDamageInfo )
	if ( !IsValid( victim ) || !victim.IsPlayer() || !IsValid( attacker ) || !attacker.IsPlayer() )
		return

	WeaponStatsStorageWrite_OnVictimHealthTrace( victim, attackerDamageInfo )
	WeaponStats_RecordInteractEventTime( victim, attacker, BE_DAMAGED )

	entity weaponEnt = DamageInfo_GetWeapon( attackerDamageInfo )
	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() )
		return

	if ( IsBitFlagSet( weaponEnt.GetWeaponTypeFlags(), WPT_PRIMARY ) )
	{
		if ( !( victim in fileLevel.beShotTime ) )
			fileLevel.beShotTime[victim] <- {}

		if ( !( attacker in fileLevel.beShotTime[victim] ) || fileLevel.beShotTime[victim][attacker] + BATTLE_CD_TIME < Time() )
			WeaponStats_RecordInteractEventTime( attacker, victim, DAMAGE_START )

		if ( attacker in fileLevel.beShotTime[victim] )
			WeaponStats_RecordInteractEventTime( attacker, victim, LAST_DAMAGE_TIME, fileLevel.beShotTime[victim][attacker] )
		fileLevel.beShotTime[victim][attacker] <- Time()
	}

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( attackerDamageInfo )
	if ( damageSourceId == eDamageSourceId.mp_weapon_grenade_emp )
	{
		WeaponStats_RecordInteractEventTime( attacker, victim, STICK_WITH_ARC_STAR )
	}

	WeaponStats_RecordInteractEventTime( attacker, victim, WEAPON_DAMAGE + weaponEnt.GetWeaponClassName() )

	if ( !( attacker in fileLevel.weaponStatsStorageSum ) || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

	float effectiveDamage = GetEffectiveDamage( victim, attackerDamageInfo )
#if WEAPON_STATS_DEBUG
	// printt( "WeaponStats:Hook_OnDamageEnemy:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName(), effectiveDamage )
#endif

	//storage
	WeaponStatsStorageWrite_OnUniversalStatistic( eStatisticTable.RAW_DAMAGE, attacker, weaponEnt, effectiveDamage, victim, attackerDamageInfo )
	WeaponStatsStorageWrite_OnDamagedVictim( attacker, weaponEnt, victim, attackerDamageInfo )
	WeaponStatsStorageWrite_OnFireAndHit( attacker, weaponEnt, victim, attackerDamageInfo )
	WeaponStatsStorageWrite_OnDamageInPeriod( victim, attacker, weaponEnt, attackerDamageInfo )
	WeaponStatsStorageWrite_OnDamageAnyVictimInPeriod( victim, attacker, weaponEnt, attackerDamageInfo )
	WeaponStatsStorageWrite_OnUniversalStatistic( eStatisticTable.DAMAGE, attacker, weaponEnt, effectiveDamage, victim, attackerDamageInfo )

	//validate
	WeaponStatsValidateStorageCondition_OnRawDamage( attacker )
	WeaponStatsValidateStorageCondition_UniversalStatistic( eStatisticTable.DAMAGE, attacker )
	WeaponStatsValidateStorageCondition_OnFireAndHit( attacker, weaponEnt )
	WeaponStatsValidateStorageCondition_OnDamageStatisticInPeriod( attacker )
}

void function WeaponStatsHook_OnLootPickup( entity player, entity ent, string ref, int unitsPickedUp, bool willDestroy, entity deathBox, int pickupFlags )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( player ) || !player.IsPlayer() )
		return
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnLootPickup:", player.GetPlayerName(), ref )
	#endif

	bool blackMarketInUseByPlayer = IsValid( GetBlackMarketInUseByPlayer( player ) )

	// track care package openings, ref to CAREER_STATS.neutral_airdrops_looted
	if ( ent.e.spawnSource == eSpawnSource.DROPPOD && !blackMarketInUseByPlayer )
	{
		entity droppod = ent.GetParent()
		if ( IsValid( droppod ) && droppod.e.sourceWeaponClassname == "" )
			WeaponStats_RecordIndependentEventTime( player, NEUTRAL_AIRDROPS_LOOTED )
	}

	if ( ent.e.spawnSource == eSpawnSource.PLAYER_DEATH && !blackMarketInUseByPlayer )
		WeaponStats_RecordIndependentEventTime( player, DEATHBOX_LOOTED )

	WeaponStatsWrite_WeaponPickupTime( player, ref )
}

