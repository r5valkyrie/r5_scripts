void function WeaponStatsHook_OnWeaponHeatStateChanged( entity player, entity weapon, bool currentIsHeated )
{
	if ( IsWeaponStatsDeactivated() )
		return
	printf( "WeaponStatsHook_OnWeaponHeatStateChange player:%s, currentIsHeated:%s", player.GetPlayerName(), currentIsHeated ? "true" : "false" )
	if ( !( player in fileLevel.weaponStatsStorageSum ) )
		return
	if ( !currentIsHeated )
	{
		foreach ( si in fileLevel.currentStatInstance[player] )
			WeaponStatsUniversalClear( eClearConfig.WEAPON_HEAT_DECREASE, player, si )
	}
	else
	{
		WeaponStatsStorageWrite_OnUniversalCount( eCountTable.KEEP_FULLY_HEATED, player, weapon )
	}
}

