void function RefreshParseCheck( int mask )
{
#if DEV
	fileLevel.currentParseMask = mask
	fileLevel.currentParseParams = 0
#endif
}

void function AddParamForChecking( int param )
{
#if DEV
	fileLevel.currentParseParams = fileLevel.currentParseParams | param
#endif
}

void function CheckParamsInHook()
{
#if DEV
	if ( fileLevel.currentParseMask < 0 )
		return
	Assert ( ( fileLevel.currentParseMask & fileLevel.currentParseParams ) == fileLevel.currentParseParams, format( "Incorrect condition used: Hook: %d; Param: %d", fileLevel.currentParseMask, fileLevel.currentParseParams ) )
#endif
}
