bool function ShouldDeactivateWeaponStats()//referenced from PlayerIsValidForStats and IsValidMapForStats
{
	if ( !Mastery_IsEnabled() )
		return true

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return true

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return true

	if ( IsLobby() )
		return true

	if ( IsPrivateMatch() )
		return true

	                            
		if ( IsOrientationMatch() )
			return true
       

	return false
	//return GetGameState() < eGameState.Playing
}

bool function IsWeaponStatsDeactivated()
{
	return Mastery_IsStatTurnOff() || fileLevel.isWeaponTrialDeactivated
}

void function WeaponStatsInit()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel
	fileLevel.isWeaponTrialDeactivated = ShouldDeactivateWeaponStats()

	AddCallback_OnPlayerWeaponSwitched( WeaponStatsHook_OnPlayerWeaponSwitched )
	AddCallback_OnPlayerShieldBreak( WeaponStatsHook_OnPlayerShieldBreak )
	AddCallback_OnNPCKilled( WeaponStatsHook_OnKillNpc )
	AddCallback_OnWeaponAttack( WeaponStatsHook_OnWeaponAttack )
	AddCallback_OnCodeDoorBroken( WeaponStatsHook_OnCodeDoorBroken )
	Bleedout_AddCallback_OnPlayerStartReceiveFirstAid( WeaponStatsHook_OnPlayerReceivingFirstAid )
	Bleedout_AddCallback_OnPlayerGotFirstAid( WeaponStatsHook_OnPlayerGotRevived )
	AddCallback_ZiplineStart( WeaponStatsHook_OnZiplineStart )
	AddCallback_OnPlayerReload( WeaponStatsHook_OnReload )
	AddCallback_OnPlayerRespawned( WeaponStatsHook_OnRespawned )
	Loot_AddCallback_OnPlayerLootPickup( WeaponStatsHook_OnLootPickup )
	AddCallback_GameStateEnter( eGameState.WinnerDetermined, WeaponStatsHook_OnWinnerDetermined )
	//Loot_AddCallback_OnWeaponAttachmentChanged( WeaponStatsHook_OnWeaponAttachmentChanged )

	InitMaxAttachmentLevel()
	InitWeaponStatsConfig()
}

void function InitPlayerStorage( entity player )
{
	if ( !( player in fileLevel.weaponStatsStorageSum ) )
	{
		WeaponStatsStorage storage
		for ( int i = 0; i < eCountTable.len(); i++ )
			storage.Count.append( {} )
		for ( int i = 0; i < eStatisticTable.len(); i++ )
			storage.Statistic.append( {} )
		fileLevel.weaponStatsStorageSum[player] <- storage

		AddButtonReleasedPlayerInputCallback( player, IN_ATTACK, WeaponStatsHook_OnTriggerReleased )
	}
	if ( !( player in fileLevel.currentStatInstance ) )
		fileLevel.currentStatInstance[player] <- []
}

ItemFlavor ornull function WeaponEntityToItemFlavor( entity weapon )
{
	string weaponClassNameOrNull = weapon.GetWeaponClassName()
	return GetWeaponItemFlavorByClass( weaponClassNameOrNull )
}

void function WeaponStatsHook_OnPlayerWeaponSwitched( entity player, entity newWeapon, entity oldWeapon )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( player ) || !player.IsPlayer() )
		return
	InitPlayerStorage( player )

	WeaponStatsStorageWrite_FinishRecordWeaponHoldTime( player )

	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( newWeapon ) || activeWeapon != newWeapon )
		return
	ItemFlavor ornull weaponOrNull = WeaponEntityToItemFlavor( newWeapon )
	if ( weaponOrNull == null )
		return
	ItemFlavor weapon = expect ItemFlavor( weaponOrNull )
	fileLevel.currentStatInstance[player] <- Mastery_GetValidStatArray( player, weapon )

	fileLevel.weaponStatsStorageSum[player].mainHandActiveWeapon = newWeapon
	WeaponStatsStorageWrite_StartRecordWeaponHoldTime( player, newWeapon )
	WeaponStats_RecordIndependentEventTime( player, WEAPON_SWITCH )
	WeaponStatsStorageClear_WeaponSwitched( player, newWeapon, oldWeapon )

	#if WEAPON_STATS_DEBUG
		//printt( "WeaponStats:RefreshStatInstance", player.GetPlayerName(), newWeapon.GetWeaponClassName() )
	#endif

	WeaponStats_UpdateTrace( player )
}

void function WeaponStats_UpdateTrace( entity player )
{
	bool needTraceRotation = false
	foreach ( si in fileLevel.currentStatInstance[player] )
		if ( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.TRACE_ROTATION] )
			needTraceRotation = true

	fileLevel.needTraceRotation[ player ] <- needTraceRotation

	if ( !fileLevel.traceThreadRunning && needTraceRotation )
	{
		fileLevel.traceThreadRunning = true
		thread WeaponStats_TraceRotation_Thread()
	}
}

void function WeaponStats_TraceRotation_Thread()
{
	const float TRACE_INTERVAL = 0.2

	while ( true )
	{
		wait( TRACE_INTERVAL )

		if ( IsWeaponStatsDeactivated() )
			break

		bool needTrace = false

		foreach ( player, needTraceRotation in fileLevel.needTraceRotation )
		{
			if ( !needTraceRotation || !IsValid( player ) )
				continue

			needTrace = true
			WeaponStatsStorageWrite_OnTraceRotation( player, player.GetAngles() )
		}

		if ( !needTrace )
			break
	}

	fileLevel.traceThreadRunning = false
}

void function WeaponStatsStorageWrite_OnTraceRotation( entity player, vector rotation )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( !( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.TRACE_ROTATION] ) )
			continue

		if ( !( si in fileLevel.weaponStatsStorageSum[player].RotationTraceInfo ) )
			fileLevel.weaponStatsStorageSum[player].RotationTraceInfo[si] <- {}

		if ( !( player in fileLevel.weaponStatsStorageSum[player].RotationTraceInfo[si] ) )
			fileLevel.weaponStatsStorageSum[player].RotationTraceInfo[si][player] <- InitRotationRingBuffer( ROTATION_RING_BUFFER_SIZE )

		WriteRotationRingBuffer( fileLevel.weaponStatsStorageSum[player].RotationTraceInfo[si][player], rotation )

		if ( FullRotationCheck( fileLevel.weaponStatsStorageSum[player].RotationTraceInfo[si][player] ) )
			WeaponStats_RecordIndependentEventTime( player, FULL_ROTATION )
	}
}

bool function FullRotationCheck( RotationRingBuffer buf )
{
	const float MAX_DELTA_ROTATION_DEGREE = 180.0
	const float FULL_ROTATION_DEGREE = 360.0

	float sumOfDeltaY = 0
	int bufLen        = buf.rotationDatas.len()
	for ( int i = 0; i < bufLen - 1; i++ )
	{
		int checkIndex = (buf.latest - i + bufLen) % bufLen
		int preIndex   = (checkIndex - 1 + bufLen) % bufLen
		float deltaY   = buf.rotationDatas[checkIndex].rotation.y - buf.rotationDatas[preIndex].rotation.y
		if ( deltaY > MAX_DELTA_ROTATION_DEGREE )
			deltaY -= FULL_ROTATION_DEGREE
		if ( -deltaY > MAX_DELTA_ROTATION_DEGREE )
			deltaY += FULL_ROTATION_DEGREE
		sumOfDeltaY += deltaY

		if ( sumOfDeltaY > FULL_ROTATION_DEGREE || -sumOfDeltaY > FULL_ROTATION_DEGREE )
			return true
	}

	return false
}

