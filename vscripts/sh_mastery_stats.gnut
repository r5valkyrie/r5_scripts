void function WeaponStatsStorageWrite_StartRecordWeaponHoldTime( entity player, entity weapon )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:StorageWrite_StartRecordWeaponHoldTime", player.GetPlayerName(), weapon.GetWeaponClassName() )
	#endif
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.HOLD_TIME] )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME] ) )
				fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME][si] <- 0
			fileLevel.weaponStatsStorageSum[player].LastHoldTimeSi = si
			break
		}
	}
}

void function WeaponStatsStorageWrite_FinishRecordWeaponHoldTime( entity player )
{
	if ( !( player in fileLevel.weaponStatsStorageSum ) || fileLevel.weaponStatsStorageSum[player].LastHoldTimeSi == null )
		return
	StatInstance lastHoldTimeSi = expect StatInstance( fileLevel.weaponStatsStorageSum[player].LastHoldTimeSi )
	if ( lastHoldTimeSi in fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME] )
	{
		fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME][lastHoldTimeSi] += Time() - GetTargetEventTime( player, WEAPON_SWITCH )
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:StorageWrite_FinishRecordWeaponHoldTime:", player.GetPlayerName(), lastHoldTimeSi.description, fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME][lastHoldTimeSi] )
		#endif
		fileLevel.weaponStatsStorageSum[player].LastHoldTimeSi = null
	}
}

float function GetEffectiveDamage( entity victim, var attackerDamageInfo )
{
	// effective damage must limit to victim's health
	return min( victim.GetHealth()+victim.GetShieldHealth(), DamageInfo_GetDamage( attackerDamageInfo ) )
}

void function WeaponStatsStorageWrite_OnContinuousDownCount( entity player, entity weaponEnt, entity victim, var damageInfo = null )
{
	ItemFlavor ornull weaponOrNull = WeaponEntityToItemFlavor( weaponEnt )
	if ( weaponOrNull == null )
		return
	ItemFlavor weapon = expect ItemFlavor( weaponOrNull )
	// extra process for ContinuousWeaponDownCount, maybe refactor later
	if ( fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownGuid != 0 && weapon.guid != fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownGuid && fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownSi in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN] )
	{
		// down enemy with different weapon will break continuity, clear trace and count
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:StorageWrite_OnDownEnemyCount:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), "break continuity", fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN][fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownSi] )
		#endif
		fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownSi].clear()
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN][fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownSi] = 0
	}

	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		// extra process for ContinuousWeaponDownCount, maybe refactor later
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.CONTINUOUS_DOWN] )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace ) )
				fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si] <- []

			if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN] ) )
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN][si] <- 0

			if ( fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].len() == fileLevel.weaponStatsConfigs.validateCondition_Count[si] )
				fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].remove( 0 )

			if ( !( si in fileLevel.weaponStatsStorageSum[player].AmmoUsed ) )
				fileLevel.weaponStatsStorageSum[player].AmmoUsed[si] <- 0

			fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].append( fileLevel.weaponStatsStorageSum[player].AmmoUsed[si] )

			if ( ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.CONTINUOUS_DOWN][si], si, player, weaponEnt, victim, damageInfo ) )
			{
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN][si]++

				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:StorageWrite_OnDownEnemyCount:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), "ContinuousWeaponDownCount", fileLevel.weaponStatsStorageSum[player].Count[eCountTable.CONTINUOUS_DOWN][si] )
				#endif
			}

			fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownSi = si
			fileLevel.weaponStatsStorageSum[player].LastContinuousWeaponDownGuid = weapon.guid
		}
	}
}

void function WeaponStatsStorageWrite_OnUniversalCount( int countTable/*eCountTable*/, entity player, entity weaponEnt = null, var damageInfo = null, entity ornull victim = null, int increment = 1 )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[countTable] )
		{
			if ( ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Count[countTable][si], si, player, weaponEnt, victim, damageInfo ) )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:StorageWrite_OnUniversalCount:", countTable, player.GetPlayerName() )
				#endif
				if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[countTable] ) )
					fileLevel.weaponStatsStorageSum[player].Count[countTable][si] <- 0
				fileLevel.weaponStatsStorageSum[player].Count[countTable][si] += increment
			}
		}
	}
}

bool function WeaponStatsCondition_ReloadTimesWithin( entity player, StatInstance si, int times, bool isExact, bool clear = false )
{
	bool result = false
	if ( times == 0 || !isExact )
		result = !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD] ) || fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] <= times
	else
		result = si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD] && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] == times
	if ( clear )
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] <- 0
	return result
}

void function WeaponStatsStorageWrite_OnUniversalStatistic( int statisticType/*eStatisticTable*/, entity player, entity weaponEnt, float value, entity ornull victim = null, var damageInfo = null )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Statistic[statisticType] && ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Statistic[statisticType][si], si, player, weaponEnt, victim, damageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				//printt( "WeaponStats:StorageWrite_OnUniversalStatistic:", statisticType, player.GetPlayerName(), weaponEnt.GetWeaponClassName() )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[player].Statistic[statisticType] ) )
				fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] += value
		}
	}
}

int function GetWeaponBurstCount( entity weaponEnt )
{
	return weaponEnt.GetWeaponSettingInt( eWeaponVar.burst_fire_count )
}

int function GetWeaponMagCount( entity weaponEnt )
{
	return weaponEnt.GetWeaponPrimaryClipCountMax()
}

void function WeaponStatsStorageWrite_OnFireAmmo( entity player, entity weaponEnt, int ammoUsed )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_FIRED] )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED] ) )
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
			if ( HasAdditionalParams( eAdditionalParamsType.FIREANDHIT, si ) && expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.FIREANDHIT][si][0] ) == eAmmoHitValidateLocation.BURST_END )
			{
				int targetCount = GetWeaponBurstCount( weaponEnt ) //GetWeaponBurstCount becomes 0 when switched to single shot mode
				if ( targetCount == 0 || fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] >= targetCount )
				{
					foreach ( clearFunc in fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] )
						clearFunc( player )
				}
			}
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] += IsBitFlagSet( weaponEnt.GetWeaponDamageFlags(), DF_SHOTGUN ) ? ammoUsed * weaponEnt.GetProjectilesPerShot() : ammoUsed

			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnFireAmmo:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si], ammoUsed )
			#endif
		}
	}
}

void function WeaponStatsStorageWrite_OnFireAndHit( entity player, entity weaponEnt, entity victim, var damageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT] && ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si], si, player, weaponEnt, victim, damageInfo ) )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT] ) )
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
			if ( IsBitFlagSet( weaponEnt.GetWeaponDamageFlags(), DF_SHOTGUN ) )
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si]++
			else if ( fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] == 0 && HasAdditionalParams( eAdditionalParamsType.FIREANDHIT, si, 1 ) && expect bool( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.FIREANDHIT][si][1] ) == false )
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] = fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si]//HitFromStart == false, so fill in fake hit count for previous fire record
			else
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si]++
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnFireAndHit:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] )
			#endif
		}
	}
}

void function WeaponStatsStorageWrite_OnReloadStatistic( entity player, entity weaponEnt )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.RELOAD] && ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.RELOAD][si], si, player, weaponEnt ) )
			fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.RELOAD][si] <- Time()
	}
}

bool function WeaponStatsCondition_LimitAmmo( entity player, StatInstance si, int target, bool needCheckContinuousLimitAmmo )
{
	int ammoUsed = 0

	if ( needCheckContinuousLimitAmmo )
	{
		Assert( fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].len() == fileLevel.weaponStatsConfigs.validateCondition_Count[si] )
		ammoUsed = fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si][fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].len() - 1] - fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si][0] + 1
	}

	#if WEAPON_STATS_DEBUG
		if ( si in fileLevel.weaponStatsStorageSum[player].AmmoUsed )
			printt( "WeaponStats:WeaponStatsCondition_LimitAmmo", player.GetPlayerName(), "ammoUsed", ammoUsed )
	#endif

	return ammoUsed <= target
}

bool function WeaponStatsCondition_LimitDamage( entity player, StatInstance si, entity victim, int limit )
{
	if ( victim == null )
		return false

	if ( !( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers) )
		return false

	if ( !( victim in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si]) )
		return false

	float damage = fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victim]
	return damage < limit
}

bool function WeaponStatsCondition_DamageContribution( entity player, StatInstance si, entity victim, float ratio )
{
	if ( victim == null )
		return false

	if ( !( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers) )
		return false

	if ( !( victim in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si]) )
		return false

	float damage = fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victim]
	int totalHp = victim.GetShieldHealthMax() + victim.GetMaxHealth()
	if ( victim in fileLevel.healthTraceInfos )
		totalHp += fileLevel.healthTraceInfos[victim].totalRecover

	if ( totalHp == 0 )
		return false

	return damage / totalHp > ratio
}

bool function WeaponStatsCondition_ReturnFire( entity attacker, entity victim, int validSeconds )
{
	// return fire, victim become attacker
	entity beShotCheckVictim   = attacker
	entity beShotCheckAttacker = victim

	if ( !( beShotCheckVictim in fileLevel.beShotTime ) )
		return false

	if ( !( beShotCheckAttacker in fileLevel.beShotTime[beShotCheckVictim] ) )
		return false

	float beShotTime = fileLevel.beShotTime[beShotCheckVictim][beShotCheckAttacker]
	return Time() - beShotTime < validSeconds
}

bool function WeaponStatsCondition_TargetEvent( entity player, string eventKey, int validSeconds )
{
	if ( !( player in fileLevel.independentEventTime ) )
		return false

	if ( !( eventKey in fileLevel.independentEventTime[player] ) )
		return false

	float eventTime = fileLevel.independentEventTime[player][eventKey]
	return Time() - eventTime < validSeconds
}

bool function WeaponStatsCondition_TargetInteractEvent_Internal( entity player, entity target, string eventKey, int validSeconds )
{
	if ( !( player in fileLevel.interactEvents ) )
		return false

	if ( !( target in fileLevel.interactEvents[player] ) )
		return false

	if ( !( eventKey in fileLevel.interactEvents[player][target].times ) )
		return false

	if ( validSeconds == NO_TIME_LIMIT )
		return true

	float eventTime = fileLevel.interactEvents[player][target].times[eventKey]
	return Time() - eventTime < validSeconds
}

float function GetTargetEventTime( entity player, string eventKey )
{
	if ( player in fileLevel.independentEventTime && eventKey in fileLevel.independentEventTime[player] )
		return fileLevel.independentEventTime[player][eventKey]
	return -1
}

float function GetTargetInteractEventTime( entity player, entity target, string eventKey )
{
	if ( player in fileLevel.interactEvents && target in fileLevel.interactEvents[player] && eventKey in fileLevel.interactEvents[player][target].times )
		return fileLevel.interactEvents[player][target].times[eventKey]
	return -1
}

// activePassiveExchange determines the active and passive
// e.g. for event "be_downed"
//    exchangeActivePassive == false, means player be downed by target
//    exchangeActivePassive == true,  means target be downed by player
bool function WeaponStatsCondition_TargetInteractEvent( entity player, entity target, string eventKey, int validSeconds, bool exchangeActivePassive = false )
{
	if ( exchangeActivePassive )
		return WeaponStatsCondition_TargetInteractEvent_Internal( target, player, eventKey, validSeconds )

	return WeaponStatsCondition_TargetInteractEvent_Internal( player, target, eventKey, validSeconds )
}

// activePassiveExchange determines the active and passive
// e.g. for event "be_killed"
//    exchangeActivePassive == false, means teammate be killed by target
//    exchangeActivePassive == true,  means target be killed by teammate
bool function WeaponStatsCondition_TeammateInteractWithTarget( entity player, StatInstance si, entity target, string event, int validSeconds, bool exchangeActivePassive )
{
	foreach ( teammate in GetPlayerArrayOfTeam( player.GetTeam() ) )
	{
		if ( teammate == player )
			continue

		if ( WeaponStatsCondition_TargetInteractEvent( teammate, target, event, validSeconds, exchangeActivePassive ) )
			return true
	}

	return false
}

void function WeaponStatsWrite_WeaponPickupTime( entity player, string weaponClassName )
{
	if ( weaponClassName.len() < WEAPON_CLASS_PREFIX.len() || weaponClassName.slice( 0, WEAPON_CLASS_PREFIX.len() ) != WEAPON_CLASS_PREFIX )
		return
	if ( !( player in fileLevel.PickupWeaponTime ) )
		fileLevel.PickupWeaponTime[player] <- {}
	fileLevel.PickupWeaponTime[player][weaponClassName] <- Time()
}

void function WeaponStatsWrite_WeaponDropTime( entity player, string weaponClassName )
{
	if ( weaponClassName.len() < WEAPON_CLASS_PREFIX.len() || weaponClassName.slice( 0, WEAPON_CLASS_PREFIX.len() ) != WEAPON_CLASS_PREFIX )
		return
	if ( !( player in fileLevel.DropWeaponTime ) )
		fileLevel.DropWeaponTime[player] <- {}
	fileLevel.DropWeaponTime[player][weaponClassName] <- Time()
}

bool function WeaponStatsCondition_AttackWithoutOverheat( entity player, StatInstance si, entity target, int resetSeconds )
{
	if ( !WeaponStatsCondition_TargetEvent( player, WEAPON_OVERHEAT, resetSeconds ) )
		return true

	if ( !( si in fileLevel.weaponStatsStorageSum[player].DamageStartTime ) || !( target in fileLevel.weaponStatsStorageSum[player].DamageStartTime[si] ) )
	{
		return true
	}

	float damageStartTime = fileLevel.weaponStatsStorageSum[player].DamageStartTime[si][target]
	float overheatTime    = fileLevel.independentEventTime[player][WEAPON_OVERHEAT]
	return damageStartTime > overheatTime
}

bool function WeaponStatsCondition_TargetRevivePair( entity player, StatInstance si, entity target, int validSeconds )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].TargetsInPeriod ) )
		return false

	float currentTime = Time()
	while ( fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si].len() > 0 && currentTime - fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si][0].timeStamp > validSeconds )
		fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si].remove( 0 )

	int validTargetCount = fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si].len()

	for ( int i = 0; i < validTargetCount; i++ )
	{
		entity target1 = fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si][i].target
		for ( int j = i + 1; j < validTargetCount; j++ )
		{
			entity target2 = fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si][j].target
			if ( WeaponStatsCondition_TargetInteractEvent( target1, target2, REVIVE_START, validSeconds ) || WeaponStatsCondition_TargetInteractEvent( target2, target1, REVIVE_START, validSeconds ) )
				return true
		}
	}
	return false
}

// refer to GetIsPlayerOnGroundForEchoLocator in mp_ability_echo_locator.nut
bool function IsPlayerInAirWithHeightCheck( entity player, int heightFromGround )
{
	bool isOnGround = true

	if ( player.IsPlayerDecoy() )
	{
		isOnGround = true//player.DecoyIsOnGround()
	}
	else
	{
		isOnGround = player.IsOnGround()
	}

	//IsOnGround is unreliable when player is bunny hopping.  Trace down to verify not on ground.
	if ( !isOnGround )
	{
		const int TRACE_START_UP_OFFSET = 2
		vector traceStart        = player.GetOrigin() + ( player.GetUpVector() * TRACE_START_UP_OFFSET )
		vector traceEnd          = player.GetOrigin() - ( player.GetUpVector() * ( TRACE_START_UP_OFFSET + heightFromGround ) )
		TraceResults traceResult = TraceLine( traceStart, traceEnd, [ player ], TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_BLOCK_WEAPONS_AND_PHYSICS )
		isOnGround = ( traceResult.fraction < 0.99 )
	}

	return !isOnGround
}

bool function WeaponStatsCondition_TargetInAir( entity victim )
{
	const int HEIGHT_FROM_GROUND = 3
	return IsPlayerInAirWithHeightCheck( victim, HEIGHT_FROM_GROUND ) && !victim.IsZiplining()
}

bool function WeaponStatsCondition_TargetOutsideSafezone( entity victim )
{
	int realm = Survival_Loot_GetDefaultRealm()
	if ( !SURVIVAL_DeathFieldIsValid( realm ) )
		return false

	vector nextCircleCenter   = SURVIVAL_GetDeathFieldCenter( realm )
	float curDeathFieldRadius = SURVIVAL_GetDeathFieldCurrentRadius( realm )
	float distance            = Distance2D( victim.GetOrigin(), nextCircleCenter )
	return distance > curDeathFieldRadius
}

bool function WeaponStatsCondition_IncreaseTimesLimit( entity player, StatInstance si, int limit )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].IncreasedTimes ) )
	{
		return true
	}

	return fileLevel.weaponStatsStorageSum[player].IncreasedTimes[si] < limit
}

bool function IsNeedTraceTargetInPeriod( StatInstance si )
{
	if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.REVIVE_PAIR_KILL] )
		return true

	return false
}

void function WeaponStats_OnEventNeedHandleTargetInPeriod( entity player, entity target )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( IsNeedTraceTargetInPeriod( si ) )
		{
			TargetInPeriodInfo info
			info.target = target
			info.timeStamp = Time()

			if ( !( si in fileLevel.weaponStatsStorageSum[player].TargetsInPeriod ) )
				fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si] <- []

			fileLevel.weaponStatsStorageSum[player].TargetsInPeriod[si].append( info )
		}
	}
}

void function WeaponStatsStorageWrite_OnWeaponAttack( entity player, entity weaponEnt, int ammoUsed )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.CONTINUOUS_DOWN] )
		{
			#if WEAPON_STATS_DEBUG
				//printt( "WeaponStats:WeaponStatsStorageWrite_OnWeaponAttack:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), ammoUsed )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[player].AmmoUsed ) )
				fileLevel.weaponStatsStorageSum[player].AmmoUsed[si] <- 1
			else
				fileLevel.weaponStatsStorageSum[player].AmmoUsed[si] += ammoUsed
		}

		fileLevel.weaponStatsStorageSum[player].WeaponChargeLevel[si] <- ( weaponEnt.IsChargeWeapon() ? weaponEnt.GetWeaponChargeLevel() : 1 )
	}
}

void function WeaponStatsStorageWrite_BreakShieldTime( entity attacker, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[attacker] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.BREAK_SHIELD_TIME, si, attacker, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_BreakShieldTime:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName(), victim.GetPlayerName() )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime ) )
				fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime[si] <- {}
			fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime[si][victim] <- Time()
		}
	}
}

bool function WeaponStatsCondition_BreakShieldTimeWithin( entity attacker, StatInstance si, float validSeconds, entity victim, bool clear = false )
{
	bool result = si in fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime && victim in fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime[si] && Time() - fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime[si][victim] <= validSeconds
	if ( si in fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime && clear )
		fileLevel.weaponStatsStorageSum[attacker].BreakShieldTime[si][victim] <- 0
	return result
}

void function WeaponStatsStorageWrite_BreakIncapShieldTime( entity attacker, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[attacker] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.BREAK_INCAP_SHIELD_TIME, si, attacker, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_BreakIncapShieldTime:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName(), victim.GetPlayerName() )
			#endif

			if ( !( si in fileLevel.weaponStatsStorageSum[attacker].BreakIncapShieldTime ) )
				fileLevel.weaponStatsStorageSum[attacker].BreakIncapShieldTime[si] <- {}
			fileLevel.weaponStatsStorageSum[attacker].BreakIncapShieldTime[si][victim] <- Time()
		}
	}
}

bool function WeaponStatsCondition_IncapShieldBreakerSameAsKiller( entity player, StatInstance si, entity target )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].BreakIncapShieldTime ) || !( target in fileLevel.weaponStatsStorageSum[player].BreakIncapShieldTime[si] ) )
	{
		return false
	}

	return true
}

void function WriteReviveAndRespawnClear( StatInstance si, entity attacker, entity victim )
{
	//track info for when victim is revived/respawned
	if ( !( victim in fileLevel.clearAction_ReviveAndRespawn ) )
		fileLevel.clearAction_ReviveAndRespawn[victim] <- {}
	fileLevel.clearAction_ReviveAndRespawn[victim][si] <- attacker
}

void function WeaponStatsStorageWrite_OnWipeSquad( entity player, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.WIPE_SQUAD_PLAYERS, si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers ) )
				fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si] <- []
			if ( !fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].contains( victim ) )
				fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].append( victim )
			if ( si in fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.RELOAD] )
				fileLevel.weaponStatsStorageSum[player].WipeSquadReloadTimes[victim] <- ( ( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD] ) ? fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] : 0 )
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnWipeSquad:", player.GetPlayerName(), victim.GetPlayerName() )
			#endif
			WriteReviveAndRespawnClear( si, player, victim )
		}
	}
}

bool function WeaponStatsCondition_ReloadTimesBySquadNotExceed( entity player, StatInstance si, int victimTeam, int maxReloadTimes )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD] ) )
		return true
	int earliestReload = INT_MAX
	foreach ( otherVictim in fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si] )
		if ( otherVictim.GetTeam() == victimTeam && otherVictim in fileLevel.weaponStatsStorageSum[player].WipeSquadReloadTimes && fileLevel.weaponStatsStorageSum[player].WipeSquadReloadTimes[otherVictim] < earliestReload )
			earliestReload = fileLevel.weaponStatsStorageSum[player].WipeSquadReloadTimes[otherVictim]
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:ReloadTimesBySquadNotExceed:", player.GetPlayerName(), victimTeam, earliestReload )
	#endif
	return earliestReload >= fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] - maxReloadTimes
}

void function WeaponStatsStorageClear_ReviveAndRespawn( entity victim )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:StorageClear_ReviveAndRespawn", victim.GetPlayerName() )
	#endif
	if ( victim in fileLevel.clearAction_ReviveAndRespawn )
	{
		foreach ( si, attacker in fileLevel.clearAction_ReviveAndRespawn[victim] )
		{
			if ( si in fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn )
				foreach ( clearFunc in fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] )
					clearFunc( attacker, victim )
		}
		delete fileLevel.clearAction_ReviveAndRespawn[victim]
	}
}

void function WeaponStatsStorageClear_WeaponSwitched( entity player, entity newWeapon, entity oldWeapon )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		WeaponStatsUniversalClear( eClearConfig.WEAPON_SWITCHED, player, si )
		if ( si in fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.SWITCH_DIFFERENT_WEAPON] )
		{
			ItemFlavor ornull weaponItemOld = IsValid( oldWeapon ) ? GetWeaponItemFlavorByClass( oldWeapon.GetWeaponClassName() ) : null
			ItemFlavor ornull weaponItemNew = IsValid( newWeapon ) ? GetWeaponItemFlavorByClass( newWeapon.GetWeaponClassName() ) : null
			ItemFlavor targetWeapon			= GetItemFlavorByGUID( si.targetTag )
			if ( weaponItemOld != targetWeapon || weaponItemOld != weaponItemNew )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:StorageClear_SwitchDifferentWeapon", player.GetPlayerName(), fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.SWITCH_DIFFERENT_WEAPON][si].len() )
				#endif
				foreach ( clearFunc in fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.SWITCH_DIFFERENT_WEAPON][si] )
					clearFunc( player )
			}
		}
	}
}

void function WeaponStatsUniversalClear( int clearConfig/*eClearConfig*/, entity player, StatInstance si )
{
	if ( si in fileLevel.weaponStatsConfigs.clearActionConfigs[clearConfig] )
	{
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:StorageClear", clearConfig, player.GetPlayerName(), fileLevel.weaponStatsConfigs.clearActionConfigs[clearConfig][si].len() )
		#endif
		foreach ( clearFunc in fileLevel.weaponStatsConfigs.clearActionConfigs[clearConfig][si] )
			clearFunc( player )
	}
}

void function WeaponStatsStorageWrite_OnDownVictimsProperty( entity player, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.VICTIMS_PROPERTY, si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnDownVictimsProperty:", player.GetPlayerName() )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[player].VictimsProperty ) )
				fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] <- {}
			int category = eVictimProperty.TIME
			if ( HasAdditionalParams( eAdditionalParamsType.VICTIMS_PROPERTY, si, 0 ) )
				category = expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si][0] )
			switch ( category )
			{
				case eVictimProperty.TIME:
					fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victim] <- Time()
					break

				case eVictimProperty.CAR_WEAPON_MOD:
					fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victim] <- weaponEnt.HasMod( CAR_ALT_AMMO_MOD )
					break

				case eVictimProperty.LOADOUT:
					fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victim] <- weaponEnt
					break
			}
			WriteReviveAndRespawnClear( si, player, victim )
		}
	}
}

void function WeaponStatsStorageClear_VictimsProperty( entity player, entity victim, StatInstance si )
{
	if ( si in fileLevel.weaponStatsStorageSum[player].VictimsProperty && victim in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] )
		delete fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victim]
}

void function WeaponStatsStorageWrite_OnVictimExecutingEnemy( entity player, entity victim )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIM_EXECUTING_ENEMY] )
		{
			if ( !( si in fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy ) )
				fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si] <- {}
			if ( !( victim in fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si] ) )
				fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si][victim] <- false
			bool forceTargetIsTeammate = expect bool( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.EXECUTING_TEAMMATE][si][0] )
			bool isTeammate            = false
			if ( forceTargetIsTeammate )
			{
				entity target = victim.e.syncedMeleeTarget
				if ( IsValid( target ) && target.IsPlayer() )
					isTeammate = IsFriendlyTeam( target.GetTeam(), player.GetTeam() )
			}
			if ( !forceTargetIsTeammate || ( forceTargetIsTeammate && isTeammate ) )
				fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si][victim] = fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si][victim] || victim.ContextAction_IsMeleeExecutionAttacker()
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnVictimExecutingEnemy:", player.GetPlayerName(), victim.GetPlayerName(), victim.ContextAction_IsMeleeExecutionAttacker(), fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si][victim] )
			#endif
		}
	}
}

void function WeaponStatsStorageWrite_OnVictimHealthTrace( entity victim, var attackerDamageInfo )
{
	int healthBeforeAttack = victim.GetShieldHealth() + victim.GetHealth()
	int health = healthBeforeAttack - int ( DamageInfo_GetDamage( attackerDamageInfo ) )
	if ( health < 0 )
		health = 0

	int maxHealth = victim.GetShieldHealthMax() + victim.GetMaxHealth()

	if ( !( victim in fileLevel.healthTraceInfos ) )
	{
		HealthTraceInfo info
		fileLevel.healthTraceInfos[victim] <- info
	}

	// Health recover to full health, reset trace info
	if ( healthBeforeAttack >= maxHealth )
	{
		foreach ( player, storage in fileLevel.weaponStatsStorageSum )
		{
			foreach ( si, damageAmountInfo in storage.DamagedPlayers )
			{
				if ( si in fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.COMPLETE_RECOVERY] )
				{
					damageAmountInfo[victim] <- 0
				}
			}
		}

		fileLevel.healthTraceInfos[victim].totalRecover = 0
		fileLevel.healthTraceInfos[victim].lastHealth = health
	}
	else
	{
		if ( healthBeforeAttack > fileLevel.healthTraceInfos[victim].lastHealth )
			fileLevel.healthTraceInfos[victim].totalRecover += healthBeforeAttack - fileLevel.healthTraceInfos[victim].lastHealth
		fileLevel.healthTraceInfos[victim].lastHealth = health
	}
}

void function WeaponStatsStorageWrite_OnDamagedVictim( entity player, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.DAMAGED_PLAYERS, si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnDamagedVictim:", player.GetPlayerName() )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers ) )
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
			if ( !( victim in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] ) )
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victim] <- GetEffectiveDamage( victim, attackerDamageInfo )
			else
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victim] += GetEffectiveDamage( victim, attackerDamageInfo )
		}

		if ( WriteConditionsEvaluate( eWriteCondition.DAMAGE_START_TIME, si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnDamagedVictim(DamageStart):", player )
			#endif

			if ( !( si in fileLevel.weaponStatsStorageSum[player].DamageStartTime ) )
				fileLevel.weaponStatsStorageSum[player].DamageStartTime[si] <- {}
			if ( !( victim in fileLevel.weaponStatsStorageSum[player].DamageStartTime[si] ) )
				fileLevel.weaponStatsStorageSum[player].DamageStartTime[si][victim] <- Time()
		}
	}
}

bool function WeaponStatsCondition_DamageInPeriodComplete( entity player, StatInstance si, entity victim, int timeLimit, int damageAmount, bool useBothWeapons )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].DamageInPeriod ) || !( victim in fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si] ) )
		return false
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:DamageInPeriodComplete:", player.GetPlayerName(), victim.GetPlayerName(), DamageInPeriodComplete( fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim], timeLimit, damageAmount, useBothWeapons ) )
	#endif
	return DamageInPeriodComplete( fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim], timeLimit, damageAmount, useBothWeapons )
}

void function WeaponStatsStorageWrite_OnDamageInPeriod( entity victim, entity player, entity weaponEnt, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_IN_PERIOD] )
		{
			bool passDamageCheck = ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_IN_PERIOD][si], si, player, weaponEnt, victim, attackerDamageInfo )
			bool forceDamageCheck = HasAdditionalParams( eAdditionalParamsType.DAMAGE_IN_PERIOD, si, 1 ) && expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si][1] ) > 0
			bool needWriteBuf = forceDamageCheck || passDamageCheck
			if ( needWriteBuf )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:StorageWrite_OnDamageInPeriod:", player.GetPlayerName(), weaponEnt.GetWeaponClassName() )
				#endif
				if ( !(si in fileLevel.weaponStatsStorageSum[player].DamageInPeriod) )
					fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si] <- {}
				if ( !(victim in fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si]) )
				{
					Assert( HasAdditionalParams( eAdditionalParamsType.DAMAGE_IN_PERIOD, si ) )
					fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim] <- InitDamageInPeriodInfoRingBuffer( expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si][0] ) )
				}
				int forceDamageCheckResetTime = HasAdditionalParams( eAdditionalParamsType.DAMAGE_IN_PERIOD, si, 2 ) ? expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si][2] ) : -1
				bool setDamageValid = !forceDamageCheck ? true : passDamageCheck &&
					( fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim].isValid || Time() - GetDamageInPeriodRingBufferLast( fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim] ).time > forceDamageCheckResetTime )
				entity weaponInSlot0 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
				entity weaponInSlot1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
				int weaponSlot       = weaponInSlot0 == weaponEnt ? 0 : 1
				WriteDamageInPeriodInfoRingBuffer( fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim], GetEffectiveDamage( victim, attackerDamageInfo ), weaponSlot, setDamageValid )
			}
		}
	}
}

bool function WeaponStatsCondition_DamageAnyVictimInPeriodComplete( entity player, StatInstance si, int timeLimit, int damageAmount, bool useBothWeapons )
{
	if ( !( si in fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod ) )
		return false

	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:DamageAnyVictimInPeriodComplete:", player.GetPlayerName(), DamageInPeriodComplete( fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si], timeLimit, damageAmount, useBothWeapons ) )
	#endif

	return DamageInPeriodComplete( fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si], timeLimit, damageAmount, useBothWeapons )
}

void function WeaponStatsStorageWrite_OnDamageAnyVictimInPeriod( entity victim, entity player, entity weaponEnt, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_ANY_VICTIM_IN_PERIOD] )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:StorageWrite_OnDamageAnyVictimInPeriod:", player.GetPlayerName(), weaponEnt.GetWeaponClassName() )
			#endif

			if ( !( si in fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod ) )
			{
				Assert( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si].len() > 0 )
				fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si] <- InitDamageInPeriodInfoRingBuffer( expect int( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si][0] ) )
			}

			WriteDamageInPeriodInfoRingBufferForShots( fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si], GetEffectiveDamage( victim, attackerDamageInfo ) )
		}
	}
}

DamageInPeriodInfoRingBuffer function InitDamageInPeriodInfoRingBuffer( int size )
{
	Assert( size > 0 )
	DamageInPeriodInfoRingBuffer infoRingBuffer
	for ( int i = 0; i < size; i++ )
	{
		DamageInPeriodInfo info
		infoRingBuffer.damageInfos.append( info )
	}
	infoRingBuffer.latest = 0
	return infoRingBuffer
}

void function WriteDamageInPeriodInfoRingBuffer( DamageInPeriodInfoRingBuffer buf, float damageAmount, int weaponSlot, bool isDamagePeriodValid = true )
{
	if ( damageAmount <= 0 )
		return
	int timeInt = int( Time() )
	if ( timeInt == buf.damageInfos[buf.latest].time )
		buf.damageInfos[buf.latest].damageAmount += damageAmount
	else
	{
		buf.latest = ( buf.latest + 1 ) % buf.damageInfos.len()
		buf.damageInfos[buf.latest].time = timeInt
		buf.damageInfos[buf.latest].damageAmount = damageAmount
	}
	buf.damageInfos[buf.latest].weaponSlot = weaponSlot
	buf.isValid = isDamagePeriodValid
}

DamageInPeriodInfo function GetDamageInPeriodRingBufferLast( DamageInPeriodInfoRingBuffer buf )
{
	return buf.damageInfos[buf.latest]
}

void function ClearSingleDamageInPeriodInfo( DamageInPeriodInfo info )
{
	info.damageAmount = 0
	info.time = 0
	info.weaponSlot = 0
}

void function ClearDamageInPeriodInfo( DamageInPeriodInfoRingBuffer buf )
{
	for( int i = 0; i < buf.damageInfos.len(); i++ )
		ClearSingleDamageInPeriodInfo( buf.damageInfos[i] )
	buf.latest = 0
}

void function MoveDamageInPeriodInfoToNext( DamageInPeriodInfoRingBuffer buf )
{
	buf.latest = ( buf.latest + 1 ) % buf.damageInfos.len()
	ClearSingleDamageInPeriodInfo( buf.damageInfos[buf.latest] )
}

void function WriteDamageInPeriodInfoRingBufferForShots( DamageInPeriodInfoRingBuffer buf, float damageAmount )
{
	buf.damageInfos[buf.latest].damageAmount += damageAmount
}

bool function DamageInPeriodComplete( DamageInPeriodInfoRingBuffer buf, int timeLimit, int requiredDamage, bool useBothWeapons )
{
	float totalAmount = 0
	int curIntTime    = int( Time() )
	int index
	int weaponSlotRecord = 0
	for ( int i = 0; i < buf.damageInfos.len(); i++ )
	{
		index = ( buf.latest + buf.damageInfos.len() - i ) % buf.damageInfos.len()
		if ( timeLimit != NO_TIME_LIMIT && buf.damageInfos[index].time + timeLimit < curIntTime )
			break
		totalAmount += buf.damageInfos[index].damageAmount
		if( buf.damageInfos[index].damageAmount > 0 )
		{
			weaponSlotRecord = weaponSlotRecord | 1 << buf.damageInfos[index].weaponSlot
		}
	}
	bool passWeaponSlotCheck = useBothWeapons ? weaponSlotRecord == 3 : true
	return buf.isValid && totalAmount > requiredDamage && passWeaponSlotCheck
}

RotationRingBuffer function InitRotationRingBuffer( int size )
{
	Assert( size > 0 )
	RotationRingBuffer ringBuffer
	for ( int i = 0; i < size; i++ )
	{
		RotationData data
		ringBuffer.rotationDatas.append( data )
	}
	ringBuffer.latest = 0
	return ringBuffer
}

void function WriteRotationRingBuffer( RotationRingBuffer buf, vector rotation )
{
	buf.latest = ( buf.latest + 1 ) % buf.rotationDatas.len()
	buf.rotationDatas[buf.latest].time = Time()
	buf.rotationDatas[buf.latest].rotation = rotation
}


////////////////////////////
////////////////////////////
////       Validate     ////
////////////////////////////
////////////////////////////
bool function WeaponStatsValidate_UniversalValidateCondition( int validateLocation/*eValidateLocation*/, entity player, StatInstance si, int validateValue = 1, void functionref( StatInstance si, entity player ) cleanupFunc = null, ... )
{
	if ( !( si in fileLevel.weaponStatsConfigs.validateConditions[validateLocation] ) || validateValue <= 0 )
		return false
	bool result = false
	if ( vargc == 0 )
		result = fileLevel.weaponStatsConfigs.validateConditions[validateLocation][si]( player, si )
	else if ( vargc == 1 )
		result = fileLevel.weaponStatsConfigs.validateConditions[validateLocation][si]( player, si, vargv[0] )
	if ( result )
	{
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:UniversalValidateCondition:", validateLocation, si.description, player.GetPlayerName() )
		#endif
		Mastery_IncrementStatInstance( player, si, validateValue )
		if ( cleanupFunc != null )
			cleanupFunc( si, player )
	}
	return result
}

void function WeaponStatsValidateStorageCondition_UniversalCount( int countTable/*eCountTable*/, entity player, void functionref( StatInstance si, entity player ) cleanupPreValidateFunc = null, void functionref( StatInstance si, entity player ) cleanupPostValidateFunc = null )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsStorageSum[player].Count[countTable] && si in fileLevel.weaponStatsConfigs.validateCondition_Count )
		{
			if ( cleanupPreValidateFunc != null )
				cleanupPreValidateFunc( si, player )
			if ( fileLevel.weaponStatsStorageSum[player].Count[countTable][si] >= fileLevel.weaponStatsConfigs.validateCondition_Count[si] )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:Stats complete:", countTable, si.description, player.GetPlayerName() )
				#endif
				Mastery_IncrementStatInstance( player, si, 1 )
				fileLevel.weaponStatsStorageSum[player].Count[countTable][si] = 0//clear
				if ( cleanupPostValidateFunc != null )
					cleanupPostValidateFunc( si, player )
			}
		}
	}
}

void function CleanupContinuousDownCount( StatInstance si, entity player )
{
	if ( si in fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace )
		fileLevel.weaponStatsStorageSum[player].AmmoUsedTrace[si].clear()
}

void function WeaponStatsValidateStorageCondition_UniversalStatistic( int statisticType/*eStatisticTable*/, entity player )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsStorageSum[player].Statistic[statisticType] && si in fileLevel.weaponStatsConfigs.validateCondition_Statistic )
		{
			if ( fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] >= fileLevel.weaponStatsConfigs.validateCondition_Statistic[si] )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:Stats complete:", statisticType, si.description, player.GetPlayerName() )
				#endif
				Mastery_IncrementStatInstance( player, si, 1 )
				fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] = 0
			}
		}
	}
}

void function WeaponStatsValidateStorageCondition_HoldTime( entity player )
{
	if ( fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME].len() > 0 )
	{
		foreach ( si, holdTime in fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME] )
		{
			int intHoldTime = int( holdTime )
			if ( intHoldTime <= 0 )
				continue
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:Stats complete(hold time):", si.description, player.GetPlayerName(), intHoldTime )
			#endif
			Mastery_IncrementStatInstance( player, si, intHoldTime )
			fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.HOLD_TIME][si] = 0
		}
	}
}

void function WeaponStatsValidateStorageCondition_KillCountXP( entity player, entity victim )
{
	StatInstance candidateSI
	float highestWeight = -1
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.KILL_COUNT_XP] && si in fileLevel.weaponStatsStorageSum[player].VictimsProperty && victim in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] )
		{
			float thisWeight = expect float( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.KILL_COUNT_XP][si][0] )
			if ( thisWeight > highestWeight )
			{
				candidateSI = si
				highestWeight = thisWeight
			}
			delete fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victim]
		}
	}

	if ( highestWeight > 0 )
	{
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:ValidateStorageCondition_KillCountXP:", candidateSI.description, player.GetPlayerName() )
		#endif
		Mastery_IncrementStatInstance( player, candidateSI, 1 )
	}
}

void function WeaponStatsValidateStorageCondition_PlayerDisconnectOrMatchEnd( entity player )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
		WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.PLAYER_DISCONNECT_OR_MATCH_END, player, si )
}

void function DeleteClearAction( StatInstance si, entity attacker, entity victim, bool execute = false )
{
	if ( victim in fileLevel.clearAction_ReviveAndRespawn && si in fileLevel.clearAction_ReviveAndRespawn[victim] )
	{
		if ( execute )
		{
			foreach ( clearFunc in fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] )
				clearFunc( attacker, victim )
		}
		delete fileLevel.clearAction_ReviveAndRespawn[victim][si]
	}
}

void function WeaponStatsValidateStorageCondition_OnWipeSquad( entity player, entity victim )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.WIPE_SQUAD] && si in fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers && fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].contains( victim ) )
		{
			int victimTeam = victim.GetTeam()
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:wipeSquad validate:", player.GetPlayerName(), victimTeam )
			#endif
			array<entity> playersInTeam = GetPlayerArrayOfTeam( victimTeam )
			int teamMemberCount = 0
			foreach ( teamMember in playersInTeam )
				if ( fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].contains( teamMember ) )
					teamMemberCount++

			if ( teamMemberCount == playersInTeam.len() )
			{
				WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.WIPE_SQUAD, player, si, 1, null, victimTeam )
				//clear
				foreach ( teamMember in playersInTeam )
					DeleteClearAction( si, player, teamMember, true )
			}
		}
	}
}

void function WeaponStatsValidateStorageCondition_OnFireAndHit( entity player, entity weaponEnt )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT] )
			WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.AMMO_HIT, player, si, 1, void function( StatInstance si, entity player ) { WeaponStatsUniversalClear( eClearConfig.FIRE_HIT_VALIDATE_PASSED, player, si ) }, weaponEnt )
	}
}

void function WeaponStatsValidateStorageCondition_OnFireAmmo( entity player, entity weaponEnt )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED] )
			WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.AMMO_FIRED, player, si, 1, void function( StatInstance si, entity player ) { WeaponStatsUniversalClear( eClearConfig.FIRE_HIT_VALIDATE_PASSED, player, si ) }, weaponEnt )
	}
}

void function WeaponStatsValidateStorageCondition_OnRawDamage( entity player )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.RAW_DAMAGE] )
			WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.RAW_DAMAGE, player, si, int( fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.RAW_DAMAGE][si] ), CleanupRawDamage )
	}
}

void function CleanupRawDamage( StatInstance si, entity player )
{
	fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.RAW_DAMAGE][si] = 0
}

bool function ValidateDownVictimDifferentProperty( entity player, StatInstance si, int propertyType, int target ) {
	if ( !( si in fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DOWN_VICTIMS_PROPERTY] ) )
		return false
	if ( !( si in fileLevel.weaponStatsStorageSum[player].VictimsProperty ) || fileLevel.weaponStatsStorageSum[player].VictimsProperty[si].len() < target )
		return false
	var first = null
	foreach ( k,v in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] )
	{
		if ( first == null )
			first = v
		else if ( first != v )
		{
			fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] <- {}
			return true
		}
	}
	return false
}

void function WeaponStatsValidateStorageCondition_OnDownVictimsProperty( entity player, entity victim )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY] )
		{
			WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.DOWN_VICTIMS_PROPERTY, player, si )
			DeleteClearAction( si, player, victim, HasAdditionalParams( eAdditionalParamsType.VICTIMS_PROPERTY, si, 1 ) && expect bool( fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si][1] ) )
		}
	}
}

void function WeaponStatsValidateStorageCondition_OnDamageStatisticInPeriod( entity player )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.DAMAGE_ANY_VICTIM_IN_PERIOD, player, si, 1,
			void function( StatInstance si, entity player ) { ClearDamageInPeriodInfo( fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si] ) } )
	}
}

void function WeaponStatsStorageValidateAndWrite_OnDoubleKill( entity player, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( si in fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.DOUBLE_KILL] && ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.DOUBLE_KILL][si], si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			if ( !WeaponStatsValidate_UniversalValidateCondition( eValidateLocation.DOUBLE_KILL, player, si ) )
				fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.DOUBLE_KILL][si] <- Time()
		}
	}
}

void function WeaponStatsWriteAndValidate_BreakShieldInSquad( entity player, entity weaponEnt, entity victim, var attackerDamageInfo )
{
	foreach ( si in fileLevel.currentStatInstance[player] )
	{
		if ( WriteConditionsEvaluate( eWriteCondition.BREAK_SHIELD_IN_SQUAD, si, player, weaponEnt, victim, attackerDamageInfo ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:WriteAndValidate_BreakShieldInSquad:", player.GetPlayerName(), weaponEnt.GetWeaponClassName(), victim.GetPlayerName() )
			#endif
			if ( !( si in fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad ) )
				fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si] <- {}
			int victimTeam = victim.GetTeam()
			if ( !( victimTeam in fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si] ) )
				fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si][victimTeam] <- []
			if ( !( fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si][victimTeam].contains( victim ) ) )
				fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si][victimTeam].append( victim )
			if ( fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.BREAK_SHIELD_IN_SQUAD][si]( player, si, victimTeam ) )
			{
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:Stats complete(BreakShieldInSquad):", si.description, player.GetPlayerName() )
				#endif
				Mastery_IncrementStatInstance( player, si, 1 )
				fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si][victimTeam] <- []
			}
		}
	}
}

////////////////////////////
////////////////////////////
//// Instant Conditions ////
////////////////////////////
////////////////////////////
bool function WeaponStatsCondition_WithAttachmentType( StatInstance si, entity weapon, array<string> attachmentTypes, int requireTier = -1 )
{
	foreach ( s in attachmentTypes )
	{
		string installed = GetInstalledWeaponAttachmentForPoint( weapon, s )
		if ( installed == "" )
			return false
		if ( requireTier > -1 )
		{
			if ( !SURVIVAL_Loot_IsRefValid( installed ) || SURVIVAL_Loot_GetLootDataByRef( installed ).tier < requireTier )
				return false
		}
	}
	return true
}

bool function WeaponStatsCondition_WithAttachmentName( StatInstance si, entity weapon, string attachmentPoint, string requireAttachment, bool isPrefix )
{
	string installed = GetInstalledWeaponAttachmentForPoint( weapon, attachmentPoint )
	if ( isPrefix )
		return ( installed.len() >= requireAttachment.len() && installed.slice( 0, requireAttachment.len() ) == requireAttachment )
	return installed == requireAttachment
}

bool function WeaponStatsCondition_WithoutAttachmentType( StatInstance si, entity weapon, string withoutType )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_WithoutAttachmentType:", withoutType, GetInstalledWeaponAttachmentForPoint( weapon, withoutType ) == "" )
	#endif
	return GetInstalledWeaponAttachmentForPoint( weapon, withoutType ) == ""
}

bool function WeaponStatsCondition_IsAds( StatInstance si, entity weapon )
{
	#if WEAPON_STATS_DEBUG
		//printt( "WeaponStats:Condition_IsAds:",weapon.IsWeaponInAds() )
	#endif
	return weapon.IsWeaponInAds()
}

bool function WeaponStatsCondition_WithinGotRevived( entity player, StatInstance si, int validSeconds )
{
	if ( WeaponStatsCondition_TargetEvent( player, REVIVED, validSeconds ) )
	{
		WeaponStats_ClearIndependentEventTime( player, REVIVED )
		return true
	}
	return false
}

bool function WeaponStatsCondition_TargetInZipline( entity victim, StatInstance si, int validSeconds )
{
	return victim.IsZiplining() && !WeaponStatsCondition_TargetEvent( victim, START_ZIPLINE, validSeconds )
}

bool function WeaponStatsCondition_IsSemiAuto( StatInstance si, entity weapon )
{
	return IsWeaponInSingleShotMode( weapon )
}

bool function WeaponStatsCondition_TargetDistanceWithin( StatInstance si, entity player, entity victim, float distanceTarget )
{
	return DistanceSqr( player.GetOrigin(), victim.GetOrigin() ) <= distanceTarget * distanceTarget
}

bool function WeaponStatsCondition_TargetDistanceExceeds( StatInstance si, entity player, entity victim, float distanceTarget )
{
	return DistanceSqr( player.GetOrigin(), victim.GetOrigin() ) >= distanceTarget * distanceTarget
}

bool function WeaponStatsCondition_IsMagEmpty( entity player, StatInstance si, entity weaponEnt )
{
	int currentAmmo = weaponEnt.UsesClipsForAmmo() ? weaponEnt.GetWeaponPrimaryClipCount() : weaponEnt.GetWeaponPrimaryAmmoCount( weaponEnt.GetActiveAmmoSource() )
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_IsMagEmpty:", player.GetPlayerName(), currentAmmo )
	#endif
	return currentAmmo == 0
}

bool function WeaponStatsCondition_IsLastMag( entity player, StatInstance si, entity weaponEnt )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_IsLastMag:", player.GetPlayerName(), weaponEnt.GetWeaponPrimaryClipCount(), weaponEnt.GetWeaponPrimaryAmmoCount( weaponEnt.GetActiveAmmoSource() ) )
	#endif
	return weaponEnt.GetWeaponPrimaryAmmoCount( weaponEnt.GetActiveAmmoSource() ) == 0
}

bool function WeaponStatsCondition_AttackerSameAsKiller( StatInstance si, entity attacker, entity victim, float timeLimit = -1 )
{
	if ( Bleedout_IsBleedingOut( victim ) )
	{
		entity bleedoutAttacker = Bleedout_GetBleedoutAttacker( victim )
		if ( bleedoutAttacker == null || bleedoutAttacker != attacker )
			return false
	}
	return timeLimit == -1 || ( si in fileLevel.weaponStatsStorageSum[attacker].VictimsProperty && victim in fileLevel.weaponStatsStorageSum[attacker].VictimsProperty[si] && expect float( fileLevel.weaponStatsStorageSum[attacker].VictimsProperty[si][victim] ) + timeLimit > Time() )
}

bool function WeaponStatsCondition_IsHeadshot( StatInstance si, var damageInfo, entity victim )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_IsHeadshot:", IsValidHeadShot( damageInfo, victim ) )
	#endif
	return IsValidHeadShot( damageInfo, victim )
}

bool function WeaponStatsCondition_InTempo( StatInstance si, entity weapon )
{
	return weapon.HasMod( MOD_MARKSMANS_TEMPO_ACTIVE )
}

bool function WeaponStatsCondition_IsFullyHeated( StatInstance si, entity weapon )
{
	return weapon.GetHeatValueOnLastFire() >= 1.0
}

bool function WeaponStatsCondition_IsMaxChargeLevel( entity player, StatInstance si, entity weapon )
{
	if ( !( player in fileLevel.weaponStatsStorageSum ) )
		return false

	if ( !( si in fileLevel.weaponStatsStorageSum[player].WeaponChargeLevel ) )
		return false

	int level    = fileLevel.weaponStatsStorageSum[player].WeaponChargeLevel[si]
	int maxLevel = weapon.GetWeaponChargeLevelMax()
	return level == maxLevel
}

bool function WeaponStatsCondition_OverChargeFraction( entity player, StatInstance si, entity weapon, float targetChargeFraction )
{
	float fraction = weapon.GetWeaponChargeFraction() + CHARGE_EPSILON
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_OverChargeFraction:", fraction, targetChargeFraction, fraction >= targetChargeFraction )
	#endif
	return fraction >= targetChargeFraction
}

bool function WeaponStatsCondition_PlayerHPExceeds( StatInstance si, entity player, float target )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_PlayerHPExceeds:", target, float( player.GetHealth() ), float( player.GetMaxHealth() ), float( player.GetHealth() ) / float( player.GetMaxHealth() ) )
	#endif
	return 100 * float( player.GetHealth() ) / float( player.GetMaxHealth() ) >= target
}

bool function WeaponStatsCondition_VictimUsingWeapon( StatInstance si, string target, entity victim )
{
	if ( victim == null || !( victim in fileLevel.weaponStatsStorageSum ) || !IsValid( fileLevel.weaponStatsStorageSum[victim].mainHandActiveWeapon ) || !fileLevel.weaponStatsStorageSum[victim].mainHandActiveWeapon.IsWeaponX() )
		return false
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_VictimUsingWeapon:", target, fileLevel.weaponStatsStorageSum[victim].mainHandActiveWeapon.GetWeaponClassName() )
	#endif
	return fileLevel.weaponStatsStorageSum[victim].mainHandActiveWeapon.GetWeaponClassName() == target
}

bool function WeaponStatsCondition_VictimPosLower( StatInstance si, entity attacker, entity victim, int offset )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_VictimPosLower:", attacker.GetOrigin(), victim.GetOrigin() )
	#endif
	return attacker.GetOrigin().z > victim.GetOrigin().z + offset
}

bool function WeaponStatsCondition_IsEnergized( StatInstance si, entity weapon )
{
	return false//weapon.GetLastEnergizeState() == ENERGIZE_ENERGIZED
}

bool function WeaponStatsCondition_ShieldMatchType( entity player, int shieldTier )
{
	LootData lootData = EquipmentSlot_GetEquippedLootDataForSlot( player, "armor" )
	//bool matchEvolvedShield = isEvolvedShield == EvolvingArmor_IsEquipmentEvolvingArmor( lootData.ref )
	return shieldTier == lootData.tier
}

bool function WeaponStatsCondition_VictimWeaponIsReloading( StatInstance si, entity victim )
{
	if ( victim == null )
		return false
	entity activeWeapon = victim.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if ( !IsValid( activeWeapon ) )
		return false
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_VictimWeaponIsReloading:", activeWeapon.IsReloading(), activeWeapon.GetWeaponClassName() )
	#endif
	return activeWeapon.IsReloading()
}

bool function WeaponStatsCondition_WithinPickupTime( StatInstance si, entity player, entity weapon, float validSeconds, float dropWeaponCheck )
{
	if ( !(player in fileLevel.PickupWeaponTime) )
		return false
	string weaponName = weapon.GetWeaponClassName()
	bool dropRecently = player in fileLevel.DropWeaponTime && weaponName in fileLevel.DropWeaponTime[player] && fileLevel.DropWeaponTime[player][weaponName] + dropWeaponCheck >= Time()
	return !dropRecently && player in fileLevel.PickupWeaponTime && weaponName in fileLevel.PickupWeaponTime[player] && fileLevel.PickupWeaponTime[player][weaponName] + validSeconds >= Time()
}

bool function WeaponStatsCondition_FireRateReached( StatInstance si, entity player, entity weapon, float target )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_FireRateReached", weapon.GetFireRateTimeLerpFraction() )
	#endif
	return false//weapon.GetFireRateTimeLerpFraction() >= target
}

bool function WeaponStatsCondition_IsSkydiving( StatInstance si, entity player )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_IsSkydiving:", player.GetPlayerName(), player.Player_IsSkydiving() )
	#endif
	return player.Player_IsSkydiving()
}

bool function WeaponStatsCondition_IsLastOneInTeam( StatInstance si, entity player )
{
	if ( !IsAlive( player ) )
		return false
	array<entity> teammates = GetPlayerArrayOfTeam( player.GetTeam() )
	if ( teammates.len() == 1 )
		return false
	foreach ( teammate in teammates )
	{
		if ( teammate != player && IsAlive( teammate ))
		{
			return false
		}
	}
	return true
}

bool function WeaponStatsCondition_AttackerHasShield( StatInstance si, entity player )
{
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Condition_AttackerHasShield:", player.GetPlayerName(), player.GetShieldHealth() )
	#endif
	return player.GetShieldHealth() > 0
}

bool function WeaponStatsCondition_IsCarUsingAltAmmo( StatInstance si, entity weaponEnt )//if true, CAR is using alt(light) ammo
{
	return weaponEnt.HasMod( CAR_ALT_AMMO_MOD )
}

bool function WeaponStatsCondition_StatisticExist( int statisticType/*eStatisticTable*/, entity player, StatInstance si )
{
	return si in fileLevel.weaponStatsStorageSum[player].Statistic[statisticType] && fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] > 0
}

bool function WeaponStatsCondition_StatisticTimeWithin( int statisticType/*eStatisticTable*/, entity player, StatInstance si, float validSeconds, bool clear = false )
{
	bool result = si in fileLevel.weaponStatsStorageSum[player].Statistic[statisticType] && Time() - fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] <= validSeconds
	if ( clear )
		fileLevel.weaponStatsStorageSum[player].Statistic[statisticType][si] <- 0
	return result
}
#endif





















