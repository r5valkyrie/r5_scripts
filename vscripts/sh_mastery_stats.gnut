void function InitWeaponStatsConfig()
{
	for ( int i = 0; i < eCountTable.len(); i++ )
		fileLevel.weaponStatsConfigs.writeCondition_Count.append( {} )
	for ( int i = 0; i < eStatisticTable.len(); i++ )
		fileLevel.weaponStatsConfigs.writeCondition_Statistic.append( {} )
	for ( int i = 0; i < eAdditionalParamsType.len(); i++ )
		fileLevel.weaponStatsConfigs.additionalParams.append( {} )
	for ( int i = 0; i < eValidateLocation.len(); i++ )
		fileLevel.weaponStatsConfigs.validateConditions.append( {} )
	for ( int i = 0; i < eClearConfig.len(); i++ )
		fileLevel.weaponStatsConfigs.clearActionConfigs.append( {} )
	for ( int i = 0; i < eWriteCondition.len(); i++ )
		fileLevel.weaponStatsConfigs.writeConditions.append( {} )
}

void function ConfigTableAddConditionParams( table<string, array<array<string> > > tab, string conditionKey, array<string> conditionParams )
{
	if ( !( conditionKey in tab ) )
		tab[conditionKey] <- []
	tab[conditionKey].append( conditionParams )
}

// this function is used to get the condition params
// e.g. stat param string: "Down:1|true;Damage:2|false" for behavior "FireAndHit"
//   "Down" and "Damage" are condition keys
// after condition key (separated by ':') is condition params, condition params separated by '|'
//   [ "1", "true" ] for "Down",  [ "2", "false" ] for Damage
// index starts from 0
//   GetSingleConfig( configTable, "Down", 0 ) == "1", GetSingleConfig( configTable, "Down", 1 ) == "true"
//   GetSingleConfig( configTable, "Damage", 0 ) == "2", GetSingleConfig( configTable, "Damage", 1 ) == "false"
string function GetSingleConfig( table<string, array<array<string> > > tab, string key, int index, string defaultValue = "" )
{
	if ( !( key in tab ) )
		return defaultValue
	Assert( tab[key].len() == 1, "This config key does not have single value!" )
	if ( tab[key][0].len() > index )
		return tab[key][0][index]
	return defaultValue
}

bool function HasAdditionalParams( int paramType/*eAdditionalParamsType*/, StatInstance si, int index = 0 )
{
	return si in fileLevel.weaponStatsConfigs.additionalParams[paramType] && fileLevel.weaponStatsConfigs.additionalParams[paramType][si].len() > index
}

void function InitMaxAttachmentLevel()
{
	maxAttachmentLevel = {}
	var attachmentMatrix = GetDataTable( WEAPON_ATTACHMENT_MATRIX_DATATABLE )
	int amRowCount       = GetDataTableRowCount( attachmentMatrix )

	array<LootData> allWeapons = SURVIVAL_Loot_GetByType( eLootType.MAINWEAPON )
	for ( int i = 0; i < amRowCount; i++ )
	{
		string attachmentName = GetDataTableString( attachmentMatrix, i, GetDataTableColumnByName( attachmentMatrix, "attachmentName" ) )
		if ( !SURVIVAL_Loot_IsRefValid( attachmentName ) || SURVIVAL_Loot_IsRefDisabled( attachmentName ) )
			continue
		int attachmentTier = SURVIVAL_Loot_GetLootDataByRef( attachmentName ).tier
		array<string> attachPoints = split( GetDataTableString( attachmentMatrix, i, GetDataTableColumnByName( attachmentMatrix, "attachmentPoint" ) ), WHITESPACE_CHARACTERS )
		foreach ( ap in attachPoints )
			if ( !allAttachments.contains( ap ) )
				allAttachments.append( ap )
		foreach ( data in allWeapons )
		{
			Assert( !IsAttachmentAmbiguousForWeapon( attachmentName, data.ref, attachPoints ) )
			int col = GetDataTableColumnByName( attachmentMatrix, data.baseWeapon )
			if ( col == -1 )
				continue
			bool attachmentIsEnabled = GetDataTableBool( attachmentMatrix, i, col )

			foreach ( string attachPoint in attachPoints )
			{
				if ( attachmentIsEnabled && data.supportedAttachments.contains( attachPoint ) )
				{
					if ( !( data.baseWeapon in maxAttachmentLevel ) )
						maxAttachmentLevel[data.baseWeapon] <- {}
					if ( !( attachPoint in maxAttachmentLevel[data.baseWeapon] ) || maxAttachmentLevel[data.baseWeapon][attachPoint] < attachmentTier )
						maxAttachmentLevel[data.baseWeapon][attachPoint] <- attachmentTier
				}
			}
		}
	}
}

void function Mastery_ParseStat( StatInstance si, string statBehavior, string statValidation, string statParams )
{
	table<string, array<array<string> > > configTable
	array<string> conditions = split( statParams, ";" )//e.g. IsAds:true;WithoutAttachmentType:sight

	foreach ( pairs in conditions )
	{
		array<string> pairSplit = split( pairs, ":" )//e.g. IsAds:true
		Assert( pairSplit.len() <= 2 )
		if ( pairSplit.len() == 1 )
			ConfigTableAddConditionParams( configTable, pairSplit[0], [] )
		else
			ConfigTableAddConditionParams( configTable, pairSplit[0], ConditionParamBreaker( pairSplit[1], "|" ) )
	}

	//#if WEAPON_STATS_DEBUG
	//	printt( "WeaponStats:Parse:", statBehavior, statParams, statValidation )
	//#endif
	switch ( statBehavior )
	{
		case "DownCount":
			WeaponStatsConfig_UniversalCount( eCountTable.DOWN, si, configTable, statValidation )
			break

		case "KillCountXP":
			WeaponStatsConfig_KillCountXP( si, configTable, statValidation )
			break

		case "KillCountWithDownCondition":
			WeaponStatsConfig_KillCountWithDownCondition( si, configTable, statValidation )
			break

		case "KillNpc":
			WeaponStatsConfig_UniversalCount( eCountTable.NPC_KILL, si, configTable, statValidation )
			break

		case "BreakShieldCount":
			WeaponStatsConfig_BreakShield( si, configTable, statValidation )
			break

		case "ContinuousWeaponDownCount":
			WeaponStatsConfig_UniversalCount( eCountTable.CONTINUOUS_DOWN, si, configTable, statValidation )
			break

		case "AssistCount":
			WeaponStatsConfig_UniversalCount( eCountTable.ASSIST, si, configTable, statValidation, CONDITION_PARAMS_WEAPON )
			break

		case "RevivePairKill":
			WeaponStatsConfig_UniversalCount( eCountTable.REVIVE_PAIR_KILL, si, configTable, statValidation )
			break

		case "WipeSquad":
			WeaponStatsConfig_WipeSquad( si, configTable )
			break

		case "BreakShieldInSquad":
			WeaponStatsConfig_BreakShieldInSquad( si, configTable, statValidation )
			break

		case "DownCountAfterDamage":
			WeaponStatsConfig_DownCountAfterDamage( si, configTable, statValidation )
			break

		case "DownCountAfterReload":
			WeaponStatsConfig_DownCountAfterReload( si, configTable, statValidation )
			break

		case "DownCountAfterBreakShield":
			WeaponStatsConfig_DownCountAfterBreakShield( si, configTable, statValidation )
			break

		case "DownCountWithoutReload":
			WeaponStatsConfig_DownCountWithoutReloadAndTriggerRelease( si, configTable, statValidation )
			break

		case "DownCountWithoutTriggerRelease":
			WeaponStatsConfig_DownCountWithoutTriggerRelease( si, configTable, statValidation )
			break

		case "DownCountWithoutAnyTriggerRelease":
			WeaponStatsConfig_DownCountWithoutReloadAndTriggerRelease( si, configTable, statValidation, true )
			break

		case "DownCountWithoutWeaponOverheat":
			WeaponStatsConfig_DownCountWithoutWeaponOverheat( si, configTable, statValidation )
			break

		case "DownCountWithFirstHitCondition":
			WeaponStatsConfig_DownCountWithFirstHitCondition( si, configTable, statValidation )
			break

		case "DamageStatistic":
			WeaponStatsConfig_UniversalStatistic( eStatisticTable.DAMAGE, si, configTable, statValidation )
			break

		case "DamageStatisticInShots":
			WeaponStatsConfig_DamageStatisticInShots( si, configTable, statValidation )
			break

		case "DamageStatisticNoReload":
			WeaponStatsConfig_DamageStatisticNoReload( si, configTable, statValidation )
			break

		case "DoubleKill":
			WeaponStatsConfig_DoubleKill( si, configTable )
			break

		case "FinishOff":
			WeaponStatsConfig_FinishOff( si, configTable, statValidation )
			break

		case "KillCountWithCategoryAndDownCondition":
			WeaponStatsConfig_KillCountWithCategoryAndDownCondition( si, configTable, statValidation )
			break

		case "DownWithoutEvent":
			WeaponStatsConfig_DownWithoutEvent( si, configTable, statValidation )
			break

		case "FireAndHit":
			WeaponStatsConfig_FireAndHit( si, configTable, statValidation )
			break

		case "ContinuousHitCount":
			WeaponStatsConfig_ContinuousHitCount( si, configTable, statValidation )
			break

		case "LandXBullets":
			WeaponStatsConfig_LandXBullets( si, configTable, statValidation )
			break

		case "RawDamage":
			WeaponStatsConfig_RawDamage( si, configTable, statValidation )
			break

		case "WeaponHoldTimeStatistic":
			WeaponStatsConfig_WeaponHoldTimeStatistic( si, configTable, statValidation )
			break

		case "HitAccuracyAtRound":
			WeaponStatsConfig_HitAccuracyAtRound( si, configTable, statValidation )
			break

		case "BreakIncapShieldAfterDown":
			WeaponStatsConfig_BreakIncapShieldAfterDown( si, configTable, statValidation )
			break
	}
}

array<bool functionref( entity, StatInstance, entity, entity ornull, var )> function ConditionUniversalParse( table<string, array<array<string> > > configTable, StatInstance si, int hookParams = CONDITION_PARAMS_ALL )
{
	RefreshParseCheck( hookParams )
	array<bool functionref( entity, StatInstance, entity, entity ornull, var )> conditionFuncs
	foreach ( k, v in configTable )
		foreach( m in v )
			ConditionParse( conditionFuncs, k, m, si )
	if ( conditionFuncs.len() == 0 )
		conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) { return true } )
	CheckParamsInHook()
	return conditionFuncs
}

void function ConditionParse( array<bool functionref( entity, StatInstance, entity, entity ornull, var )> conditionFuncs, string conditionKey, array<string> conditionValues, StatInstance si )
{
	switch ( conditionKey )
	{
		case "IsAds":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsAds ( si, weaponEnt ) == arg } )
			break

		case "WithAttachmentType":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			ParseAttachments( conditionFuncs, conditionValues )
			break

		case "WithoutAttachmentType":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			string attachment = conditionValues[0]
			Assert( allAttachments.contains( attachment ), attachment + " not found in allAttachments!" )
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( attachment ) {
				return WeaponStatsCondition_WithoutAttachmentType ( si, weaponEnt, attachment )
			} )
			break

		case "WithExactAttachment":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			string attachmentPoint = conditionValues[0]
			string attachmentName = conditionValues[1]
			bool isPrefix = conditionValues.len() > 2 && conditionValues[2] == "true"
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( attachmentPoint, attachmentName, isPrefix ) {
				return WeaponStatsCondition_WithAttachmentName ( si, weaponEnt, attachmentPoint, attachmentName, isPrefix )
			} )
			break

		case "WithinGotRevived":
			int validSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( validSeconds ) { return WeaponStatsCondition_WithinGotRevived ( attacker, si, validSeconds ) } )
			break

		case "AttackerInZipline":
			int validSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( validSeconds ) { return WeaponStatsCondition_TargetInZipline ( attacker, si, validSeconds ) } )
			break

		case "TargetInZipline":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int validSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( validSeconds ) { return WeaponStatsCondition_TargetInZipline ( expect entity( victim ), si, validSeconds ) } )
			break

		case "DamageInPeriod":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int timeLimit = conditionValues[0].tointeger()
			int requiredDamage = conditionValues[1].tointeger()
			bool useBothWeapon = conditionValues.contains( "use_both_weapons" ) ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( timeLimit, requiredDamage, useBothWeapon )
			{
				return WeaponStatsCondition_DamageInPeriodComplete( attacker, si, expect entity( victim ), timeLimit, requiredDamage, useBothWeapon )
			} )
			break

		case "IsSemiAuto":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsSemiAuto( si, weaponEnt ) == arg } )
			break

		case "DistanceWithin":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			float dist = conditionValues[0].tointeger() * INCHES_PER_METER
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( dist ) { return WeaponStatsCondition_TargetDistanceWithin( si, attacker, expect entity( victim ), dist ) } )
			break

		case "DistanceExceeds":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			float dist = conditionValues[0].tointeger() * INCHES_PER_METER
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( dist ) { return WeaponStatsCondition_TargetDistanceExceeds( si, attacker, expect entity( victim ), dist ) } )
			break

		case "LimitAmmo":
			int target = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target )
			{
				// if the last kill meet continuous weapon conditions, means all the previous meet the condition.
				bool needCheckContinuousLimitAmmo = si in fileLevel.weaponStatsStorageSum[attacker].AmmoUsedTrace &&
				si in fileLevel.weaponStatsConfigs.validateCondition_Count &&
				fileLevel.weaponStatsStorageSum[attacker].AmmoUsedTrace[si].len() == fileLevel.weaponStatsConfigs.validateCondition_Count[si]
				return WeaponStatsCondition_LimitAmmo ( attacker, si, target, needCheckContinuousLimitAmmo )
			} )
			break

		case "LimitDamage":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGED_PLAYERS][si] <- []
			int limit = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( limit )
			{
				return WeaponStatsCondition_LimitDamage( player, si, expect entity( target ), limit )
			} )
			break

		case "DamageContribution":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGED_PLAYERS][si] <- []
			float ratio = conditionValues[0].tofloat()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( ratio )
			{
				return WeaponStatsCondition_DamageContribution( player, si, expect entity( target ), ratio )
			} )
			break

		case "MatchIncreaseOnce":
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo )
			{
				return WeaponStatsCondition_IncreaseTimesLimit ( attacker, si, 1 )  // "MatchIncreaseOnce" means limit:1
			} )
			break

		case "ReturnFire":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int validSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( validSeconds )
			{
				return WeaponStatsCondition_ReturnFire( attacker, expect entity( victim ), validSeconds )
			} )
			break

		case "AttackerEvent":
			string eventKey = conditionValues[0]
			int validSeconds = conditionValues[1].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( eventKey, validSeconds )
			{
				return WeaponStatsCondition_TargetEvent( attacker, eventKey, validSeconds )
			} )
			break

		case "AttackerHasNoEvent":
			string eventKey = conditionValues[0]
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( eventKey )
			{
				return !WeaponStatsCondition_TargetEvent( attacker, eventKey, -1 )
			} )
			break

		case "TargetEvent":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			string eventKey = conditionValues[0]
			int validSeconds = conditionValues[1].tointeger()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( eventKey, validSeconds )
			{
				return WeaponStatsCondition_TargetEvent( expect entity( victim ), eventKey, validSeconds )
			} )
			break

		case "TargetHasNoEvent":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			string eventKey = conditionValues[0]
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( eventKey )
			{
				return !WeaponStatsCondition_TargetEvent( expect entity( victim ), eventKey, -1 )
			} )
			break

		case "TargetInteractEvent":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			string eventKey = conditionValues[0]
			int validSeconds = conditionValues[1].tointeger()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( eventKey, validSeconds )
			{
				return WeaponStatsCondition_TargetInteractEvent( player, expect entity( target ), eventKey, validSeconds )
			} )
			break

		case "TargetRevivePair":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int validSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( validSeconds )
			{
				return WeaponStatsCondition_TargetRevivePair( player, si, expect entity( target ), validSeconds )
			} )
			break

		case "TeammateInteractWithTarget":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			string event = conditionValues[0]
			int validSeconds = conditionValues[1].tointeger()
			bool exchangeActivePassive = conditionValues[2] == "true" ? true : false
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( event, validSeconds, exchangeActivePassive )
			{
				return WeaponStatsCondition_TeammateInteractWithTarget( player, si, expect entity( target ), event, validSeconds, exchangeActivePassive )
			} )
			break

		case "TargetDamageAttackerWithWeapon":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int validSeconds = conditionValues[0].tointeger()
			string weaponName = conditionValues[1]
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( validSeconds, weaponName )
			{
				return WeaponStatsCondition_TargetInteractEvent( expect entity( target ), player, WEAPON_DAMAGE + weaponName, validSeconds )
			} )
			break

		case "TargetIsProwler":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) { return IsProwler( expect entity( target ) ) } )
			break

		case "AttackWithoutOverheat":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_START_TIME][si] <- []
			int resetSeconds = conditionValues[0].tointeger()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo ) : ( resetSeconds )
			{
				return WeaponStatsCondition_AttackWithoutOverheat( player, si, expect entity( target ), resetSeconds )
			} )
			break

		case "IncapShieldBreakerSameAsKiller":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.BREAK_INCAP_SHIELD_TIME][si] <- []
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull target, var damageInfo )
			{
				return WeaponStatsCondition_IncapShieldBreakerSameAsKiller( player, si, expect entity( target ) )
			} )
			break

		case "TraceRotation":
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.TRACE_ROTATION][si] <- []
			break

		case "ClearOnCompleteRecovery":
			fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.COMPLETE_RECOVERY][si] <- []
			break

		case "AttackerOutsideSafezone":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg )  { return WeaponStatsCondition_TargetOutsideSafezone( attacker ) == arg } )
			break

		case "TargetOutsideSafezone":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg )  { return WeaponStatsCondition_TargetOutsideSafezone( expect entity( victim ) ) == arg } )
			break

		case "TargetInAir":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg )  { return WeaponStatsCondition_TargetInAir( expect entity( victim ) ) == arg } )
			break

		case "AttackerInAir":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg )  { return WeaponStatsCondition_TargetInAir( attacker ) == arg } )
			break

		case "AttackerSameAsKiller":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int timeLimit = conditionValues.len() > 0 && conditionValues[0].len() > 0 ? conditionValues[0].tointeger() : -1
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( timeLimit )  { return WeaponStatsCondition_AttackerSameAsKiller( si, attacker, expect entity( victim ), float( timeLimit ) ) } )
			break

		case "IsHeadshot":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsHeadshot( si, damageInfo, expect entity( victim ) ) == arg } )
			break

		case "IsOneShotKill":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) {
				return !WeaponStatsCondition_TargetInteractEvent( attacker, expect entity( victim ), LAST_DAMAGE_TIME, ONE_SHOT_KILL_INVALID_TIME )
			} )
			break

		case "InTempo":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_InTempo( si, weaponEnt ) == arg } )
			break

		case "IsFullyHeated":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsFullyHeated( si, weaponEnt ) == arg } )
			break

		case "IsMaxChargeLevel":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsMaxChargeLevel( attacker, si, weaponEnt ) == arg } )
			break

		case "OverChargeFraction":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			float arg = conditionValues[0].tofloat()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_OverChargeFraction( attacker, si, weaponEnt, arg ) == true } )
			break

		case "IsEnergized":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) { return WeaponStatsCondition_IsEnergized( si, weaponEnt ) } )
			break

		case "VictimWeaponIsReloading":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) { return WeaponStatsCondition_VictimWeaponIsReloading( si, expect entity( victim ) ) } )
			break

		case "WeaponWithinPickupTime":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			float target = conditionValues.len() > 0 ? conditionValues[0].tofloat() : WEAPON_PICKUP_INVALID_TIME
			float dropWeaponCheck = conditionValues.len() > 1 ? conditionValues[1].tofloat() : WEAPON_PICKUP_INVALID_TIME
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target, dropWeaponCheck ) {
				return WeaponStatsCondition_WithinPickupTime( si, attacker, weaponEnt, target, dropWeaponCheck )
			} )
			break

		case "WeaponWithinSwitchTime":
			float target = conditionValues.len() > 0 ? conditionValues[0].tofloat() : WEAPON_PICKUP_INVALID_TIME
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target ) {
				return Time() - GetTargetEventTime( attacker, WEAPON_SWITCH ) <= target
			} )
			break

		case "WeaponFireRateReached":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			float target = conditionValues[0].tofloat()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target ) {
				return WeaponStatsCondition_FireRateReached( si, attacker, weaponEnt, target )
			} )
			break

		case "AttackerIsSliding":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return attacker.IsSliding() == arg } )
			break

		case "VictimIsSliding":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return ( expect entity( victim ) ).IsSliding() == arg } )
			break

		case "IsMagEmpty":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsMagEmpty( attacker, si, weaponEnt ) == arg } )
			break

		case "IsLastMag":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsLastMag( attacker, si, weaponEnt ) == arg } )
			break

		case "AttackerHpWithin":
			float target = conditionValues[0].tofloat()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target )
			{
				return !WeaponStatsCondition_PlayerHPExceeds( si, player, target )
			} )
			break

		case "VictimUsingWeapon":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			string target = conditionValues[0]
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target )
			{
				return WeaponStatsCondition_VictimUsingWeapon( si, target, expect entity( victim ) )
			} )
			break

		case "VictimPosLower":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			int offset = conditionValues.len() > 0 ? conditionValues[0].tointeger() : PLAYER_HEIGHT_OFFSET_DEFAULT
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( offset ) { return WeaponStatsCondition_VictimPosLower( si, player, expect entity( victim ), offset ) } )
			break

		case "VictimIsSkydiving":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsSkydiving( si, expect entity( victim ) ) == arg } )
			break

		case "VictimIsExecuting":
			AddParamForChecking( CONDITION_PARAMS_VICTIM )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			Assert( conditionValues[1] == "true" || conditionValues[1] == "false" )
			bool forceTargetIsTeammate = conditionValues[1] == "true" ? true : false
			fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIM_EXECUTING_ENEMY][si] <- []
			fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.EXECUTING_TEAMMATE][si] <- [ forceTargetIsTeammate ]
			fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_ATTACK][si] <- [ void function( entity player ) : ( si ) {
				if ( !(player in fileLevel.weaponStatsStorageSum) )
					return
				if ( !(si in fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy) )
					return
				fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si].clear()
			} ]
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg )
			{
				if ( !(player in fileLevel.weaponStatsStorageSum) )
					return false
				if ( !(si in fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy) )
					return false
				entity victimEnt = expect entity( victim )
				if ( !(victimEnt in fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si]) )
					return false
				return fileLevel.weaponStatsStorageSum[player].VictimExecutingEnemy[si][victimEnt] == arg
			} )
			break

		case "WithWeaponCategory":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			string weaponCategoryGUID = conditionValues[0].toupper()
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( weaponCategoryGUID )
			{
				ItemFlavor ornull weaponItem = GetWeaponItemFlavorByClass( weaponEnt.GetWeaponClassName() )
				if ( weaponItem == null )
					return false
				ItemFlavor weaponCategory = WeaponItemFlavor_GetCategory( expect ItemFlavor( weaponItem ) )
				return ItemFlavor_GetGUIDString( weaponCategory ) == weaponCategoryGUID
			} )
			break

		case "LastOneInTeam":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsLastOneInTeam( si, player ) == arg } )
			break

		case "AttackerHasShield":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_AttackerHasShield( si, player ) == arg } )
			break

		case "CarUsingAltAmmo":
			AddParamForChecking( CONDITION_PARAMS_WEAPON )
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg ) { return WeaponStatsCondition_IsCarUsingAltAmmo( si, weaponEnt ) == arg } )
			break

		case "StatisticExist":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			int statisticType = conditionValues[1].tointeger()
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg, statisticType ) { return WeaponStatsCondition_StatisticExist( statisticType, player, si ) == arg } )
			break

		case "StatisticTimeWithin":
			Assert( conditionValues[0] == "true" || conditionValues[0] == "false" )
			bool arg = conditionValues[0] == "true" ? true : false
			int statisticType = conditionValues[1].tointeger()
			float validSeconds = conditionValues[2].tofloat()
			bool clear = conditionValues.len() > 3 && conditionValues[3] == "true"
			conditionFuncs.append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( arg, statisticType, validSeconds, clear ) {
				return WeaponStatsCondition_StatisticTimeWithin(statisticType, player, si, validSeconds, clear ) == arg
			} )
			break

	}
}

//arg1: string array, attachment points, e.g. "sight,barrel". If "all" is presented, all attachment is required except other attachments written in this field, e.g. "sight, all" means all attachments except sight
//arg2: string, optional, weaponRef, e.g. "mp_weapon_rspn101"
//arg3: int or "max", optional, tier requirement, "max" will find max tier for each attachment
void function ParseAttachments( array<bool functionref( entity, StatInstance, entity, entity ornull, var )> conditionFuncs, array<string> args )
{
	array<string> attachments = ConditionParamBreaker( args[0], "," )
	string weaponRef = args.len() > 1 ? args[1] : ""
	if ( attachments.contains( REQUIRE_ALL_ATTACHMENTS ) )
	{
		Assert( weaponRef.len() > 0, "Must give weaponRef if arg1 == " + REQUIRE_ALL_ATTACHMENTS )
		array<string> excludeAttachment = []
		foreach ( a in attachments )
			excludeAttachment.append( a )
		array<string> fullAttachment = SURVIVAL_Loot_GetLootDataByRef( weaponRef ).supportedAttachments
		attachments = []
		foreach ( a in fullAttachment )
			if ( !excludeAttachment.contains( a ) )
				attachments.append( a )
	}
	foreach ( attachment in attachments )
		if ( !allAttachments.contains( attachment ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( attachment + " not found in allAttachments!" )
			#endif
			return
		}
	if ( args.len() > 2 && args[2] == REQUIRE_MAX_TIER )
	{
		Assert( weaponRef.len() > 0, "Must give weaponRef if arg3 == " + REQUIRE_MAX_TIER )
		if ( !( weaponRef in maxAttachmentLevel ) )
		{
			#if WEAPON_STATS_DEBUG
				printt( weaponRef + " weaponRef not in maxAttachmentLevel" )
			#endif
			return
		}
		table<int, array<string> > filter = {}
		foreach ( attachment in attachments )
		{
			if ( !( attachment in maxAttachmentLevel[weaponRef] ) )
			{
				#if WEAPON_STATS_DEBUG
					printt( attachment + " is not in maxAttachmentLevel[" + weaponRef + "]" )
				#endif
				return
			}
			int tier = maxAttachmentLevel[weaponRef][attachment]
			if ( !( tier in filter ) )
				filter[tier] <- []
			filter[tier].append( attachment )
		}
		foreach ( k, v in filter )
		{
			int tierRequirement = k
			array<string> tierAttachments = v
			conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( tierRequirement, tierAttachments ) {
				return WeaponStatsCondition_WithAttachmentType ( si, weaponEnt, tierAttachments, tierRequirement )
			} )
		}
	}
	else
	{
		int requireTier = args.len() > 2 ? args[2].tointeger() : -1
		conditionFuncs.append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( attachments, requireTier ) {
			return WeaponStatsCondition_WithAttachmentType ( si, weaponEnt, attachments, requireTier )
		} )
	}
}

array<string> function ConditionParamBreaker( string input, string delimiter = "|" )
{
	array<string> args
	int start = 0
	for ( int i = 0; i < input.len(); i++ )
	{
		if ( input.slice( i, i + 1 ) == delimiter )
		{
			args.append( input.slice( start, i ) )
			start = i + 1
		}
	}
	args.append( input.slice( start, input.len() ) )
	return args
}

bool function ConditionsEvaluate( array<bool functionref( entity, StatInstance, entity, entity ornull, var )> conditionFuncs, StatInstance si, entity player, entity weaponEnt, entity ornull victim = null, var damageInfo = null )
{
	foreach ( condition in conditionFuncs )
	{
		if ( !( condition( player, si, weaponEnt, victim, damageInfo ) ) )
			return false
	}
	return true
}

bool function WriteConditionsEvaluate( int writeCondition/*eWriteCondition*/, StatInstance si, entity player, entity weaponEnt, entity ornull victim = null, var damageInfo = null )
{
	return si in fileLevel.weaponStatsConfigs.writeConditions[writeCondition] && ConditionsEvaluate( fileLevel.weaponStatsConfigs.writeConditions[writeCondition][si], si, player, weaponEnt, victim, damageInfo )
}

void function WeaponStatsConfig_UniversalCount( int countTable/*eCountTable*/, StatInstance si, table<string, array<array<string> > > configTable, string validation, int hookParams = CONDITION_PARAMS_ALL )
{
	fileLevel.weaponStatsConfigs.writeCondition_Count[countTable][si] <- ConditionUniversalParse( configTable, si, hookParams )
	fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

void function WeaponStatsConfig_UniversalStatistic( int statisticType/*eStatisticTable*/, StatInstance si, table<string, array<array<string> > > configTable, string validation, int hookParams = CONDITION_PARAMS_ALL )
{
	fileLevel.weaponStatsConfigs.writeCondition_Statistic[statisticType][si] <- ConditionUniversalParse( configTable, si, hookParams )
	fileLevel.weaponStatsConfigs.validateCondition_Statistic[si] <- validation.tofloat()
}

void function WeaponStatsConfig_DamageStatisticInShots( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_ANY_VICTIM_IN_PERIOD][si] <- ConditionUniversalParse( configTable, si )

	int shotCount = GetSingleConfig( configTable, SHOT_COUNT, 0 ).tointeger()
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si] <- [ shotCount ]

	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_ATTACK][si] <- [ void function( entity player ) : ( si ) {
		if ( si in fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod )
			MoveDamageInPeriodInfoToNext( fileLevel.weaponStatsStorageSum[player].DamageAnyVictimInPeriod[si] )
	} ]

	int damage = validation.tointeger()
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DAMAGE_ANY_VICTIM_IN_PERIOD][si] <- ( bool function( entity player, StatInstance si, ... ) : ( damage ) {
		return WeaponStatsCondition_DamageAnyVictimInPeriodComplete( player, si, NO_TIME_LIMIT, damage, false )
	} )
}

void function WeaponStatsConfig_DamageStatisticNoReload( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	WeaponStatsConfig_UniversalStatistic( eStatisticTable.DAMAGE, si, configTable, validation )
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- [ void function( entity player ) : ( si ) { fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.DAMAGE][si] <- 0 } ]
}

void function WeaponStatsConfig_KillCountXP( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.TIME, true]
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.KILL_COUNT_XP][si] <- [ GetSingleConfig( configTable, XP_WEIGHT, 0, "1" ).tofloat() ]
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) { WeaponStatsStorageClear_VictimsProperty( player, victim, si ) } ]
}

void function WeaponStatsConfig_KillCountWithDownCondition( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.TIME, true]
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) { WeaponStatsStorageClear_VictimsProperty( player, victim, si ) } ]
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.KILL_WITH_DOWN_CONDITION][si] <- [
		bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) {
			entity victimEnt = expect entity( victim )
			return si in fileLevel.weaponStatsStorageSum[player].VictimsProperty && victimEnt in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si]
		} ]
	fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

void function WeaponStatsConfig_BreakShield( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	WeaponStatsConfig_UniversalCount( eCountTable.BREAK_SHIELD, si, configTable, validation )

	if ( SHIELD_TYPE in configTable )
	{
		int shieldTier = GetSingleConfig( configTable, SHIELD_TYPE, 0, "1" ).tointeger()
		// bool isEvolvedShield = configTable[SHIELD_TYPE][1] == "true" ? true : false
		fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.BREAK_SHIELD][si].append(
			bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( shieldTier )
			{
				Assert( victim != null, "WeaponStatsConfig_BreakShield, but victim is null")
				return WeaponStatsCondition_ShieldMatchType( expect entity( victim ), shieldTier )
			} )
	}
	if ( WITHOUT_RELOADING in configTable )
	{
		array<void functionref(entity)> clearActions = [ void function( entity player ) : ( si ) { fileLevel.weaponStatsStorageSum[player].Count[eCountTable.BREAK_SHIELD][si] <- 0 } ]
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- clearActions
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions
	}
}

void function WeaponStatsConfig_FireAndHit( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	int validateLocation   = AMMO_HIT_VALIDATIONS[validation]
	if ( AMMO_HIT_FROM_START in configTable )
		fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.FIREANDHIT][si] <- [ validateLocation ]
	else
		fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.FIREANDHIT][si] <- [ validateLocation, false ]
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_FIRED][si] <- ConditionUniversalParse( {}, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si] <- ConditionUniversalParse( configTable, si )
	array<void functionref(entity)> clearActions                      = [ void function( entity player ) : ( si ) {
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
	} ]
	array<bool functionref(entity, StatInstance)> additionalValidates = []
	if ( DOWN in configTable )
	{
		table<string, array<array<string> > > downConfigTable
		foreach ( condition, args in configTable )
		{
			if ( condition.len() >= DOWN_PREFIX.len() && condition.slice( 0, DOWN_PREFIX.len() ) == DOWN_PREFIX )
				downConfigTable[condition.slice( DOWN_PREFIX.len(), condition.len() )] <- args
			else
				downConfigTable[condition] <- args
		}
		fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( downConfigTable, si )
		int target    = GetSingleConfig( configTable, DOWN, 0, "0" ).tointeger()
		bool exactFit = GetSingleConfig( configTable, DOWN, 1 ) == "true" ? true : false
		additionalValidates.append( bool function( entity player, StatInstance si ) : ( target, exactFit ) {
			if ( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN] )
			{
				int downCount = fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si]
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:FireHitDowned:", player.GetPlayerName(), downCount, target )
				#endif
				return exactFit ? downCount == target : downCount >= target
			}
			return false
		} )
		clearActions.append( void function( entity player ) : ( si ) {
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] <- 0
		} )
	}
	if ( DAMAGE in configTable )
	{
		table<string, array<array<string> > > damageConfigTable
		foreach ( condition, args in configTable )
		{
			if ( condition.len() >= DAMAGE_PREFIX.len() && condition.slice( 0, DAMAGE_PREFIX.len() ) == DAMAGE_PREFIX )
				damageConfigTable[condition.slice( DAMAGE_PREFIX.len(), condition.len() )] <- args
			else
				damageConfigTable[condition] <- args
		}
		fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGED_PLAYERS][si] <- ConditionUniversalParse( damageConfigTable, si )
		int target    = GetSingleConfig( configTable, DAMAGE, 0, "0" ).tointeger()
		bool exactFit = GetSingleConfig( configTable, DAMAGE, 1 ) == "true" ? true : false
		additionalValidates.append( bool function( entity player, StatInstance si ) : ( target, exactFit ) {
			if ( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers )
			{
				int damagedCount = fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si].len()
				#if WEAPON_STATS_DEBUG
					printt( "WeaponStats:FireHitDamaged:", player.GetPlayerName(), damagedCount, target )
				#endif
				return exactFit ? damagedCount == target : damagedCount >= target
			}
			return false
		} )
		clearActions.append( void function( entity player ) : ( si ) {
			fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
		} )
	}

	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.FIRE_HIT_VALIDATE_PASSED][si] <- clearActions

	if ( CLEAR_ON_WEAPON_ATTACK in configTable )
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_ATTACK][si] <- clearActions

	if ( CLEAR_ON_POST_WEAPON_ATTACK in configTable )
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.POST_WEAPON_ATTACK][si] <- clearActions

	bool allowPartialHit = ( ALLOW_PARTIAL_HIT in configTable )

	bool functionref( entity, StatInstance, ... ) validateFunction = ( bool function( entity player, StatInstance si, ... ) : ( additionalValidates, validateLocation, allowPartialHit ) {
		foreach ( validateFuncs in additionalValidates )
			if ( !validateFuncs( player, si ) )
				return false
		entity weaponEnt = expect entity( vargv[0] )
		if ( !allowPartialHit && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] < fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] )
			return false
		if ( validateLocation == eAmmoHitValidateLocation.IMMEDIATE )
			return true
		if ( validateLocation == eAmmoHitValidateLocation.SHOT_END )
			return fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] >= weaponEnt.GetProjectilesPerShot()
		if ( validateLocation == eAmmoHitValidateLocation.BURST_END )
			return !IsWeaponInSingleShotMode( weaponEnt ) && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] >= GetWeaponBurstCount( weaponEnt )
		return fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] >= GetWeaponMagCount( weaponEnt )//eAmmoHitValidateLocation.MAG_END
	} )
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.AMMO_FIRED][si] <- validateFunction
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.AMMO_HIT][si] <- validateFunction
}

void function WeaponStatsConfig_LandXBullets( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_FIRED][si] <- ConditionUniversalParse( {}, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_ATTACK][si] <- [ void function( entity player ) : ( si ) {
		if ( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED] &&
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] >= GetWeaponBurstCount( fileLevel.weaponStatsStorageSum[player].mainHandActiveWeapon ) )
		{
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT_WRITE_LOCK][si] <- 0
		}
	} ]
	int burstHitTarget = GetSingleConfig( configTable, HIT_X_EACH_BURST_IN_MAG, 0, "0" ).tointeger()
	if ( burstHitTarget > 0 )
	{
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- [ void function( entity player ) : ( si ) {
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT_WRITE_LOCK][si] <- 0
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT][si] <- 0
		} ]
	}
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.FIRE_HIT_VALIDATE_PASSED][si] <- [ void function( entity player ) : ( si ) {
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT][si] <- 0
	} ]
	int validateTarget = validation.len() > 0 ? validation.tointeger() : 0//0 means hit burstHitTarget every burst until mag empty
	bool functionref( entity, StatInstance, ... ) validateFunction = ( bool function( entity player, StatInstance si, ... ) : ( burstHitTarget, validateTarget ) {
		Assert( vargc > 0 )
		entity weapon = expect entity( vargv[0] )
		if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT] ) )
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT][si] <- 0
		int hitTarget = burstHitTarget > 0 ? burstHitTarget : fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si]
		bool countIsLocked = si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT_WRITE_LOCK] && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT_WRITE_LOCK][si] > 0
		if ( !countIsLocked && si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT] && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] >= hitTarget )
		{
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT][si] ++
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT_WRITE_LOCK][si] <- 1
		}
		if ( validateTarget == 0 && GetWeaponBurstCount( weapon ) == 0 )
			return false
		return fileLevel.weaponStatsStorageSum[player].Count[eCountTable.LAND_X_BULLETS_COUNT][si] >= ( validateTarget > 0 ? validateTarget : GetWeaponMagCount( weapon ) / GetWeaponBurstCount( weapon ) )
	} )
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.AMMO_FIRED][si] <- validateFunction
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.AMMO_HIT][si] <- validateFunction
}

void function WeaponStatsConfig_HitAccuracyAtRound( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.FIREANDHIT][si] <- [ eAmmoHitValidateLocation.ROUND_END ]
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_FIRED][si] <- ConditionUniversalParse( {}, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si] <- ConditionUniversalParse( configTable, si )
	int target = validation.tointeger()
	int firedMinimum = GetSingleConfig( configTable, FIRED_MINIMUM, 0, "10" ).tointeger()
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.PLAYER_DISCONNECT_OR_MATCH_END][si] <- ( bool function( entity player, StatInstance si, ... ) : ( target, firedMinimum ) {
		int firedCount = si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED] ? fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] : 0
		int hitCount = si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT] ? fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] : 0
		return firedCount >= firedMinimum && hitCount * 100 / firedCount >= target
	} )
}

void function WeaponStatsConfig_RawDamage( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.RAW_DAMAGE][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.RAW_DAMAGE][si] <- ( bool function( entity player, StatInstance si, ... ) { return true } )
}

void function WeaponStatsConfig_WeaponHoldTimeStatistic( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.HOLD_TIME][si] <- ConditionUniversalParse( {}, si )
}

void function WeaponStatsConfig_FinishOff( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	table<string, array<array<string> > > downConfigTable
	table<string, array<array<string> > > killConfigTable
	foreach ( condition, args in configTable )
	{
		if ( condition.len() >= DOWN_PREFIX.len() && condition.slice( 0, DOWN_PREFIX.len() ) == DOWN_PREFIX )
			downConfigTable[condition.slice( DOWN_PREFIX.len(), condition.len() )] <- args
		else
			killConfigTable[condition] <- args
	}
	if ( "AttackerSameAsKiller" in killConfigTable )
	{
		fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.TIME, true]
		fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( downConfigTable, si )
		//if victim get revived, clear storage
		fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) { WeaponStatsStorageClear_VictimsProperty( player, victim, si ) } ]
	}
	WeaponStatsConfig_UniversalCount( eCountTable.FINISH_OFF, si, killConfigTable, validation )
}

void function WeaponStatsConfig_KillCountWithCategoryAndDownCondition( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( configTable, si )
	//if victim get revived, clear storage
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) { WeaponStatsStorageClear_VictimsProperty( player, victim, si ) } ]
	int target = validation.tointeger()
	if ( LOADOUT in configTable )
	{
		fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si].append( bool function( entity player, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( target ) {
			entity weaponInSlot0 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
			entity weaponInSlot1 = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
			if ( weaponInSlot0 == null || weaponInSlot1 == null || weaponInSlot0.GetWeaponClassName() != weaponInSlot1.GetWeaponClassName() )
				return false
			array<entity> currentWeapons = []
			if ( si in fileLevel.weaponStatsStorageSum[player].VictimsProperty )
				foreach ( k,v in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] )
				{
					entity thisWeapon = expect entity( v )
					if ( !currentWeapons.contains( thisWeapon ) )
						currentWeapons.append( thisWeapon )
				}
			return currentWeapons.len() < target || currentWeapons.contains( weaponEnt )
		} )
		fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.LOADOUT, false]
		fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DOWN_VICTIMS_PROPERTY][si] <- bool function ( entity player, StatInstance si, ... ) : ( target ) { return ValidateDownVictimDifferentProperty( player, si, eVictimProperty.LOADOUT, target ) }
	}
	else if ( CAR_WEAPON_MOD in configTable )
	{
		fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.CAR_WEAPON_MOD, false]
		fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DOWN_VICTIMS_PROPERTY][si] <- bool function ( entity player, StatInstance si, ... ) : ( target ) { return ValidateDownVictimDifferentProperty( player, si, eVictimProperty.CAR_WEAPON_MOD, target ) }
	}
}

void function WeaponStatsConfig_DownWithoutEvent( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) { } ]
	int target = validation.tointeger()
	string eventKey = GetSingleConfig( configTable, WITHOUT_EVENT, 0 )
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.TIME, false]
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DOWN_VICTIMS_PROPERTY][si] <- bool function ( entity player, StatInstance si, ... ) : ( target, eventKey ) {
		if ( !( si in fileLevel.weaponStatsStorageSum[player].VictimsProperty ) )
			return false
		float eventTime = GetTargetEventTime( player, eventKey )
		int count = 0
		foreach ( victim, time in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] )
		{
			if ( eventTime < 0 || GetTargetInteractEventTime( player, victim, DAMAGE_START ) >= eventTime )
				count++
		}
		bool result = count >= target
		if ( result )
			fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] <- {}
		return result
	}
}

void function WeaponStatsConfig_WipeSquad( StatInstance si, table<string, array<array<string> > > configTable )
{
	table<string, array<array<string> > > filteredConfigTable
	array<void functionref(entity, entity)> clearActions
	//if victim get revived or respawned, clear count from WipeSquadPlayers
	clearActions.append( void function( entity player, entity victim ) : ( si ) {
		if ( si in fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers && fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].contains( victim ) )
			fileLevel.weaponStatsStorageSum[player].WipeSquadPlayers[si].fastremovebyvalue( victim )
	} )
	foreach ( condition, args in configTable )
	{
		if ( condition == "Reload" )
		{
			fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.RELOAD][si] <- ConditionUniversalParse( {}, si )
			int maxReloadTimes = GetSingleConfig( configTable, "Reload", 0, "1" ).tointeger()
			fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.WIPE_SQUAD][si] <- ( bool function( entity player, StatInstance si, ... ) : ( maxReloadTimes ) {
				Assert( vargc == 1 )
				int victimTeam = expect int( vargv[0] )
				return WeaponStatsCondition_ReloadTimesBySquadNotExceed( player, si, victimTeam, maxReloadTimes )
			} )
		}
		else
			filteredConfigTable[condition] <- args
	}
	if ( !( si in fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.WIPE_SQUAD] ) )
		fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.WIPE_SQUAD][si] <- ( bool function( entity player, StatInstance si, ... ) { return true } )
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- clearActions
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.WIPE_SQUAD_PLAYERS][si] <- ConditionUniversalParse( filteredConfigTable, si )
}

void function WeaponStatsConfig_BreakShieldInSquad( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.BREAK_SHIELD_IN_SQUAD][si] <- ConditionUniversalParse( configTable, si )
	int target = validation.tointeger()
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.BREAK_SHIELD_IN_SQUAD][si] <- ( bool function( entity player, StatInstance si, ... ) : ( target ) {
		Assert( vargc == 1 )
		int victimTeam = expect int( vargv[0] )
		return fileLevel.weaponStatsStorageSum[player].BreakShieldInSquad[si][victimTeam].len() >= target
	} )
}

void function WeaponStatsConfig_DownCountAfterDamage( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	table<string, array<array<string> > > downConfigTable
	table<string, array<array<string> > > damageConfigTable
	string invalidTime    = GetSingleConfig( configTable, INVALID_TIME, 0, DOWN_COUNT_AFTER_DAMAGE_INVALID_TIME )
	string requiredDamage = GetSingleConfig( configTable, REQUIRED_DAMAGE, 0, DOWN_COUNT_AFTER_DAMAGE_REQUIRED_DAMAGE )
	array<string> damageInPeriodArgs = [ invalidTime, requiredDamage ]
	int forceDamageCheck = 0
	int checkResetTime   = -1
	foreach ( condition, args in configTable )
	{
		switch( condition )
		{
			case USE_BOTH_WEAPONS:
				array<void functionref(entity)> clearActions = [
					void function( entity player ) : ( si )
					{
						if ( !(player in fileLevel.weaponStatsStorageSum) )
							return
						if ( !(si in fileLevel.weaponStatsStorageSum[player].DamageInPeriod) )
							return

						entity weaponInSlot0              = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_0 )
						ItemFlavor ornull weaponItemSlot0 = IsValid( weaponInSlot0 ) ? GetWeaponItemFlavorByClass( weaponInSlot0.GetWeaponClassName() ) : null
						entity weaponInSlot1              = player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_1 )
						ItemFlavor ornull weaponItemSlot1 = IsValid( weaponInSlot1 ) ? GetWeaponItemFlavorByClass( weaponInSlot1.GetWeaponClassName() ) : null
						ItemFlavor targetWeapon           = GetItemFlavorByGUID( si.targetTag )
						bool needClear                    = weaponItemSlot0 != targetWeapon || weaponItemSlot1 != targetWeapon
						if ( !needClear )
							return
						foreach ( victim, damageInPeriodInfoRingBuffer in fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si] )
						{
							ClearDamageInPeriodInfo( damageInPeriodInfoRingBuffer )
						}
					} ]
				fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions
				damageInPeriodArgs.append( "use_both_weapons" )
				break

			case FORCE_DAMAGE_CHECK:
				// means if we make a unexpect damage(e.g. every shot should be headshot, but land a body shot), reset time will be a cool down to recalculate expect damages
				forceDamageCheck = 1
				checkResetTime = GetSingleConfig( configTable, condition, 0, "-1" ).tointeger()
				fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) {
					if( !(si in fileLevel.weaponStatsStorageSum[player].DamageInPeriod) )
						return
					if( !(victim in fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si]) )
						return
					fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si][victim].isValid = true
				} ]
				break

			case RESET_AFTER_SWITCH:
				array<void functionref(entity)> clearActions = [ void function( entity player ) : ( si ) { fileLevel.weaponStatsStorageSum[player].DamageInPeriod[si] <- {} } ]
				fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.SWITCH_DIFFERENT_WEAPON][si] <- clearActions
				break

			default:
				if ( condition.len() >= DAMAGE_PREFIX.len() && condition.slice( 0, DAMAGE_PREFIX.len() ) == DAMAGE_PREFIX )
					damageConfigTable[condition.slice( DAMAGE_PREFIX.len(), condition.len() )] <- args
				else
					downConfigTable[condition] <- args
				break
		}
	}
	ConfigTableAddConditionParams( downConfigTable, "DamageInPeriod", damageInPeriodArgs )
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.DAMAGE_IN_PERIOD][si] <- [ invalidTime.tointeger(), forceDamageCheck, checkResetTime ]
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( downConfigTable, si )
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_IN_PERIOD][si] <- ConditionUniversalParse( damageConfigTable, si )
	fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

void function WeaponStatsConfig_DownCountAfterReload( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.RELOAD][si] <- ConditionUniversalParse( {}, si )
	ConfigTableAddConditionParams( configTable, "StatisticTimeWithin", [ "true", string( eStatisticTable.RELOAD ), GetSingleConfig( configTable, INVALID_TIME, 0, DOWN_COUNT_AFTER_RELOAD_INVALID_TIME ), "true" ] )
	WeaponStatsConfig_UniversalCount( eCountTable.DOWN, si, configTable, validation )
}

void function WeaponStatsConfig_DownCountAfterBreakShield( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	float invalidTime = GetSingleConfig( configTable, INVALID_TIME, 0, DOWN_COUNT_AFTER_BREAKSHIELD_INVALID_TIME ).tofloat()
	table<string, array<array<string> > > downConfigTable
	table<string, array<array<string> > > breakShieldConfigTable
	foreach ( condition, args in configTable )
	{
		if ( condition.len() >= DOWN_PREFIX.len() && condition.slice( 0, DOWN_PREFIX.len() ) == DOWN_PREFIX )
			downConfigTable[condition.slice( DOWN_PREFIX.len(), condition.len() )] <- args
		else
			breakShieldConfigTable[condition] <- args
	}
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.BREAK_SHIELD_TIME][si] <- ConditionUniversalParse( breakShieldConfigTable, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( downConfigTable, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si].append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( invalidTime ) {
		return WeaponStatsCondition_BreakShieldTimeWithin( attacker, si, invalidTime, expect entity( victim ), true )
	} )
	fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

void function WeaponStatsConfig_DownCountWithoutReloadAndTriggerRelease( StatInstance si, table<string, array<array<string> > > configTable, string validation, bool clearOnTriggerRelease = false )
{
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( configTable, si )
	string breakDoorWithGun = GetSingleConfig( configTable, BREAK_DOOR_WITH_GUN, 0, "" )
	string actualBreakDoorEvent = breakDoorWithGun.len() > 0 ? format( "%s%s", BREAK_DOOR_WITH_GUN_PREFIX, breakDoorWithGun ) : ""
	array<void functionref(entity)> clearActions = [ void function( entity player ) : ( si, actualBreakDoorEvent ) {
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] <- 0
		if ( actualBreakDoorEvent.len() > 0 )
			WeaponStats_ClearIndependentEventTime( player, actualBreakDoorEvent )
	} ]
	if ( actualBreakDoorEvent.len() > 0 )
	{
		int invalidTime = GetSingleConfig( configTable, BREAK_DOOR_WITH_GUN, 1, DOWN_COUNT_AFTER_BREAK_DOOR_WITH_GUN_INVALID_TIME ).tointeger()
		fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si].append( bool function( entity attacker, StatInstance si, entity weaponEnt, entity ornull victim, var damageInfo ) : ( invalidTime, actualBreakDoorEvent ) {
			return WeaponStatsCondition_TargetEvent( attacker, actualBreakDoorEvent, invalidTime )
		} )
	}
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions
	if ( clearOnTriggerRelease )
	{
		fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.TRIGGER_RELEASE][si] <- clearActions
		int targetCount = validation.tointeger()
		fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.TRIGGER_RELEASE][si] <- ( bool function( entity player, StatInstance si, ... ) : ( targetCount ) {
			return si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN] && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] >= targetCount
		} )
	}
	else
		fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

//Downcount is with damage requirement
void function WeaponStatsConfig_DownCountWithoutTriggerRelease( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGED_PLAYERS][si] <- ConditionUniversalParse( configTable, si )

	array<void functionref(entity)> clearActions = [ void function( entity player ) : ( si ) {
		fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] <- 0
	} ]

	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.TRIGGER_RELEASE][si] <- clearActions

	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si].append( bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) {
		entity victimEnt = expect entity(victim)
		#if WEAPON_STATS_DEBUG
			if( victimEnt != null && si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers && victimEnt in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] )
				printt( "WeaponStats:DownCountWithoutTriggerRelease:", player.GetPlayerName(), fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt], victimEnt.GetShieldHealthMax(), victimEnt.GetMaxHealth() )
		#endif
		return ( victimEnt != null && si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers && victimEnt in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si]
		&& fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt] >= ( victimEnt.GetShieldHealthMax() + victimEnt.GetMaxHealth() ) / 2 )
	} )
	int targetCount = validation.tointeger()
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.TRIGGER_RELEASE][si] <- ( bool function( entity player, StatInstance si, ... ) : ( targetCount ) {
		return si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN] && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] >= targetCount
	} )
}

void function WeaponStatsConfig_DownCountWithFirstHitCondition( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	table<string, array<array<string> > > downConfigTable
	table<string, array<array<string> > > firstHitConfigTable
	foreach ( condition, args in configTable )
	{
		if ( condition.len() >= DOWN_PREFIX.len() && condition.slice( 0, DOWN_PREFIX.len() ) == DOWN_PREFIX )
			downConfigTable[condition.slice( DOWN_PREFIX.len(), condition.len() )] <- args
		else
			firstHitConfigTable[condition] <- args
	}

	array<bool functionref( entity, StatInstance, entity, entity ornull, var )> conditions = ConditionUniversalParse( firstHitConfigTable, si )
	float invalidTime = GetSingleConfig( firstHitConfigTable, INVALID_TIME, 0, DOWN_COUNT_WITH_FIRST_HIT_INVALID_TIME ).tofloat()
	conditions.append( bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) : ( invalidTime ) {
		entity victimEnt = expect entity( victim )
		if ( si in fileLevel.weaponStatsStorageSum[player].DamageStartTime && victimEnt in fileLevel.weaponStatsStorageSum[player].DamageStartTime[si] && Time() - fileLevel.weaponStatsStorageSum[player].DamageStartTime[si][victimEnt] < invalidTime )
		{
			if ( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers )
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt] <- 0
			return false
		}
		return true
	}  )
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGED_PLAYERS][si] <- conditions

	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.DAMAGE_START_TIME][si] <- []
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <-  [ void function( entity player ) : ( si ) {
		fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] <- 0
	} ]

	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si] <- ConditionUniversalParse( downConfigTable, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.DOWN][si].insert( 0, bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) : ( invalidTime ) {
		entity victimEnt = expect entity(victim)
		if ( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers && victimEnt in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] )
		{
			bool result = fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt] > 0
			fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt] <- 0
			return result
		}
		return false
	} )
	fileLevel.weaponStatsConfigs.validateCondition_Count[si] <- validation.tointeger()
}

void function WeaponStatsConfig_DownCountWithoutWeaponOverheat( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	WeaponStatsConfig_UniversalCount( eCountTable.DOWN, si, configTable, validation )
	array< void functionref( entity ) > clearActions = [ void function( entity player ) : ( si ) {
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.DOWN][si] <- 0
	} ]
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_OVERHEAT][si] <- clearActions
}

void function WeaponStatsConfig_ContinuousHitCount( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	bool allowDifferentVictim = ( ALLOW_DIFFERENT_VICTIM in configTable )

	void functionref(entity) clearAction = void function( entity player ) : ( si, allowDifferentVictim )
	{
		if ( !allowDifferentVictim )
			fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 0
		fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
	}
	array<void functionref(entity)> clearActions = [ clearAction ]

	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_RELOAD][si] <- clearActions
	fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- clearActions

	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si] <- ConditionUniversalParse( configTable, si )
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_FIRED][si] <- ConditionUniversalParse( {}, si )

	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.AMMO_HIT][si].insert( 0, bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) : ( allowDifferentVictim, clearAction ) {
		if ( !( si in fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT] ) || fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] + 1 != fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] )
		{
			clearAction(player)
			fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 1
		}

		if ( !allowDifferentVictim )
		{
			entity victimEnt = expect entity(victim)
			bool onlyVictim = ( si in fileLevel.weaponStatsStorageSum[player].DamagedPlayers && victimEnt in fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] && fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si].len() == 1 )
			if ( !onlyVictim )
			{
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si] <- {}
				fileLevel.weaponStatsStorageSum[player].DamagedPlayers[si][victimEnt] <- 1
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] <- 1
				fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] <- 0
			}
		}
		return true
	} )

	int target = validation.tointeger()
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.AMMO_HIT][si] <- ( bool function( entity player, StatInstance si, ... ) : ( clearAction, target ) {
		if( fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] == target && fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_HIT][si] == fileLevel.weaponStatsStorageSum[player].Count[eCountTable.AMMO_FIRED][si] )
		{
			clearAction( player )
			return true
		}
		return false
	} )
}

void function WeaponStatsConfig_DoubleKill( StatInstance si, table<string, array<array<string> > > configTable )
{
	table<string, array<array<string> > > downConfigTable
	bool functionref(entity, StatInstance) additionalValidates
	float invalidTime = GetSingleConfig( configTable, INVALID_TIME, 0, DOUBLE_KILL_INVALID_TIME ).tofloat()        //interrupt after this seconds
	foreach ( condition, args in configTable )
	{
		switch ( condition )
		{
			case "Reload":
			case "ReloadTactical":
				int reloadTimes = GetSingleConfig( configTable, condition, 0, "1" ).tointeger()
				bool isExact = GetSingleConfig( configTable, condition, 1 ) == "true" ? true : false
				table<string, array<array<string> > > reloadConfigTable
				ConfigTableAddConditionParams( reloadConfigTable, "StatisticExist", [ "true", string( eStatisticTable.DOUBLE_KILL ) ] )
				if ( condition == "ReloadTactical" )
					ConfigTableAddConditionParams( reloadConfigTable, "IsMagEmpty", [ "false" ] )
				fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.RELOAD][si] <- ConditionUniversalParse( reloadConfigTable, si, CONDITION_PARAMS_WEAPON )
				additionalValidates = bool function( entity player, StatInstance si ) : ( reloadTimes, isExact ) { return WeaponStatsCondition_ReloadTimesWithin( player, si, reloadTimes, isExact, true ) }
				fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_SWITCHED][si] <- [ void function( entity player ) : ( si ) {
					fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.DOUBLE_KILL][si] <- 0
					fileLevel.weaponStatsStorageSum[player].Count[eCountTable.RELOAD][si] <- 0
				} ]
				break

			case "KeepFullyHeated":
				// Add double kill write condition
				ConfigTableAddConditionParams( downConfigTable, "IsFullyHeated", [ "true" ] )
				// Add fully heated flag
				table<string, array<array<string> > > keepHeatConfigTable
				ConfigTableAddConditionParams( keepHeatConfigTable, "StatisticExist", [ "true", string( eStatisticTable.DOUBLE_KILL ) ] )
				fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.KEEP_FULLY_HEATED][si] <- ConditionUniversalParse( keepHeatConfigTable, si, CONDITION_PARAMS_WEAPON )
				// Clear fully heated flag when leave heat condition
				fileLevel.weaponStatsConfigs.clearActionConfigs[eClearConfig.WEAPON_HEAT_DECREASE][si] <- [ void function( entity player ) : ( si ) {
					fileLevel.weaponStatsStorageSum[player].Statistic[eStatisticTable.DOUBLE_KILL][si] <- 0
					fileLevel.weaponStatsStorageSum[player].Count[eCountTable.KEEP_FULLY_HEATED][si] <- 0
				} ]
				break

			default:
				downConfigTable[condition] <- args
				break
		}
	}
	fileLevel.weaponStatsConfigs.writeCondition_Statistic[eStatisticTable.DOUBLE_KILL][si] <- ConditionUniversalParse( downConfigTable, si )
	fileLevel.weaponStatsConfigs.validateConditions[eValidateLocation.DOUBLE_KILL][si] <- ( bool function( entity player, StatInstance si, ... ) : (invalidTime, additionalValidates) {
		if ( additionalValidates != null && !additionalValidates( player, si ) )
			return false
		return WeaponStatsCondition_StatisticTimeWithin( eStatisticTable.DOUBLE_KILL, player, si, invalidTime, true )
	} )
}

void function WeaponStatsConfig_BreakIncapShieldAfterDown( StatInstance si, table<string, array<array<string> > > configTable, string validation )
{
	table<string, array<array<string> > > downConfigTable
	table<string, array<array<string> > > breakConfigTable
	foreach ( condition, args in configTable )
	{
		if ( condition.len() >= DOWN_PREFIX.len() && condition.slice( 0, DOWN_PREFIX.len() ) == DOWN_PREFIX )
			downConfigTable[condition.slice( DOWN_PREFIX.len(), condition.len() )] <- args
		else
			breakConfigTable[condition] <- args
	}
	fileLevel.weaponStatsConfigs.additionalParams[eAdditionalParamsType.VICTIMS_PROPERTY][si] <- [eVictimProperty.TIME, true]
	fileLevel.weaponStatsConfigs.writeConditions[eWriteCondition.VICTIMS_PROPERTY][si] <- ConditionUniversalParse( downConfigTable, si )
	//if victim get revived, clear storage
	fileLevel.weaponStatsConfigs.clearActionConfig_ReviveAndRespawn[si] <- [ void function( entity player, entity victim ) : ( si ) { WeaponStatsStorageClear_VictimsProperty( player, victim, si ) } ]

	WeaponStatsConfig_UniversalCount( eCountTable.BREAK_INCAP_SHIELD, si, breakConfigTable, validation )
	float invalidTime = GetSingleConfig( configTable, INVALID_TIME, 0, "-1" ).tofloat()
	fileLevel.weaponStatsConfigs.writeCondition_Count[eCountTable.BREAK_INCAP_SHIELD][si].insert ( 0,
		bool function( entity player, StatInstance si, entity weapon, entity ornull victim, var damageInfo ) : ( invalidTime ) {
			entity victimEnt = expect entity( victim )
			bool result = si in fileLevel.weaponStatsStorageSum[player].VictimsProperty && victimEnt in fileLevel.weaponStatsStorageSum[player].VictimsProperty[si] &&
			( invalidTime < 0 || Time() - expect float( fileLevel.weaponStatsStorageSum[player].VictimsProperty[si][victimEnt] ) <= invalidTime )
			if ( result )
				WeaponStatsStorageClear_VictimsProperty( player, victimEnt, si )
			return result
		} )
}

////////////////////////////
////////////////////////////
////        Hook       ////
////////////////////////////
////////////////////////////
//For all hooks, unless it's not related to fileLevel.weaponStatsStorageSum, should check null or call InitPlayerStorage( player )
void function WeaponStatsHook_OnDownEnemy( entity victim, entity attacker, var attackerDamageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !( attacker in fileLevel.weaponStatsStorageSum ) || !IsValid( victim ) || !victim.IsPlayer() )
		return
	entity weaponEnt = DamageInfo_GetWeapon( attackerDamageInfo )
	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnDownEnemy:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName() )
	#endif

	WeaponStats_RecordInteractEventTime( victim, attacker, BE_DOWNED )
	WeaponStats_RecordIndependentEventTime( victim, BE_DOWNED )

	//storage
	WeaponStatsStorageWrite_OnUniversalCount( eCountTable.DOWN, attacker, weaponEnt, attackerDamageInfo, victim )
	WeaponStatsStorageWrite_OnContinuousDownCount( attacker, weaponEnt, victim, attackerDamageInfo )
	WeaponStatsStorageWrite_OnWipeSquad( attacker, weaponEnt, victim, attackerDamageInfo )
	WeaponStatsStorageWrite_OnDownVictimsProperty( attacker, weaponEnt, victim, attackerDamageInfo )

	//validate
	WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.DOWN, attacker )
	WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.CONTINUOUS_DOWN, attacker, null, CleanupContinuousDownCount )
	WeaponStatsStorageValidateAndWrite_OnDoubleKill( attacker, weaponEnt, victim, attackerDamageInfo )
	WeaponStatsValidateStorageCondition_OnFireAndHit( attacker, weaponEnt )

	WeaponStats_RecordInteractEventTime( attacker, victim, DOWN_OTHER )
	WeaponStats_RecordIndependentEventTime( attacker, DOWN_OTHER )
}

void function WeaponStatsHook_OnKillEnemy( entity victim, entity attacker, entity killer, var attackerDamageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( victim ) || !victim.IsPlayer() )
		return
	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnKillEnemy:(victim)", victim.GetPlayerName() )
	#endif
	WeaponStatsStorageWrite_FinishRecordWeaponHoldTime( victim )

	//for trials related to attacker who finish off the victim
	if ( IsValid( attacker ) && attacker.IsPlayer() && attacker in fileLevel.weaponStatsStorageSum )
	{
		entity weaponEnt = DamageInfo_GetWeapon( attackerDamageInfo )
		if ( IsValid( weaponEnt ) && weaponEnt.IsWeaponX() && weaponEnt == fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		{
			#if WEAPON_STATS_DEBUG
				printt( "WeaponStats:Hook_OnKillEnemy:(attacker)", attacker.GetPlayerName() )
			#endif
			//storage
			WeaponStatsStorageWrite_OnUniversalCount( eCountTable.FINISH_OFF, attacker, weaponEnt, attackerDamageInfo, victim )
			//validate
			WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.FINISH_OFF, attacker )
		}
	}

	if ( IsValid( killer ) && killer.IsPlayer() && killer in fileLevel.weaponStatsStorageSum )
	{
		#if WEAPON_STATS_DEBUG
			printt( "WeaponStats:Hook_OnKillEnemy:(killer)", killer.GetPlayerName() )
		#endif
		//storage
		WeaponStats_OnEventNeedHandleTargetInPeriod( killer, victim )
		WeaponStats_RecordInteractEventTime( victim, killer, BE_KILLED )
		WeaponStatsStorageWrite_OnUniversalCount( eCountTable.KILL_WITH_DOWN_CONDITION, killer, null, null, victim )
		WeaponStatsStorageWrite_OnUniversalCount( eCountTable.REVIVE_PAIR_KILL, killer, null, null, victim )

		//validate
		WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.KILL_WITH_DOWN_CONDITION, killer )
		WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.REVIVE_PAIR_KILL, killer )
		WeaponStatsValidateStorageCondition_KillCountXP( killer, victim )
		WeaponStatsValidateStorageCondition_OnWipeSquad( killer, victim )
		WeaponStatsValidateStorageCondition_OnDownVictimsProperty( killer, victim )//this function also clean up ReviveAndRespawn for any behavior with eWriteCondition.VICTIMS_PROPERTY, is should remain the last function in this hook
	}
}

void function WeaponStatsHook_OnKillNpc( entity victim, entity attacker, var attackerDamageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !( attacker in fileLevel.weaponStatsStorageSum ) )
		return
	entity weaponEnt = DamageInfo_GetWeapon( attackerDamageInfo )
	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnKillNpc:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName() )
	#endif

	//storage
	WeaponStatsStorageWrite_OnUniversalCount( eCountTable.NPC_KILL, attacker, weaponEnt, attackerDamageInfo, victim )

	//validate
	WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.NPC_KILL, attacker )
}

void function WeaponStatsHook_OnPlayerShieldBreak( entity player, var damageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !( attacker in fileLevel.weaponStatsStorageSum ) )
		return
	entity weaponEnt = DamageInfo_GetWeapon( damageInfo )
	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnPlayerShieldBreak:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName() )
	#endif

	//storage
	WeaponStats_RecordIndependentEventTime( player, SHIELD_BROKE )
	WeaponStats_RecordInteractEventTime( attacker, player, BREAK_SHIELD )
	WeaponStatsStorageWrite_OnUniversalCount( eCountTable.BREAK_SHIELD, attacker, weaponEnt, damageInfo, player )
	WeaponStatsStorageWrite_BreakShieldTime( attacker, weaponEnt, player, damageInfo )
	WeaponStatsWriteAndValidate_BreakShieldInSquad( attacker, weaponEnt, player, damageInfo )

	//validate
	WeaponStatsValidateStorageCondition_UniversalCount( eCountTable.BREAK_SHIELD, attacker )
}

void function WeaponStatsHook_OnPlayerIncapShieldBreak( entity player, var damageInfo )
{
	if ( IsWeaponStatsDeactivated() )
		return
	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( !IsValid( attacker ) || !attacker.IsPlayer() || !( attacker in fileLevel.weaponStatsStorageSum ) )
		return

	entity weaponEnt = DamageInfo_GetWeapon( damageInfo )
	if ( !IsValid( weaponEnt ) || !weaponEnt.IsWeaponX() || weaponEnt != fileLevel.weaponStatsStorageSum[attacker].mainHandActiveWeapon )
		return

	#if WEAPON_STATS_DEBUG
		printt( "WeaponStats:Hook_OnPlayerIncapShieldBreak:", attacker.GetPlayerName(), weaponEnt.GetWeaponClassName() )
	#endif

	//storage
