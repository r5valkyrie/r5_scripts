	if ( !( si in fileLevel.weaponStatsStorageSum[player].IncreasedTimes ) )
		fileLevel.weaponStatsStorageSum[player].IncreasedTimes[si] <- value
	else
		fileLevel.weaponStatsStorageSum[player].IncreasedTimes[si] += value
