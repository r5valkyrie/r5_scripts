void function ObjectiveSystem_Init()
{
	if( isInitialized )
	{
		#if DEV
			printf( "Objective System is already initialized" )
		#endif
		return
	}
	isInitialized = true

	bool isFinale = GetCurrentPlaylistVarBool( "freelance_mode_s05ending", false )
	if ( !isFinale )
	InitObjectiveTypes()

	PrecacheParticleSystem( OBJECTIVE_BEACON_EFFECT_HANDLE )

#if SERVER

	AddCallback_GameStateEnter( eGameState.Playing, OnGameStateEnterPlaying )

	svGlobal.onTooManyNPCsCallbacks.append( OnTooManyNPCs )

	thread UpdatePlayerPopulationsInObjectives_Thread()
#endif // #if SERVER

