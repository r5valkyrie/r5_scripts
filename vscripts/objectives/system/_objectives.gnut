bool function PlayerIsInsideOfObjectiveInstance( entity player, ObjectiveInstance oi )
{
	ObjectiveDef def = s_defMap[oi.objectiveType]
	if ( def.func_playerIsInsideOfObjective != null)
		return def.func_playerIsInsideOfObjective( player, oi )

	// DEFAULT: consider inside if in any of the objectives' current zones
	{
		foreach( int zoneId in oi.currentZones )
		{
			if ( zoneId == player.p.currentZoneId )
				return true
		}
		return false
	}
}

void function UpdatePlayerPopulationsInObjectives_Thread()
{
	WaitQuotaItem wq = WaitFrameQuota_Init( 8 )

	wait 1.0
	for ( ;; )
	{
		array<ObjectiveInstance> instances = clone( s_instances )
		table<entity, array<ObjectiveInstance> > mapPlayersToOIs
		table<ObjectiveInstance, array<entity> > mapOIsToPlayers

		array<entity> players = GetPlayerArray()
		foreach ( player in players )
		{
			if ( !IsValid( player ) )
				continue

			mapPlayersToOIs[player] <- []

			foreach( ObjectiveInstance oi in instances )
			{
				if ( (oi.objectiveState == eObjectiveState.COMPLETED) && ((Time() - oi.objectiveStateCompletedTime) > 8.0) )
					continue

				if ( PlayerIsInsideOfObjectiveInstance( player, oi ) )
				{
					mapPlayersToOIs[player].append( oi )

					if ( !(oi in mapOIsToPlayers) )
						mapOIsToPlayers[oi] <- []
					mapOIsToPlayers[oi].append( player )
				}

				WaitFrameQuota( wq )
				if ( !IsValid( player ) )
					break
			}
		}

		foreach( player, arr in mapPlayersToOIs )
		{
			if ( !IsValid( player ) )
				continue

			int newVal = -1
			if ( arr.len() == 1 )
				newVal = arr[0].objectiveIndex
			else if ( arr.len() > 1 )
				Warning( "%s() - Player '%s' is in more than one objective. RUI & script need to be updated to support this.", FUNC_NAME(), string( player ) )
			player.SetPlayerNetInt( NVAR_InsideObjectiveFields, newVal )
		}

		foreach( oi, arr in mapOIsToPlayers )
		{
			oi.latestPlayers.clear()
			oi.latestPlayers.extend( arr )

			if ( (oi.objectiveState == eObjectiveState.UNDISCOVERED) && (arr.len() > 0) )
			{
				int teamToCredit = IsValid( arr[0] ) ? arr[0].GetTeam() : -1
				MarkObjectiveAsRevealed( oi, teamToCredit )
			}
		}

		//
		WaitFrameQuota_Reset( wq )
		WaitFrame()
	}
}

void function MarkObjectiveAsRevealed( ObjectiveInstance oi, int teamToCredit )
{
	SetObjectiveState( oi, eObjectiveState.REVEALED )

	SetObjectiveIcon( oi, s_defMap[oi.objectiveType].icon )

	// Big announce to nearby players:
	array<entity> inOrNear = Objectives_GetPlayersInOrNearObjective( oi )
	foreach( player in inOrNear )
		Remote_CallFunction_Replay( player, FUNCNAME_ObjectiveAnnounceDiscoveryYouDiscovered, oi.objectiveIndex )

	// Small announce to all players:
	foreach( player in GetPlayerArray() )
		Remote_CallFunction_Replay( player, FUNCNAME_ObjectiveAnnounceDiscoveryToAll, teamToCredit )
}

int function Objectives_GetCountTotal()
{
	return s_instances.len()
}

int function Objectives_GetCountComplete()
{
	int result
	foreach( oi in s_instances )
	{
		if ( oi.objectiveState >= eObjectiveState.COMPLETED )
			++result
	}
	return result
}

bool function AllObjectivesAreComplete()
{
	int countTotal = Objectives_GetCountTotal()
	int countDone = Objectives_GetCountComplete()
	return ((countDone > 0) && (countDone == countTotal))
}

void function Objectives_MarkObjectiveAsComplete( ObjectiveInstance oi )
{
	Assert( oi.objectiveState != eObjectiveState.COMPLETED )

	// Big announce to nearby players:
//	array<entity> inOrNear = Objectives_GetPlayersInOrNearObjective( oi )
//	foreach( player in inOrNear )
//		Remote_CallFunction_Replay( player, FUNCNAME_ObjectiveAnnounceFinishedToNearby )
//
//	// Small announce to all players:
//	foreach( player in GetPlayerArray() )
//		Remote_CallFunction_Replay( player, FUNCNAME_ObjectiveAnnounceFinishedToAll, oi.objectiveIndex )

	SetObjectiveIcon( oi, $"rui/hud/objectives/completed" )

	SetObjectiveState( oi, eObjectiveState.COMPLETED )
	oi.objectiveStateCompletedTime = Time()

	if ( IsPVEMode() && (FreelanceMode_GetCurrentPhase() < eFreelanceModePhase.GetToTheLZ) )
		ClientMusic_PlayCustomTrackToObjective( eMusicTrack.ObjectiveComplete, oi )

	if ( IsValid( oi.beaconEffectHandle ) )
	{
		EffectStop( oi.beaconEffectHandle );
		oi.beaconEffectHandle.Destroy()
	}

	// All completed announce:
	//if ( AllObjectivesAreComplete() )
	//	delaythread( 6.0 ) DoFreelanceModeSplashToAll( eModeSplash.AllObjectivesCleared )
}

bool function PlayerIsMarkedAsInsideObjective( entity player, ObjectiveInstance oi )
{
	return PlayerIsMarkedAsInsideObjectiveIndex( player, oi.objectiveIndex )
}

array<entity> function Objectives_GetPlayersInObjective( ObjectiveInstance oi )
{
	array<entity> results
	foreach( player in GetPlayerArray_AliveConnected() )
	{
		if ( PlayerIsMarkedAsInsideObjective( player, oi ) )
			results.append( player )
	}
	return results
}

array<entity> function Objectives_GetPlayersInOrNearObjective( ObjectiveInstance oi )
{
	array<entity> insiders
	array<entity> outsiders
	foreach( player in GetPlayerArray_AliveConnected() )
	{
		if ( PlayerIsMarkedAsInsideObjective( player, oi ) )
			insiders.append( player )
		else
			outsiders.append( player )
	}
	array<entity> results = clone insiders

	// In the zones or neighbor zones?
	{
		array<int> neighborZones = MapZones_GetNeighborZonesForZones( oi.currentZones )
		array<entity> outsidersCopy = clone outsiders
		foreach( outsider in outsidersCopy )
		{
			if ( oi.currentZones.contains( outsider.p.currentZoneId ) || neighborZones.contains( outsider.p.currentZoneId ) )
			{
				results.append( outsider )
				outsiders.removebyvalue( outsider )
				continue
			}
		}
	}

	// Close to someone already marked?
	{
		const float CLOSE_TO_INSIDER_THRESHOLD = 3000.0

		array<entity> outsidersCopy = clone outsiders
		foreach( outsider in outsidersCopy )
		{
			vector pos = outsider.GetOrigin()
			foreach( insider in insiders )
			{
				float dist = Distance( pos, insider.GetOrigin() )
				if ( dist < CLOSE_TO_INSIDER_THRESHOLD )
				{
					results.append( outsider )
					outsiders.removebyvalue( outsider )
					break
				}
			}
		}
	}

	return results
}

table<int, array<entity> > function Objectives_GetTeamsInOrNearObjective( ObjectiveInstance oi )
{
	table<int, array<entity> > teamPlayersMap

	array<entity> playersInOrNear = Objectives_GetPlayersInOrNearObjective( oi )
	foreach( entity player in playersInOrNear )
	{
		int team = player.GetTeam()
		if ( !(team in teamPlayersMap) )
			teamPlayersMap[team] <- []
		teamPlayersMap[team].append( player )
	}

	return teamPlayersMap
}

void function OnTooManyNPCs()
{
	printf( "%s() - In callback.", FUNC_NAME() )
}

