#if SERVER
void function PlayRadioDialogueToObjective( string alias, ObjectiveInstance oi )
{
	array<entity> inOrNear = Objectives_GetPlayersInOrNearObjective( oi )
	PlayRadioDialogueToPlayers( alias, inOrNear, eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
}

void function PlayRadioDialogueToObjectiveAndWait( string alias, ObjectiveInstance oi, array<entity> ornull players = null )
{
	//HACK: need a cleaner way to waitthread on playing dialogue, both radio and otherwise
	array<entity> playersNearObjective
	if ( players == null )
		playersNearObjective = Objectives_GetPlayersInOrNearObjective( oi )
	else
		playersNearObjective = expect array<entity> ( players )

	for ( int i = playersNearObjective.len() - 1; i >= 0; i-- )
	{
		if ( i == 0 )
			waitthread PlayDialogueForPlayer( alias, playersNearObjective[i], playersNearObjective[i], 0, eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
		else
			thread PlayDialogueForPlayer( alias, playersNearObjective[i], playersNearObjective[i], 0, eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
	}
}

void function PlayCharacterDialogueToObjective( string alias, ObjectiveInstance oi )
{
	table<int, array<entity> > teamPlayersMap = Objectives_GetTeamsInOrNearObjective( oi )

	array<array<entity> > playerSets
	foreach( int team, array<entity> players in teamPlayersMap )
		playerSets.append( players )
	PlayCharacterOrRadioDialogueToSetsOfPlayers( alias, playerSets, eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
}

void function PlayCharacterDialogueToPlayer( string alias, entity player )
{
	PlayCharacterOrRadioDialogueToSetsOfPlayers( alias, [[player]], eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
}

table<int, array<entity> > function GetTeamsToPlayersMap()
{
	table<int, array<entity> > result
	foreach( entity player in GetPlayerArray() )
	{
		int team = player.GetTeam()
		if ( !(team in result) )
			result[team] <- []
		result[team].append( player )
	}

	return result
}

void function PlayCharacterDialogueToEveryone( string alias )
{
	table<int, array<entity> > teamPlayersMap = GetTeamsToPlayersMap()
	array<array<entity> > playerSets
	foreach( int team, array<entity> players in teamPlayersMap )
		playerSets.append( players )

	PlayCharacterOrRadioDialogueToSetsOfPlayers( alias, playerSets, eDialogueFlags.MUTE_PLAYER_PING_DIALOGUE_FOR_DURATION )
}

void function ClientMusic_PlayCustomTrackToObjective( int musicTrack, ObjectiveInstance oi )
{
	array<entity> inOrNear = Objectives_GetPlayersInOrNearObjective( oi )
	foreach ( player in inOrNear )
		ClientMusic_PlayCustomTrackOnClient( player, musicTrack )
}

#endif // SERVER



