#if SERVER
bool function Objectives_AnyObjectiveIsUsingZoneId( int zoneId )
{
	foreach( ObjectiveInstance oi in s_instances )
	{
		if ( oi.currentZones.contains( zoneId ) )
			return true
	}

	return false
}

bool function Objectives_AnyObjectiveIsUsingZoneIds( array<int> zoneIds )
{
	foreach( zoneId in zoneIds )
	{
		if ( Objectives_AnyObjectiveIsUsingZoneId( zoneId ) )
			return true
	}
	return false
}

bool function Objectives_AnyObjectiveIsUsingZoneGroup( string zoneGroup )
{
	foreach ( ObjectiveInstance oi in s_instances )
	{
		foreach ( int zoneId in oi.currentZones )
		{
			if ( MapZones_GetZoneGroupForZone( zoneId ) == zoneGroup )
				return true
		}
	}

	return false
}
#endif // SERVER


