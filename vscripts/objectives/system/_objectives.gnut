global struct ObjectiveLaunchData
{
	string objectiveType
	array<int> homeZones
	array<string> zoneGroups
	vector defaultOrigin
	float objectiveActivateRadius

	int ambientOverrideType

	struct
	{
		ResourceCollection res
		table<string, int> intVars
		table<string, vector> vecVars
	} custom
}

global struct ObjectiveInstance
{
	string objectiveType
	ObjectiveLaunchData& launchData

	int objectiveIndex
	int objectiveState		// eObjectiveState
	float objectiveStateCompletedTime

	SkitInstance& skitInstance

	entity tasklist

	array<int> currentZones

	array<entity> latestPlayers

	entity wpMain

	entity beaconEffectHandle
}

global struct ObjectiveRegistrationInfo
{
	string title
	asset icon = $"rui/hud/objectives/generic_icon_b"

	void functionref( array<ObjectiveLaunchData> )		func_onGatherPossibleLaunches =		null
	void functionref( SkitInstance )					func_runtime
	void functionref( SkitInstance )					func_onRuntimeFinished
	void functionref( ObjectiveInstance )				func_onObjectiveDelete
	bool functionref( entity, ObjectiveInstance )		func_playerIsInsideOfObjective
}
#endif // SERVER


// not-global:

const int TASKLIST_WAYPOINT_INDEX = 0

#if SERVER
struct ObjectiveDef
{
	string title
	asset icon

	void functionref (array<ObjectiveLaunchData> )		func_onGatherPossibleLaunches
	void functionref( SkitInstance )					func_runtime
	void functionref( SkitInstance )					func_onRuntimeFinished
	void functionref( ObjectiveInstance )				func_onObjectiveDelete
	bool functionref( entity, ObjectiveInstance )		func_playerIsInsideOfObjective
}
table<string, ObjectiveDef> s_defMap


void function ObjectiveSystem_RegisterType( string objectiveType, ObjectiveRegistrationInfo info )
{
	Assert( !(objectiveType in s_defMap), format( "An objective type with id '%s' has already been registered.", objectiveType ) )

	ObjectiveDef newDef
	s_defMap[objectiveType] <- newDef

	Assert( info.title.len() > 0 )
	Assert( info.func_onGatherPossibleLaunches != null )
	Assert( info.func_runtime != null )

	newDef.title = info.title
	newDef.icon = info.icon
	newDef.func_onGatherPossibleLaunches = info.func_onGatherPossibleLaunches
	newDef.func_runtime = info.func_runtime
	newDef.func_onRuntimeFinished = info.func_onRuntimeFinished
	newDef.func_onObjectiveDelete = info.func_onObjectiveDelete
	newDef.func_playerIsInsideOfObjective = info.func_playerIsInsideOfObjective
}

void function LaunchInstanceAndMonitor_Thread( ObjectiveDef def, ObjectiveInstance oi )
{
	//Assert( oi.skitInstance == null )
	SkitInstance si = Skit_AllocInstance( def.func_runtime, def.func_onRuntimeFinished )
	oi.skitInstance = si

	EndSignal( si, SIG_SKIT_SHUTDOWN_COMPLETE )
	OnThreadEnd(
		function() : ( si, oi )
		{
			Assert( si.lifeState == eSkitLifeState.SHUT_DOWN )

			if ( oi.objectiveState < eObjectiveState.COMPLETED )
				Objectives_MarkObjectiveAsComplete( oi )
		}
	)

	Skit_LaunchInstance( si )
	WaitForever()
}

array<ObjectiveInstance> s_instances
ObjectiveInstance function ObjectiveSystem_LaunchInstance( ObjectiveLaunchData ld )
{
	ObjectiveDef def = s_defMap[ld.objectiveType]
	ObjectiveInstance oi
	oi.objectiveType = ld.objectiveType
	oi.objectiveIndex = s_instances.len()
	s_instances.append( oi )

	//
	oi.launchData = (clone ld)

	// by default, assign us to the zones we were launched with:
	oi.currentZones = ld.homeZones

	//
	oi.wpMain = CreateWaypoint_ObjectiveIndicator()
	Waypoint_Objectives_BindToObjective( oi.wpMain, oi )
	Waypoint_Objectives_SetFadeWhenInside( oi.wpMain )
	SetObjectiveIcon( oi, $"rui/hud/objectives/undiscovered" )
	// by default, put waypoint at center of starting homezones:
	oi.wpMain.SetOrigin( oi.launchData.defaultOrigin )

	//
	oi.tasklist = CreatePlayerTasklist()
	oi.tasklist.SetTasklistCustomInt( oi.objectiveIndex + 1 ) // count starts at 1
	oi.wpMain.SetWaypointEntity( TASKLIST_WAYPOINT_INDEX, oi.tasklist )

	//
	oi.beaconEffectHandle = StartParticleEffectInWorld_ReturnEntity( GetParticleSystemIndex( OBJECTIVE_BEACON_EFFECT_HANDLE ), oi.launchData.defaultOrigin - <0,0,1000>, <0, 0, 0> + <90, 0, 0> )

	//
	//SetObjectiveState( oi, eObjectiveState.UNDISCOVERED )
	SetObjectiveState( oi, eObjectiveState.REVEALED )
	SetObjectiveIcon( oi, def.icon )
	SetObjectiveTitle( oi, def.title )

	printf( "%s() - Launching objective #%i, an instance of '%s'.", FUNC_NAME(), oi.objectiveIndex, ld.objectiveType )
	thread LaunchInstanceAndMonitor_Thread( def, oi )
	//def.callback_OnLaunchObjectiveInstance( oi, ld )
	return oi
}

array<ObjectiveLaunchData> function ObjectiveSystem_GetLaunchOptionsForType( string objectiveType )
{
	ObjectiveDef def = s_defMap[objectiveType]

	array<ObjectiveLaunchData> results
	def.func_onGatherPossibleLaunches( results )
	return results
}

ObjectiveInstance function ObjectiveSystem_GetObjectiveForSkit( SkitInstance si )
{
	foreach( oi in s_instances )
	{
		if ( oi.skitInstance == si )
			return oi
	}

	Assert( false, format( "No objective has a main skit instance matching [%s].", string( si ) ) )
	return s_instances[0]
}

array<string> function ObjectiveSystem_GetAllTypes()
{
	array<string> results
	foreach( string objectiveType, ObjectiveDef def in s_defMap )
		results.append( objectiveType )
	return results
}
