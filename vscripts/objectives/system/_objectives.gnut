ObjectiveInstance function DEV_GetObjective( int index )
{
	return s_instances[index]
}

float function GetSortScoreForDevLaunch( ObjectiveLaunchData ld )
{
	const float MY_MAX_DIST = 99999.0
	float bestDist = MY_MAX_DIST
	foreach ( entity player in GetPlayerArray_AliveConnected() )
	{
		vector pos = player.GetOrigin()
		foreach( int zoneId in ld.homeZones )
		{
			entity trigger = MapZones_GetTriggerForZone( zoneId )
			if ( !IsValid( trigger ) )
				continue
			float dist = Distance( trigger.GetCenter(), pos )
			bestDist = min( dist, bestDist )
		}
	}

	return (1.0 - (bestDist / MY_MAX_DIST))
}

int function DevLaunchObjectiveSort_( ObjectiveLaunchData ll, ObjectiveLaunchData rr, bool doReverse )
{
	float llRank = GetSortScoreForDevLaunch( ll )
	float rrRank = GetSortScoreForDevLaunch( rr )

	if ( llRank < rrRank )
		return (doReverse ? -1 : 1)
	if ( llRank > rrRank )
		return (doReverse ? 1 : -1)
	return 0
}
int function DevLaunchObjectiveSort( ObjectiveLaunchData ll, ObjectiveLaunchData rr )
{
	return DevLaunchObjectiveSort_( ll, rr, false )
}
int function DevLaunchObjectiveSortReverse( ObjectiveLaunchData ll, ObjectiveLaunchData rr )
{
	return DevLaunchObjectiveSort_( ll, rr, true )
}

ObjectiveInstance ornull function DEV_LaunchObjective_( string objectiveType, int functionref(ObjectiveLaunchData, ObjectiveLaunchData) sortFunc )
{
	if ( (objectiveType == "") || !(objectiveType in s_defMap) )
	{
		printf( "%s() - objectiveType '%s' not valid. The %d valid types are:", FUNC_NAME(), objectiveType, s_defMap.len() )
		foreach( key,value in s_defMap )
		{
			printf( "  [\"%s\"] -> %s,  launchfunc:%s", key, value.title, string( value.func_runtime ) )
		}
		printf( "" )
		Assert( false, "Unknown objective type. See console log." )
		return null
	}

	array<ObjectiveLaunchData> options = ObjectiveSystem_GetLaunchOptionsForType( objectiveType )
	printf( "%s() - Found %d launch options.", FUNC_NAME(), options.len() )
	if ( options.len() == 0 )
		return null

	options.randomize()
	options.sort( sortFunc )

	ObjectiveInstance result = ObjectiveSystem_LaunchInstance( options[0] )
	return result
}

ObjectiveInstance ornull function DEV_LaunchObjective( string objectiveType )
{
	return DEV_LaunchObjective_( objectiveType, DevLaunchObjectiveSort )
}

ObjectiveInstance ornull function DEV_LaunchObjectiveFarAway( string objectiveType )
{
	return DEV_LaunchObjective_( objectiveType, DevLaunchObjectiveSortReverse )
}

void function DEV_LaunchObjectiveCount( string objectiveType, int count )
{
	int idx
	for ( idx = 0; idx < count; ++idx )
	{
		array<ObjectiveLaunchData> options = ObjectiveSystem_GetLaunchOptionsForType( objectiveType )
		if ( options.len() == 0 )
			break

		options.randomize()
		ObjectiveSystem_LaunchInstance( options[0] )
	}

	printf( "%s() - Launched '%s' %d of %d times.", FUNC_NAME(), objectiveType, idx, count )
}

bool function ListsHaveAMatch( array<string> aa, array<string> bb )
{
	foreach ( entry in aa )
	{
		if ( bb.contains( entry ) )
			return true
	}
	return false
}

float function GetSortScoreForLaunch( ObjectiveLaunchData ld )
{
	vector ldCenter = MapZones_GetAveragePositionOfZones( ld.homeZones )

	const float MY_MAX_DIST = 99999.0
	float bestDist = MY_MAX_DIST
	foreach( ObjectiveInstance oi in s_instances)
	{
		vector thisCenter = MapZones_GetAveragePositionOfZones( oi.launchData.homeZones )
		float dist = Distance( thisCenter, ldCenter )
		bestDist = min( dist, bestDist )
	}

	return (1.0 - (bestDist / MY_MAX_DIST))
}

float function GetBestDistanceSqr2D( vector org, array<vector> hotspots )
{
	float bestDistSqr = (999999.0 * 999999.0)
	foreach( spot in hotspots )
	{
		float distSqr = Distance2DSqr( org, spot )
		if ( distSqr < bestDistSqr )
			bestDistSqr = distSqr
	}
	return bestDistSqr
}
int function CalcLaunchObjectiveSortWithHotSpots( ObjectiveLaunchData ll, ObjectiveLaunchData rr, array<vector> hotspots )
{
	float llRank = GetSortScoreForLaunch( ll )
	float rrRank = GetSortScoreForLaunch( rr )

	vector llCenter = MapZones_GetAveragePositionOfZones( ll.homeZones )
	vector rrCenter = MapZones_GetAveragePositionOfZones( rr.homeZones )
	float llDistSqr = GetBestDistanceSqr2D( llCenter, hotspots )
	float rrDistSqr = GetBestDistanceSqr2D( rrCenter, hotspots )

	if ( llDistSqr > rrDistSqr )
		return -1
	if ( llDistSqr < rrDistSqr )
		return 1
	return 0
}

float function GetDistanceToClosestObjectiveCenter( ObjectiveLaunchData ld )
{
	vector ldCenter = MapZones_GetAveragePositionOfZones( ld.homeZones )

	const float MY_MAX_DIST = 99999.0
	float bestDist = MY_MAX_DIST
	foreach( ObjectiveInstance oi in s_instances)
	{
		vector thisCenter = MapZones_GetAveragePositionOfZones( oi.launchData.homeZones )
		float dist = Distance( thisCenter, ldCenter )
		bestDist = min( dist, bestDist )
	}

	return bestDist
}


ObjectiveInstance ornull function Objectives_LaunchObjective( string objectiveType, array<string> zoneGroupsToAvoid )
{
	array<ObjectiveLaunchData> options = ObjectiveSystem_GetLaunchOptionsForType( objectiveType )
	printf( "%s() - Found %d launch options.", FUNC_NAME(), options.len() )
	if ( options.len() == 0 )
		return null

	array<ObjectiveLaunchData> filtered
	foreach( ld in options )
	{
		if ( ListsHaveAMatch( ld.zoneGroups, zoneGroupsToAvoid ) )
			continue

		float bestDist = GetDistanceToClosestObjectiveCenter( ld )
		if ( bestDist < 20000 )
			continue

		filtered.append( ld )
	}
	if ( filtered.len() == 0 )
		return null

	//array<vector> hotspots
	//foreach( string group in zoneGroupsToAvoid )
	//{
	//	array<int> zoneIds = MapZones_GetZoneIdsForZoneGroup( group )
	//	vector center = MapZones_GetAveragePositionOfZones( zoneIds )
	//	hotspots.append( center )
	//}
	//foreach( ObjectiveInstance oi in s_instances)
	//{
	//	vector center = MapZones_GetAveragePositionOfZones( oi.launchData.homeZones )
	//	hotspots.append( center )
	//}
	//
	//options.randomize()
	//filtered.sort( int function( ObjectiveLaunchData ll, ObjectiveLaunchData rr ) : (hotspots)
	//{
	//	return CalcLaunchObjectiveSortWithHotSpots( ll, rr, hotspots )
	//})

	ObjectiveLaunchData ld = filtered.getrandom()
	ObjectiveInstance result = ObjectiveSystem_LaunchInstance( ld )
	return result
}

void function DEV_ClearAllObjectives()
{
	foreach( ObjectiveInstance oi in s_instances )
	{
		if ( oi.skitInstance.lifeState == eSkitLifeState.RUNNING )
		{
			Sk_KillSkit( oi.skitInstance )
		}

		if ( IsValid( oi.tasklist ) )
		{
			oi.tasklist.Destroy()
			oi.tasklist = null
		}

		if ( IsValid( oi.wpMain ) )
		{
			oi.wpMain.Destroy()
			oi.wpMain = null
		}

		ObjectiveDef def = s_defMap[oi.objectiveType]
		if ( def.func_onObjectiveDelete != null)
			def.func_onObjectiveDelete( oi )
	}

	s_instances.clear()
}


