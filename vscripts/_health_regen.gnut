global function HealthRegen_Init
global function HealthRegen_RegisterNetworking

global function HealthRegen_IsOctane

global function GetPlaylistVar_HealthRegenDelay
global function GetPlaylistVar_HealthRegenPerSec

#if SERVER
global function HealthRegen_StartOctanePassive
global function HealthRegen_Thread
global function HealthRegen_End
global function PilotShieldHealthUpdate
global function ShadowHealthUpdate
global function HealthRegen_OnPlayerHealingEnded

global function AddCallback_OnPlayerShieldBreak
global function AddCallback_OnPlayerShieldDamage
global function AddCallback_OnHealRegenMPStateChanged
