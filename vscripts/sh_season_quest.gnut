global const SHOW_UNKNOWN_ARTIFACTS = true	// if true will hide true name of artifacts until mission is beaten.

global enum eQuestMissionStatus
{
	// should have matching consts in quest.rui
	INVALID = -1,
	LOCKED,
	UNLOCKED_BUT_TOO_EARLY,
	UNLOCKED_BUT_NOT_NEXT,

	LAUNCHABLE,
	COMPLETED
}

struct {
	table< ItemFlavor, array< ItemFlavor > > questMissions
	table< ItemFlavor, array< ItemFlavor > > questComicPages
} file

const string FUNCNAME_DoGotTreasurePackNotify = "SCB_DoGotTreasurePackNotify"
const string FUNCNAME_UpdatePanelData = "SCB_UpdateQuestPanelData"
void function SeasonQuest_RegisterNetworking()
{
	Remote_RegisterClientFunction( FUNCNAME_DoGotTreasurePackNotify )
	Remote_RegisterUIFunction( FUNCNAME_UpdatePanelData )
}

const string CC_TreasureBoxDisplayAcknowledged = "ClientCallback_TreasureBoxDisplayAcknowledged"
const string CC_QuestStartedAcknowledged = "ClientCallback_QuestStartedAcknowledged"
const string CC_QuestComicReadAcknowledged = "ClientCallback_QuestComicReadAcknowledged"
const string CC_QuestComicRewardDisplayAcknowledged = "ClientCallback_QuestComicRewardDisplayAcknowledged"
const string CC_QuestMissionReadAcknowledged = "ClientCallback_QuestMissionReadAcknowledged"
const string CC_QueueRadioPlayRewardGranting = "ClientCallback_QueueRadioPlayRewardGranting"

void function SeasonQuest_SharedInit()
{
	printt("Quest system registered")
	#if SERVER || CLIENT
		Remote_RegisterServerFunction( CC_TreasureBoxDisplayAcknowledged, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( CC_QuestStartedAcknowledged, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( CC_QuestComicReadAcknowledged, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( CC_QuestComicRewardDisplayAcknowledged, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( CC_QuestMissionReadAcknowledged, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX )
		Remote_RegisterServerFunction( CC_QueueRadioPlayRewardGranting )
	#endif

	#if SERVER
		AddCallback_QueueServersideScriptGRXOperations( GivePlayerAnyPendingTreasureBoxRewards )
		AddCallback_QueueServersideScriptGRXOperations( GivePlayerAnyPendingMissionRewards )
		AddCallback_QueueServersideScriptGRXOperations( UpdatePlayerTreasureBoxPurchaseCache )
		AddCallback_QueueServersideScriptGRXOperations( UpdatePlayerQuestNewness )

		AddCallback_Lobby_OnClientConnected( SeasonQuest_TreasurePackTimerFix  )

		#if DEVELOPER
			RegisterDevCommands()
			AddCallback_GeneratePDef( GenerateSeasonQuest_PDef )
		#endif // DEVELOPER
	#endif // SERVER

	AddCallback_OnItemFlavorRegistered( eItemType.quest, OnQuestRegistered )
}


void function OnQuestRegistered( ItemFlavor quest )
{
	//printt( "DEBUG: OnQuestRegistered called for:", string( quest ) )
	array<ItemFlavor> comicPages = RegisterReferencedItemFlavorsFromArray( quest, "comicPages", "flavor" )
	file.questComicPages[ quest ] <- comicPages

	array<ItemFlavor> missions = RegisterReferencedItemFlavorsFromArray( quest, "missions", "flavor" )
	file.questMissions[ quest ] <- missions
	//printt( "DEBUG: OnQuestRegistered - missions count:", missions.len() )

	foreach( int idx, ItemFlavor mission in missions )
	{

		string type = SeasonQuest_GetLoreTypeForMissionIndex( quest, idx )
		if( type == "RadioPlay" )
		{
			RegisterItemFlavorFromSettingsAsset( SeasonQuest_GetLoreSequenceRadioPlayForMissionIndex( quest, idx ) )
		}
	}

	//RegisterItemFlavorFromSettingsAsset( $"settings/itemflav/grx_sentinel/s05_quest_mission_dummy.rpak" )
	//RegisterItemFlavorFromSettingsAsset( $"settings/itemflav/grx_sentinel/s06_quest_comic_dummy.rpak" )

	#if SERVER || CLIENT
		// was used in season 5
		//asset questModelAsset = SeasonQuest_GetGoalModel( quest )
		//PrecacheModel( questModelAsset )
	#endif
}


bool function SeasonQuest_AllTreasurePacksHaveBeenCollectedForPlayer( entity player, ItemFlavor quest )
{
	Assert( ItemFlavor_GetType( quest ) == eItemType.quest )
	int packCount = SeasonQuest_GetTreasurePacksCountForPlayer( player, quest )
	return (packCount >= SeasonQuest_GetTreasurePacksMaxCount( quest ))
}


int function SeasonQuestMission_GetLatestTimeUnlockedMission()
{
	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null )
	{
		return -1
	}
	expect ItemFlavor( quest )

	int missionsCount = SeasonQuest_GetMissionsMaxCount( quest )
	int now = GetUnixTimestamp()

	for( int i = 0; i < missionsCount; i++ )
	{
		int unlockTime = SeasonQuest_GetUnlockTimeForMissionIndex( quest, i )
		if ( now < unlockTime  )
			return ( i - 1 )
	}

	return ( missionsCount - 1 )
}


int function SeasonQuest_GetStatusForComicPageIndex( entity player, ItemFlavor quest, int index )
{
	Assert( ItemFlavor_GetType( quest ) == eItemType.quest )

	// reusing eQuestMissionStatus since it works for now.

	if ( IsEverythingUnlocked() )
		return eQuestMissionStatus.COMPLETED

	// THERE IS NO FINAL COMIC PAGE - The finale requires all prev missions to be complete, but no new boxes required:
	//int comicPagesTotalMax = SeasonQuest_GetComicPagesMaxCount( quest )
	//if ( index == (comicPagesTotalMax - 1) )
	//{
	//	int prevStatus = SeasonQuest_GetStatusForMissionIndex( player, quest, (index - 1) )
	//	if ( prevStatus == eQuestMissionStatus.COMPLETED )
	//		return eQuestMissionStatus.LAUNCHABLE
	//	return eQuestMissionStatus.LOCKED
	//}

                           
                             
                                                                                
                                                                                                         

                                                              

                                                                             

                                           
  
                                                                                                                 
                                   
  

                                                        
                                   
     
	int unlockTime = SeasonQuest_GetUnlockTimeForComicIndex( quest, index )
	if ( unlockTime > GetUnixTimestamp() )
		return eQuestMissionStatus.UNLOCKED_BUT_TOO_EARLY
      

	int comicsPagesRead = SeasonQuest_GetComicPagesReadByPlayer( player, quest )
	if ( index < comicsPagesRead )
		return eQuestMissionStatus.COMPLETED

	if ( index > (comicsPagesRead) )
		return eQuestMissionStatus.UNLOCKED_BUT_NOT_NEXT

	return eQuestMissionStatus.LAUNCHABLE
}


int function SeasonQuest_GetStatusForMissionIndex( entity player, ItemFlavor quest, int missionIndex )
{
	Assert( ItemFlavor_GetType( quest ) == eItemType.quest )

	if ( IsEverythingUnlocked() )
		return eQuestMissionStatus.COMPLETED
	if ( GetCurrentPlaylistVarBool( "seasonquest_force_missions_unlocked", false ) )
		return eQuestMissionStatus.COMPLETED

	int missionsTotalMax = SeasonQuest_GetMissionsMaxCount( quest )

	int missionsDone = SeasonQuest_GetMissionsCompletedForPlayer( player, quest )
	if ( missionIndex < missionsDone )
		return eQuestMissionStatus.COMPLETED


	int unlockTime = SeasonQuest_GetUnlockTimeForMissionIndex( quest, missionIndex )
	if ( unlockTime > GetUnixTimestamp() )
		return eQuestMissionStatus.UNLOCKED_BUT_TOO_EARLY

	if ( missionIndex > (missionsDone) )
		return eQuestMissionStatus.UNLOCKED_BUT_NOT_NEXT

	return eQuestMissionStatus.LAUNCHABLE
}

#if UI
void function FillTooltipDataForMissionButton( entity player, ItemFlavor quest, int missionIndex, ToolTipData tt )
{
	int packsInSeason = SeasonQuest_GetTreasurePacksMaxCount( quest )
	int packIndexRequiredForMission = SeasonQuest_GetTreasurePackIndexRequiredForMission( quest, missionIndex )
	int packsFoundRequired = (packIndexRequiredForMission + 1)
	int packsFound = SeasonQuest_GetTreasurePacksCountForPlayer( player, quest )
	if ( packsFound < packsFoundRequired )
		tt.titleText = Localize( "#QUEST_MISSION_TOOLTIP_PACKS", string( packsFoundRequired - packsFound ) )
	else
		tt.titleText = ""

	int timeNow = GetUnixTimestamp()
	int unlockTime = SeasonQuest_GetUnlockTimeForMissionIndex( quest, missionIndex )
	int delta = (unlockTime - timeNow)
	if ( delta < 0 )
	{
		tt.descText = "#QUEST_MISSION_TOOLTIP_AVAILABLE_NOW"
		return
	}

	int days = (delta / SECONDS_PER_DAY)
	int hours = (delta - (days * SECONDS_PER_DAY)) / SECONDS_PER_HOUR
	tt.descText = Localize( "#QUEST_MISSION_TOOLTIP_AVAILABLE_DAYS", string( days ), string( hours ) )
}
#endif //

#if SERVER
array<entity> s_playersInMissionRewarding
void function GivePlayerAnyPendingMissionRewards( entity player )
{
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		if ( s_playersInMissionRewarding.contains( player ) )
			return
		OnThreadEnd( function() : (player)
		{
			s_playersInMissionRewarding.removebyvalue( player )
		} )
		s_playersInMissionRewarding.append( player )

		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		foreach ( ItemFlavor quest in GetAllItemFlavorsOfType( eItemType.quest ) )
		{
			if ( !IsQuestCurrentOrLastSeason( quest ) )
				continue

			// don't give mission rewards for quests that doesn't have missions.
			if ( GetRewardSequenceMarketplaceVarForMissions( quest ) != "" )
				GivePlayerMissionRewardsForQuest( player, quest )

			if ( GetRewardSequenceMarketplaceVarForComic( quest ) != "" )
				GivePlayerMissionRewardsForComic( player, quest )
		}
	}()
}
void function GivePlayerMissionRewardsForQuest( entity player, ItemFlavor quest )
{
	if ( ItemFlavor_IsItemDisabledForGRX( quest ) )
		return

	GivePlayerQuestRewardSequencesFor_(
		player, quest,
		GetRewardSequenceMarketplaceVarForMissions( quest ),
		SeasonQuest_GetMissionsCompletedForPlayer( player, quest ),
		SeasonQuest_GetMissionRewardsForIndex
	)
}

void function GivePlayerAnyPendingRadioPlayRewards( entity player )
{
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		if ( s_playersInMissionRewarding.contains( player ) )
			return
		OnThreadEnd( function() : (player)
		{
			s_playersInMissionRewarding.removebyvalue( player )
		} )
		s_playersInMissionRewarding.append( player )

		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		foreach ( ItemFlavor quest in GetAllItemFlavorsOfType( eItemType.quest ) )
		{
			if ( !IsQuestActive( quest ) )
				continue

			// don't give mission rewards for quests that doesn't have missions.
			int missionsCompleted = SeasonQuest_GetMissionsCompletedForPlayer( player, quest )
			ItemFlavorBag rewardBags
			for( int i = 0; i < missionsCompleted; i++ )
			{
				ItemFlavorBag rewardBag = SeasonQuest_GetMissionRewardsForIndex( quest, i )
				if ( rewardBag.flavors.len() == 0 )
					continue

				GrantRewardsConfig grc
				grc.what               = rewardBag
				grc.sourceFlav         = quest
				grc.showCeremony       = true    //Challenge tiers with multiple rewards will have one ceremony for each reward. It's not the best, but it works. It's the same behavior as if you complete multiple tiers in one go.
				grc.markAsNew          = true
				int grantResult = GRX_GrantRewards( player, grc )
			}
		}
	}()
}

void function GivePlayerMissionRewardsForComic( entity player, ItemFlavor quest )
{
	if ( ItemFlavor_IsItemDisabledForGRX( quest ) )
		return

	ItemFlavorBag finalRewards = SeasonQuest_GetCompletionRewards( quest )
	if ( finalRewards.flavors.len() == 0 )
		return

	string mtxSequenceName = GetRewardSequenceMarketplaceVarForComic( quest )
	int sequenceStartNum = GRX_GetSequenceNumber( player, mtxSequenceName )
	if ( sequenceStartNum > 0 || sequenceStartNum == GRX_INVALID_SEQUENCE_NUMBER )
	{
		#if DEVELOPER
			Assert( sequenceStartNum != GRX_INVALID_SEQUENCE_NUMBER, "Seasonal reward sequence " + mtxSequenceName + " is not valid." )
		#endif
		return
	}

                          
	// S08 - decouples comics and treasure packs
	// Grant the completion rewards when all treasure packs have been collected
	if ( !SeasonQuest_AllTreasurePacksHaveBeenCollectedForPlayer( player, quest ) )
		return
     
                                                          
                                                                                
                                 
        

                                                                        
                             
        
      

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = HTTPQUERYGOAL
	operation.doOperationFunc = (void function( int opID ) : ( player, mtxSequenceName, finalRewards )
	{
		GRX_GiveSequenceRewardEasy( player, opID, HTTPQUERYGOAL, mtxSequenceName, 0, 1, finalRewards )
	})
	operation.onDoneCallback = ( void function( int status ) : ( player, quest )
	{
		bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
		if ( didOperationSucceed )
		{
			SetComicFinalRewardDisplay( player, quest, true )
		}
	} )
	QueueGRXOperation( player, operation )
}

const int HTTPQUERYGOAL = GRX_HTTPQUERYGOAL_GIVE_QUEST_SEQUENCE_REWARD
struct sGiveResults
{
	int count
	int startNum
}
sGiveResults function GivePlayerQuestRewardSequencesFor_(
entity player, ItemFlavor quest,
string mtxSequenceName,
int sequenceGoalNum,
ItemFlavorBag functionref( ItemFlavor flav, int seqIndex ) getRewardsFunc
)
{
	sGiveResults res

	int sequenceStartNum = GRX_GetSequenceNumber( player, mtxSequenceName )
	if ( sequenceStartNum == GRX_INVALID_SEQUENCE_NUMBER )
	{
		#if DEVELOPER
			Assert( false, "Seasonal reward sequence " + mtxSequenceName + " is not valid." )
		#endif
		return res
	}

	int count = (sequenceGoalNum - sequenceStartNum)

	ItemFlavorBag questRewards
	int questRewardIndex = sequenceStartNum
	for ( int rewardIndex = sequenceStartNum; rewardIndex < sequenceGoalNum; rewardIndex++ )
	{
		int level = rewardIndex // remove
		ItemFlavorBag rewards = getRewardsFunc( quest, rewardIndex )
		ItemFlavorBag_ClearZeroQuantityFlavors( rewards )

		// some bags will be empty but we still have to treat them as real indexes
		if ( rewards.flavors.len() > 0 )
		{
			IsItemFlavorBagValid( rewards, false, eValidation.ASSERT )
			foreach( int bagIndex, ItemFlavor reward in rewards.flavors )
			{
				Assert( rewards.quantities[ bagIndex ] > 0 )

				questRewards.flavors.append( reward )
				questRewards.quantities.append( rewards.quantities[ bagIndex ] )
			}
		}

		questRewardIndex = rewardIndex
	}

	int sequenceGoalNum2 = questRewardIndex+1

	if ( sequenceGoalNum2 != sequenceStartNum && questRewards.flavors.len() > 0 )
	{
		ScriptGRXOperationInfo operation
		operation.expectedQueryGoal = HTTPQUERYGOAL
		operation.doOperationFunc = (void function( int opID ) : ( player, mtxSequenceName, sequenceStartNum, sequenceGoalNum2, questRewards )
		{
			GRX_GiveSequenceRewardEasy( player, opID, HTTPQUERYGOAL, mtxSequenceName, sequenceStartNum, sequenceGoalNum2, questRewards )
		})

		operation.onDoneCallback = (void function( int status ) : ( player, questRewards ) {
			bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
			if ( !didOperationSucceed )
				return

			foreach ( int flavIdx, ItemFlavor flav in questRewards.flavors )
				GRX_MarkAsNewIfAppropriate( player, flav )
		})

		QueueGRXOperation( player, operation )

		while ( !IsGRXOperationDone( operation ) )
			WaitFrame()

		if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
			Warning( "Treasure Pack Rewards operation failed" )
	}

	res.count = count
	res.startNum = sequenceStartNum
	return res
}
#endif // SERVER

