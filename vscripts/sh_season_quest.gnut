#if SERVER
void function UpdatePlayerTreasureBoxPurchaseCache( entity player )
{
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
		if ( quest == null )
			return

		expect ItemFlavor( quest )
		ItemFlavor treasureBoxPurchaseFlav = SeasonQuest_GetTreasureBoxPurchaseFlav( quest )
		int numPurchasedBoxes = GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( treasureBoxPurchaseFlav ) )

		player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_lastSeenPurchased ), numPurchasedBoxes )
	}()
}
#endif //SERVER
#if SERVER
void function UpdatePlayerQuestNewness( entity player )
{
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
		if ( quest == null )
			return

		expect ItemFlavor( quest )
		for ( int missionIndex = 0; missionIndex < SeasonQuest_GetMissionsMaxCount( quest ); missionIndex++ )
		{
			ItemFlavor mission = SeasonQuest_GetMissionForIndex( quest, missionIndex )
			int missionStatus = SeasonQuest_GetStatusForMissionIndex( player, quest, missionIndex )
			int unlockTime = SeasonQuestMission_GetUnlockTime( mission )

			if ( missionStatus == eQuestMissionStatus.LAUNCHABLE && unlockTime >= SeasonQuest_GetLastMissionUnlockTime( player, quest ) )
			{
				Newness_MarkItemFlavorsAsNewForPlayer( player, [mission], true )
				SeasonQuest_UpdateLastMissionUnlockTime( player, quest )
			}
		}
	}()
}
#endif //SERVER


