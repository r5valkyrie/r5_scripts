const string VARBLOCKNAME_QuestDatas = "questDatas"
const string VARNAME_TB_lastPickupTime = "treasureBox_lastPickupTime"
const string VARNAME_TB_totalPickups = "treasureBox_totalPickups"
const string VARNAME_TB_displayStartNum = "treasureBox_displayStartNum"
const string VARNAME_TB_displayCount = "treasureBox_displayCount"
const string VARNAME_CP_displayFinalRewards = "comicPanel_displayFinalRewards"
const string VARNAME_missionProgress = "missionProgress"
const string VARNAME_comicPagesRead = "comicPagesRead"
const string VARNAME_haveStartedQuest = "haveStartedQuest"
const string VARNAME_TB_lastSeenPurchased = "treasureBox_lastSeenPurchased"
const string VARNAME_lastMissionUnlockTime = "lastMissionUnlockTime"

string function BuildPersistentVarName( ItemFlavor quest, string varName )
{
	Assert( ItemFlavor_GetType( quest ) == eItemType.quest )
	return format( "%s[%s].%s", VARBLOCKNAME_QuestDatas, ItemFlavor_GetGUIDString( quest ), varName )
}


int function GetPersistentQuestVarInt( entity player, ItemFlavor quest, string varName )
{
	return player.GetPersistentVarAsInt( BuildPersistentVarName( quest, varName ) )
}

#if SERVER
array<entity> s_playersInTreasureBoxRewarding
void function GivePlayerAnyPendingTreasureBoxRewards( entity player )
{
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		if ( s_playersInTreasureBoxRewarding.contains( player ) )
			return
		OnThreadEnd( function() : (player)
		{
			s_playersInTreasureBoxRewarding.removebyvalue( player )
		} )
		s_playersInTreasureBoxRewarding.append( player )

		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		foreach ( ItemFlavor quest in GetAllItemFlavorsOfType( eItemType.quest ) )
		{
			if ( !IsQuestCurrentOrLastSeason( quest ) )
				continue

			GivePlayerTreasureBoxRewardsForQuest( player, quest )
		}
	}()
}

void function GivePlayerTreasureBoxRewardsForQuest( entity player, ItemFlavor quest )
{
	if ( ItemFlavor_IsItemDisabledForGRX( quest ) )
		return

	sGiveResults res = GivePlayerQuestRewardSequencesFor_(
		player, quest,
		GetRewardSequenceMarketplaceVarForTreasurePacks( quest ),
		SeasonQuest_GetTreasurePacksCountForPlayer( player, quest ),
		SeasonQuest_GetTreasurePackRewardsForIndex
	)

	if ( res.count > 0 )
		SetTreasureBoxRewardDisplay( player, quest, res.startNum, res.count )
	}

void function SetComicFinalRewardDisplay( entity player, ItemFlavor quest, bool status )
{
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_CP_displayFinalRewards ), status )
}

void function SetTreasureBoxRewardDisplay( entity player, ItemFlavor quest, int startNum, int count )
{
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_displayStartNum ), startNum )
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_displayCount ), count )
}

void function ClientCallback_QuestComicRewardDisplayAcknowledged( entity player, int guid )
{
	if ( !IsValidItemFlavorGUID( guid ) )
		return
	ItemFlavor quest = GetItemFlavorByGUID( guid )
	if ( ItemFlavor_GetType( quest ) != eItemType.quest )
		return

	SetComicFinalRewardDisplay( player, quest, false )
}

void function ClientCallback_TreasureBoxDisplayAcknowledged( entity player, int guid )
{
	if ( !IsValidItemFlavorGUID( guid ) )
		return
	ItemFlavor quest = GetItemFlavorByGUID( guid )
	if ( ItemFlavor_GetType( quest ) != eItemType.quest )
		return

	SetTreasureBoxRewardDisplay( player, quest, 0, 0 )
}


void function ClientCallback_QuestStartedAcknowledged( entity player, int guid )
{
	if ( !IsValidItemFlavorGUID( guid ) )
		return
	ItemFlavor quest = GetItemFlavorByGUID( guid )
	if ( ItemFlavor_GetType( quest ) != eItemType.quest )
		return

	RecordHaveStartedQuest( player, quest )
	SetTreasureBoxRewardDisplay( player, quest, 0, 0 )

	Remote_CallFunction_UI( player, FUNCNAME_UpdatePanelData )
}

void function ClientCallback_QuestComicReadAcknowledged( entity player, int guid, int pageIndex )
{
	if ( !IsValidItemFlavorGUID( guid ) )
		return
	ItemFlavor quest = GetItemFlavorByGUID( guid )
	if ( ItemFlavor_GetType( quest ) != eItemType.quest )
		return

	int pagesUnlocked = SeasonQuest_GetComicPagesUnlockedByPlayer( player, quest )
	if ( pageIndex >= pagesUnlocked )
		return

	SeasonQuest_RecordNewComicPageReadByPlayer( player, quest, pageIndex )
	Remote_CallFunction_UI( player, FUNCNAME_UpdatePanelData )
}

void function ClientCallback_QuestMissionReadAcknowledged( entity player, int guid, int missionIndex )
{
	if ( !IsValidItemFlavorGUID( guid ) )
		return
	ItemFlavor quest = GetItemFlavorByGUID( guid )
	if ( ItemFlavor_GetType( quest ) != eItemType.quest )
		return

	int missionsUnlocked = SeasonQuest_GetMissionsMaxCount( quest )
	if ( missionIndex >= missionsUnlocked )
		return

	SeasonQuest_RecordNewMissionSuccessForPlayerIfAllowed( player, quest, missionIndex )
	Remote_CallFunction_UI( player, FUNCNAME_UpdatePanelData )
}

void function ClientCallback_QueueRadioPlayRewardGranting( entity player  )
{
	GivePlayerAnyPendingRadioPlayRewards( player )
}

