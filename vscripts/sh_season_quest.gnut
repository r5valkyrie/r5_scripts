int function SeasonQuest_GetComicPagesReadByPlayer( entity player, ItemFlavor quest )
{
	int forcedPagesRead = -1 // GetConVarInt( "seasonquest_force_pages_read_count" ) // for this to work, the convar need to be added in code.
	if ( forcedPagesRead >= 0 )
	{
		int countMax = SeasonQuest_GetComicPagesMaxCount( quest )
		return minint( forcedPagesRead, countMax )
	}

	return player.GetPersistentVarAsInt( BuildPersistentVarName( quest, VARNAME_comicPagesRead ) ) //VARNAME_missionProgress
}


int function SeasonQuest_GetComicPagesUnlockedByPlayer( entity player, ItemFlavor quest )
{
	int pageCount = SeasonQuest_GetComicPagesMaxCount( quest )
	for( int index = 0; index < pageCount; index++ )
	{
                          
		if ( SeasonQuest_GetStatusForComicPageIndex( player, quest, index ) < eQuestMissionStatus.UNLOCKED_BUT_NOT_NEXT )
     
                                                                                                     
      
			return index
	}
	return pageCount
}


int function SeasonQuest_GetMissionsCompletedForPlayer( entity player, ItemFlavor quest )
{
	int forcedMissionsCleared = GetConVarInt( "seasonquest_force_missionscleared_count" )
	if ( forcedMissionsCleared >= 0 )
	{
		int countMax = SeasonQuest_GetMissionsMaxCount( quest )
		return minint( forcedMissionsCleared, countMax )
	}

	return player.GetPersistentVarAsInt( BuildPersistentVarName( quest, VARNAME_missionProgress ) )
}

#if SERVER
bool function SeasonQuest_RecordNewComicPageReadByPlayer( entity player, ItemFlavor quest, int index )
{
	int comicPagesRead = (index + 1)
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_comicPagesRead ), comicPagesRead )

	if ( comicPagesRead >= SeasonQuest_GetComicPagesMaxCount( quest ) )
	{
		ForcePlayerGRXUpdate( player )
	}

	return true
}
#endif // SERVER

#if SERVER
bool function SeasonQuest_RecordNewMissionSuccessForPlayerIfAllowed( entity player, ItemFlavor quest, int missionIndex )
{
	int status = SeasonQuest_GetStatusForMissionIndex( player, quest, missionIndex )
	if ( status != eQuestMissionStatus.LAUNCHABLE )
	{
		printf( "%s() - Not recording '%s' success for '%s' mission #%d. Mission status is '%s'.", FUNC_NAME(), string( player ), string(ItemFlavor_GetAsset( quest )), missionIndex, GetNameForEnum( eQuestMissionStatus, status ) )
		return false
	}

	int missionsCompletedCount = (missionIndex + 1)
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_missionProgress ), missionsCompletedCount )
	return true
}
#endif // SERVER

#if SERVER
void function SeasonQuest_TreasurePackTimerFix( entity player ) //This was a defensive fix for a production issue with test_FakeTimeDays being set in the live environment
{
	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null  )
		return

	expect ItemFlavor( quest )

	int treasurePackPickupTime = SeasonQuest_GetTreasurePacksLatestPickupTimeForPlayer( player, quest )
	int currentTime = GetUnixTimestamp()

	if ( currentTime > treasurePackPickupTime  )
		return

	//Now that we are here: we are in an unusual case where we have picked up a treasure pack in a future time. This is probably an issue with fake_time_days stuff, so just reset the last time we picekd up a treasure pack.

	Warning( "%s() - Current treasure pack pickup time is from the future, so resetting for player: %s.", FUNC_NAME(), string( player ) )

	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_lastPickupTime ), 0 )
}
#endif

