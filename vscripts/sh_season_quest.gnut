#if SERVER
void function ResetQuestPersistence()
{
	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	expect ItemFlavor( quest )

	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_lastPickupTime ), 0 )
	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_totalPickups ), 0 )
	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_displayStartNum ), 0 )
	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_displayCount ), 0 )
	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_missionProgress ), 0 )
	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_lastMissionUnlockTime ), 0 )

	GP().SetPersistentVar( BuildPersistentVarName( quest, VARNAME_comicPagesRead ), 0 )
}
#endif // SERVER

#if SERVER
void function RegisterDevCommands()
{
	AddClientCommandCallbackVoid( CMD_GIVETREASUREBOX_1, void function ( entity player, array<string> args ) // dev
	{
		TreasureBox_Dev_GrantTreasureBoxPickupsTo( player, 1 )
	} )

	AddClientCommandCallbackVoid( CMD_GIVETREASUREBOX_5, void function ( entity player, array<string> args ) // dev
	{
		TreasureBox_Dev_GrantTreasureBoxPickupsTo( player, 5 )
	} )

	AddClientCommandCallbackVoid( CMD_FINISHMISSION, void function ( entity player, array<string> args ) // dev
	{
		ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
		if ( quest == null )
		{
			Warning( "No season quest is active at this time." )
			return
		}
		expect ItemFlavor( quest )

		int missionsDone     = SeasonQuest_GetMissionsCompletedForPlayer( player, quest )
		int missionsTotalMax = SeasonQuest_GetMissionsMaxCount( quest )
		if ( missionsDone >= missionsTotalMax )
			return

		SeasonQuest_RecordNewMissionSuccessForPlayerIfAllowed( player, quest, missionsDone )
		GivePlayerAnyPendingMissionRewards( player )
	} )
}

void function TreasureBox_Dev_GrantTreasureBoxPickupsTo( entity player, int count )
{
	if ( !GRX_IsInventoryReady( player ) )
		return

	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null )
		return
	expect ItemFlavor( quest )

	int packsNow          = SeasonQuest_GetTreasurePacksCountForPlayer( player, quest )
	int earnedPacksNow    = SeasonQuest_GetEarnedTreasurePacksCountForPlayer( player, quest )
	int purchasedPacksNow = SeasonQuest_GetPurchasedTreasurePacksCountForPlayer( player, quest )
	int packsMax          = SeasonQuest_GetTreasurePacksMaxCount( quest )
	int goalNum           = minint( (earnedPacksNow + count), packsMax - purchasedPacksNow )
	for ( int num = earnedPacksNow; num < goalNum; ++num )
		SeasonQuest_RecordNewTreasureBoxItemPickupForPlayer( player, quest )
	GivePlayerAnyPendingTreasureBoxRewards( player )
}

void function GenerateSeasonQuest_PDef()
{
	// Quest itemflavors:
	{
		array<string> questRefs = []
		array<string> questComments = []
		foreach ( ItemFlavor questFlav in GetAllItemFlavorsOfType( eItemType.quest ) )
		{
			questRefs.append( ItemFlavor_GetGUIDString( questFlav ) )
			questComments.append( string(ItemFlavor_GetAsset( questFlav )) )
		}
		DEV_PDefGen_AddEnum( "eQuestFlavor", questRefs, "All season quests.", questComments )
	}

	DEV_PDefGen_BeginStruct( "sSeasonQuestData", "Data for season quests." )
	DEV_PDefGen_AddField_Int( VARNAME_TB_lastPickupTime )
	DEV_PDefGen_AddField_Int( VARNAME_TB_totalPickups )
	DEV_PDefGen_AddField_Int( VARNAME_TB_displayStartNum )
	DEV_PDefGen_AddField_Int( VARNAME_TB_displayCount )
	DEV_PDefGen_AddField_Bool( VARNAME_CP_displayFinalRewards )
	DEV_PDefGen_AddField_Int( VARNAME_missionProgress )
	DEV_PDefGen_AddField_Int( VARNAME_TB_lastSeenPurchased )
	DEV_PDefGen_AddField_Int( VARNAME_lastMissionUnlockTime )

	DEV_PDefGen_AddField_Int( VARNAME_comicPagesRead )
	DEV_PDefGen_AddField_Bool( VARNAME_haveStartedQuest )

	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "Season Quest Vars" )
	DEV_PDefGen_AddField_StructArray_EnumKey( "sSeasonQuestData", "questDatas", "eQuestFlavor" )
	//
	{
		array<string> mtxSeqVars
		foreach ( ItemFlavor questFlav in GetAllItemFlavorsOfType( eItemType.quest ) )
		{
			var settingsBlock = ItemFlavor_GetSettingsBlock( questFlav )
			AddToArrayIfUnique( mtxSeqVars, GetSettingsBlockString( settingsBlock, "treasurePacksSequenceMarketplaceVar" ) )
			AddToArrayIfUnique( mtxSeqVars, GetSettingsBlockString( settingsBlock, "missionRewardsSequenceMarketplaceVar" ) )
			AddToArrayIfUnique( mtxSeqVars, GetSettingsBlockString( settingsBlock, "comicPageRewardsSequenceMarketplaceVar" ) )
		}
		foreach ( mtxSeqVar in mtxSeqVars )
			DEV_PDefGen_AddField_Int( mtxSeqVar )
	}
	DEV_PDefGen_EndFieldGroup()
}

void function AddToArrayIfUnique( array<string> arr, string newVal )
{
	if ( arr.contains( newVal ) || newVal == "" )
		return
	arr.append( newVal )
}
#endif // SERVER
#endif // DEVELOPER

#if CLIENT
string function SeasonQuest_GetCurrentPackCountDesc()
{
	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null )
		return ""
	expect ItemFlavor( quest )

	entity player = GetLocalClientPlayer()
	int packsHave = SeasonQuest_GetTreasurePacksCountForPlayer( player, quest )
	int packsMax = SeasonQuest_GetTreasurePacksMaxCount( quest )
	return Localize( "#QUEST_MAP_INFOBOX_XOFY", packsHave, packsMax )
}

void function SeasonQuest_UpdateMinimapRui( var rui )
{
	//Defensive fix for R5DEV-205227
	if ( !IsConnected() )
		return

	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null )
	{
		RuiSetBool( rui, "shouldDraw", false )
		return
	}
	expect ItemFlavor( quest )

	RuiSetBool( rui, "shouldDraw", true )
	RuiSetString( rui, "headerText", Localize( "#QUEST_MAP_INFOBOX_TITLE" ) )

	entity player = GetLocalClientPlayer()
	int packsHave = SeasonQuest_GetTreasurePacksCountForPlayer( player, quest )
	int packsMax = SeasonQuest_GetTreasurePacksMaxCount( quest )
	if ( packsHave >= packsMax )
	{
		RuiSetString( rui, "detailsText", Localize( "#QUEST_MAP_INFOBOX_HAVEALL" ) )
		RuiSetString( rui, "timerText", Localize( "#QUEST_MAP_INFOBOX_XOFY", packsHave, packsMax ) )
		return
	}

	int seconds = TreasureBox_SecondsUntilNextPickup( player, quest )
	if ( seconds > 0 )
	{
		RuiSetString( rui, "detailsText", Localize( "#QUEST_MAP_INFOBOX_HAVECOOLDOWN" ) )
		RuiSetString( rui, "timerText", TreasureBox_GetCooldownDesc( player, quest ) )
		return
	}

	RuiSetString( rui, "detailsText", Localize( "#QUEST_MAP_INFOBOX_NEEDONE" ) )
	RuiSetString( rui, "timerText", Localize( "#QUEST_MAP_INFOBOX_XOFY", packsHave, packsMax ) )
}

void function SCB_DoGotTreasurePackNotify()
{
	// Notify
	{
		AnnouncementData announcement = Announcement_Create( "" )
		Announcement_SetStyle( announcement, ANNOUNCEMENT_STYLE_GOT_TREASURE_PACK )
		Announcement_SetPurge( announcement, true )
		Announcement_SetOptionalTextArgsArray( announcement, [Localize("#TREASUREPACK_COLLECTED_NOTIFY"), SeasonQuest_GetCurrentPackCountDesc() ] )
		Announcement_SetPriority( announcement, 200 )
		Announcement_SetSoundAlias( announcement, "Season51_loot_pickup_TreasurePack" )
		announcement.duration = 4.0
		AnnouncementFromClass( GetLocalViewPlayer(), announcement )
	}
}
#endif // CLIENT

#if UI
void function PopulateRewardButtonWithArtifact( var rewardButton, ItemFlavor quest, int missionIndex, bool isOwned )
{
	var btnRui
	if ( rewardButton != null )
		btnRui = Hud_GetRui( rewardButton )

	Assert( btnRui != null )

	RuiSetBool( btnRui, "isOwned", isOwned )
	RuiSetInt( btnRui, "rarity", eRarityTier.EPIC )

	asset rewardImage = SeasonQuest_GetQuestItemIconForMissionIndex( quest, missionIndex )
	if ( !isOwned && SHOW_UNKNOWN_ARTIFACTS  )
		rewardImage = $"rui/menu/quest/artifact_unknown"

	RuiSetImage( btnRui, "buttonImage", rewardImage )
}
#endif // UI

