#if SERVER
void function SeasonQuest_RecordNewTreasureBoxItemPickupForPlayer( entity player, ItemFlavor quest )
{
	int timeNow = GetUnixTimestamp()
	int oldVal  = SeasonQuest_GetEarnedTreasurePacksCountForPlayer( player, quest )
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_totalPickups ), (oldVal + 1) )
	player.SetPersistentVar( BuildPersistentVarName( quest, VARNAME_TB_lastPickupTime ), timeNow )

	Newness_MarkItemFlavorsAsNewForPlayer( player, [quest] )
}
#endif // SERVER

