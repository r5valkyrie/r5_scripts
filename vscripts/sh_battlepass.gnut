#if SERVER || CLIENT || UI
int function GetPlayerBattlePassPurchasedLevels( EHI playerEHI, ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	#if CLIENT || UI
		Assert( playerEHI == LocalClientEHI() )
	#endif

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return 0
	#endif

	ItemFlavor xpPurchaseFlav = BattlePass_GetXPPurchaseFlav( pass )

	int numPurchasedLevels = GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( xpPurchaseFlav ) )

	numPurchasedLevels += GetPlayerBattlePassPurchasedLevelsWithLegendTokens( playerEHI, pass )

	return numPurchasedLevels
}
#endif

#if SERVER || CLIENT || UI
int function GetPlayerBattlePassPurchasedLevelsWithLegendTokens( EHI playerEHI, ItemFlavor pass )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	#if CLIENT || UI
		Assert( playerEHI == LocalClientEHI() )
	#endif

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return 0
	#endif

	// "bubblePurchaseFlav" setting may not exist in battle pass assets
	try
	{
		if ( GetGlobalSettingsAsset( ItemFlavor_GetAsset( pass ), "bubblePurchaseFlav" ) == $"" )
			return 0
	}
	catch ( ex )
	{
		return 0
	}

	ItemFlavor xpPurchaseLegendTokenFlav = BattlePass_GetXPPurchaseLegendTokenFlav( pass )

	int numPurchasedLevels = GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( xpPurchaseLegendTokenFlav ) )

	return numPurchasedLevels
}
#endif


#if SERVER
float function GetPlayerBattlePassBoost( entity player )
{
	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return 1.0
	#endif

	ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
	if ( activeBattlePass == null )
		return 1.0
	expect ItemFlavor( activeBattlePass )

	ItemFlavor xpBoostFlav = BattlePass_GetXPBoostFlav( activeBattlePass )
	int boostCount = 0
	array<entity> partyPlayers = GetPlayersInParty( player )
	foreach( entity _player in partyPlayers )
		boostCount += GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( xpBoostFlav ) )

	return 1.0 + (boostCount * BATTLEPASS_XP_BOOST_AMOUNT)
}
#endif


#if SERVER || CLIENT || UI
int function GetTotalXPToCompletePassLevel( ItemFlavor pass, int levelIndex )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )

	Assert( levelIndex >= -1 )
	if ( levelIndex == -1 )
		return 0

	BattlePassData passData = fileLevel.battlePassMap[pass]

	Assert( levelIndex < passData.totalXPToCompleteLevel.len() )
	return passData.totalXPToCompleteLevel[levelIndex]
}


int function GetBattlePassLevelForXP( ItemFlavor pass, int xp )
{
	Assert( ItemFlavor_GetType( pass ) == eItemType.battlepass )
	Assert( xp >= 0, "XP " + xp + " too low" )
	int levelIndex          = 0
	BattlePassData passData = fileLevel.battlePassMap[pass]
	for ( ; levelIndex < passData.totalXPToCompleteLevel.len(); levelIndex ++ )
	{
		if ( xp < passData.totalXPToCompleteLevel[levelIndex] )
			return levelIndex
	}

	return levelIndex
	/*

		Assert( xp >= 0, "XP is negative!?!?" )

		var scheduleDT         = BattlePass_GetScheduleDatatable( pass )
		int maxLevel           = GetDataTableRowCount( scheduleDT )
		int levelXPColumnIndex = GetDataTableColumnByName( scheduleDT, "xpPerLevel" )
		int levelColumnIndex   = GetDataTableColumnByName( scheduleDT, "levelIndex" )
		Assert( levelXPColumnIndex != -1, "Missing datatable column: levelXP" )
		int xpNeededForLevel = 0
		// todo(dw): make this not iterate through all levels

		int levelIndex = 0
		for ( ; levelIndex < maxLevel; levelIndex++ )
		{
			if ( xp <= xpNeededForLevel )
			{
				Assert( levelIndex == GetDataTableInt( scheduleDT, levelIndex - 1, levelColumnIndex ) )
				return levelIndex
			}

			xpNeededForLevel += GetDataTableInt( scheduleDT, levelIndex - 1, levelXPColumnIndex )

			// todo(dw): temp to workaround too much XP being given
			if ( levelIndex == maxLevel )
				return levelIndex
		}
		//Assert( false, "XP too high" ) // todo(dw): temp
		unreachable
	*/
}

int function GetBattlePassMaxLevelIndex( ItemFlavor pass )
{
	BattlePassData passData = fileLevel.battlePassMap[pass]
	return passData.maxPassLevel
}


int function GetBattlePassMaxPurchaseLevels( ItemFlavor pass )
{
	BattlePassData passData = fileLevel.battlePassMap[pass]
	return passData.maxPurchaseLevels
}

