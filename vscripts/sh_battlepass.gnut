#if SERVER
void function InitBattlePassXP( entity player )
{
	//Assert( !IsLobby(), "Don't call InitBattlePassXP in mp_lobby!" )	// Should not call InitXP in mp_lobby because we want to view our old xp progress in the game summary menu until we play another match

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	//ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
	//if ( activeBattlePass == null )
	//	return
	//
	//expect ItemFlavor(activeBattlePass)

	array<string> battlePassGuids = GetPersistenceEnumAsArray( "eBattlePass" )
	foreach ( guid in battlePassGuids )
	{
		string pdefPreviousXpKey = format( "battlePasses[%s].previousEarnedXP", guid )
		string pdefXpKey         = format( "battlePasses[%s].earnedXP", guid )
		int currentXP            = player.GetPersistentVarAsInt( pdefXpKey )
		player.SetPersistentVar( pdefPreviousXpKey, currentXP )
	}

	thread ClearPostGameChallengeDataThread( player )
}
#endif

