#if SERVER && DEVELOPER
void function GenerateBattlePassPDef()
{
	array<string> allBattlePassRefs = []
	array<string> allBattlePassComments = []
	foreach( ItemFlavor bp in GetAllItemFlavorsOfType( eItemType.battlepass ) )
	{
		allBattlePassRefs.append( ItemFlavor_GetGUIDString( bp ) )
		allBattlePassComments.append( string(ItemFlavor_GetAsset( bp )) )
	}
	DEV_PDefGen_AddEnum( "eBattlePass", allBattlePassRefs, "All the battle pass flavor refs.", allBattlePassComments )
	// The data to save per-battlepass
	DEV_PDefGen_BeginStruct( "sBattlePassData", "The data to save per-battlepass" )
	DEV_PDefGen_AddField_Bool( "lastSeenPremiumState" )
	DEV_PDefGen_AddField_Bool( "lastSeenEliteState" )
	DEV_PDefGen_AddField_Int( "earnedXP" )
	DEV_PDefGen_AddField_Int( "previousEarnedXP" )
	DEV_PDefGen_AddField_Int( "cachedPurchasedXP" )
	DEV_PDefGen_AddField_Int( "grxFreeRewardSeq" )
	DEV_PDefGen_AddField_Int( "grxPremiumRewardSeq" )
	DEV_PDefGen_AddField_Int( "grxEaAccessPremium" )
	DEV_PDefGen_AddField_Int( "lastSeenEarnedXP" )
	DEV_PDefGen_AddField_Int( "lastSeenPurchasedXP" )
	DEV_PDefGen_AddField_Int( "lastPopupLevel" )
	DEV_PDefGen_AddField_Int( "lastSeenMilestone" )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "battle pass data" )
	DEV_PDefGen_AddField_StructArray_EnumKey( "sBattlePassData", "battlePasses", "eBattlePass" )
	DEV_PDefGen_EndFieldGroup()
}
#endif


#if SERVER || CLIENT || UI
int function GetPlayerBattlePassPurchasableLevels( EHI playerEHI, ItemFlavor pass )
{
	int currentLevel      = GetPlayerBattlePassLevel( FromEHI( playerEHI ), pass, false )
	int purchasableLevels = fileLevel.battlePassMap[pass].maxPurchaseLevels - GetPlayerBattlePassPurchasedLevels( playerEHI, pass )

	return maxint( minint( purchasableLevels, fileLevel.battlePassMap[pass].maxPurchaseLevels - currentLevel ), 0 )
}
#endif

#if SERVER || CLIENT || UI
int function GetPlayerBattlePassPurchasableLevelsWithLegendTokens( EHI playerEHI, ItemFlavor pass )
{
	return maxint( minint( GetPlayerBattlePassPurchasableLevels( playerEHI, pass ), GetPlayerBattlePassUnpurchasedLevelsWithLegendTokens( playerEHI, pass ) ), 0 )
}
#endif

#if SERVER || CLIENT || UI
int function GetPlayerBattlePassUnpurchasedLevelsWithLegendTokens( EHI playerEHI, ItemFlavor pass )
{
	if ( !IsPurchasingBattlePassLevelsWithLegendTokensEnabled() )
		return 0

	return maxint( GetMaxBattlePassLevelsWithLegendTokens() - GetPlayerBattlePassPurchasedLevelsWithLegendTokens( playerEHI, pass ), 0 )
}
#endif

string function GetBattlePassDisplayLevel( int levelIndex, bool showBonus = false )
{
	if ( levelIndex > 99 && showBonus )
		return "#BATTLE_PASS_BONUS"

	// Because of the way battlepass xp progress was setup, if you are below the xp needed for 110 and earn a lot of xp at once, you can end up 111 or higher.
	// TODO: Ideally we would not award more xp beyond what gets you to 110, but that change is too risky at the moment.
	int displayVal = levelIndex + 1
	if ( displayVal > BATTLEPASS_MAX_LEVEL )
		displayVal = BATTLEPASS_MAX_LEVEL

	return string( displayVal )
}


asset function GetBattlePassDisplayBadge( int levelIndex )
{
	asset badgeImage
	int adjustedLevel = levelIndex + 1
	if ( adjustedLevel < 5 )
		badgeImage = $"rui/gladiator_cards/badges/account_t1"
	else if ( adjustedLevel < 10 )
		badgeImage = $"rui/gladiator_cards/badges/account_t2"
	else if ( adjustedLevel < 15 )
		badgeImage = $"rui/gladiator_cards/badges/account_t3"
	else if ( adjustedLevel < 20 )
		badgeImage = $"rui/gladiator_cards/badges/account_t4"
	else if ( adjustedLevel < 25 )
		badgeImage = $"rui/gladiator_cards/badges/account_t5"
	else if ( adjustedLevel < 30 )
		badgeImage = $"rui/gladiator_cards/badges/account_t6"
	else if ( adjustedLevel < 35 )
		badgeImage = $"rui/gladiator_cards/badges/account_t7"
	else if ( adjustedLevel < 40 )
		badgeImage = $"rui/gladiator_cards/badges/account_t8"
	else if ( adjustedLevel < 45 )
		badgeImage = $"rui/gladiator_cards/badges/account_t9"
	else if ( adjustedLevel < 50 )
		badgeImage = $"rui/gladiator_cards/badges/account_t10"
	else if ( adjustedLevel < 55 )
		badgeImage = $"rui/gladiator_cards/badges/account_t11"
	else if ( adjustedLevel < 60 )
		badgeImage = $"rui/gladiator_cards/badges/account_t12"
	else if ( adjustedLevel < 65 )
		badgeImage = $"rui/gladiator_cards/badges/account_t13"
	else if ( adjustedLevel < 70 )
		badgeImage = $"rui/gladiator_cards/badges/account_t14"
	else if ( adjustedLevel < 75 )
		badgeImage = $"rui/gladiator_cards/badges/account_t15"
	else if ( adjustedLevel < 80 )
		badgeImage = $"rui/gladiator_cards/badges/account_t16"
	else if ( adjustedLevel < 85 )
		badgeImage = $"rui/gladiator_cards/badges/account_t17"
	else if ( adjustedLevel < 90 )
		badgeImage = $"rui/gladiator_cards/badges/account_t18"
	else if ( adjustedLevel < 95 )
		badgeImage = $"rui/gladiator_cards/badges/account_t19"
	else if ( adjustedLevel < 100 )
		badgeImage = $"rui/gladiator_cards/badges/account_t20"
	else
		badgeImage = $"rui/gladiator_cards/badges/account_t21"

	return badgeImage
}


#if SERVER
void function ClientCallback_UpdateBattlePassLastInfo( entity player, int assetGuid  )
{
	if ( IsValid( player ) == false )
		return

	ItemFlavor ornull bpFlav = GetItemFlavorOrNullByGUID( assetGuid, eItemType.battlepass )
	if ( bpFlav == null )
		return

	if ( GRX_IsInventoryReady( player ) == false )
		return

	expect ItemFlavor( bpFlav )

	string baseString = format( "battlePasses[%s]", ItemFlavor_GetGUIDString( bpFlav ) )
	player.SetPersistentVar( baseString + ".lastSeenPurchasedXP", GetPlayerBattlePassPurchasedXP( ToEHI( player ), bpFlav ) )
	player.SetPersistentVar( baseString + ".lastSeenEarnedXP", player.GetPersistentVarAsInt( baseString + ".earnedXP" ) )
	player.SetPersistentVar( baseString + ".lastSeenPremiumState", DoesPlayerOwnBattlePass( player, bpFlav ) )
	player.SetPersistentVar( baseString + ".lastSeenEliteState", DoesPlayerOwnEliteBattlePass( player, bpFlav ) )
}
#endif


#if SERVER && DEVELOPER
void function DEV_ResetBattlePasses( entity player )
{
	foreach ( ItemFlavor battlePass in fileLevel.battlePassList )
	{
		int battlePassLevelsCompleteCount = GetPlayerBattlePassLevel( player, battlePass, false )
		string baseString                 = format( "battlePasses[%s]", ItemFlavor_GetGUIDString( battlePass ) )

		player.SetPersistentVar( baseString + ".earnedXP", 0 )
		player.SetPersistentVar( baseString + ".previousEarnedXP", 0 )
		player.SetPersistentVar( baseString + ".cachedPurchasedXP", 0 )
		player.SetPersistentVar( baseString + ".grxFreeRewardSeq", 0 )
		player.SetPersistentVar( baseString + ".grxPremiumRewardSeq", 0 )
		player.SetPersistentVar( baseString + ".lastSeenEarnedXP", 0 )
		player.SetPersistentVar( baseString + ".lastSeenPurchasedXP", 0 )
	}
}
#endif


#if SERVER || UI
bool function CanPlayerPurchaseBattlePass( entity player, ItemFlavor activeBattlePass )
{
	if ( DoesPlayerOwnBattlePass( player, activeBattlePass ) )
	{
		printt("CanPlayerPurchaseBattlePass - returning false because player already owns battlepass" + ItemFlavor_GetAsset( activeBattlePass ))
		return false
	}

	// unopened battlepass pack
	#if UI
		if ( GRX_GetPackCount( ItemFlavor_GetGRXIndex( BattlePass_GetBasicPurchasePack( activeBattlePass ) ) ) != 0 )
		{
			printt("CanPlayerPurchaseBattlePass - returning false because for battlepass" + string(ItemFlavor_GetAsset( activeBattlePass )) + "and GRX_GetPackCount( ItemFlavor_GetGRXIndex( BattlePass_GetBasicPurchasePack( activeBattlePass ) ) ) != 0")
			return false
		}
		if ( GRX_GetPackCount( ItemFlavor_GetGRXIndex( BattlePass_GetBundlePurchasePack( activeBattlePass ) ) ) != 0 )
		{
			printt("CanPlayerPurchaseBattlePass - returning false because for battlepass" + string(ItemFlavor_GetAsset( activeBattlePass )) + "and GRX_GetPackCount( ItemFlavor_GetGRXIndex( BattlePass_GetBundlePurchasePack( activeBattlePass ) ) ) != 0")
			return false
		}
	#endif
	//#else
	//	// todo(dw)
	//#endif

	return true
}
#endif

#if UI
GRXScriptOffer ornull function GetCurrentLegendToken_GRXScriptOffer( ItemFlavor pass )
{
	ItemFlavor xpPurchaseLegendTokenFlav = BattlePass_GetXPPurchaseLegendTokenFlav( pass )
	array<GRXScriptOffer> xpPurchaseLegendTokenOffers = GRX_GetItemDedicatedStoreOffers( xpPurchaseLegendTokenFlav, "battlepass" )

	//if there's more than 1 BP Legend Token flav offer, will need to add a way to select a specific offer from array, (bubble up a single-item offer to the front of the array)
	Assert(xpPurchaseLegendTokenOffers.len() == 1)

	GRXScriptOffer legendTokenOffer
	if ( xpPurchaseLegendTokenOffers.len() < 1 )
	{
		Warning( "No offer for xp purchase legend token for '%s'", string(ItemFlavor_GetAsset( pass )) )
		return null
	}

	return xpPurchaseLegendTokenOffers[0]
}
#endif
#if SERVER || CLIENT || UI
bool function CanPlayerPurchaseBattlePassLevelsWithLegendTokens( entity player, ItemFlavor pass )
{
	if ( !IsPurchasingBattlePassLevelsWithLegendTokensEnabled() )
	{
		printt("CanPlayerPurchaseBattlePassLevelsWithLegendTokens - returning false because battle pass level purchase with legend tokens is not enabled")
		return false
	}

	if ( !IsCurrentlyWithinTimeframeToPurchaseBattlePassLevelsWithLegendTokens() )
	{
		printt("CanPlayerPurchaseBattlePassLevelsWithLegendTokens - returning false because for battlepass " + string(ItemFlavor_GetAsset( pass )) + " player is outside the valid timeframe to purchase levels with legend tokens")
		return false
	}

	if ( !IsPlayerLeveledToPurchaseBattlePassLevelsWithLegendTokens( player, pass ) )
	{
		printt("CanPlayerPurchaseBattlePassLevelsWithLegendTokens - returning false because player's current battlepass level is below the minimum requirement to purchase levels with legend tokens")
		return false
	}

	#if UI
		GRXScriptOffer ornull offerOrNull = GetCurrentLegendToken_GRXScriptOffer( pass )
		if ( offerOrNull == null)
		{
			printt("CanPlayerPurchaseBattlePassLevelsWithLegendTokens - returning false because BP Level Legend Token GRXScriptOffer returned null")
			return false
		}

		GRXScriptOffer offer = expect GRXScriptOffer(offerOrNull)
		if ( GRXOffer_IsPurchaseLimitReached( offer ) )
		{
			printt("CanPlayerPurchaseBattlePassLevelsWithLegendTokens - returning false because player has reached the purchase limit for the current legend token GRXScriptOffer")
			return false
		}
	#endif //UI
	return true
}
#endif //SERVER || CLIENT || UI

#if SERVER || CLIENT || UI
int function GetCurrentBattlePassWeek()
{
	int currentTime                = GetUnixTimestamp()
	ItemFlavor ornull activeSeason = GetActiveSeason( currentTime )
	if ( activeSeason == null )
		return 0

	expect ItemFlavor( activeSeason )
	int seasonStartUnixTime  = CalEvent_GetStartUnixTime( activeSeason )
	int seasonFinishUnixTime = CalEvent_GetFinishUnixTime( activeSeason )

	if ( currentTime < seasonStartUnixTime || currentTime > seasonFinishUnixTime )
		return 0

	return ((currentTime - seasonStartUnixTime) / SECONDS_PER_WEEK) + 1
}
#endif


#if SERVER || CLIENT || UI
int function GetCurrentBattlePassWeekExpirationTime()
{
	int currentTime                = GetUnixTimestamp()
	ItemFlavor ornull activeSeason = GetActiveSeason( currentTime )
	if ( activeSeason == null )
		return 0

	expect ItemFlavor( activeSeason )
	int seasonStartUnixTime  = CalEvent_GetStartUnixTime( activeSeason )
	int seasonFinishUnixTime = CalEvent_GetFinishUnixTime( activeSeason )

	if ( currentTime < seasonStartUnixTime || currentTime > seasonFinishUnixTime )
		return 0


	int expireTime = seasonStartUnixTime
	while( expireTime <= currentTime )
		expireTime += SECONDS_PER_WEEK

	if ( expireTime > seasonFinishUnixTime )
		return seasonFinishUnixTime

	return expireTime
}
#endif


