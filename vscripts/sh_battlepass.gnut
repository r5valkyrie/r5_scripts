#if SERVER
void function AddPlayerBattlePassXP( entity player, int xpToAdd )
{
	if ( !IsBattlePassEnabled() )
		return

	ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
	if ( activeBattlePass == null )
		return
	expect ItemFlavor(activeBattlePass)

	int currentXPProgress = GetPlayerBattlePassXPProgress( ToEHI( player ), activeBattlePass, false )
	int currentLevel      = GetBattlePassLevelForXP( activeBattlePass, currentXPProgress )

	if ( currentLevel > GetBattlePassMaxLevelIndex( activeBattlePass ) )
		return

	if ( xpToAdd == 0 )
		return

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	{
		string pdefKey = format( "battlePasses[%s].earnedXP", ItemFlavor_GetGUIDString( activeBattlePass ) )
		int currentXP  = player.GetPersistentVarAsInt( pdefKey )
		player.SetPersistentVar( pdefKey, currentXP + ( xpToAdd ) )
	}

	int xpType = eXPType.CHALLENGE_COMPLETED
	PIN_XPBonus( player, xpType, ( xpToAdd ), true )

	int newLevel = GetBattlePassLevelForXP( activeBattlePass, GetPlayerBattlePassXPProgress( ToEHI( player ), activeBattlePass, false ) )
	if ( newLevel > currentLevel )
	{
		PIN_PlayerLeveledUp( player, currentLevel, newLevel, true )
		StatsHook_UpdateCachedBattlePassLevelStats( player )
	}
}
#endif

#if SERVER
void function AddPlayerBattlePassLevels( entity player, int numLevelsToAdd )
{
	if ( !IsBattlePassEnabled() )
		return

	ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
	if ( activeBattlePass == null )
		return
	expect ItemFlavor(activeBattlePass)

	int xpPerLevel        = GetXPToCompleteBPLevel()
	int currentXPProgress = GetPlayerBattlePassXPProgress( ToEHI( player ), activeBattlePass, false )
	int currentLevel      = GetBattlePassLevelForXP( activeBattlePass, currentXPProgress )

	if ( currentLevel > GetBattlePassMaxLevelIndex( activeBattlePass ) )
		return

	int totalToCompleteMaxLevel = GetTotalXPToCompletePassLevel( activeBattlePass, GetBattlePassMaxLevelIndex( activeBattlePass ) )
	if ( currentXPProgress + ( numLevelsToAdd * xpPerLevel ) > totalToCompleteMaxLevel )
		numLevelsToAdd = ( totalToCompleteMaxLevel - currentXPProgress ) / xpPerLevel

	if ( ( numLevelsToAdd * xpPerLevel ) == 0 )
		return

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	{
		string pdefKey = format( "battlePasses[%s].earnedXP", ItemFlavor_GetGUIDString( activeBattlePass ) )
		int currentXP  = player.GetPersistentVarAsInt( pdefKey )
		player.SetPersistentVar( pdefKey, currentXP + ( numLevelsToAdd * xpPerLevel ) )
	}

	int xpType = eXPType.CHALLENGE_COMPLETED
	PIN_XPBonus( player, xpType, ( numLevelsToAdd * xpPerLevel ), true )

	int newLevel = GetBattlePassLevelForXP( activeBattlePass, GetPlayerBattlePassXPProgress( ToEHI( player ), activeBattlePass, false ) )
	if ( newLevel > currentLevel )
	{
		PIN_PlayerLeveledUp( player, currentLevel, newLevel, true )
			StatsHook_UpdateCachedBattlePassLevelStats( player )
	}
}
#endif


#if SERVER
int function SortBattlePassesBySeasonDescending( ItemFlavor a, ItemFlavor b )
{
	ItemFlavor seasonA = BattlePass_GetSeason( a )
	ItemFlavor seasonB = BattlePass_GetSeason( b )

	if ( CalEvent_GetStartUnixTime( seasonA ) > CalEvent_GetStartUnixTime( seasonB ) )
		return -1

	if ( CalEvent_GetStartUnixTime( seasonA ) < CalEvent_GetStartUnixTime( seasonB ) )
		return 1

	return 0
}

const int BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL = GRX_HTTPQUERYGOAL_GIVE_BATTLEPASS_SEQUENCE_REWARD
void function GivePlayerBattlePassRewards( entity player )
{
	thread GivePlayerBattlePassRewardsThread( player )
}

table<entity, bool> tbl_givingBattlePassRewards = {}
void function GivePlayerBattlePassRewardsThread( entity player )
{
	EndSignal( player, "OnDestroy" )

	if ( !IsBattlePassEnabled() )
		return

	if ( player in tbl_givingBattlePassRewards && tbl_givingBattlePassRewards[player] )
		return

	OnThreadEnd(
		function() : ( player )
		{
			tbl_givingBattlePassRewards[player] <- false
		}
	)
	tbl_givingBattlePassRewards[player] <- true

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	ItemFlavor ornull lastActivePass
	if ( fileLevel.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	lastActivePass = fileLevel.currentBattlePass

	int pastSeasonsToFix   = GetCurrentPlaylistVarInt( "battlepass_past_season_fixup_count", 2 )
	bool sendPINOnFixup    = GetCurrentPlaylistVarBool( "battlepass_send_pin_on_fixup", true )
	bool doPastSeasonFixup = pastSeasonsToFix > 0

	if ( !fileLevel.sorted )
	{
		fileLevel.battlePassList.sort( SortBattlePassesBySeasonDescending )
		fileLevel.sorted = true
	}

	foreach ( int idx, ItemFlavor battlePass in fileLevel.battlePassList )
	{
		if ( !doPastSeasonFixup && lastActivePass != battlePass )
				continue

		if ( idx > pastSeasonsToFix )
			continue

		// MARKETPLACE NUMBER IS 1-100
		// LEVEL NUMBER IS 0-99
		string freeSequenceName    = format( "battlePasses[%s].grxFreeRewardSeq", ItemFlavor_GetGUIDString( battlePass ) )
		string premiumSequenceName = format( "battlePasses[%s].grxPremiumRewardSeq", ItemFlavor_GetGUIDString( battlePass ) )

		int freeSequenceCheckStartIndex    = GRX_GetSequenceNumber( player, freeSequenceName )
		int premiumSequenceCheckStartIndex = GRX_GetSequenceNumber( player, premiumSequenceName )

                       
                                                                                                                                                                           
                                                                                        
                             

		#if DEVELOPER
			Assert( freeSequenceCheckStartIndex != GRX_INVALID_SEQUENCE_NUMBER && premiumSequenceCheckStartIndex != GRX_INVALID_SEQUENCE_NUMBER, "Battlepass reward sequences are not valid for " + string(ItemFlavor_GetAsset( battlePass )) )
		#endif

		if ( freeSequenceCheckStartIndex == GRX_INVALID_SEQUENCE_NUMBER || premiumSequenceCheckStartIndex == GRX_INVALID_SEQUENCE_NUMBER )
			continue

		// THIS IS A 1-100 number ( 0-99 + 1 ) THAT SHOULD BE IDENTICAL TO MARKETPLACE SEQUENCE
		int battlePassLevelsCompleteCount = GetPlayerBattlePassLevel( player, battlePass, false ) + 1

		if ( lastActivePass != battlePass && freeSequenceCheckStartIndex == battlePassLevelsCompleteCount && premiumSequenceCheckStartIndex == battlePassLevelsCompleteCount )
			continue

		string passGUIDString = ItemFlavor_GetGUIDString( battlePass )

		ItemFlavorBag freeRewards
		int freeRewardIndex = freeSequenceCheckStartIndex
		for ( int rewardIndex = freeSequenceCheckStartIndex; rewardIndex < battlePassLevelsCompleteCount; rewardIndex++ )
		{
			int level                       = rewardIndex
			array<BattlePassReward> rewards = GetBattlePassLevelRewards( battlePass, level, player )

			foreach( BattlePassReward reward in rewards )
			{
				if ( reward.isPremium )
					continue

				Assert( reward.quantity > 0 )

				if ( ItemFlavor_GetGRXMode( reward.flav ) == eItemFlavorGRXMode.NONE )
					continue

				if ( ItemFlavor_IsItemDisabledForGRX( reward.flav ) )
					continue

				if ( ItemFlavor_GetGRXMode( reward.flav ) == GRX_ITEMFLAVORMODE_REGULAR )
				{
					if ( !GRX_IsInventoryReady( player ) )
					{
						WaitTime( 3 ) // approx. 30 frames of wait
					}
					if (!GRX_IsInventoryReady( player ) )
					{
						continue
					}
					if ( GRX_IsItemOwnedByPlayer( reward.flav, player ) )
						continue
				}

				freeRewards.flavors.append( reward.flav )
				freeRewards.quantities.append( reward.quantity )
			}
			freeRewardIndex = rewardIndex
		}

		int freeRewardIndexForGRX = freeRewardIndex + 1 // bump the sequence by one as our *target* val

		//printt( "freeSeq", freeSequenceCheckStartIndex, "->", freeRewardIndex, "for", battlePassLevelsCompleteCount )
		if ( freeRewardIndexForGRX != freeSequenceCheckStartIndex && freeRewards.flavors.len() > 0 )
		{
			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL
			operation.doOperationFunc = (void function( int opID ) : ( player, freeSequenceName, freeSequenceCheckStartIndex, freeRewardIndexForGRX, freeRewards )
			{
				GRX_GiveSequenceRewardEasy( player, opID, BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL, freeSequenceName, freeSequenceCheckStartIndex, freeRewardIndexForGRX, freeRewards )
			})
			operation.onDoneCallback = null
			QueueGRXOperation( player, operation )

			while ( !IsGRXOperationDone( operation ) )
				WaitFrame()

			if ( sendPINOnFixup && lastActivePass != battlePass )
				PIN_BattlepassPriorSeasonReward( player, passGUIDString, false, battlePassLevelsCompleteCount, freeSequenceCheckStartIndex )

			if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
				Warning( "Account Level Rewards operation failed" )
			else
				Newness_MarkItemFlavorsAsNewForPlayer( player, freeRewards.flavors, true )
		}

		if ( !GRX_IsInventoryReady( player ) || !GRX_HasInventoryEverBeenReady( player ) )
			continue

		if ( !GRX_IsItemOwnedByPlayer_AllowOutOfDateData( battlePass, player ) )
			continue

		ItemFlavorBag premiumRewards
		int premiumRewardIndex             = premiumSequenceCheckStartIndex
		for ( int rewardIndex = premiumSequenceCheckStartIndex; rewardIndex < battlePassLevelsCompleteCount; rewardIndex++ )
		{
			int level                       = rewardIndex

			array<BattlePassReward> rewards = GetBattlePassLevelRewards( battlePass, level, player )
			foreach( BattlePassReward reward in rewards )
			{
				if ( !reward.isPremium )
					continue

				Assert( reward.quantity > 0 )

				if ( ItemFlavor_GetGRXMode( reward.flav ) == eItemFlavorGRXMode.NONE )
					continue

				if ( ItemFlavor_IsItemDisabledForGRX( reward.flav ) )
					continue

				if ( ItemFlavor_GetGRXMode( reward.flav ) == GRX_ITEMFLAVORMODE_REGULAR )
				{
					if ( GRX_IsItemOwnedByPlayer( reward.flav, player ) )
						continue
				}

				premiumRewards.flavors.append( reward.flav )
				premiumRewards.quantities.append( reward.quantity )
			}
			premiumRewardIndex = rewardIndex
		}

		if ( premiumRewardIndex != premiumSequenceCheckStartIndex )
			PIN_PlayerLeveledUp( player, premiumSequenceCheckStartIndex, battlePassLevelsCompleteCount, true )

		int premiumRewardIndexForGRX = premiumRewardIndex + 1 // bump the sequence by one as our *target* val

		//printt( "premiumSeq", premiumSequenceCheckStartIndex, "->", premiumRewardIndex, "for", battlePassLevelsCompleteCount )
		if ( premiumRewardIndexForGRX != premiumSequenceCheckStartIndex && premiumRewards.flavors.len() > 0 )
		{
			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL
			operation.doOperationFunc = (void function( int opID ) : ( player, premiumSequenceName, premiumSequenceCheckStartIndex, premiumRewardIndexForGRX, premiumRewards )
			{
				GRX_GiveSequenceRewardEasy( player, opID, BATTLEPASS_REWARD_SEQUENCE_QUERYGOAL, premiumSequenceName, premiumSequenceCheckStartIndex, premiumRewardIndexForGRX, premiumRewards )
			})
			operation.onDoneCallback = (void function( int opID ) : ( player, premiumSequenceName, premiumSequenceCheckStartIndex, premiumRewardIndexForGRX, premiumRewards )
			{
				if ( !(GetCurrentPlaylistVarBool( "has_sv_op_v1_loadouts", true )) )
					ValidateGRXPlayerLoadout( player )
			})
			QueueGRXOperation( player, operation )

			while ( !IsGRXOperationDone( operation ) )
				WaitFrame()

			if ( sendPINOnFixup && lastActivePass != battlePass )
				PIN_BattlepassPriorSeasonReward( player, passGUIDString, true, battlePassLevelsCompleteCount, premiumSequenceCheckStartIndex )

			if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
				Warning( "Account Level Rewards operation failed" )
			else
				Newness_MarkItemFlavorsAsNewForPlayer( player, premiumRewards.flavors, true )
		}

                       
                                             
    
            
    

                                                                            
                                                     
    
            
    

                                                                                     
    
            
    

                                                              
    
            
    

                             
                                                      
                                                                                                         
    
                           
                                                                                                                        
                                                 
     
                                                              
              

                                  

                                                                           
              

                                                          
              

                                                                              
      
                                                           
               
      

                                               
                                                      
     
                                  
    

                                                          
                                                                                                    

                                                                                                    
                                                                                                  
    
                                    
                                                                      
                                                                                                                                                              
     
                                                                                                                                                                            
      
                                                                                                                                                             
     
                                                                           
      
                                        
      
      
                                          

                                              
                

                                                         
                                                                                                                                 

                                                                     
     
                                                        
     
        
     
                                                                                  
     
    
                             
	}
}
