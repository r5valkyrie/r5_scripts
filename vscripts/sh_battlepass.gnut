global struct BattlePassReward
{
	ItemFlavor& flav
	int         quantity
	int         level
	bool        isPremium
	bool        isElite
	bool		isEventReward = false
	string		eventName = ""
	bool 		isOwned = false //jmasse: Used only for RTK, is manually set at a data level
	bool 		isTall = false //jmasse: Used only for RTK, is manually set at a data level
	bool 		isRumble = false
	int			tier = 0

                      
                    
                
                            
}


struct BattlePassData
{
	ItemFlavor& pass
	ItemFlavor& season
	array<int>  totalXPToCompleteLevel
	int         maxPassLevel
	int         maxPurchaseLevels = 99

	table< int, table< int, array<ItemFlavor> > > challenges
	ItemFlavor ornull recurringStarChallenge
	ItemFlavor ornull recurringGrindlordChallenge
}

