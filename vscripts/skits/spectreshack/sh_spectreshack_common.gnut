	RegisterMinimapPackage( "prop_script", eMinimapObject_prop_script.SPECTRE_SHACK, MINIMAP_OBJECT_RUI, MinimapPackage_SpectreShack, FULLMAP_OBJECT_RUI, MinimapPackage_SpectreShack )
