void function SpectreShacks_MapInit()
{
                      
	if( !SpectreShacksAreEnabled() )
		return

	if( !GameMode_IsActive( eGameModes.SURVIVAL ) )
		return

	if( !MapContainsArmories() )
		return

	#if SERVER || CLIENT
		Remote_RegisterClientFunction( "Cl_SpectreShack_OnProximityTriggerEnter", "entity" )
		Remote_RegisterClientFunction( "Cl_SpectreShack_OnProximityTriggerLeave", "entity" )

		if( SpectreShack_PingFromMap_Enabled() )
		{
			Remote_RegisterServerFunction( FUNCNAME_PingArmoryFromMap, "typed_entity", "prop_dynamic" )
			Remote_RegisterClientFunction( FUNCNAME_SetArmoryClientEnt, "entity" )
		}
	#endif
	#if SERVER
		// ...
	#endif
	#if CLIENT
		SpectreShack_Init_Client()

		if( SpectreShack_PingFromMap_Enabled() )
			AddCallback_OnFindFullMapAimEntity( GetSpectreShackUnderAim, PingSpectreShackUnderAim )
	#endif
      
}

void function SpectreShacks_Bootstrap()
{
                      
	if( !SpectreShacksAreEnabled() )
		return

	if( !GameMode_IsActive( eGameModes.SURVIVAL ) )
		return

	if( !MapContainsArmories() )
		return

	#if SERVER || CLIENT
		#if DEVELOPER
			printf( "spectre shacks bootstrap()" )
		#endif
		SpectreShacks_InitGlobalDependencies()
	#endif

	#if SERVER
		AddSpawnCallback_ScriptName( IMC_ARMORY_PANEL_SCRIPTNAME, SpectreShackControl_Init )
		SpectreShack_Init()

		AddCallback_GameStateEnter( eGameState.Playing, SpectreShack_InitClientTrackingEnts )
	#endif
	#if CLIENT
		AddCreateCallback( "prop_dynamic", OnSpectreShackControlCreated )
	#endif // CLIENT

                            
}


#if CLIENT||SERVER
bool function SpectreShack_PingFromMap_Enabled()
{
	return GetCurrentPlaylistVarBool( "spectreshack_pingfrommap_enabled", true )
}
#endif

bool function MapContainsArmories()
{
                      
	string mapName = GetMapName()

	if( mapName.find( "mp_rr_tropic_island" ) > -1 )
		return true
	#if DEVELOPER
	else if( mapName.find( "mp_rr_spectreshack_actionblock_02" ) > -1 )
		return true
	printt( "ARMORIES | map does not contain armories" )
	#endif
      
	return false
}

#if CLIENT
void function OnSpectreShackControlCreated ( entity cp )
{
	if( cp.GetScriptName() != IMC_ARMORY_PANEL_SCRIPTNAME )
		return

	AddCallback_OnUseEntity_ClientServer( cp, OnControlPanelUse_Skit4 )
	SetCallback_CanUseEntityCallback( cp, Armory_ControlPanel_IsNotBusy )
}
#endif // CLIENT

bool function Armory_ControlPanel_IsNotBusy( entity player, entity ent, int useFlags )
{
	if ( !SURVIVAL_PlayerCanUse_AnimatedInteraction( player, ent ) )
		return false

	return true
}

void function SpectreShacks_InitGlobalDependencies()
{
                      
	#if SERVER || CLIENT
		FreelanceNPCs_Init()
		SkitSystem_Init()
	#if SERVER
		NPCGarbageCollection_InitForGameMode()
	#endif
		PrecacheParticleSystem( SPECTRE_SHACK_TELEPORTER_FX )
		PrecacheParticleSystem( HATCH_OPEN_DUST_FX )
		PrecacheParticleSystem( ARMORY_DOOR_DESTRUCTION_FX )
		PrecacheParticleSystem( ARMORY_SMART_SCAN_FX )
		PrecacheParticleSystem( ARMORY_TELEPORTER_3P_FX )
		PrecacheParticleSystem( ARMORY_ELECTRIC_ROOF_FX )
		PrecacheParticleSystem( ARMORY_ELECTRIC_ROOF_CENTER_FX )
		PrecacheParticleSystem( ARMORY_TOP_PRIZE_VFX )
		PrecacheModel( STANDING_SPECTRE_STATIC )
		PrecacheModel( HANGING_SPECTRE_STATIC )
	#endif // SERVER || CLIENT
                            
}

#if SERVER

void function SetupControlPanel(entity cp)
{
	cp.SetUsePrompts( "#PROMPT_ACTIVATE_SPECTRESHACK" , "#PROMPT_ACTIVATE_SPECTRESHACK" )
	cp.SetUsableByGroup ( "pilot" )
	cp.SetUsablePriority( USABLE_PRIORITY_LOW )
	cp.AddUsableValue( USABLE_CUSTOM_HINTS )
}
#endif // SERVER

void function OnControlPanelUse_Skit4( entity cp, entity player, int useInputFlags )
{
	#if CLIENT
		CustomUsePrompt_SetLastUsedTime( Time() )
	#endif
	thread ArmoryControlPanel_LongPress_Thread( cp, player )
}

void function ArmoryControlPanel_LongPress_Thread( entity cp, entity player )
{
	ExtendedUseSettings settings
	settings.duration = 0.5
	#if CLIENT
		settings.loopSound = "survival_titan_linking_loop"
		settings.displayRui = $"ui/extended_use_hint.rpak"
		settings.displayRuiFunc = ArmoryActivation_DisplayRui
		settings.icon = $""
		settings.hint = Localize( "#PROMPT_CONFIRM" )
		settings.successSound = "ui_menu_store_purchase_success"
	#elseif SERVER // end CLIENT
		settings.exclusiveUse = true
		settings.setUsableOnSuccess = false
		settings.successFunc = OnControlPanelUse_Success
		settings.failureFunc = OnControlPanelUse_Failure
	#endif // SERVER

	waitthread ExtendedUse( cp, player, settings )
}

void function ArmoryActivation_DisplayRui( entity ent, entity player, var rui, ExtendedUseSettings settings )
{
	#if CLIENT || UI
		RuiSetString( rui, "holdButtonHint", settings.holdHint )
		RuiSetString( rui, "hintText", settings.hint )
		RuiSetGameTime( rui, "startTime", Time() )
		RuiSetGameTime( rui, "endTime", Time() + settings.duration )
	#endif //CLIENT || UI
}

#if SERVER
void function OnControlPanelUse_Failure( entity cp, entity player, ExtendedUseSettings settings )
{
	cp.SetUsable()
}

void function OnControlPanelUse_Success( entity cp, entity player, ExtendedUseSettings settings )
{
	if( !IsValid( player ) )
	{
		return
	}

	SkitInstance si = liveSkits[cp]
	if ( IsValid( si ) )
	{
		ControlPanel_SpectreShack_OnUse_Server( si, player )
	}
}
#endif // SERVER

void function SpectreShackSpawnPoint_Init( entity spawnPoint, bool isStanding = false )
{
#if SERVER
	if( ! IsValid( spawnPoint ) )
	{
		return
	}

	// instance the lightweight prop
	entity spectreProp
	if( isStanding )
		spectreProp = CreatePropDynamicLightweight( STANDING_SPECTRE_STATIC, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), 0, -1, true )
	else
		spectreProp = CreatePropDynamicLightweight( HANGING_SPECTRE_STATIC, spawnPoint.GetOrigin(), spawnPoint.GetAngles(), 0, -1, true )

	spectreProp.SetScriptName( spawnPoint.GetScriptName() )
	array<entity> linkArray = clone spawnPoint.GetLinkParentArray()
	// get the reference to inbound linked ent
	foreach( entity ent in linkArray )
	{
		// establish the link to the new prop to keep the spawn groups correct
		ent.LinkToEnt( spectreProp )
		// unlink from the dummy reference
		ent.UnlinkFromEnt( spawnPoint )
	}

	array<entity> childArray = spawnPoint.GetLinkEntArray()
	foreach( entity ent in childArray)
	{
		spectreProp.LinkToEnt( ent )
	}

	// destroy dummy reference
	spawnPoint.Destroy()
#endif // SERVER
}

void function SpectreShackControl_Init( entity cp )
{
                      
#if SERVER
	SetupControlPanel( cp )
	// initialize corresponding skit
	liveSkits[cp] <- InitSkit_SpectreShack_V4_Server( cp, skitIDCounter )
	skitIDCounter++

#endif // SERVER

	AddCallback_OnUseEntity_ClientServer( cp, OnControlPanelUse_Skit4 )

#if SERVER

	#if DEVELOPER
		DEV_Tropics_RegisterNPCCamp ( cp.GetOrigin(), eNPC.SPECTRE, 1000, 1000 )
	#endif // DEV

	CreateSpectreShackPingProp ( cp.GetOrigin(), cp.GetAngles() + <0, 180, 0>, cp )
#endif // SERVER
                            
}

#if SERVER
void function SpectreShack_InitClientTrackingEnts( )
{
	if( SpectreShack_PingFromMap_Enabled() )
	{
		foreach( player in GetPlayerArray() )
		{
			foreach( entity rootEnt, SkitInstance instance in liveSkits )
			{
				Remote_CallFunction_NonReplay( player, FUNCNAME_SetArmoryClientEnt, rootEnt )
			}
		}
	}
}

entity function CreateSpectreShackPingProp( vector origin, vector angles, entity spectreShack )
{
	entity spectreShackHoldProp = CreateEntity( "prop_dynamic" )
	spectreShackHoldProp.SetModel( SPECTRESHACK_PROXY )
	spectreShackHoldProp.SetOrigin( origin )
	spectreShackHoldProp.SetAngles( angles )

	spectreShackHoldProp.kv.SpawnAsPhysicsMover  = false
	spectreShackHoldProp.SetValueForModelKey( SPECTRESHACK_PROXY )
	spectreShackHoldProp.kv.solid                = SOLID_VPHYSICS
	spectreShackHoldProp.kv.DisableBoneFollowers = 1
	spectreShackHoldProp.kv.fadedist             = 100000
	spectreShackHoldProp.kv.collide_bullet       = 0
	spectreShackHoldProp.kv.contents             = CONTENTS_BLOCK_PING
	spectreShackHoldProp.Code_SetTeam( TEAM_UNASSIGNED )

	DispatchSpawn( spectreShackHoldProp )
	spectreShackHoldProp.Highlight_Enable()
	spectreShackHoldProp.Hide()
	spectreShackHoldProp.SetParent( spectreShack )

	return spectreShackHoldProp
}
#endif // SERVER

