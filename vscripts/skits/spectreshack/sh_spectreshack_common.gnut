void function Cl_SpectreShack_OnProximityTriggerEnter( entity wp )
{
#if DEVELOPER
	printf( "CLIENT: Cl_SpectreShack_OnProximityTriggerEnter() was called" )
#endif

	if ( !IsValid( wp ) )
	{
		Assert(false, "Waypoint is null, this should never happen!")
		return
	}
	int wpType = wp.GetWaypointType()
	if ( wpType == eWaypoint.SPECTRE_SHACK_TIMER )
	{
		inShackProximity = true
		thread SpectreShackTimerWaypointThink_Thread( wp )
	}
}

void function Cl_SpectreShack_OnProximityTriggerLeave( entity wp )
{
#if DEVELOPER
	printf( "CLIENT: Cl_SpectreShack_OnProximityTriggerLeave() was called" )
#endif

	if ( !IsValid( wp ) )
	{
		Assert(false, "Waypoint is null, this should never happen!")
		return
	}

	int wpType = wp.GetWaypointType()
	if ( wpType == eWaypoint.SPECTRE_SHACK_TIMER )
	{
		inShackProximity = false
	}
}
#endif // CLIENT

#if SERVER
entity function SpectreShack_CreateRuiWaypoint( vector origin, vector angles )
{
	float delay = ARMORY_ENCOUNTER_DURATION

	entity sm = CreateScriptMover( SPECTRE_SHACK_MOVER_SCRIPTNAME, origin, angles )
	entity wp = CreatePlayerWaypoint( eWaypoint.SPECTRE_SHACK_TIMER )
	wp.SetOrigin( origin )
	wp.SetAngles( angles )

	wp.SetParent( sm )
	wp.SetWaypointGametime( 0, Time() )
	wp.SetWaypointGametime( 1, Time() + delay )
	wp.wp.waypointCreatedTime = Time()

	return wp
}

