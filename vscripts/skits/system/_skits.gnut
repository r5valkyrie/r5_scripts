//////////////
// Highlighter

const string WAYPOINTTYPE_HIGHLIGHTER = "highlighter"
const int HIGHLIGHTER_LIMIT_COUNT = 8
#if SERVER
void function HighlightEntsForDuration( array<entity> ents, float duration )
{
	array<entity> entsCopy = clone( ents )
	if ( entsCopy.len() > HIGHLIGHTER_LIMIT_COUNT )
	{
		Warning( "%s() - Can't handle more than %d ents in one batch.", FUNC_NAME(), HIGHLIGHTER_LIMIT_COUNT )
		entsCopy.resize( HIGHLIGHTER_LIMIT_COUNT )
	}
	thread function() : (entsCopy, duration)
	{
		entity wp = CreateWaypoint_Custom( WAYPOINTTYPE_HIGHLIGHTER )
		foreach ( int idx, entity ent in entsCopy )
			wp.SetWaypointEntity( idx, ent )
		wait duration
		wp.Destroy()
	}()
}
#endif // SERVER

#if CLIENT
void function InstanceHighlighterWP( entity wp )	// WAYPOINTTYPE_HIGHLIGHTER
{
	array<entity> ents
	for ( int idx = 0; idx < HIGHLIGHTER_LIMIT_COUNT; ++idx )
	{
		entity ent = wp.GetWaypointEntity( idx )
		if ( IsValid( ent ) )
			ents.append( ent )
	}

	thread function() : (wp, ents)
	{
		foreach( ent in ents )
			ent.Highlight_PushPingedState()

		wp.EndSignal( "OnDestroy" )
		OnThreadEnd( function() : (ents)
		{
			foreach( ent in ents )
			{
				if ( IsValid( ent ) )
					ent.Highlight_PopPingedState()
			}
		} )

		WaitForever()
	}()
}
#endif // CLIENT



//////////////
// Broadcast Test Message

const string WAYPOINTTYPE_BROADCAST_HUD_SPLASH = "broadcasthudsplash_msg"

#if SERVER
void function BroadcastHudSplashToRadius( string messageText, string subText, vector origin, float range, float duration )
{
	entity wp = CreateWaypoint_Custom( WAYPOINTTYPE_BROADCAST_HUD_SPLASH )
	wp.SetWaypointString( 0, messageText )
	wp.SetWaypointString( 1, subText )
	wp.SetWaypointVector( 0, origin )
	wp.SetWaypointFloat( 0, range )
	wp.SetWaypointFloat( 1, duration )

	thread function() : (wp)
	{
		wait 1.0
		wp.Destroy()
	}()
}
void function BroadcastTestMsg( string messageText, string subText )
{
	BroadcastHudSplashToRadius( messageText, subText, <0,0,0>, -1.0, 4.0 )
}
#endif // SERVER

#if CLIENT
void function Instance_BroadcastHudSplashToRadius( entity wp )
{
	entity player = GetLocalClientPlayer()
	if ( !IsAlive( player ) )
		return

	string messageText = wp.GetWaypointString( 0 )
	string subText = wp.GetWaypointString( 1 )
	vector origin = wp.GetWaypointVector( 0 )
	float range = wp.GetWaypointFloat( 0 )
	float duration = wp.GetWaypointFloat( 1 )

	if ( (range > 0.0) && (Distance( player.GetOrigin(), origin ) > range) )
		return

	//AnnouncementMessageSweep( entity player, string messageText, string subText = "", vector titleColor = <1,1,1>, asset icon = $"", string soundAlias = SFX_HUD_ANNOUNCE_QUICK, float duration = 2.0 )
	AnnouncementMessageSweep( GetLocalClientPlayer(), messageText, subText, <220,220,220>, $"", SFX_HUD_ANNOUNCE_QUICK, duration )
}
#endif // CLIENT
