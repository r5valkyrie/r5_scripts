entity function MakeFakeNPC( int npcType, vector spawnOrigin, vector spawnAngles, int rank = 0 )
{
	asset modelAsset

	int skinIndex = 0
	switch( npcType )
	{
                    
                      
                                                            
                
        
                     
                                                            
        
                          

                  
                   
                                                          
        
                        

			/*
			case eNPC.STALKER:
				modelAsset = GetNPCAsset( eNPC.STALKER, eNPCAsset.BODY )
				idleAnims.append( "" )
				break
			case eNPC.SPECTRE:
				modelAsset = GetNPCAsset( eNPC.SPECTRE, eNPCAsset.BODY )
				idleAnims.append( "" )
				break
			*/
		default:
			Assert( false, "Unhandled npcType" )
	}

	entity fakeNPC = CreatePropDynamic( modelAsset, spawnOrigin, spawnAngles, 6 )
	fakeNPC.SetSkin( skinIndex )
	DropToGround( fakeNPC )
	string idleAnim = GetRandomIdleAnimForNpcType( npcType )
	float initialTime = RandomFloatRange( 0, fakeNPC.GetSequenceDuration( idleAnim ) )
	thread PlayAnimTeleport( fakeNPC, idleAnim, fakeNPC.GetOrigin(), fakeNPC.GetAngles(), initialTime )

	return fakeNPC
}

int function GetFakeNpcType( entity fakeNpc )
{
	switch ( fakeNpc.GetModelName() )
	{
                    
                                                    
                                
                         
       
                        
                          

                  
                                                  
                     
                        

		default:
			Assert( false, "Unhandled modelName: " + fakeNpc.GetModelName() )
	}

	unreachable
}

entity ornull function TryToReplaceFakeNpcWithReal( entity fakeNpc, SkitInstance skitInstance )
{
	//will replace with real AI if budget allows, otherwise will play death anim and remove itself

	if ( !IsValid( fakeNpc  ) )
		return null

	if ( fakeNpc.e.isDisabled ) //already being 'killed'
		return null

	int npcType = GetFakeNpcType( fakeNpc )
	entity ornull npcRaw = SkNPC_SpawnNonCriticalNPC( skitInstance, npcType, fakeNpc.GetOrigin(), fakeNpc.GetAngles() )
	if ( npcRaw == null )
	{
		fakeNpc.e.isDisabled = true
		thread PlayAnim( fakeNpc, GetRandomDeathAnimForNpcType( npcType ) )
		thread DestroyAfterDelay( fakeNpc, 5 )
		printf( "%s() - Unable to spawn real npc, making the fake one 'die' ", FUNC_NAME() )
		return null
	}

	fakeNpc.Destroy()
	return expect entity( npcRaw )
}

