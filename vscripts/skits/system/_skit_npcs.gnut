string function GetRandomIdleAnimForNpcType( int npcType )
{
	array <string> anims
	switch( npcType )
	{
                    
                     
                      
                                               
                                               
                                               
                                               
                                               
                                               
        
                          

                   
		case eNPC.PROWLER:
		case eNPC.DIRE_PROWLER:
			anims.append( "pr_attack_wait_idle_01" )
			anims.append( "pr_attack_wait_idle_02" )
			anims.append( "pr_combat_idle_01" )
			anims.append( "pr_combat_idle_04" )
			anims.append( "pr_idle_lay" )
			break
                          

                  
                   
                                                  
        
                        

                   
		case eNPC.SPECTRE:
		case eNPC.DEATH_SPECTRE:
                            
                            
                                  
                     
                                 
                                  
			anims.append( "CQB_Idle_Casual" )
			break
                         


			/*
			case eNPC.STALKER:
				anims.append( "" )
				break
			*/
		default:
			Assert( false, "Unhandled npcType" )
	}
	anims.randomize()
	return anims[ 0 ]
}

