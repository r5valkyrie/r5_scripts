#if SERVER || CLIENT
global const int REALM_COUNT = 64
global enum eRealms
{
	// Default realm for players in the match
	DEFAULT = 0,
	PROTO_ABILITY_HAUNT = 1,

	//----------------------
	// STAGING AREA REALMS
	//----------------------O

	// We need to reserve realms for players in the staging area. Each player is in 2 player realms, one for just your squad so things like ultimates are
	// only seen by your squad, and also in one of a few common realms with other squads on the server so we see some of the other players running around.
	// In a 60 man, 3 player squads game we need the following number of slots:
	// 60 players / 15 players per common realm = 4 common slots
	// 60 players / 3 players per squad = 20 squad slots
	//   24 realm slots total needed
	//   more realms may be needed for playlists with smaller squads
	STAGING_REALM_PLAYERS_START = 2,
	STAGING_REALM_PLAYERS_END = (REALM_COUNT - 1),

	_count = REALM_COUNT
}
#endif

int MAX_SQUADS_IN_STAGING = 0

struct
{
#if SERVER
	table<int, int> playerRealm_Squad
	table<int, int> playerRealm_Common
	table< int, array<entity> > playersInRealm_Common
	table< int, array<entity> > playersInRealm_Squad
	table< entity, array<int> > playerDefaultRealms
	table< int, entity > realmInfoEntityByRealm

	array<void functionref( entity )> onPlayerAddedToRealmCallbacks
#endif
} file

#if SERVER
bool function AreRealmsActive()
{
	return GetCurrentPlaylistVarBool( "realming_enabled", false )
}

void function RealmsInit()
{
	AddCallback_OnClientConnected( OnPlayerConnectedRealms )
	AddCallback_OnClientDisconnected( OnPlayerDisconnectedRealms )

	if ( !AreRealmsActive() )
		return

	SetupRealms()
	AddCallback_EntitiesDidLoad( EntitiesDidLoad )
	
	SharedInit()
}
#endif

#if CLIENT
void function CL_RealmsInit()
{
	SharedInit()
}
#endif

#if SERVER || CLIENT
void function SharedInit()
{

}
#endif

#if SERVER || CLIENT
void function EntitiesDidLoad()
{
	#if SERVER
	array<int> allCommonPlayerRealms = GetAllPlayerCommonRealms()
	foreach( int realm in allCommonPlayerRealms )
	{
		RealmInfoEntity_Create( realm )
	}
	#endif
}
#endif

#if SERVER
void function SetupRealms()
{
	MAX_SQUADS_IN_STAGING = int( min( MAX_TEAMS, GetCurrentPlaylistVarInt( "num_squads_in_staging", 5 ) ) )
	if( Playlist() == ePlaylists.survival_training )
		Assert( MAX_SQUADS_IN_STAGING == 1 )
	int numCommonPlayerRealms = MAX_SQUADS_IN_STAGING > 1 ? int( max( 1, MAX_TEAMS / MAX_SQUADS_IN_STAGING ) ) : 0 // if num_squads_in_staging is set to 1, we don't need to even create any common realms, we can just put everyone in their squad realm
	int numSquadPlayerRealms  = MAX_TEAMS

	bool hasCommonRealms = numCommonPlayerRealms > 0

	int numPlayerRealmsAvailable = eRealms.STAGING_REALM_PLAYERS_END - eRealms.STAGING_REALM_PLAYERS_START + 1
	int totalRequiredPlayerRealms = numCommonPlayerRealms + numSquadPlayerRealms

	#if DEV
		printt( "|--------------------------------------" )
		printt( "|          InitStagingRealms           " )
		printt( "|--------------------------------------" )
		printt( "|  MAX_TEAMS:", MAX_TEAMS )
		printt( "|  MAX_PLAYERS:", MAX_PLAYERS )
		printt( "|  MAX_TEAM_PLAYERS:", MAX_TEAM_PLAYERS )
		printt( "|  MAX_SQUADS_IN_STAGING:", MAX_SQUADS_IN_STAGING )
		printt( "|  numStagingCommonPlayerRealms:", numCommonPlayerRealms )
		printt( "|  numStagingSquadPlayerRealms:", numSquadPlayerRealms )
		printt( "|  numPlayerRealmsAvailable:", numPlayerRealmsAvailable )
		printt( "|  totalRequiredPlayerRealms:", totalRequiredPlayerRealms )
		printt( "|--------------------------------------" )
	#endif // DEV

	Assert( totalRequiredPlayerRealms <= numPlayerRealmsAvailable, "Can't allocate enough player realms for staging area" )

	int nextAssignedRealm = eRealms.STAGING_REALM_PLAYERS_START

	// Assign player common realms
	if ( hasCommonRealms )
	{
		int count = 0
		for ( int team = 2 ; team < MAX_TEAMS + 2 ; team++ )
		{
			Assert( nextAssignedRealm >= eRealms.STAGING_REALM_PLAYERS_START )
			Assert( nextAssignedRealm <= eRealms.STAGING_REALM_PLAYERS_START + numCommonPlayerRealms )
			Assert( nextAssignedRealm <= eRealms.STAGING_REALM_PLAYERS_END )
			file.playerRealm_Common[ team ] <- nextAssignedRealm
			count++
			if ( count >= MAX_SQUADS_IN_STAGING )
			{
				nextAssignedRealm++
				count = 0
			}
		}
	}

	// Assign player squad realms
	Assert( nextAssignedRealm == eRealms.STAGING_REALM_PLAYERS_START + numCommonPlayerRealms )
	for ( int team = 2 ; team < MAX_TEAMS + 2 ; team++ )
	{
		if ( !hasCommonRealms )
		{
			Assert( nextAssignedRealm >= eRealms.STAGING_REALM_PLAYERS_START + numCommonPlayerRealms )
			Assert( nextAssignedRealm <= eRealms.STAGING_REALM_PLAYERS_START + numCommonPlayerRealms + numSquadPlayerRealms )
			Assert( nextAssignedRealm <= eRealms.STAGING_REALM_PLAYERS_END )
			file.playerRealm_Squad[ team ] <- nextAssignedRealm
			nextAssignedRealm++
		}
		else
		{
			file.playerRealm_Squad[ team ] <- file.playerRealm_Common[ team ]
		}
	}

	#if DEV
		printt( "|      C      " )
		printt( "|      O   S  " )
		printt( "|  T   M   Q  " )
		printt( "|  E   M   U  " )
		printt( "|  A   O   A  " )
		printt( "|  M   N   D  " )
		printt( "|-------------" )

		for ( int team = 2 ; team < MAX_TEAMS + 2 ; team++ )
		{
			string sTeam = string( team )
			if ( sTeam.len() == 1 )
				sTeam += " "

			string sCommonRealm = "-1"
			if ( numCommonPlayerRealms > 0 )
			{
				sCommonRealm = string( file.playerRealm_Common[ team ] )
				if ( sCommonRealm.len() == 1 )
					sCommonRealm += " "
			}

			string sSquadRealm = string( file.playerRealm_Squad[ team ] )
			if ( sSquadRealm.len() == 1 )
				sSquadRealm += " "

			printt( "|  " + sTeam + "  " + sCommonRealm + "  " +  sSquadRealm )
		}

		printt( "|---------------------------------------" )
	#endif //DEV
}

array<int> function GetAllPlayerSquadRealms()
{
	array<int> realms
	foreach( int team, int realm in file.playerRealm_Squad )
	{
		if ( !realms.contains( realm ) )
			realms.append( realm )
	}
	return realms
}

array<int> function GetAllPlayerCommonRealms()
{
	// If there is more than one common realm
	if ( MAX_SQUADS_IN_STAGING <= 1 )
		return GetAllPlayerSquadRealms()

	array<int> realms
	foreach( int team, int realm in file.playerRealm_Common )
	{
		if ( !realms.contains( realm ) )
			realms.append( realm )
	}
	return realms
}

int function GetPlayerSquadRealm( entity player )
{
	int team = player.GetTeam()
	if ( !( team in file.playerRealm_Squad ) )
		return -1
	return file.playerRealm_Squad[ team ]
}

int function GetPlayerCommonRealm( entity player )
{
	int team = player.GetTeam()

	if ( MAX_SQUADS_IN_STAGING <= 1 )
		return GetPlayerSquadRealm( player )

	if ( !( team in file.playerRealm_Common ) )
		return -1
	return file.playerRealm_Common[ team ]
}

void function PutPlayerInRealms( entity player )
{
	int team = player.GetTeam()
	int realmByPlayer
	int realmBySquad

	printt( "|---------------------------------------" )
	printt( "| Putting player in staging realms", player, "team:", team )

	player.RemoveFromAllRealms()

	// Put player in common realm
	if ( MAX_SQUADS_IN_STAGING > 1 )
	{
		Assert( team in file.playerRealm_Common )
		realmByPlayer = file.playerRealm_Common[ team ]
		player.AddToRealm( realmByPlayer )
		if( !( team in file.playersInRealm_Common ) )
		{
			array<entity> players
			file.playersInRealm_Common[ team ] <- players
		}
		file.playersInRealm_Common[ team ].append( player )
		#if DEV
			printt( "|  common realm:", file.playerRealm_Common[ team ] )
		#endif
	}

	// Put player in squad realm
	Assert( team in file.playerRealm_Squad )
	realmBySquad = file.playerRealm_Squad[ team ]
	player.AddToRealm( realmBySquad )

	if( !( team in file.playersInRealm_Squad ) )
	{
		array<entity> players
		file.playersInRealm_Squad[ team ] <- players
	}

	if ( !file.playersInRealm_Squad[ team ].contains(player) )
		file.playersInRealm_Squad[ team ].append( player )
	#if DEV
		printt( "|  squad realm:", file.playerRealm_Squad[ team ] )
		printt( "|---------------------------------------" )
	#endif // DEV
	OnPlayerAddedToRealm( player )
}

void function AddCallback_OnPlayerAddedToRealm( void functionref( entity player ) callbackFunc )
{
	Assert( !file.onPlayerAddedToRealmCallbacks.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with AddCallback_OnPlayerAddedToRealm" )
	file.onPlayerAddedToRealmCallbacks.append( callbackFunc )
}


void function RemoveCallback_OnPlayerAddedToRealm( void functionref( entity player ) callbackFunc )
{
	int index = file.onPlayerAddedToRealmCallbacks.find( callbackFunc )

	Assert( index != -1, "Requested OnPlayerAddedToRealm " + string( callbackFunc ) + " to be removed not found! " )
	file.onPlayerAddedToRealmCallbacks.fastremove( index )
}

void function OnPlayerAddedToRealm( entity player )
{
	// Added via AddCallback_OnPlayerAddedToRealm
	foreach ( callbackFunc in file.onPlayerAddedToRealmCallbacks )
	{
		callbackFunc( player )
	}
}

array< entity > function GetAllPlayersInRealm( int realm )
{
	array< entity > allPlayers = GetPlayerArray()
	array< entity > results
	foreach( pl in allPlayers )
	{
		if( !IsValid( pl ) )
			continue

		if( pl.GetRealms()[0] == realm  )
		{
			results.append( pl )
		}
	}

	return results
}

array<entity> function GetAllPlayersInRealm_ByPlayer( entity player )
{
	array< entity > results = []
	int team = player.GetTeam()
	int realm = player.GetRealms()[0]

	results = GetAllPlayersByTeamOrRealm ( team, realm )
	return results
}

array< entity > function GetAllPlayersByTeamOrRealm( int team, int realm )
{
	array< entity > results

	if ( ( team in file.playersInRealm_Common ) )
	{
		if ( MAX_SQUADS_IN_STAGING > 1 )
		{
			results = file.playersInRealm_Common[ team ]
		}
		else if( team in file.playersInRealm_Squad )
		{
			results = file.playersInRealm_Squad[ team ]
		}
	}
	else
	{
		results = GetAllPlayersInRealm( realm )
	}
	return results
}

array<int> function GetRealmsForUltimateAbility( entity player )
{
	Assert( IsValid( player ) )
	Assert( player.IsPlayer() )

	// If we're playing the game then we just put all ultimates into realm 0 like we used to
	// Carlos: better to put them in whatever the player's realm is
	if ( GetGameState() >= eGameState.Playing )
		return  player.GetRealms() //[eRealms.DEFAULT]

	// In staging, use the first available in this order:
	// 1) Player's squad realm (if exists)
	// 2) Player's common realm (if exists)
	// 3) Player's realms they're assigned to (whatever that may be)

	int squadRealm = GetPlayerSquadRealm( player )
	if ( squadRealm >= 0 )
		return [squadRealm]

	int commonRealm = GetPlayerCommonRealm( player )
	if ( commonRealm >= 0 )
		return [commonRealm]

	return player.GetRealms()
}

void function AddToUltimateRealm( entity player, entity ent )
{
	if ( !IsValid( player ) || !IsValid( ent ) )
		return

	array<int> ultimateRealms = GetRealmsForUltimateAbility( player )
	if ( ultimateRealms.len() == 0 )
		return

	ent.RemoveFromAllRealms()
	foreach( int realm in ultimateRealms )
	{
		ent.AddToRealm( realm )
	}
}


void function OnPlayerConnectedRealms( entity player )
{
	AddRealmToDefaultsForPlayer( player, eRealms.DEFAULT )
}


void function OnPlayerDisconnectedRealms( entity player )
{
	if ( !( player in file.playerDefaultRealms ) )
		return

	delete file.playerDefaultRealms[ player ]
}


void function AddRealmToDefaultsForPlayer( entity player, int realmIdx )
{
	if ( !IsValid( player ) )
		return

	if ( !( player in file.playerDefaultRealms ) )
	{
		array<int> defaultRealms
		defaultRealms.append( realmIdx )

		file.playerDefaultRealms[ player ] <- defaultRealms
	}
	else
	{
		array<int> protectedRealms = file.playerDefaultRealms[ player ]
		if ( !protectedRealms.contains( realmIdx ) )
		{
			protectedRealms.append( realmIdx )
			file.playerDefaultRealms[ player ] = protectedRealms
		}
	}
}


void function RemoveRealmFromDefaultsForPlayer( entity player, int realmIdx )
{
	if ( !IsValid( player ) || !( player in file.playerDefaultRealms ) )
		return

	array<int> defaultRealms = file.playerDefaultRealms[ player ]

	if ( !( defaultRealms.contains( realmIdx ) ) )
		return

	defaultRealms.fastremovebyvalue( realmIdx )
	file.playerDefaultRealms[ player ] = defaultRealms
}


void function PutPlayerInDefaultRealms( entity player )
{
	if ( !( player in file.playerDefaultRealms ) )
		return

	foreach ( int realmIdx in file.playerDefaultRealms[ player ] )
	{
		player.AddToRealm( realmIdx )
	}
}

void function RealmInfoEntity_Create( int realm )
{
	entity realmInfoEntity = CreateEntity( "info_target" )
	DispatchSpawn( realmInfoEntity )
	realmInfoEntity.RemoveFromAllRealms()
	realmInfoEntity.AddToRealm( realm )

	file.realmInfoEntityByRealm[ realm ] <- realmInfoEntity
}

entity function RealmInfoEntity_Get( int realm )
{

	return( file.realmInfoEntityByRealm[ realm ] )
}

void function RealmInfoEntity_Signal( int realm, string signal )
{
	if ( !(realm in file.realmInfoEntityByRealm) )
		return

	if ( !IsValid( file.realmInfoEntityByRealm[ realm ] ) )
		return

	file.realmInfoEntityByRealm[ realm ].Signal( signal )
}

void function RealmInfoEntity_EndSignal( int realm, string signal )
{
	if ( !(realm in file.realmInfoEntityByRealm) )
		return

	if ( !IsValid( file.realmInfoEntityByRealm[ realm ] ) )
		return

	EndSignal( file.realmInfoEntityByRealm[ realm ], signal )
}

#endif

#if SERVER || CLIENT
void function CopyRealmsFromTo( entity source, entity target )
{
	target.RemoveFromAllRealms()
	target.AddToOtherEntitysRealms( source )
}
#endif


#if SERVER
void function SetRealms( entity ent, array<int> realms )
{
	ent.RemoveFromAllRealms()
	foreach ( int realm in realms )
		ent.AddToRealm( realm )
}
#endif


