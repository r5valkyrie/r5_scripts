global function SV_CL_Shared_Init

void function SV_CL_Shared_Init()
{
	#if CLIENT
	if ( !IsLobby() )
		ClMinimap_Pre_Init()
	#endif

	#if DEVELOPER
		PrintDebugTimeDetails()
		#if SERVER
		ClientCommands_Init()
		#endif
	#endif

	#if SERVER
		SvDemo_ConsistencyCheckString( "SV_CL_Shared_Init()" )
	#endif

	GameModes_Init()
	Settings_Init()

	                
		Crafting_Init()
       

                   
                  
       

	if ( IsLobby() )
	{
		Shared_Lobby_Init()
		PlayerWaypoints_Init()
		return
	}

	SV_CL_Init()

	#if SERVER
		Server_Init()
	#endif

	#if CLIENT
		Client_Init()
	#endif

	RemoteFunctions_Init_Finish()

	#if SERVER
		SvDemo_ConsistencyCheckString( "SV_CL_Shared_Init END" )
	#endif
} // end SV_CL_Shared_Init()


