}

void function InstanceWP_TrackEnt( entity wp )
{
	var newRui = CreateWaypointRui( $"ui/waypoint_basic_entpos.rpak", 200 )
	SetWaypointRui_HUD( wp, newRui )

	RuiKeepSortKeyUpdated( newRui, true, "targetPos" )

	RuiSetBool( newRui, "completeADSFade", false )

	RuiTrackFloat3( newRui, "playerAngles", GetLocalViewPlayer(), RUI_TRACK_CAMANGLES_FOLLOW )

	RuiTrackString( newRui, "promptText", wp, RUI_TRACK_WAYPOINT_STRING, 0 )
	RuiTrackImage( newRui, "iconImage", wp, RUI_TRACK_WAYPOINT_IMAGE, 0 )

	entity targ0 = wp.GetWaypointEntity( 0 )
	RuiTrackFloat3( newRui, "targetPos", targ0, RUI_TRACK_OVERHEAD_FOLLOW )

	vector offset = wp.GetWaypointVector( 0 )
	RuiSetFloat3( newRui, "targetOffset", offset )

	bool ignoreCenterFade = wp.GetWaypointInt( 0 ) > 0 ? true : false
	RuiSetBool( newRui, "ignoreCenterFade", ignoreCenterFade )

	float minDistance  = wp.GetWaypointFloat( 0 )
	if ( minDistance > 0 )
		thread Update_TrackEnt_THREAD( wp, newRui )

}

void function Update_TrackEnt_THREAD( entity wp, var rui )
{
	wp.EndSignal( "OnDestroy" )


	while( true )
	{
		WaitFrame()

		entity player = GetLocalViewPlayer()
		if ( !IsValid( player ) )
			continue

		float minDistance  = wp.GetWaypointFloat( 0 )
		if ( minDistance <= 0.0 )
			break

		float distanceSqr = DistanceSqr( player.GetOrigin(), wp.GetOrigin() )
		float minDistanceSqr = minDistance * minDistance
		bool shouldHide = distanceSqr < minDistanceSqr
		RuiSetBool( rui, "isHidden", shouldHide )

	}
}

                      
                                                         
 
                              
                         
        

                                                                      
                               
                                                 
                                      
                                            
                                               
                                            
                                           
                                          
                                                                                         
                                                 

                                                                          
                        
                       
                                                      
                                             

                                                                      
                                                                      

                                                                        
                                                                        

                                                                               
                                                                               
 
      

                      
