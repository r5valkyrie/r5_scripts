array <entity> function GetFireBlockersByScriptNoteworthy( string scriptNoteworthy )
{
	array <entity> fireBlockerNavmeshSeparators
	foreach( ent in file.fireBlockers )
	{
		if ( ent.kv.script_noteworthy == scriptNoteworthy )
			fireBlockerNavmeshSeparators.append( ent )
	}

	Assert( fireBlockerNavmeshSeparators.len() > 0, "Unable to find any fireBlockers with script_noteworthy: " + scriptNoteworthy )

	return fireBlockerNavmeshSeparators
}


