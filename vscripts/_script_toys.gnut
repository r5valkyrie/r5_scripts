void function HarvesterDespawn( Harvester harvester )
{
	WaitFrame() //ensure we are running after generic navmesh_separator and door scripts

	Assert( harvester.isSpawned, "Trying to despawn a harvester that has not been spawned at " + harvester.origin )
	harvester.isSpawned = false
	foreach( navmeshSeparator in harvester.navmeshSeperators )
	{
		ToggleNPCPathsForEntity( navmeshSeparator, true )
		navmeshSeparator.NotSolid()
	}

	foreach( generatorControlNode in harvester.generatorControlNodes )
	{
		Breakable breakableGenerator = expect Breakable( GetBreakableByControlNode( generatorControlNode ) )
		if ( breakableGenerator.isSpawned )
			BreakableDespawn( breakableGenerator )
	}

	foreach ( flag in harvester.flagsToSetOnDestroy )
	{
		if ( Flag( flag ) )
			FlagClear( flag )
	}


	WaitFrame()


	if ( IsValid( harvester.ringEnt ) )
		harvester.ringEnt.Destroy()

	if ( IsValid( harvester.fxControlPointEnt ) )
		harvester.fxControlPointEnt.Destroy()

	if ( IsValid( harvester.harvesterBeamFX ) )
	{
		bool playEndCap = false
		ParticleSystemStop( harvester.harvesterBeamFX, playEndCap, 0 )
		if ( IsValid( harvester.harvesterBeamFX ) )
			harvester.harvesterBeamFX.Destroy()
	}

	if ( IsValid( harvester.damageFX ) )
	{
		harvester.damageFX.SetStopType( "destroyImmediately" )
		harvester.damageFX.Destroy()
	}

	foreach( fx in harvester.fx )
	{
		if ( IsValid( fx ) )
		{
			fx.SetStopType( "destroyImmediately" )
			fx.Destroy()
		}
	}

	if ( IsValid( harvester.model ) )
		harvester.model.Destroy()

}

void function HarvesterDespawnByInstanceName( string instanceName )
{
	WaitFrame() //ensure we are running after generic navmesh_separator and door scripts

	Harvester harvester = expect Harvester( GetHarvesterByInstanceName( instanceName ) )
	HarvesterDespawn( harvester )

}

Harvester function HarvesterSpawn( Harvester harvester)
{
	Assert( !harvester.isSpawned, "Trying to spawn a harvester that has already been spawned: " + harvester.instanceName )
	Assert( !IsValid( harvester.model ), "Trying to spawn a new harvester model that already exists: " + harvester.instanceName )

	harvester.isSpawned = true
	harvester.model = CreatePropScript( harvester.modelAsset, harvester.origin, harvester.angles, SOLID_VPHYSICS )
	harvester.model.kv.instance_name = harvester.instanceName
	harvester.numberOfGeneratorsDestroyed = 0

	foreach( navmeshSeparator in harvester.navmeshSeperators )
	{
		ToggleNPCPathsForEntity( navmeshSeparator, false )
		navmeshSeparator.NotSolid()
	}

	if ( harvester.generatorControlNodes.len() == 0 )
	{
		harvester.generatorControlNodes = HarvesterGetClosestGeneratorNodes( harvester.origin )
	}
	Assert( harvester.generatorControlNodes.len() == 4 )

	foreach( generatorControlNode in harvester.generatorControlNodes )
	{
		Breakable breakableGenerator = expect Breakable( GetBreakableByControlNode( generatorControlNode ) )
		if ( !breakableGenerator.isSpawned )
			BreakableSpawn( breakableGenerator )
	}

	harvester.model.DisableHibernation()

	// spawn harvester ring model
	int attachID = harvester.model.LookupAttachment( "ref" )
	vector attachOrg = harvester.model.GetAttachmentOrigin( attachID )
	vector attachAng = harvester.model.GetAttachmentAngles( attachID )
	harvester.ringEnt = CreatePropDynamic( MODEL_HARVESTER_TOWER_RINGS, attachOrg, attachAng, 0 )
	harvester.ringEnt.DisableHibernation()

	// spawn fx control point
	harvester.fxControlPointEnt = CreateEntity( "info_placement_helper" )
	SetTargetName( harvester.fxControlPointEnt, UniqueString( "breakableGenerator_fx_colors" ) )
	DispatchSpawn( harvester.fxControlPointEnt )

	thread HarvesterThink( harvester )

	return harvester
}

void function HarvesterThink( Harvester harvester )
{
	harvester.model.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( harvester )
		{
			printf( "%s() - Harvester at " + harvester.origin + "stopping think fuction now", FUNC_NAME() )
		}
	)

	foreach ( generatorControlNode in harvester.generatorControlNodes )
		thread HarvesterGeneratorThink( harvester, generatorControlNode )


	HarvesterStartAmbientSFX( harvester, "Coop_Generator_Ambient_Healthy" )
	harvester.fxControlPointEnt.SetOrigin( <100,100,123> )
	harvester.fxControlPointEnt.DisableHibernation()
	harvester.harvesterBeamFX = StartParticleEffectInWorld_ReturnEntity( GetParticleSystemIndex( FX_HARVESTER_BEAM ), harvester.origin, <0,0,0> )
	harvester.harvesterBeamFX.SetStopType( "destroyImmediately" )
	harvester.harvesterBeamFX.DisableHibernation()
	EffectSetControlPointEntity( harvester.harvesterBeamFX, 1, harvester.fxControlPointEnt )

	bool firstDamageStateTriggered = false
	bool secondDamageStateTriggered = false
	bool thirdDamageStateTriggered = false

	HarvesterStartAmbientSFX( harvester, "Coop_Generator_Ambient_Healthy" )
	thread HarvesterRingsPlayAnim( harvester, "generator_cycle_fast" )

	while( true )
	{
		WaitFrame()

		HarvesterUpdateFXColorControlPoint( harvester )

		//-------------------------------------------------------
		// has the whole harvester (all 4 generators) been destroyed?
		//-------------------------------------------------------
		if ( harvester.numberOfGeneratorsDestroyed > 3 )
		{

			break //we're done here
		}

		//----------------------
		//3 generators destroyed
		//----------------------
		if ( harvester.numberOfGeneratorsDestroyed > 2 && !thirdDamageStateTriggered )
		{
			thirdDamageStateTriggered = true
			HarvesterStartDmgFX( harvester, FX_HARVESTER_HEALTH_LOW )
			HarvesterStartAmbientSFX( harvester, "Coop_Generator_Ambient_Critical" )
			thread HarvesterRingsPlayAnim( harvester, "generator_cycle_slow" )
		}

		//----------------------
		// 2 generators destroyed
		//----------------------
		else if ( harvester.numberOfGeneratorsDestroyed > 1 && !secondDamageStateTriggered )
		{
			secondDamageStateTriggered = true
			//play smoke?
		}
		//----------------------
		// 1 generator destroyed
		//----------------------
		else if ( harvester.numberOfGeneratorsDestroyed > 0 && !firstDamageStateTriggered )
		{
			firstDamageStateTriggered = true
			HarvesterStartAmbientSFX( harvester, "Coop_Generator_Ambient_Damaged" )
			thread HarvesterRingsPlayAnim( harvester, "generator_cycle_fast" )
		}

	}

	//-----------------------------------
	// Harvester alarm, fire, ready to blow up
	//-----------------------------------
	harvester.model.Signal( SIGNAL_HARVESTER_BLOWING_UP )

	entity fireLoopFX = PlayLoopFX( FX_HARVESTER_FIRE, harvester.origin, <0, 0, 0> )
	EmitSoundAtPosition( TEAM_UNASSIGNED, harvester.origin, "Canyonlands_Generic_Emit_Fire_Medium_A", harvester.model )
	EmitSoundOnEntity( harvester.model, "TitanWar_Harvester_ShieldAlarm" )
	wait 1.75
	EmitSoundOnEntity( harvester.model, "TitanWar_Harvester_ShieldAlarm" )
	wait 1.75

	//-----------------------------------
	// Harvester actual destruction effects, etc
	//-----------------------------------

	//set any user defined flags for harvester destruction
	foreach ( flag in harvester.flagsToSetOnDestroy )
	{
		if ( !Flag( flag ) )
			FlagSet( flag )
	}

	/*
	RadiusDamage(
		harvester.origin,					// origin
		svGlobal.worldspawn,				// owner
		harvester.model,		 			// inflictor
		1000,								// pilot damage
		2000,								// heavy armor damage
		200,								// inner radius
		400,								// outer radius
		SF_ENVEXPLOSION_NO_NPC_SOUND_EVENT,	// explosion flags
		0, 									// distanceFromAttacker
		1000, 								// explosionForce
		DF_SKIPS_DOOMED_STATE,				// damage flags
		eDamageSourceId.exploding_barrel	// damage source id
	)
	*/
	//Be sure to damage any nearby enemies heavily
	array<entity> npcs = GetNPCArrayEx( "any", TEAM_ANY, eNpcTeam.FRIENDLY, harvester.origin, 325 )
	foreach( npc in npcs )
	{
		if ( !IsAlive( npc ) )
			continue
		Assert( !npc.IsPlayer() )
		int scriptTypeMask = damageTypes.dissolve// | DF_STOPS_TITAN_REGEN
		npc.TakeDamage( npc.GetHealth() + 1, svGlobal.worldspawn, svGlobal.worldspawn, { origin = npc.GetOrigin(), scriptType = scriptTypeMask, damageSourceId = eDamageSourceId.exploding_barrel } )
	}

	PlayFX( FX_HARVESTER_DUST, harvester.origin,  <0, 0, 0> )
	PlayFX( FX_HARVESTER_EXPLOSION, harvester.origin,  <0, 0, 0> )
	harvester.fx.append( fireLoopFX )
	AI_CreateDangerousArea_Static( svGlobal.worldspawn, null, 128, TEAM_INVALID, true, true, harvester.origin )
	EmitSoundAtPosition( TEAM_UNASSIGNED, harvester.origin, "titan_death_explode", harvester.model)
	EmitSoundAtPosition( TEAM_UNASSIGNED, harvester.origin, "Coop_Generator_Destroyed", harvester.model)

	CreateShake( harvester.origin, 16, 1, 4, 4000 )

	harvester.model.Signal( SIGNAL_HARVESTER_DESTROYED )
	harvester.ringEnt.EndSignal( "OnDestroy" )

	if ( IsValid_ThisFrame( harvester.harvesterBeamFX ) )
	{
		bool playEndCap = false
		ParticleSystemStop( harvester.harvesterBeamFX, playEndCap, 0 )
	}

	//Fade out harvester sounds.
	HarvesterFadeAmbientSFX( harvester )

	HarvesterRingsPlayAnim( harvester, "generator_fall" )
	harvester.ringEnt.Hide()
	thread HarvesterRingsPlayAnim( harvester, "generator_idle" )

}

void function HarvesterStartDmgFX( Harvester harvester, asset fxAsset )
{
	if ( IsValid( harvester.damageFX ) )
		StopFX( harvester.damageFX )

	if ( harvester.damageSFX != "" )
		StopSoundOnEntity( harvester.model, harvester.damageSFX )

	harvester.damageFX = PlayFXWithControlPoint( fxAsset, harvester.origin, harvester.fxControlPointEnt, -1, null, null, C_PLAYFX_LOOP )
	harvester.damageFX.DisableHibernation()

	harvester.damageSFX = "Coop_Generator_Electrical_Arcs"
	EmitSoundOnEntity( harvester.model, harvester.damageSFX )
}

void function HarvesterUpdateFXColorControlPoint( Harvester harvester )
{
	if ( harvester.numberOfGeneratorsDestroyed == 4 )
		return

	float healthRatio = float( 4 - harvester.numberOfGeneratorsDestroyed ) / 4.0

	float blendStartFrac 	= 0.95
	float midFrac 			= 0.6
	float blendEndFrac 		= 0.2

	vector color

	if ( healthRatio > midFrac )
	{
		color.x = GraphCapped( healthRatio, blendStartFrac, midFrac, HARVESTER_COLOR_FULL.x, HARVESTER_COLOR_MED.x )
		color.y = GraphCapped( healthRatio, blendStartFrac, midFrac, HARVESTER_COLOR_FULL.y, HARVESTER_COLOR_MED.y )
		color.z = GraphCapped( healthRatio, blendStartFrac, midFrac, HARVESTER_COLOR_FULL.z, HARVESTER_COLOR_MED.z )
	}
	else
	{
		color.x = GraphCapped( healthRatio, midFrac, blendEndFrac, HARVESTER_COLOR_MED.x, HARVESTER_COLOR_LOW.x )
		color.y = GraphCapped( healthRatio, midFrac, blendEndFrac, HARVESTER_COLOR_MED.y, HARVESTER_COLOR_LOW.y )
		color.z = GraphCapped( healthRatio, midFrac, blendEndFrac, HARVESTER_COLOR_MED.z, HARVESTER_COLOR_LOW.z )
	}

	//printt( color )

	harvester.fxControlPointEnt.SetOrigin( color )
}

void function HarvesterStartAmbientSFX( Harvester harvester, string soundAlias )
{
	if ( harvester.ambientSFX != "" && harvester.ambientSFX == soundAlias )
		return

	HarvesterFadeAmbientSFX( harvester )

	EmitSoundOnEntity( harvester.model, soundAlias )
	harvester.ambientSFX = soundAlias
}

void function HarvesterFadeAmbientSFX( Harvester harvester )
{
	if ( harvester.ambientSFX == "" )
		return

	FadeOutSoundOnEntity( harvester.model, harvester.ambientSFX, 1.0 )
	harvester.ambientSFX = ""
}

void function HarvesterRingsPlayAnim( Harvester harvester, string animAlias )
{
	if ( harvester.ringAnim != "" && harvester.ringAnim != animAlias )
	{
		harvester.ringEnt.Anim_Stop()
		harvester.ringAnim = ""
	}

	harvester.ringAnim = animAlias
	PlayAnim( harvester.ringEnt, animAlias )
}

void function HarvesterGeneratorThink( Harvester harvester, entity generatorControlNode )
{
	harvester.model.EndSignal( "OnDestroy" )

	Breakable breakableGenerator = expect Breakable( GetBreakableByControlNode( generatorControlNode ) )
	generatorControlNode.WaitSignal( SIGNAL_BREAKABLE_DESTROYED )
	harvester.model.Signal( SIGNAL_BREAKABLE_DESTROYED )
	harvester.numberOfGeneratorsDestroyed++
	if ( harvester.numberOfGeneratorsDestroyed == 4 )
		harvester.killer = breakableGenerator.killer
}

Harvester function HarvesterSpawnByInstanceName( string instanceName )
{
	Harvester harvester = expect Harvester( GetHarvesterByInstanceName( instanceName ) )
	harvester = HarvesterSpawn( harvester )

	return harvester
}

Harvester ornull function GetHarvesterByInstanceName( string instanceName )
{
	foreach( harvester in file.harvesters )
	{
		if ( harvester.instanceName == instanceName )
			return harvester
	}
	printf( "%s() - There is no harvester with instance_name: " + instanceName, FUNC_NAME() )
	return null
}

void function HarvesterSetFlagOnDestroyed( Harvester harvester, string flagToSet )
{
	if ( !FlagExists( flagToSet ) )
		FlagInit( flagToSet )
	foreach ( flag in harvester.flagsToSetOnDestroy )
	{
		if ( flag == flagToSet )
			Assert( false, flagToSet + "flag has already been added to harvester flags at " + harvester.origin )
	}

	harvester.flagsToSetOnDestroy.append( flagToSet )
}

array <entity> function HarvesterGetClosestGeneratorNodes( vector origin )
{

	array <entity> generatorControlNodes = ArrayClosestWithinDistance( file.breakableControlNodes, origin, 512 )
	Assert( generatorControlNodes.len() > 3 )
	if ( generatorControlNodes.len() != 4 )
		generatorControlNodes = [ generatorControlNodes[0], generatorControlNodes[1], generatorControlNodes[2], generatorControlNodes[3] ]

	return generatorControlNodes
}


