CreatureCage ornull function CreatureCageSpawn( SkitInstance ornull si, string instanceName, int ornull eNpcType = null, int minToSpawn = 0, int maxToSpawn = 0, int cageButtonType = eCageButtonType.CONSOLE )
{
	CreatureCage cage = expect CreatureCage( GetCreatureCageByInstanceName( instanceName ) )

	Assert( !cage.isSpawned, "Trying to spawn a creature cage that has already been spawned: " + instanceName )
	Assert( !IsValid( cage.cageModel ), "Trying to spawn a new creature cage model that already exists: " + instanceName )
	Assert( !IsValid( cage.cageAntennaModel ), "Trying to spawn a new creature cage antenna model that already exists: " + instanceName )
	Assert( !cage.isOpen, "Trying to spawn a creature cage but it's door was left open last time it was deleted" )

	if ( si == null )
	{
		Warning( "CreatureCageSpawn used without a skit instance, this is no longer valid! Bailing out." )
		return null
	}
	expect SkitInstance( si )

	//---------------------
	// respawn models
	//----------------------
	cage.cageModel = CreatePropDynamic( cage.cageModelAsset, cage.cageModelOrigin, cage.cageModelAngles, SOLID_VPHYSICS )
	cage.cageModel.AllowMantle()
	cage.cageAntennaModel = CreatePropDynamic( cage.cageAntennaModelAsset, cage.cageAntennaModelOrigin, cage.cageAntennaModelAngles, SOLID_VPHYSICS )

	//---------------------
	// unhide other elements
	//----------------------
	cage.door.MakeVisible()
	cage.door.Solid()

	if ( cageButtonType == eCageButtonType.HACKPANEL )
	{

		cage.controlPanel.MakeVisible()
		cage.controlPanel.Solid()
		cage.controlPanel.SetUsable()
	}
	else if ( cageButtonType == eCageButtonType.SHOOTABLELOCK )
	{
		cage.shootableLock.MakeVisible()
		cage.shootableLock.Solid()
		ScriptToyChangeStatusLights( cage.shootableLock, $"runway_light_red" )
		Highlight_SetNeutralHighlight( cage.shootableLock, "sp_interact_object" )
		Highlight_SetFriendlyHighlight( cage.shootableLock, "sp_interact_object" )
		Highlight_SetEnemyHighlight( cage.shootableLock, "sp_interact_object" )
	}
	else //standard console button
	{
		cage.button.MakeVisible()
		cage.button.Solid()
		cage.button.SetUsable()
	}

	cage.cageButtonType = cageButtonType

	ToggleNPCPathsForEntity( cage.cageRoofNavmeshSeperator, true ) //enable the roof navmesh
	ToggleNPCPathsForEntity( cage.cageDoorNavmeshSeperator, false ) //disable navmesh that door covers
	cage.cageDoorNavmeshSeperator.Solid()

	foreach( navblocker in cage.cageNavmeshSeperators )
	{
		ToggleNPCPathsForEntity( navblocker, false )
		//navblocker.Solid()
	}


	//-----------------
	// Antenna lights
	//-----------------
	CreatureCageLightsToggle( cage )

	//---------------------
	// spawn creatures
	//----------------------
	if ( eNpcType != null )
		SpawnCreaturesInCage( si, cage, expect int( eNpcType ), minToSpawn, maxToSpawn )


	cage.isSpawned = true
	cage.isLocked = false

	thread CreatureCageThink( cage )

	return cage
}

void function CreatureCageOpen( CreatureCage cage )
{

	if ( cage.cageButtonType  == eCageButtonType.HACKPANEL )
		cage.controlPanel.Signal( "PanelReprogram_Success" )
	else
		cage.button.Signal( "SwitchActivate" )

}

array <entity> function GetAllCreaturesInsideCageBounds( CreatureCage cage )
{
	vector cageOrg = cage.dangerousAreaEnt.GetOrigin()
	float radiusToCheck = 300
	if ( IsGoliathCage( cage.cageModelAsset ) )
		radiusToCheck = 700


	array <entity> creatures = GetNPCArrayEx( "any", -1, -1, cageOrg, radiusToCheck )
	array <entity> creaturesInsideCage

	vector cageMins = cage.cageModel.GetBoundingMins()
	vector cageMaxs = cage.cageModel.GetBoundingMaxs()
	foreach( npc in creatures )
	{
		if ( !IsAlive( npc ) )
			continue

		if ( !IsCreature( npc  ) )
			continue

		vector npcOrigin = npc.GetOrigin() + <0, 0, 72>
		vector localPos = WorldPosToLocalPos( npcOrigin, cage.cageModel )
		bool insideCage = PointIsWithinBounds( localPos, cageMins, cageMaxs )
		if ( !insideCage )
			continue

		creaturesInsideCage.append( npc )
	}

	return creaturesInsideCage
}


void function CreatureCageLightsToggle( CreatureCage cage )
{
	foreach( fx in cage.cageFx )
	{
		if ( IsValid( fx ) )
			fx.Destroy()
	}

	int fxIndex
	vector antennaLightOrigin = cage.cageAntennaModelOrigin + <0, 0, 350>

	if ( cage.isOpen )
		fxIndex = GetParticleSystemIndex( $"runway_light_green" )
	else
		fxIndex = GetParticleSystemIndex( $"runway_light_red" )

	entity fxLights = StartParticleEffectInWorld_ReturnEntity( fxIndex, antennaLightOrigin, <0, 0, 0> )
	cage.cageFx.append( fxLights )

}

void function SpawnCreaturesInCage( SkitInstance si, CreatureCage cage, int npcType, int minToSpawn = -1, int maxToSpawn = -1 )
{
	Assert( minToSpawn <= maxToSpawn, format( "%s() -- min to spawn (%d) must be <= max to spawn (%d)", FUNC_NAME(), minToSpawn, maxToSpawn ) )

	array <entity> creatures
	array< table<string, vector> > animOffsets = GetCreatureCageAnimOffsetsForType( npcType )
	array <string> idleAnims = GetCreatureCageIdleAnimsForType( npcType )
	vector spawnOrigin = cage.cageModel.GetOrigin()
	vector cageOrigin = cage.cageModelOrigin
	vector cageAngles = cage.cageModelAngles

	float xOffset = 0
	float yOffset = 0
	float zOffset = 0
	//HACK - additional offsets to get these guys idling the right spot until we get legit anims playing off a proper cage attachment
	switch( npcType )
	{
                  
                   
                 
               
        
                        

                    
                     
                 
                
        
                          

                   
		case eNPC.PROWLER:
			//need to fix base anims
			xOffset = -100
			yOffset = -140
			break
                         

                   
                    
                 
        
                         
		default:
			break

	}
	vector cageOriginAdjusted = PositionOffsetFromOriginAngles( cageOrigin, cageAngles, xOffset, yOffset, zOffset )

	int animNumber = 0
	int spawnGoal = animOffsets.len()
	int criticalGoal
	if ( maxToSpawn >= 0 )
		spawnGoal = minint( spawnGoal, maxToSpawn )
	if ( minToSpawn >= 0 )
		criticalGoal = minint( spawnGoal, minToSpawn )
	else
		criticalGoal = spawnGoal

	for ( int i = 0; i < spawnGoal; i++ )
	{

		//vector origin = cageOrigin + animOffsets[i]["origin"]
		vector origin = PositionOffsetFromOriginAngles( cageOriginAdjusted, cageAngles, animOffsets[i]["origin"].x, animOffsets[i]["origin"].y, animOffsets[i]["origin"].z )
		vector angles = AnglesCompose( cageAngles, animOffsets[i]["angles"] )

		//DebugDrawText( origin + <0,0,72>, (animOffsets[i]["origin"].x).tostring(), true, 9999999 )
		if ( animNumber > idleAnims.len() - 1 )
			animNumber = 0

		bool isCritical = false
		if ( i < criticalGoal )
			isCritical = true

		thread ScriptCageCreatureThink( si, cage, npcType, origin, angles, idleAnims[ animNumber ], isCritical )
		animNumber++
	}
}

array <string> function GetCreatureCageIdleAnimsForType( int eNpcType )
{
	array <string> idleAnims
	switch( eNpcType )
	{
                  
                   
                                       
        
                        

                    
                     
                                                   
                                                   
                                                   
                                                   
                                                   
                                                   
        
                          

                   
		case eNPC.PROWLER:
			idleAnims.append( "pr_pve_caged_small_aggro_01" )
			idleAnims.append( "pr_pve_caged_small_aggro_02" )
			idleAnims.append( "pr_pve_caged_small_aggro_03" )
			idleAnims.append( "pr_pve_caged_small_aggro_04" )
			break
                         

                   
                    
                                       
        
                         

		default:
			Assert( false, "Unhandled eNpcType" )
	}

	return idleAnims
}


array< table<string, vector> > function GetCreatureCageAnimOffsetsForType( int eNpcType )
{
	array< table<string, vector> > animOffsets

	switch ( eNpcType )
	{
                  
                   
                                                                                               
                                                                                                
                                                                                                     
                                                                                                      
                                                                                                      
                                                                                                        
                                                                                                        
                                                                                                      
        
                        

                    
                     
                                                                                                          
                                                                                                         
                                                                                                    
                                                                                                     
                                                                                                        
                                                                                                   
                                                                                                     
                                                                                                    
                                                                                                     
        
                          

                   
		case eNPC.PROWLER:
			animOffsets.append( { origin = <0, 0, 0>, angles = <0, 269.991394, 0> } )
			animOffsets.append( { origin = <0, 0, 0>, angles = <0, 89.9913788, 0> } )
			animOffsets.append( { origin = <0, 0, 0>, angles = <0, 179.991379, 0> } )
			animOffsets.append( { origin = <0, 0, 0>, angles = <0, 89.9913788, 0> } )
			break
                         

                   
                    
                                                                           
        
                         
		default:
			Assert( false, "Unhandled eNpcType" )
	}

	return animOffsets
}


bool function IsGoliathCage( asset cageModelAsset )
{
	if ( cageModelAsset == $"mdl/containers/portable_holding_cell_massive_open.rmdl" )
		return true
	return false
}

CreatureCage ornull function GetCreatureCageByInstanceName( string instanceName )
{
	foreach( cage in file.creatureCages )
	{
		if ( cage.cageInstanceName == instanceName )
			return cage
	}
	printf( "%s() - There is no creature cage with instance_name: " + instanceName, FUNC_NAME() )

	return null
}

CreatureCage ornull function GetClosestCreatureCage( vector origin )
{
	if ( file.creatureCages.len() == 0 )
	{
		printf( "%s() - There are no creature cages spawned at all" )
		return null
	}
	float dist = 99999999
	float newDist
	CreatureCage ornull cageToReturn = null
	foreach( cage in file.creatureCages )
	{
		if ( !IsValid( cage.cageAntennaModel ) )
			continue
		newDist = Distance( origin, cage.cageAntennaModel.GetOrigin() )
		if ( newDist < dist )
		{
			dist = newDist
			cageToReturn = cage
		}
	}

	return cageToReturn
}

void function CreatureCageDespawnAll()
{
	//deletes creature cages but can be respawned
	foreach( cage in file.creatureCages )
		CreatureCageDespawn( cage.cageInstanceName )
}

void function CreatureCageDestroyAll()
{
	//permanently deletes creature cages, cannot respawn
	foreach( cage in file.creatureCages )
		CreatureCageDestroy( cage.cageInstanceName )
}

void function CreatureCageCloseDoorAndDisable( entity door, entity navmeshSeparator )
{

	Assert( IsValid( door ) )
	Assert( IsValid( navmeshSeparator ) )
	door.EndSignal( "OnDestroy" )

	Signal( door, "CloseDoor" )
	float animLength = door.GetSequenceDuration( "close" )
	wait animLength
	door.MakeInvisible()
	door.NotSolid()
	navmeshSeparator.Hide()
	navmeshSeparator.NotSolid()
	ToggleNPCPathsForEntity( navmeshSeparator, true )

}

void function CreatureCageDespawn( string instanceName )
{
	WaitFrame() //ensure we are running after generic navmesh_separator and door scripts

	CreatureCage cage = expect CreatureCage( GetCreatureCageByInstanceName( instanceName ) )
	Assert( cage.isSpawned, "Trying to despawn a creature cage that has not been spawned: " + instanceName )

	cage.isSpawned = false

	//reset all to original state
	Signal( cage.cageModel, "CreatureCageDespawned" )

	if ( cage.isOpen )
	{
		if ( cage.cageButtonType == eCageButtonType.CONSOLE )
			Signal( cage.button, "SwitchReset" )
		thread CreatureCageCloseDoorAndDisable( cage.door, cage.cageDoorNavmeshSeperator )
		cage.isOpen = false
	}
	foreach( creature in cage.creatures )
	{
		if ( IsAlive( creature ) )
			creature.Destroy()
	}
	foreach( prop in cage.propCreatures )
	{
		if ( IsValid( prop ) )
			prop.Destroy()
	}
	foreach( fx in cage.cageFx )
	{
		if ( IsValid( fx ) )
			fx.Destroy()
	}

	if ( IsValid ( cage.cageRoofNavmeshSeperator ) )
	{
		ToggleNPCPathsForEntity( cage.cageRoofNavmeshSeperator, false ) //disable the roof navmesh
	}

	if ( IsValid ( cage.cageDoorNavmeshSeperator ) )
	{
		ToggleNPCPathsForEntity( cage.cageDoorNavmeshSeperator, true )
		cage.cageDoorNavmeshSeperator.NotSolid()
	}

	if ( cage.cageNavmeshSeperators.len() > 0 )
	{
		foreach( navblocker in cage.cageNavmeshSeperators )
		{
			ToggleNPCPathsForEntity( navblocker, true )
			navblocker.NotSolid()
		}
	}

	WaitFrame()
	cage.cageModel.Destroy()
	cage.cageAntennaModel.Destroy()

	cage.door.MakeInvisible()
	cage.door.NotSolid()
	if ( IsValid( cage.button ) )
	{
		cage.button.MakeInvisible()
		cage.button.NotSolid()
		cage.button.UnsetUsable()
		Entity_StopFXArray( cage.button )
	}

	if ( IsValid( cage.shootableLock ) )
	{
		cage.shootableLock.MakeInvisible()
		cage.shootableLock.NotSolid()
		cage.shootableLock.UnsetUsable()
		Entity_StopFXArray( cage.shootableLock )
	}
	if ( IsValid( cage.controlPanel ) )
	{
		cage.controlPanel.MakeInvisible()
		cage.controlPanel.NotSolid()
		cage.controlPanel.UnsetUsable()
	}
}

void function CreatureCageDestroy( string instanceName )
{
	CreatureCage cage = expect CreatureCage( GetCreatureCageByInstanceName( instanceName ) )
	Assert( cage.isSpawned, "Trying to despawn a creature cage that has not been spawned: " + instanceName )
	CreatureCageDespawn( instanceName ) //deletes and disables some elements, normally to be later respawned

	//-------------------------------------------------------------
	// Destroy every additional element, never to be spawned again
	//--------------------------------------------------------------
	//Remove from file.creatureCages array
	for ( int i = file.creatureCages.len() - 1; i >= 0; i-- )
	{
		if ( file.creatureCages[ i ].cageInstanceName == instanceName )
			file.creatureCages.remove( i )
	}

	//Destroy everything else
	if ( IsValid ( cage.cageDoorNavmeshSeperator ) )
	{
		ToggleNPCPathsForEntity( cage.cageDoorNavmeshSeperator, true )
		cage.cageDoorNavmeshSeperator.NotSolid()
		cage.cageDoorNavmeshSeperator.Destroy()
	}

	if ( cage.cageNavmeshSeperators.len() > 0 )
	{
		foreach( navblocker in cage.cageNavmeshSeperators )
		{
			ToggleNPCPathsForEntity( navblocker, true )
			navblocker.NotSolid()
			navblocker.Destroy()
		}
	}

	if ( IsValid( cage.door ) )
		cage.door.Destroy()

	if ( IsValid( cage.controlPanel ) )
		cage.controlPanel.Destroy()

	if ( IsValid( cage.button ) )
		cage.button.Destroy()

	if ( IsValid( cage.dangerousAreaEnt ) )
		cage.dangerousAreaEnt.Destroy()

	if ( cage.creatures.len() > 0 )
	{
		foreach( npc in cage.creatures )
		{
			if ( IsAlive( npc ) )
				npc.Destroy()
		}
	}
}

void function CreatureCageThink( CreatureCage cage )
{
	Assert( IsNewThread(), "Must be threaded off." )
	//----------------------------------------
	// Dangerous areas to push creatures out
	//----------------------------------------
	float dangerousAreaSize
	if ( IsGoliathCage( cage.cageModelAsset ) )
		dangerousAreaSize = 204.0
	else
		dangerousAreaSize = 92.0

	cage.cageModel.EndSignal( "OnDestroy" )
	cage.cageModel.EndSignal( "CreatureCageDespawned" )
	vector buttonPos
	if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
		buttonPos = cage.controlPanel.GetOrigin()
	else if ( cage.cageButtonType == eCageButtonType.SHOOTABLELOCK )
		buttonPos = cage.shootableLock.GetOrigin()
	else //standard console button
		buttonPos = cage.button.GetOrigin()

	while( true )
	{
		//Cage is LOCKED
		if ( cage.isLocked && cage.cageButtonType == eCageButtonType.CONSOLE )
		{
			Entity_StopFXArray( cage.button ) //HACK: should do this in global script for button
			cage.button.SetSkin( 0 ) //Hack: swapping console skin to show it's locked
		}
		while ( cage.isLocked )
			wait 0.1


		if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
		{
			cage.controlPanel.SetUsable()
		}
		else if ( cage.cageButtonType == eCageButtonType.CONSOLE )
		{
			cage.button.SetUsable()
			cage.button.SetSkin( 1 ) //Hack: swapping console skin to show it's unlocked
		}
		else //shootable lock
		{

		}


		//-------------------------------------------------------
		// Wait for panel or switch to be activated, open/close door
		//-------------------------------------------------------
		if ( cage.isOpen )
		{
			if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
				SetControlPanelUsePrompts( cage.controlPanel, "#PVEOBJECTIVE_CLOSE_CREATURE_CAGE", "#PVEOBJECTIVE_CLOSE_CREATURE_CAGE" )

			if ( cage.cageButtonType == eCageButtonType.CONSOLE )
				cage.button.SetUsePrompts( "#PVEOBJECTIVE_CLOSE_CREATURE_CAGE", "#PVEOBJECTIVE_CLOSE_CREATURE_CAGE" )
		}

		else
		{
			if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
				SetControlPanelUsePrompts( cage.controlPanel, "#PVEOBJECTIVE_OPEN_CREATURE_CAGE", "#PVEOBJECTIVE_OPEN_CREATURE_CAGE" )

			if ( cage.cageButtonType == eCageButtonType.CONSOLE )
				cage.button.SetUsePrompts( "#PVEOBJECTIVE_OPEN_CREATURE_CAGE", "#PVEOBJECTIVE_OPEN_CREATURE_CAGE" )
		}

		//------------------------------------------
		// Wait till Control panel or button used
		//------------------------------------------
		if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
		{
			cage.controlPanel.WaitSignal( "PanelReprogram_Success" )
		}
		else if ( cage.cageButtonType == eCageButtonType.SHOOTABLELOCK )
		{
			waitthread ButtonWaitForActivateOrReset( cage.shootableLock )
		}
		else //standard console button
		{
			waitthread ButtonWaitForActivateOrReset( cage.button )
		}

		//hack: need a cleaner way to get player directly from button press or console hack
		cage.lastPlayerToOpen = GetClosest( GetPlayerArray_AliveConnected(), buttonPos )

		//----------------------
		// Open/Close the door
		//-----------------------
		if ( cage.isOpen )
		{
			Signal( cage.door, "CloseDoor" )
			cage.isOpen = false
		}
		else
		{
			Signal( cage.door, "OpenDoor" )
			cage.cageModel.Signal( SIGNAL_CREATURE_CAGE_OPENED )
			cage.isOpen = true
		}

		//-------------------------------
		// Toggle locked antenna lights
		//-------------------------------
		CreatureCageLightsToggle( cage )


		//----------------------------------------------
		// Create dangerous area to make creatures exit
		//----------------------------------------------
		if ( cage.hasCreatures )
		{
			cage.hasCreatures = false
			//TODO: dangerous area causes creatures to freeze since they are missing dodge anims
			//thread CreatureCageCreateTemporaryDangerousArea( cage.dangerousAreaEnt.GetOrigin(), dangerousAreaSize )
		}

		//-------------------------------
		// Button/panel unusable for a moment
		//-------------------------------
		WaitFrame()
		if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
			cage.controlPanel.UnsetUsable()
		else if ( cage.cageButtonType == eCageButtonType.CONSOLE )
			cage.button.UnsetUsable()
		else //shootable lock
		{
			ScriptToyChangeStatusLights( cage.shootableLock, $"runway_light_green" )
			Highlight_ClearNeutralHighlight( cage.shootableLock )
			Highlight_ClearFriendlyHighlight( cage.shootableLock )
			Highlight_ClearEnemyHighlight( cage.shootableLock )
			break
		}

		wait 2

	}

}


void function ButtonWaitForActivateOrReset( entity button )
{
	if ( !IsValid( button ) )
		return
	button.EndSignal( "OnDestroy" )
	button.EndSignal( "SwitchActivate" )
	button.EndSignal( "SwitchReset" )

	WaitForever()
}


void function CreatureCageCreateTemporaryDangerousArea( vector dangerousAreaEntPos, float dangerousAreaSize )
{
	entity tempDangerousAreaEnt = CreateInfoTarget( dangerousAreaEntPos, <0, 0, 0> )
	AI_CreateDangerousArea_Static( tempDangerousAreaEnt, null, dangerousAreaSize, TEAM_INVALID, true, true, dangerousAreaEntPos )
	wait 3
	tempDangerousAreaEnt.Destroy()

}

void function ScriptCageCreatureThink( SkitInstance si, CreatureCage cage, int npcType, vector origin, vector angles, string animIdle, bool isCritical )
{
	Assert( IsNewThread(), "Must be threaded off." )

	//--------------------------------------------
	// use prop dynamics to show creatures before door opens
	//--------------------------------------------
	/*CreatureSetStateCaged( creature )
	MakeInvincible( creature )
	creature.SetNoTarget( true )
	creature.SetNoTargetSmartAmmo( true )
	float initialTime = RandomFloatRange( 0, creature.GetSequenceDuration( animIdle ) )

	thread PlayAnimTeleport( creature, animIdle, origin, angles, initialTime )*/
	asset propModel
	bool hasPropModel = false
	entity prop
	switch ( npcType )
	{
                  
                   
                                                         
                      
        
                        

                    
                     
                                                           
                      
        
                          

                   
		case eNPC.PROWLER:
			propModel = GetNPCAsset( eNPC.PROWLER, eNPCAsset.BODY )
			hasPropModel = true
			break
                         

                   
                    
                                                          
                      
        
                             

		default:
			Warning( "%s() -- no prop model specified for NPC type %d; no prop will be spawned!", FUNC_NAME(), npcType )
			break
	}
	if ( hasPropModel )
	{
		prop = CreatePropDynamic( propModel, origin, angles, 0, 2000 )
		float initialTime = RandomFloatRange( 0, prop.GetSequenceDuration( animIdle ) )
		thread PlayAnimTeleport( prop, animIdle, origin, angles, initialTime )
		cage.propCreatures.append( prop )
	}

	//--------------------------------------------
	// //TODO - Creatures swap anims and get agitated when player close
	//--------------------------------------------

	//--------------------------------------------
	// Door opened, creatures become real AI
	//--------------------------------------------
	cage.cageModel.WaitSignal( SIGNAL_CREATURE_CAGE_OPENED )

	/*ClearInvincible( creature )
	creature.Anim_Stop()
	CreatureSetStateFree( creature )
	thread CreatureAnimateOutOfCage( creature, cage )
	wait 1
	creature.SetNoTargetSmartAmmo( false )
	creature.SetNoTarget( false )*/

	if ( prop != null )
	{
		cage.propCreatures.fastremovebyvalue( prop )
		prop.Destroy()
	}

                  
                                           
                       
	bool isGoliath = false
                                

	string squadName = "cageCreatures_" + UniqueString()
	entity creature
	if ( isCritical )
		creature = SkNPC_SpawnNPC( si, npcType, origin, angles )
	else
	{
		entity ornull creatureRaw = SkNPC_SpawnNonCriticalNPC( si, npcType, origin, angles )
		if ( creatureRaw == null )
			return
		creature = expect entity( creatureRaw )
	}

	if ( !isGoliath )
		creature.SetSquad( squadName )

	CreatureSetStateFree( creature )
	thread CreatureAnimateOutOfCage( creature, cage )

	cage.creatures.append( creature )
	cage.hasCreatures = true
}

void function CreatureSetStateCaged( entity npc )
{
	if ( !IsAlive( npc ) )
		return

	npc.e.isOpen = false
}

void function CreatureAnimateOutOfCage( entity npc, CreatureCage cage )
{
	if ( !IsAlive( npc ) )
		return

	npc.EndSignal( "OnDeath" )
	string classname = npc.GetClassName()
	if ( classname != "npc_goliath" )
		return

	if ( cage.exitAnimation != "" )
		waitthread PlayAnimTeleport( npc, cage.exitAnimation, npc.GetOrigin(), npc.GetAngles() )
	DropToGround( npc )
}

void function CreatureSetStateFree( entity npc )
{
	if ( !IsAlive( npc ) )
		return

	npc.e.isOpen = true
}

bool function CreatureIsCaged( entity npc )
{
	if ( !IsAlive( npc ) )
		return false

	return !npc.e.isOpen
}

void function LockCreatureCage( CreatureCage cage )
{
	//Assert( !cage.isOpen, "Cannot LockCreatureCage unless it is closed: " + cage.cageModelOrigin )
	if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
		cage.controlPanel.UnsetUsable()
	else
		cage.button.UnsetUsable()

	cage.isLocked = true

}

void function UnlockCreatureCage( CreatureCage cage )
{
	//Assert( !cage.isOpen, "Cannot UnlockCreatureCage unless it is closed: " + cage.cageModelOrigin )
	if ( cage.cageButtonType == eCageButtonType.HACKPANEL )
		cage.controlPanel.SetUsable()
	else
		cage.button.SetUsable()
	cage.isLocked = false
}

