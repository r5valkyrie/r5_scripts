array <entity> function FireBlockerActivate( string scriptNoteworthy )
{
	array <entity> fireBlockerNavmeshSeparators = GetFireBlockersByScriptNoteworthy( scriptNoteworthy )
	foreach( fireBlockerNavmeshSeparator in fireBlockerNavmeshSeparators )
	{
		ToggleNPCPathsForEntity( fireBlockerNavmeshSeparator, false )
		array <entity> fireNodes = fireBlockerNavmeshSeparator.GetLinkEntArray()
		foreach( node in fireNodes )
		{
			FireblockerCreateFire( node )
			AI_CreateDangerousArea_Static( svGlobal.worldspawn, node, 128, TEAM_INVALID, true, true, node.GetOrigin() )

		}

	}
	return fireBlockerNavmeshSeparators
}

void function FireBlockerActivateAll()
{
	foreach( ent in file.fireBlockers )
		FireBlockerActivate( expect string( ent.kv.script_noteworthy ) )
}

void function FireblockerCreateFire( entity node )
{
	//TODO - temp workaround for heavy proto fire fx
	int effectIndex = GetParticleSystemIndex( FIRE_BLOCKER_FIRE )
	entity fx = PlayLoopFX( FIRE_BLOCKER_FIRE, node.GetOrigin(), AnglesCompose( node.GetAngles(), <0, 90, 0> ) )
	EmitSoundAtPosition( TEAM_UNASSIGNED, node.GetOrigin(), "Canyonlands_Generic_Emit_Fire_Medium_A", node )
	entity trigger = SpawnRadiusTrigger( node.GetOrigin(), 60, 60 )
	FireTriggerInit( trigger )
}


