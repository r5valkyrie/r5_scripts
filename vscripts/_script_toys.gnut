void function NavmeshSeparatorThink( entity separator )
{
	bool connected = true
	if ( separator.HasKey( "startDisconnected" ) && separator.kv.startDisconnected == "1" )
		connected = false

	ToggleNPCPathsForEntity( separator, connected )
	if ( connected )
		separator.NotSolid()
	else
		separator.Solid()

	if ( separator.HasKey( "script_flag" ) && separator.kv.script_flag != "" )
	{
		string flag = string( separator.kv.script_flag )
		FlagInit( flag, connected )

		while ( IsValid( separator ) )
		{
			if ( connected )
				FlagWaitClear( flag )
			else
				FlagWait( flag )

			connected = !connected
			ToggleNPCPathsForEntity( separator, connected )
			if ( connected )
				separator.NotSolid()
			else
				separator.Solid()
		}
	}
}

void function ParticleSystemInit( entity particleSystem )
{
	// Effects are often played at long distances and many effects were not showing up once hibernation was turned on by default
	particleSystem.DisableHibernation()

	if ( IsConnectedToTriggerActivate( particleSystem ) )
	{
		thread ParticleSystemTriggerActivate( particleSystem )
		return
	}

	if ( !particleSystem.HasKey( "script_flag" ) )
		return

	string flag = string( particleSystem.kv.script_flag )
	if ( flag == "" )
		return

	bool startActive = false
	if ( particleSystem.HasKey( "start_active" ) )
		startActive = particleSystem.kv.start_active == "1"

	FlagInit( flag, startActive )

	thread ParticleSystemFlagThink( particleSystem, flag, startActive )
}

void function ParticleSystemFlagThink( entity particleSystem, string flag, bool startActive )
{
	bool playEndCap = false
	if ( particleSystem.HasKey( "playEndCap" ) )
		playEndCap = particleSystem.kv.playEndCap == "1"

	float lifetime = 0.0
	if ( particleSystem.HasKey( "lifetime" ) )
		lifetime = float( particleSystem.kv.lifetime )

	bool hasLifetime = lifetime > 0.0

	float startDelay = 0
	if ( particleSystem.HasKey( "start_delay" ) )
		startDelay = float( particleSystem.kv.start_delay )

	float stopDelay = 0
	if ( particleSystem.HasKey( "stop_delay" ) )
		stopDelay = float( particleSystem.kv.stop_delay )

	bool flagReverse = false
	if ( particleSystem.HasKey( "flag_reverse" ) )
		flagReverse = particleSystem.kv.flag_reverse == "1"

	if ( hasLifetime && startActive && IsValid( particleSystem ) )
	{
		wait lifetime
		waitthread ParticleSystemStop( particleSystem, playEndCap, stopDelay )
	}

	while ( IsValid( particleSystem ) )
	{
		if ( !Flag( flag ) )
		{
			FlagWait( flag )
			if ( flagReverse && !hasLifetime )
			{
				waitthread ParticleSystemStop( particleSystem, playEndCap, stopDelay )
			}
			else
			{
				waitthread ParticleSystemStart( particleSystem, startDelay )
				if ( hasLifetime )
				{
					wait lifetime
					waitthread ParticleSystemStop( particleSystem, playEndCap, stopDelay )
				}
			}
		}

		if ( Flag( flag ) )
		{
			FlagWaitClear( flag )
			if ( flagReverse )
			{
				waitthread ParticleSystemStart( particleSystem, startDelay )
				if ( hasLifetime )
				{
					wait lifetime
					waitthread ParticleSystemStop( particleSystem, playEndCap, stopDelay )
				}
			}
			else if ( !hasLifetime )
			{
				waitthread ParticleSystemStop( particleSystem, playEndCap, stopDelay )
			}
		}
	}
}

void function ParticleSystemTriggerActivate( entity particleSystem )
{
	particleSystem.EndSignal( "OnDestroy" )

	waitthread WaitForTriggerActivate( particleSystem )
	ParticleSystemStart( particleSystem, 0.0 )
}

void function ParticleSystemStart( entity particleSystem, float delay )
{
	if ( delay > 0 )
		wait delay
	EntFireByHandle( particleSystem, "Start", "", 0, null, null )
}

void function ParticleSystemStop( entity particleSystem, bool playEndCap, float delay )
{
	if ( delay > 0 )
		wait delay

	if ( playEndCap )
		EntFireByHandle( particleSystem, "StopPlayEndCap", "", 0, null, null )
	else
		EntFireByHandle( particleSystem, "Stop", "", 0, null, null )
}

void function ScriptedSoundEffectThink( entity ent )
{
	EndSignal( ent, "OnDestroy" )

	string flag
	bool startActive = ent.HasKey( "start_active" ) && ent.kv.start_active == "1"
	string soundAlias = string( ent.kv.soundName )
	float fadeinDuration = float( ent.kv.fadein_duration )
	float fadeoutDuration = float( ent.kv.fadeout_duration )

	Assert( soundAlias != "" )

	if ( ent.HasKey( "script_flag" ) && ent.kv.script_flag != "" )
	{
		flag = string( ent.kv.script_flag )
		FlagInit( flag, startActive )
	}

	wait 0.2

	if ( startActive && flag == "" )
		EmitSoundOnEntity( ent, soundAlias )

	if ( IsConnectedToTriggerActivate( ent ) )
	{
		waitthread WaitForTriggerActivate( ent )
		EmitSoundOnEntity( ent, soundAlias )
		return
	}

	if ( flag == "" )
		return

	float startDelay = 0
	if ( ent.HasKey( "start_delay" ) )
		startDelay = float( ent.kv.start_delay )

	while ( IsValid( ent ) )
	{
		if ( Flag( flag ) )
		{
			wait startDelay
			EmitSoundOnEntity( ent, soundAlias )
			FlagWaitClear( flag )
		}
		else
		{
			if ( fadeoutDuration > 0 )
				FadeOutSoundOnEntity( ent, soundAlias, fadeoutDuration )
			else
				StopSoundOnEntity( ent, soundAlias )
			FlagWait( flag )
		}
	}
}

void function InfoTextPanelsCreate()
{
	while ( GetPlayerArray().len() == 0 )
		WaitFrame()

	int max_remote_calls_per_frame = 10
	int num_remote_calls_this_frame = 0

	foreach ( entity ent in file.infoTextPanels )
	{
		// Build the message on the client
		string titleText = ""
		if ( ent.HasKey( "title" ) )
			titleText = ent.GetValueForKey( "title" )

		string mainText = ""
		if ( ent.HasKey( "text" ) )
			mainText = ent.GetValueForKey( "text" )

		for ( int textIndex = 2; ent.HasKey( "text" + textIndex ); textIndex++ )
		{
			string line = ent.GetValueForKey( "text" + textIndex )
			if ( line != "" )
				mainText += "\n" + ent.GetValueForKey( "text" + textIndex )
		}

		vector origin = ent.GetOrigin()
		vector angles = AnglesCompose( ent.GetAngles(), <0,180,0> )
		bool showPin = ( ent.HasKey( "show_pin" ) && ent.GetValueForKey( "show_pin" ) == "1" )
		float textScale = 1.0
		foreach ( entity player in GetPlayerArray() )
		{
			if ( !IsValid( player ) )
				continue

			Remote_CallFunction_NonReplay( player, "Dev_CreateTextInfoPanel", origin, angles, showPin, textScale )

			num_remote_calls_this_frame++
			//printt( "Dev_BuildTextInfoPanel", num_remote_calls_this_frame )
			if ( num_remote_calls_this_frame >= max_remote_calls_per_frame )
			{
				num_remote_calls_this_frame = 0
				//printt( "Dev_BuildTextInfoPanel PAUSE" )
				WaitFrame()
			}
		}

		WaitFrame()
	}
}

void function PlayEditorDefaultAnim( entity ent )
{
	if ( !ent.HasKey( "DefaultAnim" ) )
		return

	string animStr = expect string( ent.kv.DefaultAnim )
	if ( animStr == "" )
		return

	thread PlayEditorDefaultAnim_Think( ent, animStr )
}

void function PlayEditorDefaultAnim_Think( entity ent, string animStr )
{
	ent.EndSignal( "OnDestroy" )
	ent.EndSignal( "NewFirstPersonSequence" )
	ent.EndSignal( "StopEditorDefaultAnim" )

	OnThreadEnd(
	function() : ( ent )
		{
			if ( IsValid( ent ) )
				ent.Anim_Stop()
		}
	)

	while ( true )
	{
		ent.Anim_Play( animStr )
		if ( ent.HasKey( "DefaultCycle" ) )
		{
			string defaultCycleString = expect string( ent.kv.DefaultCycle )
			float defaultCycleFloat = float( defaultCycleString )
			ent.SetCycle( defaultCycleFloat )
		}
		WaittillAnimDone( ent )
	}
}


