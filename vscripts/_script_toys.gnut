entity function GetDoorNavmeshSeparatorByScriptNoteworthy( string scriptNoteworthy )
{
	entity doorNavmeshSeparator
	foreach( ent in file.doorNavmeshSeperators )
	{
		if ( ent.kv.script_noteworthy == scriptNoteworthy )
			return ent
	}

	Assert( false, "Unable to find any doorNavmeshSeparator with script_noteworthy: " + scriptNoteworthy )

	unreachable
}

