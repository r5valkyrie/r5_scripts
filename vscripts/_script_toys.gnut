array< table <string, vector> > function GetDefendSpawnsForBreakable( Breakable breakable, float additionalOffset = 0, float additionalOffsetAngled = 0 )
{
	array< table <string, vector> > spawnTable
	array< table <string, vector> > spawnTableToReturn
	vector originBreakable = breakable.origin
	vector anglesBreakable = breakable.angles

	switch( breakable.breakableType )
	{
		case eBreakbleType.GENERATOR:
		case eBreakbleType.CONSOLE: //todo
			float baseOffset = 48 + additionalOffset
			float baseOffsetAngled = 46 + additionalOffsetAngled
			//on all four sides
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, 0, baseOffset, 10 ), angles = AnglesCompose( anglesBreakable, <0, -90, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, 0, -(baseOffset), 10 ), angles = AnglesCompose( anglesBreakable, <0, 90, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, baseOffset, 0, 10 ), angles = AnglesCompose( anglesBreakable, <0, 0, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, -(baseOffset), 0, 10 ), angles = AnglesCompose( anglesBreakable, <0, 180, 0>  ) } )
			//on all four corners
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, baseOffsetAngled, baseOffsetAngled, 10 ), angles = AnglesCompose( anglesBreakable, <0, -45, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, -(baseOffsetAngled), -(baseOffsetAngled), 10 ), angles = AnglesCompose( anglesBreakable, <0, 135, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, baseOffsetAngled, -(baseOffsetAngled), 10 ), angles = AnglesCompose( anglesBreakable, <0, 45, 0>  ) } )
			spawnTable.append( { origin = PositionOffsetFromOriginAngles( originBreakable, anglesBreakable, -(baseOffsetAngled), baseOffsetAngled, 10 ), angles = AnglesCompose( anglesBreakable, <0, -135, 0>  ) } )
			break
		default:
			Assert( false, "Unhandled eBreakbleType: " + breakable.breakableType )
	}

                    
                                             
                                                                                      
                           
                                                                                                 
                                            
                            
                                                                   
                        
                

                                                  
  
                                         
                                         
                              
                              
                                   
   
                                             
   

  
                     
                          

	return spawnTableToReturn
}

array< table <string, vector> > function GetDefendSpawnsForHarvester( Harvester harvester )
{
	array< table <string, vector> > spawnTableToReturn

	foreach( generatorNode in harvester.generatorControlNodes )
	{
		Breakable generator = expect Breakable( GetBreakableByControlNode( generatorNode ) )
		GetBreakableByControlNode( generatorNode )
		float additionalDefenderOffset = 56 //push some of these guys outside the bubble shield so they can shoot
		float additionalDefenderOffsetCorner = 56
		array< table <string, vector> > spawnTable = GetDefendSpawnsForBreakable( generator, additionalDefenderOffset, additionalDefenderOffsetCorner )
		spawnTableToReturn.extend( spawnTable )
	}

	return spawnTableToReturn
}

void function BreakableDespawn( Breakable breakable )
{
	WaitFrame() //ensure we are running after generic navmesh_separator and door scripts

	Assert( breakable.isSpawned, "Trying to despawn a breakable that has not been spawned at " + breakable.origin )
	breakable.isSpawned = false
	ToggleNPCPathsForEntity( breakable.navmeshSeperator , true )
	breakable.navmeshSeperator.NotSolid()
	WaitFrame()
	foreach( fx in breakable.fx )
	{
		if ( IsValid( fx ) )
			fx.Destroy()
	}

	if ( IsValid( breakable.model ) )
		breakable.model.Destroy()

	if ( IsValid( breakable.modelDestroyed ) )
		breakable.modelDestroyed.Destroy()

	foreach ( flag in breakable.flags )
		FlagClear( flag )

	foreach( ent in breakable.poweredItems )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}

}

void function BreakableDespawnByInstanceName( string instanceName )
{
	WaitFrame() //ensure we are running after generic navmesh_separator and door scripts

	Breakable breakable = expect Breakable( GetBreakableByInstanceName( instanceName ) )
	BreakableDespawn( breakable )

}

Breakable function BreakableSpawn( Breakable breakable )
{
	Assert( !breakable.isSpawned, "Trying to spawn a breakable that has already been spawned: " + breakable.instanceName )
	Assert( !IsValid( breakable.model ), "Trying to spawn a new breakable model that already exists: " + breakable.instanceName )

	float health
	string usePrompt
	string idleSound
	asset idleFx
	string idleFxTag

	switch ( breakable.breakableType )
	{
		case eBreakbleType.CONSOLE:
			health = BREAKABLE_HEALTH_CONSOLE
			usePrompt = "#PVE_HINT_DESTROY_CONSOLE"
			break
		case eBreakbleType.GENERATOR:
			health = BREAKABLE_HEALTH_GENERATOR
			usePrompt = "#PVE_HINT_DESTROY_GENERATOR"
			break
		case eBreakbleType.CREATURE_GAS:
			health = BREAKABLE_HEALTH_CREATURE_GAS
			usePrompt = "#PVE_HINT_DESTROY_CREATURE_GAS"
			idleSound = "canyonlands_generic_emit_steam_medium"
			//idleFx = FX_IDLE_FX_CREATURE_GAS
			//idleFxTag = "fx_top"
			break
		default:
			Assert( false, "Unhandled breakable type at " + breakable.origin )
	}

	breakable.isSpawned = true
	breakable.model = CreatePropScript( breakable.modelAsset, breakable.origin, breakable.angles, SOLID_VPHYSICS )
	breakable.model.kv.instance_name = breakable.instanceName
	if ( IsValid( breakable.navmeshSeperator ) )
	{
		breakable.navmeshSeperator.NotSolid()
		ToggleNPCPathsForEntity( breakable.navmeshSeperator, false )
	}


	if ( idleSound != "" )
		EmitSoundOnEntity( breakable.model, idleSound )

	if ( idleFx != $"" )
		PlayLoopFXOnEntity( idleFx, breakable.model, idleFxTag  )

	SetTeam( breakable.model, eNpcTeam.LEGION )
	Highlight_SetNeutralHighlight( breakable.model, "enemy_sonar" )
	Highlight_SetFriendlyHighlight( breakable.model, "enemy_sonar" )
	Highlight_SetEnemyHighlight( breakable.model, "enemy_sonar" )
	breakable.model.SetUsable()
	breakable.model.SetUsePrompts( usePrompt, usePrompt )

	breakable.model.SetCanBeMeleed( true )
	SetVisibleEntitiesInConeQueriableEnabled( breakable.model, true )
	breakable.model.SetTakeDamageType( DAMAGE_EVENTS_ONLY )
	breakable.model.SetDamageNotifications( true )
	breakable.model.SetMaxHealth( health )
	breakable.model.SetHealth( health )
	breakable.model.DisableHibernation()
	breakable.controlNode.SetParent( breakable.model )

	AddEntityCallback_OnDamaged( breakable.model,
		void function ( entity breakableModel, var damageInfo ) : ( breakable )
		{
			if ( !IsValid( breakableModel ) )
			{
				// sometimes OnDamage gets called twice in the same frame, ( scorch's fire )
				// and first call destroys breakable in BreakableDestroy()
				return
			}

			entity attacker = DamageInfo_GetAttacker( damageInfo )
			if ( !IsValid( attacker ) )
				return

			if ( !attacker.IsPlayer() )
				return

			float damage = DamageInfo_GetDamage( damageInfo )

			int health = breakableModel.GetHealth()
			health -= int( damage )

			breakable.lastTimeAttacked = Time()
			breakable.lastTimeAttacker = attacker
			if ( health <= 0 )
				BreakableDestroy( breakable, attacker )
			else
				breakableModel.SetHealth( health )
		}
	)

	breakable.poweredItems = []

	return breakable
}

Breakable function BreakableSpawnByInstanceName( string instanceName )
{
	Breakable breakable = expect Breakable( GetBreakableByInstanceName( instanceName ) )
	breakable = BreakableSpawn( breakable )
	return breakable
}

Breakable function BreakableSpawnByType( int breakableType, vector origin, vector angles )
{
	//HACK: placeholder to spawn a breakable for Halloween until I can refactor
	Breakable breakable
	breakable.controlNode = CreateInfoTarget( origin, angles )
	breakable.modelAsset = MODEL_CREATURE_GAS
	breakable.modelAssetDestroyed = MODEL_CREATURE_GAS_DESTROYED
	breakable.origin = origin
	breakable.angles = angles
	breakable.isDestroyed = false
	breakable.isSpawned = false
	breakable.breakableType = breakableType

	return BreakableSpawn( breakable )
}

void function BreakableDestroy( Breakable breakable, entity attacker )
{
	entity breakableModel = breakable.model
	breakable.modelDestroyed = CreatePropDynamic( breakable.modelAssetDestroyed, breakable.origin, breakable.angles, SOLID_VPHYSICS )
	if ( breakableModel.GetParent() )
		breakable.modelDestroyed.SetToSameParentAs( breakableModel )

	breakableModel.Signal( SIGNAL_BREAKABLE_DESTROYED )
	breakable.controlNode.Signal( SIGNAL_BREAKABLE_DESTROYED )

	breakable.killer = attacker
	breakable.isDestroyed = true
	breakable.modelDestroyed.AllowMantle()
	breakable.modelDestroyed.DisableHibernation()
	vector origin = breakableModel.GetOrigin()
	vector up = breakableModel.GetUpVector()
	vector upAngles = VectorToAngles( up )

	string sfxExplosion
	string sfxSparksEnd01
	string sfxSparksEnd02
	asset fxExplosion
	asset fxFireEnd
	asset fxSparksEnd
	asset fxSteamEnd
	float shakeAmplitude
	float shakeFrequency
	float shakeDuration
	float shakeRadius
	vector sparkEndOrigin
	vector sparkEndAngles
	vector steamOrigin
	vector steamAngles
	vector fireEndOrigin
	vector fireEndAngles

	switch ( breakable.breakableType )
	{
		case eBreakbleType.CONSOLE:
			sfxExplosion = "ai_reaper_explo_3p"
			sfxSparksEnd01 = "spectre_vs_spectre_execution_zap_sparks_3p"
			sfxSparksEnd02 = "sewers_emit_intermittentsparks"
			fxExplosion = FX_EXPLOSION_CONSOLE
			fxFireEnd = FX_FIRE_END_CONSOLE
			fxSparksEnd = FX_SPARKS_END_CONSOLE
			fxSteamEnd = FX_STEAM_END_CONSOLE
			shakeAmplitude = 7
			shakeFrequency = 0.15
			shakeDuration = 1.2
			shakeRadius = 512
			sparkEndOrigin = PositionOffsetFromEnt( breakableModel, -6, 4, 20 ) + ( up * 30 )
			sparkEndAngles = upAngles
			steamOrigin = PositionOffsetFromEnt( breakableModel, -16, 0, 12 ) + ( up * 40 )
			steamAngles = upAngles
			fireEndOrigin = PositionOffsetFromEnt( breakableModel, 16, 10, 48 )
			fireEndAngles = breakable.angles
			break
		case eBreakbleType.GENERATOR:
			sfxExplosion = "BatteryCrate_Explosion"
			sfxSparksEnd01 = "spectre_vs_spectre_execution_zap_sparks_3p"
			sfxSparksEnd02 = "sewers_emit_intermittentsparks"
			fxExplosion = FX_EXPLOSION_GENERATOR
			fxFireEnd = FX_FIRE_END_GENERATOR
			fxSparksEnd = FX_SPARKS_END_GENERATOR
			fxSteamEnd = FX_STEAM_END_GENERATOR
			shakeAmplitude = 7
			shakeFrequency = 0.15
			shakeDuration = 2
			shakeRadius = 2048
			sparkEndOrigin = origin + ( up * 30 )
			sparkEndAngles = upAngles
			steamOrigin = origin + ( up * 40 )
			steamAngles = upAngles
			fireEndOrigin = steamOrigin + <0, 0, -16>
			fireEndAngles = <0, 0, 0>
			break
		case eBreakbleType.CREATURE_GAS:
			sfxExplosion = "ai_reaper_explo_3p"
			fxSteamEnd = FX_STEAM_END_CREATURE_GAS
			fxExplosion = FX_EXPLOSION_CREATURE_GAS
			fxFireEnd = FX_FIRE_END_CREATURE_GAS
			shakeAmplitude = 7
			shakeFrequency = 0.15
			shakeDuration = 1.2
			steamOrigin = origin + <0, 0, 4>
			steamAngles = upAngles
			shakeRadius = 512
			fireEndOrigin = origin + <0, 0, 4>
			fireEndAngles = <0,0,0>
			break
		default:
			Assert( false, "Unhandled breakable type at " + breakable.origin )
	}

	EmitSoundOnEntity( breakable.modelDestroyed, sfxExplosion )
	StartParticleEffectOnEntity( breakable.modelDestroyed, GetParticleSystemIndex( fxExplosion ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	CreateShake( breakable.origin, shakeAmplitude, shakeFrequency, shakeDuration, shakeRadius )

	if ( fxSparksEnd != "" )
		breakable.fx.append( PlayFX( fxSparksEnd, sparkEndOrigin, sparkEndAngles ) )

	if ( fxSteamEnd != "" )
		breakable.fx.append( PlayFX( fxSteamEnd, steamOrigin, steamAngles ) )

	if ( fxFireEnd != "" )
		breakable.fx.append( PlayFX( fxFireEnd, fireEndOrigin, fireEndAngles ) )

	if ( sfxSparksEnd01 != "" )
		EmitSoundAtPosition( TEAM_UNASSIGNED, sparkEndOrigin, sfxSparksEnd01, breakable.modelDestroyed)

	if ( sfxSparksEnd02 != "" )
		EmitSoundAtPosition( TEAM_UNASSIGNED, sparkEndOrigin, sfxSparksEnd02, breakable.modelDestroyed )

	//SpawnMatchCandyForPlayer( attacker, 110, breakable.origin )

	foreach ( flag in breakable.flags )
		FlagSet( flag )

	foreach( ent in breakable.poweredItems )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}
	breakableModel.Destroy()
}

Breakable ornull function GetBreakableByInstanceName( string instanceName )
{
	foreach( breakable in file.breakables )
	{
		if ( breakable.instanceName == instanceName )
			return breakable
	}
	printf( "%s() - There is no breakable with instance_name: " + instanceName, FUNC_NAME() )

	return null
}

Breakable ornull function GetBreakableByControlNode( entity controlNode )
{
	foreach( breakable in file.breakables )
	{
		if ( breakable.controlNode == controlNode )
			return breakable
	}
	return null
}

void function BreakableSetFlagOnDestroyed( Breakable breakable, string flagToSet )
{
	if ( !FlagExists( flagToSet ) )
		FlagInit( flagToSet )
	foreach ( flag in breakable.flags )
	{
		if ( flag == flagToSet )
			Assert( false, flagToSet + "flag has already been added to breakable flags at " + breakable.origin )
	}

	breakable.flags.append( flagToSet )
}


