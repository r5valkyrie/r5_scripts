#if SERVER
bool function __VoucherRewardImmediateOrGRXLogic( ItemFlavor voucherFlav )
{
	bool rewardUsingGRX = false
	switch ( Voucher_GetBehavior( voucherFlav ) )
	{
		case eVoucherBehavior.IMMEDIATE:
			Assert( ItemFlavor_GetGRXMode( voucherFlav ) == eItemFlavorGRXMode.NONE, format( "Voucher flav %s is set to %s but has GRX mode %s", string(ItemFlavor_GetAsset( voucherFlav )), GetEnumStringSlow( eVoucherBehavior, Voucher_GetBehavior( voucherFlav ) ), GetEnumStringSlow( eItemFlavorGRXMode, ItemFlavor_GetGRXMode( voucherFlav ) ) ) )
			break

		case eVoucherBehavior.STACKABLE_SCRIPT_DRIVEN:
			Assert( false, format( "Something tried to reward a voucher (%s) which has a script-driven stack count", string(ItemFlavor_GetAsset( voucherFlav )) ) )
			break

		case eVoucherBehavior.GRX_STACKABLE:
		case eVoucherBehavior.GRX_CONSUMABLE_INSTANT:
		case eVoucherBehavior.GRX_CONSUMABLE_OVER_TIME:
			Assert( ItemFlavor_GetGRXMode( voucherFlav ) == eItemFlavorGRXMode.CONSUMABLE, format( "Voucher flav %s is set to %s but has GRX mode %s", string(ItemFlavor_GetAsset( voucherFlav )), GetEnumStringSlow( eVoucherBehavior, Voucher_GetBehavior( voucherFlav ) ), GetEnumStringSlow( eItemFlavorGRXMode, ItemFlavor_GetGRXMode( voucherFlav ) ) ) )
			rewardUsingGRX = true
			break

		default:
			Assert( false )
			break
	}
	return rewardUsingGRX
}
#endif

#if SERVER
void function __VoucherDoImmediateReward( entity player, ItemFlavor voucherFlav, int qty, ItemFlavor ornull sourceFlav )
{
	Assert( Voucher_GetBehavior( voucherFlav ) == eVoucherBehavior.IMMEDIATE )
	ApplyVoucherActivationEffects( player, voucherFlav, qty, sourceFlav )
}
#endif

#if SERVER
void function ApplyVoucherActivationEffects( entity player, ItemFlavor voucherFlav, int voucherQty, ItemFlavor ornull sourceFlav )
{
	int battlePassLevels = Voucher_GetEffectBattlepassLevels( voucherFlav ) * voucherQty
	if ( battlePassLevels > 0 )
	{
		ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
		if ( activeBattlePass != null )
		{
			expect ItemFlavor(activeBattlePass)
			AddPlayerBattlePassLevels( player, battlePassLevels )
		}
		else
		{
			Warning( "Player (%s) earned %d BP levels from voucher (%s) but no BattlePass is active.", string(player), battlePassLevels, string(ItemFlavor_GetAsset( voucherFlav )) )
		}
	}

	int stars = Voucher_GetEffectBattlepassStars( voucherFlav ) * voucherQty
	if ( stars > 0 )
	{
		ItemFlavor ornull activeBattlePass = GetPlayerActiveBattlePass( player )
		if ( activeBattlePass != null )
		{
			if ( sourceFlav != null )
			{
				expect ItemFlavor( sourceFlav )
				int bonusStars = Boost_GetBonus( player, stars, eBoostModifierType.BP_STARS, Boost_GetChallengeCategory( sourceFlav ) )
				if ( bonusStars > 0 )
				{
					Boost_Sv_AddToPostGameChallengeBonus( player, sourceFlav.guid, bonusStars )
					stars += bonusStars
				}
			}
			AddBPStars( player, stars )
		}
		else
			Warning( "Player (%s) earned %d stars from voucher (%s) but no BattlePass is active.", string(player), stars, string(ItemFlavor_GetAsset( voucherFlav )) )
	}

	int accountXP = Voucher_GetEffectAccountXP( voucherFlav ) * voucherQty
	if ( accountXP > 0 )
	{
		AddXP( player, eXPType.CHALLENGE_REWARD, accountXP )
	}

	string ornull statRef = Voucher_GetEffectStatRef( voucherFlav )
	if ( statRef != null )
	{
		int statIncAmt = Voucher_GetEffectStatAmount( voucherFlav ) * voucherQty
		StatsHook_IncrementStatEntryForChallengeReward( player, expect string(statRef), statIncAmt )
	}

	string ornull persistenceVarNameToInc = Voucher_GetPDefVarNameToIncrement( voucherFlav )
	if ( persistenceVarNameToInc != null )
	{
		IncrementVoucherRedeemedPersistenceVar( player, voucherFlav, voucherQty )
	}

	string ornull pDefVarName = Voucher_GetConsumableUseCountPDefVarName( voucherFlav )
	if ( pDefVarName != null )
	{
		IncrementVoucherRedeemedQuantity( player, voucherFlav, voucherQty )
	}
}
#endif


