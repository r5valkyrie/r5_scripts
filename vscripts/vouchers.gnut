#if SERVER || CLIENT || UI
void function Vouchers_LevelInit()
{
	#if UI
		FileStruct_LifetimeLevel newFileLevel
		fileLevel = newFileLevel
	#endif

	InitScriptDrivenVoucherCallbacks()

	AddCallback_RegisterRootItemFlavors( void function() {
		foreach ( asset voucherAsset in GetBaseItemFlavorsFromArray( "vouchers" ) )
		{
			ItemFlavor ornull flav = RegisterItemFlavorFromSettingsAsset( voucherAsset )
			if ( flav == null )
				continue

			#if SERVER
				expect ItemFlavor( flav )

				asset model = Voucher_GetModel( flav )
				if ( model != $"" )
					PrecacheModel( model )
			#endif
		}
	})

	#if SERVER
		AddCallback_QueueServersideScriptGRXOperations( GivePlayerVoucherRewards )

		#if DEVELOPER
			AddCallback_GeneratePDef( GenerateVouchers_PDef )
		#endif // DEVELOPER
	#endif
}
#endif


#if SERVER || CLIENT || UI
void function InitScriptDrivenVoucherCallbacks()
{
	//fileLevel.voucherFlavGetActiveQuantityFuncMap[$"settings/itemflav/voucher/bp_grind_points_2x_2hrs.rpak"] = int function( entity player ) {
	//
	//}
}
#endif


#if SERVER && DEVELOPER
void function GenerateVouchers_PDef()
{
	DEV_PDefGen_BeginFieldGroup( "Voucher consumable use count data - DO NOT CHANGE OR MARKETPLACE SYNC WILL BREAK" )

	array<string> registeredPDefVarNames
	foreach ( ItemFlavor voucherFlav in GetAllItemFlavorsOfType( eItemType.voucher ) )
	{
		string ornull pDefVarName = Voucher_GetConsumableUseCountPDefVarName( voucherFlav )
		if ( pDefVarName == null )
			continue

		expect string( pDefVarName )
		Assert( !(registeredPDefVarNames.contains(pDefVarName)), string(ItemFlavor_GetAsset( voucherFlav )) + " uses duplicate consumableUseCountPDefVarName '" + pDefVarName + "'" )

		DEV_PDefGen_AddField_Int( pDefVarName )
	}

	DEV_PDefGen_EndFieldGroup()
}
#endif
