#if SERVER
void function GivePlayerVoucherRewards( entity player )
{
	foreach ( ItemFlavor voucherFlav in GetAllItemFlavorsOfType( eItemType.voucher ) )
	{
		if ( ItemFlavor_IsItemDisabledForGRX( voucherFlav ) )
			continue

		string ornull pDefVarName = Voucher_GetConsumableUseCountPDefVarName( voucherFlav )
		if ( pDefVarName == null )
			continue

		expect string( pDefVarName )
		int voucherCount  = Voucher_GetVoucherActiveCount( player, voucherFlav )
		int redeemedCount = GetVoucherRedeemedCount( player, voucherFlav )

		if ( voucherCount > redeemedCount )
		{
			ApplyVoucherActivationEffects( player, voucherFlav, voucherCount - redeemedCount, null)
		}
	}
}
#endif

#if SERVER || CLIENT || UI
ItemFlavor ornull function Voucher_GetCalEventFlav( ItemFlavor flav )
{
	Assert( ItemFlavor_GetType( flav ) == eItemType.voucher )

	asset calEventAsset = WORKAROUND_AssetAppend( GetGlobalSettingsAsset( ItemFlavor_GetAsset( flav ), "calEventFlav" ), ".rpak" )
	if ( IsValidItemFlavorSettingsAsset( calEventAsset ) )
		return GetItemFlavorByAsset( calEventAsset )
	return null
}
#endif


