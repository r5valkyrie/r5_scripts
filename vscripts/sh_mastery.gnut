#if ( CLIENT || UI ) && DEVELOPER
void function DEV_TestGetSpecialInfo()
{
	array<MasteryWeapon_BaseQueryResult> allWeaponData
	foreach ( ItemFlavor weapon in GetAllWeaponItemFlavors() )
	{
		MasteryWeapon_BaseQueryResult ornull baseData = Mastery_GetWeaponBaseData( weapon )
		if ( baseData != null )
			allWeaponData.append( expect MasteryWeapon_BaseQueryResult( baseData ) )
	}
	// top three level weapon
	allWeaponData.sort( int function( MasteryWeapon_BaseQueryResult a, MasteryWeapon_BaseQueryResult b ) {
		if ( a.level < b.level )
			return 1
		if ( a.level > b.level )
			return -1
		return 0
	} )
	for( int i = 0; i < 3; i++ )
	{
		printf( "Top [%d] level weapon-%s", i+1, WeaponItemFlavor_GetClassname( allWeaponData[i].weapon ) )
	}
	// next level up weapon
	allWeaponData.sort( int function( MasteryWeapon_BaseQueryResult a, MasteryWeapon_BaseQueryResult b ) {
		if( a.xp == b.xp )
			return 0
		if ( Mastery_GetWeaponXPPercentToNextLevel( a ) < Mastery_GetWeaponXPPercentToNextLevel( b ) )
			return -1
		if ( Mastery_GetWeaponXPPercentToNextLevel( a ) > Mastery_GetWeaponXPPercentToNextLevel( b ) )
			return 1
		return 0
	} )
	printf( "Next level up weapon-%s", WeaponItemFlavor_GetClassname( allWeaponData[0].weapon ) )
}
#endif

#if CLIENT || UI
float function Mastery_GetWeaponXPPercentToNextLevel( MasteryWeapon_BaseQueryResult weaponData )
{
	Assert( weaponData.level >= 1, "weapon level < 1" )
	int levelStartXP = weaponData.level == 1 ? 0 : Mastery_GetTotalXPToCompleteWeaponLevel( weaponData.level - 1 )
	int levelEndXP = Mastery_GetTotalXPToCompleteWeaponLevel( weaponData.level )
	//printf( "test level start xp:%d, level end xp:%d, total xp this level:%d, current xp:%d, percent:%f, level:%d",
	//	levelStartXP,
	//	levelEndXP,
	//	levelEndXP - levelStartXP,
	//	weaponData.xp,
	//	float( levelEndXP - weaponData.xp ) / float( levelEndXP - levelStartXP ),
	//	weaponData.level)
	return float( levelEndXP - weaponData.xp ) / float( levelEndXP - levelStartXP )
}
#endif

#if CLIENT || UI
MasteryWeapon_BaseQueryResult ornull function Mastery_GetWeaponBaseData( ItemFlavor weapon )
{
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return null
	}
	entity player = GetLocalClientPlayer()
	MasteryWeapon_BaseQueryResult result
	result.xp = player.GetPersistentVarAsInt( fileLevel.weaponConfigMap[weapon].persistenceKey_XP )
	result.level = Mastery_CalculateLevelFromXP( result.xp )
	result.weapon = weapon
	return result
}

array<MasteryWeapon_TrialQueryResult> ornull function Mastery_GetWeaponTrialList( ItemFlavor weapon )
{
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return null
	}
	array<MasteryWeapon_TrialQueryResult> resultList
	array<TrialConfig> trialConfigList = fileLevel.weaponConfigMap[weapon].trialList
	array<MasteryTrialData> trialDataList = fileLevel.localPlayerInfo.weaponDataCache[weapon].trialList
	for ( int i = 0; i < trialConfigList.len(); i++ )
	{
		MasteryWeapon_TrialQueryResult queryResult
		queryResult.trialConfig = trialConfigList[i]
		queryResult.trialData = trialDataList[i]

		foreach( reward in queryResult.trialConfig.rewards )
		{
			MasteryReward masteryReward = clone( reward )
			masteryReward.isOwned = queryResult.trialData.isCompleted
			masteryReward.isTall = false
			queryResult.rewards.append( masteryReward )
		}

		resultList.append( queryResult )
	}
	return resultList
}

// Since this is so far only used by trial celebrations to initialize and then modify showing a past trial state, only trialData is cloned and not trialConfig.
array<MasteryWeapon_TrialQueryResult> ornull function Mastery_GetWeaponTrialListClonedTrialData( ItemFlavor weapon )
{
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return null
	}
	array<MasteryWeapon_TrialQueryResult> resultList
	array<TrialConfig> trialConfigList = clone fileLevel.weaponConfigMap[weapon].trialList
	array<MasteryTrialData> trialDataList = clone fileLevel.localPlayerInfo.weaponDataCache[weapon].trialList
	for ( int i = 0; i < trialConfigList.len(); i++ )
	{
		MasteryWeapon_TrialQueryResult queryResult
		queryResult.trialConfig = trialConfigList[i]

		MasteryTrialData trialData
		trialData.currentValue = trialDataList[i].currentValue
		trialData.isUnlocked   = trialDataList[i].isUnlocked
		trialData.isCompleted  = trialDataList[i].isCompleted
		#if CLIENT && DEVELOPER
			trialData.statInternalValue = trialDataList[i].statInternalValue
			trialData.isStatUnlocked = trialDataList[i].isStatUnlocked
		#endif
		queryResult.trialData = trialData

		foreach ( reward in queryResult.trialConfig.rewards )
		{
			MasteryReward masteryReward = clone( reward )
			masteryReward.isOwned = queryResult.trialData.isCompleted
			masteryReward.isTall = false
			queryResult.rewards.append( masteryReward )
		}

		resultList.append( queryResult )
	}
	return resultList
}

MasteryWeapon_TrialQueryResult ornull function Mastery_GetWeaponFinalTrialData( ItemFlavor weapon )
{
	MasteryWeapon_FinalRewardResult ornull finalReward = Mastery_GetWeaponFinalReward( weapon, 1  )

	if( finalReward == null )
		return null

	expect MasteryWeapon_FinalRewardResult( finalReward )

	if( finalReward.rewards.len() == 0 )
		return null

	MasteryWeapon_TrialQueryResult bonusTrial
	bonusTrial.trialConfig.name = ItemFlavor_GetLongName(finalReward.rewards[0].flav )
	bonusTrial.trialConfig.rewards = finalReward.rewards
	bonusTrial.trialConfig.goal = finalReward.goalVal
	bonusTrial.trialConfig.description = Localize( "#MASTERY_COMPLETE_ALL_TRIALS", Localize( ItemFlavor_GetShortName( weapon ) ) )
	bonusTrial.trialData.isUnlocked = true
	bonusTrial.trialData.isCompleted = finalReward.isCompleted
	bonusTrial.trialData.currentValue = finalReward.curVal

	return bonusTrial
}

MasteryWeapon_FinalRewardResult ornull function Mastery_GetWeaponFinalReward( ItemFlavor weapon, int rewardType )
{
	Assert( rewardType != eFinalRewardType.None && rewardType < eFinalRewardType.COUNT, "[Mastery] Weapon final reward type invalid, " + rewardType )
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return null
	}
	MasteryWeapon_FinalRewardResult result
	if ( rewardType == eFinalRewardType.Five )
	{
		int completedTrialCount               = 0
		array<TrialConfig> trialConfigList    = fileLevel.weaponConfigMap[weapon].trialList
		array<MasteryTrialData> trialDataList = fileLevel.localPlayerInfo.weaponDataCache[weapon].trialList
		for ( int i = 0; i < trialConfigList.len(); i++ )
		{
			TrialConfig trialConfig    = trialConfigList[i]
			MasteryTrialData trialData = trialDataList[i]
			if ( trialConfig.tierLevel <= FINAL_REWARD_FIVE_INDEX )
			{
				if ( trialData.isCompleted )
					completedTrialCount += 1
			}
		}
		result.curVal = completedTrialCount
		result.goalVal = FINAL_REWARD_FIVE_INDEX + 1
		result.isCompleted = result.curVal == result.goalVal
		result.rewards = fileLevel.weaponConfigMap[weapon].finalRewardFive
	}
	return result
}

MasteryWeapon_FinalRewardResult function Mastery_GetAllWeaponReward()
{
	MasteryWeapon_FinalRewardResult result
	int finishedWeaponCount = 0
	foreach( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		int completedTrialCount               = 0
		array<TrialConfig> trialConfigList    = fileLevel.weaponConfigMap[weapon].trialList
		array<MasteryTrialData> trialDataList = fileLevel.localPlayerInfo.weaponDataCache[weapon].trialList
		for ( int i = 0; i < trialConfigList.len(); i++ )
		{
			TrialConfig trialConfig    = trialConfigList[i]
			MasteryTrialData trialData = trialDataList[i]
			if ( trialData.isCompleted )
				completedTrialCount += 1
		}
		if ( completedTrialCount == trialConfigList.len() )
			finishedWeaponCount += 1
	}
	result.curVal = finishedWeaponCount
	result.goalVal = fileLevel.weaponConfigMap.len()
	result.rewards = fileLevel.allWeaponRewards
	result.isCompleted = result.curVal == result.goalVal
	return result
}

table<ItemFlavor, MasteryWeapon_MatchXPPerWeapon> function Mastery_GetPreviousMatchXPUpdates()
{
	table<ItemFlavor, MasteryWeapon_MatchXPPerWeapon> result
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return result
	bool isBRMode = IsBRMode( player )
	int rank = GetMatchRank( player )
	int totalHeldTime = GetTotalWeaponHeldTime( player )
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		int currentXP = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_XP )
		int lastXP    = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_SopmXP )
		int lastBonusXP =  player.GetPersistentVarAsInt( weaponConfig.persistenceKey_ProgMod_Bonus )
		if ( currentXP > lastXP )
		{
			MasteryWeapon_MatchXPPerWeapon matchXPPerWeapon
			matchXPPerWeapon.currentXP = currentXP
			matchXPPerWeapon.lastXP = lastXP
			matchXPPerWeapon.lastBonusXP = lastBonusXP
			// find trials just unlock
			int lastLevel = Mastery_CalculateLevelFromXP( lastXP )
			int currentLevel = Mastery_CalculateLevelFromXP( currentXP )
			foreach ( trialConfig in weaponConfig.trialList )
			{
				bool justUnlocked = (!IsTrialUnlocked( lastLevel, trialConfig.tierLevel )) && IsTrialUnlocked( currentLevel, trialConfig.tierLevel )
				if ( justUnlocked )
					matchXPPerWeapon.unlockTrialList.append( trialConfig )
			}
			// gather xp composition
			foreach ( xpModifier in weaponConfig.xpModifierList )
			{
				int statValue = player.GetPersistentVarAsInt( xpModifier.statInstance.persistenceKey )
				if ( statValue > 0 )
				{
					int xpValue = CalculateXPFromStatValue( statValue, xpModifier, player, isBRMode )
					AddXPComponent( matchXPPerWeapon, xpModifier, xpValue )
					// for Placement Bonus
					if ( xpModifier.specialModifier == eSpecialModifierType.Rank )
					{
						int bonusXP = CalculateXPSpecialModifier_PlacementBonus( statValue, totalHeldTime, rank, xpModifier, isBRMode )
						if ( bonusXP > 0 )
						{
							AddXPComponent( matchXPPerWeapon, xpModifier, bonusXP, ACTION_PLACEMENT_BONUS )
						}
					}
					//
				}
			}

			result[weapon] <- matchXPPerWeapon
		}
	}
	return result
}

void function AddXPComponent( MasteryWeapon_MatchXPPerWeapon matchXPPerWeapon, XPModifierConfig xpModifier, int xpValue, string actionTag = "" )
{
	MasteryWeapon_XPComponent xpComponent
	xpComponent.xpValue = xpValue
	xpComponent.xpModifierConfig = xpModifier
	string action = actionTag == "" ? xpModifier.action : actionTag
	string actionText = actionTag == "" ? xpModifier.actionText : GetActionTextFromTag( actionTag )
	if ( !(action in matchXPPerWeapon.actionXPMap) )
	{
		MasteryWeapon_ActionXP actionXP
		matchXPPerWeapon.actionXPMap[action] <- actionXP
		matchXPPerWeapon.actionXPMap[action].actionText = actionText
	}
	matchXPPerWeapon.actionXPMap[action].xpValue += xpValue
	matchXPPerWeapon.actionXPMap[action].xpComponentList.append( xpComponent )
}


table<ItemFlavor, MasteryWeapon_MatchTrialPerWeapon> function Mastery_GetPreviousMatchTrialUpdates()
{
	table<ItemFlavor, MasteryWeapon_MatchTrialPerWeapon> result
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return result
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		foreach ( trialConfig in weaponConfig.trialList )
		{
			int currentStat = player.GetPersistentVarAsInt( BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel ) )
			int lastStat    = player.GetPersistentVarAsInt( BuildPDefKey_TrialStruct( weapon, trialConfig.tierLevel ) + PERSISTENCE_SOPM_STAT_SUFFIX )
			if ( currentStat > lastStat && lastStat < trialConfig.goal ) // find changed trials
			{
				if ( !(weapon in result) )
				{
					MasteryWeapon_MatchTrialPerWeapon matchTrialPerWeapon
					result[weapon] <- matchTrialPerWeapon
				}
				MasteryWeapon_ChangedTrial changedTrial
				changedTrial.lastValue = lastStat
				changedTrial.currentValue = minint( trialConfig.goal, currentStat )
				changedTrial.lastFrac = float( changedTrial.lastValue ) /  float( trialConfig.goal )
				changedTrial.currentFrac = float( changedTrial.currentValue) / float( trialConfig.goal )
				changedTrial.trialConfig = trialConfig
				changedTrial.isComplete = currentStat >= trialConfig.goal
				result[weapon].changedTrialList.append( changedTrial )
			}
		}
	}
	return result
}

int function Mastery_GetWeaponXP( ItemFlavor weapon )
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return 0

	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return 0
	}

	return player.GetPersistentVarAsInt( fileLevel.weaponConfigMap[weapon].persistenceKey_XP )
}


int function Mastery_GetWeaponLevel( ItemFlavor weapon )
{
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		#if DEVELOPER
			printf( "[Mastery] Can't find request weapon:" + DEV_ItemFlavor_GetCleanedAssetPath( weapon ) )
		#endif
		return 0
	}

	return Mastery_CalculateLevelFromXP( Mastery_GetWeaponXP( weapon ) )
}

int function Mastery_SortTrialQueryResult( MasteryWeapon_TrialQueryResult a, MasteryWeapon_TrialQueryResult b )
{
	if ( a.trialData.isCompleted && !b.trialData.isCompleted )
		return 1

	else if ( !a.trialData.isCompleted && b.trialData.isCompleted )
		return -1

	else if ( a.trialConfig.tierLevel < b.trialConfig.tierLevel )
		return -1
	else if ( b.trialConfig.tierLevel < a.trialConfig.tierLevel )
		return 1

	else if ( a.trialData.isUnlocked && !b.trialData.isUnlocked )
		return -1

	else if ( !a.trialData.isUnlocked && b.trialData.isUnlocked )
		return 1

	return 0
}
#endif

//////REWARDS//////
#if SERVER
const int MASTERY_REWARD_SEQUENCE_QUERYGOAL = GRX_HTTPQUERYGOAL_GIVE_MASTERY_SEQUENCE_REWARD
void function GiveMasteryRewards( entity player )
{
	#if MASTERY_DEBUG
		printt( format( "[Mastery] debug mark: %s, player: %s", FUNC_NAME( 0 ), string( player ) ) )
	#endif
	thread GiveMasteryRewardsThread( player )
	thread HandleMasteryBadgesThread( player )
}
#endif

#if SERVER
array<entity> s_playersInMasteryRewarding
void function GiveMasteryRewardsThread( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	if ( s_playersInMasteryRewarding.contains( player ) )
		return
	OnThreadEnd( function() : (player)
	{
		s_playersInMasteryRewarding.fastremovebyvalue( player )
	} )
	s_playersInMasteryRewarding.append( player )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	// Test function
	//string sequenceName = "rewardseq_s14_quest" // TODO: need 29 formal sequence name on server, in pdef ref to "mastery.weapon[SAID01870377113].rewardseq"
	//
	//int currentBitmask = GRX_GetSequenceNumber( player, sequenceName )
	//int rewardIndex = 2
	//int targetBitmask = currentBitmask | 1 << rewardIndex
	//
	//ItemFlavor testWeapon = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( "SAID01870377113" ) )
	//GetRewardsForSingleWeapon( player, sequenceName, currentBitmask, targetBitmask, fileLevel.weaponConfigMap[testWeapon].trialList[0].rewards )

	//
	bool finishAllWeaponTrials = true
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		string sequenceName = BuildPdefKey_WeaponStruct( weapon ) + PERSISTENCE_REWARDSEQ_SUFFIX
		//sequenceName = "rewardseq_s14_quest" // For debug use
		int currentBitmask = GRX_GetSequenceNumber( player, sequenceName )
		int targetBitmask = currentBitmask
		array<MasteryReward> rewards
		int level = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_Level )
		bool finishAllFive = true
		foreach ( trialConfig in weaponConfig.trialList )
		{
			int currentStat = player.GetPersistentVarAsInt( BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel ) )
			bool trialCompleted = currentStat >= trialConfig.goal
			if ( !trialCompleted && trialConfig.tierLevel <= FINAL_REWARD_FIVE_INDEX )
			{
				finishAllFive = false
			}
			if ( !trialCompleted )
			{
				finishAllWeaponTrials = false
			}

			bool isRewardGained = IsBitFlagSet( currentBitmask, 1 << trialConfig.tierLevel ) // bool( currentBitmask & 1 << index )
			if ( isRewardGained )
				continue
			if ( trialCompleted )
			{
				if ( !IsTrialUnlocked( level, trialConfig.tierLevel ) )
				{
#if DEVELOPER
					if ( !GetConVarBool( "mastery_unlock_all_trials" ) )
#endif
					{
						#if DEVELOPER
							Assert( false, "[Mastery] Trial is locked, but try to give trial completed rewards. Try to set ConVar 'mastery_unlock_all_trials' with 'true' if you want to ignore this error in DEV mode." )
						#else
							Assert( false, "[Mastery] Trial is locked, but try to give trial completed rewards." )
						#endif
						continue
					}
				}

				bool hasValidReward = false
				// copy from battle pass
				foreach ( reward in trialConfig.rewards )
				{
					Assert( reward.quantity > 0 )

					if ( !CanGiveReward( player, reward.flav, rewards ) )
						continue

					rewards.append( reward )
					hasValidReward = true
				}
				if ( hasValidReward )
					targetBitmask = targetBitmask | 1 << trialConfig.tierLevel
			}
		}
		// weapon final rewards
		if ( finishAllFive )
		{
			bool isRewardGained = IsBitFlagSet( currentBitmask, 1 << FINAL_REWARD_START_BIT )
			if ( !isRewardGained )
			{
				bool hasValidReward = false
				foreach ( MasteryReward reward in weaponConfig.finalRewardFive )
				{
					Assert( reward.quantity > 0 )

					if ( !CanGiveReward( player, reward.flav, rewards ) )
						continue

					rewards.append( reward )
					hasValidReward = true
				}
				if ( hasValidReward )
					targetBitmask = targetBitmask | 1 << FINAL_REWARD_START_BIT
			}
		}

		if ( rewards.len() > 0 )
		{
			Assert( currentBitmask != targetBitmask, format( "[Mastery] Trial rewards error: currentBitmask(%d) == targetBitmask(%d)", currentBitmask, targetBitmask ) )
			GetMasterySequenceRewards( player, sequenceName, currentBitmask, targetBitmask, rewards )
		}
	}

	// All weapon reward
	if ( finishAllWeaponTrials )
	{
		int allWeaponRewardBitmask = GRX_GetSequenceNumber( player, ALL_WEAPON_REWARD_SEQUENCE_NAME )
		bool isRewardGained = IsBitFlagSet( allWeaponRewardBitmask, 1 << ALL_WEAPON_REWARD_BIT )
		if ( !isRewardGained )
		{
			array<MasteryReward> rewards
			foreach ( MasteryReward reward in fileLevel.allWeaponRewards )
			{
				Assert( reward.quantity > 0 )

				if ( !CanGiveReward( player, reward.flav, rewards ) )
					continue

				rewards.append( reward )
			}
			if ( rewards.len() > 0 )
				GetMasterySequenceRewards( player, ALL_WEAPON_REWARD_SEQUENCE_NAME, allWeaponRewardBitmask, allWeaponRewardBitmask | 1 << ALL_WEAPON_REWARD_BIT, rewards )
		}
	}
}

bool function CanGiveReward( entity player, ItemFlavor rewardFlav, array<MasteryReward> pendingRewards )
{
	if ( ItemFlavor_GetGRXMode( rewardFlav ) == eItemFlavorGRXMode.NONE ) // mark in bakery setting say "Not a marketplace item"
		return false

	if ( ItemFlavor_IsItemDisabledForGRX( rewardFlav ) )
		return false

	if ( ItemFlavor_GetGRXMode( rewardFlav ) == GRX_ITEMFLAVORMODE_REGULAR )
	{
		if ( GRX_IsItemOwnedByPlayer( rewardFlav, player ) )
			return false

		foreach ( pendingReward in pendingRewards )
		{
			if ( pendingReward.flav == rewardFlav )
			{
				return false
			}
		}
	}
	return true
}
#endif

#if SERVER
void function GetMasterySequenceRewards( entity player, string sequenceName, int currentBitmask, int targetBitmask, array<MasteryReward> rewards )
{
	#if MASTERY_DEBUG
		printf( "[Mastery] GetMasterySequenceRewards, player:%s, sequenceName:%s, currentBitmask:%d, targetBitmask:%d",
			string( player ),
			sequenceName,
			currentBitmask,
			targetBitmask )
	#endif
	if ( rewards.len() == 0 )
	{
		Assert( false, "GetMasterySequenceRewards, reward count must > 0" )
		return
	}
	ItemFlavorBag rewardBag
	foreach ( MasteryReward reward in rewards )
	{
		Assert( reward.quantity > 0 )

		if ( ItemFlavor_GetGRXMode( reward.flav ) == eItemFlavorGRXMode.NONE )
			continue

		if ( ItemFlavor_IsItemDisabledForGRX( reward.flav ) )
			continue

		if ( ItemFlavor_GetGRXMode( reward.flav ) == GRX_ITEMFLAVORMODE_REGULAR )
		{
			if ( GRX_IsItemOwnedByPlayer( reward.flav, player ) )
				continue
		}

		rewardBag.flavors.append( reward.flav )
		rewardBag.quantities.append( reward.quantity )
	}

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = MASTERY_REWARD_SEQUENCE_QUERYGOAL
	operation.doOperationFunc = (void function( int opID ) : ( player, sequenceName, currentBitmask, targetBitmask, rewardBag )
	{
		GRX_GiveBitMaskSequenceRewardEasy( player, opID, MASTERY_REWARD_SEQUENCE_QUERYGOAL, sequenceName, currentBitmask, targetBitmask, rewardBag )
	})
	operation.onDoneCallback = (void function( int status ) : ( player, rewardBag ) {
		bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
		if ( !didOperationSucceed )
			return

		foreach ( int flavIdx, ItemFlavor flav in rewardBag.flavors )
			GRX_MarkAsNewIfAppropriate( player, flav )
	})
	QueueGRXOperation( player, operation )

	while ( !IsGRXOperationDone( operation ) )
		WaitFrame()

	if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
	{
		Warning( "Account Level Rewards operation failed" )
	}
}
#endif

#if UI
array<MasteryReward> function Mastery_GetMatchRewards()
{
	array<MasteryReward> rewards
	int completeWeaponCount = 0
	bool hasNewCompletedTrial = false
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		int completeTrialCount         = 0
		int completedTrialCount_Five   = 0
		bool hasNewCompletedTrial_Five = false
		int weaponLevel                = GetPersistentVarAsInt( weaponConfig.persistenceKey_Level )
		bool containSpecialBadge       = false
		// set sopm stat for trials of each weapon
		foreach ( TrialConfig trialConfig in weaponConfig.trialList )
		{
			int currentStat        = GetPersistentVarAsInt( BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel ) )
			int sopmStat           = GetPersistentVarAsInt( BuildPDefKey_TrialStruct( weapon, trialConfig.tierLevel ) + PERSISTENCE_SOPM_STAT_SUFFIX )
			bool isRewardFiveTrial = trialConfig.tierLevel <= FINAL_REWARD_FIVE_INDEX
			if ( currentStat >= trialConfig.goal )
			{
				completeTrialCount += 1
				if ( isRewardFiveTrial )
					completedTrialCount_Five += 1
				if ( sopmStat < trialConfig.goal )
				{
					hasNewCompletedTrial = true
					if ( isRewardFiveTrial )
						hasNewCompletedTrial_Five = true
					// Trial rewards
					foreach ( reward in trialConfig.rewards )
					{
						if ( trialConfig.specialBadge == reward.flav )
						{
							if ( containSpecialBadge )
								continue
							containSpecialBadge = true
							Assert( IsItemFlavorStructValid( ( expect ItemFlavor( trialConfig.specialBadge ) ).guid, eValidation.ASSERT ) )
							Assert( ItemFlavor_GetGRXMode( expect ItemFlavor( trialConfig.specialBadge ) ) == eItemFlavorGRXMode.REGULAR )
							MasteryReward masteryReward
							masteryReward.flav = expect ItemFlavor( trialConfig.specialBadge )
							masteryReward.quantity = 1
							masteryReward.level = GRX_GetItemTier( ItemFlavor_GetGRXIndex( reward.flav ) ) - 2 // For battle pass badge, level will +2 in ceremony, see ShowBattlePassItem_Badge( item, scale, level )
							rewards.append( masteryReward )
						}
						else
						{
							rewards.append( reward )
						}
					}
				}
			}
		}
		// Final reward for one weapon
		if ( ( completedTrialCount_Five >= FINAL_REWARD_FIVE_INDEX + 1 ) && hasNewCompletedTrial_Five )
		{
			foreach ( reward in weaponConfig.finalRewardFive )
			{
				rewards.append( reward )
			}
		}
		// If complete the weapon
		if ( completeTrialCount == weaponConfig.trialList.len() )
		{
			completeWeaponCount += 1
		}
	}
	// All weapon reward
	if ( completeWeaponCount == fileLevel.weaponConfigMap.len() && hasNewCompletedTrial )
	{
		foreach ( reward in fileLevel.allWeaponRewards )
		{
			rewards.append( reward )
		}
	}
	return rewards
}

bool function Mastery_DisplayMatchRewards()
{
	WaitEndFrame()

	bool ready = GRX_IsInventoryReady() && GRX_AreOffersReady()
	if ( !ready )
		return false

	array<MasteryReward> rewards = Mastery_GetMatchRewards()

	if ( rewards.len() == 0 )
	{
		printf( "[Mastery] Request to show reward ceremony dialog but no rewards" )
		return false
	}
	else
	{
		printf( "[Mastery] Show reward ceremony!" )
	}

	bool isForBattlePass = true
	bool isForQuest = false

	array<BattlePassReward> battlePassRewards
	foreach ( reward in rewards )
	{
		BattlePassReward battlePassReward
		battlePassReward.flav = reward.flav
		battlePassReward.quantity = reward.quantity
		battlePassReward.level = reward.level
		battlePassRewards.append( battlePassReward )
	}

	ShowRewardCeremonyDialog(
		"",
		"MASTERY_REWARD_TITLE",
		"",
		battlePassRewards,
		isForBattlePass,
		isForQuest,
		true,
		true
	)

	return true
}

bool function Mastery_WeaponTrialsBecameUnlockedOrCompleted()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return false

	// return as soon as we find a trial that became unlocked or completed
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		foreach ( trialConfig in weaponConfig.trialList )
		{
			if ( DidWeaponTrialBecomeUnlocked( player, weaponConfig, trialConfig ) || DidWeaponTrialBecomeCompleted( player, weapon, trialConfig ) )
				return true
		}
	}

	return false
}

bool function DidWeaponTrialBecomeUnlocked( entity player, MasteryWeaponConfig weaponConfig, TrialConfig trialConfig )
{
	int currentXP         = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_XP )
	int lastXP            = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_SopmXP )
	bool trialWasUnlocked = false

	if ( currentXP > lastXP )
	{
		int lastLevel    = Mastery_CalculateLevelFromXP( lastXP )
		int currentLevel = Mastery_CalculateLevelFromXP( currentXP )
		trialWasUnlocked = !IsTrialUnlocked( lastLevel, trialConfig.tierLevel ) && IsTrialUnlocked( currentLevel, trialConfig.tierLevel )
	}

	return trialWasUnlocked
}

bool function DidWeaponTrialBecomeCompleted( entity player, ItemFlavor weapon, TrialConfig trialConfig )
{
	int currentStat        = player.GetPersistentVarAsInt( BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel ) )
	int lastStat           = player.GetPersistentVarAsInt( BuildPDefKey_TrialStruct( weapon, trialConfig.tierLevel ) + PERSISTENCE_SOPM_STAT_SUFFIX )
	bool trialWasCompleted = currentStat > lastStat && lastStat < trialConfig.goal && currentStat >= trialConfig.goal

	return trialWasCompleted
}

array<MasteryWeapon_TrialStatusChangesPerWeapon> function Mastery_GetWeaponTrialStatusChanges()
{
	array<MasteryWeapon_TrialStatusChangesPerWeapon> result

	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return result

	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		MasteryWeapon_TrialStatusChangesPerWeapon newEntry
		newEntry.weapon = weapon

		array<MasteryWeapon_TrialQueryResult> ornull weaponTrialListState1 = Mastery_GetWeaponTrialListClonedTrialData( weapon )
		array<MasteryWeapon_TrialQueryResult> ornull weaponTrialListState2 = Mastery_GetWeaponTrialList( weapon )
		expect array<MasteryWeapon_TrialQueryResult>( weaponTrialListState1 )
		expect array<MasteryWeapon_TrialQueryResult>( weaponTrialListState2 )

		bool weaponHasTrialStatusChanges = false
		int newChallengesCompleted = 0

		foreach ( index, trialConfig in weaponConfig.trialList )
		{
			MasteryWeapon_TrialStatusChange statusChangeData
			statusChangeData.state1 = weaponTrialListState1[index]

			if ( DidWeaponTrialBecomeUnlocked( player, weaponConfig, trialConfig ) )
			{
				weaponHasTrialStatusChanges = true
				statusChangeData.statusChange = eWeaponTrialStatusChangeType.UNLOCKED
				statusChangeData.state1.trialData.isUnlocked = false
				statusChangeData.state2 = weaponTrialListState2[index]
			}
			else if ( DidWeaponTrialBecomeCompleted( player, weapon, trialConfig ) )
			{
				weaponHasTrialStatusChanges = true
				statusChangeData.statusChange = eWeaponTrialStatusChangeType.COMPLETED
				statusChangeData.state1.trialData.isCompleted = false
				statusChangeData.state1.trialData.currentValue = player.GetPersistentVarAsInt( BuildPDefKey_TrialStruct( weapon, trialConfig.tierLevel ) + PERSISTENCE_SOPM_STAT_SUFFIX )
				statusChangeData.state2 = weaponTrialListState2[index]
				newChallengesCompleted++
			}
			else
			{
				statusChangeData.statusChange = eWeaponTrialStatusChangeType.NONE
			}

			newEntry.trialStatusChangeList.append( statusChangeData )
		}

		MasteryWeapon_TrialStatusChange statusChangeData
		MasteryWeapon_TrialQueryResult finalTrial = expect MasteryWeapon_TrialQueryResult( Mastery_GetWeaponFinalTrialData( weapon ) )
		if ( newChallengesCompleted > 0 && finalTrial.trialData.isCompleted )
		{
			finalTrial.trialData.isCompleted = false
			finalTrial.trialData.currentValue -= newChallengesCompleted
			statusChangeData.statusChange = eWeaponTrialStatusChangeType.COMPLETED
			statusChangeData.state1 = finalTrial
			statusChangeData.state2 = expect MasteryWeapon_TrialQueryResult( Mastery_GetWeaponFinalTrialData( weapon ) )
			newEntry.trialStatusChangeList.append( statusChangeData )
		}

		if ( weaponHasTrialStatusChanges )
			result.append( newEntry )
	}

	return result
}
#endif

//////FOR BADGE//////
#if SERVER
array<entity> s_playersInBadgeUpdating
void function HandleMasteryBadgesThread( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	if ( s_playersInBadgeUpdating.contains( player ) )
		return
	OnThreadEnd( function() : (player)
	{
		s_playersInBadgeUpdating.fastremovebyvalue( player )
	} )
	s_playersInBadgeUpdating.append( player )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	array<UpdateBadgeData> needUpdateBadgeList
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		ItemFlavor ornull specialBadge
		int completedBadgeTrialCount = 0
		foreach ( trialConfig in weaponConfig.trialList )
		{
			if ( trialConfig.specialBadge != null )
			{
				Assert( specialBadge == null || specialBadge == trialConfig.specialBadge, "[Mastery] Current only support one kind of special badge for weapon mastery" )
				Assert( ItemFlavor_GetType( expect ItemFlavor( trialConfig.specialBadge ) ) == eItemType.gladiator_card_badge, "[Mastery] Special badge must be type of eItemType.gladiator_card_badge" )
				specialBadge = trialConfig.specialBadge
				bool isComplete = Mastery_IsTrialCompleted( player, weapon, trialConfig )
				if ( isComplete )
					completedBadgeTrialCount += 1
			}
		}

		if ( ItemFlavor_GetGRXMode( expect ItemFlavor( specialBadge ) ) != eItemFlavorGRXMode.REGULAR )
			continue

		if ( GRX_HasItem( player, ItemFlavor_GetGRXIndex( expect ItemFlavor( specialBadge ) ) ) )
		{
			int weaponLevel = player.GetPersistentVarAsInt( weaponConfig.persistenceKey_Level )
			int bitfield = maxint( 0, GRX_GetItemTier( player, ItemFlavor_GetGRXIndex( expect ItemFlavor( specialBadge ) ) ) )
			int currentTier = Mastery_GetTierFromBitfield( bitfield )
			int targetTier = completedBadgeTrialCount > currentTier ? completedBadgeTrialCount : currentTier

			int targetBitfield = Mastery_CreateTierLevelBitfield( targetTier, weaponLevel )

			if ( targetBitfield > bitfield ) // Only update changed badges, and bitfield must increase because tier and level must increase
			{
				UpdateBadgeData badgeData
				badgeData.badge = expect ItemFlavor( specialBadge )
				badgeData.bitfield = targetBitfield
				needUpdateBadgeList.append( badgeData )
			}

			#if DEVELOPER
				if ( currentTier > completedBadgeTrialCount )
					Warning( "[Mastery] Player %s badge tier reverted, from %d to %d", string( player ), currentTier, completedBadgeTrialCount )
				if ( bitfield != targetBitfield )
				{
					printf( "[Mastery] Player %s badge bitfield is different, %s, old: %d new: %d", string( player ), ItemFlavor_GetGRXAlias( expect ItemFlavor( specialBadge ) ), bitfield, targetBitfield )
					if ( targetBitfield > bitfield )
						printf( "[Mastery] Player %s badge got updated, %s, from %d to %d", string( player ), ItemFlavor_GetGRXAlias( expect ItemFlavor( specialBadge ) ), bitfield, targetBitfield )
				}
			#endif
		}
	}

	if ( needUpdateBadgeList.len() > 0 )
		SetBadgeTierList( player, needUpdateBadgeList )
}
#endif

#if SERVER
void function SetBadgeTierList( entity player, array<UpdateBadgeData> badgeDataList )
{
	if ( !IsValid( player ) )
		return

	array<int> itemIdxs
	array<int> tiers
	foreach ( badgeData in badgeDataList)
	{
		Assert( ItemFlavor_GetGRXMode( badgeData.badge ) == eItemFlavorGRXMode.REGULAR )
		itemIdxs.append( ItemFlavor_GetGRXIndex( badgeData.badge ) )
		tiers.append( badgeData.bitfield )
	}

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_UPDATE_ITEMS
	operation.doOperationFunc   = (void function( int opID ) : ( player, itemIdxs, tiers )
	{
		//GRX_SetItemTierList( player, opID, itemIdxs, tiers )
		#if MASTERY_DEBUG
			printt("[Mastery] SetBadgeTierList DEBUG", itemIdxs.len(), tiers.len() )
		#endif
	})
	operation.onDoneCallback    = (void function( int status ) : ( player, itemIdxs ) {
		bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
		if ( !didOperationSucceed )
			return

		foreach ( itemIdx in itemIdxs )
			GRX_MarkAsNewIfAppropriate( player, GetItemFlavorByGRXIndex( itemIdx ) )
	})
	QueueGRXOperation( player, operation, false )

	while ( !IsGRXOperationDone( operation ) )
		WaitFrame()

	if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
	{
		Warning( "[Mastery] SetBadgeTierList update items operation failed" )
	}
}
#endif

#if SERVER
void function SetBadgeTier( entity player, ItemFlavor badge, int tier )
{
	if ( !IsValid( player ) )
		return

	Assert( ItemFlavor_GetGRXMode( badge ) == eItemFlavorGRXMode.REGULAR )

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_UPDATE_ITEMS
	operation.doOperationFunc   = (void function( int opID ) : ( player, badge, tier )
	{
		GRX_SetItemTier( player, opID, ItemFlavor_GetGRXIndex( badge ), tier )
		#if MASTERY_DEBUG
			printf ("[Mastery] SetBadgeTier DEBUG: " + string(ItemFlavor_GetAsset( badge )) )
		#endif
	})
	operation.onDoneCallback    = (void function( int status ) : ( player, badge ) {
		bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
		if ( !didOperationSucceed )
			return

		GRX_MarkAsNewIfAppropriate( player, badge )
	})
	operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( badge )
	QueueGRXOperation( player, operation, false )

	while ( !IsGRXOperationDone( operation ) )
		WaitFrame()

	if ( operation.status != eScriptGRXOperationStatus.DONE_SUCCESS )
	{
		Warning( "[Mastery] SetBadgeTier update items operation failed" )
	}
}
#endif

int function Mastery_GetStatValue( entity player, string statRef )
{
	if ( !fileLevel.isMasteryEnabled )
		return 0
	return player.GetPersistentVarAsInt( statRef )
}

bool function Mastery_IsValidStatRef( string statRef )
{
	if ( !fileLevel.isMasteryEnabled )
		return true
	if ( statRef == "" )
		return false
	#if ASSERTS
		Assert( statRef.find( "said" ) == -1, "[Mastery] Badge stat ref for mastery should use upper case 'SAID', current: " + statRef )
	#endif
	return fileLevel.validStatList.contains( statRef )
}

bool function Mastery_DoesStatSatisfyValue( entity player, string statRef, float checkValue )
{
	if ( !fileLevel.isMasteryEnabled )
		return false
	Assert( float(int(checkValue)) == checkValue )
	int value = Mastery_GetStatValue( player, statRef )
	return (value >= int(checkValue))
}

#if UI && DEVELOPER
void function DEV_PrintStatusChangeForAllTrials()
{
	entity player = GetLocalClientPlayer()

	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		printt( Localize( ItemFlavor_GetLongName( weapon ) ) + ":" )

		foreach ( index, trialConfig in weaponConfig.trialList )
		{
			string statusChange = "unchanged"
			if ( DidWeaponTrialBecomeUnlocked( player, weaponConfig, trialConfig ) )
				statusChange = "unlocked"
			else if ( DidWeaponTrialBecomeCompleted( player, weapon, trialConfig ) )
				statusChange = "completed"

			printt( "    trial", index + ":", statusChange )
		}
	}
}
#endif

bool function Mastery_IsEnabled()
{
	return GetCurrentPlaylistVarInt( "enable_mastery_weapon", 1 ) == 1
}

bool function Mastery_IsOptimizationEnabled()
{
	return GetCurrentPlaylistVarInt( "enable_mastery_opt", 1 ) == 1
