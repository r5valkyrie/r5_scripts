#if SERVER && DEVELOPER
void function ClientCommand_mastery_dump( entity player, array<string> args )
{
	DEV_DumpMasteryPlayerInfo( player )
}

void function DEV_DumpMasteryPlayerInfo( entity player )
{
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		printf( "[Mastery] ----------" )
		printf( "[Mastery] Weapon<%s> [%s]", DEV_ItemFlavor_GetCleanedAssetPath( weapon ), ItemFlavor_GetGUIDString( weapon ) )
		string xpKey = weaponConfig.persistenceKey_XP
		printf( "[Mastery] xp:" + player.GetPersistentVarAsInt( xpKey ) )
		string sopmXPKey = weaponConfig.persistenceKey_SopmXP
		printf( "[Mastery] sopm_xp:" + player.GetPersistentVarAsInt( sopmXPKey ) )
		string levelKey = weaponConfig.persistenceKey_Level
		printf( "[Mastery] level:" + player.GetPersistentVarAsInt( levelKey ) )
		foreach ( index, trialConfig in weaponConfig.trialList )
		{
			string statKey     = BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel )
			string sopmStatKey = BuildPDefKey_TrialStruct( weapon, trialConfig.tierLevel ) + PERSISTENCE_SOPM_STAT_SUFFIX
			printf( "[Mastery] trial level[%d] stat value:%d isLocked:%s, statIndex:%d statParam:%s, sopm_stat:%d",
				trialConfig.tierLevel,
				player.GetPersistentVarAsInt( statKey ),
				!(player in fileLevel.playerInfoCache) ? "notValid" : fileLevel.playerInfoCache[player].statDataCache[trialConfig.statInstance.cacheIndex].isLocked ? "true" : "false",
				trialConfig.statInstance.cacheIndex,
				trialConfig.statParam,
				player.GetPersistentVarAsInt( sopmStatKey ) )
		}
		foreach ( index, xpModifierConfig in weaponConfig.xpModifierList )
		{
			string statKey = BuildPDefKey_XPModifierStat( weapon, xpModifierConfig.index )
			printf( "[Mastery] xp modifier index[%d] stat value:%d isLocked:%s, statIndex:%d statParam:%s",
				xpModifierConfig.index,
				player.GetPersistentVarAsInt( statKey ),
				!(player in fileLevel.playerInfoCache) ? "notValid" : fileLevel.playerInfoCache[player].statDataCache[xpModifierConfig.statInstance.cacheIndex].isLocked ? "true" : "false",
				xpModifierConfig.statInstance.cacheIndex,
				xpModifierConfig.statParam )
		}
	}
}

void function DEV_SetWeaponXP( string guid, int rawValue, entity player, bool setSopm = true )
{
	if ( rawValue > fileLevel.weaponMaxXP )
	{
		Warning( "[Mastery] Can't set XP %d, exceed the max level %d, will be capped to XP %d", rawValue, fileLevel.weaponMaxLevel, fileLevel.weaponMaxXP )
	}
	int value                        = minint( fileLevel.weaponMaxXP, rawValue )
	int level                        = Mastery_CalculateLevelFromXP( value )
	ItemFlavor weapon                = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( guid ) )
	MasteryWeaponConfig weaponConfig = fileLevel.weaponConfigMap[weapon]
	SetPlayerWeaponXP( player, weaponConfig, value )
	if ( setSopm )
		player.SetPersistentVar( weaponConfig.persistenceKey_SopmXP, value )
	if ( !IsLobby() )
	{
		fileLevel.playerInfoCache[player].weaponDataCache[GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( guid ) )].startXP = value
		fileLevel.playerInfoCache[player].weaponDataCache[GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( guid ) )].startLevel = level
		InitPlayerInfo( player, fileLevel.playerInfoCache[player] )
	}
                   
                                                                               
                                                                                                                                             
       
}

void function DEV_CompleteAllWeaponTrials( entity player )
{
	DEV_SetAllWeaponLevel( 100, player )
	DEV_SetAllWeaponTrialProgress( 100, player )
}

void function DEV_CompleteMostWeaponTrials( entity player )
{
	DEV_SetAllWeaponLevel( 100, player )
	DEV_SetMostWeaponTrialProgress( 100, player )
}

void function DEV_SetWeaponLevel( string guid, int displayLevel, entity player, bool setSopm = true )
{
	int xp = Mastery_GetTotalXPToCompleteWeaponLevel( displayLevel - 1 )
	DEV_SetWeaponXP( guid, xp, player, setSopm )
	WeaponStatsHook_OnPlayerWeaponSwitched( player, player.GetActiveWeapon( eActiveInventorySlot.mainHand ), null )
}

void function DEV_SetAllWeaponLevel( int displayLevel, entity player )
{
	array<ItemFlavor> allweapons = GetAllWeaponItemFlavors()
	foreach ( weapon in allweapons )
	{
		DEV_SetWeaponLevel( ItemFlavor_GetGUIDString( weapon ), displayLevel, player )
	}
}

void function DEV_ResetAllWeaponTrialProgress( entity player )
{
	DEV_SetAllWeaponTrialProgress( 0, player )
}

void function DEV_SetAllWeaponTrialProgress( int value, entity player )
{
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		foreach ( index, trialConfig in weaponConfig.trialList )
		{
			string statKey = BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel )
			player.SetPersistentVar( statKey, value )
		}
	}
}

void function DEV_SetMostWeaponTrialProgress( int value, entity player )
{
	int totalWeapon = 0
	foreach ( weapon, weaponConfig in fileLevel.weaponConfigMap )
	{
		if ( totalWeapon == fileLevel.weaponConfigMap.len() - 1 )
			break

		foreach ( index, trialConfig in weaponConfig.trialList )
		{
			string statKey = BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel )
			player.SetPersistentVar( statKey, value )
		}
		totalWeapon++
	}
}

void function DEV_SetSingleWeaponTrialProgress( entity player, string guid, int tierLevel = -1, int statValue = 0 )
{
	ItemFlavor weapon = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( guid ) )
	if ( tierLevel == -1 )
	{
		foreach ( index, trialConfig in fileLevel.weaponConfigMap[weapon].trialList )
		{
			string statKey = BuildPDefKey_TrialStat( weapon, trialConfig.tierLevel )
			player.SetPersistentVar( statKey, statValue )
		}
	}
	else
	{
		string statKey = BuildPDefKey_TrialStat( weapon, tierLevel )
		player.SetPersistentVar( statKey, statValue )
	}
}
#endif

#if SERVER && DEVELOPER
void function GenerateMasteryPDef()
{
	DEV_PDefGen_BeginStruct( "sMasteryTrial", "Stat info for mastery trials" )
	DEV_PDefGen_AddField_Int( PERSISTENCE_STAT_SUFFIX )
	DEV_PDefGen_AddField_Int( PERSISTENCE_SOPM_STAT_SUFFIX )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginStruct( "sMasteryData", "Data for one mastery item" )
	DEV_PDefGen_AddField_Int( PERSISTENCE_XP_SUFFIX )
	DEV_PDefGen_AddField_Int( PERSISTENCE_SOPM_XP_SUFFIX )
	DEV_PDefGen_AddField_Int( PERSISTENCE_LEVEL_SUFFIX )
	DEV_PDefGen_AddField_Int( PERSISTENCE_REWARDSEQ_SUFFIX )
	DEV_PDefGen_AddField_Int( PERSISTENCE_PROGRESSION_MODIFIER_SUFFIX )
	DEV_PDefGen_AddField_StructArray_IntKey( "sMasteryTrial", PERSISTENCE_TRIAL_LIST, TRIAL_COUNT )
	DEV_PDefGen_AddField_IntArray_IntKey( PERSISTENCE_XP_MODIFIER_LIST, XP_MODIFIER_COUNT )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "Weapon Mastery" )
	DEV_PDefGen_AddField_StructArray_EnumKey( "sMasteryData", "mastery_weapons", "eWeaponFlavor" )
	DEV_PDefGen_AddField_Int( ALL_WEAPON_REWARD_SEQUENCE_NAME )
	DEV_PDefGen_EndFieldGroup()
}
#endif

void function Sh_Mastery_Init()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	#if SERVER
		WeaponStatsInit()
	#endif

	if ( !Mastery_IsEnabled() )
	{
		fileLevel.isStatTurnOff = true
		fileLevel.isMasteryEnabled = false
		printt( "[MASTERY] Not initiate mastery system due to playlist var enable_mastery_weapon == 0" )
		return
	}

	fileLevel.isStatTurnOff = false
	fileLevel.isMasteryEnabled = true

	LoadConfig()
	BuildValidStatList()

	#if SERVER
		AddCallback_GameStateEnter( eGameState.Resolution, OnMatchEnd )
		AddCallback_OnPersistentDataReady( OnPersistentDataReady )
		#if MASTERY_OPEN_GRX
			AddCallback_QueueServersideScriptGRXOperations( GiveMasteryRewards )
		#endif
	#endif

	#if CLIENT || UI
		thread InitLocalPlayerInfo_Thread()
	#endif

	/////DEV REGION START/////
	#if SERVER && DEVELOPER
		AddCallback_GeneratePDef( GenerateMasteryPDef )
		AddClientCommandCallback( "mastery_dump", ClientCommand_mastery_dump )
	#endif

	#if CLIENT && DEVELOPER
		AddCallback_OnPlayerWeaponSwitched( OnPlayerWeaponSwitched )
		RegisterSignal( "CloseDebugMenu" )
	#endif
	/////DEV REGION END/////
}

#if SERVER
void function OnPersistentDataReady( entity player )
{
	#if MASTERY_DEBUG
		printt( format( "[Mastery] debug mark: %s, player: %s", FUNC_NAME( 0 ), string( player ) ) )
	#endif
	#if SERVER
		if ( IsLobby() )
		{
			return
		}
		if ( player in fileLevel.playerInfoCache ) // reconnect won't go here but in OnClientConnectionRestored
			return
		MasteryPlayerInfo playerInfo
		fileLevel.playerInfoCache[player] <- playerInfo

		InitPlayerInfo( player, playerInfo )
		ClearPlayerXPStatsData( player )
		RecordPlayerSOPMData( player )
	#endif
}
#endif

#if CLIENT || UI
void function InitLocalPlayerInfo_Thread()
{
	while ( !IsFullyConnected() )
		WaitFrame()
	
	InitPlayerInfo( GetLocalClientPlayer(), fileLevel.localPlayerInfo )
}
#endif

