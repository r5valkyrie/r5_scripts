array<StatInstance> function Mastery_GetAllStatInstance()
{
	if ( fileLevel.isStatTurnOff )
		return []
	// TODO: Add init finish flag to find problem?
	return fileLevel.allStatsList
}

array<StatInstance> function Mastery_GetValidStatArray( entity player, ItemFlavor weapon )
{
	if ( fileLevel.isStatTurnOff )
		return []
	if ( !IsValid( player ) || !player.IsPlayer() )
		return []
	if ( IsLowCostBot( player ) )
		return []	
	if ( !(player in fileLevel.playerInfoCache) )
	{
		Assert( false, "[Mastery] Player " + player.GetEntIndex() + "NOT in playerInfoCache!" )
		return []
	}
	// TODO: Need to optimize if called frequently, or null or input array ref
	int targetTag = ItemFlavor_GetGUID( weapon )
	array<StatInstance> result
	if ( !(targetTag in fileLevel.targetStatsMap) )
		return result
	foreach ( StatInstance statInstance in fileLevel.targetStatsMap[targetTag] )
	{
		#if DEVELOPER
			if ( GetConVarBool( "mastery_unlock_all_trials" ) )
				fileLevel.playerInfoCache[player].statDataCache[statInstance.cacheIndex].isLocked = false
		#endif
		if ( !fileLevel.playerInfoCache[player].statDataCache[statInstance.cacheIndex].isLocked )
		{
			result.append( statInstance )
		}
	}
	return result
}

void function Mastery_IncrementStatInstanceByIndex( entity player, int cacheIndex, int value )
{
	if ( fileLevel.isStatTurnOff )
		return
	StatInstance statInstance = fileLevel.allStatsList[cacheIndex]
	Mastery_IncrementStatInstance( player, statInstance, value )
}

void function Mastery_IncrementStatInstance( entity player, StatInstance statInstance, int value )
{
	if ( fileLevel.isStatTurnOff )
		return
	if ( !IsValid( player ) || !player.IsPlayer() )
		return
	if ( IsLowCostBot( player ) )
		return
	if ( !(player in fileLevel.playerInfoCache) )
	{
		Assert( false, "[Mastery] Player " + player.GetEntIndex() + "NOT in playerInfoCache!" )
		return
	}
	ItemFlavor weapon = GetItemFlavorByGUID( statInstance.targetTag )
	if ( !(weapon in fileLevel.weaponConfigMap) )
	{
		Assert( false, "[Mastery] StatInstance targetTag is invalid!" + statInstance.targetTag )
		return
	}

	#if DEVELOPER
		if ( GetConVarBool( "mastery_unlock_all_trials" ) )
			fileLevel.playerInfoCache[player].statDataCache[statInstance.cacheIndex].isLocked = false
	#endif
	Assert( fileLevel.playerInfoCache[player].statDataCache[statInstance.cacheIndex].isLocked == false, "[Mastery] IncrementStat is locked! index:" + statInstance.cacheIndex )
	Assert( value > 0, "[Mastery] IncrementStat input a <= 0 value: " + value )

	//int currentValue = fileLevel.playerInfoCache[player].statInfoCache[statInstance.cacheIndex].currentValue
	int currentValue = player.GetPersistentVarAsInt( statInstance.persistenceKey )

	#if DEVELOPER
                    
                                     
                                                                                                                                                    
        
	#endif

	#if DEVELOPER
		if ( !DEV_ShouldIgnorePersistence() )
	#endif
		{
			statInstance.isModified = true
			player.SetPersistentVar( statInstance.persistenceKey, currentValue + value )
		}

	// for PIN
	if ( statInstance.statType == eMasteryStatType.Trial )
	{
		TrialConfig trialConfig = fileLevel.weaponConfigMap[weapon].trialList[statInstance.trialIndex]
		//PIN_Mastery_WeaponTrialProgress( player, weapon, trialConfig, currentValue, value )
		#if MASTERY_DEBUG
			printt( "[Mastery] Trial value increase", currentValue, value )
		#endif
	}

	//fileLevel.playerInfoCache[player].statInfoCache[statInstance.cacheIndex].currentValue = currentValue + value
	WeaponStatsHook_OnIncrementStatInstance( player, statInstance, value )
}
#endif

