global struct StatInstance
{
	int    targetTag
	string persistenceKey
	int    cacheIndex
	int    statType
	int    trialIndex = -1 // Not tier level just index for config array which is same on client
	int    xpIndex = -1
	bool   isModified = false
	//StatParams params
	#if DEVELOPER
		string description
		bool   hideDebugInfo = false
	#endif
}

global struct MasteryReward
{
	ItemFlavor& flav
	int         quantity
	int			level
	bool 		isOwned = false //jmasse: Used only for RTK, is manually set at a data level
	bool 		isTall = false //jmasse: Used only for RTK, is manually set at a data level
}

global struct TrialConfig
{
	int tierLevel
	int displayLevel
	int goal
	StatInstance& statInstance

	#if DEVELOPER
		string statParam
	#endif
	array<MasteryReward> rewards
	ItemFlavor ornull specialBadge

	#if CLIENT || UI
		string description
		string name
	#endif
}

global struct XPModifierConfig
{
	int   index
	float weight
	float nonBRWeight
	int   specialModifier = eSpecialModifierType.None
	StatInstance& statInstance

	#if DEVELOPER
		string statParam
	#endif
	string action
	string modifierType
	#if CLIENT || UI
		string actionText
	#endif
}

