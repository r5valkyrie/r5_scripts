global function BandwidthStress_Init

global function BandwidthStress_Begin
global function BandwidthStress_End

global function BandwidthStressReliable_Blast
global function BandwidthStressReliable_Begin
global function BandwidthStressReliable_End

const float	ENT_SPAWN_RADIUS = 1000
const int	ENT_SPAWN_RATE = 20
const asset	STRESS_MDL = $"mdl/creatures/prowler/prowler_apex.rmdl"

const array< string > STRESS_MDL_ANIMS =
[
	"pr_idle_scan",
	"pr_idle_lay",
	//"pr_combat_idle_01",
	//"pr_combat_idle_04",
	//"pr_signal_acknowledge",
]

struct
{
	array< entity > stressEnts
	int entsLimit
} file

void function BandwidthStress_Init()
{
	//AddCallback_EntitiesDidLoad( EntitiesDidLoadSmokeTest )

	PrecacheModel( STRESS_MDL )

	RegisterSignal( "BandwidthStressKill" )
	RegisterSignal( "BandwidthStressReliableKill" )
}

// ------------------------------------------------------------------------------------------------------------------
//
// ######## ##    ## ######## #### ######## ##    ##     ######  ######## ########  ########  ######   ######
// ##       ###   ##    ##     ##     ##     ##  ##     ##    ##    ##    ##     ## ##       ##    ## ##    ##
// ##       ####  ##    ##     ##     ##      ####      ##          ##    ##     ## ##       ##       ##
// ######   ## ## ##    ##     ##     ##       ##        ######     ##    ########  ######    ######   ######
// ##       ##  ####    ##     ##     ##       ##             ##    ##    ##   ##   ##             ##       ##
// ##       ##   ###    ##     ##     ##       ##       ##    ##    ##    ##    ##  ##       ##    ## ##    ##
// ######## ##    ##    ##    ####    ##       ##        ######     ##    ##     ## ########  ######   ######
//
// ------------------------------------------------------------------------------------------------------------------

entity function BandwidthStress_SpawnStressEnt( vector spawnAreaPos )
{
	// Spawn randomly inside a cube
	float offsetX = RandomFloatRange( -ENT_SPAWN_RADIUS, ENT_SPAWN_RADIUS )
	float offsetY = RandomFloatRange( -ENT_SPAWN_RADIUS, ENT_SPAWN_RADIUS )
	float offsetZ = RandomFloatRange( -ENT_SPAWN_RADIUS, ENT_SPAWN_RADIUS )
	vector offsetPos = < offsetX, offsetY, offsetZ >

	entity stressEnt = CreatePropScript( STRESS_MDL, spawnAreaPos + offsetPos, <0,0,0> )
	file.stressEnts.append( stressEnt )

	thread function() : ( stressEnt )
	{
		stressEnt.EndSignal( "OnDestroy" )

		vector angleInc = <0,0,0>//GetRandomUnitVector() * 5
		int throttle = 0;

		while ( true )
		{
			vector newPos = stressEnt.GetOrigin() + (<0,0,0> * 10.0)
			stressEnt.SetOrigin( newPos )

			if ( (throttle % 2) == 0 )
			{
				//vector newAngles = <0,0,0> * 180
				vector newAngles = stressEnt.GetAngles() + angleInc
				stressEnt.SetAngles( newAngles )
			}

			if ( (throttle % 4) == 0 )
			{
				string animToPlay = STRESS_MDL_ANIMS.getrandom()
				thread PlayAnimOnly( stressEnt, animToPlay )
			}

			throttle += RandomIntRangeInclusive( 1, 1 )
			WaitFrame()
		}
	}()

	return stressEnt
}

void function BandwidthStress_Begin( int entLimit = 110 )
{
	file.entsLimit = entLimit

	thread function() : ()
	{
		entity world = svGlobal.worldspawn
		world.Signal( "BandwidthStressKill" )
		world.EndSignal( "BandwidthStressKill" )

		OnThreadEnd( function () : ()
			{
				printt( "Ending", FUNC_NAME(), "thread" )
			}
		)

		while ( true )
		{
			array<entity> players = GetPlayerArray()
			entity playerZero = players[0]
			if ( IsValid( playerZero ) )
			{
				vector spawnAreaPos = playerZero.GetOrigin() + < 0, 0, 2 * ENT_SPAWN_RADIUS >

				int spawnCount = file.entsLimit - file.stressEnts.len()
				if ( spawnCount >= 0 )
				{
					spawnCount = minint( spawnCount, ENT_SPAWN_RATE )

					for ( int spawnIdx = 0; spawnIdx < spawnCount; ++spawnIdx )
					{
						BandwidthStress_SpawnStressEnt( spawnAreaPos )
					}

					if ( spawnCount > 0 && file.entsLimit == file.stressEnts.len() )
					{
						printt( "BandwidthStress - Finished spawning", file.entsLimit, "stress ents" )
					}
				}
				else
				{
					printt( "BandwidthStress - Destroying", abs( spawnCount ), "stress ents" )

					// Too many stress ents, destroy some
					while ( file.stressEnts.len() > file.entsLimit )
					{
						entity toDestroy = file.stressEnts.pop()
						toDestroy.Destroy()
					}
				}
			}

			wait 1
		}
	}()
}

void function BandwidthStress_End()
{
	entity world = svGlobal.worldspawn
	world.Signal( "BandwidthStressKill" )

	foreach ( entity ent in file.stressEnts )
	{
		ent.Destroy()
	}

	file.stressEnts = []

	file.entsLimit = 0
}

