// ##     ## ##             ##       ## ######### ##    ##  ##                ##    ##    ##   ##   ##             ##       ##
// ##     ## ##       ##    ## ##    ## ##     ## ##    ##  ##          ##    ##    ##    ##    ##  ##       ##    ## ##    ##
// ##     ## ########  ######   ######  ##     ##  ######   ########     ######     ##    ##     ## ########  ######   ######
//
// ------------------------------------------------------------------------------------------------------------------

void function BandwidthStressReliable_Blast( entity player, int magnitude = 5 )
{
	if ( !IsValid( player ) )
		return

	string pVarName = "currentEliteStreak" // This var is unused

	int toggleVal = player.GetPersistentVarAsInt( pVarName )
	toggleVal = ClampInt( toggleVal, 0, 1 )

	for ( int magIter = 0; magIter < magnitude; magIter++ )
	{
		toggleVal = 1 - toggleVal
		player.SetPersistentVar( pVarName, toggleVal )
	}
}

void function BandwidthStressReliable_Begin( int magnitude = 5 )
{
	thread function() : ( magnitude )
	{
		entity world = svGlobal.worldspawn
		world.Signal( "BandwidthStressReliableKill" )
		world.EndSignal( "BandwidthStressReliableKill" )

		OnThreadEnd( function () : ()
			{
				printt( "Ending", FUNC_NAME(), "thread" )
			}
		)

		while ( true )
		{
			array<entity> players = GetPlayerArray()
			foreach ( entity player in players )
			{
				BandwidthStressReliable_Blast( player, magnitude )
			}

			wait 1
		}
	}()
}

void function BandwidthStressReliable_End()
{
	entity world = svGlobal.worldspawn
	world.Signal( "BandwidthStressReliableKill" )
}

