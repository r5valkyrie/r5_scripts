#if DEV
void function OnPlayerRespawned( entity player )
{
	if ( player.IsBot() )
		return

	thread HeatmapPlayerMovement( player )
}

void function HeatmapPlayerMovement( entity player )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	while( true )
	{
		if ( player.IsTitan() )
			HeatMapStat( player, "TitanMovement", player.GetOrigin() )
		else
			HeatMapStat( player, "PilotMovement", player.GetOrigin() )

		wait 0.5
	}
}

void function LootPickedUp( entity player, entity pickup, string ref, int unitsPickedUp, bool willDestroy, entity deathBox, int pickupFlags )
{
	LootData data = SURVIVAL_Loot_GetLootDataByRef( ref )

	// Heatmap loot pickup
	string heatmapString  = "Sur_LootPickup_"
	string lootTypeString = Survival_GetLootTypeForStatString( data )
	if ( lootTypeString != "" )
	{
		heatmapString += lootTypeString
		heatmapString += "_tier" + string(data.tier)
		HeatMapStat( player, heatmapString, pickup.GetOrigin() )
	}
}


void function OnPlayerStartBleedout( entity player, entity attacker, var damageInfo )
{
	string weaponString           = ""
	string ornull weaponClassName = GetWeaponClassNameFromDamageInfo( damageInfo )
	if ( weaponClassName != null )
		weaponString = string( weaponClassName )
	float dist = -1
	if ( IsValid( player ) && IsValid( attacker ) )
		dist = Distance( player.GetOrigin(), attacker.GetOrigin() )

	if ( IsValid( player ) )
	{
		HeatMapStat( player, "sur_downed_victim", player.GetOrigin() )

		float distToTeammate = GetDistanceToNearestTeammate( player )
		if ( distToTeammate >= 2000 )
			HeatMapStat( player, "sur_downed_victim_gt_2000_from_team", player.GetOrigin() )
		else if ( distToTeammate >= 0 && distToTeammate < 2000 )
			HeatMapStat( player, "sur_downed_victim_lt_2000_from_team", player.GetOrigin() )

		if ( DamageInfo_GetDamageSourceIdentifier( damageInfo ) == eDamageSourceId.deathField
				|| (Bleedout_IsBleedingOut( player ) && Bleedout_GetBleedoutDamageSourceId( player ) == eDamageSourceId.deathField) )
			HeatMapStat( player, "sur_downed_by_circle", player.GetOrigin() )
	}

	if ( IsValid( player ) && IsValid( attacker ) && attacker.IsPlayer() )
	{
		float attackDist = Distance( player.GetOrigin(), attacker.GetOrigin() )
		if ( attackDist < 256 )
			HeatMapStat( player, "sur_downed_victim_attacker_lt_256", player.GetOrigin() )
		else if ( attackDist < 512 )
			HeatMapStat( player, "sur_downed_victim_attacker_lt_512", player.GetOrigin() )
		else if ( attackDist < 3000 )
			HeatMapStat( player, "sur_downed_victim_attacker_lt_3000", player.GetOrigin() )
		else if ( attackDist >= 3000 )
			HeatMapStat( player, "sur_downed_victim_attacker_gt_3000", player.GetOrigin() )
	}

	if ( IsValid( attacker ) && attacker.IsPlayer() )
	{
		HeatMapStat( player, "sur_downed_attacker", player.GetOrigin() )
	}
}


void function OnLootSpawn( entity ent, LootData data, int count )
{
	HeatMapStat( ent, "Sur_LootDrop_All", ent.GetOrigin() )
	HeatMapStat( ent, "Sur_LootDrop_All_tier" + string(data.tier), ent.GetOrigin() )
	if ( data.lootType == eLootType.MAINWEAPON )
		HeatMapStat( ent, "Sur_LootDrop_Weapons_All", ent.GetOrigin() )

	string heatmapString  = "Sur_LootDrop_"
	string lootTypeString = Survival_GetLootTypeForStatString( data )
	if ( lootTypeString == "" )
		return

	heatmapString += lootTypeString
	heatmapString += "_tier" + string(data.tier)

	HeatMapStat( ent, heatmapString, ent.GetOrigin() )
}


void function OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	if ( !IsValid( victim ) )
		return

	// ???: Passed in attacker is immediately overwritten
	attacker = DamageInfo_GetAttacker( damageInfo )

	if ( GameMode_IsActive( eGameModes.SURVIVAL ) )
	{
		if ( victim.IsPlayer() && !Survival_HasPlayerJumpedOutOfPlane( victim ) )
			return
		if ( attacker.IsPlayer() && !Survival_HasPlayerJumpedOutOfPlane( attacker ) )
			return
	}

	// Death
	if ( victim.IsPlayer() && victim.IsTitan() )
		HeatMapStat( victim, "TitanDeath", victim.GetOrigin() )
	else if ( victim.IsPlayer() )
		HeatMapStat( victim, "PilotDeath", victim.GetOrigin() )
	else
		HeatMapStat( attacker, "NPCDeath", victim.GetOrigin() )

	// Kill Spot
	if ( IsValid( attacker ) )
	{
		if ( victim.IsPlayer() )
			HeatMapStat( attacker, "PlayerKilledPlayer", attacker.GetOrigin() )
		else
			HeatMapStat( attacker, "PlayerKilledNPC", attacker.GetOrigin() )
	}
}
#endif //DEV

