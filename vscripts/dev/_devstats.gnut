global function SvDevStats_LevelInit
global function HeatMapStat

#if DEV
const int HEATMAP_VERSION = 3    // DONT CHANGE THIS UNLESS YOUR NAME IS CHAD G AND YOU ALSO CHANGE PARSER SOURCE CODE
global const string HEATMAP_SEPARATOR = ";"
#endif //DEV

struct
{
	array<entity> playersWhoLootedMainWeapon
} file


void function SvDevStats_LevelInit()
{
	#if DEV
		AddCallback_OnPlayerRespawned( OnPlayerRespawned )
		Loot_AddCallback_OnPlayerLootPickup( LootPickedUp )
		Bleedout_AddCallback_OnPlayerStartBleedout( OnPlayerStartBleedout )
		Loot_AddCallback_OnLootSpawn( OnLootSpawn )
		AddCallback_OnPlayerKilled( OnPlayerKilled )
	#endif
}


