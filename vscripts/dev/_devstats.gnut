void function HeatMapStat( entity player, string heatmapType, vector position, array<int> values = [] )
{
	#if DEV
		if ( !ShouldSendDevStats() )
			return

		if ( GetGameState() != eGameState.Playing )
			return

		if ( IsValid( player ) && player.IsPlayer() && player.IsBot() )
			return

		string platform      = (IsValid( player ) && player.IsPlayer()) ? player.GetPlayerPlatformName() : "unknown"
		string statPrintLine = "#heatmap"

		// Common info for all stats
		statPrintLine += HEATMAP_SEPARATOR + "ver=" + HEATMAP_VERSION
		statPrintLine += HEATMAP_SEPARATOR + "game=r5"
		statPrintLine += HEATMAP_SEPARATOR + "platform=" + platform
		statPrintLine += HEATMAP_SEPARATOR + "map=" + GetMapName()
		statPrintLine += HEATMAP_SEPARATOR + "mode=" + GameRules_GetGameMode()
		statPrintLine += HEATMAP_SEPARATOR + "unixTime=" + GetUnixTimestamp()
		statPrintLine += HEATMAP_SEPARATOR + "matchID=" + lstrip( rstrip( GameRules_GetUniqueMatchID() ) )
		statPrintLine += HEATMAP_SEPARATOR + "playlist=" + lstrip( rstrip( GetCurrentPlaylistName() ) )

		// Heatmap specific info
		statPrintLine += HEATMAP_SEPARATOR + "heatmapType=" + heatmapType
		statPrintLine += HEATMAP_SEPARATOR + "posX=" + floor( position.x + 0.5 )
		statPrintLine += HEATMAP_SEPARATOR + "posY=" + floor( position.y + 0.5 )
		statPrintLine += HEATMAP_SEPARATOR + "posZ=" + floor( position.z + 0.5 )

		if ( values.len() > 0 )
			statPrintLine += HEATMAP_SEPARATOR + "value0=" + values[0]
		if ( values.len() > 1 )
			statPrintLine += HEATMAP_SEPARATOR + "value1=" + values[1]
		if ( values.len() > 2 )
			statPrintLine += HEATMAP_SEPARATOR + "value2=" + values[2]

		printl_spamLog( statPrintLine )
	#endif
}