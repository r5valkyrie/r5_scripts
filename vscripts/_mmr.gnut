void function SetPlayerMmrUtil ( entity player, float mmr, float variance, float d = 0, float teamAdjust = 0 )
{
	int teamID = player.GetTeam()
	float teamMMR = TestComputeTeamMean ( player , mmr )
	float teamVariance = TestComputeTeamVariance ( player, variance )

	MMR_OnPlayerConnected ( player ) //init file.teams

#if DEVELOPER
	DEV_script_ranked_debug ( "\t\tTeamID " + teamID )
	DEV_script_ranked_debug ( "\t\tSetting MMR: " + mmr )
	DEV_script_ranked_debug ( "\t\tSetting variance: " + variance )
	DEV_script_ranked_debug ( "\t\tSetting teamMMR: " + teamMMR )
	DEV_script_ranked_debug ( "\t\tSetting teamVariance: " + teamVariance )
	DEV_script_ranked_debug ( "\t\tSetting d: " + d )
	DEV_script_ranked_debug ( "\t\tSetting teamAdjust: " + teamAdjust )
#endif

	//SetPlayerMMR( player, mmr, variance, teamMMR, teamVariance, d, teamAdjust )
}

bool function IsPlayerOnTeamWithBotPairing ( entity player )
{
	return ( GetPlayerMMR( player )[6] == TEAM_MMR_BOT_PAIRING_OVERRIDE )
}

float function TestComputeTeamMean ( entity player , float playerMean )
{		
	int teamID = player.GetTeam()

	array < entity > squad = GetPlayerArrayOfTeam ( teamID )

	if ( squad.len() <= 1  )
		return playerMean

	float teamSum = playerMean

	foreach ( member in squad)
	{
		if ( member != player )
		{
			if( !HasPlayerMMR( member ) )
			{
				if ( GetConVarBool( "ranked_assert_on_invalid_client_data" ) )
					Assert ( false, "TestComputeTeamMean member has no MMR data:  " + member.GetPlayerName() )
			}

			teamSum += GetPlayerMMR( member )[0]
		}
	}

	return teamSum / float ( squad.len() )
}


float function TestComputeTeamVariance ( entity player, float playerVarance )
{
	int teamID = player.GetTeam()

	array < entity > squad = GetPlayerArrayOfTeam ( teamID )

	if ( squad.len() <= 1  )
		return playerVarance

	float teamSum = playerVarance

	foreach ( member in squad )
	{
		if ( member != player )
		{
			if( !HasPlayerMMR( member ) )
			{
				if ( GetConVarBool( "ranked_assert_on_invalid_client_data" ) )
					Assert ( false, "TestComputeTeamVariance member has no MMR data:  " + member.GetPlayerName() )
			}

			teamSum += GetPlayerMMR( member )[1]
		}
	}

	return teamSum / float ( squad.len() )
}


