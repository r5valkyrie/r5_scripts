struct MMR_teamEntry
{
	bool isInit
	int placement
	float mean
	float variance
	float adjustment
	table<int, bool> interactions
}

struct
{
	bool isTracking
	array<MMR_teamEntry> teams
	bool isMMRPlacementFinal = false
} file

