// Warning!!! this function is not authoritative! Tunables can change on Stryder making the computation wrong
// real probabilities used by matchmaking are computed on Stryder and not exposed to server
float function MMR_ComputePairWinRateProbability( float partyIMean, float partyIVariance, float partyQMean, float partyQVariance )
{
	float variancePerformance = pow( 25/6, 2 )

	float tempCiq = partyIVariance + partyQVariance + 2 * variancePerformance

	float cIq = sqrt( tempCiq )
	float pDe = exp( partyIMean / cIq ) + exp( partyQMean / cIq )
	float pIq = exp( partyIMean / cIq ) / pDe

	return pIq
}

#if DEVELOPER
void function MMR_PrintTeams()
{
	printt("MMR_PrintTeams")

	array<string> printTeamBuffer
	MMR_ComputePrintTeams( null, printTeamBuffer )

	foreach(string line in printTeamBuffer)
	{
		printt(line)
	}
}

void function MMR_ComputePrintTeams( entity playerFocus, array<string> printTeamBuffer )
{
	float teamMean = 0
	float teamVariance = 0

	if( playerFocus )
	{
		int teamIdx = playerFocus.GetTeam()

		//if( file.teams.isvalidindex( teamIdx ) )
		//{
		//	teamMean = file.teams[ teamIdx ].mean
		//	teamVariance = file.teams[ teamIdx ].variance
		//}
	}

	int idx = 0
	foreach(MMR_teamEntry entry in file.teams)
	{
		idx = idx + 1
		if( !entry.isInit )
			continue

		int teamIdx = idx - 1

		string teamStr = "mmr: TeamIdx:" + string( teamIdx ) + ", Placement:" + string( entry.placement ) + ", Mean/Variance:" + string( entry.mean ) + "/" + string( entry.variance )
		if( teamVariance > 0 )
		{
			float winProb = MMR_ComputePairWinRateProbability( teamMean, teamVariance, entry.mean, entry.variance )
			teamStr += " Win:" + string( winProb )
		}

		printTeamBuffer.append( teamStr )

		array<entity> teamMembers = GetPlayerArrayOfTeam( teamIdx )
		foreach( entity player in teamMembers )
		{
			// 0: playerMean, 1: playerVariance, 2:teamMean, 3:teamVariance
			array< float > mmrs = GetPlayerMMR( player )
			printTeamBuffer.append("mmr: TeamIdx:" + string( teamIdx ) + " Player:" + player.GetPlayerName() + ", Mean/Variance:" + string( mmrs[0] ) + "/" + string( mmrs[1] ) )
		}

		string interactions = "mmr: TeamIdx:" + string( teamIdx )
		foreach(int teamInteractIdx, bool _ in entry.interactions)
		{
			interactions += ", " + string( teamInteractIdx )
		}
		printTeamBuffer.append( interactions )
	}
}

