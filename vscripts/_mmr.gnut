void function MMR_Init()
{
	file.isTracking = false

	if( !GetConVarBool( "match_trackMMR" ) )
		return

	if ( IsLobby() )
		return

	if( IsPrivateMatch() )
		return

	file.isTracking = true

	AddCallback_OnClientConnected( MMR_OnPlayerConnected )
	AddCallback_OnPlayerKilled( MMR_OnPlayerKilled )
	Bleedout_AddCallback_OnPlayerStartBleedout( MMR_OnPlayerStartBleedout )
}


array< float > function MMR_GetInteractionsForPlayer( entity player, int functionref ( entity player ) getRank )
{
	array< float > interactions

	if( !file.isTracking )
		return interactions

	if( !HasPlayerMMR( player ) )
		return interactions

	int teamIdx = player.GetTeam()
	//Assert( file.teams.isvalidindex( teamIdx ) )

	bool gameModeIsElimination = IsEliminationBased() // true for traditional BR aka Survival & BR-based LTMs
	bool isMatchComplete = GetGameState() >= eGameState.WinnerDetermined

	// for NON-elimination rules, if the match is complete we can get everyone's rank
	if( !gameModeIsElimination && isMatchComplete && !file.isMMRPlacementFinal )
	{
		// update rank of any players that still exist
		array< entity > allPlayers = GetPlayerArray()
		foreach( p in allPlayers )
		{
			if ( !HasPlayerMMR( p ) )
				continue

			int team = p.GetTeam()
			//if ( !file.teams.isvalidindex( team ) ) // R5DEV-446487: defensive fix for bad team indexes with non-survival modes with Bot-teams
			//{
			//	Warning( "MMR: MMR_GetInteractionsForPlayer - found an invalid index in the MMR Team list; this is *likely* because of Bot teams not updating the index here properly." )
			//	MMR_OnPlayerConnected( p ) // will stick an entry into the table for this player/team
			//}
			file.teams[ team ].placement = getRank( p )
		}
		file.isMMRPlacementFinal = true
	}
	else // traditional BR or non-elimination game isn't complete yet
	{
		file.teams[ teamIdx ].placement = getRank( player ) // if player leaves we mark their rank, but we will update at match complete if team-members remain
	}

	int interactionIdx = 0
	interactions.resize( file.teams[ teamIdx ].interactions.len() * 3 )

	// we do not need accurate placement for all teams as long rank1 < rank2 is verified
	foreach( k,v in file.teams[ teamIdx ].interactions ) // it is a set
	{
		// TODO: early leavers should ignore interactions
		if ( ( !gameModeIsElimination && isMatchComplete ) || ( gameModeIsElimination && !IsTeamAlive( k ) ) )
		{
			Assert( !gameModeIsElimination || file.teams[ k ].placement != -1, "MMR_GetInteractionsForPlayer_Elimination is not assigning rank to an interaction correctly, it's expected that placement for this team is already filled" )
			interactions[interactionIdx++] = float(file.teams[ k ].placement)
		}
		else
		{
			interactions[interactionIdx++] = float(-1) // I quit early so everyone is better than me
		}

		interactions[interactionIdx++] = file.teams[ k ].mean
		interactions[interactionIdx++] = file.teams[ k ].variance
	}

	return interactions
}

void function MMR_OnPlayerConnected( entity player )
{
	if( !HasPlayerMMR( player ) )
	{
		printt("MMR_OnPlayerConnected player has no MMR data", player)
		#if DEVELOPER
			DEV_script_ranked_debug (  "MMR_OnPlayerConnected player has no MMR data" )
		#endif
		return
	}

	int teamIdx = player.GetTeam()

	//if( !file.teams.isvalidindex( teamIdx ) )
	//{
	//	file.teams.resize( teamIdx + 1 )
	//}

	if( !file.teams[ teamIdx ].isInit )
	{
		#if DEVELOPER
			DEV_script_ranked_debug (  "MMR_OnPlayerConnected init team" )
		#endif
		// grab team MMR, we suppose team MMR will not change for the duration of a game
		// obviously does not work if team composition is dynamic
		file.teams[ teamIdx ].isInit = true

		// 0: playerMean, 1: playerVariance, 2:teamMean, 3:teamVariance
		array< float > mmrs = GetPlayerMMR( player )

		file.teams[ teamIdx ].placement = -1
		file.teams[ teamIdx ].mean = mmrs[2]
		file.teams[ teamIdx ].variance = mmrs[3]
		file.teams[ teamIdx ].adjustment = mmrs[5]
	}
}

void function MMR_OnInteraction( entity victim, entity attacker )
{
	if( !file.isTracking )
		return

	if( !IsValid( victim ) )
		return

	if( !IsValid( attacker ) )
		return

	if ( !attacker.IsPlayer() )
		return

	if ( !victim.IsPlayer() )
		return

	if( !HasPlayerMMR( victim ) )
		return

	if( !HasPlayerMMR( attacker ) )
		return

	int teamIdxAttacker = attacker.GetTeam()
	int teamIdxVictim = victim.GetTeam()

	if( teamIdxAttacker == teamIdxVictim )
		return

	//Assert( file.teams.isvalidindex(teamIdxAttacker) )
	//Assert( file.teams.isvalidindex(teamIdxVictim) )

	// interactions are symmetric, we could save space ...
	// we use the table as a set
	file.teams[ teamIdxAttacker ].interactions[ teamIdxVictim ] <- true
	file.teams[ teamIdxVictim ].interactions[ teamIdxAttacker ] <- true

	printt("MMR_OnInteraction", teamIdxAttacker, teamIdxVictim, file.teams[ teamIdxAttacker ].interactions.len(), file.teams[ teamIdxVictim ].interactions.len() )
}

void function MMR_OnPlayerStartBleedout( entity victim, entity attacker, var damageInfo )
{
	MMR_OnInteraction( victim, attacker )
}

void function MMR_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	MMR_OnInteraction( victim, attacker )
}