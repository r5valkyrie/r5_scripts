void function Sh_ArenaDeathField_Init()
{
	PrecacheParticleSystem( $"P_survival_radius_CP_1x1" )
	PrecacheParticleSystem( $"P_survival_radius_CP_1x5" )
	PrecacheParticleSystem( $"P_survival_radius_CP_1x100" )
	PrecacheParticleSystem( $"P_ring_FP_hit_01" )

	RegisterSignal( "NewDeathFieldStarting" )

	#if SERVER
		RegisterSignal( "GenerateDeathFieldData" )
		RegisterSignal( "DeathField_ShrinkNow" )
		RegisterSignal( "CleanupOutsideCircle" )

		FlagInit( "UsePreciseFinalCircleOverride" )
		FlagInit( "AllowDeathFieldUpdate", true )
		FlagInit( "DeathFieldPaused", GetCurrentPlaylistVarBool( "sur_circle_start_paused", false ) )
		FlagInit( "DoneCreatingDeathFieldPosition" )
		FlagInit( "SUR_DeathFieldShrinking" )
		FlagInit( "DeathFieldCalculationComplete" )

		AddCallback_EntitiesDidLoad( EntitiesDidLoad_DeathField )
		AddCallback_GameStateEnter( eGameState.Playing, Pathfinder_RandomizeSurveyLocations )
		AddCallback_GameStateEnter( eGameState.Resolution, Deathfield_Destroy )
		if ( GetMapName() == "mp_rr_tropic_island" )
			AddSpawnCallbackEditorClass( "prop_script", "script_survival_survey_beacon", Pathfinder_AddSurveyBeacon )
		else
			AddSpawnCallbackEditorClass( "prop_dynamic", "script_survival_survey_beacon", Pathfinder_AddSurveyBeacon )

		AddClientCommandCallback( "UpdateCirclePos", ClientCommand_UpdateCirclePos )

		file.verifyCircleCenter = GetCurrentPlaylistVarBool( "deathfield_verify_circle_center", true )
	#endif

	InitDeathFieldDataAndStageData()
	AddCallback_GameStateEnter( eGameState.Playing, Deathfield_OnPlayingGameStateEnter )

	#if CLIENT
		file.colorCorrection = ColorCorrection_Register( COLOR_CORRECTION )

		AddCreateCallback( "script_mover", OnPropScriptCreated )
		AddCreateCallback( "prop_script", OnPropScriptCreated )
		AddCreateCallback( "prop_dynamic", OnPropDynamicCreated )
		AddCallback_PlayerClassChanged( SurveyBeacon_ClassChanged )

		AddCreatePilotCockpitCallback( TrackDeathfieldDistance )
		AddLocalPlayerTookDamageTypeCallback( eDamageSourceId.deathField, Callback_OnPlayerTakeDeathFieldDamage )
	#endif
}

void function Deathfield_OnPlayingGameStateEnter()
{
	if ( Playlist() == ePlaylists.survival_firingrange || Playlist() == ePlaylists.survival_training )
		return

	// If the deathfield system is already running (arenas pre-stages it during
	// buy phase), skip reinitialization. GenerateDeathFieldData() fires the
	// "GenerateDeathFieldData" signal which would kill the active
	// SURVIVAL_RunArenaDeathField thread and destroy the ring entity.
	#if SERVER
		if ( Flag( "DeathCircleActive" ) )
			return
	#endif

	InitDeathFieldDataAndStageData()

	#if SERVER
		EntitiesDidLoad_DeathField()
	#endif
}

// =========================================================================
// Shared utility functions
// =========================================================================

float function GetRingTuningOverrideVar( string varName, float defaultValue )
{
	// S3 does not have GetPlaylistVarFloat (cross-playlist version),
	// so we use GetCurrentPlaylistVarFloat directly. This wrapper
	// preserves API compatibility with newer seasons.
	return GetCurrentPlaylistVarFloat( varName, defaultValue )
}

void function GenerateDeathFieldStageData()
{
	file.deathFieldStageData.clear()

	int i = 0
	while ( true )
	{
		float radius = GetRingTuningOverrideVar( "deathfield_radius_" + i, -1.0 )

		bool allowMissingDefaults = false
		if ( radius < 0 )
		{
			if ( file.deathFieldStageData.len() > 0 )
			{
				break
			}
			else
			{
				Warning( "Survival deathfield playlist vars are missing!" )
				allowMissingDefaults = true
			}
		}

		file.deathFieldStageData.append( CreateDeathFieldStageData( i++, allowMissingDefaults ) )
	}
}

DeathFieldStageData function CreateDeathFieldStageData( int index, bool allowMissingDefaults )
{
	float lastRadius = SURVIVAL_Deathfield_GetStartRadius()

	if ( file.deathFieldStageData.len() > 0 )
	{
		lastRadius = file.deathFieldStageData[ file.deathFieldStageData.len() - 1 ].endRadius
	}

	bool circleDebug = GetBugReproNum() == 1001

	int currentIndex = file.deathFieldStageData.len()

	float defaultSpeed     = GetRingTuningOverrideVar( "deathfield_default_shrinkSpeed", 140.0 )
	float shrinkSpeed      = GetRingTuningOverrideVar( "deathfield_shrinkSpeed_" + index, -1.0 )
	float circleCloseSpeed = shrinkSpeed > 0 ? shrinkSpeed : defaultSpeed

	DeathFieldStageData data
	data.circleDeviation = GetRingTuningOverrideVar( "deathfield_circleDeviation_" + index, 1.0 )

	if ( index < file.deathFieldStagesOverrideRadius.len() )
		data.endRadius = file.deathFieldStagesOverrideRadius[ index ]
	else
		data.endRadius = GetRingTuningOverrideVar( "deathfield_radius_" + index, allowMissingDefaults ? 20000.0 : -1.0 )

	if ( index < file.deathFieldStagesOverrideMinimapZoom.len() )
		data.minimapZoomScale = file.deathFieldStagesOverrideMinimapZoom[ index ]
	else if ( data.endRadius <= 600 )
		data.minimapZoomScale = 0.1
	else if ( data.endRadius <= 1000 )
		data.minimapZoomScale = 0.7
	else if ( data.endRadius <= 2000 )
		data.minimapZoomScale = 1.5
	else if ( data.endRadius <= 5000 )
		data.minimapZoomScale = 3.0

	data.preShrinkDuration = GetRingTuningOverrideVar( "deathfield_preShrinkDuration_" + index, allowMissingDefaults ? 240.0 : -1.0 )
	data.shrinkDuration = ((lastRadius - data.endRadius) / circleCloseSpeed)
	data.percentDamagePerTick = GetRingTuningOverrideVar( "deathfield_damagePercent_" + index, allowMissingDefaults ? 0.01 : -1.0 )

	Assert( data.endRadius > 0 )
	Assert( data.preShrinkDuration > 0 )
	Assert( data.shrinkDuration > 0 )
	Assert( data.percentDamagePerTick >= 0 )

	// Flowstate: dynamically scale ring close speeds based on player count
	float factor = 1.0
	if ( GetCurrentPlaylistVarBool( "flowstate_change_ring_close_speeds_dynamically", false ) )
	{
		factor = 0.05 + (float( GetPlayerArray().len() ) / float( MAX_PLAYERS )) * 0.95
		data.preShrinkDuration *= factor
		data.shrinkDuration *= factor
	}

	if ( circleDebug )
	{
		data.preShrinkDuration = 10.0
	}

	return data
}

void function InitDeathFieldDataAndStageData()
{
	file.deathFieldStartStage = 0

	GenerateDeathFieldStageData()

	file.deathFieldStartStage = GetCurrentPlaylistVarInt( "survival_death_field_start_stage", 0 )
	if ( file.deathFieldStartStage >= file.deathFieldStageData.len() )
		file.deathFieldStartStage = file.deathFieldStageData.len()
}

float function SURVIVAL_Deathfield_GetStartRadius()
{
	float startRadius = GetRingTuningOverrideVar( "survival_death_field_start_radius", 65000 )

	if ( file.deathFieldStartStage > 0 )
	{
		startRadius = file.deathFieldStageData[file.deathFieldStartStage - 1].endRadius
	}
	else if ( file.overrideStartRadius > 0 )
	{
		startRadius = file.overrideStartRadius
	}

	return startRadius
}

float function SURVIVAL_Deathfield_GetStartDamage()
{
	int startStage = maxint( file.deathFieldStartStage - 1, 0 )

	return file.deathFieldStageData[startStage].percentDamagePerTick
}

bool function PlayerShouldSeeSurveyBeaconMarkers( entity player )
{
	#if MP_PVEMODE
		if ( IsAlive( player ) )
			return player.HasPassive( ePassives.PAS_PATHFINDER )
		LoadoutEntry characterSlot = Loadout_Character()
		if ( !LoadoutSlot_IsReady( ToEHI( player ), characterSlot ) )
			return false
		ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( player ), characterSlot )
		string ref = ItemFlavor_GetHumanReadableRef( character )
		return (ref == "character_pathfinder")
	#else
		return player.HasPassive( ePassives.PAS_PATHFINDER )
	#endif
}

#if CLIENT
DeathFieldStageData function GetDeathFieldStage( int index )
{
	if ( file.deathFieldStageData.len() == 0 )
		InitDeathFieldDataAndStageData()

	if ( file.deathFieldStageData.len() > index && index > -1 )
		return file.deathFieldStageData[ index ]

	return CreateDeathFieldStageData( index, true )
}

vector function GetDeathfieldFinalCenter()
{
	int count = file.deathFieldStageData.len()
	if ( count == 0 )
		return <0, 0, 0>

	DeathFieldStageData dt = file.deathFieldStageData[count - 1]
	return dt.endPos
}
#endif

int function Survival_GetNumDeathfieldStages()
{
	return file.deathFieldStageData.len()
}

#if SERVER
vector function PickPosition( string positionsRawString )
{
	array<string> positionStrings = GetTrimmedSplitString( positionsRawString, "," )
	array<vector> positions
	foreach ( positionString in positionStrings )
	{
		array<string> valuesAsStrings = GetTrimmedSplitString( positionString, WHITESPACE_CHARACTERS )
		Assert( valuesAsStrings.len() == 3, "PickPosition: vectorString should have format \"x y z\"" )
		vector pos = < float( valuesAsStrings[0] ), float( valuesAsStrings[1] ), float( valuesAsStrings[2] ) >
		positions.append( pos )
	}
	int index = RandomInt( positions.len() )
	vector selectedPos = positions[index]
	return selectedPos
}

void function EntitiesDidLoad_DeathField()
{
	string startPosOverride = GetCurrentPlaylistVarString( "deathfield_start_positions", "" )
	if ( startPosOverride != "" )
	{
		vector startPos = PickPosition( startPosOverride )

		array<int> realms = Survival_Loot_GetRealmsToPopulate()
		foreach( realm in realms)
			SURVIVAL_SetDeathFieldOverrideStartPos( realm, startPos )
	}

	thread __EntitiesDidLoad()
}

void function __EntitiesDidLoad()
{
	// Populate realm tables FIRST so all accessor functions work during
	// DeathFieldCreatePositions -> GenerateDeathFieldData -> SURVIVAL_CalculateAirdropPositions
	array<int> realms = Survival_Loot_GetRealmsToPopulate()
	file.deathFieldData.clear()
	file.deathFieldStages.clear()
	int i = 0

	foreach ( realm in realms )
	{
		DeathFieldData data

		data.startRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.currentRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.endRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.percentDamagePerTick = SURVIVAL_Deathfield_GetStartDamage()
		data.codeIndex = i++

		file.deathFieldData[ realm ] <- data

		array<DeathFieldStageData> newStages
		foreach ( dt in file.deathFieldStageData )
		{
			newStages.append( clone dt )
		}
		file.deathFieldStages[ realm ] <- newStages
	}

	// Create positions - GenerateDeathFieldData updates file.deathFieldStageData[].endPos
	// and syncs to per-realm tables before calling SURVIVAL_CalculateAirdropPositions
	DeathFieldCreatePositions()

	if ( file.deathFieldStartStage > 0 )
	{
		foreach ( realm in realms )
		{
			file.deathFieldData[ realm ].center = file.deathFieldStages[ realm ][ file.deathFieldStartStage ].endPos
		}
		SetCurrentDeathFieldStage( file.deathFieldStartStage )
	}

	if ( GetCurrentPlaylistVarBool( "show_ring_in_airdrop", false ) )
	{
		int _defaultRealm = Survival_Loot_GetDefaultRealm()
		vector circleCenter = file.deathFieldData[ _defaultRealm ].center
		float circleRadius  = file.deathFieldData[ _defaultRealm ].currentRadius
		entity tempZoneEnt = SafeZone_CreateEnt( circleCenter, circleRadius, Survival_Loot_GetDefaultRealm() )
		foreach ( player in GetPlayerArray() )
			tempZoneEnt.Minimap_AlwaysShow( 1, player )

		thread DeleteMinimapZoneAfterPlaneCompletes( tempZoneEnt )
	}

	ResetDeathFieldDataToDefault()
	FlagSet( "DeathFieldCalculationComplete" )
}

void function DeleteMinimapZoneAfterPlaneCompletes( entity tempZoneEnt )
{
	FlagWait( "DeathCircleActive" )

	if ( IsValid( tempZoneEnt ) )
		tempZoneEnt.Destroy()
}

void function ResetDeathFieldDataToDefault()
{
	array<int> allRealms = Survival_Loot_GetRealmsToPopulate()

	RoundBased_ResetSurveyZones()

	foreach ( realm in allRealms )
	{
		Assert( file.deathFieldStages[ realm ].len() > 0 )
		DeathFieldData data = file.deathFieldData[ realm ]
		vector startCenter  = file.deathFieldStages[ realm ][file.deathFieldStartStage].endPos
		int maxDeviation = GetCurrentPlaylistVarInt( "survival_circle_max_deviation", 0 )
		if ( maxDeviation > 0 && Distance( startCenter, <0, 0, 0> ) > maxDeviation )
			data.center = Normalize( startCenter ) * maxDeviation
		else
			data.center = startCenter

		data.nextCenter = startCenter

		if ( realm in file.overrideStartPos )
		{
			startCenter = file.overrideStartPos[ realm ]
			data.center = startCenter
		}

		DestroyAllLootOutsideDeathField( realm, data.center, SURVIVAL_Deathfield_GetStartRadius() )
	}
}

DeathFieldStageData function GetDeathFieldStage( int index, int realm = -1 )
{
	int _realm = realm == -1 ? Survival_Loot_GetDefaultRealm() : realm
	return file.deathFieldStages[ _realm ][ index ]
}

vector function GetDeathfieldFinalCenter( int realm = -1 )
{
	int _realm = realm == -1 ? Survival_Loot_GetDefaultRealm() : realm
	int count = file.deathFieldStages[_realm].len()
	if ( count == 0 )
		return <0, 0, 0>

	DeathFieldStageData dt = file.deathFieldStages[_realm][count - 1]
	return dt.endPos
}

int function GetDeathFieldStartStage()
{
	return file.deathFieldStartStage
}

