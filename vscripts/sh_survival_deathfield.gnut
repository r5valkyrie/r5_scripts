int function CodeCallback_GetFinalRingNavNodeIndex()
{
	FlightPath flightPath = GetAnalysisForModel( CARE_PACKAGE_AIRDROP_MODEL, CARE_PACKAGE_IDLE )

	return GetAnalysisDataIndex( flightPath )
}

enum InvalidRingReason
{
	VALID = 0,//green
	AIRDROP = 1, //orange
	OUT_OF_RADIUS = 2,//dark gray
	AWAY_FROM_LOOT = 3,//orange
	IN_EXCLUSION_ZONE = 4//purple
}
table < int, int > s_DEV_finalRingIndexStates
int function CodeCallback_IsFinalRingPointValid( vector origin, int index )
{
	if ( index in s_DEV_finalRingIndexStates )
		return s_DEV_finalRingIndexStates[index]

	if ( s_DEV_finalRingIndexStates.len() > 65000 )
		s_DEV_finalRingIndexStates.clear()

	float distToCenterSqr = Distance2DSqr( origin, DeathField_GetStartCircleCenter() )
	float radiusSqr = SURVIVAL_Deathfield_GetStartRadius() * SURVIVAL_Deathfield_GetStartRadius()

	if ( distToCenterSqr > radiusSqr )
	{
		s_DEV_finalRingIndexStates[index] <- InvalidRingReason.OUT_OF_RADIUS
		return InvalidRingReason.OUT_OF_RADIUS
	}

	float maxDistToLoot = GetCurrentPlaylistVarFloat( "deathfield_finalpos_maxlootdist", 3000.0 )
	float maxDistToLootSQ = maxDistToLoot * maxDistToLoot
	float maxDistToLootTight = GetCurrentPlaylistVarFloat( "deathfield_finalpos_maxlootdist_tight", 1000.0 )
	float maxDistToLootTightSQ = maxDistToLootTight * maxDistToLootTight

	vector lootLocation = SURVIVAL_GetClosestValidCircleEndLocation( origin )
	float locToNearestLootSQ = Distance2DSqr( origin, lootLocation )
	float maxDistThresholdSQ = VerifyCircleCenter( origin, false ) ? maxDistToLootSQ : maxDistToLootTightSQ

	if ( (locToNearestLootSQ > maxDistThresholdSQ) )
	{
		s_DEV_finalRingIndexStates[index] <- InvalidRingReason.AWAY_FROM_LOOT
		return InvalidRingReason.AWAY_FROM_LOOT
	}

	if ( !SURVIVAL_IsValidCircleLocation( origin ) )
	{
		s_DEV_finalRingIndexStates[index] <- InvalidRingReason.IN_EXCLUSION_ZONE
		return InvalidRingReason.IN_EXCLUSION_ZONE
	}

	s_DEV_finalRingIndexStates[index] <- InvalidRingReason.VALID
	return InvalidRingReason.VALID
}

