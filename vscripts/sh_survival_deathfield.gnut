void function DEV_SimulateFinalLocations( int tries = 2000, float drawTime = 600.0, bool generateCircles = true, float waitTime = 0.0, float circleDrawTime = 1.0, bool showCirclePull = false, bool showLastCircle = false )
{
	for ( int i = 0; i < tries; i++ )
	{
		vector o = GetFinalDeathFieldLocation()
		DebugDrawLine( o, o + <0, 0, 10000>, 255, 0, 0, true, drawTime )
		GenerateDeathFieldData( o, 1.0 )
		WaitFrame()
	}
}

void function DEV_DrawCircleLocations( int realm = -1, int circle = -1, float time = 20.0 )
{
	int _realm = realm == -1 ? Survival_Loot_GetDefaultRealm() : realm

	if ( circle != -1 )
	{
		DeathFieldStageData data = file.deathFieldStages[ _realm ][circle]
		DebugDrawCircle( data.endPos, <0, 0, 1>, data.endRadius, 255, 0, 0, true, time )
		return
	}

	for ( int i = file.deathFieldStages[ _realm ].len() - 1; i >= 0; i-- )
	{
		DeathFieldStageData data = file.deathFieldStages[ _realm ][i]
		DebugDrawCircle( data.endPos, <0, 0, 1>, data.endRadius, 255, 0, 0, true, time )
	}
}

