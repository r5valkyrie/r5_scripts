void function SURVIVAL_SetDeathFieldOverrideStartRadius( float radius )
{
	printt( "overriding deathfield start radius: " + radius )
	file.overrideStartRadius = radius
}

void function SURVIVAL_SetDeathFieldStagesOverrideRadius( array<float> radii )
{
	file.deathFieldStagesOverrideRadius = clone radii
}

void function SURVIVAL_SetDeathFieldStagesOverrideMinimapZoom( array<float> zooms )
{
	file.deathFieldStagesOverrideMinimapZoom = clone zooms
}

bool s_deathFieldSynchronized = false
void function DeathFieldKeepCodeUpdated_THREAD( DeathFieldData data, entity deathField )
{
	deathField.EndSignal( "OnDestroy" )

	// TODO: update when code supports realmed circles
	if ( data.s_deathFieldSynchronized )
		return

	data.s_deathFieldSynchronized = true

	OnThreadEnd(
		function() : ( data )
		{
			if ( data.codeIndex == 0 )
				SetDeathFieldParams( <0, 0, 0>, 100000, 0, 90000, 99999 )
			DeathField_SetActive( data.codeIndex, false )
		}
	)

	for ( ; ; )
	{
		if ( data.codeIndex == 0 )
			SetDeathFieldParams( data.center, data.startRadius, data.endRadius, data.startTime, data.endTime )
		DeathField_SetActive( data.codeIndex, true )
		DeathField_SetOrigin( data.codeIndex, data.center )
		DeathField_SetRadiusStartEnd( data.codeIndex, data.startRadius, data.endRadius )
		DeathField_SetTimeStartEnd( data.codeIndex, data.startTime, data.endTime )
		WaitFrame()
	}
}

void function SURVIVAL_AddCallback_OnDeathFieldStartShrink( void functionref( table<int, DeathFieldData> ) callbackFunc )
{
	Assert( !file.ServerCallbacks_OnDeathFieldStartShrink.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with SURVIVAL_AddCallback_OnDeathFieldStartShrink" )
	file.ServerCallbacks_OnDeathFieldStartShrink.append( callbackFunc )
}

void function SURVIVAL_AddCallback_OnDeathFieldStopShrink( void functionref( table<int, DeathFieldData> ) callbackFunc )
{
	Assert( !file.ServerCallbacks_OnDeathFieldStopShrink.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with SURVIVAL_AddCallback_OnDeathFieldStopShrink" )
	file.ServerCallbacks_OnDeathFieldStopShrink.append( callbackFunc )
}

void function DeathFieldCircleWait( float waitTime )
{
	#if DEVELOPER
		svGlobal.levelEnt.EndSignal( "DeathField_ShrinkNow" )
	#endif // DEVELOPER

	wait waitTime
}


void function DeathFieldShrinkThink_Thread( table<int, DeathFieldData> data, table<int, entity> deathFields )
{
	#if DEVELOPER
		svGlobal.levelEnt.EndSignal( "DeathField_ShrinkNow" )
	#endif // DEVELOPER

	foreach ( realm, deathField in deathFields )
	{
		DeathFieldData d = data[realm]
		OnThreadEnd(
			function() : ( d, deathField )
			{
				d.currentRadius = d.endRadius
			}
		)
	}

	//Fire callbacks for Death Field Shrink Start
	foreach ( void functionref( table<int, DeathFieldData> ) callback in file.ServerCallbacks_OnDeathFieldStartShrink )
		callback( data )

	float endTime = data[ Survival_Loot_GetDefaultRealm() ].endTime

	while ( Time() < endTime )
	{
		WaitFrame()
		foreach ( realm, deathField in deathFields )
		{
			data[ realm ].center = deathField.GetOrigin()
			data[ realm ].currentRadius = GraphCapped( Time(), data[ realm ].startTime, data[ realm ].endTime, data[ realm ].startRadius, data[ realm ].endRadius )
		}
	}

	//Fire callbacks for Death Field Shrink Stop
	foreach ( void functionref( table<int, DeathFieldData> ) callback in file.ServerCallbacks_OnDeathFieldStopShrink )
		callback( data )
}

entity function SafeZone_CreateEnt_( vector origin, float radius, string targetName, int realm )
{
	entity ent = CreateEntity( "prop_script" )
	ent.SetValueForModelKey( $"mdl/dev/empty_model.rmdl" )
	ent.kv.fadedist = -1
	ent.kv.renderamt = 255
	ent.kv.rendercolor = "255 255 255"
	ent.kv.solid = SOLID_VPHYSICS    // why solid? was hardcoded '6' before, likely should be '0'
	ent.SetOrigin( origin )
	ent.SetAngles( <0, 0, 0> )
	ent.NotSolid()
	ent.Hide()
	ent.DisableHibernation()
	ent.Minimap_SetObjectScale( radius / SURVIVAL_MINIMAP_RING_SCALE )
	ent.Minimap_SetAlignUpright( true )
	ent.Minimap_SetZOrder( 2 )
	ent.Minimap_SetClampToEdge( true )
	ent.Minimap_SetCustomState( eMinimapObject_prop_script.OBJECTIVE_AREA )
	ent.RemoveFromAllRealms()
	ent.AddToRealm( realm )
	SetTargetName( ent, targetName )
	DispatchSpawn( ent )
	return ent
}
entity function SafeZone_CreateEnt( vector origin, float radius, int realm )
{
	return SafeZone_CreateEnt_( origin, radius, "safeZone", realm )
}

entity function SafeZone_CreateEnt_NoLine( vector origin, float radius, int realm )
{
	return SafeZone_CreateEnt_( origin, radius, "safeZone_noline", realm )
}

void function SafeZone_SetRadius( entity safeZone, float radius )
{
	safeZone.Minimap_SetObjectScale( radius / SURVIVAL_MINIMAP_RING_SCALE )
}

void function SURVIVAL_RunArenaDeathField()
{
	if ( !DoesCurrentModeHaveDeathfield() )
		return

	// Cant hit RoundBased_ResetDeathfield in RoundBased modes, resulting in a crash later
	// with file.safeZone[ realm ] being invalid.  Kill the thread on this signal
	svGlobal.levelEnt.EndSignal( "GenerateDeathFieldData" )

	array<int> allRealms = Survival_Loot_GetRealmsToPopulate()

	if ( GetCurrentPlaylistVarBool( "deathfield_starts_after_ship_flyout", true ) || Deathfield_GetHasCustomStart() )
		FlagWait( "DeathCircleActive" )
	else
		FlagSet( "DeathCircleActive" )

	if ( file.deathFieldStartStage == 0 && !Deathfield_GetDoesDeathfieldStartEnabled() )
		waitthread DeathFieldCircleWait( START_WAIT_TIME )

	FlagClear( "AllowDeathFieldUpdate" )

	table<int, float> radiuses
	table<int, entity> deathFields

	ResetDeathFieldDataToDefault()

	foreach ( realm in allRealms )
	{
		// Set starting death field radius in all realms
		{
			Assert( file.deathFieldStages[ realm ].len() > 0 )
			DeathFieldData data = file.deathFieldData[ realm ]
			float radius = min( 65536.0, data.startRadius )
			radiuses[ realm ] <- radius
		}

		// Spawn deathfield mover in each realm
		{
			DeathFieldData data = file.deathFieldData[ realm ]

			entity deathField = CreateEntity( "script_mover" )
			deathField.SetValueForModelKey( $"mdl/dev/empty_model.rmdl" )
			deathField.kv.SpawnAsPhysicsMover = 0
			deathField.kv.fadedist = -1
			deathField.kv.renderamt = 255
			deathField.kv.rendercolor = "255 255 255"
			deathField.kv.solid = 0
			deathField.SetOrigin( data.center )
			deathField.SetAngles( <0, 0, 0> )
			deathField.NotSolid()
			deathField.Hide()
			deathField.DisableHibernation()
			deathField.SetScriptName( "deathField" )
			deathField.RemoveFromAllRealms()
			deathField.AddToRealm( realm )
			SetTargetName( deathField, "deathField" )
			deathFields[ realm ] <- deathField
		}

		// Show where ring will close to in all realms, track stats
		{
			DeathFieldData data = file.deathFieldData[ realm ]

			entity safeZone
			bool useSafezoneNoLine = GetCurrentPlaylistVarBool( "deathfield_use_safezone_noline", false )
			if ( !useSafezoneNoLine )
			{
				safeZone = SafeZone_CreateEnt( data.center, radiuses[ realm ], realm )
			}
			else
			{
				safeZone = SafeZone_CreateEnt_NoLine( data.center, radiuses[ realm ], realm )
			}
			file.safeZone[ realm ] <- safeZone

			StatsHook_SetDeathCircle( data.center, radiuses[ realm ], "end_circle_close" )
			StatsHook_SetSafeZone( data.center, radiuses[ realm ] )
		}
	}

	bool spawnedDeathfield = false

	if ( Deathfield_GetDoesDeathfieldStartEnabled() )
	{
		spawnedDeathfield = true
		SetCurrentDeathFieldStage( file.deathFieldStartStage )

		foreach ( realm, deathField in deathFields )
		{
			DeathFieldData data = file.deathFieldData[ realm ]
			FinalizeDeathfieldSpawn( data, deathField, realm )
		}
	}

	foreach ( realm, deathField in deathFields )
	{
		entity safeZone     = file.safeZone[ realm ]
		foreach ( player in GetPlayerArrayIncludingSpectators() )
		{
			safeZone.Minimap_Hide( 0, player )
		}
	}

	FlagWaitClear( "DeathFieldPaused" )

	for ( int deathFieldStage = file.deathFieldStartStage; deathFieldStage < file.deathFieldStageData.len(); deathFieldStage++ )
	{
		FlagWaitClear( "DeathFieldPaused" )

		table<int, vector> allStarts
		table<int, float> allStartRadiuses

		foreach ( realm in allRealms )
		{
			vector startPos   = deathFields[realm].GetOrigin()
			allStarts[ realm ] <- startPos

			DeathFieldData data = file.deathFieldData[ realm ]
			float startRadius = data.endRadius
			allStartRadiuses[ realm ] <- startRadius
		}

		SetCurrentDeathFieldStage( deathFieldStage )
		bool shouldDoPreWait = true // ( i > file.deathFieldStartStage || file.deathFieldStartStage == 0 )

		if ( file.deathFieldStartStage > 0 )
		{
			if ( !spawnedDeathfield )
			{
				spawnedDeathfield = true

				foreach ( realm, deathField in deathFields )
				{
					DeathFieldData data = file.deathFieldData[ realm ]
					FinalizeDeathfieldSpawn( data, deathField, realm )
				}
			}
		}

		foreach ( realm, deathField in deathFields )
		{
			DeathFieldStageData stage = file.deathFieldStages[ realm ][deathFieldStage]
			float preShrinkDuration   = shouldDoPreWait ? stage.preShrinkDuration : 0.0

			DeathFieldData data = file.deathFieldData[ realm ]
			data.startTime = Time() + preShrinkDuration + MARGIN_WAIT_TIME

			if ( GetCurrentPlaylistVarBool( "deathfield_starts_in_prematch", false ) && GetGameState() == eGameState.Prematch )
				data.startTime += GetCustomIntroLength()

			data.endTime = data.startTime + stage.shrinkDuration
			data.startRadius = data.endRadius
			data.endRadius = stage.endRadius
		}

		float startTime = file.deathFieldData[ allRealms[0] ].startTime
		SetGlobalNetTime( "nextCircleStartTime", startTime - MARGIN_WAIT_TIME )

		foreach ( void functionref( int, float ) callback in file.onSurvivalDeathFieldStageChangedCallbacks )
			thread callback( deathFieldStage, startTime - MARGIN_WAIT_TIME )

		foreach ( realm, deathField in deathFields )
		{
			entity safeZone = file.safeZone[ realm ]
			DeathFieldData data = file.deathFieldData[ realm ]

			foreach ( player in GetPlayerArrayIncludingSpectators() )
			{
				if ( player.DoesShareRealms( safeZone ) )
				{
					safeZone.Minimap_AlwaysShow( 0, player )
				}
				else
				{
					safeZone.Minimap_Hide( 0, player )
				}
			}
			safeZone.SetOrigin( data.nextCenter )

			float radius = min( 65536.0, data.endRadius )
			SafeZone_SetRadius( safeZone, radius )
			StatsHook_SetSafeZone( data.nextCenter, radius )
		}

		svGlobal.levelEnt.Signal( "NewDeathFieldStarting" )

		if ( shouldDoPreWait )
		{
			DeathFieldStageData stage = file.deathFieldStages[ allRealms[0] ][deathFieldStage]
			DeathFieldData data = file.deathFieldData[ allRealms[0] ]

			// Need to set the current damage per tick if the ring starts enabled otherwise it will be the last set which was done in GenerateDeathFieldStageData which runs CreateDeathFieldStageData
			// Because GenerateDeathFieldStageData runs through each ring stage from 0 to last, the current damage tick right now is actually for the final ring stage not the first
			if ( Deathfield_GetDoesDeathfieldStartEnabled() )
				data.percentDamagePerTick = stage.percentDamagePerTick

			AddSurvivalCommentaryEvent( eSurvivalEventType.ROUND_TIMER_STARTED )

                             
                                                                              
     
                                                                                             

                                                                    
      
                                                
                                                                                  
                                                          
      
     
        
                                   
				{
					float waitTime = stage.preShrinkDuration
					if ( GetCurrentPlaylistVarBool( "deathfield_starts_in_prematch", false ) && GetGameState() == eGameState.Prematch )
						waitTime += GetCustomIntroLength()

					waitthread DeathFieldCircleWait( waitTime )
				}


			// only change these settings if we dev-skipped the previous circle since it will send an unwated message
			#if DEVELOPER
				if ( fabs( Time() + MARGIN_WAIT_TIME - data.startTime ) > 1.0 )
				{
					printt( "reset net time" )
					data.startTime = Time() + MARGIN_WAIT_TIME
					SetGlobalNetTime( "nextCircleStartTime", data.startTime - MARGIN_WAIT_TIME )
					data.endTime = data.startTime + stage.shrinkDuration
				}
			#endif // DEVELOPER
		}

		FlagWaitClear( "DeathFieldPaused" )

		int deathFieldStagesLength = 0
		foreach ( realm in allRealms )
		{
			DeathFieldStageData stage = file.deathFieldStages[ realm ][deathFieldStage]
			deathFieldStagesLength = file.deathFieldStages[ realm ].len()
			DeathFieldData data = file.deathFieldData[ realm ]

			data.percentDamagePerTick = stage.percentDamagePerTick
		}

		if ( deathFieldStage == 0 )
		{
			AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVING )
		}
		else if ( deathFieldStage == deathFieldStagesLength - 1 )
		{
			if ( RandomIntRange( 0, 99 ) < 50 )
				AddSurvivalCommentaryEvent( eSurvivalEventType.FINAL_CIRCLE_MOVING )
			else
				AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_CLOSING_TO_NOTHING )
		}
		else
		{
			AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVING )
		}

		foreach ( player in GetPlayerArray_Alive() )
		{
			Remote_CallFunction_NonReplay( player, "ServerCallback_AnnounceCircleClosing" )
		}

		wait MARGIN_WAIT_TIME

		FlagSet( "SUR_DeathFieldShrinking" )

		if ( !spawnedDeathfield )
		{
			spawnedDeathfield = true

			foreach ( realm, deathField in deathFields )
			{
				DeathFieldData data = file.deathFieldData[ realm ]
				FinalizeDeathfieldSpawn( data, deathField, realm )
			}
		}

		table<int, vector> finalPositions
		foreach ( realm, deathField in deathFields )
		{
			DeathFieldData data = file.deathFieldData[ realm ]
			DeathFieldStageData stage = file.deathFieldStages[ realm ][deathFieldStage]

			StatsHook_SetDeathCircle( data.center, data.startRadius, "start_circle_close" )

			vector finalPosition = < data.nextCenter.x, data.nextCenter.y, Survival_GetMapFloorZ( data.nextCenter ) >
			finalPositions[ realm ] <- finalPosition

			deathField.NonPhysicsMoveTo( finalPosition, stage.shrinkDuration, 0, 0 )
		}

		// time when circle stops moving.
		SetGlobalNetTime( "circleCloseTime", Time() + file.deathFieldStages[ allRealms[0] ][deathFieldStage].shrinkDuration )

		waitthread DeathFieldShrinkThink_Thread( file.deathFieldData, deathFields )

		foreach ( realm, deathField in deathFields )
		{
			DeathFieldData data = file.deathFieldData[ realm ]

			data.currentRadius = data.endRadius
			deathField.NonPhysicsStop()
			deathField.SetOrigin( finalPositions[ realm ] )
			data.center = deathField.GetOrigin()
		}

		// only change these settings if we dev-skipped the previous circle since it will send an unwated message
		#if DEVELOPER
			if ( Time() < GetGlobalNetTime( "nextCircleStartTime" ) + MARGIN_WAIT_TIME + file.deathFieldStages[ allRealms[0] ][deathFieldStage].shrinkDuration - 1.0 )
			{
				SetGlobalNetTime( "nextCircleStartTime", Time() - (file.deathFieldStages[ allRealms[0] ][deathFieldStage].shrinkDuration + file.deathFieldStages[ allRealms[0] ][deathFieldStage].preShrinkDuration) )
			}
		#endif // DEVELOPER

		foreach ( realm, deathField in deathFields )
		{
			DeathFieldData data = file.deathFieldData[ realm ]
			DeathFieldStageData stage = file.deathFieldStages[ realm ][deathFieldStage]

			StatsHook_SetDeathCircle( data.nextCenter, data.currentRadius, "end_circle_close" )

			if ( deathFieldStage + 1 < file.deathFieldStages[realm].len() )
			{
				DeathFieldStageData nextStage = file.deathFieldStages[realm][deathFieldStage + 1]
				float frac                    = 1.0 - (nextStage.endRadius / stage.endRadius)
				data.nextCenter = nextStage.endPos // GetRandomCenter( data.center, 0, data.currentRadius * frac )
			}

			if ( stage.minimapZoomScale != -1.0 )
			{
				const float MINIMAP_ZOOM_LERP_TIME = 3.0
				foreach ( p in GetPlayerArray() )
					p.SetMinimapZoomScale( stage.minimapZoomScale, MINIMAP_ZOOM_LERP_TIME )
			}
		}

		FlagClear( "SUR_DeathFieldShrinking" )

		wait 4.0

		foreach ( realm, startPos in allStarts )
			thread CleanupOutsideCircle( realm, startPos, allStartRadiuses[ realm ] )

		SurveyBeacons_RemoveSurveyZones()

		file.circlesCompleted = deathFieldStage

		FlagWaitClear( "DeathFieldPaused" )
	}

	foreach ( realm, deathField in deathFields )
	{
		DeathFieldData data = file.deathFieldData[ realm ]
		//if last radius is tiny (default is "1" for the shipped game), it might as well be zero for damage purposes
		//other modes sometimes override the final circle to be substantial size
		if ( data.currentRadius < 5 )
			data.currentRadius = 0.0
	}

	WaitForever()
}

void function FinalizeDeathfieldSpawn( DeathFieldData data, entity deathField, int realm )
{
	DispatchSpawn( deathField )
	thread DeathFieldDamage( data, deathField )
	thread DeathFieldKeepCodeUpdated_THREAD( data, deathField )

	file.deathField[ realm ] <- deathField

	deathField.EndSignal( "OnDestroy" )
}

void function CleanupOutsideCircle( int realm, vector startPos, float startRadius )
{
	if ( startRadius > REALBIG_CIRCLE_END_RADIUS )
		return

	svGlobal.levelEnt.Signal( "CleanupOutsideCircle" )
	svGlobal.levelEnt.EndSignal( "CleanupOutsideCircle" )

	array<entity> npcTitans = GetNPCArrayByClass( "npc_titan" )
	array<entity> loot      = GetEntArrayByClass_Expensive( "prop_survival" )

	int numComparesPerFrame = 5
	int numCompares         = 0

	foreach ( titan in npcTitans )
	{
		if ( IsValid( titan ) )
		{
			if ( !titan.IsInRealm( realm ) )
				continue

			if ( Distance2D( startPos, titan.GetOrigin() ) > startRadius )
			{
				titan.Die()
			}
			if ( ++numCompares > numComparesPerFrame )
			{
				numCompares = 0
				WaitFrame()
			}
		}
	}

	float persistTime = 0.0

	foreach ( item in loot )
	{
		if ( IsValid( item ) )
		{
			if ( !item.IsInRealm( realm ) )
				continue

			persistTime = PERSIST_TIME_OUTSIDE_CIRCLE_DEFAULT

			entity p = item.GetParent()
			if ( IsValid( p ) )
			{
				if ( p.GetTargetName() == DEATH_BOX_TARGETNAME )
				{
					persistTime = PERSIST_TIME_OUTSIDE_CIRCLE_LONG
				}
			}

			if ( item.e.spawnTime + persistTime < Time() && Distance2D( startPos, item.GetOrigin() ) > startRadius )
			{
				item.Destroy()
			}
			if ( ++numCompares > numComparesPerFrame )
			{
				numCompares = 0
				WaitFrame()
			}
		}
	}
}

#if DEVELOPER
// this totally works!
void function DEV_DestroyAllLootOutsideDeathField()
{
	array<int> allRealms = Survival_Loot_GetRealmsToPopulate()
	table<int, vector> allStarts
	table<int, float> allStartRadiuses

	foreach ( realm in allRealms )
	{
		DeathFieldData data = file.deathFieldData[ realm ]
		vector startPos   = data.center
		allStarts[ realm ] <- startPos

		float startRadius = data.endRadius
		allStartRadiuses[ realm ] <- startRadius
	}

	foreach ( realm, startPos in allStarts )
		DestroyAllLootOutsideDeathField( realm, startPos, allStartRadiuses[ realm ] )
}
#endif // DEVELOPER

// This should only be done during setup or through the a console commond, use CleanupOutsideCircle during gameplay as it limits operations per frame
void function DestroyAllLootOutsideDeathField( int realm, vector startPos, float startRadius )
{
	array<entity> loot      = GetEntArrayByClass_Expensive( "prop_survival" )

	foreach ( item in loot )
	{
		if ( IsValid( item ) )
		{
			if ( !item.IsInRealm( realm ) )
				continue

			if ( Distance2D( startPos, item.GetOrigin() ) > startRadius )
			{
				item.Destroy()
			}
		}
	}
}

bool function ShouldDeathFieldDamage()
{
	if ( GamePlaying() )
		return true

	if ( GetGameState() == eGameState.Prematch && GetCurrentPlaylistVarBool( "deathfield_starts_in_prematch", false ) )
		return true

	return false
}

void function DeathFieldDamage( DeathFieldData data, entity deathField )
{
	deathField.EndSignal( "OnDestroy" )

	while ( ShouldDeathFieldDamage() )
	{
		                               
		if ( Deathfield_GetDoesDeathfieldStartEnabled() )
		{
			FlagWait( "PlaneDoorOpen" )
		}
		else
                                       
		{
			FlagWaitClear( "DeathFieldPaused" )
		}

		float currentRadius = data.currentRadius

		foreach ( player in GetPlayerArray_Alive() )
		{
			if ( !player.DoesShareRealms( deathField ) )
				continue

			if ( HasDeathFieldImmunity( player ) )
				continue

			//phasing and not in phase_runner
			if ( player.IsPhaseShifted() && !StatusEffect_HasSeverity( player, eStatusEffect.phase_gate_tracking ) )
			{
				if ( player.GetPhaseShiftType() != PHASETYPE_DOOR )
				{
					continue
				}
			}

			float playerDist = Distance2D( player.GetOrigin(), data.center )
			if ( playerDist > currentRadius  || fabs( playerDist - currentRadius ) < FLT_EPSILON )
			{
				if ( GetRingTuningOverrideVar ( "deathfield_damages_shield", 0.0 ) == 1.0 )
					player.TakeDamage( int( data.percentDamagePerTick * float( player.GetMaxHealth() ) ), null, null, { scriptType = DF_DOOMED_HEALTH_LOSS, damageSourceId = eDamageSourceId.deathField } )
				else
				{
                                     
						Deathfield_EnforcedRingLethality_DeathFieldDamage( player, data, deathField )
          
                                                                                                                                                                                                                
           
				}
				PIN_RingTick ( player )
			}
		}

                       
                                         
   
                           
            

                                              
            

                                                                        
            

                                                            
                              
    
                                   
                                                                                                           
                                                    
    
       
    
                                     
    
   
                             

		foreach ( tunnelEnt in PhaseTunnel_GetAllTunnelEnts() )
		{
			if ( !IsValid( tunnelEnt ) )
				continue

			if ( !tunnelEnt.DoesShareRealms( deathField ) )
				continue

			if ( !PhaseTunnel_IsTunnelValid( tunnelEnt ) )
				continue

			if ( StatusEffect_HasSeverity( tunnelEnt, eStatusEffect.ring_immunity ) )
				continue

			vector start = PhaseTunnel_GetTunnelStart( tunnelEnt )
			vector end = PhaseTunnel_GetTunnelEnd( tunnelEnt )

			if ( !IsValid( start ) || !IsValid( end ) )
				continue

			float dist = Distance2D( start, data.center )

			if ( dist > currentRadius )
			{
				float dist2 = Distance2D( end, data.center )

				if ( dist2 > currentRadius )
				{
					tunnelEnt.e.deathfieldDamageTicks++
					if ( tunnelEnt.e.deathfieldDamageTicks > GetCurrentPlaylistVarInt( "phase_tunnel_deathfield_max_ticks", 3 ) )
					{
						PhaseTunnel_MarkForDelete( tunnelEnt )
						tunnelEnt.Signal( "PhaseTunnel_DestroyTunnel" )
					}
				}
			}
			else
			{
				tunnelEnt.e.deathfieldDamageTicks = 0
			}
		}

		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_AIRDROPEXTRA ) )
		{
			foreach ( clusterEnt in AirdropExtravaganza_GetClusterEntities() )
			{
				if ( !IsValid( clusterEnt ) )
					continue

				if ( !clusterEnt.DoesShareRealms( deathField ) )
					continue

				float dist = Distance2D( clusterEnt.GetOrigin(), data.center )

				if ( dist > currentRadius )
				{
					clusterEnt.Destroy()
				}
			}

			bool killAirdropsInDeathField = GetCurrentPlaylistVarBool( "airdrops_kill_in_deathfield_enabled", false )
			if ( killAirdropsInDeathField )
			{
				foreach ( airdropPod in AirdropExtravaganza_GetTrackedAirdropPods() )
				{
					if ( !IsValid( airdropPod ) )
						continue

					if ( !airdropPod.DoesShareRealms( deathField ) )
						continue

					float dist = Distance2D( airdropPod.GetOrigin(), data.center )

					if ( dist > currentRadius )
					{
						airdropPod.Signal("DroppodRemoveLocationMarker")
						if ( !killAirdropsInDeathField )
							continue

						airdropPod.e.deathfieldDamageTicks++
						if ( airdropPod.e.deathfieldDamageTicks > GetCurrentPlaylistVarInt( "airdrop_deathfield_max_ticks", 10 ) )
							AirdropExtravaganazaCleanupPod( airdropPod, 1.0 )
					}
				}
			}
		}

		foreach ( entity npc in GetNPCArray() )
		{
			if ( !IsValid( npc ) || !IsAlive( npc ) )
				continue

			if ( !npc.DoesShareRealms( deathField ) )
				continue

			if ( npc.ai.hasDeathFieldImmunity )
				continue

			float npcDist = Distance2D( npc.GetOrigin(), data.center )
			if ( npcDist > currentRadius )
				npc.TakeDamage( int( data.percentDamagePerTick * float( npc.GetMaxHealth() ) ), null, null, { scriptType = DF_BYPASS_SHIELD | DF_DOOMED_HEALTH_LOSS, damageSourceId = eDamageSourceId.deathField } )
		}

		foreach ( entity flyer in Flyers_GetAllFlyers() )
		{
			if ( !IsValid( flyer ) )
				continue

			if ( !flyer.DoesShareRealms( deathField ) )
				continue

			if ( StatusEffect_HasSeverity( flyer, eStatusEffect.ring_immunity ) )
				continue

			float flyerDist = Distance2D( flyer.GetOrigin(), data.center )
			if ( flyerDist > currentRadius )
				flyer.TakeDamage( int( data.percentDamagePerTick * float( flyer.GetMaxHealth() ) ), null, null, { scriptType = DF_BYPASS_SHIELD | DF_DOOMED_HEALTH_LOSS, damageSourceId = eDamageSourceId.deathField } )
		}

		wait DEATHFIELD_DAMAGE_CHECK_STEP_TIME
	}
}

void function ClientCommand_UpdateCirclePos( entity player, array<string> args )
{
	if ( args.len() < 2 )
		return

	bool cheatsEnabled = GetConVarBool( "sv_cheats" )
	if ( !cheatsEnabled )
	{
		BigWarningLog( "UpdateCirclePos - disabled (server cheats are off): " + player )
		return
	}
	if ( !Flag( "AllowDeathFieldUpdate" ) )
	{
		BigWarningLog( "UpdateCirclePos - no longer allowed to change circle pos" )
		return
	}

	float argX    = float( args[0] )
	float argY    = float( args[1] )
	vector newPos = <argX, argY, 0>

	#if DEV
		thread DEV_ForceDeathFieldPosition( newPos )
	#endif // DEV
}

#if DEVELOPER
void function DEV_ForceDeathFieldPosition( vector endPos )
{
	if ( !SURVIVAL_IsValidCircleLocation( endPos ) )
	{
		Warning( "Invalid Circle Location Requested: " + endPos )
		return
	}
	GenerateDeathFieldData( endPos, 5.0 )
}

struct DebugCenterStruct
{
	vector circleCenterA
	vector circleCenterB
}


void function DEV_SimulateFinalLocations( int tries = 2000, float drawTime = 600.0, bool generateCircles = true, float waitTime = 0.0, float circleDrawTime = 1.0, bool showCirclePull = false, bool showLastCircle = false )
{
	int MAX_PER_FRAME = generateCircles ? 1 : 100
	int currentCount = 0

	int gridCount = MAX_GRID / gridwidth

	array< array< DebugGridData > > mapGrid
	array< DebugCenterStruct > centers

	mapGrid.resize( gridCount )
	for ( int i = 0; i < mapGrid.len(); i++ )
	{
		mapGrid[i].resize( gridCount )
	}

	float offset = float( MAX_GRID ) / 2.0

	for ( int i = 0; i < tries; i++ )
	{
		vector o = GetFinalDeathFieldLocation()
		//printt( "Final location: " + o )

		// populate grid
		{
			vector g = GetGridPos( o )
			int gridPosX = int( g.x )
			int gridPosY = int( g.y )

			if (
			(gridPosX >= 0 && gridPosX < gridCount) &&
			(gridPosY >= 0 && gridPosY < gridCount)
				)
			{
				mapGrid[gridPosX][gridPosY].count += 1
				if ( !(o in mapGrid[gridPosX][gridPosY].locationCount) )
					mapGrid[gridPosX][gridPosY].locationCount[ o ] <- 0

				mapGrid[gridPosX][gridPosY].locationCount[ o ] += 1
			}
		}

		if ( generateCircles )
			GenerateDeathFieldData( o, waitTime )
		currentCount++

		DebugCenterStruct centerStruct
		centerStruct.circleCenterA = file.deathFieldStageData[0].endPos
		centerStruct.circleCenterB = file.deathFieldStageData[file.deathFieldStageData.len() - 2].endPos
		centers.append( centerStruct )

		if ( waitTime != 0 )
			wait waitTime
	}

	float minHeight = 5000

	float lowestPercent = 100.0
	float highestPercent = 0.0
	int numValidSquares = 0

	for ( int i = 0; i < gridCount; i++ )
	{
		for ( int j = 0; j < gridCount; j++ )
		{
			int count = mapGrid[i][j].count
			if ( count > 0 )
			{
				float percent = ((float(count) * 100.0) / float( tries ))
				if ( percent > highestPercent )
					highestPercent = percent
				if ( percent < lowestPercent )
					lowestPercent = percent

				numValidSquares++
			}
		}
	}

	printt( "ideal percent - " + (100.0 / float( numValidSquares )) )

	printt( "lowestPercent " + lowestPercent )
	printt( "highestPercent " + highestPercent )

	for ( int i = 0; i < gridCount; i++ )
	{
		for ( int j = 0; j < gridCount; j++ )
		{
			int count = mapGrid[i][j].count
			if ( count > 0 )
			{
				float percent = ((float(count) * 100.0) / float( tries ))
				vector pos    = < (i * gridwidth) - offset, (j * gridwidth) - offset, 0 > + <gridwidth / 2, gridwidth / 2, 0>
				vector pos1   = pos + <0, 0, 10000>

				float colorGrade = GraphCapped( percent, lowestPercent, highestPercent, 0.0, 255.0 )
				vector color = <colorGrade, colorGrade, colorGrade>

				DebugDrawCircle( pos1, <0, 0, 0>, gridwidth / 2.0, int(color.x), int(color.y), int(color.z), true, drawTime )
				DebugDrawLine( pos1 + < -gridwidth / 2 + 1, gridwidth / 2 - 1, 0>, pos1 + < gridwidth / 2 - 1, gridwidth / 2 - 1, 0>, int(color.x), int(color.y), int(color.z), true, drawTime )
				DebugDrawLine( pos1 + < -gridwidth / 2 + 1, -gridwidth / 2 + 1, 0>, pos1 + < gridwidth / 2 - 1, -gridwidth / 2 + 1, 0>, int(color.x), int(color.y), int(color.z), true, drawTime )
				DebugDrawLine( pos1 + < -gridwidth / 2 + 1, -gridwidth / 2 + 1, 0>, pos1 + < -gridwidth / 2 + 1, gridwidth / 2 - 1, 0>, int(color.x), int(color.y), int(color.z), true, drawTime )
				DebugDrawLine( pos1 + < gridwidth / 2 - 1, -gridwidth / 2 + 1, 0>, pos1 + < gridwidth / 2 - 1, gridwidth / 2 - 1, 0>, int(color.x), int(color.y), int(color.z), true, drawTime )

				//if  ( percent >= 1.0 ) //(lowestPercent+highestPercent)/2.0 )
				DebugDrawText( pos1, percent + " ", false, drawTime )

				// foreach ( loc, num in mapGrid[i][j].locationCount )
				// {
				// 	DebugDrawLine( loc, loc + <0, 0, 1000> + (<0, 0, num * 1000>), <0, 255, 0>, true, drawTime )
				// 	DebugDrawCircle( loc + <0,0,2500>, <0, 0, 1>, 200.0, <0, 255, 0>, true, drawTime )
				// }
			}
		}
	}

	if ( showCirclePull || showLastCircle )	// Draw a line from one circle center to another
	{
		int i = 0
		foreach ( centerStruct in centers )
		{
			if ( showCirclePull )
				//DebugDrawLine( centerStruct.circleCenterA, centerStruct.circleCenterB, <255, 0, 0>, true, drawTime )

			if ( showLastCircle )
				//DebugDrawCircle( centerStruct.circleCenterB + <0,0,2500>, <0, 0, 1>, 2000.0, <255, 255, 0>, true, drawTime )

			i++
		}
	}
}

vector function GetGridPos( vector loc )
{
	float offset = float( MAX_GRID ) / 2.0
	int gridPosX = int( (loc.x + offset) / float( gridwidth ) )
	int gridPosY = int( (loc.y + offset) / float( gridwidth ) )

	return < gridPosX, gridPosY, 0 >
}

void function DEV_MonteCarloFinalLocations( int tries = 2000, float drawTime = 300.0, float percentileStart = 0, float percentileEnd = 1.0, bool noRelativeCompare = false )
{
	file.debug_DisplayUnprocessedEndPoints = true
	file.debug_UnprocessedEndPoints.clear()

	// Duplicate script for debug draw ONLY
	array<entity> allLootBins = GetAllLootBins()
	float max_X, max_Y, min_X, min_Y
	foreach ( entity bin in allLootBins )
	{
		vector origin = bin.GetOrigin()
		if ( origin.x < min_X )
			min_X = origin.x
		else if ( origin.x > max_X )
			max_X = origin.x

		if ( origin.y < min_Y )
			min_Y = origin.y
		else if ( origin.y > max_Y )
			max_Y = origin.y
	}

	vector lootBinCenter = < (max_X + min_X) * 0.5, (max_Y + min_Y) * 0.5, 0 >
	float width          = (max_X - min_X) * 0.5
	float height         = (max_Y - min_Y) * 0.5
	float lootBinRadius  = sqrt( (width * width) + (height * height) )
	float smallRadius = width > height ? width : height

	//DebugDrawLine( < max_X, min_Y, 0 >, < min_X, min_Y, 0 >, COLOR_MAGENTA, true, drawTime )
	//DebugDrawLine( < max_X, max_Y, 0 >, < min_X, max_Y, 0 >, COLOR_MAGENTA, true, drawTime )
	//DebugDrawLine( < min_X, max_Y, 0 >, < min_X, min_Y, 0 >, COLOR_MAGENTA, true, drawTime )
	//DebugDrawLine( < max_X, max_Y, 0 >, < max_X, min_Y, 0 >, COLOR_MAGENTA, true, drawTime )
	//DebugDrawSphere( lootBinCenter, 128, COLOR_MAGENTA, true, drawTime )
	//DebugDrawSphere( < 0, 0, 0 >, 128, <255, 255, 0>, true, drawTime )

	//DebugDrawCircle( lootBinCenter + < 0, 0, 5000 >, < 0, 0, 1>, REALBIG_CIRCLE_END_RADIUS, <255, 255, 0>, true, drawTime )
	//DebugDrawCircle( lootBinCenter + < 0, 0, 5000 >, < 0, 0, 1>, lootBinRadius, COLOR_CYAN, true, drawTime )
	DebugDrawCircle( lootBinCenter + < 0, 0, 5000 >, < 0, 0, 1>, smallRadius, 0, 255, 120, true, drawTime )

	// Generate points, n per frame
	printt( "    | DEV_MonteCarloFinalLocations running..." )
	printt( "        | Calculating final locations..." )
	array<vector> endPoints
	int actionPerFrameCounter
	for ( int i = 0; i < tries; i++ )
	{
		endPoints.append( GetFinalDeathFieldLocation() )
		actionPerFrameCounter++

		if ( actionPerFrameCounter == 100 )
		{
			actionPerFrameCounter = 0
			WaitFrame()
		}
	}

	printt( "        | Drawing unprocessed end points..." )
	actionPerFrameCounter = 0
	for ( int i = 0; i < tries; i++ )
	{
		vector loc = file.debug_UnprocessedEndPoints[ i ]
		DebugDrawAxis( < loc.x, loc.y, -2500 >, < 0, 0, 0>, drawTime, 64, < 200, 0, 255> )
		actionPerFrameCounter++

		if ( actionPerFrameCounter == 100 )
		{
			actionPerFrameCounter = 0
			WaitFrame()
		}
	}

	// Parse nearby points
	printt( "        | Getting neighbor counts..." )
	int neighborRadius = 1536
	int neighborRadiusSQ = neighborRadius * neighborRadius
	int debug_TopNeighborCount
	int debug_TopNeighborCountIdx
	float avgNeighborCount
	array<int> endLocationNeighborCount
	for ( int i = 0; i < tries; i++ )
	{
		vector endLoc = endPoints[ i ]
		endLocationNeighborCount.append( 0 )
		for ( int j = 0; j < tries; j++ )
		{
			if ( i == j )
				continue

			vector curLoc = endPoints[ j ]

			if ( DistanceSqr( endLoc, curLoc ) <= neighborRadiusSQ )
			{
				endLocationNeighborCount[ i ]++
				if ( endLocationNeighborCount[ i ] > debug_TopNeighborCount )
				{
					debug_TopNeighborCount = endLocationNeighborCount[ i ]
					debug_TopNeighborCountIdx = i
				}
			}
		}
		avgNeighborCount += float( endLocationNeighborCount[ i ] )
	}

	actionPerFrameCounter = 0
	printt( "        | Drawing locations..." )
	int colorMaxNeighbors = debug_TopNeighborCount > 10 ? debug_TopNeighborCount : 10
	for ( int i = 0; i < tries; i++ )
	{
		float neighborFracRelative = min( float( endLocationNeighborCount[ i ] ) / float ( debug_TopNeighborCount ), 1.0 )

		if ( neighborFracRelative > percentileEnd || neighborFracRelative < percentileStart )
			continue


		// Define the color ranges. A value of 0.1 means if neighbor count is 10% of total tested positions.
		// - No more than 6 indexes. Unless you change how color rendering works.
		// - First index should be 0, unless you don't want to draw values below a threshold.
		// - Last index also includes all values above it, all the way to 100%.

		// Currently using: 0, 1%, 2%, 4%, 8%
		const array<float> COLOR_STAGE_PERCENT_VALUES = [ 0.0, 0.01, 0.02, 0.04, 0.08 ]

		float neighborFracTotalDrawn = min( float( endLocationNeighborCount[ i ] ) / float ( tries ), 1.0 )
		vector colorToDraw = GetSpectrumColorForValue( neighborFracTotalDrawn, COLOR_STAGE_PERCENT_VALUES )

		vector endLoc = endPoints[ i ]

		// Line above endpoint indicating (with height) how the num neighbors stacks up relative to all other endpoints
		const float MAX_DISPLAY_HEIGHT = 10000
		vector heightStart = FlattenVec( endLoc )
		vector heightEnd   = heightStart + <0, 0, 3500 + (MAX_DISPLAY_HEIGHT * neighborFracRelative) >

		if ( noRelativeCompare )
		{
			heightStart = endLoc
			heightEnd = endLoc + < 0, 0, 7000 >
		}

		DebugDrawLine( heightStart, heightEnd + <0, 0, 5000 >, int(colorToDraw.x), int(colorToDraw.y), int(colorToDraw.z), true, drawTime )
		//DebugDrawLine( heightStart, heightEnd, 200, 200, 200, true, drawTime )
		DebugDrawAxis( heightEnd + < 0, 0, 64>, < 0, 0, 0 >, drawTime, 32, < 255, 255, 255 > )

		DebugDrawLine( FlattenVec(endLoc), FlattenVec(file.debug_UnprocessedEndPoints[ i ]) + < 0, 0, -2500 >, 150, 150, 150, true, drawTime )
		actionPerFrameCounter++
		if ( actionPerFrameCounter > 100 )
		{
			actionPerFrameCounter = 0
			WaitFrame()
		}
	}


	const int PERCENTILE_STEP = 16
	const int NUM_PERCENTILE_IDX = (100 / PERCENTILE_STEP) + 1
	avgNeighborCount /= tries
	array<int> clonedNeighborData = clone endLocationNeighborCount
	clonedNeighborData.sort( SortLowestInt )
	int[ NUM_PERCENTILE_IDX ] pointsPerPercentile = [ 0, ... ]
	float percentileValueStep   = float( debug_TopNeighborCount ) / float( PERCENTILE_STEP )
	for ( int i; i < tries; i++ )
	{
		float percentile = float( clonedNeighborData[ i ] ) / percentileValueStep
		int percentileIdx = minint( int( percentile ), (100 / PERCENTILE_STEP) )
		pointsPerPercentile[ percentileIdx ]++
	}

	printt( "    | RESULTS ==============" )
	printt( "        | Most neighbors:", debug_TopNeighborCount )
	printt( "        | Avg num neighbors:", avgNeighborCount )
	printt( "		  | Percentiles of top neighbor count" )
	float percentileSum
	for ( int i; i < NUM_PERCENTILE_IDX; i++ )
	{
		percentileSum += 100 * (float( pointsPerPercentile[ i ] ) / float( tries ))
		printf( "		  |   %4i%% [%4.1f] %5i ( %5.2f%%, %5.2f%% )", i * PERCENTILE_STEP, percentileValueStep * float( i ), pointsPerPercentile[ i ], 100 * (float( pointsPerPercentile[ i ] ) / float( tries )), percentileSum )
	}
}

vector function GetSpectrumColorForValue( float val, array<float> colorStages = [ 0.0, 0.25, 0.5, 0.8, 1.0 ] )
{
	Assert( colorStages.len() == 5, "Warning! Color stages array has incorrect number of entries!" )
	Assert( val >= 0 && val <= 1.0, "Warning! Val provided is outside of legal range [0, 1]!" )

	int valColorStage
	for ( int i; i < 4; i++ )
	{
		if ( val > colorStages[ i ] )
			valColorStage++
		else
			break
	}

	int prevColorStage = maxint( valColorStage - 1, 0 )
	float valStagePercent           = min( (val - colorStages[ prevColorStage ]) / (colorStages[ valColorStage ] - colorStages[ prevColorStage ]), 1.0 )
	float valStagePercentComplement = 1 - valStagePercent

	// There's probably a slicker way to do this but I can't think of it
	float color_R, color_G, color_B
	switch ( valColorStage )
	{
		// Red -> Yellow
		case 0:
			color_R = 255.0
			color_G = 255.0 * valStagePercent
			break
		// Yellow -> Green

		case 1:
			color_R = 255.0 * valStagePercentComplement
			color_G = 255.0
			break
		// Green -> Cyan

		case 2:
			color_G = 255.0
			color_B = 255.0 * valStagePercent
			break
		// Cyan -> Blue

		case 3:
			color_G = 255.0 * valStagePercentComplement
			color_B = 255.0
			break
		// Blue -> Magenta

		case 4:
			color_B = 255.0
			color_R = 255.0 * valStagePercent
			break
	}

	return < color_R, color_G, color_B >
}

