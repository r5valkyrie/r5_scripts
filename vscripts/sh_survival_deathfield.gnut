void function GenerateDeathFieldStageData()
{
	file.deathFieldStageData.clear()

	int i = 0
	while ( true )
	{
		float radius = GetRingTuningOverrideVar( "deathfield_radius_" + i, -1.0 )

		bool allowMissingDefaults = false
		if ( radius < 0 )
		{
			if ( file.deathFieldStageData.len() > 0 )
			{
				break
			}
			else
			{
				Warning( "Survival deathfield playlist vars are missing!" )
				allowMissingDefaults = true
			}
		}

		file.deathFieldStageData.append( CreateDeathFieldStageData( i++, allowMissingDefaults ) )
	}
}

float function GetRingTuningOverrideVar ( string varName, float defaultValue )
{

	if ( GetCurrentPlaylistVarBool ("deathfield_allows_override", true ) )
	{
		//Does current playlist have ring_tuning_override?
		const string NO_RING_TUNING_OVERRIDE = ""
		string tuningOverridePlaylist = GetCurrentPlaylistVarString ( "playlist_ring_tuning_override", NO_RING_TUNING_OVERRIDE )

		if ( tuningOverridePlaylist != NO_RING_TUNING_OVERRIDE )
		{
			// There is a tuning override, fetch the value from that playlist instead
			return GetPlaylistVarFloat( tuningOverridePlaylist, varName, defaultValue )
		}
	}
	return GetCurrentPlaylistVarFloat( varName, defaultValue )

}

DeathFieldStageData function CreateDeathFieldStageData( int index, bool allowMissingDefaults )
{
	float lastRadius = SURVIVAL_Deathfield_GetStartRadius()

	if ( file.deathFieldStageData.len() > 0 )
	{
		lastRadius = file.deathFieldStageData[ file.deathFieldStageData.len() - 1 ].endRadius
	}

	bool circleDebug = GetBugReproNum() == 1001

	int currentIndex = file.deathFieldStageData.len()

	float defaultSpeed     = GetRingTuningOverrideVar( "deathfield_default_shrinkSpeed", 140.0 )
	float shrinkSpeed      = GetRingTuningOverrideVar( "deathfield_shrinkSpeed_" + index, -1.0 )
	float circleCloseSpeed = shrinkSpeed > 0 ? shrinkSpeed : defaultSpeed // per second

	DeathFieldStageData data
	data.circleDeviation = GetRingTuningOverrideVar( "deathfield_circleDeviation_" + index, 1.0 )

	if ( index < file.deathFieldStagesOverrideRadius.len() )
		data.endRadius = file.deathFieldStagesOverrideRadius[ index ]
	else
		data.endRadius = GetRingTuningOverrideVar( "deathfield_radius_" + index, allowMissingDefaults ? 20000.0 : -1.0 )

	if ( index < file.deathFieldStagesOverrideMinimapZoom.len() )
		data.minimapZoomScale = file.deathFieldStagesOverrideMinimapZoom[ index ]
	else if ( data.endRadius <= 600 )
		data.minimapZoomScale = 0.1
	else if ( data.endRadius <= 1000 )
		data.minimapZoomScale = 0.7
	else if ( data.endRadius <= 2000 )
		data.minimapZoomScale = 1.5
	else if ( data.endRadius <= 5000 )
		data.minimapZoomScale =  3.0

	data.preShrinkDuration = GetRingTuningOverrideVar( "deathfield_preShrinkDuration_" + index, allowMissingDefaults ? 240.0 : -1.0 )
	data.shrinkDuration = ((lastRadius - data.endRadius) / circleCloseSpeed)
	data.percentDamagePerTick = GetRingTuningOverrideVar( "deathfield_damagePercent_" + index, allowMissingDefaults ? 0.01 : -1.0 )

	Assert( data.endRadius > 0 )
	Assert( data.preShrinkDuration > 0 )
	Assert( data.shrinkDuration > 0 )
	Assert( data.percentDamagePerTick >= 0 )

	if ( circleDebug )
	{
		data.preShrinkDuration = 10.0
	}

	return data
}


void function InitDeathFieldDataAndStageData()
{
	file.deathFieldStartStage = 0

	GenerateDeathFieldStageData()

	file.deathFieldStartStage = GetCurrentPlaylistVarInt( "survival_death_field_start_stage", 0 )
	if ( file.deathFieldStartStage >= file.deathFieldStageData.len() )
		file.deathFieldStartStage = file.deathFieldStageData.len()
}


float function SURVIVAL_Deathfield_GetStartRadius()
{
	float startRadius = GetRingTuningOverrideVar ( "survival_death_field_start_radius", 65000 )

	if ( file.deathFieldStartStage > 0 )
	{
		startRadius = file.deathFieldStageData[file.deathFieldStartStage - 1].endRadius
	}
	else if (file.overrideStartRadius > 0)
	{
		startRadius = file.overrideStartRadius
	}

	return startRadius
}

float function SURVIVAL_Deathfield_GetStartDamage()
{
	int startStage = maxint( file.deathFieldStartStage - 1, 0 )

	return file.deathFieldStageData[startStage].percentDamagePerTick
}

bool function TeamShouldSeeBeaconMarker( int team, entity beacon )
{
	array<entity> players = GetPlayerArrayOfTeam( team )

	bool shouldSee = false

	foreach ( player in players )
	{
		if ( HasActiveSurveyZone( player ) )
			return false

		if ( PlayerShouldSeeSurveyBeaconMarkers( player, beacon ) && !HasActiveSurveyZone( player ) )
			shouldSee = true
	}

	return shouldSee
}

                    
                                                          
 
                                                                        
 

                                                          
 
                                                          
 

                                                                                       
 
                                                                             
 
                          

#if SERVER
vector function PickPosition( string positionsRawString )
{
	array<vector> positions = GamemodeUtility_ParseStringOfVectors( positionsRawString )
	int index = RandomInt( positions.len() )
	vector selectedPos = positions[index]
	return selectedPos
}
#endif // SERVER

#if SERVER
void function EntitiesDidLoad_DeathField()
{
	string startPosOverride = GetCurrentPlaylistVarString( "deathfield_start_positions", "" )
	if ( startPosOverride != "" )
	{
		vector startPos = PickPosition( startPosOverride )

		array<int> realms = Survival_Loot_GetRealmsToPopulate()
		foreach( realm in realms)
			SURVIVAL_SetDeathFieldOverrideStartPos( realm, startPos )
	}

	thread __EntitiesDidLoad()
}

void function __EntitiesDidLoad()
{
	if ( DoesCurrentModeHaveMapSetup() )
		FlagWait( "MapSetupComplete" )

	DeathFieldCreatePositions()

	array<int> realms = Survival_Loot_GetRealmsToPopulate()
	file.deathFieldData.clear()
	file.deathFieldStages.clear()
	int i = 0

	foreach ( realm in realms )
	{
		DeathFieldData data

		data.startRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.currentRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.endRadius = SURVIVAL_Deathfield_GetStartRadius()
		data.percentDamagePerTick = SURVIVAL_Deathfield_GetStartDamage()
		data.codeIndex = i++

		file.deathFieldData[ realm ] <- data

		array<DeathFieldStageData> newStages
		foreach ( dt in file.deathFieldStageData )
		{
			newStages.append( clone dt )
		}
		file.deathFieldStages[ realm ] <- newStages
	}

	if ( file.deathFieldStartStage > 0 )
	{
		foreach ( realm in realms )
		{
			file.deathFieldData[ realm ].center = file.deathFieldStages[ realm ][ file.deathFieldStartStage ].endPos
		}
		SetCurrentDeathFieldStage( file.deathFieldStartStage )
	}

	if ( GetCurrentPlaylistVarBool( "show_ring_in_airdrop", false ) )
	{
		vector circleCenter = SURVIVAL_GetDeathFieldCenter( Survival_Loot_GetDefaultRealm() )
		float circleRadius  = SURVIVAL_GetDeathFieldCurrentRadius( Survival_Loot_GetDefaultRealm() )
		entity tempZoneEnt = SafeZone_CreateEnt( circleCenter, circleRadius, Survival_Loot_GetDefaultRealm() )
		foreach ( player in GetPlayerArray() )
			tempZoneEnt.Minimap_AlwaysShow( 1, player )

		thread DeleteMinimapZoneAfterPlaneCompletes( tempZoneEnt )
	}

	ResetDeathFieldDataToDefault()

	FlagSet( "DeathFieldCalculationComplete" )
}

void function DeleteMinimapZoneAfterPlaneCompletes( entity tempZoneEnt )
{
	FlagWait( "DeathCircleActive" )

	if ( IsValid( tempZoneEnt ) )
		tempZoneEnt.Destroy()
}

void function ResetDeathFieldDataToDefault()
{
	array<int> allRealms = Survival_Loot_GetRealmsToPopulate()

	RoundBased_ResetSurveyZones()

	foreach ( realm in allRealms )
	{
		Assert( file.deathFieldStages[ realm ].len() > 0 )
		DeathFieldData data = file.deathFieldData[ realm ]
		vector startCenter  = file.deathFieldStages[ realm ][file.deathFieldStartStage].endPos

		int maxDeviation = GetCurrentPlaylistVarInt( "survival_circle_max_deviation", 0 )
		if ( maxDeviation > 0 && Distance( startCenter, <0, 0, 0> ) > maxDeviation )
			data.center = Normalize( startCenter ) * maxDeviation
		else
			data.center = startCenter

		data.nextCenter = startCenter

		if ( realm in file.overrideStartPos )
		{
			startCenter = file.overrideStartPos[ realm ]
			data.center = startCenter
		}

		DestroyAllLootOutsideDeathField( realm, data.center, SURVIVAL_Deathfield_GetStartRadius() )
	}
}

DeathFieldStageData function GetDeathFieldStage( int realm, int index )
{
	return file.deathFieldStages[ realm ][ index ]
}

vector function GetDeathfieldFinalCenter( int realm )
{
	int count = file.deathFieldStages[realm].len()
	if ( count == 0 )
		return <0, 0, 0>

	DeathFieldStageData dt = file.deathFieldStages[realm][count - 1]
	return dt.endPos
}

int function GetDeathFieldStartStage()
{
	return file.deathFieldStartStage
}

// Is the deathfield start flag set outside of BR and Deathfield script?
bool function Deathfield_GetHasCustomStart()
{
	return GetCurrentPlaylistVarBool( "deathfield_has_custom_start", false )
}
#endif // SERVER

