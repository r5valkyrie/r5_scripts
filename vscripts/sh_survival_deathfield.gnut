void function DEV_PrintAllRingInfo( int realm = -1, int circle = -1, float time = 20.0 )
{
	int _realm = realm == -1 ? Survival_Loot_GetDefaultRealm() : realm

	vector yOffset = < 0, 0, 35>

	float startRadius = 0

	if ( file.deathFieldData[ _realm ].startRadius > 0 )
		startRadius = file.deathFieldData[ _realm ].startRadius

	printt( "Starting External Radius: " +  startRadius * INCHES_TO_METERS + " meters" + " / " + startRadius + " units" )

	if ( circle != -1 )
	{
		DeathFieldStageData data = file.deathFieldStages[ _realm ][circle]
		//DebugDrawCircle( data.endPos, <0, 0, 1>, data.endRadius, <255, 0, 0>, true, time )
		return
	}

	for ( int i = file.deathFieldStages[ _realm ].len() - 1; i >= 0; i-- )
	{
		DeathFieldStageData data = file.deathFieldStages[ _realm ][i]
		printt( "Round: " + i + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration + " seconds" )
		DebugDrawText( data.endPos + ( yOffset * i ), "Round: " + i + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration + " seconds", true, 50.0 )
	}
}

void function DEV_PrintCurrentRingInfo( int realm = -1, float time = 50.0 )
{
	int _realm = realm == -1 ? Survival_Loot_GetDefaultRealm() : realm

	for ( int i = file.deathFieldStages[ _realm ].len() - 1; i >= 0; i-- )
	{
		DeathFieldStageData data = file.deathFieldStages[ _realm ][i]

		if ( DeathField_IsActiveForIndex( 0 ) )
		{
			//PRINT RING INDEX & RING RADIUS (METERS) & RING RADIUS (UNITS) & RING DAMGE VALUE & RING CLOSE TIME
			printt( "Round: " + i + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration + " seconds" )
			DebugDrawText( data.endPos, "Round: " + i + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration + " seconds", true, 50.0 )
			return
		}
	}

	//if you've reached this point it means you're before the first ring has started moving, so just draw the first ring.
	DeathFieldStageData data = file.deathFieldStages[ _realm ][0]
	//PRINT RING INDEX & RING RADIUS (METERS) & RING RADIUS (UNITS) & RING DAMGE VALUE & RING CLOSE TIME
	printt( "Round: " + 0 + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration + " seconds" )
	DebugDrawText( data.endPos, "Round: " + 0 + " | Radius: " + data.endRadius * INCHES_TO_METERS + " meters" + " / " + data.endRadius + " units" + " | DPS: " + data.percentDamagePerTick + " | Close Time: " + data.shrinkDuration, true, 50.0 )
}

void function DEV_PingOverrideLocations()
{
	int i = 0
	foreach ( loc, radius in file.overrideCircleEndPos )
		CreateWaypoint_Ping_Location( gp()[0], ePingType.MULTILOCATION, null, loc, i++, true )
}

void function DEV_TeleportToOverrideLocation( int index )
{
	// Indices should be consistent per-session but not necessarily hold if you relaunch/reload
	entity player = gp()[0]

	int i = 0
	foreach ( loc, radius in file.overrideCircleEndPos )
	{
		if ( index == i )
		{
			printt( "Override End Location " + index + ", location is " + loc + " (radius " + radius + ")" )
			player.SetOrigin( loc )
			break
		}
		i++
	}
}

void function DEV_TeleportToAllOverrideLocations( int delay = 10 )
{
	thread DEV_TeleportToAllOverrideLocations_Thread( delay )
}

void function DEV_TeleportToAllOverrideLocations_Thread( int delay )
{
	entity player = gp()[0]

	int i = 0
	foreach ( loc, radius in file.overrideCircleEndPos )
	{
		printt( "Override End Location " + i++ + ", location is " + loc + " (radius " + radius + ")" )
		player.SetOrigin( loc )

		wait delay
	}
}

