void function OnPanelUseFinished_SurveyBeacon( entity panel, entity player, bool success )
{
	entity firstPersonProxy = player.GetFirstPersonProxy()

	int handIndex = firstPersonProxy.FindBodygroup( "l_hand" )
	if ( handIndex != -1 )
	{
		// show the hand
		if ( firstPersonProxy.GetBodygroupModelIndex( handIndex ) != 0 )
			firstPersonProxy.SetBodygroupModelByIndex( handIndex, 0 )
	}
	int usbIndex = firstPersonProxy.FindBodygroup( "l_hand_usb" )
	if ( usbIndex != -1 )
	{
		// hide the usb
		if ( firstPersonProxy.GetBodygroupModelIndex( usbIndex ) != 0 )
			firstPersonProxy.SetBodygroupModelByIndex( usbIndex, 0 )
	}
}

                                  
                                                                 
 
                            

                                                                 

                         
                                                              

                            

                                        
  
                                                        
           

                                                                       
           

                                                          
                                                        
  

                              

                                  
                                                                                                               

                           
 

                                                                               
 
                              

             
                                              
   
                                          
   
  

         
 
                                        

                    
                                                                 
 
                            

                                                                 

                         
                                                              

                                               

                                                                                                                                   

                                                 
                                                            
  
                                            
  
 
                          

entity function SURVIVAL_CreateSurveyZoneEntity( vector circleOrigin, float circleRadius, string targetName = "surveyZone" )
{

	entity surveyZone = CreateEntity( "prop_script" )
	surveyZone.SetValueForModelKey( $"mdl/dev/empty_model.rmdl" )
	surveyZone.kv.fadedist = -1
	surveyZone.kv.renderamt = 255
	surveyZone.kv.rendercolor = "255 255 255"
	surveyZone.kv.solid = 0
	surveyZone.SetOrigin( circleOrigin )
	surveyZone.SetAngles( <0, 0, 0> )
	surveyZone.Hide()
	surveyZone.NotSolid()
	surveyZone.DisableHibernation()

	float radius = min( 65536.0, circleRadius )
	surveyZone.Minimap_SetObjectScale( radius / SURVIVAL_MINIMAP_RING_SCALE )
	surveyZone.Minimap_SetAlignUpright( true )
	surveyZone.Minimap_SetZOrder( MINIMAP_Z_OBJECTIVE )
	surveyZone.Minimap_SetClampToEdge( true )
	surveyZone.Minimap_SetCustomState( eMinimapObject_prop_script.OBJECTIVE_AREA )

	array<entity> players = GetPlayerArrayIncludingSpectators()
	foreach ( p in players )
	{
		surveyZone.Minimap_Hide( p.GetTeam(), null )
	}

	SetTargetName( surveyZone, targetName )
	DispatchSpawn( surveyZone )

	return surveyZone
}

entity function OBSERVER_GetOrCreateSurveyRing( entity observer )
{
	if ( file.observerSurveyMinimapEnt == null || file.observerSurveyMinimapEnt.GetOwner() == null )
	{
		printt( "OBS_SURVEY: minimapEnt not found or missing owner" )
		int stageOffset = Flag( "DeathCircleActive" ) ? 1 : 0;
		DeathFieldStageData deathField
		int currentDeathFieldStageValue = int( max( 0, SURVIVAL_GetCurrentDeathFieldStage() ) )
		int realm                      = Survival_GetPlayerRealm( observer )
		deathField = file.deathFieldStages[ realm ][ int( min( currentDeathFieldStageValue + stageOffset, file.deathFieldStages[ realm ].len() - 1 ) ) ]
		vector circleOrigin = deathField.endPos
		float circleRadius  = deathField.endRadius < 175.0 ? 175.0 : deathField.endRadius

		if (file.observerSurveyMinimapEnt == null)
		{
			file.observerSurveyMinimapEnt = SURVIVAL_CreateSurveyZoneEntity( circleOrigin, circleRadius, "observerSurveyZone" )
		}

		file.observerSurveyMinimapEnt.SetOwner( observer )
	}

	return file.observerSurveyMinimapEnt
}

bool function OBSERVER_ShouldShowSurveyRing( entity observer )
{
	if ( !observer.GetPlayerNetBool( NV_OBSERVER_SURVERY_RING_ENABLED ) )
		return false

	if ( observer.GetObserverMode() == OBS_MODE_ROAMING )
		return true

	entity target = observer.GetObserverTarget()
	if ( !IsValid( target ) )
		return true

	return !TeamHasActiveSurveyZone( target.GetTeam() )
}

void function OBSERVER_ToggleSurveyRingEnabled( entity observer )
{
	if ( observer.GetTeam() != TEAM_SPECTATOR )
		return

	bool enableSurveyRing = !observer.GetPlayerNetBool( NV_OBSERVER_SURVERY_RING_ENABLED )
	observer.SetPlayerNetBool( NV_OBSERVER_SURVERY_RING_ENABLED, enableSurveyRing )

	OBSERVER_RefreshSurveryRing( observer )
}

void function OBSERVER_RefreshSurveryRing( entity observer )
{
	if ( observer.GetTeam() != TEAM_SPECTATOR )
		return

	entity minimapEnt = OBSERVER_GetOrCreateSurveyRing( observer )

	if ( OBSERVER_ShouldShowSurveyRing( observer ) )
	{
		printt( "OBS_SURVEY: showing survey ent for " + observer )
		minimapEnt.Minimap_AlwaysShow( TEAM_INVALID, observer )
	}
	else
	{
		printt( "OBS_SURVEY: hiding survey ent for " + observer )
		minimapEnt.Minimap_Hide( TEAM_INVALID, observer )
	}
}

void function OBSERVER_UpdateSurveyRegion( int stage )
{
	if ( file.observerSurveyMinimapEnt == null )
		return

	// The ring will be recreated as to accurately update values.
	file.observerSurveyMinimapEnt.Destroy()
	file.observerSurveyMinimapEnt = null

	array<entity> spectators = GetPlayerArrayOfTeam( TEAM_SPECTATOR )
	foreach ( spectator in spectators )
		OBSERVER_RefreshSurveryRing( spectator )
}

void function OBSERVER_OnSurveryBeaconScanned( int team )
{
	if ( file.observerSurveyMinimapEnt == null )
		return

	array<entity> spectators = GetPlayerArrayOfTeam( TEAM_SPECTATOR )
	foreach ( spectator in spectators )
	{
		if ( spectator.GetObserverTarget() && spectator.GetObserverTarget().GetTeam() == team )
			file.observerSurveyMinimapEnt.Minimap_Hide( TEAM_INVALID, spectator )
	}
}

void function SURVIVAL_ShowSurveyRegionOnSquadMaps( entity player )
{
	if ( HasActiveSurveyZone( player ) )
		return

	int team = player.GetTeam()

	DeathFieldStageData deathField
	int currentDeathFieldStageValue

	//Using a patch fix this logic will be replaced/refactored in a later version of the game.
	//checking to see if this is before the Ring movement has started, bypassing normal setting of currentDeathFieldStageValue which will be set to 0, which will inherently make the later logic to set current deathfield return file.deathFieldStages[ realm ][1] which is the SECOND ring, not the FIRST (which is at index [0].
	if (SURVIVAL_GetCurrentDeathFieldStage() > -1)
	{
		currentDeathFieldStageValue = int( max( 0, SURVIVAL_GetCurrentDeathFieldStage() ) )
	}
	else if (SURVIVAL_GetCurrentDeathFieldStage() <= -1)
	{
		currentDeathFieldStageValue = -1
	}

	int realm                      = Survival_GetPlayerRealm( player )
	deathField = file.deathFieldStages[ realm ][ int( min( currentDeathFieldStageValue + 1, file.deathFieldStages[ realm ].len() - 1 ) ) ]
	vector circleOrigin = deathField.endPos
	float circleRadius  = deathField.endRadius < 175.0 ? 175.0 : deathField.endRadius

	entity surveyZone = SURVIVAL_CreateSurveyZoneEntity( circleOrigin, circleRadius )

	surveyZone.SetOwner( player )

	file.surveyMinimapEnts.append( surveyZone )

	surveyZone.Minimap_AlwaysShow( team, null )

	                   
		thread Perk_NextZoneSurveyBeacon_ListenForScannedZoneEntered( player, surveyZone, circleRadius )
                          

	OBSERVER_OnSurveryBeaconScanned( team )
}

void function SurveyBeacons_RemoveSurveyZones()
{
	foreach ( ent in file.surveyMinimapEnts )
	{
		if ( ent.GetTargetName() == "surveyZone" )
		{
			ent.Destroy()
		}
	}

	ArrayRemoveInvalid( file.surveyMinimapEnts )

	foreach ( player in GetPlayerArray() )
		Remote_CallFunction_NonReplay( player, "ServerCallback_UpdateSurveyBeaconHUDVisibility" )
}

void function Deathfield_Destroy()
{
	foreach ( deathField in file.deathField )
	{
		if ( IsValid( deathField ) )
			deathField.Destroy()
	}
}

                    
                                                
 
                               
                                 
                                    
              
                                        
  
                                                       

                                      
   
                                                             
    
                 
                                         
                                                       
     
                                                                                            
      
             
      
     

                                            
     
                                        
                                   
          
     
        
     
                                           
                                   
     
    
   

                                                
                               
   
                                                     
    
                                                         
    
   
  
     
  
                                                        
                                               
                            
  

                                                             

                             
                                         
                  

                           

                                                               
  
                                                                 
   
                                     
                                    
   
  

                                         

                                         
  
                                          
                           
                               
   
                                                
                                                              
                                
   

                                       
   
                                  
                                          
   

                                     
  

                                         

                                                         
 
     
void function SurveyBeacons_RandomizeLocations()
{
                      
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
		return
      

	if ( !GameMode_IsActive( eGameModes.SURVIVAL ) )
		return

                         
                                                 
       
	{
		SurveyBeacon_RandomizeBeaconArray( BeaconScanEnemy_GetSpawnedBeacons(), ePropPlacementType.ENEMY_SCAN_BEACON  )
	}
                         
                                   
       
	{
		SurveyBeacon_RandomizeBeaconArray( Perk_NextZoneSurveyBeacon_GetSpawnedBeacons(), ePropPlacementType.RING_CONSOLE, COLOR_MAGENTA, GetRingConsoleGoalNumber() )
	}
}

void function SurveyBeacon_PruneInvalidBeacons()
{
	ArrayRemoveInvalid( file.surveyBeacons )
}
                          

void function SetSurveyBeaconMinimapVisibility( entity player )
{
	int team           = player.GetTeam()
	bool hasBeaconUser = false

	array<entity> teamPlayers = GetPlayerArrayOfTeam( team )
	array<bool> beaconVisibility
	beaconVisibility.resize( file.surveyBeacons.len() )
	foreach ( p in teamPlayers )
	{
		for( int i =0; i < file.surveyBeacons.len(); i++ )
		{
			if ( PlayerShouldSeeSurveyBeaconMarkers( p, file.surveyBeacons[i] ) )
			{
				beaconVisibility[i] = true
			}
		}
	}

	Remote_CallFunction_NonReplay( player, "ServerCallback_UpdateSurveyBeaconHUDVisibility" )

	for( int i =0; i < file.surveyBeacons.len(); i++ )
	{
		entity beacon = file.surveyBeacons[i]
		if ( beaconVisibility[i] )
		{
			beacon.Minimap_AlwaysShow( team, null )
		}
		else
		{
			beacon.Minimap_Hide( player.GetTeam(), null )
		}
	}
}

void function SurveyBeacons_AddBeacon( entity beaconMarker, string scriptName )
{
	if ( GetCurrentPlaylistVarBool( "survey_beacons_enabled", true ) == false )
	{
		if ( IsValid( beaconMarker ) )
			beaconMarker.Destroy()

		return
	}

	entity surveyBeacon

	if ( beaconMarker.GetNetworkedClassName() == "prop_script" )
	{
		surveyBeacon = beaconMarker
	}
	else
	{
		surveyBeacon = CreatePropScript( beaconMarker.GetModelName(), beaconMarker.GetOrigin(), beaconMarker.GetAngles(), int( beaconMarker.kv.solid ) )
		beaconMarker.Destroy()
	}


	surveyBeacon.AllowMantle()
	surveyBeacon.SetScriptName( scriptName )
	surveyBeacon.SetFadeDistance( 15000 )

	surveyBeacon.Minimap_SetCustomState( eMinimapObject_prop_script.SURVEY_BEACON )
	surveyBeacon.Minimap_SetAlignUpright( true )
	surveyBeacon.Minimap_SetClampToEdge( false )
	surveyBeacon.Minimap_SetZOrder( MINIMAP_Z_OBJECT )

	OnPanelSpawn( surveyBeacon )

	SetControlPanelUseFunc( surveyBeacon, OnPanelUse_SurveyBeacon )
	ControlPanel_SetPlayerFinishesUsingFunc( surveyBeacon, OnPanelUseFinished_SurveyBeacon )

	SetControlPanelUsePrompts( surveyBeacon, "#SURVEY_BEACON_HOLD_PROMPT", "#SURVEY_BEACON_PRESS_PROMPT" )

	ClearCallback_CanUseEntityCallback( surveyBeacon )
	SetCallback_CanUseEntityCallback( surveyBeacon, SurveyBeacon_CanUseFunction )
	surveyBeacon.AddUsableValue( USABLE_CUSTOM_HINTS )

	file.surveyBeacons.append( surveyBeacon )
}


float function SURVIVAL_Server_GetNextDeathFieldEndRadius( int realm )
{
	return file.deathFieldData[ realm ].endRadius
}


vector function GetPreviousCircleDirection( vector currentPoint, float edgeFrac )
{
	vector directionToCenter = FlattenVec( DeathField_GetStartCircleCenter() - currentPoint )
	directionToCenter = Normalize( directionToCenter )
	float distToCenter = Length2D( directionToCenter )
	if ( distToCenter < FLT_EPSILON )
	{
		directionToCenter = <1, 0, 0>
		edgeFrac = 0
	}

	float angleDeviation = GraphCapped( edgeFrac, 0.0, 1.0, 180.0, 30.0 )
	float anglePicked = RandomFloatRange( -angleDeviation, angleDeviation )

	vector newVec = VectorRotateAxis( directionToCenter, <0, 0, 1>, anglePicked )

	return Normalize( newVec )
}
