SharedRankedDivisionData function GetCurrentArenasRankedDivisionFromScoreAndLadderPosition( int score, int ladderPosition )
{
	int numPlayersOnLadder = ArenasRanked_GetNumPlayersOnLadder()
	if ( (ladderPosition != SHARED_RANKED_INVALID_LADDER_POSITION) && (numPlayersOnLadder > 0) && (ladderPosition <= numPlayersOnLadder) )
	{
		SharedRankedDivisionData ladderDivisionData = expect SharedRankedDivisionData ( file.ladderOnlyDivision )
		#if DEVELOPER
			if ( ladderDivisionData.scoreMin > score ) //We probably got here from a persistence reset in dev, so persistence and stryder don't match up anymore!
				return GetCurrentArenasRankedDivisionFromScore( score )
		#endif

		Assert( ladderDivisionData.scoreMin <= score )
		return (ladderDivisionData)
	}

	return GetCurrentArenasRankedDivisionFromScore( score )

}


SharedRankedDivisionData function GetCurrentArenasRankedDivisionFromScore( int score )
{
	if ( score <= ARENAS_RANKED_PLACEMENT_SCORE )
	{
		Assert( file.rankedDivisions.len() > 0 )
		Assert( file.rankedDivisions[ 0 ].scoreMin == ARENAS_RANKED_PLACEMENT_SCORE )
		return file.rankedDivisions[ 0 ]
	}

	bool foundRank = false
	SharedRankedDivisionData data

	for ( int i = 0; i < file.rankedDivisions.len(); i++ )
	{
		if ( file.rankedDivisions[i].scoreMin > score )
			break

		foundRank = true

		data = file.rankedDivisions[ i ]
	}

	Assert( foundRank )
	return data
}


SharedRankedDivisionData ornull function GetNextArenasRankedDivisionFromScore( int score )
{
	bool foundRank = false
	SharedRankedDivisionData data

	// Still placing, there is no next rank
	if ( score <= ARENAS_RANKED_PLACEMENT_SCORE )
		return null

	score = maxint( score, ARENAS_RANKED_MIN_SCORE )

	int i = 0
	for ( ; i < file.rankedDivisions.len(); i++ )
	{
		if ( file.rankedDivisions[i].scoreMin > score )
			break

		foundRank = true

		data = file.rankedDivisions[ i ]
	}

	if ( i >= file.rankedDivisions.len() )
	{
		return null
	}

	data = file.rankedDivisions[ i ]

	if ( data.isLadderOnlyDivision )
		return null

	Assert( foundRank )

	return data
}

int function ArenasRanked_GetNumPlacementMatchesRequired()
{
	int currentUnixTime                  = GetUnixTimestamp()
	ItemFlavor latestRankedPeriod = ArenasRanked_GetFinalRankedPeriod()

	if( SharedRankedPeriod_HasSplits( latestRankedPeriod ) && SharedRankedPeriod_IsSecondSplitActive( latestRankedPeriod ) )
		return GetCurrentPlaylistVarInt( "arenas_ranked_split_num_placement_matches", ARENAS_RANKED_SPLIT_NUM_PLACEMENT_MATCHES )

	return GetCurrentPlaylistVarInt( "arenas_ranked_num_placement_matches", ARENAS_RANKED_NUM_PLACEMENT_MATCHES )
}

int function ArenasRanked_GetNumPlacementMatchesCompleted( entity player )
{
#if UI
	if ( !IsFullyConnected() )
		return 0
#endif

#if CLIENT
	if ( !IsConnected() )
		return 0
#endif

	return expect int( GetArenasRankedPersistenceData( player, "arenasRankedPlacementMatchesCompleted" ) )
}

bool function ArenasRanked_HasFinishedPlacementMatches( entity player )
{
	return ArenasRanked_GetNumPlacementMatchesCompleted( player ) >= ArenasRanked_GetNumPlacementMatchesRequired()
}

#if SERVER
void function ArenasRanked_SetPlacementWin( entity player, int numGame, bool wonGame )
{
	Assert( numGame >= 0 && numGame < ARENAS_RANKED_NUM_PLACEMENT_MATCHES )

	int placementWins = player.GetPersistentVarAsInt( "placementWins" )

	// Default is 0 but clear bit on a loss just in case
	if( wonGame )
		placementWins = placementWins | (1 << numGame )
	else
		placementWins = placementWins & ~(1 << numGame )

	player.SetPersistentVar( "placementWins", placementWins )
}

void function ArenasRanked_ClearPlacementWins( entity player )
{
	player.SetPersistentVar( "placementWins", 0 )
}

#endif

array<bool> function ArenasRanked_GetPlacementWinsAsArray( entity player )
{
	#if DEVELOPER
	if ( DEV_ShouldIgnorePersistence() )
		return []
	#endif

	#if UI
	if ( !IsFullyConnected() )
		return []
	#endif

	#if CLIENT
	if ( !IsConnected() )
		return []
	#endif

	int placementWins = 0

	#if UI
		placementWins = GetPersistentVarAsInt( "placementWins" )
	#else
		placementWins = player.GetPersistentVarAsInt( "placementWins" )
	#endif

	array<bool> placementWinArray = []
	for( int i = 0; i < ARENAS_RANKED_NUM_PLACEMENT_MATCHES; ++i )
		placementWinArray.append( (placementWins & (1 << i)) != 0 )

	return placementWinArray
}

#if SERVER
const int ARENAS_SCOREMAX = 8000
const float ARENAS_MMRMAX = 50.0

int function ArenasRanked_ComputeMMRScoreMapping( float mmr )
{
	int ScoreMax = ARENAS_SCOREMAX // should be data driven, map to master, keep in sync with Stryder
	int ScoreMin = 1 // should be data driven

	float mmrMin = 0 // tunable, keep in sync with Stryder
	float mmrMax = ARENAS_MMRMAX // tunable, keep in sync with Stryder

	return int( ScoreMin + ( ( mmr - mmrMin ) / ( mmrMax - mmrMin ) ) * ( ScoreMax - ScoreMin ) )
}

float function ArenasRanked_MapScoreToMMR( int score )
{
	int ScoreMax = ARENAS_SCOREMAX // should be data driven, map to master, keep in sync with Stryder
	int ScoreMin = 1 // should be data driven

	float mmrMin = 0 // tunable, keep in sync with Stryder
	float mmrMax = ARENAS_MMRMAX // tunable, keep in sync with Stryder

	return (mmrMin + ((float( score - ScoreMin ) / float( ScoreMax - ScoreMin )) * ( mmrMax - mmrMin )))
}

int function ArenasRanked_ComputeScoreDiffFromPlayer( entity player )
{
	return 0
}

int function ArenasRanked_ComputeScoreDiff( float mmr, bool isWinner, int score, float win_p )
{
	// on Carlos suggestion: base can be a number based on win probability to reflect unbalanced match
	// Pierse will do some maths around win probability to get a linear scale
	float base = GetCurrentPlaylistVarFloat( "arenas_ranked_score_min", 12 ) // minimum value, won or lost, tunable

	float spread = GetCurrentPlaylistVarFloat( "arenas_ranked_score_spread", 2000 ) // max difference between scoreMmr and score to get the full bonus, tunable
	float bonus = GetCurrentPlaylistVarFloat( "arenas_ranked_score_bonus", 96 ) // maximum extra AP won/lost based on player AP and MMR difference

	float bonusP = GetCurrentPlaylistVarFloat( "arenas_ranked_score_bonus_p", 48 ) // maximum value won/lost based on predicted winrate
	float spreadP = GetCurrentPlaylistVarFloat( "arenas_ranked_score_spread_p", 0.4 ) // how far from 50% should winrate be to earn max bonus above

	float mmrSpread = GetCurrentPlaylistVarFloat( "arenas_ranked_mmr_spread", 5.0 ) // Used when above max score to scale loss amount off MMR below cap

	float maxAPLoss = GetCurrentPlaylistVarFloat( "arenas_ranked_max_score_loss", 30 ) // Most a player can lose in a single match (doesn't include abandon penalty)

	// Remove bonus when near max MMR and at AP cap
	// This prevents high AP players from being dragged back down to score cap, and lets them grind ladder pos
	bool useScoreSpread = score < ARENAS_SCOREMAX

	//
	int factorWin = 1
	if ( isWinner == false )
		factorWin = -1

	int scoreMMR = ArenasRanked_ComputeMMRScoreMapping( mmr )
	float spreadRange = useScoreSpread ? ( scoreMMR - score ) / spread : 0.0
	float spreadPRange = ( 0.5 - win_p ) / spreadP

	if( isWinner )
	{
		spreadRange = clamp( spreadRange, 0, 1 )
		spreadPRange = clamp( spreadPRange, 0, 1 )
	}
	else
	{
		// Only apply MMR spread bonus on a loss. No bonus for a win when above max score
		if( !useScoreSpread )
			spreadRange = ( mmr - ARENAS_MMRMAX ) / mmrSpread

		spreadRange = clamp( spreadRange, -1, 0 )
		spreadPRange = clamp( spreadPRange, -1, 0 )
	}

	float scoreDiff = base * factorWin + bonus * spreadRange + bonusP * spreadPRange
	return int( max( -maxAPLoss, scoreDiff ) )
}

int function ArenasRanked_SeedScoreFromMMR( entity player, array<float> mmrs )
{
	// 0: playerMean, 1: playerVariance, 2:teamMean, 3:teamVariance
	int score = ArenasRanked_ComputeMMRScoreMapping( mmrs[0] )

	int numDivisionsToStartBack = GetCurrentPlaylistVarInt( "arenas_ranked_num_div_reset_after_placement", 6 )
	int divisionIndex = file.rankedDivisions.len() - numDivisionsToStartBack
	for ( int i = numDivisionsToStartBack; i < file.rankedDivisions.len(); i++ )
	{
		if ( file.rankedDivisions[i].scoreMin >= score )
		{
			divisionIndex = i - numDivisionsToStartBack
			break
		}
	}

	if( divisionIndex <= 0 || divisionIndex >= file.rankedDivisions.len() )
		return ARENAS_RANKED_MIN_SCORE

	return file.rankedDivisions[ divisionIndex ].scoreMin
}

