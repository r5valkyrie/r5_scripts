void function SetPlayerArenasRankScore( entity player, int score )
{
	if ( !IsArenasRankedInSeason() )
		return

	SetArenasRankedPersistenceData( player, "currentArenasRankedScore", score )

                       
                                                                                                                                                                                                                
      

	int highest = expect int ( GetArenasRankedPersistenceData( player, "highestArenasRankedScore" ) )

	if ( score > highest )
	{
		SetArenasRankedPersistenceData( player, "highestArenasRankedScore", score )
	}
}

void function SetArenasRankedPersistenceData( entity player, string persistenceField, var data )
{
	int currentUnixTime                  = GetUnixTimestamp()
	ItemFlavor ornull arenasRankedPeriod = null

	if ( arenasRankedPeriod != null )
	{
		string preriodRef = ItemFlavor_GetGUIDString( expect ItemFlavor(arenasRankedPeriod) )
		player.SetPersistentVar( "arenasRankedData[" + preriodRef + "]." + persistenceField, data )
	}
}


