void function ArenasRanked_OnPlayerDisconnected( entity player )
{
	if ( IsLobby() )
	{
		if ( player in file.oldAPScore )
			delete file.oldAPScore[ player ]

		if ( player in file.arenasRankedPlayerGRXStateIsUpdated )
			delete file.arenasRankedPlayerGRXStateIsUpdated[ player ]

		if ( player in file.playersThatResetArenasRankOnConnect )
			delete file.playersThatResetArenasRankOnConnect[ player ]

		if ( player in file.playersToSetArenasBadgeStatsOnConnect )
			delete file.playersToSetArenasBadgeStatsOnConnect[ player ]
	}
}


bool function ArenasRanked_ShouldCheckLadderPositionForPlayer( entity player )
{
	//TODO(chin): Need to do historical ladder position look up.
	int rankScore = GetPlayerArenasRankScore( player )
	if ( file.ladderOnlyDivision != null )
		return rankScore >= expect SharedRankedDivisionData ( file.ladderOnlyDivision ).scoreMin

	if ( file.topRankedDivisionData.emblemDisplayMode == emblemDisplayMode.DISPLAY_LADDER_POSITION )
		return rankScore >= file.topRankedDivisionData.scoreMin

	return false
}


void function ArenasRanked_MarkPlayerForSetBadgeStatsOnConnect( entity player, string rankedPeriodGUID )
{
	if ( player in file.playersToSetArenasBadgeStatsOnConnect )
	{
		file.playersToSetArenasBadgeStatsOnConnect[ player ].append( rankedPeriodGUID )
	}
	else
	{
		file.playersToSetArenasBadgeStatsOnConnect[ player ] <- [ rankedPeriodGUID ]
	}
}


void function ArenasRanked_MarkPlayerForRankedResetPinEvent( entity player, string previousDivisionName, string currentDivisionName )
//Hacky: when persistence is being initialized, PIN isn't available yet, so save off this data to fire off pin events later.
//Most times this will not actually run since we need to wait till Stryder confirms the AP before we reset.
{
	ArenasRankedResetStruct dataStruct
	dataStruct.previousDivisionName = previousDivisionName
	dataStruct.currentDivisionName  = currentDivisionName

	if ( player in file.playersThatResetArenasRankOnConnect )
	{
		file.playersThatResetArenasRankOnConnect[ player ].append( dataStruct )
	}
	else
	{
		file.playersThatResetArenasRankOnConnect[ player ]<- [ dataStruct ]
	}
}


void function ArenasRanked_InitRankedTierNamesToBadgeAwardsLevelTable()
{
	//Hard coded, but this should be fine to be constant across Ranked Periods; even if we change the rank tier structure by adding tiers etc we're not going to be changing names to not mean the same thing etc.
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_PLACEMENT"  ] <- sharedRankedBadgeAwardLevel.NONE
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_BRONZE"  ] <- sharedRankedBadgeAwardLevel.BRONZE_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_SILVER"  ] <- sharedRankedBadgeAwardLevel.SILVER_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_GOLD"  ] <- sharedRankedBadgeAwardLevel.GOLD_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_PLATINUM"  ] <- sharedRankedBadgeAwardLevel.PLATINUM_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_DIAMOND"  ] <- sharedRankedBadgeAwardLevel.DIAMOND_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_MASTER"  ] <- sharedRankedBadgeAwardLevel.MASTER_STATIC
	file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ "#ARENAS_RANKED_TIER_APEX_PREDATOR"  ] <- sharedRankedBadgeAwardLevel.APEX_STATIC

	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_PLACEMENT"  ] <- sharedRankedBadgeAwardLevel.NONE
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_BRONZE"  ] <- sharedRankedBadgeAwardLevel.BRONZE_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_SILVER"  ] <- sharedRankedBadgeAwardLevel.SILVER_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_GOLD"  ] <- sharedRankedBadgeAwardLevel.GOLD_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_PLATINUM"  ] <- sharedRankedBadgeAwardLevel.PLATINUM_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_DIAMOND"  ] <- sharedRankedBadgeAwardLevel.DIAMOND_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_MASTER"  ] <- sharedRankedBadgeAwardLevel.MASTER_ANIMATED
	file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ "#ARENAS_RANKED_TIER_APEX_PREDATOR"  ] <- sharedRankedBadgeAwardLevel.APEX_ANIMATED
}


int function ArenasRanked_CalculateBadgeAwardLevelStat( entity player, int rankedScore, ItemFlavor rankedPeriod, bool isFirstSplit )
{
	//Note: Make switch statement based on Ranked Period if we change rank tier structure post Ranked Season 04
	string rankedPeriodGUIDString        = ItemFlavor_GetGUIDString( rankedPeriod )
	int ladderPosition                   = ArenasRanked_GetHistoricalLadderPosition( player, rankedPeriodGUIDString, isFirstSplit )
	SharedRankedTierData splitRankedTier = ArenasRanked_GetHistoricalRankedDivisionFromScoreAndLadderPosition( rankedScore, ladderPosition, rankedPeriodGUIDString ).tier

	string tierName = splitRankedTier.name
	Assert( tierName in file.arenasRankedTierNamesToBadgeAwardStaticLevelTable )

	if ( !SharedRankedPeriod_HasSplits( rankedPeriod ) || isFirstSplit )
		return file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ tierName ]

	if ( SharedRankedPeriod_HasSplits( rankedPeriod ) && (!isFirstSplit) ) //Technically this is just the else part of the earlier ( !RankedPeriod_HasSplits( rankedPeriod ) || !isSecondSplit ) check but doing it explicitly
	{
		int previousArenasRankedScore             = ArenasRanked_GetHistoricalFirstSplitRankScore( player, rankedPeriodGUIDString )
		int firstSplitLadderPosition              = ArenasRanked_GetHistoricalLadderPosition( player, rankedPeriodGUIDString, true )
		SharedRankedTierData firstSplitRankedTier = ArenasRanked_GetHistoricalRankedDivisionFromScoreAndLadderPosition( previousArenasRankedScore, firstSplitLadderPosition, rankedPeriodGUIDString ).tier
		if ( firstSplitRankedTier == splitRankedTier )
		{
			Assert( tierName in file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable )
			return file.arenasRankedTierNamesToBadgeAwardAnimatedLevelTable[ tierName ]
		}
		else
		{
			SharedRankedTierData higherTierAchieved = ArenasRanked_GetHigherOfTwoTiers( firstSplitRankedTier, splitRankedTier )
			Assert( higherTierAchieved.name in file.arenasRankedTierNamesToBadgeAwardStaticLevelTable )
			return file.arenasRankedTierNamesToBadgeAwardStaticLevelTable[ higherTierAchieved.name ]
		}
	}

	unreachable
}
