	//Husaria
	//Plant a breaching charge that fires a sonic wave through walls to destroy traps, force open doors, and disorient enemies.
	weapons/s0_dev_protos/mp_weapon_concussive_breach.nut
	//Throw a grenade that briefly blinds and deafens opponents.
	weapons/s0_dev_protos/mp_weapon_grenade_flashbang.nut
	//You have a shotgun on your leg that fires when you melee doors or enemies. Requires shotgun ammo. Using your abilities grants you a brief speed boost.
	weapons/s0_dev_protos/sh_pilot_passive_shotgun_kick.gnut
	weapons/s0_dev_protos/mp_weapon_shotgun_kick.nut
	
	//Jericho
	//Throw two electrically-charged javelins that burn through enemy body shields.
	weapons/s0_dev_protos/mp_ability_maelstrom_javelin.nut
	//A full-body shield that protects you from incoming fire.
	weapons/s0_dev_protos/mp_ability_riot_shield.nut

	//Prophet
	//Scans the environment for enemies and gathers information on targets found.
	weapons/s0_dev_protos/mp_ability_spotter_sight.nut
	
	//Nomad
	//Follow the Loot Compass to the nearest item.
	weapons/s0_dev_protos/mp_ability_loot_compass.nut

	//Forge
	//Ground Slam
	//Reverse your jump jets to slam down into the ground.
	weapons/s0_dev_protos/mp_ability_ground_slam.nut
	
	//Rampart (OG)
	//Build cover with an upper barrier that blocks incoming shots.
	//weapons/s0_dev_protos/mp_weapon_cover_wall.nut

