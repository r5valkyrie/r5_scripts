	//Stryder Dodge Roll (Proto)
	weapons/s0_dev_protos/mp_ability_dodge_roll.nut
	// weapons/s0_dev_protos/mp_ability_dodge_roll_cafe.nut
	// weapons/s0_dev_protos/mp_ability_phase_dash.nut

	//Sonic Shriek (Proto)
	//A charged short-range blast of force that pushes pilots and projectiles.
	weapons/s0_dev_protos/mp_ability_sonic_shout.nut	
	
	//Split Timeline
	//Weirdest ability in the game -> Proto changed to mp_ability_mark_recall which wasn't commented and doesn't have the weapon handling stuff
	//You can split time in two, carry different weapons, you can have different health / shield and ammo in each timeline
	weapons/s0_dev_protos/mp_ability_split_timeline.nut
	
	
	//------------------------ Second part of dev protos. Cafe
	
	//Skunner
	//Drop a pile of debris that slows and damages enemies when they move through it.
	weapons/s0_dev_protos/mp_weapon_debris_trap.nut
	//Instantly create a spiked barrier made from rapid hardening resin.
	weapons/s0_dev_protos/mp_weapon_grenade_barrier.nut
	
	//Unreleased Mirage Ultimate (Proto)
	weapons/s0_dev_protos/mp_ability_haunt.nut
	
	//Proximity Mine
	
