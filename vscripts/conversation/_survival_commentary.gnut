void function Survival_Commentary_PlayerDamaged( entity player, var damageInfo )
{
	if ( GetGameState() < eGameState.Playing )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( IsAlive( player ) )
		AddSurvivalCommentaryEvent( eSurvivalEventType.PILOT_WOUNDED, player, attacker, damageInfo )
}


void function Survival_Commentary_OnPlayerKilled( entity playerKilled, entity attacker, var damageInfo )
{
	if ( GetGameState() < eGameState.Playing )
		return

	AddSurvivalCommentaryEvent( eSurvivalEventType.PILOT_KILL, playerKilled, attacker, damageInfo )
}


void function Survival_Commentary_OnShieldBreak( entity playerBroken, var damageInfo )
{
	if ( !IsValidPlayer( playerBroken ) )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( !IsValid( attacker ) || !attacker.IsPlayer() || attacker == playerBroken || attacker.GetTeam() == playerBroken.GetTeam())
		return

	PlayBattleChatterLineToSpeakerAndTeam( attacker, "bc_shieldBreakEnemy" )

	foreach ( player in GetPlayerArrayOfTeam( attacker.GetTeam() ) )
	{
		Remote_CallFunction_Replay( player, "ServerCallback_AnnouncePlayerBreaksEnemyShield", playerBroken )
	}
}


void function Survival_Commentary_OnPlayerMatchStateChanged( entity player, int oldValue, int newValue )
{
	if ( player.GetPlayerNetBool( "isJumpmaster" ) && newValue == ePlayerMatchState.SKYDIVE_FALLING )
	{
		PlayBattleChatterLineToSpeakerAndTeam( player, "bc_podLeaderLaunch" )
	}

	if ( newValue == ePlayerMatchState.NORMAL )
	{
		// Setup threat detection callbacks on bombardments and grenades. Wraith players handle their own callouts
		if ( !player.HasPassive( ePassives.PAS_VOICES ) )
		{
			SurvivalCommentary_InitThreatChatterForPlayer( player )
		}
	}
}


void function SurvivalCommentary_InitThreatChatterForPlayer( entity player )
{
	ThreatDetection_StartForPlayer( player )

	AddCallback_OnThreatEventActivation( player, eThreatDetectionZoneType.BOMBARDMENT, SurvivalCommentary_OnThreatActivationBombardment )
	AddCallback_OnThreatEventActivation( player, eThreatDetectionZoneType.GRENADE, SurvivalCommentary_OnThreatActivationGrenade )
}


void function SurvivalCommentary_OnThreatActivationBombardment( entity player, ThreatEventCallbackData data )
{
	PlayThreatChatterToSpeakerAndTeam( player, "bc_callout_enemyAirstrike" )
}


void function SurvivalCommentary_OnThreatActivationGrenade( entity player, ThreatEventCallbackData data )
{
	PlayThreatChatterToSpeakerAndTeam( player, "bc_enemyGrenade" )
}


void function PlayThreatChatterToSpeakerAndTeam( entity player, string chatterLine )
{
	if ( ! ( player in playerCommentaryMap ) )
		return

	if ( (Time() - playerCommentaryMap[player].teamLastCalledOutThreatTime) > SAME_EVENT_DEBOUNCE )
	{
		PlayBattleChatterLineToSpeakerAndTeam( player, chatterLine )

		foreach ( entity teamPlayer in GetPlayerArrayOfTeam( player.GetTeam() ) )
		{
			if ( ! ( teamPlayer in playerCommentaryMap ) )
				continue

			playerCommentaryMap[teamPlayer].teamLastCalledOutThreatTime = Time()
		}
	}
}


void function CircleTimerThink()
{
	float nextCircleTime
	float timerValue
	bool oneMinCalled             = false
	bool thirtySecondsCalled      = false
	bool fourtyFiveSecondsCalled  = false
	bool tenSecondsCalled         = false
	bool haveFilteredEarlierTimes = false

	while( true )
	{
		svGlobal.levelEnt.WaitSignal( "NewDeathFieldStarting" )

		nextCircleTime = GetGlobalNetTime( "nextCircleStartTime" )
		timerValue = nextCircleTime - Time()

		if ( !haveFilteredEarlierTimes )
		{
			haveFilteredEarlierTimes = true
			if ( timerValue <= 11 )
			{
				tenSecondsCalled = true
			}
			if ( timerValue <= 31 )
			{
				thirtySecondsCalled = true
			}
			if ( timerValue <= 46 )
			{
				fourtyFiveSecondsCalled = true
			}
			if ( timerValue <= 61 )
			{
				oneMinCalled = true
			}
		}

		while( timerValue > 0 )
		{
			timerValue = nextCircleTime - Time()

			if ( timerValue <= 11 && !tenSecondsCalled )
			{
				tenSecondsCalled = true
				AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVES_10SEC )
			}
			else if ( timerValue <= 31 && !thirtySecondsCalled )
			{
				thirtySecondsCalled = true
				AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVES_30SEC )
			}
			else if ( timerValue <= 46 && !fourtyFiveSecondsCalled )
			{
				fourtyFiveSecondsCalled = true
				AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVES_45SEC )
			}
			else if ( timerValue <= 61 && !oneMinCalled )
			{
				oneMinCalled = true
				AddSurvivalCommentaryEvent( eSurvivalEventType.CIRCLE_MOVES_1MIN )
			}

			WaitFrame()
		}

		oneMinCalled = false
		thirtySecondsCalled = false
		fourtyFiveSecondsCalled = false
		tenSecondsCalled = false
		haveFilteredEarlierTimes = false
	}
}


void function SquadScatteredBattleChatterThink_Thread()
{
	if ( GetCurrentPlaylistVarBool( "dialogue_squad_spreadout_enabled", true ) == false )
		return

	table< int, table <entity, table<entity, float> > >sqrDistanceBetweenPlayersByTeam
	array<int> scatteredTeams = []

	entity player1
	entity player2
	float sqrDistBetween

	WaitSignal( svGlobal.levelEnt, "NewDeathFieldStarting" )

	while ( true )
	{
		// Build a table with the 2D squared distances between each player on a squad
		foreach ( int team in GetAllValidPlayerTeams() )
		{
			array<entity> livingTeamArray = GetPlayerArrayOfTeam_Alive( team )
			ArrayRemoveInvalid( livingTeamArray )

			if ( livingTeamArray.len() == 0 )
				continue

			sqrDistanceBetweenPlayersByTeam[team] <- {}

			for ( int i = 0; i < livingTeamArray.len(); i++ )
			{
				player1 = livingTeamArray[i]
				sqrDistanceBetweenPlayersByTeam[team][player1] <- {}

				for ( int j = i + 1; j < livingTeamArray.len(); j++ )
				{
					player2 = livingTeamArray[j]
					sqrDistanceBetweenPlayersByTeam[team][player2] <- {}

					sqrDistBetween = Distance2DSqr( player1.GetOrigin(), player2.GetOrigin() )

					sqrDistanceBetweenPlayersByTeam[team][player1][player2] <- sqrDistBetween
					sqrDistanceBetweenPlayersByTeam[team][player2][player1] <- sqrDistBetween

					if ( sqrDistBetween > SQUAD_SPREAD_OUT_DIST_SQ && !scatteredTeams.contains( team ) )
					{
						scatteredTeams.append( team )
						foreach( teammember in livingTeamArray )
						{
							if( teammember.IsPlayer() && IsValid( teammember ) )
								PIN_SquadScatteringDetected( teammember )
						}
					}
				}
			}

			WaitFrame()
		}

		// Go through the teams that we've found to be scattered, and play battle chatter
		// Find the two players that are closest together on the squad, and make sure the line comes from
		// one of them, since being with your squad is more important than anything else scattered-wise
		foreach ( int team in scatteredTeams )
		{
			entity potentialSpeaker1
			entity potentialSpeaker2
			float minDist                 = -1
			float dist                    = 0
			array<entity> livingTeamArray = GetPlayerArrayOfTeam_Alive( team )
			ArrayRemoveInvalid( livingTeamArray )

			for ( int i = 0; i < livingTeamArray.len(); i++ )
			{
				player1 = livingTeamArray[i]

				if ( ! (player1 in sqrDistanceBetweenPlayersByTeam[team]) )
					continue

				for ( int j = i + 1; j < livingTeamArray.len(); j++ )
				{
					player2 = livingTeamArray[j]

					if ( ! (player2 in sqrDistanceBetweenPlayersByTeam[team][player1]) )
						continue

					dist = sqrDistanceBetweenPlayersByTeam[team][player1][player2]

					if ( dist < minDist || minDist < 0 )
					{
						minDist = dist
						potentialSpeaker1 = player1
						potentialSpeaker2 = player2
					}
				}
			}

			entity speaker
			foreach ( entity player in livingTeamArray )
			{
				if ( player == potentialSpeaker1 )
				{
					speaker = potentialSpeaker2
				}
				else
				{
					speaker = potentialSpeaker2
				}
				if ( playerCommentaryMap[player].canHearScatteredCallout )
				{
					PlayBattleChatterLineToPlayer( "bc_scatteredNag", player, speaker )
					thread TrackPlayerScatteredCalloutDebounce_Thread( player )
				}
			}
		}
		scatteredTeams = []

		wait 30.0
	}
}


void function TrackPlayerScatteredCalloutDebounce_Thread( entity player )
{
	OnThreadEnd(
		function() : ( player )
		{
			if ( IsValid( player ) )
				playerCommentaryMap[player].canHearScatteredCallout = true
		}
	)

	EndSignal( player, "OnDeath" )

	playerCommentaryMap[player].canHearScatteredCallout = false

	wait SCATTERED_CALLOUT_DEBOUNCE
}

