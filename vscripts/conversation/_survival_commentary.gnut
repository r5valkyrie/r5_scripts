void function TrackDamageCalloutDebounceTimer_Thread( entity player )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	OnThreadEnd(
		function() : ( player )
		{
			if ( IsValid( player ) )
				playerCommentaryMap[player].canDoDamageCallout = true
		}
	)

	playerCommentaryMap[player].canDoDamageCallout = false

	wait DAMAGE_CALLOUT_DEBOUNCE
}


void function SetCanDoDamageCallout( entity player, bool canDo )
{
	playerCommentaryMap[player].canDoDamageCallout = canDo
}


void function UpdatePreviousEngagementTimeForPlayer( entity attackingPlayer, int enemyTeam )
{
	bool havePreviouslyEngagedEnemyTeam = enemyTeam in playerCommentaryMap[attackingPlayer].engagedEnemyTeamTimestamps

	if ( havePreviouslyEngagedEnemyTeam )
	{
		playerCommentaryMap[attackingPlayer].engagedEnemyTeamTimestamps[ enemyTeam ] = Time()
	}
	else
	{
		playerCommentaryMap[attackingPlayer].engagedEnemyTeamTimestamps[ enemyTeam ] <- Time()
	}
}


void function Survival_Process_CarePackage()
{
	string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.CARE_PACKAGE_DROPPING )

	if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
		thread PlayCommentaryLineToAllPlayers( commentaryRef, "bc_droppingCarePack" )
	else
		thread PlayCommentaryLineToAllPlayers( commentaryRef )

	if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_ADDITIONAL_HOST_COMMENT )
		thread PlayCommentaryLineToAllPlayers( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.CARE_PACKAGE_DROPPING ) )
}

                
void function Survival_Process_ReplicatorAirdropIncoming()
{
	// TODO BA: Remove post 19.0 when replicator dropping line is added.
	if ( SurvivalCommentary_GetHost() == eSurvivalHostType.NOC )
	{
		foreach( team in GetAllTeams() )
		{
			entity speaker = TryFindSpeakingPlayerOnTeam( team )

			if ( !IsValid( speaker ) )
				continue

			PlayBattleChatterLineToSpeakerAndTeam( speaker, "bc_droppingReplicator" )
		}

		return
	}

	string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.DROPPING_REPLICATOR )
	printf( "Picking commentary ref: " + commentaryRef )

	if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
		PlayCommentaryLineToAllPlayers( commentaryRef, "bc_droppingReplicator" )
	else
		PlayCommentaryLineToAllPlayers( commentaryRef )
}
      

                    
                                                    
 
                                                                                                       
                                                     

                                                                
                                                                            
       
                                                
 
      

                        
                                                        
 
                                        
                                                                                                                 
                                                     

                                                
 
                              


