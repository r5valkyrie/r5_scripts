void function TryPlayWeaponBattleChatterLine( entity weaponOwner, entity weapon )
{
	var battleChatterLine

	                               
	if ( weapon.HasMod( GRENADIER_PASSIVE_WEAPON_MOD ) )
	{
		//clean up the script here after ship. Potentially talk to engineering about a more elegant solution
		battleChatterLine = weapon.GetWeaponInfoFileKeyField( "battle_chatter_event_fuse" )
	}
	else
       
	{
		//battleChatterLine = weapon.GetWeaponSettingString( eWeaponVar.battle_chatter_event ) // S3: battle_chatter_event not in eWeaponVar
		battleChatterLine = null
	}

	if ( battleChatterLine == null )
		return

	PlayBattleChatterLineToSpeakerAndTeam( weaponOwner, expect string( battleChatterLine ) )
}

void function TryPlayWeaponPickupBattleChatter( entity player, entity weapon )
{
	if ( !IsValid( player ) )
		return

	if ( !( file.voicesWithWeaponPickupChatter.contains( GetPlayerVoice( player ) ) ) )
		return

	if ( !IsValid( weapon ) )
		return

	if ( !IsValid( player.GetActiveWeapon( eActiveInventorySlot.mainHand ) ) )
		return

	PlayerCommentaryData data = playerCommentaryMap[ player ]

	if ( data.havePlayedChatterWeapons.contains( weapon.GetWeaponClassName() ) )
		return

	if ( GetPlayerVoice( player ) == RAMPART_VOICE && PlayerHasPassive( player, ePassives.PAS_GUNNER ) && weapon.GetMods().contains( GUNNER_MOD_NAME ) )
	{
		playerCommentaryMap[ player ].havePlayedChatterWeapons.append( weapon.GetWeaponClassName() )
		thread PlayBattleChatterLineDelayedToSpeakerAndTeam( player, "bc_rampart_picksUpLMG", 1.0 )
	}

	if ( GetPlayerVoice( player ) == RAMPART_VOICE &&  weapon.GetWeaponClassName() == "mp_weapon_nemesis" )
	{
		playerCommentaryMap[ player ].havePlayedChatterWeapons.append( weapon.GetWeaponClassName() )
		thread PlayBattleChatterLineDelayedToSpeakerAndTeam( player, "bc_rampart_picksUpNemesis", 1.0 )
	}

}

void function PlayBattleChatterLineToTeamButNotSpeaker( entity speakingPlayer, string chatterLine )
{
	//printt( "PlayBattleChatterLine, speakingPlayer: " +  speakingPlayer + ", chatterLine: " + chatterLine )
	foreach ( player in GetPlayerArrayOfTeam( speakingPlayer.GetTeam() ) )
	{
		if ( player == speakingPlayer )
			continue

		PlayBattleChatterLineToPlayer( chatterLine, player, speakingPlayer )
	}
}

void function PlayBattleChatterLineToSpeakerWithDebounceTime( string conversationType, entity listeningPlayer, entity speakingPlayer, float debounceMin, float debounceMax, entity addressee = null )
{
	if ( !ShouldPlayBattleChatter( conversationType, listeningPlayer, speakingPlayer ) )
		return

	if ( !IsValid( speakingPlayer ) )
		return

	if ( !(speakingPlayer in file.battleChatterDebounceTimes) )
	{
		table<string, float> debounceTimes = {}
		file.battleChatterDebounceTimes[ speakingPlayer ] <- debounceTimes
	}

	bool shouldPlayLine = true

	if ( conversationType in file.battleChatterDebounceTimes[ speakingPlayer ] && Time() < file.battleChatterDebounceTimes[ speakingPlayer ][ conversationType ] )
	{
		shouldPlayLine = false
	}

	if ( shouldPlayLine )
	{
		int dialogueFlags = 0
		if ( IsValid( addressee ) && ShouldStompConAltForLine( conversationType, speakingPlayer, addressee ) )
		{
			dialogueFlags = eDialogueFlags.STOMP_CON_ALT
		}

		file.battleChatterDebounceTimes[speakingPlayer][conversationType] <- Time() + RandomFloatRange( debounceMin, debounceMax )
		PlayDialogueForPlayer_NoWait( conversationType, listeningPlayer, speakingPlayer, dialogueFlags )
	}
}

void function PlayBattleChatterLineToSpeakerAndTeamWithDebounceTime( entity speakingPlayer, string chatterLine, float debounceMin, float debounceMax, entity addressee = null, bool isDebounceForAllTeamSpeakers = false )
{
	if ( !IsValid( speakingPlayer ) )
		return

	if ( !(speakingPlayer in file.battleChatterDebounceTimes) )
	{
		table<string, float> debounceTimes = {}
		file.battleChatterDebounceTimes[ speakingPlayer ] <- debounceTimes
	}

	bool shouldPlayLine = true
	// Do we block a dialogue line if any member of the squad has triggered it within the debounce time
	if ( isDebounceForAllTeamSpeakers )
	{
		array< entity > teamPlayersArray = GetPlayerArrayOfTeam( speakingPlayer.GetTeam() )
		foreach ( teamPlayer in teamPlayersArray )
		{
			if ( !IsValid( teamPlayer ) )
				continue

			if ( teamPlayer in file.battleChatterDebounceTimes && chatterLine in file.battleChatterDebounceTimes[ teamPlayer ] && Time() < file.battleChatterDebounceTimes[ teamPlayer ][ chatterLine ] )
			{
				shouldPlayLine = false
				break
			}
		}
	}
	else if ( chatterLine in file.battleChatterDebounceTimes[ speakingPlayer ] && Time() < file.battleChatterDebounceTimes[ speakingPlayer ][ chatterLine ] ) // Otherwise only block the dialogue if the speaker has triggered it within the debounce time
	{
		shouldPlayLine = false
	}

	// If this line is going to be played by the player, make sure we set debounce time on it and play the line
	if ( shouldPlayLine )
	{
		file.battleChatterDebounceTimes[speakingPlayer][chatterLine] <- Time() + RandomFloatRange( debounceMin, debounceMax )
		PlayBattleChatterLineToSpeakerAndTeam( speakingPlayer, chatterLine, addressee )
	}
}


void function PlayBattleChatterLineDelayedToSpeakerWithDebounceTime_Thread( string conversationType, entity listeningPlayer, entity speakingPlayer, float delay, float debounceMin, float debounceMax, entity addressee = null )
{
	EndSignal( speakingPlayer, "OnDeath", "OnDestroy" )

	wait delay

	PlayBattleChatterLineToSpeakerWithDebounceTime( conversationType, listeningPlayer, speakingPlayer, debounceMin, debounceMax, addressee )
}

void function PlayBattleChatterLineDelayedToSpeakerAndTeamWithDebounceTime_Thread( entity speakingPlayer, string chatterLine, float delay, float debounceMin, float debounceMax, entity addressee = null, bool isDebounceForAllTeamSpeakers = false )
{
	EndSignal( speakingPlayer, "OnDeath", "OnDestroy" )

	wait delay

	PlayBattleChatterLineToSpeakerAndTeamWithDebounceTime( speakingPlayer, chatterLine, debounceMin, debounceMax, addressee, isDebounceForAllTeamSpeakers )
}


void function StopBattleChatterLinesForSpeakerAndTeam( entity speakingPlayer )
{
	if ( !IsValid( speakingPlayer ) )
		return

	foreach ( player in GetFriendlySquadArrayForPlayer( speakingPlayer ) )
		StopBattleChatterLinesForPlayer( player )
}


void function StopBattleChatterLinesForPlayer( entity listeningPlayer, int dialogueFlags = 0 )
{
	if ( !ShouldStopBattleChatter( listeningPlayer ) )
		return

	StopAllQueuedAndCurrentDialogueForPlayer( listeningPlayer, dialogueFlags )
}


void function PlayBattleChatterLineToSpeakerAndTeam( entity speakingPlayer, string chatterLine, entity addressee = null )
{
	if ( !IsValid( speakingPlayer ) )
		return

	foreach ( player in GetFriendlySquadArrayForPlayer( speakingPlayer ) )
		PlayBattleChatterLineToPlayer( chatterLine, player, speakingPlayer, addressee )
}


void function PlayBattleChatterLineToSpeakerAndTeamThatBlocksLowerPriorityLines( entity speakingPlayer, string chatterLine )
{
	if ( !IsValid( speakingPlayer ) )
		return

	foreach ( player in GetFriendlySquadArrayForPlayer( speakingPlayer ) )
		PlayBattleChatterLineToPlayerThatBlocksLowerPriorityLines( chatterLine, player, speakingPlayer )
}

void function PlayAmbientDialogueLineToSpeakerAndTeamThatBlocksLowerPriorityLines( entity speakingPlayer, string name )
{
	if ( !IsValid( speakingPlayer ) )
		return

	foreach( entity player in GetFriendlySquadArrayForPlayer( speakingPlayer ) )
	{
		if ( !ShouldPlayBattleChatter( name, player, speakingPlayer ) )
			continue

		PlayDialogueForPlayer_NoWait( name, player, speakingPlayer, eDialogueFlags.BLOCK_LOWER_PRIORITY_QUEUE_ITEMS | eDialogueFlags.AMBIENT_DIALOGUE )
	}
}

void function PlayBattleChatterAliasIdToSpeakerAndPlayers( entity speakingPlayer, int aliasID, array<entity> players, int dialogueFlags = 0 )
{
	foreach ( player in players )
		PlayBattleChatterAliasIdToPlayer( aliasID, player, speakingPlayer, dialogueFlags )
}


void function PlayBattleChatterLineDelayedToSpeakerAndTeam( entity speakingPlayer, string chatterLine, float delay )
{
	EndSignal( speakingPlayer, "OnDeath" )
	EndSignal( speakingPlayer, "OnDestroy" )

	wait delay

	PlayBattleChatterLineToSpeakerAndTeam( speakingPlayer, chatterLine )
}


void function PlayBattleChatterLineDelayedToPlayer( entity speakingPlayer, string chatterLine, float delay )
{
	EndSignal( speakingPlayer, "OnDeath" )
	EndSignal( speakingPlayer, "OnDestroy" )

	wait delay

	PlayBattleChatterLineToPlayer( chatterLine, speakingPlayer, speakingPlayer )
}


void function PlayBattleChatterLineToSpeakerAndOtherPlayer( entity speakingPlayer, entity otherPlayer, string chatterLine )
{
	PlayBattleChatterLineToPlayer( chatterLine, speakingPlayer, speakingPlayer, otherPlayer )
	PlayBattleChatterLineToPlayer( chatterLine, otherPlayer, speakingPlayer, otherPlayer )
}


void function PlayBattleChatterLineToTeamChooseSpeaker( string conversationType, int teamNum )
{
	foreach ( listeningPlayer in GetPlayerArrayOfTeam( teamNum ) )
	{
		entity speaker = TryFindSpeakingPlayerOnTeam( teamNum )

		if ( !IsValid( speaker ) )
			return

		PlayBattleChatterLineToPlayer( conversationType, listeningPlayer, speaker )
	}
}


void function PlayBattleChatterLineToPlayer( string conversationType, entity listeningPlayer, entity speakingPlayer, entity addressee = null )
{
	if ( !ShouldPlayBattleChatter( conversationType, listeningPlayer, speakingPlayer ) )
		return

	int dialogueFlags = 0

	if ( IsValid( addressee ) && ShouldStompConAltForLine( conversationType, speakingPlayer, addressee ) )
	{
		dialogueFlags = eDialogueFlags.STOMP_CON_ALT
	}

	PlayDialogueForPlayer_NoWait( conversationType, listeningPlayer, speakingPlayer, dialogueFlags )
}

bool function ShouldStompConAltForLine( string conversationType, entity speakingPlayer, entity addressee )
{
	string foundConAlt = ""
	array<string> squadVoices = [ GetPlayerVoice( speakingPlayer ) ]
	bool duplicateLegendsOnSquad = false

	foreach ( entity squadmate in GetPlayerArrayOfTeam_Alive( speakingPlayer.GetTeam() ) )
	{
		if ( squadmate == speakingPlayer )
			continue

		if ( squadVoices.find( GetPlayerVoice( squadmate ) ) > -1 )
			duplicateLegendsOnSquad = true

		squadVoices.append( GetPlayerVoice( squadmate ) )

		string potentialConAlt = GetConditionalAltDialogue( conversationType, speakingPlayer, squadmate, true )

		if ( potentialConAlt != "" )
		{
			if ( foundConAlt != "" )
			{
				#if DEVELOPER
					if ( !duplicateLegendsOnSquad )
						Assert( false, "More then one condPlayer exists for con alt " + conversationType + " for speaker " + GetPlayerVoice( speakingPlayer ) + " , this is not currently supported." )
				#endif

				return !duplicateLegendsOnSquad // if there are dupe legends, you should not stomp the con alt. if there are not dupe legends, you should stomp the con alt
			}

			foundConAlt = potentialConAlt
		}

	}

	if ( foundConAlt != "" )
	{
		if ( addressee.GetTeam() !=  speakingPlayer.GetTeam() )
			return false

		if ( DoesConditionalAltRequireAddressee( foundConAlt ) )
		{
			ItemFlavor condPlayerCharacter = GetConditionalAltCondPlayerCharacterFromAlias( foundConAlt )
			ItemFlavor addresseeCharacter = LoadoutSlot_GetItemFlavor( addressee, Loadout_Character() )

			if ( condPlayerCharacter != addresseeCharacter )
				return true
		}
		else
		{
			Assert( false, "Dialogue line " + conversationType + " has a con alt " + foundConAlt + " and was passed an addressee but does not require one." )
			return true
		}
	}

	return false
}

void function PlayBattleChatterLineToPlayerThatBlocksLowerPriorityLines( string conversationType, entity listeningPlayer, entity speakingPlayer )
{
	if ( !ShouldPlayBattleChatter( conversationType, listeningPlayer, speakingPlayer ) )
		return

	PlayDialogueForPlayer_NoWait( conversationType, listeningPlayer, speakingPlayer, eDialogueFlags.BLOCK_LOWER_PRIORITY_QUEUE_ITEMS )
}


void function PlayBattleChatterAliasIdToPlayer( int aliasID, entity listeningPlayer, entity speakingPlayer, int dialogueFlags = 0 )
{
	if ( !ShouldPlayBattleChatter( "NON_EMPTY_STRING", listeningPlayer, speakingPlayer ) )
		return

	PlayDialogueIdForPlayer_NoWait( aliasID, listeningPlayer, speakingPlayer, dialogueFlags )
}


void function PlayDamagedBattleChatter( entity victim, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( !IsAlive( attacker ) )
		return

	if ( !attacker.IsPlayer() )
		return

	if ( attacker == victim )
		return

	if ( victim.GetHealth() <= DamageInfo_GetDamage( damageInfo ) || Bleedout_IsBleedingOut( victim ) )
		//i.e. victim is going to die from this, let the kill battle chatter take priority
		return

	int victimTeam    = victim.GetTeam()
	int attackingTeam = attacker.GetTeam()

	//
	// VICTIM CHATTER
	//

	int damageType     = DamageInfo_GetDamageType( damageInfo )
	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )

	if ( !IsValid( victim ) || ! victim.IsPlayer() || damageSourceId == eDamageSourceId.outOfBounds || damageSourceId == eDamageSourceId.deathField )
		return

                       
                                                                     
         
       

                               
                                                            
                                                                        
         
       

	if ( playerCommentaryMap[victim].canDoDamageCallout && !Bleedout_IsBleedingOut( victim ) )
	{
		// If bullet damage, use specific line. Otherwise use generic line
		if ( damageType == DMG_BULLET )
		{
			PlayBattleChatterLineToSpeakerAndTeam( victim, "bc_takingFire" )
		}
		else
		{
			PlayBattleChatterLineToSpeakerAndTeam( victim, "bc_takingDamage" )
		}
		thread TrackDamageCalloutDebounceTimer_Thread( victim )
	}

	//#if HAS_THIRD_PARTY_CHATTER
	{
		// Getting attacked by a third party squad logic

		// If the team that just hit me is already in my "recently hit me" table, then that means I've already done their relevant callout
		// if their hit time is within the last SQUAD_ENGAGEMENT_CALLOUT_DEBOUNCE time (because they would have been purged by now)
		bool shouldDoCallout = true
		if ( attackingTeam in playerCommentaryMap[victim].attackedByEnemyTeamTimestamps )
		{
			if ( Time() - playerCommentaryMap[victim].attackedByEnemyTeamTimestamps[attackingTeam] < SQUAD_ENGAGEMENT_CALLOUT_DEBOUNCE )
			{
				shouldDoCallout = false
			}
		}

		foreach ( entity victimTeamMember in GetPlayerArrayOfTeam( victimTeam ) )
		{
			if ( !IsValid( victimTeamMember ) )
				continue

			playerCommentaryMap[victimTeamMember].attackedByEnemyTeamTimestamps[ attackingTeam ] <- Time()
		}


		// prune any old entries
		foreach ( int storedAttackerTeam, float storedTimestamp in clone playerCommentaryMap[victim].attackedByEnemyTeamTimestamps )
		{
			if ( Time() - storedTimestamp > SQUAD_ENGAGEMENT_CALLOUT_DEBOUNCE )
			{
				delete playerCommentaryMap[victim].attackedByEnemyTeamTimestamps[ storedAttackerTeam ]
			}
		}
		// if there are more than one recent entries, you're being third partied
		if ( playerCommentaryMap[victim].attackedByEnemyTeamTimestamps.len() > 1 && shouldDoCallout && !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
		{
			PlayBattleChatterLineToSpeakerAndTeam( victim, "bc_anotherSquadAttackingUs" )
			PIN_ThirdPartyDiag( victim )
		}
	}
	//#endif // HAS_THIRD_PARTY_CHATTER

	//
	// ATTACKER CHATTER
	//

	if ( damageType != DMG_BULLET )
		return

	if ( DamageInfo_GetDistFromAttackOrigin( damageInfo ) > FAR_ENGAGEMENT_MIN_DIST )
	{
		if ( Time() - playerCommentaryMap[attacker].timeLastCalledEnemyDamaged > SAME_EVENT_DEBOUNCE )
		{
			playerCommentaryMap[attacker].timeLastCalledEnemyDamaged = Time()
			PlayBattleChatterLineToSpeakerAndTeam( attacker, "bc_damageEnemy" )
		}
	}
	else // close-range, so call out the engagement
	{
		// Engagement callout for player who fired the shot
		bool firstEngagement = false
		foreach ( entity friendlyPlayer in GetPlayerArrayOfTeam( attackingTeam ) )
		{
			if ( !IsValid( friendlyPlayer ) )
				continue

			if ( ! (victimTeam in playerCommentaryMap[friendlyPlayer].engagedEnemyTeamTimestamps) )
			{
				playerCommentaryMap[friendlyPlayer].engagedEnemyTeamTimestamps[ victimTeam ] <- Time()
				firstEngagement = true
			}
		}

		if ( firstEngagement || (Time() - playerCommentaryMap[attacker].engagedEnemyTeamTimestamps[ victimTeam ] > SQUAD_ENGAGEMENT_CALLOUT_DEBOUNCE) )
		{
			PlayBattleChatterLineToSpeakerAndTeam( attacker, "bc_engagingEnemy" )

			foreach ( entity friendlyPlayer in GetPlayerArrayOfTeam( attackingTeam ) )
			{
				if ( !IsValid( friendlyPlayer ) )
					continue

				playerCommentaryMap[friendlyPlayer].engagedEnemyTeamTimestamps[ victimTeam ] = Time()
			}
		}
	}
}


void function RemoveVictimTeamFromOtherTeamsRecentlyEngagedLists( int victimTeam )
{
	foreach ( entity player, PlayerCommentaryData data in playerCommentaryMap )
	{
		if ( victimTeam in data.attackedByEnemyTeamTimestamps )
		{
			delete data.attackedByEnemyTeamTimestamps[ victimTeam ]
		}
	}
}


void function SurvivalCommentary_OnSuccessfulReload( entity player )
{
	if ( PlayerMatchState_GetFor( player ) == ePlayerMatchState.STAGING_AREA )
		return

	if ( Time() - player.GetLastTimeDamagedByOtherPlayer() > RELOAD_CALLOUT_RELEVANT_TIME )
	{
		if ( Time() - player.GetLastTimeDidDamageToOtherPlayer() > RELOAD_CALLOUT_RELEVANT_TIME )
		{
			return
		}
	}

	if ( Time() - file.playerToLastCalledReloadTime[player] < RELOAD_CALLOUT_DEBOUNCE )
	{
		return
	}

	file.playerToLastCalledReloadTime[player] = Time()
	PlayBattleChatterLineToSpeakerAndTeam( player, "bc_reload" )
}


