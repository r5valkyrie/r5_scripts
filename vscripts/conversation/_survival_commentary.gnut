void function ToggleCrowdSystem()
{
	if ( file.crowdSystemActive )
	{
		file.crowdSystemActive = false
		printt( "Crowd Audio: OFF" )
	}
	else
	{
		file.crowdSystemActive = true
		printt( "Crowd Audio: ON" )
	}
}


bool function IsCommentaryEventEnabled( int eventType )
{
	foreach ( disabledEventType in file.disabledCommentaryEvents )
	{
		if ( disabledEventType == eventType )
			return false
	}

	return true
}


void function SurvivalCommentary_SetEventEnabled( int eventType, bool value )
{
	if ( value == true )
	{
		Assert( !IsCommentaryEventEnabled( eventType ), "Trying to SurvivalCommentary_SetEventEnabled( true ) on a commentary event that is already enabled" )
		file.disabledCommentaryEvents.fastremovebyvalue( eventType )
	}
	else
	{
		Assert( IsCommentaryEventEnabled( eventType ), "Trying to SurvivalCommentary_SetEventEnabled( false ) on a commentary event that is already disabled" )
		file.disabledCommentaryEvents.append( eventType )
	}
}


void function SetCommentaryEnabled( bool value )
{
	file.commentarySystemActive = value
}


