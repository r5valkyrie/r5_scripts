//Routes events to help determing if they need to be queued up for commentary or crowd sounds or not
void function ProcessNewEvent( int eventIndex )
{
	switch( file.recentEventList[eventIndex].eventType )
	{
		case eSurvivalEventType.PILOT_KILL:
			thread Survival_Process_PilotKilled( eventIndex )
			break

		case eSurvivalEventType.PILOT_WOUNDED:
			Survival_Process_PilotWounded( eventIndex )
			break

		case eSurvivalEventType.ROUND_TIMER_STARTED:
			Survival_Process_RoundTimerStarted()
			break

		case eSurvivalEventType.CIRCLE_MOVING:
			Survival_Process_CircleMoving()
			break

		case eSurvivalEventType.FINAL_CIRCLE_MOVING:
			Survival_Process_FinalCircleMoving()
			break

		case eSurvivalEventType.CIRCLE_CLOSING_TO_NOTHING:
			Survival_Process_CircleCloseToNothing()
			break

		case eSurvivalEventType.CARE_PACKAGE_DROPPING:
			Survival_Process_CarePackage()
			break

		case eSurvivalEventType.HOVER_TANK_INBOUND:
			Survival_Process_HoverTankInbound()
			break

		case eSurvivalEventType.CIRCLE_MOVES_1MIN:
			Survival_Process_CircleMove1Min()
			break

		case eSurvivalEventType.CIRCLE_MOVES_45SEC:
			Survival_Process_CircleMove45Seconds()
			break

		case eSurvivalEventType.CIRCLE_MOVES_30SEC:
			Survival_Process_CircleMove30Seconds()
			break

		case eSurvivalEventType.CIRCLE_MOVES_10SEC:
			Survival_Process_CircleMove10Seconds()
			break

		                
		case eSurvivalEventType.REPLICATOR_AIRDROP_INCOMING:
			Survival_Process_ReplicatorAirdropIncoming()
			break
        

                      
                                                
                                         
        
        

                          
                                                   
                                             
        
                                
	}
}


void function Survival_Process_PilotKilled( int eventIndex )
{
	SurvivalCommentaryEvent eventToProcess = file.recentEventList[eventIndex]

	vector pilot01_Origin
	if ( !IsValid( eventToProcess.victim ) )
		return
	pilot01_Origin = eventToProcess.victim.GetOrigin()

	vector pilot02_Origin
	if ( !IsValid( eventToProcess.attacker ) )
		return
	pilot02_Origin = eventToProcess.attacker.GetOrigin()

	//Player was killed by neutral titan, door or by the circle or something random
	if ( !eventToProcess.attacker.IsPlayer() )
		return

	// If they killed themselves, no comment
	if ( eventToProcess.victim == eventToProcess.attacker )
		return

	bool hasScreenBeenCalledFor = false

	if ( GamePlaying() )
		wait DELAY_BEFORE_REPORT // (dw): Need to update kill leader immediately at end of match, so winners unlock kill-leader-related stats (e.g.: R5DEV-78029)

	SurvivalCommentary_KillLeaderUpdate( eventToProcess.attacker )

	if ( !GamePlaying() )
		wait DELAY_BEFORE_REPORT

	if ( !IsValid( eventToProcess.victim ) || !IsValid( eventToProcess.attacker ) )
		return

                               
                                                                                                                                                       
         
       

	if ( !file.firstBloodCalled )
	{
		file.firstBloodCalled = true

		string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.FIRST_BLOOD )

		                                               
			//Play unique VO if first blood killer is Rev and we have Noc Rev as announcer
			if ( SurvivalCommentary_GetHost() == eSurvivalHostType.NOC && IsValid( eventToProcess.attacker ) )
			{
				if ( eventToProcess.attacker.HasPassive( ePassives.PAS_DEATHSTALKER ) || eventToProcess.attacker.HasPassive ( ePassives.PAS_REVENANT_REWORK) )
				{
					commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.FIRST_BLOOD_HAS_REV )
				}
			}
        

		thread PlayCommentaryLineWithSquadBasedResponse( commentaryRef, "bc_weTookFirstBlood", "bc_firstBlood", eventToProcess.attacker, "", eventToProcess.victim.GetTeam() )

		ApexScreen_ShowKillerKilled( eventToProcess.victim, eventToProcess.attacker, eventToProcess.damageSourceID, eventToProcess.distanceBetweenPlayers, eSurvivalCommentaryPlayerType.NONE )
		hasScreenBeenCalledFor = true
	}

	string alias
	array<entity> players = GetPlayerArray()

	bool didPlaySpecialKillLine = false
	if ( heirloomDamageSourceIds.contains( eventToProcess.damageSourceID ) )
	{
		//R5DEV-452239
		string voice = GetPlayerVoice( eventToProcess.attacker )
		PlayBattleChatterLineToSpeakerAndTeam( eventToProcess.attacker, "bc_" + voice + "_iKilledAnEnemyWithHeirloom" )
		didPlaySpecialKillLine = true
	}

	if ( eventToProcess.victim.GetEncodedEHandle() == file.championEEH )
	{
		if ( ShouldPlayCommentary( eventToProcess.victim ) )
		{
			ApexScreen_ShowKillerKilled( eventToProcess.victim, eventToProcess.attacker, eventToProcess.damageSourceID, eventToProcess.distanceBetweenPlayers, eSurvivalCommentaryPlayerType.CHAMPION )
			hasScreenBeenCalledFor = true

			foreach ( player in players )
				Remote_CallFunction_NonReplay( player, "ServerCallback_Survival_HighlightedPlayerKilled", eventToProcess.victim, eventToProcess.attacker, eSurvivalCommentaryPlayerType.CHAMPION )

			string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.CHAMPION_ELIMINATED )

			// Should always comment if your squad took down the champion, but general reaction still obeys comment chance probability
			if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
				thread PlayCommentaryLineWithSquadBasedResponse( commentaryRef, "bc_weKilledChampion", "bc_championEliminated", eventToProcess.attacker )
			else
				thread PlayCommentaryLineWithSquadBasedResponse( commentaryRef, "bc_weKilledChampion", "", eventToProcess.attacker )
		}
	}
	else if ( eventToProcess.victim.GetEncodedEHandle() == file.killLeaderEEH )
	{
		if ( ShouldPlayCommentary( eventToProcess.victim ) )
		{
			ApexScreen_ShowKillerKilled( eventToProcess.victim, eventToProcess.attacker, eventToProcess.damageSourceID, eventToProcess.distanceBetweenPlayers, eSurvivalCommentaryPlayerType.KILLLEADER )
			hasScreenBeenCalledFor = true

			foreach ( player in players )
				Remote_CallFunction_NonReplay( player, "ServerCallback_Survival_HighlightedPlayerKilled", eventToProcess.victim, eventToProcess.attacker, eSurvivalCommentaryPlayerType.KILLLEADER )

			string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.KILL_LEADER_ELIMINATED )

			thread PlayCommentaryLineWithSquadBasedResponse( commentaryRef, "bc_weKilledKillLeader", "", eventToProcess.attacker )
		}
	}
	else if ( eventToProcess.damageType == DMG_MELEE_EXECUTION )
	{
		entity attacker = eventToProcess.attacker

		ItemFlavor character      = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), Loadout_Character() )
		LoadoutEntry killQuipSlot = Loadout_CharacterKillQuip( character )
		if ( LoadoutSlot_IsReady( ToEHI( attacker ), killQuipSlot ) )
		{
			ItemFlavor killQuip = LoadoutSlot_GetItemFlavor( ToEHI( attacker ), killQuipSlot )
			thread BroadcastQuip( attacker, killQuip )
		}
	}
	else if ( Time() - playerCommentaryMap[ eventToProcess.attacker ].timeLastCalledEnemyKill > SAME_EVENT_DEBOUNCE && eventToProcess.damageSourceID != eDamageSourceId.bleedout )
	{
		if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) && GetPlayerArrayOfTeam_Alive( eventToProcess.victim.GetTeam() ).len() == 0 )
		{
			                    
			if( !eventToProcess.attacker.HasPassive( ePassives.PAS_SQUADWIPE_SQUAD_COUNT ) )
         
			{
				PlayBattleChatterLineToSpeakerAndTeam( eventToProcess.attacker, "bc_squadTeamWipe" )
			}

			RemoveVictimTeamFromOtherTeamsRecentlyEngagedLists( eventToProcess.victim.GetTeam() )
		}
		else if ( !didPlaySpecialKillLine )
		{
			PlayBattleChatterLineToSpeakerAndTeam( eventToProcess.attacker, "bc_iKilledAnEnemy" )
		}
		playerCommentaryMap[ eventToProcess.attacker ].timeLastCalledEnemyKill = Time()

		entity congratulator = TryFindSpeakingPlayerOnTeamDisallowSelf( eventToProcess.attacker.GetTeam(), eventToProcess.attacker )

		if ( IsValid( congratulator ) )
		{
			PlayBattleChatterLineToPlayer( "bc_congratsKill", eventToProcess.attacker, congratulator, eventToProcess.attacker )
		}
	}

	if ( IsValid( eventToProcess.victim ) )
	{
		array<entity> livingMembersOfDeadPlayerTeam = GetPlayerArrayOfTeam_Alive( eventToProcess.victim.GetTeam() )
		if ( livingMembersOfDeadPlayerTeam.len() == 2 && !Bleedout_IsBleedingOut( livingMembersOfDeadPlayerTeam[0] ) && !Bleedout_IsBleedingOut( livingMembersOfDeadPlayerTeam[1] ) )
		{
			PlayBattleChatterLineToTeamChooseSpeaker( "bc_twoSquaddiesLeft", eventToProcess.victim.GetTeam() )
		}
	}

	if ( eventToProcess.distanceBetweenPlayers > NOTEWORTHY_KILL_DISTANCE && !hasScreenBeenCalledFor )
		ApexScreen_ShowKillerKilled( eventToProcess.victim, eventToProcess.attacker, eventToProcess.damageSourceID, eventToProcess.distanceBetweenPlayers, eSurvivalCommentaryPlayerType.NONE )

	//Commented out because we are no longer using the host. Leaving this here for now for when we want to use these events again or turn back on the host
	if ( !file.isSquadMatch )
	{
		/*		if(GetPlayerArray_Alive().len() == 1)
				{
					PlayCrowdEvent( pilot01_Origin, eSurvivalEventType.WINNER_WINNER )
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(eSurvivalHostType.AI, eSurvivalCommentaryBucket.WINNER) )
					WaitFrame()
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(file.guestHost, eSurvivalCommentaryBucket.WINNER) )
				}
				else if ( GetPlayerArray_Alive().len() == file.numPlayerAtStart / 2 )
				{
					PlayCrowdEvent( SURVIVAL_GetNextCircleCenter( Survival_Loot_GetDefaultRealm() ), eSurvivalEventType.HALF_PLAYERS_ALIVE )
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(file.guestHost, eSurvivalCommentaryBucket.HALF_PLAYERS_LEFT) )
				}
				else if ( GetPlayerArray_Alive().len() == 10 )
				{
					PlayCrowdEvent( SURVIVAL_GetNextCircleCenter( Survival_Loot_GetDefaultRealm() ), eSurvivalEventType.PLAYERS_ALIVE_10 )
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(file.guestHost, eSurvivalCommentaryBucket.PLAYERS_LEFT_10) )
				}
				else if ( GetPlayerArray_Alive().len() == 5 )
				{
					PlayCrowdEvent( SURVIVAL_GetNextCircleCenter( Survival_Loot_GetDefaultRealm() ), eSurvivalEventType.PLAYERS_ALIVE_5 )
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(file.guestHost, eSurvivalCommentaryBucket.PLAYERS_LEFT_5) )
				}
				else if ( GetPlayerArray_Alive().len() == 2 )
				{
					thread PlayCommentaryLine( PickCommentaryLineFromBucket(file.guestHost, eSurvivalCommentaryBucket.ONE_V_ONE) )
				}
				else if(RandomIntRange(0,99) < CHANCE_FOR_PILOT_KILLED_CHEER)
				{
					PlayCrowdEvent( pilot01_Origin, eSurvivalEventType.PILOT_KILL )

					if(!hasScreenBeenCalledFor)
						SvApexScreens_ShowMode( eApexScreenMode.PLAYERS_REMAINING )
				}*/
	}
	else
	{
		if ( GetNumTeamsRemaining() == 1 && !file.winnerDeclared )
		{
			file.winnerDeclared = true
			thread PlayCommentaryLineToAllPlayers( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.WINNER ) )
			file.commentarySystemActive = false
		}


		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
		{
			if ( GetNumTeamsRemaining() == file.numSquadsAtStart / 2 && !file.halfSquadsCalled )
			{
				file.halfSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_legendsLeftHalf" )
			}
			else if ( GetNumTeamsRemaining() == 3 && !file.threeSquadsCalled )
			{
				file.threeSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_legendsLeft3" )
			}
			else if ( GetNumTeamsRemaining() == 2 && !file.twoSquadsCalled )
			{
				file.twoSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_legendsLeft2" )
			}
		}
		else
		{
			if ( GetNumTeamsRemaining() == file.numSquadsAtStart / 2 && !file.halfSquadsCalled )
			{
				file.halfSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_squadsLeftHalf" )
			}
			else if ( GetNumTeamsRemaining() == 3 && !file.threeSquadsCalled )
			{
				file.threeSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_squadsLeft3" )
			}
			else if ( GetNumTeamsRemaining() == 2 && !file.twoSquadsCalled )
			{
				file.twoSquadsCalled = true

				if ( RandomIntRange( 0, 99 ) < CHANCE_FOR_CHARACTER_COMMENT )
					PlayMatchCommentaryBattleChatter( "bc_squadsLeft2" )
			}
		}
	}
}

bool function ShouldPlayCommentary( entity victim ) {
	bool playCommentary = true
	                               
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) && !Respawn_Token_IsPlayerEliminated( victim ) )
		{
			playCommentary = false
		}
       
	return playCommentary
}


const bool KILL_LEADER_DEBUG_PRINTS = true
void function SurvivalCommentary_KillLeaderUpdate( entity pilot )
{
	if ( !IsValid( pilot ) )
		return

	                              
		//remove spammy kill leader lines in mode
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) && SurvivalCommentary_GetHost() == eSurvivalHostType.NOC )
			return
       

	if ( !pilot.IsPlayer() )
		return

	EHIScriptStruct pilotEHISS = GetEHIScriptStruct( pilot )
	pilotEHISS.kills = pilot.GetPlayerNetInt( "kills" )

	if ( pilot.GetEncodedEHandle() == file.killLeaderEEH )
		return

	#if KILL_LEADER_DEBUG_PRINTS
		string DEBUG_currentName = "(invalid)"
		int DEBUG_currentKills   = 0
	#endif

	int killGoal = KILL_LEADER_MIN_KILL_REQUIREMENT // must be greater than or equal to this

	entity killLeader = GetEntityFromEncodedEHandle( file.killLeaderEEH )
	if ( file.killLeaderEEH != EncodedEHandle_null )
	{
		EHIScriptStruct killLeaderEHISS = GetEHIScriptStructFromEncodedEHandle( file.killLeaderEEH )

		if ( IsValid( killLeader ) && IsAlive( killLeader ) )
			killGoal = killLeaderEHISS.kills + 1 // (dw): If the current kill leader is alive, the new one must exceed the number of kills
		else
			killGoal = killLeaderEHISS.kills // (dw): If the current kill leader is dead, some just needs to reach that number to become the new one

		#if KILL_LEADER_DEBUG_PRINTS
			DEBUG_currentName = killLeaderEHISS.name
			DEBUG_currentKills = killLeaderEHISS.kills
		#endif
	}

	if ( pilotEHISS.kills < killGoal )
	{
		#if KILL_LEADER_DEBUG_PRINTS
			printf( "KILL LEADER UPDATE: Unchanged from %s @ %d (was considering %s @ %d)", DEBUG_currentName, DEBUG_currentKills, pilot.GetPlayerName(), pilotEHISS.kills )
		#endif
		return
	}

	#if KILL_LEADER_DEBUG_PRINTS
		printf( "KILL LEADER UPDATE: CHANGED!!! from %s @ %d to %s @ %d", DEBUG_currentName, DEBUG_currentKills, pilot.GetPlayerName(), pilotEHISS.kills )
	#endif

	// pilot is new kill leader

	if ( IsValid( killLeader ) )
	{
		if ( GradeFlagsHas( killLeader, eTargetGrade.CHAMP_KILLLEADER ) )
		{
			GradeFlagsClear( killLeader, eTargetGrade.CHAMP_KILLLEADER )
			GradeFlagsSet( killLeader, eTargetGrade.CHAMPION )
		}
		else
		{
			GradeFlagsClear( killLeader, eTargetGrade.CHAMPION )
		}
	}

	file.killLeaderEEH = pilot.GetEncodedEHandle()

	if ( GradeFlagsHas( pilot, eTargetGrade.CHAMPION ) )
	{
		if ( IsValid( killLeader ) )
			GradeFlagsClear( killLeader, eTargetGrade.CHAMPION )
		GradeFlagsSet( pilot, eTargetGrade.CHAMP_KILLLEADER )
	}
	else
	{
		GradeFlagsSet( pilot, eTargetGrade.KILLLEADER )
	}

	string commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.NEW_KILL_LEADER )

	                            
		// Play a different line depending on if the kill leader is a Legend or Rev
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
		{
			if ( ShadowArmy_IsPlayerOnShadowArmy( pilot ) )
				commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.SHADOW_ARMY_NEW_KILL_LEADER_REV )
			else
				commentaryRef = PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.SHADOW_ARMY_NEW_KILL_LEADER_LEGEND )
		}
                                   

	thread PlayCommentaryLineWithSquadBasedResponse( commentaryRef, "bc_squadmateBecomesKillLeader", "bc_killLeaderNew", pilot, "bc_iBecomeKillLeader", -1, true )

	if ( GetXPEventCount( pilot, eXPType.KILL_LEADER ) == 0 )
	{
		AddXP( pilot, eXPType.KILL_LEADER )
	}

	UnlockAchievement( pilot, achievements.KILL_LEADER )

	SetGlobalNetEnt( "killLeader", pilot )

	array<entity> players = GetPlayerArrayIncludingSpectators()

	foreach ( player in players )
		Remote_CallFunction_NonReplay( player, "ServerCallback_Survival_NewKillLeader", pilot, pilotEHISS.kills )
}


