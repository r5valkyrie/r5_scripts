void function PlayCommentaryLine_Internal( string dialogueRef, array<entity> players, string dialogueResponseRef )
{
	if ( !file.commentarySystemActive )
		return

	foreach ( entity player in players )
	{
		if ( !IsValid( player ) )
			continue

		if ( !IsBattleChatterEnabled() )
		{
			thread PlayDialogueForPlayer( dialogueRef, player, null, 0, COMMENTARY_ANNOUNCER_DIALOGUE_FLAGS )
			continue
		}

		entity responseSpeaker = TryFindSpeakingPlayerOnTeam( player.GetTeam() )

		thread PlayDialogueForPlayer( dialogueRef, player, null, 0, COMMENTARY_ANNOUNCER_DIALOGUE_FLAGS, dialogueResponseRef, responseSpeaker )
	}
}


void function PlayCommentaryLineToAllPlayers( string dialogueRef, string dialogueResponseRef = "" )
{
	array<entity> players = GetPlayerArray()

	thread PlayCommentaryLine_Internal( dialogueRef, players, dialogueResponseRef )
}


void function PlayCommentaryLineToAllPlayersDelayed( string dialogueRef, float delay, string dialogueResponseRef = "" )
{
	if ( delay > 0 )
		wait delay

	PlayCommentaryLineToAllPlayers( dialogueRef, dialogueResponseRef )
}


void function PlayCommentaryLineToPlayerArray( string dialogueRef, array<entity> players, string dialogueResponseRef = "" )
{
	thread PlayCommentaryLine_Internal( dialogueRef, players, dialogueResponseRef )
}


void function PlayCommentaryLineToPlayerArrayDelayed( string dialogueRef, float delay, array<entity> players, string dialogueResponseRef = "" )
{
	if ( delay > 0 )
		wait delay

	PlayCommentaryLineToPlayerArray( dialogueRef, players, dialogueResponseRef )
}


void function PlayCommentaryLineWithSquadBasedResponse( string commentaryDialogueRef, string mySquadResponseRef, string notMySquadResponseRef, entity eventInstigator, string eventInstigatorResponse = "", int excludedTeam = -1, bool passAddressee = false )
{
	if ( !file.commentarySystemActive )
		return

	if ( !IsValid( eventInstigator ) || !IsBattleChatterEnabled() )
	{
		thread PlayCommentaryLineToAllPlayers( commentaryDialogueRef )
		return
	}

	string responseRef
	foreach ( entity player in GetPlayerArray() )
	{
		if ( !IsValid( player ) )
			continue

		// Sometimes, a team shouldn't have a response to a line, like in the case of first blood.
		// This block just plays the commentary line to those players like normal, without queueing up a response
		if ( player.GetTeam() == excludedTeam )
		{
			thread PlayDialogueForPlayer( commentaryDialogueRef, player, null, 0, COMMENTARY_ANNOUNCER_DIALOGUE_FLAGS )
			continue
		}

		responseRef = ""

		bool instigatorOnSameTeamAsCurrentPlayer = eventInstigator.GetTeam() == player.GetTeam()

		if ( instigatorOnSameTeamAsCurrentPlayer )
			responseRef = mySquadResponseRef
		else
			responseRef = notMySquadResponseRef

		// If the event is one where the instigator responds themselves, load up their response
		// if the player is the instigator, they should still hear their squad respond instead of themselves
		entity responseSpeaker
		if ( instigatorOnSameTeamAsCurrentPlayer && eventInstigatorResponse != "" )
		{
			if ( player != eventInstigator )
			{
				responseSpeaker = eventInstigator
			}
			else
			{
				responseSpeaker = TryFindSpeakingPlayerOnTeamDisallowSelf( player.GetTeam(), player, true )
			}

			if ( responseSpeaker == eventInstigator )
				responseRef = eventInstigatorResponse
		}
		else
		{
			responseSpeaker = TryFindSpeakingPlayerOnTeam( player.GetTeam() )
		}


		int dialogueFlags = COMMENTARY_ANNOUNCER_DIALOGUE_FLAGS

		if ( passAddressee && IsValid( responseSpeaker ) && responseSpeaker != eventInstigator && ShouldStompConAltForLine( responseRef, responseSpeaker, eventInstigator ) )
		{
			dialogueFlags = dialogueFlags | eDialogueFlags.STOMP_CON_ALT
		}

		thread PlayDialogueForPlayer( commentaryDialogueRef, player, null, 0, dialogueFlags, responseRef, responseSpeaker )
	}
}


void function PlayCommentaryLineWithCircleBasedResponse( string commentaryDialogueRef, string chatterFar, string chatterClose, string chatterNotTogether, string chatterAllInside )
{
	if ( !file.commentarySystemActive )
		return

	if ( !IsBattleChatterEnabled() )
	{
		PlayCommentaryLineToAllPlayers( commentaryDialogueRef )
		return
	}

	string responseRef = ""
                     
                            
                                                           
  
                                          
                       
  
       

	foreach ( team in GetAllValidPlayerTeams() )
	{
                      
                        
        
			responseRef = ChooseCircleBattleChatterResponseString( team, chatterFar, chatterClose, chatterNotTogether, chatterAllInside )

		foreach ( entity player in GetPlayerArrayOfTeam( team ) )
		{
			entity responseSpeaker = TryFindSpeakingPlayerOnTeam( team )

			thread PlayDialogueForPlayer( commentaryDialogueRef, player, null, 0, COMMENTARY_ANNOUNCER_DIALOGUE_FLAGS, responseRef, responseSpeaker )
		}
	}
}


void function PlayMatchCommentaryBattleChatter( string conversationName, entity optionalSpeaker = null )
{
	foreach ( team in GetAllValidPlayerTeams() )
	{
		PlayBattleChatterLineToTeamChooseSpeaker( conversationName, team )
	}
}


void function PlayCrowdEvent( vector eventOrigin, int eventIndex )
{
	if ( !file.crowdSystemActive )
		return

	array<entity> players = GetPlayerArray()

	foreach ( player in players )
		Remote_CallFunction_NonReplay( player, "ServerCallback_Survival_PlayCrowdEvent", eventOrigin, eventIndex )
}

