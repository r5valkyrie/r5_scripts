void function AddSurvivalCommentaryEvent( int eventType, entity pilot_1 = null, entity pilot_2 = null, var damageInfo = null )
{
	if ( GetCurrentPlaylistVarInt( "survival_match_commentary", 1 ) == 0 )
		return

	// Determine if event is valid for mode
	if ( !Survival_ShouldProcessSurvivalEventForCurrentMode( eventType ) )
	{
		printf( "Event type: " + eventType + " failed process check in mode" )
		return
	}

	// Determine if event is currently enabled
	if ( !IsCommentaryEventEnabled( eventType ) )
	{
		printf( "Event type: " + eventType + " is disabled" )
		return
	}

	thread AddSurvivalCommentaryEvent_Internal( eventType, pilot_1, pilot_2, damageInfo )
}


void function AddSurvivalCommentaryEvent_Internal( int eventType, entity pilot_1, entity pilot_2, var damageInfo )
{
	SurvivalCommentaryEvent newEvent
	newEvent.eventTimeStamp = Time()
	newEvent.eventType = eventType
	newEvent.victim = pilot_1  //the player who was killed/wounded
	newEvent.attacker = pilot_2  //the attacker

	if ( IsValid( damageInfo ) )
	{
		if ( DamageInfo_GetDamage( damageInfo ) == 0.0 )
			return

		newEvent.damageType = DamageInfo_GetDamageType( damageInfo )
		newEvent.damageSourceID = DamageInfo_GetDamageSourceIdentifier( damageInfo )

		if ( IsValid( pilot_1 ) && IsValid( pilot_2 ) )
			newEvent.distanceBetweenPlayers = DamageInfo_GetDistFromAttackOrigin( damageInfo )
	}

	if ( file.newestEventIndex >= MAX_STORED_EVENTS - 1 )
		file.newestEventIndex = 0
	else
		file.newestEventIndex += 1

	if ( file.recentEventList.len() <= file.newestEventIndex )
		file.recentEventList.append( newEvent )
	else
		file.recentEventList[file.newestEventIndex] = newEvent

	ProcessNewEvent( file.newestEventIndex )
}

