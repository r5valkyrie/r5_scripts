void function Survival_Commentary_PlayerConnected( entity player )
{
	if ( GetCurrentPlaylistVarBool( "survival_match_commentary", true ) )
		AddEntityCallback_OnPostDamaged( player, Survival_Commentary_PlayerDamaged )

	file.playerToLastCalledReloadTime[ player ] <- Time()

	PlayerCommentaryData data
	playerCommentaryMap[ player ] <- data
}


void function Survival_Commentary_PlayerDisconnected( entity player )
{
	if ( !IsValid( player ) )
		return

	if ( player in file.playerToLastCalledReloadTime )
		delete file.playerToLastCalledReloadTime[ player ]

	if ( !IsAlive( player ) )
		return

	                      
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
			return
       

	if ( GradeFlagsHas( player, eTargetGrade.CHAMPION ) )
		thread PlayCommentaryLineToAllPlayers( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.CHAMPION_ELIMINATED ) )
}


void function SurvivalCommentary_PickChampion()
{
	if ( (IsRoundBased() && GetRoundsPlayed() > 0) )
	{
		foreach ( entity player in GetPlayerArray() )
		{
			GradeFlagsClear( player, eTargetGrade.CHAMPION )
		}
	}
	else
	{
		Assert( file.championEEH == EncodedEHandle_null )
	}

	entity champion   = null
	// look at the stats of the last game they played
	int bestPlacement = 9999999
	int mostKills     = 0
	int mostDamage    = 0

	foreach ( entity player in GetPlayerArray() )
	{
		bool better = false

		int matchResultsCurrMatchIndex = modint( player.GetPersistentVarAsInt( "matchResults_nextIndex" ), PersistenceGetArrayCount( "matchResults" ) ) // need to mod in case the size of the array changes
		int matchResultsPrevMatchIndex = modint( matchResultsCurrMatchIndex - 1, PersistenceGetArrayCount( "matchResults" ) )
		int placement                  = player.GetPersistentVarAsInt( format( "matchResults[%d].placement", matchResultsPrevMatchIndex ) )
		int kills                      = player.GetPersistentVarAsInt( format( "matchResults[%d].playersKilled", matchResultsPrevMatchIndex ) )
		int damage                     = player.GetPersistentVarAsInt( format( "matchResults[%d].damageDealt", matchResultsPrevMatchIndex ) )
		int prevMatchPlacementOf	   = player.GetPersistentVarAsInt( format( "matchResults[%d].placementof", matchResultsPrevMatchIndex ) )

		if ( prevMatchPlacementOf > 0 && placement < bestPlacement )
		{
			better = true
		}
		else if ( placement == bestPlacement )
		{
			if ( kills > mostKills )
			{
				better = true // "You kill me, you're better. I kill you, I'm better."
			}
			else if ( kills == mostKills )
			{
				if ( damage > mostDamage )
				{
					better = true
				}
				else if ( damage == mostDamage )
				{
					// oh my, it's quite a tie
					better = CoinFlip()
				}
			}
		}

		if ( better )
		{
			champion = player
			bestPlacement = placement
			mostKills = kills
			mostDamage = damage
		}
	}

	if ( !IsValid( champion ) )
		return

	file.championEEH = champion.GetEncodedEHandle()
	GradeFlagsSet( champion, eTargetGrade.CHAMPION )

	file.championTeam = champion.GetTeam()
	foreach ( entity teammate in GetPlayerArrayOfTeam( file.championTeam ) )
		AddXP( teammate, eXPType.BONUS_CHAMPION )

	// Set champion squad EEH ints for client script
	array<EncodedEHandle> championSquad = GetPlayerSquadSafe( file.championEEH, 3 )
	SetGlobalNetInt( "championEEH", file.championEEH )
	SetGlobalNetInt( "championSquad1EEH", championSquad[1] )
	SetGlobalNetInt( "championSquad2EEH", championSquad[2] )
}

void function SurvivalCommentary_AddWeaponPickupChatterVoice( string voice )
{
	Assert( !( file.voicesWithWeaponPickupChatter.contains( voice ) ), "Voice already added to array" )
	file.voicesWithWeaponPickupChatter.append( voice )
}

