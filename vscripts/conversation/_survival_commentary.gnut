void function SurvivalCommentary_Init()
{
	ShSurvivalCommentary_Init()
	ShAmbientDialogue_Init()

	AddCallback_OnClientConnected( Survival_Commentary_PlayerConnected )

	bool isModeAllowed = GameMode_IsActive( eGameModes.SURVIVAL )
                       
                                                                        
      

	if( !isModeAllowed )
		return

	if ( GetCurrentPlaylistVarInt( "survival_match_commentary", 1 ) == 0 )
		return

	AddPostDamageCallback( "player", PlayDamagedBattleChatter )

	AddCallback_GameStateEnter( eGameState.Playing, Survival_Commentary_Playing )
