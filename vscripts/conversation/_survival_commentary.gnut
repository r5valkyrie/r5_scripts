void function PlayCircleNagBattleChatterToPlayers( string commentaryFar, string commentaryClose, string commentaryNotTogether, string commentaryAllInside )
{
	foreach ( team in GetAllValidPlayerTeams() )
	{
		string circleBattleChatter = ChooseCircleBattleChatterResponseString( team, commentaryFar, commentaryClose, commentaryNotTogether, commentaryAllInside )
		PlayBattleChatterLineToTeamChooseSpeaker( circleBattleChatter, team )
	}
}


string function ChooseCircleBattleChatterResponseString( int team, string commentaryFar, string commentaryClose, string commentaryNotTogether, string commentaryAllInside )
{
	entity firstPlayer = GetPlayerArrayOfTeam_Alive( team ).len() > 0 ? GetPlayerArrayOfTeam_Alive( team )[0] : null
	int realm          = Survival_Loot_GetDefaultRealm()
	if ( firstPlayer != null )
	{
		realm = Survival_GetPlayerRealm( firstPlayer )

		vector circleCenter = SURVIVAL_GetNextCircleCenter( realm )
		float circleRadius  = SURVIVAL_Server_GetNextDeathFieldEndRadius( realm )

		array< entity > teammateList = GetPlayerArrayOfTeam_Alive( team )

		int numTeammatesOutsideCircle = 0
		int numTeammatesFarFromCircle = 0

		foreach ( playerOnTeam in teammateList )
		{
			float distanceToCircleCenter        = Distance2D( circleCenter, playerOnTeam.GetOrigin() )
			float distanceOutsideCircleBoundary = max( distanceToCircleCenter - circleRadius, 0 )

			if ( distanceOutsideCircleBoundary > 0 )
				numTeammatesOutsideCircle++
			if ( distanceOutsideCircleBoundary > CONSIDERED_FAR_OUTSIDE_CIRCLE_DISTANCE )
				numTeammatesFarFromCircle++
		}

		if ( numTeammatesFarFromCircle == teammateList.len() )
		{
			return commentaryFar
		}

		if ( numTeammatesOutsideCircle == teammateList.len() )
		{
			return commentaryClose
		}

		if ( numTeammatesOutsideCircle > 0 )
		{
			return commentaryNotTogether
		}

		if ( numTeammatesOutsideCircle == 0 )
		{
			return commentaryAllInside
		}
	}

	return ""
}

