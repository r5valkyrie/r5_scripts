/////////////////////////////////////////////////

table<ResourceGroup, ResourceCollection> s_mapGroupsToChildren
table<int, ResourceGroup> s_mapZonesToGroups
table<ResourceGroup, int> s_mapGroupsToZones
ResourceGroup s_globalGroup
bool s_globalGroupIsInitialized = false

void function Groups_Init()
{
	InitNewGroup( s_globalGroup, {} )
	Assert( s_globalGroup.core.internalIndexForType == 0 )

	// Pointing to itself as the parent:
	s_globalGroup.core.parentGroupIndex = 0
	s_globalGroup.core.keywords.append( "global_group" )

	s_globalGroupIsInitialized = true
}

void function Groups_Finalize()
{
	MapZones_PerZoneCallback( CreateGroupForMapZone )
	FinalizeOrphanedGroups()

#if DEV
	SanityCheckGroups()
#endif // DEV

	//finalize loot_resources
	FinalizeLootResources()
	FlagSet( "ResourceSystemReady" )
	foreach( func in s_resourceSystemIsReadyCallbacks )
		func()
}

array<ResourceSystemIsReadyCallbackType> s_resourceSystemIsReadyCallbacks
void function AddCallback_ResourceSystemIsReady( ResourceSystemIsReadyCallbackType func )
{
	s_resourceSystemIsReadyCallbacks.append( func )
}

#if DEV
void function SanityCheckGroups()
{
	foreach ( ResourceGroup group in s_all.groups )
	{
		Assert( group.core.parentGroupIndex != -1 )
	}
}
#endif // DEV

ResourceGroup function ORS_GetGlobalGroup()
{
	Assert( s_globalGroupIsInitialized )
	return s_globalGroup
}


void function CreateGroupForMapZone( int zoneId )
{
	ResourceGroup newGroup = CreateNewGroup( {} )

	// Zone-specific stuff:
	s_mapZonesToGroups[zoneId] <- newGroup
	s_mapGroupsToZones[newGroup] <- zoneId
	AssignResourceToGroup( newGroup.core, s_globalGroup )

	entity trigger = MapZones_GetTriggerForZone( zoneId )
	newGroup.core.spawnOrigin = trigger.GetOrigin()
	newGroup.core.keywords.append( MapZones_GetTriggerNameForZone( zoneId ) )
}

ResourceGroup function ORS_GetGroupForMapZone( int zoneId )
{
	return s_mapZonesToGroups[zoneId]
}
int function GetZoneIdForGroup( ResourceGroup group )
{
	return s_mapGroupsToZones[group]
}
bool function GroupIsAMapZoneGroup( ResourceGroup group )
{
	return (group in s_mapGroupsToZones)
}

void function InitNewGroup( ResourceGroup group, table<string, string> kvs )
{
	InitCore( group.core, eORType.GROUP, s_all.groups.len(), kvs )
	AddToRC_Group( s_all, group )

	const string GATHER_RADIUS_KEYNAME = "subgroup_radius"
	group._setup.gatherRadius = KVGet_ValFloat( kvs, GATHER_RADIUS_KEYNAME )

	ResourceCollection children
	s_mapGroupsToChildren[group] <- children
}

ResourceGroup function CreateNewGroup( table<string, string> kvs )
{
	ResourceGroup newRes
	InitNewGroup( newRes, kvs )
	return newRes
}

void function SpawnCallback_ResourceGroup( table<string, string> kvs )
{
	CreateNewGroup( kvs )
}

void function AssignResourceToGroup( ResourceCore core, ResourceGroup group )
{
	Assert( core.parentGroupIndex == -1, "Unable to AssignResourceToGroup for resource at " + core.spawnOrigin + ". It may already belong to an existing group." )
	core.parentGroupIndex = group.core.internalIndexForType
	ORS_AddResourceToCollection( GetChildrenForGroup( group ), core )
}

ResourceCollection function GetChildrenForGroup( ResourceGroup group )
{
	return s_mapGroupsToChildren[group]
}

void function FinalizeGroupGUIDs()
{
	foreach( int index, ResourceGroup group in s_all.groups )
	{
		foreach ( string guid in group.core._setup.childGUIDs )
		{
			if ( guid in s_setup_mapGUIDsToCores )
			{
				ResourceCore core = s_setup_mapGUIDsToCores[guid]
				AssignResourceToGroup( core, group )
			}
			else
			{
				entity ent = GetEntityForGUID( guid )
				if ( IsValid( ent ) )
					group.otherEnts.append( ent )
			}
		}
	}

	foreach ( int resType, array<ResourceCore> typeList in s_all._listByType )
	{
		foreach( ResourceCore core in typeList )
		{
			ResourceCollection newCol
			foreach ( string guid in core._setup.childGUIDs )
			{
				if ( guid in s_setup_mapGUIDsToCores )
				{
					ResourceCore childCore = s_setup_mapGUIDsToCores[guid]
					ORS_AddResourceToCollection( newCol, childCore )
				}
				if ( guid in s_setup_mapGUIDsToPathNodes )
				{
					PatrolRouteNode node = s_setup_mapGUIDsToPathNodes[guid]
					FinalizePatrolRoute( core, node )
				}
				else
				{
					entity ent = GetEntityForGUID( guid )
					if ( IsValid( ent ) )
						core.linkedEnts.append( ent )
				}
			}

			if ( newCol._total > 0 )
			{
				core.linkedResourcesIndex = s_linkedResourceCollections.len()
				s_linkedResourceCollections.append( newCol )
			}

			core._setup.childGUIDs.clear()
		}
	}
}

void function FinalizeLootResources()
{
	array<LootSpawn> lootSpawnresources = ORS_Find_( ORS_GetGlobalGroup(), eSearchFlags.NONE, [ eORType.LOOT_SPAWN ], [], [] ).lootSpawns

	foreach( lootSpawn in lootSpawnresources)
	{

		if ( lootSpawn.lootRef.find( "attachment" ) >= 0 )
		{
			/////////////////////////////////////
			// weapon attachments - special case
			/////////////////////////////////////
			// (in levelEd, they will be targeting the intended weapon to be used with)

			array<LootSpawn> targetedLoot = ORS_GetLinkedResources( lootSpawn.core ).lootSpawns
			Assert( targetedLoot.len() == 1, "resource_loot attachment at " + lootSpawn.core.spawnOrigin + " isn't targeting a weapon to determine what attachment to spawn" )
			targetedLoot[0].spawned = true //don't spawn the targeted weapon
			string weaponRef = targetedLoot[0].lootRef
			int attachmentType = GetWeaponAttachmentTypeFromString( lootSpawn.lootRef )
			lootSpawn.lootRef = GetAttachmentLootRefForWeapon( attachmentType, weaponRef, lootSpawn.lootLevel )

			//if no attachment of that style or level, spawn weapon ammo as a fallback
			if ( lootSpawn.lootRef == "" )
				lootSpawn.lootRef = GetWeaponAmmoType( weaponRef )

			//if no ammo type (gold weapon, etc) spawn a shield cell
			if ( lootSpawn.lootRef == "" )
				lootSpawn.lootRef = "health_pickup_combo_small"
		}
	}
}

void function FinalizeOrphanedGroups()
{
	array<ResourceGroup> groupsWithGatherRadius
	foreach( ResourceGroup group in s_all.groups )
	{
		if ( group._setup.gatherRadius > 0.001 )
			groupsWithGatherRadius.append( group )
	}

	// Smallest to largest:
	groupsWithGatherRadius.sort( int function( ResourceGroup aa, ResourceGroup bb )
	{
		if ( aa._setup.gatherRadius < bb._setup.gatherRadius )
			return -1
		if ( aa._setup.gatherRadius > bb._setup.gatherRadius )
			return 1
		return 0
	})

	// For groups w/ GATHER_RADIUS_KEYNAME, grab any orphaned groups in range.
	// (Sad hack for not having deep-linking into instances feature, yet.)
	foreach( ResourceGroup gatherGroup in groupsWithGatherRadius )
	{
		int findCount = 0

		float radius = gatherGroup._setup.gatherRadius
		float radiusSq = (radius * radius)
		foreach( ResourceGroup group in s_all.groups )
		{
			if ( group.core.parentGroupIndex >= 0 )
				continue
			if ( group == gatherGroup )
				continue
			float distSq = DistanceSqr( group.core.spawnOrigin, gatherGroup.core.spawnOrigin )
			if ( distSq > radiusSq )
				continue

			++findCount
			AssignResourceToGroup( group.core, gatherGroup )
		}

		if ( findCount == 0 )
			Warning( "%s() - Found no orphaned subgroups in given %.2f radius for resource group: %s", FUNC_NAME(), radius, ORS_GetLongDesc( gatherGroup.core ) )
		//printf( "%s() - Found %d orphans in radius %.2f for: %s", FUNC_NAME(), findCount, radius, ORS_GetLongDesc( gatherGroup.core ) )
	}

	// Assign orphaned resources to groups:
	for ( int orType = 0; orType < eORType._count; ++orType )
	{
		foreach ( ResourceCore core in s_all._listByType[orType] )
		{
			if ( core.parentGroupIndex >= 0 )
				continue

			int zoneId = MapZones_GetZoneForOrigin( core.spawnOrigin )
			ResourceGroup group = ((zoneId == -1) ? s_globalGroup : s_mapZonesToGroups[zoneId])
			AssignResourceToGroup( core, group )
		}
	}
}

void function FinalizePatrolRoute( ResourceCore resCore, PatrolRouteNode pathNode  )
{
	PatrolRoute patrolRoute
	foreach( PatrolRoute res in s_all.patrolRoutes )
	{
		if ( res.core == resCore )
			patrolRoute = res
	}

	foreach( string guid in resCore._setup.childGUIDs )
	{
		if ( guid in s_setup_mapGUIDsToPathNodes )
			patrolRoute.startNodeArray.append( s_setup_mapGUIDsToPathNodes[guid] )
	}
}

void function FinalizePatrolPaths()
{
	// parse all path nodes and store the connections for later use.
	foreach( PatrolRouteNode node in s_setup_mapGUIDsToPathNodes )
	{
		foreach( string guid in node.childGUIDs )
		{
			if ( !( guid in s_setup_mapGUIDsToPathNodes ) )
			{
				//s_setup_mapGUIDsToCores we could store link to cores here as well.
				continue
			}
			PatrolRouteNode childNode = s_setup_mapGUIDsToPathNodes[guid]

			childNode.parentLinks.append( node )
			node.childLinks.append( childNode )
		}
	}
}

bool function IsInfantrySpawnValid( vector origin )
{
	// Check if spawn intersects any geo
	const int TOUCHING_GROUND_FORGIVENESS = 10
	const int TRACE_POINT_HEIGHT = 70
	vector lowerPoint = origin + <0, 0, TOUCHING_GROUND_FORGIVENESS>
	vector upperPoint = origin + <0, 0, TOUCHING_GROUND_FORGIVENESS + TRACE_POINT_HEIGHT>
	TraceResults traceDown = TraceLine( upperPoint, lowerPoint, [], TRACE_MASK_NPCWORLDSTATIC )
	if ( traceDown.startSolid || traceDown.hitEnt != null )
	{
		//printf( "INVALID Infantry spawn at %s. Detected intersecting geo.", VectorToStr( origin ) )
		//DebugDrawRotatedBox( origin, <-16, -16, 0>, <16, 16, 72>, ent.GetAngles(), COLOR_RED, true, 99999 )
		return false
	}
	TraceResults traceUp = TraceLine( lowerPoint, upperPoint, [], TRACE_MASK_NPCWORLDSTATIC )
	if ( traceUp.startSolid || traceUp.hitEnt != null )
	{
		//printf( "INVALID Infantry spawn at %s. Detected intersecting geo.", VectorToStr( origin ) )
		//DebugDrawRotatedBox( origin, <-16, -16, 0>, <16, 16, 72>, ent.GetAngles(), COLOR_RED, true, 99999 )
		return false
	}

	return true
}

bool function IsProwlerSpawnValid( vector origin )
{
	// For now just:
	return IsInfantrySpawnValid( origin )
}

/////////////////////////////////////////////
// Searching


struct SearchParams
{
	bool includeTypesAll = true				// if true, "includeTypes" are ignored (assumed all true)
	bool[eORType._count] includeTypes		//

	//
	array<string> includeKeywords
	array<string> excludeKeywords

	ResourceCollection results

	int searchFlags = eSearchFlags.NONE
	int allowedDepth = 99

	//
	//bool allowResultsCurrentlyInUse = false
}

bool function CompareKeywordListsForMatchAny( array<string> arg1, array<string> arg2 )
{
	int size1 = arg1.len()
	int size2 = arg2.len()
	array<string> aa = ((size1 < size2) ? arg1 : arg2)
	array<string> bb = ((size1 < size2) ? arg2 : arg1)

	if ( bb.len() == 0 )
		return false

	foreach( string str in aa )
	{
		if ( bb.contains( str ) )
			return true
	}

	return false
}

bool function CompareKeywordListsForMatchAll( array<string> arg1, array<string> arg2 )
{
	int size1 = arg1.len()
	int size2 = arg2.len()
	array<string> aa = ((size1 < size2) ? arg1 : arg2)
	array<string> bb = ((size1 < size2) ? arg2 : arg1)

	if ( bb.len() == 0 )
		return false

	if ( aa.len() == 0 )
		return false

	foreach( string str in aa )
	{
		if ( !bb.contains( str ) )
			return false
	}

	return true
}

void function RecursiveFind( ResourceCollection scope, SearchParams params, int depth )
{
	const int SANITY_DEPTH_CHECK = 20
	Assert( (depth < SANITY_DEPTH_CHECK), "Infinite loop?" )

	for ( int orType = 0; orType < eORType._count ; ++orType )
	{
		if ( !(params.includeTypesAll || params.includeTypes[orType]) )
			continue

		array<ResourceCore> arr = scope._listByType[orType]
		for ( int itemIdx = 0; itemIdx < arr.len(); ++itemIdx )
		{
			ResourceCore core = arr[itemIdx]

			if ( !IsBitFlagSet( params.searchFlags, eSearchFlags.RETURN_INUSE_RESOURCES) )
			{
				if ( ORS_IsInUse( core ) )
					continue
			}

			if ( params.includeKeywords.len() > 0 )
			{
				if ( IsBitFlagSet( params.searchFlags, eSearchFlags.MATCH_ALL_INCLUDE_KEYWORDS ) )
				{
					if ( !CompareKeywordListsForMatchAll( params.includeKeywords, core.keywords ) )
						continue
				}
				else
				{
					if ( !CompareKeywordListsForMatchAny( params.includeKeywords, core.keywords ) )
						continue
				}
			}

			if ( params.excludeKeywords.len() > 0 )
			{
				if ( CompareKeywordListsForMatchAny( params.excludeKeywords, core.keywords ) )
					continue
			}

			ORS_AddResourceToCollection( params.results, core )
		}
	}

	if ( depth >= params.allowedDepth )
		return

	foreach( ResourceGroup childGroup in scope.groups )
	{
		if ( !IsBitFlagSet( params.searchFlags, eSearchFlags.TRAVERSE_INUSE_GROUPS) )
		{
			if ( ORS_IsInUse( childGroup.core ) )
				continue
		}

		RecursiveFind( GetChildrenForGroup( childGroup ), params, (depth+1) )
	}
}

array<string> function MakeLowercaseCloneOfStringArray( array<string> strArray )
{
	array<string> result
	foreach( string str in strArray )
		result.append( str.tolower() )
	return result
}

ResourceCollection function ORS_Find_( ResourceGroup groupScope, int searchFlags, array<int> typesToInclude, array<string> keywordsToInclude, array<string> keywordsToExclude )
{
	SearchParams params

	params.includeTypesAll = (typesToInclude.len() == 0)
	foreach ( int eoType in typesToInclude )
		params.includeTypes[eoType] = true

	params.includeKeywords = MakeLowercaseCloneOfStringArray( keywordsToInclude )
	params.excludeKeywords = MakeLowercaseCloneOfStringArray( keywordsToExclude )
	params.searchFlags = searchFlags

	RecursiveFind( GetChildrenForGroup( groupScope ), params, 0 )

	return params.results
}

ResourceCollection function ORS_FindBasic( ResourceGroup groupScope, string keyWord )
{
	return ORS_Find_( groupScope, eSearchFlags.NONE, [], [keyWord], [] )
}

array<ResourceGroup> function ORS_GetGroupsWithMatchingKeywords( ResourceGroup groupScope, array<string> keywords )
{
	ResourceCollection coll = ORS_Find_( groupScope, eSearchFlags.NONE, [eORType.GROUP], keywords, [] )
	return coll.groups
}

ResourceGroup function ORS_GetGroupForResource( ResourceCore core )
{
	return s_all.groups[core.parentGroupIndex]
}

int function ORS_GetTopParentZoneIdForResource( ResourceCore core )
{
	ResourceGroup group = ORS_GetGroupForResource( core )
	for( ;; )
	{
		ResourceGroup nextGroup = ORS_GetGroupForResource( group.core )
		if ( nextGroup == s_globalGroup )
			break
		group = nextGroup
	}

	if ( GroupIsAMapZoneGroup( group ) )
		return GetZoneIdForGroup( group )

	return -1
}

ResourceCollection function ORS_GetLinkedResources( ResourceCore core )
{
	return s_linkedResourceCollections[core.linkedResourcesIndex]
}

array<entity> function ORS_GetLinkedEntsArray( ResourceCore core )
{
	return core.linkedEnts
}


/////////
// Marking In-Use

void function ORS_MarkInUse( ResourceCore core )
{
	Assert( core.usageCurrentCount == 0 )
	core.usageCurrentCount++
	core.usageLifetimeCount++
}

void function ORS_Free( ResourceCore core )
{
	Assert( core.usageCurrentCount > 0 )
	core.usageCurrentCount = maxint( 0, (core.usageCurrentCount - 1) )
}

bool function ORS_IsInUse( ResourceCore core )
{
	return (core.usageCurrentCount > 0)
}

int function ORS_GetNumberOfTimesUsed( ResourceCore core )
{
	return core.usageLifetimeCount
}


/////////
// Debug Utils
///
string function GetKeywordsDescString( array<string> keywords )
{
	if ( keywords.len() == 0 )
		return ""

	string result = ""
	foreach ( string keyword in keywords )
		result += ("'" + keyword + "' ")
	return result
}
string function VectorToStr( vector org )
{
	return format( "<%.1f, %.1f, %.1f>", org.x, org.y, org.z )
}
string function GetCommonDescString( ResourceCore core )
{
	string keyWordsStr = ""
	{
		string desc = GetKeywordsDescString( core.keywords )
		if ( desc.len() > 0 )
			keyWordsStr = " keywords:[" + desc + "]"
	}

	return format( "org:%s  %s", VectorToStr( core.spawnOrigin ), keyWordsStr )
}

string function GetTypeDescString( ResourceCore core )
{
	switch( core.orType )
	{
		case eORType.GROUP:
		{
			if ( core.internalIndexForType == 0 )
				return "(GLOBAL_GROUP)"

			ResourceGroup group = s_all.groups[core.internalIndexForType]
			if ( GroupIsAMapZoneGroup( group ) )
			{
				int zoneId = GetZoneIdForGroup( group )
				return format( "(Zone '%s')", GetDevNameForZoneId( zoneId ) )
			}
		}
	}

	return ""
}

string function GetUsageDescString( ResourceCore core )
{
	string inner = (core.usageCurrentCount == 0) ? " " : (core.usageCurrentCount == 1) ? "*" : string( core.usageCurrentCount )
	string result = format( "[%s:%d] ", inner, core.usageLifetimeCount )
	return result
}

void function PrintResourceCollection( ResourceCollection coll, string label )
{
	printf( "========================================" )
	printf( "==   %s", label )
	printf( "" )

	for ( int orType = 0; orType < eORType._count; ++orType )
	{
		printf( "%3d  - %s",	coll._listByType[orType].len(), GetTypeName( orType ) )
	}

	printf( "========================================" )
}

string function GetStrForDepthPrint( int depth )
{
	// I regret nothing.
	switch( depth )
	{
		case 0:
			return ""
		case 1:
			return "  "
		case 2:
			return "    "
		case 3:
			return "      "
		case 4:
			return "        "
		case 5:
			return "          "
		case 6:
			return "            "
		case 7:
			return "              "
		case 8:
			return "                "
		case 9:
			return "                  "
	}

	return "         ..."
}

string function ORS_GetLongDesc( ResourceCore core )
{
	return format( "%s (#%d) %s %s %s", GetTypeName( core.orType ), core.internalIndexForType, GetUsageDescString( core ), GetTypeDescString( core ), GetCommonDescString( core ) )
}

void function PrintItemRecursive( ResourceCore core, int depth, int maxDepth )
{
	printf( "%s%s", GetStrForDepthPrint( depth ), ORS_GetLongDesc( core ) )

	if ( (core.orType == eORType.GROUP) && (depth < maxDepth) )
	{
		ResourceGroup group = s_all.groups[core.internalIndexForType]
		ResourceCollection coll = s_mapGroupsToChildren[group]

		for ( int orType = (eORType._count - 1); orType >= 0 ; --orType )
		{
			array<ResourceCore> arr = coll._listByType[orType]
			for ( int itemIdx = 0; itemIdx < arr.len(); ++itemIdx )
				PrintItemRecursive( arr[itemIdx], (depth + 1), maxDepth )
		}

		foreach( int index, entity ent in group.otherEnts )
		{
			printf( "%s.otherEnts[%d] - %s", GetStrForDepthPrint( depth + 1 ), index, string( ent ) )
		}
	}
}

void function PrintCollection( ResourceCollection coll )
{
	for ( int orType = 0; orType < eORType._count; ++orType )
	{
		array<ResourceCore> thisType = coll._listByType[orType]
		if ( thisType.len() == 0 )
			continue

		printf( "" )
		printf( "%s (%d)", GetTypeName( orType ), thisType.len() )
		foreach ( int index, ResourceCore core in thisType )
			printf( "#%d group:%d %s %s %s", index, core.parentGroupIndex, GetUsageDescString( core ), GetTypeDescString( core ), GetCommonDescString( core ) )
	}
}

