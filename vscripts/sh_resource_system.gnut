//
ResourceGroup function CastTo_Group( ResourceCore core )
{
	Assert( core.orType == eORType.GROUP )
	return s_all.groups[core.internalIndexForType]
}
PointOfInterest function CastTo_POI( ResourceCore core )
{
	Assert( core.orType == eORType.POI )
	return s_all.pois[core.internalIndexForType]
}
LootSpawn function CastTo_LootSpawn( ResourceCore core )
{
	Assert( core.orType == eORType.LOOT_SPAWN )
	return s_all.lootSpawns[core.internalIndexForType]
}
InfantrySpawn function CastTo_InfantrySpawn( ResourceCore core )
{
	Assert( core.orType == eORType.INFANTRY_SPAWN )
	return s_all.infantrySpawns[core.internalIndexForType]
}
ProwlerSpawn function CastTo_ProwlerSpawn( ResourceCore core )
{
	Assert( core.orType == eORType.PROWLER_SPAWN )
	return s_all.prowlerSpawns[core.internalIndexForType]
}
DroppodSpawn function CastTo_DroppodSpawn( ResourceCore core )
{
	Assert( core.orType == eORType.DROPPOD_SPAWN )
	return s_all.droppodSpawns[core.internalIndexForType]
}
SniperNest function CastTo_SniperNest( ResourceCore core )
{
	Assert( core.orType == eORType.SNIPER_NEST )
	return s_all.sniperNests[core.internalIndexForType]
}
CandyBox function CastTo_CandyBox( ResourceCore core )
{
