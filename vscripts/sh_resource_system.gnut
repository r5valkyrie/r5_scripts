}

global struct CandyBox
{
	ResourceCore core
}

global struct WallButtonSpawner
{
	ResourceCore core
	entity panel
}

global struct ResourceDoor
{
	ResourceCore core

	array<entity> doorEnts
}

global struct ResourceCollection
{
	array<ResourceGroup>		groups					// eORType.GROUP
	array<PointOfInterest>		pois					// eORType.POI
	array<LootSpawn>			lootSpawns				// eORType.LOOT_SPAWN
	array<InfantrySpawn>		infantrySpawns			// eORType.INFANTRY_SPAWN
	array<ProwlerSpawn>			prowlerSpawns			// eORType.PROWLER_SPAWN
	array<DroppodSpawn>			droppodSpawns			// eORType.DROPPOD_SPAWN
	array<SniperNest>			sniperNests				// eORType.SNIPER_NEST
	array<CandyBox>				candyBoxes				// eORType.CANDYBOX
	array<WallButtonSpawner>	wallButtonSpawners		// eORType.WALLBUTTON_SPAWNER
	array<PatrolRoute>			patrolRoutes			// eORType.PATROL_ROUTE
	array<ResourceDoor>			doors					// eORType.DOOR

	array<ResourceCore>[eORType._count] _listByType
	int _total
}
