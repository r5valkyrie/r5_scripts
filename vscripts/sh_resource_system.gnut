void function ObjectiveResourceSystem_Init()
{
	ORSPrecache_WallButtons()

#if SERVER
	//
	{
		ResourceCollection empty
		s_linkedResourceCollections.append( empty )
	}

	FlagInit( "ResourceSystemReady" )
	AddCallback_EntitiesDidLoad( EntitiesDidLoad )
	AddCallback_OnEntityLinkingFinished( OnEntityLinkingFinished )
	Groups_Init()

	AddCallback_OnScriptOnlyEntPreSpawn( OnScriptOnlyEntPreSpawn )

	AddCallback_GameStateEnter( eGameState.Playing, OnGameStateEnterPlaying )
#endif // SERVER
}

#if SERVER

void function OnScriptOnlyEntPreSpawn( table<string, string> kvs )
{
	if ( KVGet_ClassName( kvs ) != RESOURCE_INFOENT_BASECLASS )
		return

	string ec = KVGet_EditorClass( kvs )
	if ( ec.len() == 0 )
		return

	if ( ec.find("resource_") == -1 )
		return

	switch ( ec )
	{
		case "resource_group":
		case "resource_group_script_only":
			SpawnCallback_ResourceGroup( kvs )
			break
		case "resource_poi":
			SpawnCallback_POI( kvs )
			break
		case "resource_loot":
			SpawnCallback_LootSpawner( kvs )
			break
		case "resource_infantryspawn":
		case "resource_infantryspawn_script_only":
			SpawnCallback_InfantrySpawn( kvs )
			break
		case "resource_prowlerspawn":
			SpawnCallback_ProwlerSpawn( kvs )
			break
		case "resource_droppodspawn":
			SpawnCallback_DroppodSpawn( kvs )
			break
		case "resource_snipernest":
			SpawnCallback_SniperNest( kvs )
			break
		case "resource_candybox":
			SpawnCallback_CandyBox( kvs )
			break
		case "resource_wallbutton_spawner":
			SpawnCallback_WallButtonSpawner( kvs )
			break
		case "resource_patrolroute":
			SpawnCallback_PatrolRoute( kvs )
			break
		case "resource_pathnode":
			SpawnCallback_PathNode( kvs )
			break
		case "resource_door":
		case "resource_door_finder_script_only":
			SpawnCallback_DoorResource( kvs )
			break

		// defunct, should be removed or replaced in the map if at all possible, but to avoid error messaging I'm catching them here.
		case "resource_patrolnode":
			break

		default:
			Warning( "%s() - Unhandled type '%s' at " + KVGet_Origin( kvs ), FUNC_NAME(), ec )
			break
	}
}

void function OnGameStateEnterPlaying()
{
#if DEV
	thread DebugFrameThread()
#endif //DEV
}

void function AddToRCInternal( ResourceCollection coll, ResourceCore core )
{
	coll._listByType[core.orType].append( core )
	coll._total++
}

void function AddToRC_Group( ResourceCollection coll, ResourceGroup group )
{
	// eORType.GROUP
	coll.groups.append( group )
	AddToRCInternal( coll, group.core )
}
void function AddToRC_POI( ResourceCollection coll, PointOfInterest res )
{
	// eORType.POI
	coll.pois.append( res )
	AddToRCInternal( coll, res.core )
}
void function AddToRC_LootSpawn( ResourceCollection coll, LootSpawn res )
{
	// eORType.LOOT_SPAWN
	coll.lootSpawns.append( res )
	AddToRCInternal( coll, res.core )
}
void function AddToRC_InfantrySpawn( ResourceCollection coll, InfantrySpawn res )
{
	// eORType.INFANTRY_SPAWN
	coll.infantrySpawns.append( res )
	AddToRCInternal( coll, res.core )
}
