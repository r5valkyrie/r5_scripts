void function SpawnCallback_PathNode( table<string, string> kvs )
{
	PatrolRouteNode node
	node.nodeOrigin = KVGet_Origin( kvs )
	node.weight = KVGet_ValFloat( kvs, "weight", 1.0 )
	node.assault_tolerance = KVGet_ValFloat( kvs, "script_assault_tolerance", 0 )

	foreach( key, val in kvs )
	{
		if ( key.find( "link_to_guid_" ) == 0 )
			node.childGUIDs.append( val )
	}

	Assert( !s_cleanupHappened )
	string guid = KVGet_ValString( kvs, "link_guid" )
	if ( guid.len() > 0 )
		s_setup_mapGUIDsToPathNodes[guid] <- node
}

