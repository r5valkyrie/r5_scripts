//
void function ORS_AddResourceToCollection( ResourceCollection coll, ResourceCore core )
{
	Assert( coll != s_all )
	switch( core.orType )
	{
		case eORType.GROUP:
			AddToRC_Group( coll, CastTo_Group( core ) )
			break
		case eORType.POI:
			AddToRC_POI( coll, CastTo_POI( core ) )
			break
		case eORType.LOOT_SPAWN:
			AddToRC_LootSpawn( coll, CastTo_LootSpawn( core ) )
			break
		case eORType.INFANTRY_SPAWN:
			AddToRC_InfantrySpawn( coll, CastTo_InfantrySpawn( core ) )
			break
		case eORType.PROWLER_SPAWN:
			AddToRC_ProwlerSpawn( coll, CastTo_ProwlerSpawn( core ) )
			break
		case eORType.DROPPOD_SPAWN:
			AddToRC_DroppodSpawn( coll, CastTo_DroppodSpawn( core ) )
			break
		case eORType.SNIPER_NEST:
			AddToRC_SniperNest( coll, CastTo_SniperNest( core ) )
			break
		case eORType.CANDYBOX:
			AddToRC_CandyBox( coll, CastTo_CandyBox( core ) )
			break
		case eORType.WALLBUTTON_SPAWNER:
			AddToRC_WallButtonSpawner( coll, CastTo_WallButtonSpawner( core ) )
			break
		case eORType.PATROL_ROUTE:
			AddToRC_PatrolRoute( coll, CastTo_PatrolRoute( core ) )
			break
		case eORType.DOOR:
			AddToRC_Door( coll, CastTo_Door( core ) )
			break
		default:
			Assert( false, "Unhandled orType: " + core.orType )
	}
}

void function ORS_RemoveResourceFromCollection( ResourceCollection coll, ResourceCore core )
{
	Assert( coll != s_all )
	switch( core.orType )
	{
		case eORType.GROUP:
			coll.groups.removebyvalue( CastTo_Group( core ) )
			break
		case eORType.POI:
			coll.pois.removebyvalue( CastTo_POI( core ) )
			break
		case eORType.LOOT_SPAWN:
			coll.lootSpawns.removebyvalue( CastTo_LootSpawn( core ) )
			break
		case eORType.INFANTRY_SPAWN:
			coll.infantrySpawns.removebyvalue( CastTo_InfantrySpawn( core ) )
			break
		case eORType.PROWLER_SPAWN:
			coll.prowlerSpawns.removebyvalue( CastTo_ProwlerSpawn( core ) )
			break
		case eORType.DROPPOD_SPAWN:
			coll.droppodSpawns.removebyvalue( CastTo_DroppodSpawn( core ) )
			break
		case eORType.SNIPER_NEST:
			coll.sniperNests.removebyvalue( CastTo_SniperNest( core ) )
			break
		case eORType.CANDYBOX:
			coll.candyBoxes.removebyvalue( CastTo_CandyBox( core ) )
			break
		case eORType.WALLBUTTON_SPAWNER:
			coll.wallButtonSpawners.removebyvalue( CastTo_WallButtonSpawner( core ) )
			break
		case eORType.PATROL_ROUTE:
			coll.patrolRoutes.removebyvalue( CastTo_PatrolRoute( core ) )
			break
		case eORType.DOOR:
			coll.doors.removebyvalue( CastTo_Door( core ) )
			break
		default:
			Assert( false, "Unhandled orType: " + core.orType )
	}

	coll._total--
	coll._listByType[core.orType].removebyvalue( core )
}

string function GetTypeName( int orType )
{
	foreach( string key, int val in eORType )
	{
		if ( val == orType )
			return key
	}

	Assert( false, ("Unhandled type #" + orType) )
	return ""
}

/////////////

table<string, ResourceCore> s_setup_mapGUIDsToCores
table<string, PatrolRouteNode> s_setup_mapGUIDsToPathNodes

bool s_cleanupHappened = false
void function CleanUpSetupEnts()
{
	Assert( !s_cleanupHappened )
	s_setup_mapGUIDsToCores.clear()
	s_setup_mapGUIDsToPathNodes.clear()
	s_cleanupHappened = true
}

void function OnEntityLinkingFinished()
{
	FinalizeGroupGUIDs()
	FinalizePatrolPaths()
}

void function EntitiesDidLoad()
{
	Groups_Finalize()

	// Door fixups:
	{
		array<entity> doorEnts = GetAllDoorEnts()
		foreach( doorRes in s_all.doors )
		{
			doorRes.doorEnts = GetEntsFromArrayInRange( doorRes.core.spawnOrigin, 128.0, doorEnts )
			if ( doorRes.doorEnts.len() == 0 )
			{
				//double check that we are maybe near one of the giant script doors which, if in it's open state, may be further away than 128 units
				if ( GetClosestScriptDoorToPos( doorRes.core.spawnOrigin, 256.0 ) == null )
				{
					// this warning spams when we delete doors that are outside the circle.
					//Warning( "%s() - Door resource at %s isn't near any existing doors.", FUNC_NAME(), string( doorRes.core.spawnOrigin ) )
				}
			}
		}
	}

	CleanUpSetupEnts()
}

void function InitCore( ResourceCore core, int orType, int internalIndexForType, table<string, string> kvs )
{
	core.orType = orType
	core.internalIndexForType = internalIndexForType

	//
	core.spawnOrigin = KVGet_Origin( kvs )
	core.spawnAngles = KVGet_Angles( kvs )
	core.keywords = GetKeywordsFromKV( kvs )

	foreach( key, val in kvs )
	{
		if ( key.find( "link_to_guid_" ) == 0 )
			core._setup.childGUIDs.append( val )
	}

	Assert( !s_cleanupHappened )
	string guid = KVGet_ValString( kvs, "link_guid" )
	if ( guid.len() > 0 )
		s_setup_mapGUIDsToCores[guid] <- core
}

array<string> function GetKeywordsFromRawString( string rawStr )
{
	array<string> result = split( rawStr, WHITESPACE_CHARACTERS + ".,;:?" )
	for ( int idx = 0; idx < result.len(); ++idx )
		result[idx] = result[idx].tolower()

	return result
}

array<string> function GetKeywordsFromKV( table<string, string> kvs )
{
	string keywordsValue = KVGet_ValString( kvs, "resource_tags" )
	return GetKeywordsFromRawString( keywordsValue )
}

//////////////////////////////////

void function SpawnCallback_POI( table<string, string> kvs )
{
	PointOfInterest newRes
	//
	InitCore( newRes.core, eORType.POI, s_all.pois.len(), kvs )

	//
	newRes.scriptRadius = KVGet_ValFloat( kvs, "script_radius" )
	newRes.scriptHeight = KVGet_ValFloat( kvs, "script_height" )

	// newRes.kvs:
	foreach( string key, string val in kvs )
	{
		if ( key.find( "link_to_guid_" ) == 0 )
			continue

		switch( key )
		{
			case "link_guid":
			case "save_model_kv":
			case "save_radius_kv":
			case "save_height_kv":
			case "script_radius":
			case "script_height":
			case "editorclass":
			case "inherit":
			case "scale":
			case "origin":
			case "angles":
			case "classname":
				// don't keep
				break
			case "model":
				if ( val != "mdl/dev/editor_ref.rmdl" )
					newRes.kvs[key] <- val
				break
			default:
				newRes.kvs[key] <- val
		}
	}

	AddToRC_POI( s_all, newRes )
}

void function SpawnCallback_InfantrySpawn( table<string, string> kvs )
{
	InfantrySpawn newRes

	if ( !IsInfantrySpawnValid( KVGet_Origin( kvs ) ) )
		return

	//
	InitCore( newRes.core, eORType.INFANTRY_SPAWN, s_all.infantrySpawns.len(), kvs )
	AddToRC_InfantrySpawn( s_all, newRes )

	if ( KVGet_ValString( kvs, RES_KEYWORD_INDOORS ) == "1" )
		newRes.core.keywords.append( RES_KEYWORD_INDOORS )
}


void function SpawnCallback_LootSpawner( table<string, string> kvs )
{
	LootSpawn newRes

	newRes.lootLevel = KVGet_ValInt( kvs, "loot_level" )
	newRes.minPlayers = KVGet_ValInt( kvs, "min_players" ) //will not spawn this loot unless min_players is met
	if ( newRes.minPlayers == 0 )
		newRes.minPlayers = 1
	asset modelName = KVGet_Model( kvs )
	Assert( modelName != $"", "resource_loot has no loot model defined at " + KVGet_Origin( kvs ) )
	newRes.lootRef = GetLootRefFromModelName( modelName, newRes.lootLevel )

	if ( newRes.lootRef == "" )
	{
		Warning( "%s() - resource_loot has unhandled loot model asset at %s: %s", FUNC_NAME(), VectorToStr( KVGet_Origin( kvs ) ), string( modelName ) )
		return
	}

	InitCore( newRes.core, eORType.LOOT_SPAWN, s_all.lootSpawns.len(), kvs )
	AddToRC_LootSpawn( s_all, newRes )
}

void function SpawnCallback_ProwlerSpawn( table<string, string> kvs )
{
	ProwlerSpawn newRes

	if ( !IsProwlerSpawnValid( KVGet_Origin( kvs ) ) )
		return

	//
	InitCore( newRes.core, eORType.PROWLER_SPAWN, s_all.prowlerSpawns.len(), kvs )
	AddToRC_ProwlerSpawn( s_all, newRes )

	if ( KVGet_ValString( kvs, RES_KEYWORD_INDOORS ) == "1" )
		newRes.core.keywords.append( RES_KEYWORD_INDOORS )
}

