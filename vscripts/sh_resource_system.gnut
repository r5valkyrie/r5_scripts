global enum eSearchFlags
{
	NONE = 0
	RETURN_INUSE_RESOURCES =		(1 << 0)
	TRAVERSE_INUSE_GROUPS =			(1 << 1)
	MATCH_ALL_INCLUDE_KEYWORDS =	(1 << 2)
}

global enum eORType
{
	GROUP,
	//
	POI,
	LOOT_SPAWN,
	//
	INFANTRY_SPAWN,
	PROWLER_SPAWN,
	DROPPOD_SPAWN,
	SNIPER_NEST,
	//
	CANDYBOX,
	//
	WALLBUTTON_SPAWNER,
	//
	PATROL_ROUTE,
	DOOR,

	_count
}

global struct ORTokenCollection
{
	array<int>[eORType._count] forType
}

global const int NULL_TOKEN = 0

global struct ResourceCore
{
	int orType = -1		// eORType
	int internalIndexForType = -1

	int parentGroupIndex = -1

	vector spawnOrigin
	vector spawnAngles

	int linkedResourcesIndex = 0
	array<entity> linkedEnts

	/////
	int groupIndex = -1		// ActionGroup
	array<string> keywords	// ""

	int usageCurrentCount = 0
	int usageLifetimeCount = 0

	struct
	{
		array<string> childGUIDs
	} _setup
}

global struct PatrolRouteNode
{
	vector nodeOrigin
	array<string> childGUIDs
	array<PatrolRouteNode> parentLinks
	array<PatrolRouteNode> childLinks
	int visits
	float weight
	float assault_tolerance
}
global struct PatrolRoute
{
	ResourceCore           core
	array<PatrolRouteNode> startNodeArray
}

global struct ResourceGroup
{
	ResourceCore core

	array<entity> otherEnts

	//
	struct
	{
		float gatherRadius = 0.0
	} _setup
}

global struct PointOfInterest
{
	ResourceCore core
	float scriptRadius
	float scriptHeight
	table<string, string> kvs
	entity trigger
}

global struct InfantrySpawn
{
