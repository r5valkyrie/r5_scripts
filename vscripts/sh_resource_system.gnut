	return doorResources
}

array<PointOfInterest> function ORS_GetPOIResourcesFromGroups( array<ResourceGroup> resourceGroups, array<string> keywordsToInclude = [], array<string> keywordsToExclude = [] )
{

	array<PointOfInterest> POIresources
	int searchFlags                 = 0
	array<int> typesToInclude       = [eORType.POI]

	foreach( group in resourceGroups )
		POIresources.extend( ORS_Find_( group, 0, typesToInclude, keywordsToInclude, keywordsToExclude ).pois )

	return POIresources
}

array<WallButtonSpawner> function ORS_GetWallButtonResourcesFromGroups( array<ResourceGroup> resourceGroups, array<string> keywordsToInclude = [], array<string> keywordsToExclude = [] )
{
	array<WallButtonSpawner> wallButtonresources
	int searchFlags                 = 0
	array<int> typesToInclude       = [eORType.WALLBUTTON_SPAWNER]

	foreach( group in resourceGroups )
		wallButtonresources.extend( ORS_Find_( group, 0, typesToInclude, keywordsToInclude, keywordsToExclude ).wallButtonSpawners )

	return wallButtonresources
}

array <ResourceGroup> function ORS_GetResourceGroupsMatchingKeywordArrays( array<array<string> > resGroupKeywordArrays )
{
	//get resource groups defined by different combinations of keywords
	array <ResourceGroup> arrayOfResoureGroupsToReturn

	if ( resGroupKeywordArrays.len() == 0 )
		return arrayOfResoureGroupsToReturn

	ResourceGroup groupScope 			= ORS_GetGlobalGroup()
	int searchFlags 					= eSearchFlags.MATCH_ALL_INCLUDE_KEYWORDS
	array<int> typesToInclude 			= [eORType.GROUP]

	foreach( keywordArray in resGroupKeywordArrays )
	{
		array<string> keywordsToInclude = keywordArray
		array<string> keywordsToExclude = []
		ResourceCollection resources = ORS_Find_( groupScope, searchFlags, typesToInclude, keywordsToInclude, keywordsToExclude )
		if ( resources.groups.len() == 0  )
		{
			string invalidKeywords = ""
			foreach( word in keywordsToInclude )
				invalidKeywords = invalidKeywords + word + ", "
			Assert( false, "No resource groups found. Keyword(s) may be invalid: " + invalidKeywords )
		}
		arrayOfResoureGroupsToReturn.extend( resources.groups )
	}

	Assert( arrayOfResoureGroupsToReturn.len() > 0 )

	return arrayOfResoureGroupsToReturn
}

PointOfInterest function ORS_GetPOIByKeyword( array<PointOfInterest> pois, string keyword )
{
	foreach( poi in pois )
	{
		if ( poi.core.keywords.contains( keyword ) )
			return poi
	}

	Assert( false, format( "Couldn't find any poi in array[%d] with keyword: '%s'", pois.len(), keyword ) )
	PointOfInterest blank
	return blank
}


bool function ORS_IsValidPOI( PointOfInterest poi )
{
	if ( poi.core.spawnOrigin == <0, 0, 0> )
		return false

	return true
}


#if SERVER
array<ProwlerSpawn> function ORS_GetProwlerSpawnsInRadius( vector center, float radius )
{
	array<ProwlerSpawn> prowlerSpawnCandidates = ORS_Find_( ORS_GetGlobalGroup(), eSearchFlags.NONE, [], [], [] ).prowlerSpawns
	array<ProwlerSpawn> prowlerSpawns


	float maxDist2DSq = ( radius * radius )

	foreach( spawner in prowlerSpawnCandidates )
	{
		if ( Distance2DSqr( spawner.core.spawnOrigin, center ) < maxDist2DSq )
			prowlerSpawns.append( spawner )
	}

	return prowlerSpawns

}
#endif // SERVER



#if SERVER
array<PointOfInterest> function ORS_GetPOIsInRadiusByKeywords( vector center, float radius, array<string> keywords )
{
	array<PointOfInterest> POIresourcesCandidates = ORS_Find_( ORS_GetGlobalGroup(), eSearchFlags.NONE, [], keywords, [] ).pois
	array<PointOfInterest> POIresources

	float maxDist2DSq = ( radius * radius )

	foreach( poi in POIresourcesCandidates )
	{
		if ( Distance2DSqr( poi.core.spawnOrigin, center ) < maxDist2DSq )
			POIresources.append( poi )
	}

	return POIresources

}
#endif // SERVER


#if SERVER
array<LootSpawn> function ORS_GetLootSpawnsInRadiusByKeywords( vector center, float radius, array<string> keywords = [] )
