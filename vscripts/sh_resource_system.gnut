#if DEV
bool s_debugDrawFrame = false
bool s_debugDrawTextDetails = false
bool s_debugDrawGroups = false
bool s_debugDrawSpawns = false
bool s_debugDrawProwlerSpawns = false
bool s_debugDrawPOIs = false
void function DEV_ResourceUpdateDrawFrame()
{
	if ( s_debugDrawGroups || s_debugDrawSpawns || s_debugDrawProwlerSpawns || s_debugDrawPOIs )
		s_debugDrawFrame = true
	else
		s_debugDrawFrame = false
}

void function DEV_ResourceToggleDrawGroups()
{
	s_debugDrawGroups = !s_debugDrawGroups
	DEV_ResourceUpdateDrawFrame()
}

void function DEV_ResourceToggleDrawSpawns()
{
	s_debugDrawSpawns = !s_debugDrawSpawns
	DEV_ResourceUpdateDrawFrame()
}

void function DEV_ResourceToggleDrawProwlerSpawns()
{
	s_debugDrawProwlerSpawns = !s_debugDrawProwlerSpawns
	DEV_ResourceUpdateDrawFrame()
}

void function DEV_ResourceToggleDrawPOIs()
{
	s_debugDrawPOIs = !s_debugDrawPOIs
	DEV_ResourceUpdateDrawFrame()
}

void function DEV_ResourceToggleDrawTextDetails()
{
	s_debugDrawTextDetails = !s_debugDrawTextDetails
}

void function DebugFrameThread()
{
	while ( true )
	{
		if ( s_debugDrawFrame )
			DebugDrawFrame()
		wait 0.5
	}
}

void function DebugDrawFrame()
{
	if ( s_debugDrawGroups )
	{
		foreach ( ResourceCore core in s_all._listByType[eORType.GROUP] )
		{
			vector pos = core.spawnOrigin
			vector color = <0, 128, 255>
			float size = 50.0
			if ( MapZones_GetZoneForOrigin( pos ) < 0 )
			{
				color = <255, 32, 32>
				size = 500.0
			}
			if ( s_debugDrawTextDetails )
				DebugDrawText( pos + <0, 0, 60>, format( "Group -- keywords [ %s ]", GetKeywordsDescString( core.keywords ) ), true, 0.6 )
			//DebugDrawCube( pos, size, color, false, 0.6 )
			DebugDrawMark( pos, size, color, true, 0.6 )
		}
	}

	if ( s_debugDrawSpawns )
	{
		foreach ( ResourceCore core in s_all._listByType[eORType.INFANTRY_SPAWN] )
		{
			vector pos = core.spawnOrigin
			vector angles = core.spawnAngles
			vector forward = AnglesToForward( angles )
			if ( s_debugDrawTextDetails )
				DebugDrawText( pos + <0, 0, 80>, format( "Infantry Spawn -- keywords [ %s ]", GetKeywordsDescString( core.keywords ) ), true, 0.6 )
			DebugDrawRotatedBox( pos, <-15, -15, 0>, <15, 15, 60>, angles, COLOR_RED, false, 0.6 )
			DebugDrawArrow( pos + <0, 0, 30>, pos + <0, 0, 30> + forward * 20, 10, COLOR_RED, false, 0.6 )
		}
	}

	if ( s_debugDrawProwlerSpawns )
	{
		foreach ( ResourceCore core in s_all._listByType[eORType.PROWLER_SPAWN] )
		{
			vector pos = core.spawnOrigin
			vector angles = core.spawnAngles
			vector forward = AnglesToForward( angles )
			if ( s_debugDrawTextDetails )
				DebugDrawText( pos + <0, 0, 80>, format( "Prowler Spawn -- keywords [ %s ]", GetKeywordsDescString( core.keywords ) ), true, 0.6 )
			DebugDrawRotatedBox( pos, <-15, -15, 0>, <15, 15, 60>, angles, COLOR_RED, false, 0.6 )
			DebugDrawArrow( pos + <0, 0, 30>, pos + <0, 0, 30> + forward * 20, 10, COLOR_RED, false, 0.6 )
		}
	}

	if ( s_debugDrawPOIs )
	{
		foreach ( ResourceCore core in s_all._listByType[eORType.POI] )
		{
			vector pos = core.spawnOrigin
			vector angles = core.spawnAngles
			vector forward = AnglesToForward( angles )
			if ( s_debugDrawTextDetails )
				DebugDrawText( pos + <0, 0, 30>, format( "POI -- keywords [ %s ]", GetKeywordsDescString( core.keywords ) ), true, 0.6 )
			DebugDrawRotatedBox( pos, <-15, -15, 0>, <15, 15, 15>, angles, COLOR_WHITE, false, 0.6 )
			DebugDrawArrow( pos + <0, 0, 15>, pos + <0, 0, 15> + forward * 10, 5, COLOR_WHITE, false, 0.6 )
		}
	}
}

void function DEV_PrintObjectiveEntsReport( bool verbose )
{
	printf( "" )
	PrintResourceCollection( s_all, ("Resources: '" + GetMapName() + "'") )
	if ( verbose )
	{
		printf( "" )
		printf( "==   Details (flat)" )
		PrintCollection( s_all )

		printf( "" )
		printf( "==   Details (nested)" )
		PrintItemRecursive( s_globalGroup.core, 0, 999 )
	}
	printf( "" )
}

//
void function DEV_PrintCollection( ResourceCollection coll )
{
	printf( "" )
	printf( "==   Details for collection" )
	PrintCollection( coll )
	printf( "" )
}

void function DEV_PrintGroup( ResourceGroup group, int maxDepth = 999 )
{
	printf( "" )
	printf( "==   Details for group (maxDepth=%d)", maxDepth )
	PrintItemRecursive( group.core, 0, maxDepth )
	printf( "" )
}
