table<var, void functionref(var)> WORKAROUND_challengeButtonToClickHandlerMap = {} // todo(dw): R5DEV-81942
table<var, void functionref(var)> WORKAROUND_challengeButtonToRightClickHandlerMap = {} // todo(dw): R5DEV-81942


