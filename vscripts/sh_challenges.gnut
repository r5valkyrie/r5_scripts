#if SERVER
void function RefreshDailyChallengesThread( entity player, bool BPChangeOver )
{
	Assert( IsLobby() )

	EndSignal( player, "OnDestroy" )

	bool forceRefresh = BPChangeOver

	while ( IsValid( player ) )
	{
		while ( !GRX_IsInventoryReady( player ) )
			WaitFrame()

		// note: order matters -- UpdaUpdateDailyChallenges bumps the pvar for daily expiry so it HAS to go last (woohoo side effects <3)
		// otherwise, any other "daily" type refreshes that rely on that pvar will just be forever kicked down the road
		UpdateDailyEventShopChallenges( player )
		UpdateDailyChallenges( player, forceRefresh )

		forceRefresh = false
		Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )

		int dailyExpirationTime = ClampChallengeExpireTime( player.GetPersistentVarAsInt( "dailyExpirationTime" ) )
		int currentTime         = Daily_GetCurrentTime()
		if ( currentTime < dailyExpirationTime )
		{
			float delay = float( dailyExpirationTime - currentTime )
			#if CHALLENGE_DEBUG
				ChallengeDbg( player, "Waiting",
					"dailyExpirationTim", dailyExpirationTime,
					"currentTime", currentTime,
					"delay", delay )
			#endif
			wait delay
		}
		else
		{
			wait 5.0
		}

		WaitFrame()
	}
}
#endif

#if SERVER
void function RefreshWeeklyChallengesThread( entity player )
{
	Assert( IsLobby() )

	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	int nextRefreshUnixTime = GetCurrentBattlePassWeekExpirationTime()
	WaitForUnixTime( nextRefreshUnixTime )

	bool BPChangeOver = false

	UpdateWeeklyChallenges( player, BPChangeOver )
	UpdateWeeklyRecurringChallenges( player, BPChangeOver )

	Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
}
#endif

