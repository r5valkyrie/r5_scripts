	DEV_PDefGen_AddField_Int( "postgameGrindStartValue" )
	DEV_PDefGen_AddField_Int( "currentBattlePassChallengeSeason" )

	DEV_PDefGen_AddField_GUIDArray_IntKey( "favoriteChallengeGUID", NUM_FAVORITE_CHALLENGES )

	DEV_PDefGen_AddField_IntArray_IntKey( "weeklyGroupOrder", NUM_CHALLENGE_WEEKS_MAX )

	DEV_PDefGen_EndFieldGroup()
}
