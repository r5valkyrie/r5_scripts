#if SERVER
void function Challenges_OnPlayerReconnected( entity player )
{
	bool isReconnecting = true
	thread Challenges_OnPlayerConnectedThread( player, isReconnecting )
}

void function Challenges_MatchAddStatCallbacks( entity player, PlayerChallengesState pcs )
{
	Assert( !IsLobby() )
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in clone pcs.challengeStateMap )
	{
		int tierCount   = Challenge_GetTierCount( challengeFlav )
		int currentTier = Challenge_GetCurrentTier( player, challengeFlav )

		for ( int tierIdx = 0 ; tierIdx < tierCount ; tierIdx++ )
		{
			array<string> statRefs = Challenge_GetStatRefs( challengeFlav, tierIdx )
			RegisterOnStatChangedCallback( player, statRefs, challengeFlav )

			if ( Challenge_IsEitherOr( challengeFlav ) )
			{
				array<string> altStatRefs = Challenge_GetStatRefs( challengeFlav, tierIdx, true )
				RegisterOnStatChangedCallback( player, altStatRefs, challengeFlav )
			}
		}
	}
	GetPlayerChallengesState( player ).statCallbacksRegistered = true
}

void function Challenges_LobbyAddStatCallbacks( entity player )
{
	Assert( IsLobby() )
}

void function Challenges_OnPlayerConnectedThread( entity player, bool isReconnecting )
{
	if ( !IsValid( player ) )
		return

	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	if ( BOTS_HAVE_CHALLENGES == false && player.IsNPC() )
		return

	if ( IsPrivateMatchLobby() || IsPrivateMatch() )
		return

	// is covered by private match but hits on listen server
	if ( player.GetTeam() == TEAM_SPECTATOR )
		return

	OnThreadEnd(
		function() : ( player )
		{
			if ( !IsValid( player ) )
			{
				return
			}
			GetPlayerChallengesState( player ).challengesThreadCompleted = true
			Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
		}
	)

	PlayerChallengesState pcs
	fileLevel.playerChallengesStateMap[player] <- pcs

	InitPlayerChallengesStateFromPersistence( player, pcs )
	// Go through all previously assigned player challenges and ensure completed ones were handled

	bool removedOldChallenges = false
	array< ItemFlavor > challengesThatDontWorkAnymore
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		int tierCount = Challenge_GetTierCount( challengeFlav )
		if ( tierCount == 0 )
			challengesThatDontWorkAnymore.append( challengeFlav )
	}

	fileLevel.hasSvOptimizations = GetCurrentPlaylistVarBool( "has_sv_op_v1_challenges", true )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	foreach ( challengeFlav in challengesThatDontWorkAnymore )
	{
		TakeChallengeFromPlayer( player, challengeFlav, "no_tiers" )
		removedOldChallenges = true
	}

	if ( removedOldChallenges )
	{
		// clear postgame menu
		player.SetPersistentVar( "lastGamePlayers", 0 )
		player.SetPersistentVar( "lastGameSquads", 0 )
	}

	if ( IsLobby() )
	{
		Challenge_LobbyThread_ProcessChallengesForPlayer( player, pcs )
		ResetSingleMatchChallengesForPlayer( player, pcs )
	}
	else
	{
		// in a match, we don't want to action on any Challenges in terms of *state* - assign, take, etc
		// we only want the stat callbacks so progress happens appropriately - does NOT address UX of Events ending mid-match however
		Challenges_MatchAddStatCallbacks( player, pcs )
		Mythics_RegisterBoostedMythicChallengeForPlayer( player )
		if ( !isReconnecting && IsMatchmakingFromMatchEnabled() )
			ResetSingleMatchChallengesForPlayer( player, pcs )
	}
}

void function Challenge_LobbyThread_ProcessChallengesForPlayer( entity player, PlayerChallengesState pcs )
{
	Challenges_LobbyAddStatCallbacks( player )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	// Attempt to progress assigned challenges
	{
		array<ItemFlavor> challengesToProcess = []
		foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
		{
			challengesToProcess.append( challengeFlav )
		}

		int attemptsRemaining = GetCurrentPlaylistVarInt( "challenge_completion_attempts", 5 )
		while ( attemptsRemaining-- > 0 )
		{
			if ( challengesToProcess.len() == 0 )
				break

			for ( int idx = challengesToProcess.len() - 1; idx >= 0; idx-- )
			{
				bool processingSuccessful = UpdateChallengeCompletion( player, challengesToProcess[idx] )
				if ( processingSuccessful )
				{
					challengesToProcess.remove( idx )
				}
			}

			if ( attemptsRemaining == 0 )
			{
				foreach ( ItemFlavor challengeFlav in challengesToProcess )
				{
					PIN_Challenge( player, ItemFlavor_GetHumanReadableRef( challengeFlav ), "failed_update" )
				}
			}

			wait 1.0 // This retrying is just so we can wait for challenge tiers that use GRX_GiveSequenceReward.
		}
	}

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	thread RefreshEventChallengesThread( player )

	bool BPChangeOver = false

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	ItemFlavor ornull activeBattlePass = fileLevel.currentSeason.battlePassOrNull

	if ( activeBattlePass == null )
	{
		BPChangeOver = true
	}
	else
	{
		expect ItemFlavor( activeBattlePass )
		int playerCurrentBP = player.GetPersistentVarAsInt( "currentBattlePassChallengeSeason" )
		int activeBPID      = ItemFlavor_GetGUID( activeBattlePass )
		if ( activeBPID != playerCurrentBP )
		{
			BPChangeOver = true
			player.SetPersistentVar( "currentBattlePassChallengeSeason", activeBPID )
		}
	}

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	thread RefreshDailyChallengesThread( player, BPChangeOver )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	UpdateWeeklyChallenges( player, BPChangeOver )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	UpdateWeeklyRecurringChallenges( player, BPChangeOver )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	thread RefreshWeeklyChallengesThread( player )

	if ( fileLevel.hasSvOptimizations )
		wait 0.1

	                           
		UpdateBeginnerChallenges( player )
                                 

	UpdateMythicChallenges( player ) // do this last because we want to give GRX state maximum time to update

	foreach ( ItemFlavor challengeFlav, ChallengeState cs in clone pcs.challengeStateMap )
	{
		bool processingSuccessful = UpdateChallengeCompletion( player, challengeFlav )
		if ( !processingSuccessful )
			return // (dw): see comment above

		int tierCount   = Challenge_GetTierCount( challengeFlav )
		int currentTier = Challenge_GetCurrentTier( player, challengeFlav )

		// something is wrong, reset this challenge R5DEV-102463
		Assert( currentTier <= Challenge_GetTierCount( challengeFlav ) )
		if ( currentTier > Challenge_GetTierCount( challengeFlav ) )
		{
			TakeChallengeFromPlayer( player, challengeFlav, "tier_too_high" )
			AssignChallengeToPlayer( player, challengeFlav )
			currentTier = 0
		}
	}
}

void function ResetSingleMatchChallengesForPlayer( entity player, PlayerChallengesState pcs )
{
	foreach ( ItemFlavor challenge in fileLevel.singleMatchChallenges )
	{
		if ( Challenge_IsAssigned( player, challenge ) && !Challenge_IsComplete( player, challenge ) )
		{
			ChallengeState cs 	   = pcs.challengeStateMap[ challenge ]
			int currentTier 	   = Challenge_GetCurrentTier( player, challenge )
			array<string> statRefs = Challenge_GetStatRefs( challenge, currentTier )
			int newMarkerValue     = 0
			foreach ( string statRef in statRefs )
			{
				StatEntry statEntry = GetStatEntryByRef( statRef )
				newMarkerValue += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
			}
			player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarker", newMarkerValue )

			if ( Challenge_IsEitherOr( challenge ) )
			{
				statRefs.clear()
				statRefs       = Challenge_GetStatRefs( challenge, currentTier, true )
				newMarkerValue = 0
				foreach ( string statRef in statRefs )
				{
					StatEntry statEntry = GetStatEntryByRef( statRef )
					newMarkerValue += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
				}
				player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarkerAlt", newMarkerValue )
			}
		}
	}
}

void function HandleStatChanged( entity player, StatEntry statEntry, int oldValue, int newValue )
{
	if ( GetCurrentPlaylistVarBool( "delayed_stat_callbacks", true ) )
	{
		thread Callback_OnStatChanged_Int( player, statEntry, oldValue, newValue )
	}
	else
	{
		Callback_OnStatChanged_Int( player, statEntry, oldValue, newValue )
	}
}

void function RegisterOnSingleStatChangedCallback( entity player, StatEntry statEntry )
{
	AddCallback_StatChanged_Int( player, statEntry, void function( entity player, int oldValue, int newValue ) : ( statEntry ) {
		HandleStatChanged( player, statEntry, oldValue, newValue )
	} )
}

void function RegisterOnStatChangedCallback( entity player, array< string > statRefs, ItemFlavor challenge )
{
	foreach ( string statRef in statRefs )
	{
		StatEntry statEntry = GetStatEntryByRef( statRef )
		AddCallback_StatChanged_Int( player, statEntry, void function( entity player, int oldValue, int newValue ) : ( statEntry ) {
			HandleStatChanged( player, statEntry, oldValue, newValue )
		} )
	}
}

bool function AllowRewardSequenceSkipAhead( ItemFlavor challenge )
{
	Assert( ItemFlavor_GetType( challenge ) == eItemType.challenge )
	return GetGlobalSettingsBool( ItemFlavor_GetAsset( challenge ), "grxRewardSequenceAllowsSkipAhead" )
}
#endif // SERVER

