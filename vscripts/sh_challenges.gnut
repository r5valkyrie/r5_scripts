	for ( int index = 0; index < NUM_FAVORITE_CHALLENGES; index++ )
	{
		player.SetPersistentVar( format( "favoriteChallengeGUID[%d]", index ), 0 )
	}

	Remote_CallFunction_NonReplay( player, "ServerToClient_ChallengeDataDidChange", false )
}
