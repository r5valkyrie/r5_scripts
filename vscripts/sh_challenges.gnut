		return

	UpdateMythicChallenges( player )
}
#endif

#if SERVER
void function UpdateBeginnerChallenges( entity player )
{
	Assert( IsLobby() )

                           
	if ( !GRX_IsInventoryReady( player ) )
		return

	if ( !Challenge_IsChallengesStateInititated( player ) )
		return

	if( !BeginnerChallenges_IsActive() )
		return

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	bool didChange     = false

                                   
                                                          

                                                                                              
                                                                                                                             

                                                                                  
                                       
   
                                                                         
    
                                                                             
                    
    
   
      
   
                                                    
                                                                         
    
                                                        
     
                                                                                
                     
     
    

                                                 
                                                           
    
                                                                         
                                                         
     
                                                      
                     
     
    
   
       

	if ( didChange )
		Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
      
}

void function UpdateMythicChallenges( entity player )
{
	Assert( IsLobby() )

	if ( !GRX_IsInventoryReady( player ) )
		return

	if ( !Challenge_IsChallengesStateInititated( player ) )
		return

	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	array<ItemFlavor> allMythic = clone GetAllChallengesOfTimespan( eChallengeTimeSpanKind.MYTHIC )

	foreach ( ItemFlavor challenge in allMythic )
	{
		if ( ItemFlavor_ChallengesHaveMetaData() )
		{
			Assert( ItemFlavor_GetType( challenge ) == eItemType.challenge )

			table<string, string> ornull metaData = ItemFlavor_GetMetaData( challenge )
			expect table<string, string>(metaData)
			SettingsAssetGUID preReq = int( metaData[ HAS_MYTHIC_PREREQ ] )

			if ( ! IsValidItemFlavorGUID( preReq ) )
				continue

			Assert( IsItemFlavorStructValid( GetItemFlavorByGUID( preReq ).guid, eValidation.ASSERT ) )
			Assert( ItemFlavor_GetGRXMode( GetItemFlavorByGUID( preReq ) ) == eItemFlavorGRXMode.REGULAR )

			bool hasPrereq    = GRX_IsItemOwnedByPlayer_AllowOutOfDateData( GetItemFlavorByGUID( preReq ), player )
			bool hasChallenge = Challenge_IsAssigned( player, challenge )

			array< ItemFlavor > allSkins = Mythics_GetAllSkinsFromBase( GetItemFlavorByGUID( preReq ) )
			int ownedCount = 0
			foreach ( ItemFlavor skinFlav in allSkins )
			{
				if ( GRX_IsItemOwnedByPlayer( skinFlav, player ) )
					ownedCount++
			}
			bool ownsAllSkins = ( ownedCount == allSkins.len() )

			bool didChange = false
			if ( hasPrereq && ! hasChallenge && ! ownsAllSkins )
			{
				AssignChallengeToPlayer( player, challenge )
				didChange = true
			}
			else if ( ( ! hasPrereq || ownsAllSkins ) && hasChallenge )
			{
				TakeChallengeFromPlayer( player, challenge, !hasPrereq ? "mythic_prereq" : "mythic_owned" )
				didChange = true
			}

			if ( didChange )
				Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
		}
		else
		{
			Assert( false, "Mythic skins REQUIRE Challenge Meta Data" )
		}
	}
}
#endif

#if SERVER
void function UpdateDailyEventShopChallenges( entity player )
{
	#if DEVELOPER
	if ( DEV_ShouldIgnorePersistence() )
	{
		return
	}
	#endif

	int dailyExpirationTime = ClampChallengeExpireTime( player.GetPersistentVarAsInt( "dailyExpirationTime" ) )
	int currentTime = Daily_GetCurrentTime()
	bool refreshTimeInFuture = dailyExpirationTime - currentTime > SECONDS_PER_DAY
	bool expired = ( currentTime >= dailyExpirationTime ) || refreshTimeInFuture

	array< ItemFlavor > current = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENTSHOP_DAILY_CHALLENGE )
	array< ItemFlavor > pool = EventShop_GetCurrentActiveEventShopDailyChallenges()

	// if we have no current shop, remove the current shop dailies and return
	if ( EventShop_GetCurrentActiveEventShop() == null )
	{
		foreach ( ItemFlavor challenge in current )
		{
			TakeChallengeFromPlayer( player, challenge, "event_shop_inactive" )
		}
		return
	}

	// otherwise check if we need to refresh; if so then remove current dailies and replace
	if ( !expired )
	{
		return
	}

	// it's possible to be here with dailies that are expired and need to be removed but our pool is empty because there is no next shop
	// or the next shop doesn't have challenges -- in that case, clean up (remove current) and return early

	foreach ( ItemFlavor challenge in current )
	{
		TakeChallengeFromPlayer( player, challenge, "event_shop_expired" )
	}

	if ( pool.len() == 0 )
	{
		return
	}

	// if we're here, then it means we have a pool to work with and we've emptied the current batch
	// re-assign from the pool and finish; we don't need to set the expire time since UpdateDailyChallenges() does it

	foreach ( ItemFlavor challenge in GetChallengesFromPool( pool, player, DAILY_CHALLENGE_SET ) )
	{
		AssignChallengeToPlayer( player, challenge )
	}
}
#endif

#if SERVER
void function UpdateDailyChallenges( entity player, bool forceNew = false )
{
	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	int dailyExpirationTime                   = ClampChallengeExpireTime( player.GetPersistentVarAsInt( "dailyExpirationTime" ) )
	int currentTime                           = Daily_GetCurrentTime()
	bool challengeRefreshTimeSetToFarInFuture = dailyExpirationTime - currentTime > SECONDS_PER_DAY //Defensive fix for time skip related hijinks
	//printt( "challengeRefreshTimeSetToFarInFuture : " + challengeRefreshTimeSetToFarInFuture  )
	bool dailiesExpired                       = (currentTime >= dailyExpirationTime) || challengeRefreshTimeSetToFarInFuture || forceNew


	// Get current assigned dailies
	array<ItemFlavor> currentDailies = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.DAILY )

	int numDailiesToAssign = DAILY_CHALLENGE_SET.len()

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	if ( fileLevel.currentSeason.battlePassOrNull == null )
		numDailiesToAssign = 0

	if ( currentDailies.len() == numDailiesToAssign && !dailiesExpired )
	{
		#if CHALLENGE_DEBUG
			ChallengeDbg( player, "",
				"dailyExpirationTime", dailyExpirationTime,
				"currentTime", currentTime,
				"dailiesExpired", dailiesExpired,
				"numDailiesToAssign", numDailiesToAssign )
		#endif
		return
	}


	// Get all possible dailies in the pool and remove previous dailies from the pool
	array<ItemFlavor> dailyChallengePool = clone GetAllChallengesOfTimespan( eChallengeTimeSpanKind.DAILY )

	array<ItemFlavor> nonRepeatableDailies
	foreach ( ItemFlavor challenge in currentDailies )
	{
		nonRepeatableDailies.append( challenge )
	}

	foreach ( ItemFlavor challenge in nonRepeatableDailies )
		dailyChallengePool.fastremovebyvalue( challenge )

	Assert( dailyChallengePool.len() >= numDailiesToAssign, "Not enough daily challenges in the pool to assign new unique daily challenges" )
	dailyChallengePool.randomize()

	// User doesn't have enough dailies assigned, fill the open slots
	while( currentDailies.len() < numDailiesToAssign )
	{
		ItemFlavor challenge = dailyChallengePool.pop()
		AssignChallengeToPlayer( player, challenge )
		currentDailies.append( challenge )
	}

	if ( !dailiesExpired )
	{
		#if CHALLENGE_DEBUG
			ChallengeDbg( player, "",
				"dailyExpirationTime", dailyExpirationTime,
				"currentTime", currentTime,
				"dailiesExpired", dailiesExpired,
				"numDailiesToAssign", numDailiesToAssign )
		#endif
		return
	}

	// Remove old dailies
	foreach ( ItemFlavor challenge in currentDailies )
	{
		TakeChallengeFromPlayer( player, challenge, "daily" )
	}

	array<ItemFlavor> challengesFromPool = GetChallengesFromPool( dailyChallengePool, player, DAILY_CHALLENGE_SET )
	for ( int i = 0 ; i < challengesFromPool.len() ; i++ )
	{
		ItemFlavor challenge = challengesFromPool[i]

		challenge = OverrideChallengeIfNecessary( challenge, player )

		AssignChallengeToPlayer( player, challenge )
	}

	// Update expiration on dailies
	int newExpireTime = ClampChallengeExpireTime( Daily_GetEndOfDayForCurrentTime() )
	#if CHALLENGE_DEBUG
		ChallengeDbg( player, "",
			"dailyExpirationTime", dailyExpirationTime,
			"currentTime", currentTime,
			"dailiesExpired", dailiesExpired,
			"numDailiesToAssign", numDailiesToAssign,
			"newExpireTime", newExpireTime )
	#endif

	//+TEMP FOR S04E01 - SEE R5DEV-131084 - Refresh event dailies
	array<ItemFlavor> events = GetActiveBuffetEventArray( GetUnixTimestamp() )
	foreach ( buffetEvent in events )
	{
		array<ItemFlavor> dailies                = BuffetEvent_GetDailyChallenges_TEMP( buffetEvent )
		array<ItemFlavor> currentEventChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT, -1, buffetEvent )

		foreach ( ItemFlavor challenge in dailies )
		{
			if ( currentEventChallenges.find( challenge ) != -1 )
			{
				TakeChallengeFromPlayer( player, challenge, "buffet_daily" )
				AssignChallengeToPlayer( player, challenge )
			}
		}
	}
	//-TEMP FOR S04E01 - SEE R5DEV-131084

	player.SetPersistentVar( "dailyExpirationTime", newExpireTime )
	player.SetPersistentVar( "dailyRerollCount", 0 )
}
#endif

ItemFlavor function OverrideChallengeIfNecessary( ItemFlavor challenge, entity player )
{
	// Kepler A/B testing not available
	return challenge
}

#if SERVER
void function UpdateRewardCampaignChallenges( entity player )
{
	if ( RewardCampaign_IsEnabled() )
	{
		array< ItemFlavor > rewardCampaigns = RewardCampaign_GetRegisteredEvents()
		foreach ( ItemFlavor rewardCampaign in rewardCampaigns )
		{
			array< ItemFlavor > challenges = []
			challenges.append( RewardCampaign_GetMetaChallenge( rewardCampaign ) )
			challenges.extend( RewardCampaign_GetStandaloneChallenges( rewardCampaign ) )

			if ( CalEvent_IsActive( rewardCampaign, GetUnixTimestamp() ) )
			{
				// Assign active reward campaigns' challenges
				foreach ( ItemFlavor challenge in challenges )
				{
					if ( !Challenge_IsAssigned( player, challenge ) )
					{
						AssignChallengeToPlayer( player, challenge )
					}
				}
			}
			else
			{
				// Take inactive reward campaigns' challenges
				foreach ( ItemFlavor challenge in challenges )
				{
					if ( Challenge_IsAssigned( player, challenge ) )
					{
						TakeChallengeFromPlayer( player, challenge, "campaign" )
					}
				}
			}
		}

		// Won't iterate through the contained challenge collections, find all active challenge collections separately instead.
	}
}
#endif

#if SERVER
void function UpdateChallengeCollectionChallenges( entity player )
{
	if ( ChallengeCollection_IsEnabled() )
	{
		table< int, ChallengeCollection > challengeCollections = ChallengeCollection_GetRegisteredCollections()

		// Update all registered challenges to make sure things get assigned/unassigned.
		foreach( ChallengeCollection challengeCollection in challengeCollections )
		{
			int activeState = ChallengeCollection_GetActiveState( player, challengeCollection )
			bool challengeCollectionIsActive = ( activeState == eChallengeCollectionActiveState.ACTIVE )

			array< ItemFlavor > challengesToAssign = []
			array< ItemFlavor > challengesToUnassign = []

			if ( challengeCollectionIsActive )
			{
				// Queue Collection's meta challenge
				challengesToAssign.append( challengeCollection.mainChallenge )

				if ( ChallengeCollection_GetFirstViewedTime( player, challengeCollection ) == 0 )
				{
					ChallengeCollection_SetFirstViewedTime( player, challengeCollection, GetUnixTimestamp() )
				}
			}
			else
			{
				challengesToUnassign.append( challengeCollection.mainChallenge )
			}

			// Queue the sets' meta challenges and contained challenges
			foreach( ChallengeSet challengeSet in challengeCollection.challengeSets )
			{
				if ( challengeCollectionIsActive && CalEvent_IsActive( challengeSet.itemFlav, GetUnixTimestamp() ) )
				{
					challengesToAssign.append( challengeSet.mainChallenge )
					challengesToAssign.extend( challengeSet.challenges )
				}
				else
				{
					challengesToUnassign.append( challengeSet.mainChallenge )
					challengesToUnassign.extend( challengeSet.challenges )
				}
			}

			foreach( ItemFlavor challenge in challengesToAssign )
			{
				if ( !Challenge_IsAssigned( player, challenge ) )
				{
					AssignChallengeToPlayer( player, challenge )
				}
			}

			foreach( ItemFlavor challenge in challengesToUnassign )
			{
				if ( Challenge_IsAssigned( player, challenge ) )
				{
					TakeChallengeFromPlayer( player, challenge, "collection_" + string( activeState ) )
				}
			}
		}

	}
}
#endif

#if DEVELOPER && SERVER
void function TestReRollChallenge( entity player, int slot )
{
	array<ItemFlavor> currentDailies = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.DAILY )
	currentDailies.sort( Challenge_SortByDifficulty )
	ItemFlavor challenge            = currentDailies[slot]
	SettingsAssetGUID challengeGUID = ItemFlavor_GetGUID( challenge )
	RerollDailyChallenge( player, challengeGUID )
}
#endif

#if SERVER
void function ClientCallback_Challenge_ReRoll( entity player, int guid )
{
	thread _ChallengeReRoll( player, guid )
}
#endif


#if SERVER
void function _ChallengeReRoll( entity player, int guid )
{
	EndSignal( player, "OnDestroy" )

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	ItemFlavor ornull activeBattlePass = fileLevel.currentSeason.battlePassOrNull

	if ( activeBattlePass == null )
		return

	expect ItemFlavor( activeBattlePass )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	ItemFlavor rerollFlav = BattlePass_GetRerollFlav( activeBattlePass )

	int numTokens         = GRX_GetConsumableCount( ItemFlavor_GetGRXIndex( rerollFlav ) )
	string persistenceKey = "challengeRerollsUsed"
	int tokensUsed        = player.GetPersistentVarAsInt( persistenceKey )

	Assert( tokensUsed <= numTokens )

	int currentDailyRerollCount = player.GetPersistentVarAsInt( "dailyRerollCount" )
	int numNeeded               = CHALLENGE_REROLL_COSTS[ minint( currentDailyRerollCount, CHALLENGE_REROLL_COSTS.len() - 1 ) ]

	if ( numTokens - tokensUsed < numNeeded )
		return

	if ( RerollDailyChallenge( player, guid ) )
	{
		player.SetPersistentVar( persistenceKey, tokensUsed + numNeeded )
		int currentDailyReroll = player.GetPersistentVarAsInt( "dailyRerollCount" )
		player.SetPersistentVar( "dailyRerollCount", currentDailyReroll + 1 )
	}
}
#endif

#if SERVER
bool function RerollDailyChallenge( entity player, SettingsAssetGUID challengeGUID )
{
	ItemFlavor ornull replacementChallenge = null
	ItemFlavor ornull challengeToRemove = GetItemFlavorOrNullByGUID( challengeGUID, eItemType.challenge )

	if ( challengeToRemove == null )
		return false

	expect ItemFlavor( challengeToRemove )

	int targetDifficulty = Challenge_GetDifficulty( challengeToRemove )

	array<ItemFlavor> charactersUsedInRemovedChallenge = Challenge_GetCharacterItemFlavors( challengeToRemove, 0 )
	array<ItemFlavor> assignedDailyChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.DAILY )

	if ( assignedDailyChallenges.find( challengeToRemove ) == -1 )
		return false

	TakeChallengeFromPlayer( player, challengeToRemove, "reroll" )

	array<ItemFlavor> dailyChallengePool = clone GetAllChallengesOfTimespan( eChallengeTimeSpanKind.DAILY )

	dailyChallengePool.fastremovebyvalue( challengeToRemove )
	dailyChallengePool.randomize()

	foreach ( challenge in dailyChallengePool )
	{
		if ( Challenge_GetDifficulty( challenge ) != targetDifficulty )
		{
			continue
		}

		if ( Challenge_GetGameMode( challenge ) != eChallengeGameMode.ANY )
		{
			continue
		}

		array<ItemFlavor> charPrereq = Challenge_GetCharacterItemFlavors( challenge, 0 )
		bool ineligible = false

		foreach ( char in charPrereq )
		{
			if ( !GRX_IsItemOwnedByPlayer( char, player ) )
			{
				ineligible = true
				break
			}
			else if ( charactersUsedInRemovedChallenge.len() != 0 && charactersUsedInRemovedChallenge.find( char ) != -1 )
			{
				ineligible = true
				break
			}
		}

		if ( ineligible )
		{
			continue
		}

		replacementChallenge = challenge

		if ( replacementChallenge != null )
			break
	}

	if ( replacementChallenge == null )
	{
		replacementChallenge = dailyChallengePool.pop()
	}

	expect ItemFlavor( replacementChallenge )
	AssignChallengeToPlayer( player, replacementChallenge )

	Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
	return true
}
#endif

#if SERVER
array<ItemFlavor> function GetChallengesFromPool( array<ItemFlavor> dailyChallengePool, entity player, array<int> challengeDifficultySet )
{
	array<ItemFlavor> backupChallenges = clone dailyChallengePool
	array<ItemFlavor> results
	array<ItemFlavor> charactersUsed

	array<int> challengeSetCopy = clone challengeDifficultySet

	foreach ( challenge in dailyChallengePool )
	{
		bool ineligible = false

		array<ItemFlavor> charPrereq = Challenge_GetCharacterItemFlavors( challenge, 0 )
		foreach ( char in charPrereq )
		{
			if ( !GRX_IsItemOwnedByPlayer( char, player ) )
			{
				ineligible = true
				break
			}

			if ( charactersUsed.find( char ) != -1 )
			{
				ineligible = true
				break
			}
		}

		if ( ineligible )
		{
			continue
		}

		int difficulty = Challenge_GetDifficulty( challenge )
		if ( challengeSetCopy.find( difficulty ) != -1 )
		{
			challengeSetCopy.fastremovebyvalue( difficulty )
		}
		else
		{
			continue
		}

		charactersUsed.extend( charPrereq )

		results.append( challenge )

		if ( results.len() == challengeDifficultySet.len() )
		{
			break
		}
	}

	if ( results.len() < challengeDifficultySet.len() )
	{
		foreach ( challenge in backupChallenges )
		{
			if ( results.find( challenge ) != -1 )
				continue

			results.append( challenge )

			if ( results.len() == challengeDifficultySet.len() )
				break
		}
	}

	results.sort( Challenge_SortByDifficulty )

	return results
}
#endif

#if SERVER
int function Challenge_SortByDifficulty( ItemFlavor a, ItemFlavor b )
{
	if ( Challenge_GetDifficulty( a ) < Challenge_GetDifficulty( b ) )
		return -1
	else if ( Challenge_GetDifficulty( a ) > Challenge_GetDifficulty( b ) )
		return 1

	return 0
}
#endif


#if SERVER
void function UpdateWeeklyChallenges( entity player, bool resetChallenges )
{
	Assert( IsLobby() )

	UpdateWeeklyChallengeRandomization( player, resetChallenges )

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	ItemFlavor ornull activeBattlePass = fileLevel.currentSeason.battlePassOrNull

	int numChallengeWeeks = NUM_CHALLENGE_WEEKS_MAX

	if ( activeBattlePass != null )
	{
		numChallengeWeeks = GetNumBattlePassChallengesWeeks( expect ItemFlavor( activeBattlePass ) )
	}

	int currentWeek = GetCurrentBattlePassWeek()

	PlayerChallengesState pcs = GetPlayerChallengesState( player )

	array<int> validWeekGroups = []
	for ( int i = 1 ; i < numChallengeWeeks ; i++ )
	{
		if ( i <= currentWeek )
			validWeekGroups.append( player.GetPersistentVarAsInt( "weeklyGroupOrder[" + (i - 1) + "]" ) )
	}

	#if CHALLENGE_DEBUG
		ChallengeDbg( player, "",
			"currentWeek", currentWeek,
			"validWeekGroups", validWeekGroups.join( "," ) )
	#endif

	// Go through week by week and make sure the player has all challenges up to current week, but not anything past current week
	for ( int i = 1 ; i <= numChallengeWeeks ; i++ )
	{
		int groupIndex = player.GetPersistentVarAsInt( "weeklyGroupOrder[" + (i - 1) + "]" )

		if ( groupIndex <= 0 )
			continue

		array<ItemFlavor> assignedChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.SEASON_WEEKLY, groupIndex )

		// Take the challenges if there are any and we aren't to this week yet (happened a lot in dev with everything_unlocked)
		// Also take them if they are not in this Battle Pass
		foreach ( ItemFlavor challenge in clone assignedChallenges )
		{
			bool fromOldBP = false
			if ( activeBattlePass == null )
			{
				fromOldBP = true
			}
			else
			{
				expect ItemFlavor( activeBattlePass )
				fromOldBP = !BattlePassHasWeeklyChallenge( activeBattlePass, challenge, groupIndex )
			}

			if ( i > currentWeek || fromOldBP )
			{
				TakeChallengeFromPlayer( player, challenge, "weekly_old_bp" )
				assignedChallenges.removebyvalue( challenge )
			}
		}

		// Assign new challenges up to the current week if we don't have them already
		if ( i <= currentWeek && assignedChallenges.len() == 0 )
		{
			array<ItemFlavor> weeklyChallenges = GetAllChallengesOfTimespan( eChallengeTimeSpanKind.SEASON_WEEKLY, groupIndex )

			foreach ( ItemFlavor challenge in weeklyChallenges )
			{
				if ( !(challenge in pcs.challengeStateMap) )
				{
					AssignChallengeToPlayer( player, challenge )
				}
			}
		}
	}
}
#endif


#if SERVER
void function UpdateWeeklyChallengeRandomization( entity player, bool reinitialize )
{
	Assert( PersistenceGetArrayCount( "weeklyGroupOrder" ) == NUM_CHALLENGE_WEEKS_MAX )

	// If player has already been randomized we don't need to do anything
	array<int> randomizedOrder = []
	int numWeeks               = NUM_CHALLENGE_WEEKS_MAX

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	if ( fileLevel.currentSeason.battlePassOrNull != null )
	{
		numWeeks = GetNumBattlePassChallengesWeeks( expect ItemFlavor( fileLevel.currentSeason.battlePassOrNull ) )
	}

	for ( int i = 0 ; i < numWeeks ; i++ )
	{
		randomizedOrder.append( i + 1 )
		if ( player.GetPersistentVarAsInt( "weeklyGroupOrder[" + i + "]" ) == 0
				|| player.GetPersistentVarAsInt( "weeklyGroupOrder[" + i + "]" ) > numWeeks )
		{
			reinitialize = true
		}
	}

	if ( !reinitialize )
		return

	PlayerChallengesState pcs             = GetPlayerChallengesState( player )
	array<ItemFlavor> challengesToProcess = []
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		if ( Challenge_GetTimeSpanKind( challengeFlav ) == eChallengeTimeSpanKind.SEASON_WEEKLY )
			challengesToProcess.append( challengeFlav )
	}

	foreach ( challengeFlav in challengesToProcess )
		TakeChallengeFromPlayer( player, challengeFlav, "weekly_randomize" )

	randomizedOrder.randomize()

	#if CHALLENGE_DEBUG
		ChallengeDbg( player, "Randomizing weekly groups" )
	#endif

	for ( int i = 0 ; i < NUM_CHALLENGE_WEEKS_MAX ; i++ )
	{
		if ( i < numWeeks )
			player.SetPersistentVar( "weeklyGroupOrder[" + i + "]", randomizedOrder[i] )
		else
			player.SetPersistentVar( "weeklyGroupOrder[" + i + "]", 0 )
	}
}
#endif


#if SERVER
void function UpdateWeeklyRecurringChallenges( entity player, bool reinitialize )
{
	Assert( IsLobby() )

	array<ItemFlavor> allRecurringChallenges      = GetAllChallengesOfTimespan( eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING )
	array<ItemFlavor> assignedRecurringChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.SEASON_WEEKLY_RECURRING )
	int currentWeek                               = GetCurrentBattlePassWeek()
	int weeklyRecurringLastResetWeek              = player.GetPersistentVarAsInt( "weeklyRecurringLastResetWeek" )
	bool resetChallenges                          = currentWeek != weeklyRecurringLastResetWeek || reinitialize

	if ( fileLevel.currentSeason.expirationTimestamp < GetUnixTimestamp() )
		RefreshCachedSeasonInfo()

	ItemFlavor ornull activePass = fileLevel.currentSeason.battlePassOrNull
	if ( activePass != null )
	{
		expect ItemFlavor( activePass )
		if ( !BattlePass_WeeklyRecurringResetsEveryWeek( activePass ) )
			resetChallenges = reinitialize // don't reset per week
	}

	#if CHALLENGE_DEBUG
		ChallengeDbg( player, "",
			"currentWeek", currentWeek,
			"weeklyRecurringLastResetWeek", weeklyRecurringLastResetWeek,
			"resetChallenges", resetChallenges )
	#endif

	// Remove challenges that no longer exist, or if they're expired remove them as well (they will get them again in the next step)
	for ( int i = assignedRecurringChallenges.len() - 1 ; i >= 0 ; i-- )
	{
		ItemFlavor challenge = assignedRecurringChallenges[i]

		if ( !resetChallenges && allRecurringChallenges.find( challenge ) != -1 )
			continue

		TakeChallengeFromPlayer( player, challenge, "weekly_recurring" )
		assignedRecurringChallenges.remove( i )
	}

	// Make sure player has all available challenges assigned to them
	foreach ( ItemFlavor challenge in allRecurringChallenges )
	{
		if ( assignedRecurringChallenges.find( challenge ) != -1 )
			continue

		AssignChallengeToPlayer( player, challenge )
		assignedRecurringChallenges.append( challenge )
	}

	if ( activePass != null )
	{
		expect ItemFlavor( activePass ) // expect is scoped
		// it's possible for Entitlements or other Systems to alter BP Stars & XP in the Lobby.
		// since these are tracked as "stats," we need to add a callback so that proper UI elements can be triggered if they change
		Assert( BattlePass_UseStarsToProgress( activePass ) )
		ItemFlavor ornull starChallenge  = GetBattlePassRecurringStarChallenge( activePass )
		ItemFlavor ornull grindChallenge = GetBattlePassRecurringGrindlordChallenge( activePass )
		Assert( starChallenge != null && grindChallenge != null )
		expect ItemFlavor( starChallenge )
		expect ItemFlavor( grindChallenge )
		Assert( Challenge_IsAssigned( player, starChallenge ) && Challenge_IsAssigned( player, grindChallenge ) )

		array<string> statRefs = Challenge_GetStatRefs( starChallenge, BASE_CHALLENGE_TIER )
		RegisterOnStatChangedCallback( player, statRefs, starChallenge )

		statRefs = Challenge_GetStatRefs( grindChallenge, BASE_CHALLENGE_TIER )
		RegisterOnStatChangedCallback( player, statRefs, grindChallenge )

		GetPlayerChallengesState( player ).statCallbacksRegistered = true
	}

	if ( resetChallenges )
		player.SetPersistentVar( "weeklyRecurringLastResetWeek", currentWeek )
}
#endif


#if SERVER
void function RefreshEventChallengesThread( entity player )
{
	Assert( IsLobby() )

	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

#if DEVELOPER
	if ( DEV_ShouldIgnorePersistence() )
		return
#endif

	while ( false ) // Kepler not available
	{
		WaitFrame()
	}

	#if CHALLENGE_DEBUG
		array<string> dbgAssignedRefs = []
		array<string> dbgTakenRefs    = []
	#endif

	while ( true )
	{
		int nextRefreshUnixTime = GetNextEventStartUnixTime()

		array<ItemFlavor> assignedEventChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT )
		assignedEventChallenges.extend( GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_HIDDEN ) )
		array<ItemFlavor> desiredEventChallenges  = []

		ItemFlavor ornull activeEvent

		ItemFlavor ornull collectionEvent = GetActiveCollectionEvent( GetUnixTimestamp() )
		if ( collectionEvent != null )
		{
			array<ItemFlavor> collectionEventChallenges = CollectionEvent_GetChallenges( expect ItemFlavor(collectionEvent) )
			if ( collectionEventChallenges.len() > 0 )
			{
				if ( activeEvent == null )
				{
					activeEvent = collectionEvent
					desiredEventChallenges.extend( collectionEventChallenges )
				}
				else Warning( "Multiple calevents trying to assign event challenges! (%s, %s)", string(ItemFlavor_GetAsset( expect ItemFlavor(activeEvent) )), string(ItemFlavor_GetAsset( expect ItemFlavor(collectionEvent) )) )
			}
		}

		ItemFlavor ornull themedShopEvent = GetActiveThemedShopEvent( GetUnixTimestamp() )
		if ( themedShopEvent != null )
		{
			array<ItemFlavor> themedShopEventChallenges = ThemedShopEvent_GetChallenges( expect ItemFlavor(themedShopEvent) )

			if ( themedShopEventChallenges.len() > 0 )
			{
				if ( activeEvent == null )
				{
					activeEvent = themedShopEvent
					desiredEventChallenges.extend( themedShopEventChallenges )
				}
				else Warning( "Multiple calevents trying to assign event challenges! (%s, %s)", string(ItemFlavor_GetAsset( expect ItemFlavor(activeEvent) )), string(ItemFlavor_GetAsset( expect ItemFlavor(themedShopEvent) )) )
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		foreach ( buffetEvent in GetActiveBuffetEventArray( GetUnixTimestamp() ) )
		{
			int[1] OUT_nextRefreshUnixTime
			array<ItemFlavor> buffetEventChallenges = BuffetEvent_GetCurrentChallenges_EXCLUDING_DAILIES( buffetEvent, OUT_nextRefreshUnixTime )

			if ( buffetEventChallenges.len() > 0 )
			{
				desiredEventChallenges.extend( buffetEventChallenges )
				nextRefreshUnixTime = OUT_nextRefreshUnixTime[0]
			}

			//+TEMP FOR S04E01 - SEE R5DEV-131084
			array<ItemFlavor> dailies = BuffetEvent_GetDailyChallenges_TEMP( buffetEvent )
			desiredEventChallenges.extend( dailies )
			//-TEMP FOR S04E01 - SEE R5DEV-131084
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		ItemFlavor ornull eventShopEvent = EventShop_GetCurrentActiveEventShop()
		if ( eventShopEvent != null )
		{
			ItemFlavor ornull mainEventChallenge = EventShop_GetMainChallenge( expect ItemFlavor(eventShopEvent) )
			if ( mainEventChallenge != null )
			{
				desiredEventChallenges.append( expect ItemFlavor(mainEventChallenge) )

				array< ItemFlavor > eventShopDailyChallenges = EventShop_GetCurrentActiveEventShopDailyChallenges()
				foreach ( ItemFlavor challenge in eventShopDailyChallenges )
				{
					if ( !Challenge_IsAssigned( player, challenge ) )
					{
						AssignChallengeToPlayer( player, challenge )
					}
				}

				array< ItemFlavor > eventShopEventChallenges = EventShop_GetCurrentActiveEventShopEventChallenges()
				foreach ( ItemFlavor challenge in eventShopEventChallenges )
				{
					if ( !Challenge_IsAssigned( player, challenge ) )
					{
						AssignChallengeToPlayer( player, challenge )
					}
				}
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		foreach ( ItemFlavor assignedChallenge in assignedEventChallenges )
		{
			if ( desiredEventChallenges.find( assignedChallenge ) == -1 )
			{
				TakeChallengeFromPlayer( player, assignedChallenge, "event_inactive" )
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		bool assignedAnyEventChallenges = false
		foreach ( ItemFlavor desiredChallenge in desiredEventChallenges )
		{
			if ( assignedEventChallenges.find( desiredChallenge ) == -1 )
			{
				AssignChallengeToPlayer( player, desiredChallenge )
				assignedAnyEventChallenges = true
			}
		}

		// story event challenges
		array<ItemFlavor> assignedSpecialEventChallenges = GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_SPECIAL )
		assignedSpecialEventChallenges.extend( GetAssignedChallengesByTimeSpan( player, eChallengeTimeSpanKind.EVENT_SPECIAL_2 ) )
		array<ItemFlavor> desiredSpecialEventChallenges = []
		array<ItemFlavor> activeSpecialEvents

		array< ItemFlavor > storyChallengeEvents = GetActiveStoryChallengeEvents( GetUnixTimestamp() )
		foreach ( ev in storyChallengeEvents )
		{
			array<ItemFlavor> challenges = StoryChallengeEvent_GetStoryChallengesForPlayer( ev, player )
			if ( challenges.len() > 0 )
			{
				activeSpecialEvents.push( ev )
				desiredSpecialEventChallenges.extend( challenges )
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		foreach ( ItemFlavor assignedChallenge in assignedSpecialEventChallenges )
		{
			if ( desiredSpecialEventChallenges.find( assignedChallenge ) == -1 )
			{
				TakeChallengeFromPlayer( player, assignedChallenge, "special_event_end" )
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		bool assignedAnySpecialEventChallenges = false
		foreach ( ItemFlavor desiredChallenge in desiredSpecialEventChallenges )
		{
			if ( assignedSpecialEventChallenges.find( desiredChallenge ) == -1 )
			{
				AssignChallengeToPlayer( player, desiredChallenge )
				assignedAnySpecialEventChallenges = true
			}
		}

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		UpdateRewardCampaignChallenges( player )
		UpdateChallengeCollectionChallenges( player )

		if ( fileLevel.hasSvOptimizations )
			wait 0.1

		if ( activeSpecialEvents.len() > 0 && assignedAnySpecialEventChallenges )
		{
			// todo(dw): It's hacky to do this here but it's JFS for S03E01.
			Newness_MarkItemFlavorsAsNewForPlayer( player, activeSpecialEvents )
		}


		Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange_FromEventsRefresh" )

		if ( nextRefreshUnixTime == INT_MAX )
			break
		else
			WaitForUnixTime( nextRefreshUnixTime )
	}
}
#endif

#if SERVER
bool function AssignChallengeToPlayer( entity player, ItemFlavor challengeFlav )
{
	PlayerChallengesState pcs = GetPlayerChallengesState( player )

	bool alreadyHasChallenge = (challengeFlav in pcs.challengeStateMap)
	if ( alreadyHasChallenge )
	{
		Assert( false, format( "Tried to assign challenge %s twice to the same player", string( ItemFlavor_GetAsset( challengeFlav ) ) ) )
		PIN_Challenge( player, ItemFlavor_GetHumanReadableRef( challengeFlav ), "duplicate_start" )
		return false
	}

	int tierCount = Challenge_GetTierCount( challengeFlav )
	if ( tierCount == 0 )
		return false

	// Add to assigned challenges
	bool didAssignChallenge = false
	for ( int persistentArrayIdx = 0 ; persistentArrayIdx < NUM_CHALLENGES_MAX ; persistentArrayIdx++ )
	{
		if ( pcs.persistentArrayMirror[persistentArrayIdx] != null )
			continue

		ChallengeState cs
		cs.persistenceIdx	= persistentArrayIdx
		cs.flav				= challengeFlav

		player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].guid", ItemFlavor_GetGUID( challengeFlav ) )
		player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].currentTier", 0 )

		// we need to zero out bitfield type stats when the challenge is assigned so that we don't have previous progress
		// since we can't "diff" progress in the same way using statMarkers with bitfields
		if ( Challenge_IsBitfieldType( challengeFlav, 0 ) )
		{
			array<string> statRefs = Challenge_GetStatRefs( challengeFlav, 0 )
			Assert( statRefs.len() == 1, "Bitfield Challenges may only reference a single stat" )
			StatEntry entry = GetStatEntryByRef( statRefs[0] )
			Assert( entry.behavior == eStatBehavior.BITFIELD, "Bitfield Challenges must reference a BITFIELD-style stat" )

			#if ASSERTS
			foreach ( ItemFlavor assignedChallenge, ChallengeState unused in pcs.challengeStateMap )
			{
				array<string> assignedChallengeStatRefs = Challenge_GetStatRefs( assignedChallenge, 0 )
				foreach ( string ref in assignedChallengeStatRefs )
				{
					if ( ref == statRefs[0] )
					{
						Assert( false, "Bitfield stats may only be used by a single assigned challenge at a time as there is no way to diff progress on a bitfield." )
					}
				}
			}
			#endif

			player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].statMarker", 0 )
			player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].statMarkerAlt", 0 )
			player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].currentTier", 0 )

			InitializeBitfieldStat( player, entry )
		}

		int statMarker = 0
		if ( Challenge_ShouldStartAtZero( challengeFlav, 0 ) )
		{
			array<string> statRefs = Challenge_GetStatRefs( challengeFlav, 0 )
			foreach ( string statRef in statRefs )
			{
				StatEntry statEntry = GetStatEntryByRef( statRef )
				statMarker += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
			}
		}
		player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].statMarker", statMarker )

		statMarker = 0
		if ( Challenge_ShouldStartAtZero( challengeFlav, 0 ) && Challenge_IsEitherOr( challengeFlav ) )
		{
			array<string> statRefs = Challenge_GetStatRefs( challengeFlav, 0, true )
			foreach ( string statRef in statRefs )
			{
				StatEntry statEntry = GetStatEntryByRef( statRef )
				statMarker += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
			}
		}
		player.SetPersistentVar( "challenges[" + persistentArrayIdx + "].statMarkerAlt", statMarker )

		// Formally add the challenge to the PCS
		pcs.challengeStateMap[challengeFlav] <- cs
		pcs.persistentArrayMirror[persistentArrayIdx] = cs

		#if CHALLENGE_DEBUG
			ChallengeDbg( player, "Assigning challenge",
				"idx", persistentArrayIdx,
				"flav", string(ItemFlavor_GetAsset( challengeFlav )),
				"currentTier", Challenge_GetCurrentTier( player, challengeFlav ),
				"statMarker", player.GetPersistentVarAsInt( "challenges[" + persistentArrayIdx + "].statMarker" ),
				"statMarkerAlt", player.GetPersistentVarAsInt( "challenges[" + persistentArrayIdx + "].statMarkerAlt" ) )
		#endif

		if ( Challenge_GetTimeSpanKind( challengeFlav ) != eChallengeTimeSpanKind.DAILY )
			Newness_MarkItemFlavorsAsNewForPlayer( player, [challengeFlav] )

		PIN_Challenge( player, ItemFlavor_GetHumanReadableRef( challengeFlav ), "started" )

		didAssignChallenge = true
		break
	}

	Assert( didAssignChallenge, format( "Challenge %s wasn't assigned for player because no free slots were available", string(ItemFlavor_GetAsset( challengeFlav )) ) )
	return didAssignChallenge
}
#endif


#if SERVER
void function TakeChallengeFromPlayer( entity player, ItemFlavor challengeFlav, string context )
{
	PlayerChallengesState pcs = GetPlayerChallengesState( player )
	Assert( challengeFlav in pcs.challengeStateMap, format( "Tried to take challenge %s from player but it wasn't assigned", string(ItemFlavor_GetAsset( challengeFlav )) ) )

	if ( !Challenge_IsAssigned( player, challengeFlav ) )
		return

	PIN_Challenge( player, ItemFlavor_GetHumanReadableRef( challengeFlav ), "taken", context )

	if ( Challenge_GetTimeSpanKind( challengeFlav ) != eChallengeTimeSpanKind.DAILY )
		Newness_MarkItemFlavorGUIDAsNotNewForPlayer( player, ItemFlavor_GetGUID( challengeFlav ) )

	ChallengeState cs = pcs.challengeStateMap[challengeFlav]

	#if CHALLENGE_DEBUG
		ChallengeDbg( player, "Taking challenge",
			"idx", cs.persistenceIdx,
			"flav", string(ItemFlavor_GetAsset( challengeFlav )),
			"currentTier", Challenge_GetCurrentTier( player, challengeFlav ),
			"statMarker", player.GetPersistentVarAsInt( "challenges[" + cs.persistenceIdx + "].statMarker" ),
			"statMarkerAlt", player.GetPersistentVarAsInt( "challenges[" + cs.persistenceIdx + "].statMarkerAlt" ),
			"context", context)
	#endif

	delete pcs.challengeStateMap[challengeFlav]
	pcs.persistentArrayMirror[cs.persistenceIdx] = null

	player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].guid", 0 )
	player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarker", 0 )
	player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarkerAlt", 0 )
	player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].currentTier", 0 )

	cs.persistenceIdx = -1
	ItemFlavor badItemFlav
	cs.flav = badItemFlav
}
#endif


#if SERVER && DEVELOPER
void function ResetAllChallengeProgress( entity player )
{
	PlayerChallengesState pcs = GetPlayerChallengesState( player )
	foreach ( ItemFlavor challengeFlav, ChallengeState cs in pcs.challengeStateMap )
	{
		array<string> statRefs = Challenge_GetStatRefs( cs.flav, 0 )
		int markerValue        = 0
		foreach ( string statRef in statRefs )
		{
			StatEntry statEntry = GetStatEntryByRef( statRef )
			markerValue += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
		}

		player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarker", markerValue )

		statRefs    = Challenge_GetStatRefs( cs.flav, 0, true )
		markerValue = 0
		foreach ( string statRef in statRefs )
		{
			StatEntry statEntry = GetStatEntryByRef( statRef )
			markerValue += GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )
		}
		player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarkerAlt", markerValue )

		player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].currentTier", 0 )
	}

	QueueChallengeDataDidChange( player )
}
#endif


#if SERVER && DEVELOPER
void function RandomizeAllChallengeProgress( entity player )
{
	// thread it off and added WaitFrame() to fix for remote calls crashing if we do too many of them in one frame.
	thread function() : (player)
	{
		EndSignal( player, "OnDestroy" )

		OnThreadEnd( function() : (player)
		{
			printt( "All Challenges Randomzied" )
		} )

		PlayerChallengesState pcs = GetPlayerChallengesState( player )

		array<ChallengeState ornull> persistentArrayMirror = clone pcs.persistentArrayMirror
		persistentArrayMirror.randomize()

		foreach ( int persistentArrayIdx, ChallengeState ornull cs in persistentArrayMirror )
		{
			if ( persistentArrayIdx > 30 )
				break

			if ( cs == null )
				continue
			expect ChallengeState(cs)

			// Tier
			int tier = RandomInt( Challenge_GetTierCount( cs.flav ) )
			player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].currentTier", tier )

			// Value
			player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarker", 0 )
			array<string> statRefs = Challenge_GetStatRefs( cs.flav, 0 )

			foreach ( int i, string statRef in statRefs )
			{
				StatEntry statEntry = GetStatEntryByRef( statRef )
				int newValue        = (i == 0) ? RandomIntRange( 0, Challenge_GetGoalVal( cs.flav, tier ) ) : 0
				__SetStat_Int( player, statEntry, newValue, true )
			}

			if ( Challenge_IsEitherOr( cs.flav ) )
			{
				bool useAlt = true
				player.SetPersistentVar( "challenges[" + cs.persistenceIdx + "].statMarkerAlt", 0 )
				statRefs.clear()
				statRefs = Challenge_GetStatRefs( cs.flav, 0, useAlt )

				foreach ( int i, string statRef in statRefs )
				{
					StatEntry statEntry = GetStatEntryByRef( statRef )
					int newValue        = (i == 0) ? RandomIntRange( 0, Challenge_GetGoalVal( cs.flav, tier, useAlt ) ) : 0
					__SetStat_Int( player, statEntry, newValue, true )
				}
			}
		}

		QueueChallengeDataDidChange( player )
	}()
}
#endif


#if SERVER && DEVELOPER
void function AddProgressToChallengeByRef( entity player, string ref, float progressFrac = 0.4 )
{
	if ( ref == "" )
		return
	ItemFlavor challengeFlav = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( ref ) )
	Assert( ItemFlavor_GetType( challengeFlav ) == eItemType.challenge )

	if ( !Challenge_IsAssigned( player, challengeFlav ) )
	{
		Warning( "player do not have the challenge. " + ref )
		return
	}

	int activeTier  = Challenge_GetCurrentTier( player, challengeFlav )
	int progressVal = Challenge_GetProgressValue( player, challengeFlav, activeTier )
	int goalVal     = Challenge_GetGoalVal( challengeFlav, activeTier )

	int additionalProgress = int( ceil( float( goalVal ) * progressFrac ) )

	array<string> statRefs = Challenge_GetStatRefs( challengeFlav, 0 )
	bool isDevManualIncrement = true
	foreach ( int i, string statRef in statRefs )
	{
		StatEntry statEntry = GetStatEntryByRef( statRef )
		__IncrementStat_Int( player, statEntry, additionalProgress, isDevManualIncrement )
	}

	if ( Challenge_IsEitherOr( challengeFlav ) )
	{
		bool useAlt = true
		progressVal = Challenge_GetProgressValue( player, challengeFlav, activeTier, useAlt )
		goalVal     = Challenge_GetGoalVal( challengeFlav, activeTier, useAlt )

		additionalProgress = int( ceil( float( goalVal ) * progressFrac ) )

		statRefs.clear()
		statRefs = Challenge_GetStatRefs( challengeFlav, 0, useAlt )
		foreach ( int i, string statRef in statRefs )
		{
			StatEntry statEntry = GetStatEntryByRef( statRef )
			__IncrementStat_Int( player, statEntry, additionalProgress, isDevManualIncrement )
		}
	}

	QueueChallengeDataDidChange( player )
}

#endif


#if SERVER && DEVELOPER
void function TakeAllChallengesFromPlayer( entity player )
{
	PlayerChallengesState pcs = GetPlayerChallengesState( player )
	foreach ( int persistentArrayIdx, ChallengeState ornull cs in pcs.persistentArrayMirror )
	{
		if ( cs == null )
			continue
		expect ChallengeState(cs)

		TakeChallengeFromPlayer( player, cs.flav, "dev_take_all" )
	}

	Remote_CallFunction_NonReplay( player, "ServerToClient_AssignedChallengesDidChange" )
}
#endif


