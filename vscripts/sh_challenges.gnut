// eChallengeTimeSpanKind enum allong with AllChallengesMenu_UpdateCategories(..)
// controls which and how challenges are shown in the challenge menu.
global enum eChallengeTimeSpanKind
{
	BEGINNER,
	EVENTSHOP_DAILY_CHALLENGE, // daily challenges specifically tied to an event shop
	EVENTSHOP_EVENT_CHALLENGE, // event length challenges tied to an event shop
	DAILY,
	SEASON_WEEKLY,
	SEASON_WEEKLY_RECURRING,
	EVENT,
	EVENT_SPECIAL,
	EVENT_SPECIAL_2,
	EVENT_HIDDEN, // hidden challenge type that's ONLY to be used to grant badges via GRX
	REWARD_CAMPAIGN,
	MYTHIC,
	FAVORITE, // Category does not map to a Bakery setting -- KEEP THIS LAST
}

