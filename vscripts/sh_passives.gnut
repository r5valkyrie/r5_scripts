///////////////////
//// Internals ////
///////////////////
///////////////////
#if SERVER || CLIENT
void function CodeCallback_OnPassiveChanged( entity player, int passiveIdx )
{
	if ( !IsValid( player ) )
		return

	bool nowHasPassive  = player.HasPassive( passiveIdx )
	bool didHavePassive = !nowHasPassive // todo(dw): it's a llliieee

	foreach( callback in file.passiveChangedCallbackListMap[passiveIdx] )
		callback( player, passiveIdx, didHavePassive, nowHasPassive )
}
#endif



#if SERVER
void function Passives_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	if ( !IsAlive( attacker ) )
		return

	if ( !IsPilot( attacker ) )
		return

	if ( attacker == victim )
		return

}

void function Passives_OnPlayerAssist( entity assister, entity victim )
{
	if ( !IsAlive( assister ) )
		return

	if ( !IsPilot( assister ) )
		return

	if ( assister == victim )
		return
}

void function Passives_OnPlayerStartBleedout( entity player, entity attacker, var damageInfo )
{
	if ( PlayerHasPassive( player, ePassives.PAS_MIRAGE ) )
	{
		if ( PlayerCanUseDecoy( player ) ) //TODO: Wonderfully over the top death animations.
		{
			array<string> deathAnims = [ "mp_pt_medium_holo_overacted_death_kickup", "mp_pt_medium_holo_overacted_death_look" ]
			CreateHoloPilotDecoys( player, 1, deathAnims[RandomIntRange( 0, deathAnims.len() )] )
		}

		EnableCloak( player, GetMirageCloakDuration( player, MIRAGE_DOWNED_CLOAK_DURATION ) )
		                    
		if( player.HasPassive( ePassives.PAS_PAS_UPGRADE_ONE ) )
		{
			thread PassiveUpgrade_CloakedSpeedBoost_Thread( player )
		}
        
	}
}
#endif

#if SERVER
void function Passives_OnRespawnBeaconStartUse( entity beacon, entity player )
{
	if ( PlayerHasPassive( player, ePassives.PAS_MIRAGE ) && !AreAbilitiesSilenced( player ) )
	{
		thread MirageCloakThread( player )
	}
}

void function MirageCloakThread( entity player )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "PassiveMirage_StopCloakFromBeacon" )
	string id = EnableCloakForever( player )

	OnThreadEnd(
		function() : ( player, id )
		{
			DisableCloakForever( player, id )
		}
	)

	WaitForever()
}

void function Passives_OnRespawnBeaconStopUse( entity beacon, entity player )
{
	if ( PlayerHasPassive( player, ePassives.PAS_MIRAGE ) )
	{
		player.Signal( "PassiveMirage_StopCloakFromBeacon" )
	}
}

void function Passives_OnPlayerStartRes( entity medicPlayer, entity patientPlayer, vector animRefAngles, bool endCrouched )
{
	if ( PlayerHasPassive( medicPlayer, ePassives.PAS_MIRAGE ) && !AreAbilitiesSilenced( medicPlayer ) )
	{
		patientPlayer.Signal( "PassiveMirage_StartRes" )

		thread CloakBothPlayers( medicPlayer, patientPlayer, Bleedout_GetFirstAidTime( medicPlayer ), animRefAngles )
	}
}

void function CloakBothPlayers( entity medicPlayer, entity patientPlayer, float duration, vector animRefAngles )
{
	Assert( IsValid( patientPlayer ) )
	if ( !IsValid( patientPlayer ) )
		return

	medicPlayer.EndSignal( "BleedOut_OnStartDying" )
	medicPlayer.EndSignal( "OnDeath" )
	patientPlayer.EndSignal( "OnDeath" )
	patientPlayer.EndSignal( "PassiveMirage_StartRes" )

	string medicId = EnableCloakForever( medicPlayer )
	string patientId = EnableCloakForever( patientPlayer )

	OnThreadEnd(
		function() : ( medicPlayer, medicId, patientPlayer, patientId )
		{
			if ( IsValid( medicPlayer ) )
			{
				DisableCloakForever( medicPlayer, medicId, 0.5 )
			}
			if ( IsValid( patientPlayer ) )
			{
				DisableCloakForever( patientPlayer, patientId, 0.5 )
			}
		}
	)

	WaitSignal( patientPlayer, "BleedOut_OnRevive", "BleedOut_OnReviveStop" )
}

                     
void function ReviveCloak( entity medicPlayer, entity patientPlayer )
{
	if( !IsValid( medicPlayer ) || !IsValid( patientPlayer ) )
		return

                     
	bool patientIsMirage = PlayerHasPassive( patientPlayer, ePassives.PAS_MIRAGE )
	if ( ( PlayerHasPassive( medicPlayer, ePassives.PAS_MIRAGE ) && !AreAbilitiesSilenced( medicPlayer ) ) || patientIsMirage )
      
                                                                                                     
       
	{
		                    
		if( !patientIsMirage )
        
			EnableCloak( medicPlayer, GetMirageCloakDuration( medicPlayer, MIRAGE_REVIVE_CLOAK_DURATION ), 0.0 )
			EnableCloak( patientPlayer, GetMirageCloakDuration( patientPlayer, MIRAGE_REVIVE_CLOAK_DURATION ), 0.0 )

		                    
			if( medicPlayer.HasPassive( ePassives.PAS_PAS_UPGRADE_ONE ) )
			{
				thread PassiveUpgrade_CloakedSpeedBoost_Thread( medicPlayer )
			}
			if( patientIsMirage && patientPlayer.HasPassive( ePassives.PAS_PAS_UPGRADE_ONE ) )
			{
				thread PassiveUpgrade_CloakedSpeedBoost_Thread( patientPlayer )
			}
        

		                    
		if( !patientIsMirage )
        
			Remote_CallFunction_Replay( medicPlayer, "ServerToClient_ShowCloakHintText" )

		if( patientPlayer.IsPlayer() )
			Remote_CallFunction_Replay( patientPlayer, "ServerToClient_ShowCloakHintText" )

		                    
		if( !patientIsMirage )
        
			thread DisarmOnCloak( medicPlayer )

		if( patientPlayer.IsPlayer() )
			thread DisarmOnCloak( patientPlayer )
	}
}

                    
void function PassiveUpgrade_CloakedSpeedBoost_Thread( entity player )
{
	int speedHandle = StatusEffect_AddEndless( player, eStatusEffect.speed_boost, UPGRADE_MIRAGE_CLOAK_SPEED_BOOST_AMNT )

	OnThreadEnd(
		function() : ( player, speedHandle )
		{
			if ( IsValid( player ) )
			{
				StatusEffect_Stop( player, speedHandle )
			}
		}
	)

	while( IsValid( player) )
	{
		if( !player.IsCloaked( true ) )
			return

		WaitFrame()
	}
}
      

void function DisarmOnCloak( entity player )
{
	if( !IsValid( player ) )
		return

	entity playerWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
	if( IsValid(  playerWeapon ) )
		Warning("Native func FastHolster() missing")
		//playerWeapon.FastHolster()

	// Swap to unarmed
	if( IsValid( player ) )
		player.SetActiveWeaponBySlot(eActiveInventorySlot.mainHand, WEAPON_INVENTORY_SLOT_PRIMARY_2 )
}
                           

void function Passives_OnPlayerDeathboxOpened( entity player )
{
	if ( PlayerHasPassive( player, ePassives.PAS_MIRAGE ) && !AreAbilitiesSilenced( player ) )
	{
		thread CloakWhileInDeathbox( player )
	}
}

void function CloakWhileInDeathbox( entity player )
{
	player.EndSignal( "OnDeath" )

	string id = EnableCloakForever( player )

	OnThreadEnd(
		function() : ( player, id )
		{
			if ( IsValid( player ) )
			{
				DisableCloakForever( player, id, 0.5 )
			}
		}
	)

	WaitFrame()

	while ( player.IsInventoryOpen() )
		WaitFrame()
}
#endif

#if CLIENT
                     
void function ServerToClient_ShowCloakHintText()
{
	entity player = GetLocalViewPlayer()

	if (IsValid(player))
	{
		AnnouncementMessageRight( player, "#CLOAK_UNARMED_WARNING" )
	}
}
                           
#endif // CLIENT

#if SERVER
bool function IsDroppingWithSquad( entity player )
{
	if( player.GetPlayerNetBool( "isJumpingWithSquad" ) )
		return ( player.GetPlayerNetEnt( "skydiveFollowPlayer" ) != null || player.GetPlayerNetBool( "isJumpmaster" ) )

	if( player.GetPlayerNetEnt( "skydiveFollowPlayer" ) != null )
		return true

	return false
}

void function AttemptDecoyDrop( entity player )
{
	//Some small timing issues with the start of skydive.
	//if ( player.GetVelocity().z > 0 ) //Some small timing issues with the start of skydive.
	//	return
	//
	//float absVelocity = fabs( player.GetVelocity().z )
	//if ( absVelocity > 1000 )
	//	return

	if ( !player.Player_IsSkydiving() )
		return

	if ( player.p.skydiveDecoysFired < 2 )
	{
		if ( GetCurrentPlaylistVarBool( "mirage_skydive_decoy_full_team", true ) && IsDroppingWithSquad( player ) )
		{
			foreach ( teammate in GetPlayerArrayOfTeam( player.GetTeam() ) )
			{
				if ( teammate.Player_IsSkydiving() && ( IsDroppingWithSquad( teammate ) || player.GetPlayerNetEnt( "skydiveFollowPlayer" ) == teammate ) )
				{
					thread DecoyDropThink( player, teammate )
					thread DecoyDropThink( player, teammate, true )
				}
			}
		}
		else
		{
			thread DecoyDropThink( player, player )
			thread DecoyDropThink( player, player, true )
		}

		player.p.skydiveDecoysFired++
		if ( player.p.skydiveDecoysFired == 2 )
			Remote_CallFunction_NonReplay( player, "ServerCallback_Mirage_DecoysDeployed", true )
	}
}
#endif


#if SERVER
void function DecoyDropThink( entity sender, entity player, bool usePredictedPos = false )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )

	vector playerOrigin      = player.GetOrigin()
	vector viewVector        = AnglesToForward( sender.CameraAngles() )
	vector predictedPosition = ClampToWorldspace( playerOrigin + player.GetVelocity() * Clamp( player.GetGameAverageLatency(), 0.0, 1.0 ) )
	if ( usePredictedPos )
	{
		TraceResults traceResults = TraceLine( playerOrigin, predictedPosition, [player], TRACE_MASK_SHOT, TRACE_COLLISION_GROUP_NONE )
		predictedPosition = traceResults.endPos
	}
	float startingYaw = FlattenAngles( VectorToAngles( viewVector ) ).y
	vector moverPos   = usePredictedPos ? predictedPosition : playerOrigin
	entity mover      = CreateScriptMover( MIRAGE_DECOY_DROP_MOVER_SCRIPTNAME, moverPos, <0, startingYaw, 0> )
	mover.SetAbsAngles( <0, startingYaw, 0> )

	entity characterModel = CreatePropDynamic( player.GetModelName(), mover.GetOrigin(), mover.GetAngles() )
	characterModel.SetScriptName( MIRAGE_DECOY_DROP_SCRIPTNAME )
	characterModel.SetParent( mover, "", false )
	characterModel.NotSolid()
	SetTeam( characterModel, player.GetTeam() )
	Survival_SetFriendlyOwnerHighlight( player, characterModel )
	characterModel.Anim_PlayOnly( "ACT_MP_FREEFALL" )
	int forwardPoseID = characterModel.LookupPoseParameterIndex( "freefall_pitch" )
	//int sidePoseID = characterModel.LookupPoseParameterIndex( "freefall_yaw" )
	characterModel.SetPoseParameterOverTime( forwardPoseID, 100, 0.5 )
	characterModel.SetOwner( player )
	characterModel.kv.fadeDist = 20000
	//characterModel.SetPoseParameterOverTime( sidePoseID, 50, 0.3 )
	if ( usePredictedPos )
	{
		characterModel.kv.VisibilityFlags = ENTITY_VISIBLE_TO_OWNER
	}
	else
	{
		characterModel.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY | ENTITY_VISIBLE_TO_ENEMY
	}

	int friendlyTeam = characterModel.GetTeam()
	//EmitSoundOnEntityToTeam( characterModel, "holopilot_loop", friendlyTeam ) //loopingSound
	//EmitSoundOnEntityToEnemies( characterModel, "holopilot_loop_enemy", friendlyTeam ) ///loopingSound
	Highlight_SetFriendlyHighlight( characterModel, HIGHLIGHT_FRIENDLY_PLAYER_DECOY )
	Highlight_SetOwnedHighlight( characterModel, HIGHLIGHT_FRIENDLY_PLAYER_DECOY )
	Highlight_SetEnemyHighlight( characterModel, "survival_enemy_skydiving" )
	SetDefaultMPEnemyHighlight( characterModel )

	array<entity> fxArray
	int attachID            = characterModel.LookupAttachment( "CHESTFOCUS" )
	entity holoPilotTrailFX = StartParticleEffectOnEntity_ReturnEntity( characterModel, HOLO_PILOT_TRAIL_FX, FX_PATTACH_POINT_FOLLOW, attachID )
	SetTeam( holoPilotTrailFX, friendlyTeam )
	holoPilotTrailFX.SetOwner( player )
	if ( usePredictedPos )
	{
		holoPilotTrailFX.kv.VisibilityFlags = ENTITY_VISIBLE_TO_OWNER
	}
	else
	{
		holoPilotTrailFX.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY
	}

	fxArray.append( holoPilotTrailFX )


	SkyDiveTrailPackage diveTrailPackage         = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
	array<SkyDiveTrailFXStruct> smokeColorTrails = diveTrailPackage.smokeColorFX
	vector smokeColor

	if ( !usePredictedPos )
	{
		foreach ( fxStruct in smokeColorTrails )
		{
			entity smokeFX_enemy = StartParticleEffectOnEntityWithPos_ReturnEntity( characterModel, GetParticleSystemIndex( fxStruct.fx ), fxStruct.attachType, attachID, <0, 0, 0>, VectorToAngles( <0, 0, -1> ) )

			if ( fxStruct.useSkyDiveSmokeColorForTeam )
				smokeColor = GetSkydiveSmokeColorForTeam( player.GetTeam() )
			else
				smokeColor = fxStruct.controlPoint

			EffectSetControlPointVector( smokeFX_enemy, 1, smokeColor * 0.7 )
			SetTeam( smokeFX_enemy, player.GetTeam() )
			smokeFX_enemy.kv.VisibilityFlags = ENTITY_VISIBLE_TO_ENEMY
			fxArray.append( smokeFX_enemy )
		}
	}

	foreach ( fxStruct in smokeColorTrails )
	{
		entity smokeFX_friendly = StartParticleEffectOnEntityWithPos_ReturnEntity( characterModel, GetParticleSystemIndex( fxStruct.fx ), fxStruct.attachType, attachID, <0, 0, 0>, VectorToAngles( <0, 0, -1> ) )

		if ( fxStruct.useSkyDiveSmokeColorForTeam )
			smokeColor = GetSkydiveSmokeColorForTeam( player.GetTeam() )
		else
			smokeColor = fxStruct.controlPoint

		EffectSetControlPointVector( smokeFX_friendly, 1, smokeColor )
		SetTeam( smokeFX_friendly, player.GetTeam() )
		smokeFX_friendly.SetOwner( player )
		if ( usePredictedPos )
		{
			smokeFX_friendly.kv.VisibilityFlags = ENTITY_VISIBLE_TO_OWNER
		}
		else
		{
			smokeFX_friendly.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY
		}
		fxArray.append( smokeFX_friendly )
	}

	//#################
	//EmitSoundOnEntity( characterModel, "Survival_DropSequence_Travel_3P" )

	OnThreadEnd(
		function() : ( characterModel, mover, fxArray )
		{
			foreach( fx in fxArray )
			{
				if ( IsValid( fx ) )
					fx.Destroy()
				if ( IsValid( characterModel ) )
					characterModel.Destroy()
				if ( IsValid( mover ) )
					mover.Destroy()
			}
		}
	)

	vector dir               = viewVector * player.GetVelocity().Length()
	vector oldVelocity       = <dir.x, dir.y, player.GetVelocity().z >
	array<entity> ignoreEnts = [ characterModel, mover ]
	ignoreEnts.extend( GetPlayerArray() )
	vector mins     = <-64, -64, -64>
	vector maxs     = <64, 64, 64>
	vector traceEnd = mover.GetOrigin() + (Normalize( oldVelocity ) * 64000)

	TraceResults result         = TraceHull( mover.GetOrigin(), traceEnd, mins, maxs, ignoreEnts, TRACE_MASK_PLAYERSOLID_BRUSHONLY, TRACE_COLLISION_GROUP_PLAYER )
	float distanceFromCollision = Distance( mover.GetOrigin(), result.endPos )
	float waitTime = 25.0
	float velocityMag = sqrt( oldVelocity.x * oldVelocity.x + oldVelocity.y * oldVelocity.y + oldVelocity.z * oldVelocity.z )
	if ( velocityMag > 0 )
		waitTime = distanceFromCollision / velocityMag

	waitTime = min( waitTime, 25.0 )
	mover.NonPhysicsMoveTo( result.endPos, waitTime + 0.5, 0, min( waitTime + 0.49, 2.0 ) ) //Adding time so the holopilot is killed before colliding with the ground.
	vector tranceAngles = VectorToAngles( result.endPos - mover.GetOrigin() )
	mover.NonPhysicsRotate( <0, FlattenAngles( tranceAngles ).y, 0>, 0.0 ) //Yaw instant
	mover.NonPhysicsRotateTo( tranceAngles, 0.5, 0.1, 0.1 ) //Pitch over time

	float endTime          = Time() + waitTime
	bool anticipateLanding = false
	while ( !anticipateLanding && Time() < endTime )
	{
		distanceFromCollision = Distance( mover.GetOrigin(), result.endPos )
		if ( distanceFromCollision <= SKYDIVE_SLOWDOWN_DIST_FROM_GROUND )
		{
			characterModel.Anim_PlayOnly( "ACT_MP_FREEFALL_ANTICIPATE" )
			anticipateLanding = true
		}
		wait 0.1
	}

	wait endTime - Time()
}

void function Lifeline_PassiveToggle( entity player, int passive, bool didHave, bool nowHas )
{
	//We only want to update during character selection. Death or disconnect shouldn't impact teammate's backpack space.
	if ( !IsAlive( player ) )
		return

	if ( didHave )
	{
		TakeExtraWeaponMod( player, "quick_heal" )
	}

	if ( nowHas )
	{
		GiveExtraWeaponMod( player, "quick_heal" )
	}
}

void function PassiveToggleFastHeal( entity player, int passive, bool didHave, bool nowHas )
{
	if ( !IsAlive( player ) )
		return

	if ( didHave )
	{
		TakeExtraWeaponMod( player, "fast_heal" )
		if ( InDomeShield( player ) )
			GiveExtraWeaponMod( player, "quick_heal" )
	}

	if ( nowHas )
	{
		if ( player.GetExtraWeaponMods().contains( "quick_heal" ) )
			TakeExtraWeaponMod( player, "quick_heal" )
		GiveExtraWeaponMod( player, "fast_heal" )
	}
}

void function EnableQuickHeal( entity player )
{
	if ( player.p.quickHealEnableCount == 0 )
	{
		GiveExtraWeaponMod( player, "quick_heal" )
	}

	player.p.quickHealEnableCount++
}

void function DisableQuickHeal( entity player )
{
	player.p.quickHealEnableCount--
	Assert( player.p.quickHealEnableCount >= 0, "< 0 can cause bugs" )
	if ( player.p.quickHealEnableCount == 0 )
		TakeExtraWeaponMod( player, "quick_heal" )
}


#endif

              
          
                                                                                           
 
                
    
                                                                        
    
 
      
      

#if SERVER
void function Revenant_PassiveToggle( entity player, int passive, bool didHave, bool nowHas )
{
	if ( !IsValid( player ) )
		return

	if ( !Bleedout_IsBleedingOut( player ) )
		return

	if ( nowHas )
	{
		GivePlayerSettingsMods( player, [ "revenant_bleedout" ] )
	}

	else if ( didHave )
	{
		TakePlayerSettingsMods( player, [ "revenant_bleedout" ] )
	}
}

void function Revenant_BleedoutBegin( entity player, entity attacker, var damageInfo )
{
	if ( !PlayerHasPassive( player, ePassives.PAS_DEATHSTALKER ) )
		return

	GivePlayerSettingsMods( player, [ "revenant_bleedout" ] )
}

void function Revenant_BleedoutEnd( entity player )
{
	if ( !PlayerHasPassive( player, ePassives.PAS_DEATHSTALKER ) )
		return

	TakePlayerSettingsMods( player, [ "revenant_bleedout" ] )
}
#endif //HAS_SERVER

