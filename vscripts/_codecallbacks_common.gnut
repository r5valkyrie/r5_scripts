void function PrintDebugClientCommand( entity player, array<string> args )
{
	printl( "############################" )
	printl( "CodeCallback_ClientCommand() before" )
	printl( "player = " + player )
	printl( "args:" )
	foreach ( key, value in args )
		printl( key + " : " + value )
	printl( "############################" )
}

var function CodeCallback_ClientCommand( entity player, array<string> args )
{
	// returned bool means if a function hook has been found / not
	// nothing to do with error propagation
	PrintDebugClientCommand( player, args )

	if ( !player.hasConnected )
		return false

	string commandString = args.remove( 0 )

	if ( commandString in svGlobal.clientCommandCallbacks  )
	{
		printt( "CodeCallback_ClientCommand: running registered command", commandString )
		svGlobal.clientCommandCallbacks[commandString]( player, args )
		return true
	}

	printt( "ALERT:", commandString, "isn't a registered client command but was forwarded to CodeCallback_ClientCommand." )
	return false
}

// called by code when an animation does { event AE_SV_VSCRIPT_CALLBACK FrameNumber "some string" }
// and by a script function OnFootstep, apparently.
void function CodeCallback_OnServerAnimEvent( entity ent, string eventName )
{
	PerfStart( PerfIndexServer.CB_OnServerAnimEvent )
	if ( HasAnimEvent( ent, eventName ) )
		thread RunAnimEventCallbacks( ent, eventName )

	// couldn't find this eventName on the ent or the global anim events,
	// so try breaking it down. If we didn't find it, it means
	// script needs to handle the event, even if it is just to
	// do nothing with it

	array<string> tokens = split( eventName, ":" )
	string tokenName = tokens[0]

	if ( HasAnimEventTokenized( ent, tokenName ) )
		thread RunAnimEventTokenizedCallbacks( ent, tokenName, tokens )

	if ( tokenName in svGlobal.globalAnimEventTokenizeCallbacks )
	{
		thread svGlobal.globalAnimEventTokenizeCallbacks[ tokenName ]( ent, tokens )
		PerfEnd( PerfIndexServer.CB_OnServerAnimEvent )
		return
	}

	if ( tokenName in svGlobal.globalAnimEventCallbacks )
	{
		thread svGlobal.globalAnimEventCallbacks[ tokenName ]( ent )
		PerfEnd( PerfIndexServer.CB_OnServerAnimEvent )
		return
	}

	switch ( tokenName )
	{
		case "worldsound":
			GlobalAnimEventWithStringParameter_WorldSound( ent, tokens[1] )
			break

		case "signal":
			SendSignalFromTokens( ent, tokens )
			break

		case "flagset":
			GlobalAnimEventWithStringParameter_FlagSet( ent, tokens[1] )
			break

		case "cloak_start":
			GlobalAnimEventWithStringParameter_CloakStart( ent, tokens[1] )
			break

		case "dialogue":
			PlayDialogueForAnimEvent( ent, tokens[1] )
			break

		case "rampart_turret_spin_up":
		case "rampart_turret_button_press":
			OnAnimEvent_weapon_mounted_turret_weapon( ent, tokenName )
			break
		case "rampart_turret_mobile_spin_up":
		case "rampart_turret_mobile_button_press":
			OnAnimEvent_weapon_mobile_hmg( ent, tokenName )
			break
		                   
		case "loot_marvin_dispense_loot":
			LootMarvin_OnDispenseLootAnimEvent( ent )
			break
        

		case "catalyst_spike_strip_idle_3p_fx":
			Warning("catalyst_spike_strip_idle_3p_fx missing, implement!")
			//SpikeStrip_Start3PIdleFXAnimEvent( ent )
			break

		case "spawn_prop_in_world":
			//Emote_AnimEvent_SpawnModelInWorld( ent, tokens[1], tokens[2] )
			Warning("Emote_AnimEvent_SpawnModelInWorld missing, implement!")
			break

		case "spawn_spray_in_world":
			//Emote_AnimEvent_SpawnSprayInWorld( ent, tokens[1], tokens[2], tokens[3] )
			Warning("Emote_AnimEvent_SpawnSprayInWorld missing, implement!")
			break

		case "ammo_swap_reload_complete":
			OnAnimEvent_weapon_car_ammo_swap_complete(ent)
			break
	}

	PerfEnd( PerfIndexServer.CB_OnServerAnimEvent )
}

void function CodeCallback_OnPush( entity pusher, entity pushedEntity, vector pushVel, vector pushAmount, bool standingOnPusher )
{
	// use AddCallback_OnPush( ent, callbackFunc ) to add a on push callback function
	foreach ( callbackFunc in pusher.e.onPushCallbacks )
	{
		callbackFunc( pusher, pushedEntity, pushVel, pushAmount, standingOnPusher )
	}
}

void function AddCallback_OnPush( entity ent, void functionref( entity, entity, vector, vector, bool ) callbackFunc )
{
	Assert( !ent.e.onPushCallbacks.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " to entity" )

	ent.e.onPushCallbacks.append( callbackFunc )
}

void function CodeCallback_OnWouldOtherwiseCrushEntity( entity crusher, entity pushedEntity )
{
	foreach ( callbackFunc in crusher.e.onWouldOtherwiseCrushEntity )
	{
		callbackFunc( crusher, pushedEntity )
	}
}

void function AddCallback_OnWouldOtherwiseCrushEntity( entity ent, void functionref( entity, entity ) callbackFunc )
{
	Assert( !ent.e.onWouldOtherwiseCrushEntity.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " to entity" )

	ent.e.onWouldOtherwiseCrushEntity.append( callbackFunc )
}

bool function CodeCallback_OnEntityBeingCrushed( entity crusher, entity pushedEntity )
{
	bool doCrush = true
	
	foreach ( shouldDoCrushCallbackFunc in pushedEntity.e.onEntityBeingCrushed )
	{
		if ( !shouldDoCrushCallbackFunc( crusher, pushedEntity ) )
		{
			doCrush = false
			break
		}
	}

	return doCrush
}

void function AddCallback_OnEntityBeingCrushed( entity ent, bool functionref( entity, entity ) callbackFunc )
{
	Assert( !ent.e.onEntityBeingCrushed.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " to entity" )

	ent.e.onEntityBeingCrushed.append( callbackFunc )
}

//Safe push mode will pause playing the pushing animation if it would hit an entity (think sliding doors that will pause doing their slide close animation when the door would hit a player)
bool function CodeCallback_ShouldIgnoreSafePushMode( entity animatingEnt, entity pushedEnt )
{
	if ( !IsValid( animatingEnt ) || !IsValid( pushedEnt ) )
		return false


	if ( pushedEnt.e.ignoreSafePushMode )
		return true

	return false
}
