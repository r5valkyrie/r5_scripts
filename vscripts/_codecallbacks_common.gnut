array<void functionref( table<string, string> kvs )> s_onScriptOnlyEntPreSpawnCallbacks
void function AddCallback_OnScriptOnlyEntPreSpawn( void functionref( table<string, string> kvs ) func )
{
	Assert( !s_onScriptOnlyEntPreSpawnCallbacks.contains( func ) )
	s_onScriptOnlyEntPreSpawnCallbacks.append( func )
}

const bool SCRIPTONLY_ENTS_WILL_NOT_SPAWN_NORMALLY = true
bool function CodeCallback_OnScriptOnlyEntPreSpawn( table<string, string> kvs )
{
	const bool BE_VERBOSE = false
	if ( BE_VERBOSE )
	{
		printf( "%s() - %s", FUNC_NAME(), string( kvs ) )
		foreach( k,v in kvs )
			printf( " [%s] <- '%s'", k, v )
		printf( "" )
	}

	foreach( func in s_onScriptOnlyEntPreSpawnCallbacks )
		func( kvs )

	return SCRIPTONLY_ENTS_WILL_NOT_SPAWN_NORMALLY
}

string function KVGet_ValString( table<string, string> kvs, string keyName )
{
	if ( !(keyName in kvs) )
		return ""
	return kvs[keyName]
}
float function KVGet_ValFloat( table<string, string> kvs, string keyName, float defaultVal = 0.0 )
{
	if ( !(keyName in kvs) )
		return defaultVal
	return float( kvs[keyName] )
}

int function KVGet_ValInt( table<string, string> kvs, string keyName, int defaultVal = -1 )
{
	if ( !(keyName in kvs) )
		return defaultVal
	return int( kvs[keyName] )
}

bool function KVGet_ValBool( table<string, string> kvs, string keyName, bool defaultVal = false )
{
	if ( !(keyName in kvs) )
		return defaultVal
	return bool( int( kvs[keyName] ) )
}


vector function KVGet_ValVector( table<string, string> kvs, string keyName, vector defaultVal = <0.0, 0.0, 0.0> )
{
	if ( !(keyName in kvs) )
		return defaultVal
	return StringToVector( kvs[keyName] )
}

vector function KVGet_Origin( table<string, string> kvs )
{
	return KVGet_ValVector( kvs, "origin" )
}
vector function KVGet_Angles( table<string, string> kvs )
{
	return KVGet_ValVector( kvs, "angles" )
}
asset function KVGet_Model( table<string, string> kvs )
{
	if ( !("model" in kvs) )
		return $""
	return GetKeyValueAsAsset( kvs, "model" )
}
string function KVGet_ClassName( table<string, string> kvs )
{
	return KVGet_ValString( kvs, "classname" )
}
string function KVGet_EditorClass( table<string, string> kvs )
