	file.classHeadshotCallbacks[className].fastremovebyvalue( callbackFunc )
}

void function RunClassHeadshotCallbacks( entity ent, var damageInfo )
{
	string className = ent.GetClassName()
	if ( !(className in file.classHeadshotCallbacks) )
		return

	foreach ( callbackFunc in file.classHeadshotCallbacks[className] )
	{
		callbackFunc( ent, damageInfo )
		DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
		if ( DamageInfo_GetDamage( damageInfo ) == 0 )
			return
	}
}

void function AddDamageFinalCallback( string className, void functionref( entity, var ) callbackFunc )
{
	if ( !( className in file.classDamageFinalCallbacks ) )
		file.classDamageFinalCallbacks[className] <- []

	Assert( !file.classDamageFinalCallbacks[className].contains( callbackFunc ), "Tried to add damage final callback that is already added" )
	file.classDamageFinalCallbacks[className].append( callbackFunc )
}

void function RunClassDamageFinalCallbacks( entity ent, var damageInfo )
{
	string className = ent.GetClassName()
	if ( !( className in file.classDamageFinalCallbacks ) )
		return

	if( !IsValid( ent ) )
		ForceScriptError( "Running damage callbacks on invalid entity.  ClassName = " + className )

	string entName = string( ent )
	foreach ( callbackFunc in file.classDamageFinalCallbacks[className] )
	{
		if ( DamageInfo_GetDamage( damageInfo ) == 0 ) // check each loop as callbacks could change the damageinfo or destroy ent
			return
		callbackFunc( ent, damageInfo )

		if( !IsValid( ent ) )
			ForceScriptError( "DamageFinalCallback '" + ShortenDamageCallbackName( string( callbackFunc ) ) + "' destroyed the damaged entity. Ent = " + entName + ", ClassName = " + className )

		DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
	}
}

void function AddPostDamageCallback( string className, void functionref( entity, var ) callbackFunc )
{
	if ( !( className in file.classPostDamageCallbacks ) )
		file.classPostDamageCallbacks[className] <- []

	Assert( !file.classPostDamageCallbacks[className].contains( callbackFunc ), "Tried to add post damage callback that is already added" )
	file.classPostDamageCallbacks[className].append( callbackFunc )
}

void function RunClassPostDamageCallbacks( entity ent, var damageInfo )
{
	string className = ent.GetClassName()
	if ( !( className in file.classPostDamageCallbacks ) )
		return

	foreach ( callbackFunc in file.classPostDamageCallbacks[className] )
	{
		#if DEVELOPER
		float damage = DamageInfo_GetDamage( damageInfo )
		#endif
		callbackFunc( ent, damageInfo )

		#if DEVELOPER
		Assert( damage == DamageInfo_GetDamage( damageInfo ), "Damage changed in a post damage callback" )
		#endif

		DamageInfo_Print( damageInfo, "cb " + ShortenDamageCallbackName( string( callbackFunc ) ) + " " + DamageInfo_GetDamage( damageInfo ) )
	}
}

