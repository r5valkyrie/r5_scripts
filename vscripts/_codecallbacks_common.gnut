void function CodeCallback_OnEntityHealResourceFinished( entity ent, int healAmount, string refName, entity sourceEnt )
{
	if ( refName != "regen_default" ) // JFS: no PIN event for octane since it could potentially spam ... http://10.65.4.186:8080/browse/R5DEV-71515
		PIN_OnPlayerHealed( ent, healAmount, refName, sourceEnt )

	if ( healAmount > 0 )
	{
		StatsHook_GenericPlayer_OnEntityHealResourceFinished( ent, healAmount )
		StatsHook_MedicDeployableDrone_OnEntityHealResourceFinished( ent, healAmount, refName, sourceEnt )
		StatsHook_OctaneHealthRegen_OnEntityHealResourceFinished( ent, healAmount, refName, sourceEnt )
	}
}

void function CodeCallback_OnObserverTargetChanged( entity observer, entity newTarget )
{
	// Added via AddCallback_OnPlayerObserverTargetChanged
	foreach ( callbackFunc in svGlobal.onPlayerObserverTargetChangedCallbacks )
	{
		callbackFunc( observer, newTarget )
	}
}

void function AddPlayerCallback_OnSpawned( entity player, void functionref(entity) func )
{
	player.p.playerSpawnedCallbacks.append( func )
}

void function RemovePlayerCallback_OnSpawned( entity player, void functionref(entity) func )
{
	player.p.playerSpawnedCallbacks.fastremovebyvalue( func )
}

void function CodeCallback_OnPlayerRealmChanged( entity ent )
{
	Assert( ent.IsPlayer(), "CodeCallback_OnPlayerRealmChanged only meant to be run on players." )

	for ( int i = 0; i < ent.p.realmLinkedEntities.len(); i++ )
	{
		entity realmLinkedEnt = ent.p.realmLinkedEntities[i]
		
		if ( IsValid( realmLinkedEnt ) )
		{
			//children will already be brought across realms
			if ( realmLinkedEnt.IsChild( ent ) )
				continue

			realmLinkedEnt.RemoveFromAllRealms()
			realmLinkedEnt.AddToOtherEntitysRealms( ent )
		}
		else
		{
			Warning( "Removing invalid ent from realmLinkedEntities for " + ent.GetPlayerName() + ", should probably be managed by whoever added it." )
			ent.p.realmLinkedEntities.fastremove( i )
			i--
		}
	}

	foreach ( callbackFunc in ent.p.playerOnRealmChangedCallbacks )
		callbackFunc( ent )
}

void function AddEntityCallback_OnPlayerRealmChanged( entity ent, void functionref(entity) callbackFunc )
{
	Assert( ent.IsPlayer(), "Can only add realm changed callback for players." )
	Assert( !ent.p.playerOnRealmChangedCallbacks.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with AddEntityCallback_OnRealmChanged" )

	ent.p.playerOnRealmChangedCallbacks.append( callbackFunc )
}

void function RemoveEntityCallback_OnPlayerRealmChanged( entity ent, void functionref(entity) callbackFunc )
{
	Assert( ent.IsPlayer(), "Can only add realm changed callback for players." )
	int index = ent.p.playerOnRealmChangedCallbacks.find( callbackFunc )

	Assert( index != -1, "RemoveEntityCallback_OnRealmChanged " + string( callbackFunc ) + " to be removed not found! " )
	ent.p.playerOnRealmChangedCallbacks.fastremove( index )
}

bool function CodeCallback_GetNPCCountForReactive( entity victim )
{
	if ( !victim.IsNPC() )
		return false

	if ( IsProwler( victim ) )
		return true

	if ( IsTrainingDummie( victim ) )
		return true

	//=== add other NPC types here ===

	return false
}