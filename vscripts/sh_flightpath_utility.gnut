#if SERVER || CLIENT
void function AddToAllowedAirdropDynamicEntities( entity ent )
{
	Assert( !file.airdropAllowedDynamicEnts.contains( ent ), "Entity already added to allowed airdrop dynamic ents!" )

	file.airdropAllowedDynamicEnts.append( ent )
}
#endif


#if SERVER && CLIENT
void function RemoveFromAllowedAirdropDynamicEntities( entity ent )
{
	Assert( file.airdropAllowedDynamicEnts.contains( ent ), "Entity not contained in allowed dynamic airdrop entities! Cannot remove from array." )

	file.airdropAllowedDynamicEnts.fastremovebyvalue( ent )
}
