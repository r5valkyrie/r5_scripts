global function Stats_IsValidMapForStats

#if SERVER
global function Stats_ShouldGatherBRStatsInModeForPlayer
global function Stats_ModeIsValidForBRStats
global function Stats_PlayerIsValidForStats

global function Stats_UpdateDistanceKillStatEntry
#endif // SERVER

global function Stats_CurrentModeSupportsCustomStats
global function Stats_CurrentModeIsSurvival

global function CalcStatSum_Int
global function FindMaxStat_Int

global function Stats_CountSetBitsInCharacterBitfield

bool function Stats_IsValidMapForStats()
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return false

	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
		return false

	if ( IsLobby() )
		return false

	return true
}

#if SERVER
bool function Stats_ShouldGatherBRStatsInModeForPlayer( entity player )
{
	Assert( IsValid( player ) && player.IsPlayer() )

	if ( !Stats_ModeIsValidForBRStats() )
		return false

	if ( !Stats_PlayerIsValidForStats( player ) )
		return false

	return true
}

bool function Stats_ModeIsValidForBRStats()
{
	if ( !GetCurrentPlaylistVarBool( "enable_stats", true ) )
		return false

	// if we want to disable BR-specific stats but keep player stats for abilities (for example)
	if ( GetCurrentPlaylistVarString( "stats_match_type", "survival" ) == STATS_MATCH_TYPE_NONE )
		return false

	if ( Stats_CurrentModeSupportsCustomStats() )
		return false

	                      
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
		return false
       

	                              
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
		return false
       

                  
                                                                           
              
       

	                        
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_EXPLORE ) )
			return false
       

	if ( IsSpawnOnSquadMode() )
		return false

	if ( IsPVEMode() )
		return false

	                            
		if ( IsOrientationMatch() )
			return false
       

	if ( IsLobby() || IsPrivateMatch() )
		return false

	return true
}

bool function Stats_PlayerIsValidForStats( entity player )
{
	Assert( player.IsPlayer(), "PlayerIsValidForStats should *only* be called for player entities." )

	if ( !GetCurrentPlaylistVarBool( "enable_stats", true ) )
		return false

	// TODO - R5DEV-413763: nesting this here as a temp fix
	if ( !Stats_IsValidMapForStats() )
		return false

	if ( IsPrivateMatch() )
		return false

	// todo(dw): optimize this to just return the state of a file-level flag
	if ( GameMode_IsActive( eGameModes.SURVIVAL ) && !Survival_HasPlayerJumpedOutOfPlane( player ) )
		return false

                            
	if ( IsOrientationMatch() )
		return false
      

	return true
}

void function Stats_UpdateDistanceKillStatEntry( entity player, StatEntry distanceKillStatEntry, int newDistance )
{
	int oldMaxDistance = GetStat_Int( player, distanceKillStatEntry, eStatGetWhen.CURRENT )
	if ( newDistance > oldMaxDistance )
		__SetStat_Int( player, distanceKillStatEntry, newDistance )
}
#endif

bool function Stats_CurrentModeSupportsCustomStats()
{
	string mode = ""

	#if UI
	if ( IsLobby() )
	{
		mode = GetPlaylistVarString( LobbyPlaylist_GetSelectedPlaylist(), "stats_match_type", "survival" )
	}
	else
	#endif
	{
		mode = GetCurrentPlaylistVarString( "stats_match_type", "survival" )
	}

	Assert( STATS_MATCH_TYPES.contains( mode ), "Invalid Playlist var stats_match_type " + mode )

	return ( STATS_ALTERNATE_MODE_REFS.contains( mode ) )
}

bool function Stats_CurrentModeIsSurvival()
{
	string mode = ""

	#if UI
	if ( IsLobby() )
		{
			mode = GetPlaylistVarString( LobbyPlaylist_GetSelectedPlaylist(), "pin_match_type", "survival" )
		}
	else
	#endif
	{
		mode = GetCurrentPlaylistVarString( "stats_match_type", "survival" )
	}

	return mode == "survival" || mode == "duo" || mode == "ranked"
}

int function CalcStatSum_Int( entity player, array<StatEntry> sourceEntries, int when )
{
	int sum = 0
	foreach ( StatEntry sourceEntry in sourceEntries )
		sum += GetStat_Int( player, sourceEntry, when )
	return sum
}

int function FindMaxStat_Int( entity player, array<StatEntry> sourceEntries, int when )
{
	int max = 0
	foreach ( StatEntry sourceEntry in sourceEntries )
	{
		int temp = GetStat_Int( player, sourceEntry, when )
		if ( temp > max )
			max = temp
	}
	return max
}

int function Stats_CountSetBitsInCharacterBitfield( int input )
{
	int count = 0

	// note: this is intended ONLY for use for bitfields that represent a list of characters in the context of statrefs
	// this may have unintended consequences if you try to use it for more generalized purposes!!

	// iterate through the known character bitmasks and check if the bit is set in the input
	foreach ( string guid, int characterBitmask in StatsDefs_GetCharacterGUIDToBitmaskMap() )
	{
		if ( IsBitFlagSet( input, characterBitmask ) )
		{
			count += 1
		}
	}

	return count
}