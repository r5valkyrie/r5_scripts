struct DialogueEntryGroup
{
	string     groupName
	array<int> aliasIds
	asset      sourceDataTable

	#if SERVER
		ShuffleData shuffleData
	#endif // SERVER
}


struct DialogueData
{
	string name
	string alias
	int    priority
	string perspective
	bool   canPlayIfSolo
	string radioDisplayName
	string voice
	bool   radioIntercept
	string dialogueText
	float  dialogueTextDuration
	asset  vduVideo

	DialogueEntryGroup& group
	int                 indexInGroup
}


global struct QueueItem
{
	int    priority
	int    entHandle = -1
	float  timeAdded = -1
	bool   active = false
	string milesAlias = ""
	bool   success = true
	int    serialNum = -1
	bool   shouldBlockLowerPriorityItems = false
	int	   groupID = -1 // Shared group ID = removed together
}

struct QueueData
{
	array<QueueItem> queue
	#if CLIENT
		string flagPauseQueue
		int    dialoguePauseStackCount = 0
		table  signalDummy
	#endif
}

const int QUEUE_MAIN = 0
// JFS quick + dirty. Incrementing this. More thorough fix for after 7.2 --> Custom queues starts at 1 and goes to num queues. All checks handle this (> goes to >=, etc)
const int NUM_CUSTOM_QUEUES = 6
global const int NUM_TOTAL_DIALOGUE_QUEUES = NUM_CUSTOM_QUEUES + 1

