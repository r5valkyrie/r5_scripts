//=============================================================================
// SNDC Callback Wrappers (TYPED file — correct functionref signatures)
//
// Each wrapper:
//   - Non-overflow vars: registers in BOTH engine + SDK systems
//   - Overflow vars: registers in SDK ONLY (engine doesn't know about them)
//=============================================================================

global function RegisterNetworkedVariableChangeCallback_boolSafe
global function RegisterNetworkedVariableChangeCallback_intSafe
global function RegisterNetworkedVariableChangeCallback_floatSafe
global function RegisterNetworkedVariableChangeCallback_timeSafe
global function RegisterNetworkedVariableChangeCallback_entSafe

#if CLIENT || UI

void function RegisterNetworkedVariableChangeCallback_boolSafe( string name, void functionref( entity, bool, bool, bool ) callback )
{
	if (!SDKIsOverflowVar(name))
		RegisterNetworkedVariableChangeCallback_bool( name, callback )
	SDKRegisterNetVarCallback_bool( name, callback )
}

void function RegisterNetworkedVariableChangeCallback_intSafe( string name, void functionref( entity, int, int, bool ) callback )
{
	if (!SDKIsOverflowVar(name))
		RegisterNetworkedVariableChangeCallback_int( name, callback )
	SDKRegisterNetVarCallback_int( name, callback )
}

void function RegisterNetworkedVariableChangeCallback_floatSafe( string name, void functionref( entity, float, float, bool ) callback )
{
	if (!SDKIsOverflowVar(name))
		RegisterNetworkedVariableChangeCallback_float( name, callback )
	SDKRegisterNetVarCallback_float( name, callback )
}

void function RegisterNetworkedVariableChangeCallback_timeSafe( string name, void functionref( entity, float, float, bool ) callback )
{
	if (!SDKIsOverflowVar(name))
		RegisterNetworkedVariableChangeCallback_time( name, callback )
	SDKRegisterNetVarCallback_time( name, callback )
}

void function RegisterNetworkedVariableChangeCallback_entSafe( string name, void functionref( entity, entity, entity, bool ) callback )
{
	if (!SDKIsOverflowVar(name))
		RegisterNetworkedVariableChangeCallback_ent( name, callback )
	SDKRegisterNetVarCallback_ent( name, callback )
}

#elseif SERVER

void function RegisterNetworkedVariableChangeCallback_boolSafe( string name, void functionref( entity, bool, bool, bool ) callback ) {}
void function RegisterNetworkedVariableChangeCallback_intSafe( string name, void functionref( entity, int, int, bool ) callback ) {}
void function RegisterNetworkedVariableChangeCallback_floatSafe( string name, void functionref( entity, float, float, bool ) callback ) {}
void function RegisterNetworkedVariableChangeCallback_timeSafe( string name, void functionref( entity, float, float, bool ) callback ) {}
void function RegisterNetworkedVariableChangeCallback_entSafe( string name, void functionref( entity, entity, entity, bool ) callback ) {}

#endif
