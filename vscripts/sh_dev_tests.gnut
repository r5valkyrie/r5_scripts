void function test_spawnallchargeweapons()
{
	array<string> weapons =
	[
		"mp_weapon_defender"
		"mp_weapon_energy_shotgun:hopup_energy_choke" // peacekeeper
		"mp_weapon_lstar" // for overheat test
		"mp_weapon_doubletake:hopup_energy_choke" // tripletake
		"mp_weapon_3030"
		"mp_weapon_sentinel"
		"health_pickup_combo_large"
		"mp_weapon_dragon_lmg"
		"mp_weapon_thermite_grenade"
	]

	entity human = test_gethuman()
	vector centerOrg = human.GetOrigin()
	vector spreadDir = FlattenVec( human.GetViewVector() )
	float spreadDist = 20

	foreach ( idx, entry in weapons )
	{
		array<string> tokens = split( entry, ":" )
		vector newOrg = centerOrg + (spreadDir * (spreadDist * idx))
		string weaponStr = tokens[0]
		tokens.fastremove(0)
		entity weapon = SpawnGenericLoot( weaponStr, newOrg, <-1, -1, -1>, 1 )
		if ( weapon && tokens.len() > 0 )
		{
			weapon.SetWeaponMods( tokens )
		}
	}
}

void function test_spectator( int numTeams = 2, bool humansTogether = true )
{
	thread test_spectator_thread( numTeams, humansTogether )
}

void function test_spectator_thread( int numTeams, bool humansTogether )
{
	// Setup the teams first - has to be a wait thread because bots take time to spawn
	waitthread test_teams_thread( numTeams, !humansTogether )

	// Make the first human a spectator and make sure everyone else on human's team has health
	entity firstPlayer = test_gethuman()
	int firstPlayerTeam = firstPlayer.GetTeam()

	array<entity> teamMembers = GetPlayerArrayOfTeam( firstPlayerTeam )
	foreach( entity player in teamMembers )
	{
		if ( player == firstPlayer )
			continue

		if ( player.GetHealth() == 0 )
		{
			player.SetHealth( player.GetMaxHealth() )
		}
	}

	KillPlayer( firstPlayer, eDamageSourceId.damagedef_suicide )
}

