void function test_help()
{
	// Keep in alphabetical order
	printt( "test_downedenemy( bleedoutTime ) - spawns/moves an enemy bot near you in downed state.  Global bleedout time can be overridden if you pass in a value > 0." )
	printt( "test_downedplayer( bleedoutTime, player = null ) - downs the player.  If no player specified, will down first human player. Global bleedout time can be overridden if you pass in a value > 0." )
	printt( "test_downedteammate( bleedoutTime ) - spawns/moves a bot on your team near you in downed state.  Global bleedout time can be overridden if you pass in a value > 0." )
	printt( "test_everybodyiscaustic() - custom test for caustic skinsh_ that turns everyone to caustic with the latest skin" )
	printt( "test_itemflavorsdump() - outputs to console and file the list of item flavors seen by the vm. Add a string to filter out results.  Look for file 'itemflavorsdump_'" )
	printt( "test_putplayerinsafespotformap() - runs some test points for the function with expected pass/fail.  See console for output." )
	printt( "test_setskinfxvisibility( true/false ) - enables/disables skin fx visibility - NOT WORKING" ) // TODO:JL this was a change on r5bc for testing caustic's pyro skin which is still in r5bc so this doesn't currently work
	printt( "test_spawnallchargeweapons() - drops all weapons with necessary attachments to do charge/overheat" )
	printt( "test_spawnnpc( aisetting_filename, name = \"\", isFriendly = false ) - attempts to spawn an npc in front of you with that aisetting on an enemyteam or your team" )
	printt( "test_spectator( int numTeams = 2, bool humansTogether = true ) - this will setup a scenario where the first human becomes a spectator" )
	printt( "test_stresstestpvs() - spawns enough bots to make 60 players and triggers their ults at the same time. If the game crashes, check the client log for all entities in the list and look for suspiciously high numbers." )
	printt( "test_teams( numteams = 2, humansSeparate = true, maxAngle = 70, distance = 300 ) - sets up teams and creates bots if it has to.  numTeams - number of total teams, humansSeparate - humans split on different teams, maxAngle - the furthest spread of teams, distance - distance from human player" )
	printt( "test_toomanymovers( player = null,  time = 0 ) - creates 25 movers in a grid around you, indicated by pink circles on the ground. Use to test animation issues, moving around them shouldn't trigger too many movers errors unless there is an issue with the animation that's currently playing. Ends after the duration or when test_toomanymovers_endtest is called" )
	printt( "test_toomanymovers_endtest( player = null ) - destroys all movers created by test_toomanymovers()" )
	printt( "test_trigger( enterCallback = null, leaveCallback = null, radius = 100, aboveHeight = 256, belowHeight = 16 ) - creates a trigger of a given radius in front of you and registers a callback for testing that will exist always. Note: callbacks must be global functions." )
}

entity function test_gethuman()
{
	// Find first human player
	array< entity > allPlayers = GetPlayerArray_Alive()
	foreach ( player in allPlayers )
	{
		// Find the first human one, assume it's you
		if ( player.IsBot() )
			continue
		return player
	}
	return null
}

void function test_downedplayer( float bleedoutTime = 0, entity player = null )
{
	if ( player == null )
		player = test_gethuman()

	if ( bleedoutTime > 0 ) // Note: A bleedout of 0 has the player actually remaining in bleedout forever
	{
		Bleedout_OverrideBleedoutTime( player, bleedoutTime )
	}
	int damageAmount = player.GetMaxHealth() + player.GetShieldHealthMax() + EXTRA_DMG_FOR_FORTIFIED
	player.TakeDamage( damageAmount, null, null, null )
}

void function test_downedenemy( float bleedoutTime = 0 )
{
	entity human = test_gethuman()

	// Setup the teams
	int myTeam = human.GetTeam()
	array< entity > allPlayers = GetPlayerArray_Alive()
	array< entity > enemies
	foreach ( player in allPlayers )
	{
		if ( !player.IsBot() )
			continue

		if ( IsFriendlyTeam( player.GetTeam(), myTeam ) )
			continue

		enemies.append( player )
	}

	int botCount = 2 - enemies.len()  // We need at least one extra enemy so we don't trigger a champion screen
	if ( botCount > 0 )
	{
		ServerCommand( "bots " + botCount ) // This command puts bots on different teams automatically
	}

	// Victim needs at least one friendly to be in the downed state
	entity victim
	entity victimTeammate
	array< entity > newenemies
	allPlayers = GetPlayerArray_Alive()
	foreach ( player in allPlayers )
	{
		if ( IsFriendlyTeam( player.GetTeam(), myTeam ) )
			continue

		if ( !IsValid( victim ) )
		{
			victim = player
		}
		else
		{
			victimTeammate = player
			break
		}
	}

	// Setup the enemy team
	SetTeam( victimTeammate, victim.GetTeam() )

	// Down our victim
	vector fwd = AnglesToForward( human.GetAngles() )
	victim.SetOrigin( human.GetOrigin() + fwd * 100 )
	test_downedplayer( bleedoutTime, victim )
}

void function test_downedteammate( float bleedoutTime = 0 )
{
	// Find first human player
	entity human = test_gethuman()

	// Setup the teams
	int myTeam = human.GetTeam()
	array< entity > allPlayers = GetPlayerArray_Alive()
	array<entity> enemies
	entity futureTeammate
	foreach ( player in allPlayers )
	{
		if ( !player.IsBot() )
			continue

		if ( IsFriendlyTeam( player.GetTeam(), myTeam ) )
			continue

		futureTeammate = player
		enemies.append( player )
	}

	int botCount = 2 - enemies.len()  // We need at least one enemy and one friendly so we don't go into the champion screen
	if ( botCount > 0 )
	{
		ServerCommand( "bots " + botCount )

		if ( !IsValid( futureTeammate ) )
		{
			allPlayers = GetPlayerArray_Alive()
			foreach ( player in allPlayers )
			{
				if ( !player.IsBot() )
					continue

				if ( IsFriendlyTeam( player.GetTeam(), myTeam ) )
					continue

				futureTeammate = player
				break
			}
		}
	}

	// Down our teammate
	SetTeam( futureTeammate, human.GetTeam() )
	vector fwd = AnglesToForward( human.GetAngles() )
	futureTeammate.SetOrigin( human.GetOrigin() + fwd * 100 )
	test_downedplayer( bleedoutTime,futureTeammate )
}

void function test_execution( array<string> filter = [], float delayBetweenExecutions = 1.0, bool debugDraw = true, bool cancelTest = false, string outputPath = "" )
{
	entity human = test_gethuman()
	vector fwd = AnglesToForward( human.GetAngles() )
	vector right = AnglesToRight( human.GetAngles() )
	vector playerOrigin = human.GetOrigin()

	vector centerPos = playerOrigin + fwd * 100
	vector attackerOrigin = centerPos + 15 * right
	vector targetOrigin = centerPos - 15 * right

	// grab the target and the attacker from the current players
	int myTeam = human.GetTeam()
	array<entity> allPlayers = GetPlayerArray_Alive()
	entity attacker
	entity target
	foreach ( player in allPlayers )
	{
		if ( !player.IsBot() )
			continue

		if ( IsFriendlyTeam( player.GetTeam(), myTeam ) )
		{
			target = player
		}
		else
		{
			attacker = player
		}
	}

	// if the players don't exist then spawn them in
	int botsToAdd = (attacker == null ? 1 : 0) + (target == null ? 1 : 0)
	if ( botsToAdd > 0 )
	{
		ServerCommand( "bots " + botsToAdd )
		allPlayers = GetPlayerArray_Alive()

		foreach( player in allPlayers )
		{
			if ( !player.IsBot() )
				continue

			if( target == null )
			{
				if ( player == attacker )
					continue
				target = player
			}
			else if( attacker == null )
			{
				if( player == target )
					continue
				attacker = player
			}
			if( attacker != null && target != null )
				break
		}
	}

	// setting an arbitrary team seems to cause issues so find an enemy team in the player array to use
	int enemyTeam
	foreach( entity player in allPlayers )
	{
		if( player.GetTeam() != human.GetTeam() )
		{
			enemyTeam = player.GetTeam()
			break
		}
	}
	SetTeam( attacker, enemyTeam )
	SetTeam( target, human.GetTeam() )
	array<entity> bots = [attacker, target]

	thread test_execution_thread( filter, bots, delayBetweenExecutions, attackerOrigin, targetOrigin, debugDraw, cancelTest, outputPath )
}

struct ExecutionMetrics
{
	string name
	float duration
	float attackerDeltaPos
	float targetDeltaPos
}

struct CharacterExecutionMetrics
{
	string characterRef
	array<ExecutionMetrics> executions
}

void function test_execution_thread( array<string> filter, array<entity> bots, float delayBetweenExecutions, vector attackerOrigin, vector targetOrigin, bool debugDraw, bool cancelTest, string outputPath )
{
	entity human = test_gethuman()
	Signal( human, "ExecutionTestTriggered" )
	EndSignal( human, "ExecutionTestTriggered" )
	FlagSet( "DisableLootDrops" )
	entity attacker = bots[0]
	entity target = bots[1]
	OnThreadEnd(
		function() : ( attacker )
		{
			FlagClear( "DisableLootDrops" )
			attacker.Signal( "InterruptSyncedMelee" )
			attacker.Signal( "ExecutionTestEnded" )
		}
	)

	// initialize the attacker and target state
	ClientCommand_loadouts_devset( target, ["character_selection", "character_wraith"] )
	LoadoutEntry characterLoadout = Loadout_Character()
	array<ItemFlavor> validCharacters = characterLoadout.validItemFlavorList
	array<CharacterExecutionMetrics> metrics
	table<ItemFlavor, bool> playedExecutions
	// starting at index 2 because the first 2 indexes are character_random and character_dummie
	for( int charIndex = 2; charIndex < validCharacters.len(); charIndex++ )
	{
		ItemFlavor character = validCharacters[charIndex]
		CharacterExecutionMetrics characterMetrics
		LoadoutEntry executionLoadout = Loadout_CharacterExecution( character )
		array<ItemFlavor> validExecutions = executionLoadout.validItemFlavorList

		bool foundUniqueExecution = false
		foreach( execution in validExecutions )
		{
			if( !( execution in playedExecutions ) )
			{
				foundUniqueExecution = true
				break
			}
		}
		if( !foundUniqueExecution )
			continue

		LoadoutEntry skinEntry = Loadout_CharacterSkin( character )
		array<ItemFlavor> validSkins = skinEntry.validItemFlavorList
		if( validSkins.len() <= 0 )
			continue

		table<string, string> ornull metaData = character.metaData
		expect table<string, string>(metaData)

		// filter for any characters that the user may have passed in, otherwise play every execution
		if( filter.len() > 0 )
		{
			bool found = false
			foreach( charactersToPlay in filter )
			{
				if( metaData["character_ref"] == charactersToPlay )
				{
					found = true
					break
				}
			}
			if( !found )
				continue
		}
		// find any mythic skins the player has and setup a skin override for those executions
		table<ItemFlavor, ItemFlavor> executionToRequiredSkin
		foreach( skin in validSkins )
		{
			if ( ItemFlavor_GetQuality( skin ) == eRarityTier.MYTHIC && Mythics_SkinHasCustomExecution( skin ) && !DoesPlayerHaveDeathProtection( attacker ) )
				executionToRequiredSkin[Mythics_GetCustomExecutionForCharacterOrSkin( skin )] <- skin
		}

		// find character specific executions and setup any target character overrides for those exectuions
		table<ItemFlavor, ItemFlavor> executionToRequiredTargetCharacter
		foreach( execution in validExecutions )
		{
			var settingsBlock            = GetSettingsBlockForAsset( ItemFlavor_GetAsset( character ) )
			var executionsArray             = GetSettingsBlockArray( settingsBlock, "executions" )
			for ( int entryIdx = 0 ; entryIdx < GetSettingsArraySize( executionsArray ) ; entryIdx++ )
			{
				var entryBlock = GetSettingsArrayElem( executionsArray, entryIdx )
				ItemFlavor curFlavor = GetItemFlavorByAsset( GetSettingsBlockAsset( entryBlock, "flavor" ) )
				if( curFlavor != execution )
					continue
				asset executionCharRefAsset = GetSettingsBlockAsset( entryBlock, "characterRef" )
				if ( executionCharRefAsset != $"" )
				{
					executionToRequiredTargetCharacter[execution] <- GetItemFlavorByAsset( WORKAROUND_AssetAppend( executionCharRefAsset, ".rpak" ) )
				}
				break
			}
		}

		string characterRef = metaData["character_ref"]
		characterMetrics.characterRef = characterRef

		// set the attacker's character and skin to the default. default skin assures we don't pick the mythic skin at random
		WaitFrame()
		ClientCommand_loadouts_devset( attacker, ["character_selection", characterRef] )
		// is there a better way to generate this SAID?
		string idStr = character.guid.tostring()
		string saidStr = "SAID"
		for( int i=0; i < 11 - idStr.len(); i++ )
		{
			saidStr += "0"
		}
		saidStr += idStr
		string defaultSkinName = DEV_ItemFlavor_GetCleanedAssetPath( validSkins[0] )
		ClientCommand_loadouts_devset( attacker, ["character_skin_for_" + saidStr, defaultSkinName] )
		WaitFrame()


		foreach( execution in validExecutions )
		{
			if( !IsAlive( target ) )
			{
				DEV_RespawnPlayersBySpecifiers( [], target )
			}
			WaitFrame()
			bool needsReset = false
			ClientCommand_loadouts_devset( target, ["character_selection", "character_wraith"] )
			if( execution in executionToRequiredSkin )
			{
				string requiredSkinName = DEV_ItemFlavor_GetCleanedAssetPath( executionToRequiredSkin[execution] )
				ClientCommand_loadouts_devset( attacker, ["character_skin_for_" + saidStr, requiredSkinName] )
				needsReset = true
			}
			else if( execution in executionToRequiredTargetCharacter )
			{
				table<string, string> ornull targetTmp = executionToRequiredTargetCharacter[execution].metaData
				expect table<string, string>(targetTmp)
				ClientCommand_loadouts_devset( target, ["character_selection", targetTmp["character_ref"]] )
				needsReset = true
			}
			attacker.SetOrigin( attackerOrigin )
			target.SetOrigin( targetOrigin )
			attacker.SetAngles( VectorToAngles( targetOrigin - attackerOrigin ) )
			test_downedplayer( 0, target )
			WaitFrame()

			EHI playerEHI = ToEHI( attacker )

			string executionName = DEV_ItemFlavor_GetCleanedAssetPath( execution )
			ClientCommand_loadouts_devset( attacker, ["character_execution_for_" + saidStr, executionName] )

			Wait( delayBetweenExecutions )
			TryStartSyncedMelee( attacker, target )

			// deterministically calculate the duration and distance traveled during the execution
			vector originAtAnimStart = target.GetOrigin()
			string attackerSequenceStr = string(CharacterExecution_GetAttackerAnimSeq( execution ) )
			float duration = attacker.GetSequenceDuration( attackerSequenceStr )
			// increment through the animation to determine how far the player moved
			const float ITERATIONS_PER_SECOND = 10
			float percentagePerIteration = 1.0 / duration / ITERATIONS_PER_SECOND
			int attackerSequenceIdx = attacker.LookupSequence( attackerSequenceStr )
			ItemFlavor victimCharacter = LoadoutSlot_GetItemFlavor( target, Loadout_Character() )
			asset setFile = CharacterClass_GetSetFile( victimCharacter )
			string targetRigWeight = GetGlobalSettingsString( setFile, "bodyModelRigWeight" )
			string targetSequenceStr = string( CharacterExecution_GetVictimAnimSeq( execution, victimCharacter, targetRigWeight ) )
			int targetSequenceIdx = target.LookupSequence( targetSequenceStr )
			vector targetAnimStartOrigin = target.Anim_GetStartForRefEntity( targetSequenceStr, attacker, "ref" ).origin
			float initialDelta = Distance( originAtAnimStart, targetAnimStartOrigin )
			float maxAttackerDeltaSqr = 0.0
			float maxTargetDeltaSqr = 0.0
			for( float endCycle = 0; endCycle < 1.0; endCycle += percentagePerIteration )
			{
				vector attackerDelta = attacker.GetAnimDeltas( attackerSequenceIdx, 0.0, endCycle )
				vector targetDelta = target.GetAnimDeltas( targetSequenceIdx, 0.0, endCycle )
				maxAttackerDeltaSqr = max( LengthSqr( attackerDelta ), maxAttackerDeltaSqr )
				maxTargetDeltaSqr = max( LengthSqr( targetDelta ), maxTargetDeltaSqr )
			}
			float maxAttackerDelta = sqrt( maxAttackerDeltaSqr )
			// note this is technically slightly wrong because we are just adding the lengths together, so if the movement is in opposite directions it will add together rather than cancel each other out
			// doing it this way as I was seeing some discrepancies on ref angles and I couldn't find a way to convert the delta from local to world space, it should be mostly the same result on almost all finishers
			float maxTargetDelta = sqrt( maxTargetDeltaSqr ) + initialDelta
			bool checkSmokeTest = SmokeTest_IsActive()
			if( checkSmokeTest )
			{
				if( maxTargetDelta > MAX_EXECUTION_DISPLACEMENT )
				{
					string msg = "Execution movement distance (" + maxTargetDelta + " moving from " + originAtAnimStart + " to " + targetAnimStartOrigin + ") exceeded max valid movement distance (" + MAX_EXECUTION_DISPLACEMENT + ") for target on execution "
					ReportSyncedMeleeIssue( attacker, msg, GetIgnoredExecutionRefsForMaxTargetDistance() )
				}

				if( maxAttackerDelta > MAX_EXECUTION_DISPLACEMENT )
				{
					string msg = "Execution movement distance (" + maxAttackerDelta + ") exceeded max valid movement distance (" + MAX_EXECUTION_DISPLACEMENT + ") for attacker on execution "
					ReportSyncedMeleeIssue( attacker, msg, GetIgnoredExecutionRefsForMaxAttackerDistance() )
				}

				if( duration < MIN_EXECUTION_DURATION )
				{
					string msg = "Execution duration (" + duration + ") was less than min valid duration (" + MIN_EXECUTION_DURATION + "s) on execution "
					ReportSyncedMeleeIssue( attacker, msg, GetIgnoredExecutionRefsForTime() )
				}

				if( duration > MAX_EXECUTION_DURATION )
				{
					string msg = "Execution duration (" + duration + ") was more than the max valid duration (" + MAX_EXECUTION_DURATION + "s) on execution "
					ReportSyncedMeleeIssue( attacker, msg, GetIgnoredExecutionRefsForTime() )
				}
			}

			////////////////////
			// DEBUG DRAW vars
			float debugDrawFullTime = duration + (delayBetweenExecutions/2)
			const vector ATK_COLOR = COLOR_PINK
			const vector TAR_COLOR = COLOR_BLUE
			vector lastAtkPos = attacker.GetOrigin()
			vector lastTarPos = target.GetOrigin()
			if( debugDraw )
			{
				DebugDrawAxis( attacker.GetOrigin(), attacker.GetAngles(), debugDrawFullTime, 5, ATK_COLOR )
				DebugDrawAxis( target.GetOrigin(), target.GetAngles(), debugDrawFullTime, 5, TAR_COLOR )
			}

			float startTime = Time()
			while( attacker.ContextAction_IsMeleeExecution() )
			{
				float timeSinceStart = Time() - startTime
				if( debugDraw )
				{
					float timeLeft = debugDrawFullTime - timeSinceStart
					DebugDrawLine( lastAtkPos, attacker.GetOrigin(), 255, 105, 180, true, timeLeft)
					DebugDrawLine( lastTarPos, target.GetOrigin(), 0, 0, 255, true, timeLeft)

					DebugDrawSphere( attacker.GetOrigin(), 6, 255, 105, 180, true, 0.1 )
					DebugDrawSphere( target.GetOrigin(), 6, 0, 0, 255, true, 0.1 )

					lastAtkPos = attacker.GetOrigin()
					lastTarPos = target.GetOrigin()
				}

				if( cancelTest && timeSinceStart > ( GetSyncedMeleeAllowedCancelTime() - .1 ) )
				{
					attacker.Signal( "InterruptSyncedMelee" )
				}

				WaitFrame()
			}


			if( debugDraw )
			{
				const vector COLOR_OFFSET = <75,75,75>
				//DebugDrawArrow( attackerOrigin, attacker.GetOrigin(), 3, 255, 155, 230, true, 1 )
				DebugDrawSphere( attacker.GetOrigin(), 6, 55, 155, 230, true, 1 )

				//DebugDrawArrow( targetOrigin, target.GetOrigin(), 3, 0, 0, 255, true, 1 )
				DebugDrawSphere( target.GetOrigin(), 6, 0, 0, 255, true, 1 )
			}

			Wait( delayBetweenExecutions )

			if( IsAlive( target ) )
			{
				target.Die()
				WaitFrame()
			}

			if( needsReset )
			{
				ClientCommand_loadouts_devset( attacker, ["character_skin_for_" + saidStr, defaultSkinName] )
				ClientCommand_loadouts_devset( target, ["character_selection", "character_wraith"] )
			}

			ExecutionMetrics data
			data.name = executionName
			data.attackerDeltaPos = maxAttackerDelta
			data.targetDeltaPos = maxTargetDelta
			data.duration = duration
			characterMetrics.executions.append( data )
			playedExecutions[execution] <- true
		}
		metrics.append( characterMetrics )
	}

	OutputMetrics( metrics, outputPath )
}

string function GetIgnoredExecutionRefsForMaxTargetDistance()
{
	string ignoreList = "character_execution_wraith_heirloom_v22_magicsnowbeast_prestige "
	 					+ "character_execution_horizon_blackhole "
						+ "character_execution_rampart_begging "
						+ "character_execution_wattson_default "
						+ "character_execution_pathfinder_highfive "
						+ "character_execution_valkyrie_afterburner "
						+ "character_execution_fuse_bodyslam "
						+ "character_execution_revenant_impale "
						+ "character_execution_madmaggie_whipcord "
						+ "character_execution_bangalore_prototype1 "
						+ "character_execution_bangalore_prototype2 "
						+ "character_execution_newcastle_armshield "
						+ "character_execution_valkyrie_crash "
						+ "character_execution_fuse_clothesline "
						+ "character_execution_seer_droneslinger "
						+ "character_execution_ash_base"
	return GetCurrentPlaylistVarString( "ignored_execution_refs_for_max_target_distance", ignoreList )
}

string function GetIgnoredExecutionRefsForMaxAttackerDistance()
{
	string ignoreList = "character_execution_valkyrie_crash "
							+ "character_execution_ash_slash "
							+ "character_execution_valkyrie_afterburner "
							+ "character_execution_rampart_begging "
							+ "character_execution_loba_stomp "
							+ "character_execution_revenant_default "
	return GetCurrentPlaylistVarString( "ignored_execution_refs_for_max_attacker_distance", ignoreList )
}

