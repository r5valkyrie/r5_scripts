void function test_teams( int numTeams = 2, bool humansSeparate = true, float maxAngle = 70, int distance = 300 )
{
	thread test_teams_thread( numTeams, humansSeparate, maxAngle, distance )
}

void function test_teams_thread( int numTeams = 2, bool humansSeparate = true, float maxAngle = 70, int distance = 300 )
{
	if ( numTeams <= 0 )
	{
		return;
	}

	// The human we will be using to place the teams
	entity originHuman = test_gethuman()
	int humanTeam = originHuman.GetTeam()
	vector humanOrg = originHuman.GetOrigin()
	vector humanViewDir = FlattenVec( originHuman.GetViewVector() )
	vector humanRightDir = FlattenVec( VectorRotateAxis( humanViewDir, <0, 0, 1>, -90 ) )// originHuman.GetRightVector() ) <-- Get Right Vector must be the body.  Everyone spawned askew.

	const int MinNumPlayersPerTeam = 2
	int neededPlayerCount = (numTeams*MinNumPlayersPerTeam)
	array< entity > allPlayers = GetPlayerArray_Alive()

	// Gather all humans that aren't the originHuman
	array< entity > almostAllHumans
	foreach ( player in allPlayers )
	{
		if ( !player.IsBot() && player != originHuman )
		{
			almostAllHumans.append( player )
		}
	}

	// Determine how many players we would be short
	int neededBots = 0
	if ( humansSeparate || almostAllHumans.len()+1 <= MinNumPlayersPerTeam ) // The + 1 denotes our originHuman
	{
		neededBots = neededPlayerCount - allPlayers.len()
	}
	else
	{
		// If all the humans are together on one team, then we may be
		// short bots to fill out the other teams
		neededBots = ( neededPlayerCount + (almostAllHumans.len()+1-MinNumPlayersPerTeam) - allPlayers.len() ) // Add back in the humans that would normally be on another team
	}
	if ( neededBots > 0 )
	{
		ServerCommand( "bots " + neededBots ) // This creates bots on different teams

		wait numTeams // We need time for the server to make the bots.  More bots == more time needed.
	}

	allPlayers = GetPlayerArray_Alive()

	// Gather our bots we will delegate out and
	// and also compile all the teams the game knows about.
	// There are some file data structs in other places of
	// script that have cached these teams.  So I'm going
	// to just use the existing ones.
	array< entity > allBots
	array< int > teams
	foreach ( player in allPlayers )
	{
		if ( player.IsBot() )
		{
			allBots.append( player )
		}

		int team = player.GetTeam()
		if ( !teams.contains( team ) )
		{
			teams.append( team )
		}
	}

	int team = teams.pop()
	const int Offset = 50
	SetTeam( originHuman, team )

	// Setup the human one first
	{
		int memberCount = 1
		vector spawnDir = humanRightDir
		if ( !humansSeparate ) // So all humans shoudl be together
		{
			foreach ( player in almostAllHumans )
			{
				SetTeam( player, team )
				player.SetOrigin( humanOrg + (spawnDir * Offset * memberCount) )
				player.SetForwardVector( humanViewDir )
				++memberCount
			}
			almostAllHumans.clear()
		}

		// Fill in the rest with bots
		for ( int i = memberCount; i < MinNumPlayersPerTeam; ++i )
		{
			entity player = allBots.pop()
			SetTeam( player, team )
			player.SetOrigin( humanOrg + (spawnDir * Offset * i) )
			player.SetForwardVector( humanViewDir )
		}
	}

	// Now Setup the other teams and sprinkle around the rest of the humans
	if ( numTeams > 1 )
	{
		float angleIncrement = ( numTeams > 2 ) ? maxAngle/(numTeams-2) : 0.0 // Subtract human team, and the first team starts at "0th" position so we if there are 3 teams the second team has to be at the other end.
		float startingAngle = ( numTeams > 2 ) ? -maxAngle/2 : 0.0
		float totalAngle = startingAngle
		int memberCount = 0
		vector spawnPos = humanOrg
		vector spawnDir = humanRightDir
		{
			for ( int i = 1; i < numTeams; ++i )
			{
				if ( teams.len() > 0 )
				{
					team = teams.pop()
				}
				else
				{
					printt( "ERROR in test_teams - there were not enough team indicies, will put remaining players in team " + team )
				}
				memberCount = 0
				spawnPos = humanOrg + (VectorRotateAxis( humanViewDir, <0, 0, 1>, totalAngle ) * distance )

				for ( int k = 0; k < MinNumPlayersPerTeam; ++k )
				{
					if ( (almostAllHumans.len() > 0 && k == 0) || allBots.len() == 0 )
					{
						entity player = almostAllHumans.pop()
						SetTeam( player, team )
						player.SetOrigin( spawnPos + (spawnDir * Offset * memberCount) )
						player.SetForwardVector( -humanViewDir )
						++memberCount
					}
					else
					{
						entity player = allBots.pop()
						SetTeam( player, team )
						player.SetOrigin( spawnPos + (spawnDir * Offset * memberCount) )
						player.SetForwardVector( -humanViewDir )
						++memberCount
					}
				}

				float prevTotal = totalAngle
				totalAngle += angleIncrement
				if ( totalAngle >= 0 && prevTotal < 0 )
				{
					spawnDir *= -1 // Flip direction of spawn
				}
			}
		}

		// Add any extraneous bots/humans to the last team
		{
			foreach( player in almostAllHumans )
			{
				SetTeam( player, team )
				player.SetOrigin( spawnPos + (spawnDir * Offset * memberCount) )
				player.SetForwardVector( -humanViewDir )
				++memberCount
			}
			foreach( player in allBots )
			{
				SetTeam( player, team )
				player.SetOrigin( spawnPos + (spawnDir * Offset * memberCount) )
				player.SetForwardVector( -humanViewDir )
				++memberCount
			}
		}
	}

	printt( "test_teams - Completed.  If people aren't quite in the right groupings you may need to call it again.  The bots may not have been completed in time." )
}

void function test_trigger( void functionref( entity trigger, entity ent ) enterCallback = null, void functionref( entity trigger, entity ent ) leaveCallback = null, float radius = 100, float aboveHeight = 256, float belowHeight = 16 )
{
	entity player = test_gethuman()
	thread test_trigger_internal_thread( player, enterCallback, leaveCallback, radius, aboveHeight, belowHeight )
}

void function test_trigger_internal_thread( entity player, void functionref( entity trigger, entity ent ) enterCallback, void functionref( entity trigger, entity ent ) leaveCallback, float radius, float aboveHeight, float belowHeight )
{
	vector triggerOrigin = player.GetOrigin() + ( player.GetForwardVector()*radius*2.0 )

	entity trigger = CreateEntity( "trigger_cylinder" )
	trigger.RemoveFromAllRealms()
	trigger.AddToOtherEntitysRealms( player )
	trigger.SetCylinderRadius( radius )
	trigger.SetAboveHeight( aboveHeight )
	trigger.SetBelowHeight( belowHeight ) // Need this because the player or entity can sink into the ground a tiny bit and we check player feet not half height
	trigger.SetOrigin( triggerOrigin )
	trigger.SetEnterCallback( enterCallback )
	trigger.SetLeaveCallback( leaveCallback )
	DispatchSpawn( trigger )

	trigger.SearchForNewTouchingEntity()

	 DebugDrawCylinder( trigger.GetOrigin() - <0.0, 0.0, trigger.GetBelowHeight()>, <270.0, 0.0, 0.0>, trigger.GetRadius(), trigger.GetAboveHeight() + trigger.GetBelowHeight(), 255,0,0, true, 99999.0 )

	WaitSignal ( trigger, "OnDestroy" )
}

struct
{
	bool stresstestpvs_inprogress = false
} file

void function test_stresstestpvs()
{
	thread internal_stresstestpvs_thread()
}

void function internal_stresstestpvs_thread()
{
	AssertIsNewThread()

	if ( file.stresstestpvs_inprogress )
	{
		printt( "test_stresstestpvs - ERROR - is already in progress. Cannot start another one until it has completed." )
		return
	}

	file.stresstestpvs_inprogress = true

	// Spawn necessary number of bots
	int MAX_TOTAL_PLAYERS = 60
	array< entity > allPlayers = GetPlayerArray_Alive()
	int numBotsNeeded = MAX_TOTAL_PLAYERS - allPlayers.len()
	printt( "test_stresstestpvs - START - spawning " + numBotsNeeded + " bots" )

	if ( numBotsNeeded > 0 )
	{
		ServerCommand( "bots " + numBotsNeeded )

		waitthread function() : ( MAX_TOTAL_PLAYERS )
		{
			float timeStart = Time()
			float timeEnd = timeStart + 15.0
			while ( GetPlayerArray_Alive().len() < MAX_TOTAL_PLAYERS )
			{
				if ( Time() > timeEnd )
				{
					break
				}
				printt( "test_stresstestpvs - " + GetPlayerArray_Alive().len()  + " players in world....waiting for more to be created." )
				wait 3.0

			}
			printt( "test_stresstestpvs - All bots created, now marking new pvs baseline" )
		} ()
	}

	if ( GetPlayerArray_Alive().len() < MAX_TOTAL_PLAYERS )
	{
		printt( "test_stresstestpvs - Running test failed - could not hit max players to run test.  Please try to run the test again." )
		return
	}

	// Have client take pvs snapshot for baseline
	allPlayers = GetPlayerArray_Alive()
	foreach ( player in allPlayers )
	{
		if ( player.IsHuman() )
			Remote_CallFunction_NonReplay( player, "ServerToClient_LeafSystemMarkPvs" )
	}
	wait 1.5

	// Give infinite ammo and trigger ult
	ServerCommand( "sv_infinite_ammo 1" )

	printt( "test_stresstestpvs - triggering all bots to fire..." )
	foreach( player in allPlayers )
	{
		player.BotButtonPress( IN_ATTACK )
	}
	ServerCommand( "sv_infinite_ammo 0" ) // Turn it back off or it seems some bots will keep firing (probably related to whatever weapon they were given)

	printt( "test_stresstestpvs - ...waiting 3.0s" )
	wait 3.0
	printt( "test_stresstestpvs - END - Success if no assert" )

	file.stresstestpvs_inprogress = false
}
#endif

#if CLIENT
//-----------------------------------------------------------------------------
// CLIENT FUNCTIONS
// All in LOWER CASE so we can type them faster
//-----------------------------------------------------------------------------
void function test_help( )
{
	// Keep in alphabetical order
	printt( "test_itemflavorsdump() - outputs to console and file the list of item flavors seen by the vm. Add a string to filter out results.  Look for file 'itemflavorsdump_'" )
}

void function test_tiptext( int tipNumber )
{
	string tip

	if( tipNumber < 10 )
	{
		tip = "#TIP_00" + tipNumber
	}
	else if ( tipNumber < 100 )
	{
		tip = "#TIP_0" + tipNumber
	}
	else
	{
		tip = "#TIP_" + tipNumber
	}

	string tip_localized = Localize( tip )

	printt( format( "%s(): Tip Text %s == %s ", FUNC_NAME(), tip, tip_localized ) )
	Obituary_Print_Localized( tip_localized )
}

#endif

#endif // DEV