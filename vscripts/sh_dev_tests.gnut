void function ReportSyncedMeleeIssue( entity attacker, string msg, string ignoredRefs )
{
	ItemFlavor attackerCharacter = LoadoutSlot_GetItemFlavor( attacker, Loadout_Character() )
	ItemFlavor attackerExecution = LoadoutSlot_GetItemFlavor( attacker, Loadout_CharacterExecution( attackerCharacter ) )
	string executionName = DEV_ItemFlavor_GetCleanedAssetPath( attackerExecution )
	if( ignoredRefs.find( executionName ) >= 0 )
	{
		return
	}
	ForceScriptError( msg + executionName )
}

void function OutputMetrics( array<CharacterExecutionMetrics> metrics, string outputPath )
{
	string fileString = ""
	fileString += "Min Duration," + MIN_EXECUTION_DURATION + "s\n"
	fileString += "Max Duration," + MAX_EXECUTION_DURATION + "s\n"
	fileString += "Max Displacement," + MAX_EXECUTION_DISPLACEMENT + " units\n"

	fileString += "\nFinisher Name,Character Ref,Duration,Attacker Max Displacement,Target Max Displacement,Violations\n"

	bool outputToFile = outputPath != ""
	if( !outputToFile )
	{
		printl( "Printing Execution Metrics:" )
		printl( "\n"+fileString )
	}

	int totalViolations = 0
	foreach( characterMetrics in metrics )
	{
		foreach( executionMetric in characterMetrics.executions )
		{
			int durationVio = (executionMetric.duration > MAX_EXECUTION_DURATION || executionMetric.duration < MIN_EXECUTION_DURATION) ? 1 : 0
			int atkDeltaVio = executionMetric.attackerDeltaPos > MAX_EXECUTION_DISPLACEMENT ? 1 : 0
			int tarDeltaVio = executionMetric.targetDeltaPos > MAX_EXECUTION_DISPLACEMENT ? 1 : 0
			int violations = durationVio + atkDeltaVio + tarDeltaVio
			totalViolations += violations

			string lineString = executionMetric.name + ","
			lineString += characterMetrics.characterRef + ","
			lineString += executionMetric.duration + ","
			lineString += executionMetric.attackerDeltaPos + ","
			lineString += executionMetric.targetDeltaPos + ","
			lineString += string( violations )

			if( outputToFile )
			{
				fileString += lineString + "\n"
			}
			else
			{
				printl( lineString )
				if ( violations > 0 )
				{
					string executionWarningStr = "Execution '" + executionMetric.name + "' "
					if ( durationVio > 0)
						Warning( executionWarningStr + "duration: " + executionMetric.duration + " is outside limits. Min: " + MIN_EXECUTION_DURATION + " Max: " + MAX_EXECUTION_DURATION  )
					if ( atkDeltaVio > 0 )
						Warning( executionWarningStr + "attacker displacement: " + executionMetric.attackerDeltaPos + " is outside limit. Max displacement: " + MAX_EXECUTION_DISPLACEMENT )
					if ( tarDeltaVio > 0 )
						Warning( executionWarningStr + "target displacement: " + executionMetric.targetDeltaPos + " is outside limit. Max displacement: " + MAX_EXECUTION_DISPLACEMENT )
				}
			}
		}
	}

	if( outputToFile )
	{
		DevTextBufferClear()
		DevTextBufferWrite( fileString )
		DevTextBufferDumpToFile( outputPath )
		DevTextBufferClear()
	}
	else
	{
		if ( totalViolations > 0 )
		{
			Warning( "Execution test found " + totalViolations + " violations across " + metrics.len() + " character executions. Details above in the log." )
		}
	}
}

void function test_everybodyiscaustic()
{
	string characterFlavorStr = "character_caustic"
	string skinFlavorStr = "character_skin_caustic_legendary_pyro"

	// Get the character ItemFlavor
	array<ItemFlavor> flavors = GetAllCharacters()
	ItemFlavor characterFlavor
	foreach( itemFlavor in flavors)
	{
		if ( ItemFlavor_GetCharacterRef( itemFlavor ) == characterFlavorStr )
		{
			characterFlavor = itemFlavor
			break
		}
	}

	if ( characterFlavor.guid == -1)
	{
		printt( "SCRIPT ERROR: Could not find character item flavor named '" + characterFlavorStr + "'" )
		return
	}

	// Get the character skin ItemFlavor
	array<ItemFlavor> characterSkins = 	GetValidItemFlavorsForLoadoutSlot( EHI_null, Loadout_CharacterSkin( characterFlavor ) )
	ItemFlavor skinFlavor
	foreach ( itemFlavor in characterSkins )
	{
		if ( DEV_ItemFlavor_GetCleanedAssetPath( itemFlavor ) == skinFlavorStr )
		{
			skinFlavor = itemFlavor
			break
		}
	}

	if ( skinFlavor.guid == -1 )
	{
		printt( "SCRIPT ERROR: Could not find skin item flavor named '" + skinFlavorStr + "'" )
		return
	}

	// Turn everyone to that character
	array<entity> allplayers = GetPlayerArray_Alive()
	foreach ( player in allplayers )
	{
		SetItemFlavorLoadoutSlot( ToEHI( player ), Loadout_CharacterSkin( characterFlavor ), skinFlavor )
		// SetItemFlavorLoadoutSlot( ToEHI( player ), Loadout_CharacterClass(), characterFlavor ) // Removed?
	}

	// Apply the skin
}

void function test_putplayerinsafespotformap()
{
	// Note: This is not a complete test suite, just some problematic ones that any re-work of the function should not break.
	// Best tests have been:
	// - Trident eject between two pillars, eject when drivers seat in a lamp post, eject after high speed collision, loba tac under trident that is on a stairwell/ramp
	// - Loba tac between narrow bin and wall
	// - Loba tac in corners of bins
	// - Loba tac on areas with complex geo.
	// - Loba tac between two large pipes (olympus mu1: script GetPlayerArray().SetOrigin(<-35748.375, -7397.88574, -4286.02783>)
	// - Loba tac under stairwells
	// - Loba tac under variety of static vehicles in the world
	// - Loba tac large pockets in structure (particularly if you aim for the corner of these pockets)
	// - Loba tac overtop large trees and statues
	// - Rampart gun in front of crafting station - enter then exit crafting station

	bool foundTest = false
	int failCount = 0
	string mapName = GetMapName().tolower()
	if ( mapName == "mp_rr_canyonlands_mu3" )
	{
		foundTest = true
		failCount += test_putplayerinsafespotformap_internal( false, <5200.20703, -31232.5645, 2888.1853> )	// (wall and crate) http://jiratf.respawn.net:8080/browse/R5DEV-264752
		failCount += test_putplayerinsafespotformap_internal( true, <4818.34473, -31009.1895, 2888.23755> )	// (high and low are the same plane)
		failCount += test_putplayerinsafespotformap_internal( false, <-8131.70068, 36848.5586, 5965.83936> )	// (crashed ship divet) http://jiratf.respawn.net:8080/browse/R5DEV-264757
		failCount += test_putplayerinsafespotformap_internal( false, <1450.22998, 22442.7422, 4161.896> )		// (supply bin and wall)
	}
	else if ( mapName == "mp_rr_desertlands_mu2" )
	{
		foundTest = true

		// Could not find a way to catch this case:
		// It should be true, but not in the position it gives back currently.  This is a scenario where low collision pushed us towards high collision but the gap is large enough that we don't hit high collision to fail the high collision test
		//failCount += test_putplayerinsafespotformap_internal( false, <-25607.7285, -21599.0957, -4418.92676> )				// (in gap between low and high and low pushed us inwards) http://jiratf.respawn.net:8080/browse/R5DEV-265759
		failCount += test_putplayerinsafespotformap_internal( false, <-19022.4609, -18340.4355, -4309.11865> )	// (in gap under a tank)
	}
	else if ( mapName == "mp_rr_olympus_mu1" )
	{
		foundTest = true
		failCount += test_putplayerinsafespotformap_internal( false, <-18989.082, 32167.2305, -5784.18506> )	// (complex tower structure) ended up pushing us back into high collision
		failCount += test_putplayerinsafespotformap_internal( false, <-18905.3965, 32201.918, -5566.22119> )	// (complex tower structure) http://jiratf.respawn.net:8080/browse/R5DEV-260728
		failCount += test_putplayerinsafespotformap_internal( false, <-4634.83008, -2541.29297, -6257.17822> )	// (hammond labs) http://jiratf.respawn.net:8080/browse/R5DEV-265638
		failCount += test_putplayerinsafespotformap_internal( false, <-35802.8164,-7669.64258, -4270.09277> ) 	// (between two pipes)
		failCount += test_putplayerinsafespotformap_internal( false, <-35717.0547, -7751.70313, -4214.11035> )	// (between pipe and grainery)

		// Could not find a way to catch this case:
		//failCount += test_putplayerinsafespotformap_internal( false, <15580.1953, -15096.4941, -5710.2959> )	// (stupid tree) http://jiratf.respawn.net:8080/browse/R5DEV-265763

		failCount += test_putplayerinsafespotformap_internal( true, <-18709.8496, 32282.1582, -5711.16064> )	// (off a wall)
	}
	else if ( mapName == "mp_rr_party_crasher" )
	{
		foundTest = true

		// Could not find a way to catch this case:
		// The statue in the middle has a large open gap, if her tac ends up in there then she will teleport there.
		//failCount += test_putplayerinsafespotformap_internal( false, <830.662964, 961.881775, 985.026184> )	// (statue) http://jiratf.respawn.net:8080/browse/R5DEV-257805

		failCount += test_putplayerinsafespotformap_internal( false, <830.491211, 944.849548, 985.018921> )	// (statue - but hit high colliison first)  http://jiratf.respawn.net:8080/browse/R5DEV-257805
	}

	if ( foundTest )
	{
		printt( "test_putplayerinsafespotformap - tests completed, " + failCount + " tests failed (see above for any fail messages)" )
	}
	else
	{
		printt( "test_putplayerinsafespotformap - NO TESTS FOR MAP FOUND" )
	}
}

int function test_putplayerinsafespotformap_internal( bool expectedValue, vector spot )
{
	vector ornull retVector = CanPutPlayerInSafeSpot( GetPlayerArray(), null, null, true, false, spot, spot )
	bool didTestPass = expectedValue ? retVector != null : retVector == null
	if ( !didTestPass )
		printt( "test_putplayerinsafespotformap_internal - failed test: script CanPutPlayerInSafeSpot( GetPlayerArray(), null, null, true, false, " + spot + ", " + spot + " )" )
	return didTestPass ? 0 : 1 // Note:  we are testing for failure
}

