entity function SpawnMoverMovingFromStartToEnd( string scriptName, entity childEntity, vector startOrigin, vector startAngles, vector goal, float moveTime )
{
	// spawn the mover
	entity script_mover = CreateScriptMover( scriptName, startOrigin, startAngles )

	// set the mover to be a pusher
	script_mover.SetPusher( true )

	// parent it to the entity that actually has geo
	childEntity.SetParent( script_mover )

	// set the movers target position
	script_mover.NonPhysicsMoveTo( goal, moveTime, 0, 0 )

	return script_mover
}

void function tooManyMoversTest_Thread( entity player, float duration )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "tooManyMoverTestEnd" )

	array< entity > allMovers

	OnThreadEnd(
		function() : ( allMovers )
		{
			foreach (entity mover in allMovers)
			{
				if ( IsValid(mover) )
				{
					mover.Destroy()
				}
			}
		}
	)

	vector currentPos = player.GetOrigin()
	vector angles = player.GetAngles()


	float spacing = 150
	float x = currentPos.x
	float y = currentPos.y + (-3 * spacing)
	float z = currentPos.z
	float initialX = (-3 * spacing) + x
	for (int i = 0; i < 5; i++)
	{
		y = y + spacing
		x = initialX
		for (int j = 0; j < 5; j++)
		{
			x = x + spacing
			currentPos = <x, y, z>

			entity traceBlocker = CreateTraceBlockerVolume( currentPos, 5, false, CONTENTS_BLOCK_PING | CONTENTS_NOGRAPPLE, 0, "TEST_PUSHER_ENT_" + ( (i * 5) + j ) )
			entity newMover = SpawnMoverMovingFromStartToEnd( "TEST_PUSHER_ENT_" + ( (i * 5) + j ), traceBlocker, currentPos, angles, currentPos + <0,0,100>, 10 )
			allMovers.append( newMover )


			traceBlocker.SetParent( newMover, "", true )
			thread tooManyMoversTestDebugDisplay_Thread( newMover )
		}
	}

	if ( duration == 0)
		WaitForever()
	else
		wait duration
}

void function tooManyMoversTestDebugDisplay_Thread( entity mover )
{
	EndSignal( mover, "OnDestroy" )

	while( true )
	{
		DebugDrawSphere(mover.GetOrigin(), 5, 255, 105, 180, true, 1)
		wait 1
	}
}

