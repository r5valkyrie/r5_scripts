array<SharedRankedTierData> function Ranked_GetTiers()
{
	return file.rankedTiers
}


SharedRankedTierData ornull function Ranked_GetNextTierData( SharedRankedTierData data )
{
	if ( data.isLadderOnlyTier )
		return null

	if ( data.index + 1 < file.rankedTiers.len() )
		return file.rankedTiers[ data.index + 1 ]

	return null
}


array< SharedRankedDivisionData > function Ranked_GetRankedDivisionDataForTier( SharedRankedTierData tier )
{
	if ( tier.isLadderOnlyTier )
	{
		Assert( file.ladderOnlyDivision != null )
		return [ expect SharedRankedDivisionData( file.ladderOnlyDivision ) ]
	}

	array< SharedRankedDivisionData > data

	for ( int i = 0; i < file.rankedDivisions.len(); i++ )
	{
		if ( file.rankedDivisions[ i ].tier == tier )
			data.append( file.rankedDivisions[ i ] )
	}

	return data
}



#if SERVER
void function Ranked_FindLadderPositionsForCharSelect()
//Doing this in character select as a batch for most players, instead of doing individual lookups whenever players connect. We still do that for late stragglers to catch edge cases
{
	Assert( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
	foreach ( entity player in GetPlayerArray() )
	{
		if ( Ranked_ShouldCheckLadderPositionForPlayer( player ) && !(player in file.playersToCheckLadderPositions) )
			file.playersToCheckLadderPositions[ player ] <- true
	}

	if ( file.playersToCheckLadderPositions.len() > 0 )
	{
		string periodName = Ranked_GetStryderLadderNameForLatestRankedPeriod()
		//printt( "Ranked_FindLadderPositionsForCharSelect, periodName is: " + periodName )
		array<entity> playersToLookUp
		foreach ( player, value in file.playersToCheckLadderPositions )
		{
			if ( value )
				playersToLookUp.append( player )
		}

		LookupRankedPosForPlayers( periodName, playersToLookUp )
	}
}


void function CodeCallback_BotMimicPlayerRanked( entity player, entity bot )
{
	if ( !IsValid( player ) )
		return

	if ( !IsValid( bot ) )
		return

	int rankedScore = GetRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME )
	SetRankedPersistenceData( bot, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME, rankedScore )
}


void function UpdateHighScore( entity player, int score, string seasonRef )
{
	int highest
	ItemFlavor rankedPeriod = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( seasonRef ) )

	if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.ranked_2pt0_period )
	{
		highest = player.GetPersistentVarAsInt( "rankedPeriodData[" + seasonRef + "]." + "highestRankedScore" )
		if ( score > highest )
			player.SetPersistentVar( "rankedPeriodData[" + seasonRef + "]." + "highestRankedScore", score )

		return
	}

	bool hasSplit = ( !SharedRankedPeriod_HasSplits( rankedPeriod ) || ItemFlavor_GetType( rankedPeriod ) == eItemType.ranked_2pt0_period ||
						!SharedRankedPeriod_IsFirstSplitActive( rankedPeriod ) )

	if ( hasSplit )
		highest = player.GetPersistentVarAsInt( "allRankedData[" + seasonRef + "]." + "highestRankedScore" )
	else
		highest = player.GetPersistentVarAsInt( "allRankedData[" + seasonRef + "]." + "firstSplitHighScore" )

	if ( score > highest )
	{
		if ( hasSplit )
			player.SetPersistentVar( "allRankedData[" + seasonRef + "]." + "highestRankedScore", score )
		else
			player.SetPersistentVar( "allRankedData[" + seasonRef + "]." + "firstSplitHighScore", score )
	}

	// don't worry about offseason high score; it's not really used for anything.
}


void function SetRankedPersistenceData( entity player, string persistenceField, int data )
{
	string ornull currentSeasonRefOrNull = GetCurrentStatRankedPeriodRefOrNullByType( eItemType.calevent_rankedperiod )

	if ( currentSeasonRefOrNull != null )
	{
		expect string( currentSeasonRefOrNull )
		if ( ItemFlavor_GetType( GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( currentSeasonRefOrNull ) ) ) == eItemType.ranked_2pt0_period )
		{
			Assert( RANKED_2PT0_PERSISTENCE_FIELDS.contains( persistenceField ) )
			if ( !(RANKED_2PT0_PERSISTENCE_FIELDS.contains( persistenceField )) )
				return

			if ( XPROG_MERGED_PLATFORM_PERSISTENCE_FIELDS.contains( persistenceField ) )
			{
				Ranked_SetXProgMergedPersistenceData( player, persistenceField, data )
				return
			}
			else
			{
				player.SetPersistentVar( "rankedPeriodData[" + currentSeasonRefOrNull + "]." + persistenceField, data )
			}
		}
		else
		{
			player.SetPersistentVar( "allRankedData[" + currentSeasonRefOrNull + "]." + persistenceField, data )
		}

		// make sure to always update high score when setting current score
		// N.B.: highestRankedScore == 2nd-split (*not overall*) high score for seasons with splits
		if ( persistenceField == RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME )
			UpdateHighScore( player, data, currentSeasonRefOrNull )
	}
}

void function SetRankedGameData( entity player, string persistenceField, int data )
{
	player.SetPersistentVar( "rankedGameData." + persistenceField, data )
}


void function Ranked_SetHistoricalRankedPersistenceData( entity player, string persistenceField, var data, string rankedPeriodRef )
{
	// allRankedData persistence uses integer indices, not GUID strings
	// ranked_2pt0_period flavors aren't registered either - skip all historical ranked persistence writes
	return
}


                      
void function Ranked_OnMatchBehaviorEnd( entity player, bool wasUnexpectedDisconnect )
{

	#if DEVELOPER
		DEV_script_ranked_debug ( "Ranked_OnMatchBehaviorEnd for player: " + player.GetPlayerName() + " and wasUnexpectedDisconnect: " + wasUnexpectedDisconnect )
	#endif

	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
		return

	if ( !MatchBehavior_Enabled() )
		return

	bool bIsNetworkAlertInUse = GetCurrentPlaylistVarBool( "networkalert_nostats", true )
	if( bIsNetworkAlertInUse && IsServerNetworkAlertTriggered() )
	{
		SetRankedGameData( player, "lastGameRankedForgiveness", 1 ) // server was ddosed, do not apply abandon penalty
	}
	else if ( !MatchBehaviorPlayer_DidAbandonThisMatch( player ) )
	{
		if ( wasUnexpectedDisconnect ) // Player who left didn't abandon, but it was an unexpected disconnect, so give his teammates loss forgiveness, if they are still playing
		{
			foreach ( entity teamPlayer in GetPlayerArrayOfTeam( player.GetTeam() ) )
			{
				if ( teamPlayer == player )
					continue

				if ( !Ranked_IsMatchOverForPlayer( teamPlayer ) ) //Give loss forgiveness as long as match participation hasn't fully ended for the players
					SetRankedGameData( teamPlayer, "lastGameRankedForgiveness", 1 )
			}
		}
		else //Player quit out on purpose through the menus; only give lossForgivessness if the team was never full
		{
			if ( !SharedRanked_DidPlayerEverHaveAFullTeam( player ) )
				SetRankedGameData( player, "lastGameRankedForgiveness", 1 )
		}
	}
	else
	{
		//In here: Player is marked as abandon. We may or may not forgive the player for this, but we are definitely incrementing the number of games consisdered to have been abandoned.
		int timeBetweenAbandonResetsAllowed = GetCurrentPlaylistVarInt( "ranked_time_between_abandon_resets_allowed", SECONDS_PER_DAY )

		int usedAbandonedForgivenessGames = expect int ( player.GetPersistentVar( "numUsedForgivenessAbandons" ) )

		if ( GetCurrentPlaylistVarBool( "ranked_track_unexpected_disconnects", true ) )
		{
			if ( usedAbandonedForgivenessGames < GetCurrentPlaylistVarInt( "ranked_num_abandon_forgiveness_games", SHARED_RANKED_NUM_ABANDON_FORGIVENESS_GAMES ) && wasUnexpectedDisconnect )
			{
				player.SetPersistentVar( "totalRankedGamesAbandoned", expect int ( player.GetPersistentVar( "totalRankedGamesAbandoned" ) ) + 1 )
				int lastTimeRankedAbandoned = expect int( player.GetPersistentVar( "lastTimeGameWasRankedAbandoned" ) )

				if ( lastTimeRankedAbandoned > 0 && GetCurrentTimeForPersistence() < lastTimeRankedAbandoned + timeBetweenAbandonResetsAllowed )
				{
					player.SetPersistentVar( "numUsedForgivenessAbandons", expect int ( player.GetPersistentVar( "numUsedForgivenessAbandons" ) ) + 1 )
				}

				player.SetPersistentVar( "lastTimeGameWasRankedAbandoned", GetCurrentTimeForPersistence() )
				SetRankedGameData( player, "lastGameAbandonForgiveness", 1 )
			}
			else
			{
				player.SetPersistentVar( "totalRankedGamesAbandoned", expect int ( player.GetPersistentVar( "totalRankedGamesAbandoned" ) ) + 1 )
				player.SetPersistentVar( "lastTimeGameWasRankedAbandoned", GetCurrentTimeForPersistence() )
				SetRankedGameData( player, "lastGameRankedAbandon", 1 )
				SharedRanked_SetMatchmakingDelayDuration( player )
				player.SetPersistentVar( "numPenalizedAbandons", expect int ( player.GetPersistentVar( "numPenalizedAbandons" ) ) + 1 )
			}
		}
		else
		{
			if ( wasUnexpectedDisconnect )
			{
				player.SetPersistentVar( "totalRankedGamesAbandoned", expect int ( player.GetPersistentVar( "totalRankedGamesAbandoned" ) ) + 1 )
				player.SetPersistentVar( "lastTimeGameWasRankedAbandoned", GetCurrentTimeForPersistence() )
				SetRankedGameData( player, "lastGameAbandonForgiveness", 1 )
			}
			else
			{
				player.SetPersistentVar( "totalRankedGamesAbandoned", expect int ( player.GetPersistentVar( "totalRankedGamesAbandoned" ) ) + 1 )
				player.SetPersistentVar( "lastTimeGameWasRankedAbandoned", GetCurrentTimeForPersistence() )
				SetRankedGameData( player, "lastGameRankedAbandon", 1 )
				SharedRanked_SetMatchmakingDelayDuration( player )
				player.SetPersistentVar( "numPenalizedAbandons", expect int ( player.GetPersistentVar( "numPenalizedAbandons" ) ) + 1 )
			}
		}

		//Player has abandoned, give teammates that are not also party mates loss forgiveness.
		foreach ( entity teamPlayer in GetPlayerArrayOfTeam( player.GetTeam() ) )
		{
			if ( teamPlayer == player )
				continue

			if ( PlayersInSameParty( teamPlayer, player ) )
				continue

			SetRankedGameData( teamPlayer, "lastGameRankedForgiveness", 1 )

			#if DEVELOPER
			//DEV OVERRIDE
			if ( GetCurrentPlaylistVarBool ( "Ranked_DEV_QV_Disable_RankForgiveness" , false ) )
			{
				SetRankedGameData( teamPlayer, "lastGameRankedForgiveness", 0 )
			}
			#endif
		}
	}

	#if DEVELOPER
	//DEV OVERRIDE
	if ( GetCurrentPlaylistVarBool ( "Ranked_DEV_QV_Disable_RankForgiveness" , false ) )
	{
		SetRankedGameData( player, "lastGameRankedForgiveness", 0 )
	}
	#endif

	// hasMatchParticipationStarted not available, PrepareGameSummaryForPointCalculation is stubbed
	// if ( !player.p.hasMatchParticipationStarted )
	// 	PrepareGameSummaryForPointCalculation( player )
}
                       


void function SharedRanked_SetMatchmakingDelayDuration( entity player )
{
	//printt( "Player ban time is: " +  banLengthInSeconds )
	SetPlayerBan( player, MATCHBANREASON_ABANDONED, SharedRanked_GetAbandonPenaltyLength( player ) )
}


void function Ranked_OnPlayerDisconnected( entity player )
{
	if ( IsLobby() )
	{
		if ( player in file.playersToCheckLadderPositions )
			delete file.playersToCheckLadderPositions[ player ]
	}
}

void function Ranked_InitPrevRankBadges( entity player , bool reconnect = false )
{
	if ( Ranked_ShouldShowRankedBadge() )
	{
		return
	}

	int teamID = player.GetTeam()
	array<entity> teammates = GetPlayerArrayOfTeam ( teamID )

	foreach (teammate in teammates)
	{
		//Pull
		int scorePrevSeason = GetPrevSeasonPeakPlayerRankScore ( teammate )
		printf ("badge rank on connect scorePrevSeason player: " + teammate.GetPlayerName() + " : " + scorePrevSeason )
		Remote_CallFunction_NonReplay( player, "ServerToClient_Ranked_UpdatePlayerPrevRankedScore", teammate, scorePrevSeason )



		int ladderPosPrevSeason = Ranked_GetPeakLadderPositionPrevSeason ( teammate )
		printf ("badge rank on connect laddder pos PrevSeason player: " + teammate.GetPlayerName() + " : " + ladderPosPrevSeason )
		Remote_CallFunction_NonReplay( player, "ServerToClient_Ranked_UpdatePlayerPrevLadderPos", teammate, ladderPosPrevSeason )

		if ( !reconnect )
		{
			//Push
			scorePrevSeason = GetPrevSeasonPeakPlayerRankScore ( player )
			printf ( "badge rank on connect scorePrevSeason teammate: " + player.GetPlayerName() + " : " + scorePrevSeason )
			Remote_CallFunction_NonReplay( teammate, "ServerToClient_Ranked_UpdatePlayerPrevRankedScore", player, scorePrevSeason )

			ladderPosPrevSeason = Ranked_GetPeakLadderPositionPrevSeason ( player )
			printf ( "badge rank on connect laddder pos PrevSeason teammate: " + teammate.GetPlayerName() + " : " + ladderPosPrevSeason )
			Remote_CallFunction_NonReplay( teammate, "ServerToClient_Ranked_UpdatePlayerPrevLadderPos", player, ladderPosPrevSeason )
		}
	}
}

void function Ranked_OnPlayerReconnected( entity player )
{
	//early out if hide RP display
	if ( Ranked_ShouldShowPreRankedBadge () )
	{
		return
	}

	Ranked_InitPrevRankBadges ( player, true )
}


