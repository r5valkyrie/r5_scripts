#if SERVER
void function Ranked_UpgradePlayerPersistence( entity player, int oldVersion, int newVersion )
{
	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	int versionNum_setEndLadderPosForSeason1 = 202001120
	if ( oldVersion < versionNum_setEndLadderPosForSeason1 )
	{
		Ranked_SetHistoricalRankedPersistenceData( player, "endSeriesLadderPosition", -1, RANKED_SEASON_02_GUIDSTRING )
	}
}


void function Ranked_SetStatsForRankedSeasonTwo( entity player )
//For people who never played ranked before we added the stat tracker for RP. This is needed to unlock the correct badge
{
	int statTrackerRP = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.rankedperiod_current_rank_score, RANKED_SEASON_02_GUIDSTRING ) )
	if ( statTrackerRP == 0 )
	{
		int rankedScoreForSeasonTwo = Ranked_GetHistoricalRankScore( player, RANKED_SEASON_02_GUIDSTRING )
		StatsHook_SetRankedScore( player, MATCHRANKEDMODE_RANKED, RANKED_SEASON_02_GUIDSTRING, rankedScoreForSeasonTwo )
	}
}
#endif // SERVER


