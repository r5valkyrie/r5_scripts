#if SERVER && DEVELOPER
void function GenerateRanked_PDef()
{
	array<string> ranked2Pt0PeriodRefs = []
	array<string> ranked2Pt0PeriodComments = []
	foreach ( int idx, ItemFlavor rankedPeriod in file.allRanked2Pt0Periods )
	{
		ranked2Pt0PeriodRefs.append( ItemFlavor_GetGUIDString( rankedPeriod ) )
		ranked2Pt0PeriodComments.append( string(ItemFlavor_GetAsset( rankedPeriod )) )
	}
	DEV_PDefGen_AddEnum( "eRankedPeriod2Pt0Flavor", ranked2Pt0PeriodRefs, "All Ranked 2.0 Periods.", ranked2Pt0PeriodComments )

	array<string> rankedPeriodRefs = []
	array<string> rankedPeriodComments = []
	foreach ( int idx, ItemFlavor rankedPeriod in GetAllRankedPeriodCalEventFlavorsByType( eItemType.calevent_rankedperiod ) )
	{
		rankedPeriodRefs.append( ItemFlavor_GetGUIDString( rankedPeriod ) )
		rankedPeriodComments.append( string(ItemFlavor_GetAsset( rankedPeriod )) )
	}
	foreach ( int idx, ItemFlavor rankedPeriod in file.allRanked2Pt0Periods )
	{
		rankedPeriodRefs.append( ItemFlavor_GetGUIDString( rankedPeriod ) )
		rankedPeriodComments.append( string(ItemFlavor_GetAsset( rankedPeriod )) )
	}
	DEV_PDefGen_AddEnum( "eRankedStatPeriod", rankedPeriodRefs, "All Ranked Stat Periods.", rankedPeriodComments )

	DEV_PDefGen_BeginFieldGroup( "Shared Ranked Vars" )

	DEV_PDefGen_AddField_Int( "lastTimeGameWasRankedAbandoned" )
	DEV_PDefGen_AddField_Int( "numPenalizedAbandons" )
	DEV_PDefGen_AddField_Int( "numUsedForgivenessAbandons" )
	DEV_PDefGen_AddField_Int( "totalRankedGamesAbandoned" )

	DEV_PDefGen_EndFieldGroup()
}
#endif


#if UI
int function Ranked_GetTierCount()
{
	string rankedPeriodGUID = Ranked_GetCurrentPeriodGUIDString()
	array < SharedRankedTierData > currentTiers = file.historicalRankedTiers[ rankedPeriodGUID ]
	return currentTiers.len()
}

bool function Ranked_IsLocalPlayerInLadderOnlyTier()
{
	entity player 						 = GetLocalClientPlayer()
	int currentScore                     = GetPlayerRankScore( player )
	int ladderPosition                   = Ranked_GetLadderPosition( player  )
	SharedRankedDivisionData currentRank = GetCurrentRankedDivisionFromScoreAndLadderPosition( currentScore, ladderPosition )
	SharedRankedTierData currentTier     = currentRank.tier
	return currentTier.isLadderOnlyTier
}

array< featureTutorialTab > function Ranked_PopulateAboutText()
{
	array< featureTutorialTab > tabs

	featureTutorialTab tab1
	array< featureTutorialData > tab1Rules

	// Tab 1 contains surface overview of ranked play
	tab1.tabName = 	"#RANKED_ABOUT_TAB_1_NAME"
	// TODO - It would be preferable for us to make #RANKED_ABOUT_TAB_1_DESC_1 a dynamic string that can incorperate Ranked_RankedPartyMaxTierDifferential() instead of hardcoding the value into the string
	// https://jiratf.rspn.ad.ea.com/browse/R5DEV-588232
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_ABOUT_TAB_1_HEADER_1", "#RANKED_ABOUT_TAB_1_DESC_1", $"" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_ABOUT_TAB_1_HEADER_2", "#RANKED_ABOUT_TAB_1_DESC_2", $"" ) )
	tab1Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_ABOUT_TAB_1_HEADER_3", "#RANKED_ABOUT_TAB_1_DESC_3", $"" ) )

	tab1.rules = tab1Rules
	tabs.append( tab1 )

                     
	tab1.tabName = "#RANKED_TITLE"

	featureTutorialTab tab2
	array<featureTutorialData> tab2Rules
	tab2.tabName = "#RANKED_RUMBLE"

	tab2Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_RUMBLE_ABOUT_TAB_1_HEADER_1", "#RANKED_RUMBLE_ABOUT_TAB_1_DESC_1", $"" ) )
	tab2Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_RUMBLE_ABOUT_TAB_1_HEADER_2", "#RANKED_RUMBLE_ABOUT_TAB_1_DESC_2", $"" ) )
	tab2Rules.append( UI_FeatureTutorialDialog_BuildDetailsData( "#RANKED_RUMBLE_ABOUT_TAB_1_HEADER_3", "#RANKED_RUMBLE_ABOUT_TAB_1_DESC_3", $"" ) )

	tab2.rules = tab2Rules
	tabs.append( tab2 )
                          

	return tabs
}
#endif // UI

