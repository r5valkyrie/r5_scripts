void function SetPlayerRankScore( entity player, int score, int startingScore )
{
	if ( !IsRankedInSeason() )
		return
                     
	if ( RankedRumble_IsLatestGameRankedRumble( player ) )
		return
      
	SetRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME, score )
	StatsHook_RecordRankScoreStats( player, score )

	if ( startingScore != SHARED_RANKED_INVALID_RANK_SCORE )
	{
		SharedRankedDivisionData oldRank = GetCurrentRankedDivisionFromScore( startingScore ) // Deliberately only doing score, so will give us Master instead of Apex.
		SharedRankedDivisionData newRank = GetCurrentRankedDivisionFromScore( score ) // Deliberately only doing score, so will give us Master instead of Apex.

		if ( oldRank.index != newRank.index )
			PIN_PlayerRankedPlayDivisionChange( player, oldRank.divisionName, newRank.divisionName, eItemType.calevent_rankedperiod )
	}
	else if ( !player.IsBot() )
	{
		Assert( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
		SetRankedGameData( player, "lastGameStartingScore", score )
	}
}
#endif

#if SERVER || CLIENT
bool function Ranked_IsPlayerAbandoning( entity player )
//Needs to run on both server and client!
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
		return false

	if ( !GetCurrentPlaylistVarBool( "ranked_match_abandon_penalty", true ) )
		return false

	if ( bool( GetRankedGameData( player, "lastGameRankedForgiveness" ) ) )
		return false

	//TODO(chin): Expand out rankedDidPlayerEverHaveAFullTeam net var functionality to be set on server as and when
	//actions happen to make it safe for a player to abandon or not, instead of checking the state of the world at
	//the current time. All this script below then just becomes a check on the net var

	if ( Ranked_IsMatchOverForPlayer( player ) )
		return false

	if ( Ranked_IsDeadAndCanExitWithoutPenalty( player ) )
		return false

	if ( GetGameState() >= eGameState.Prematch && !SharedRanked_DidPlayerEverHaveAFullTeam( player ) ) //Once we get into skydiving; allow people to leave if they haven't had a full squad ever connected
		return false

	return true
}
#endif


#if SERVER || CLIENT
bool function SharedRanked_DidPlayerEverHaveAFullTeam( entity player )
//Has to run on both server and client for menu warning, so use a net var. Functioned off to make it easier to rewrite Ranked_IsPlayerAbandoning in the future
{
	return player.GetPlayerNetBool( "rankedDidPlayerEverHaveAFullTeam" )
}
#endif


#if SERVER || CLIENT
// TODO: do we actually ever use the switch?
int function SharedRanked_GetAbandonPenaltyLength( entity player )
{
	if( !IsValid( player ) )
		return 0

	int numGamesAbandoned = expect int ( player.GetPersistentVar( "numPenalizedAbandons" ) ) + 1
	if ( numGamesAbandoned == 0 )
		return 0

	int banLengthInSeconds = 0

	if ( GetCurrentPlaylistVarBool( "ranked_abandon_stacking_penalties", false ) )
	{
		switch( numGamesAbandoned )
		{
			case 1:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_1", 60 * 5 ) //5 minutes
				break

			case 2:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_2", 60 * 10 ) //10 minutes
				break

			case 3:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_3", 60 * 20 )  //20 minutes
				break

			case 4:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_4", 60 * 45 ) //45 minutes
				break

			case 5:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_5", 60 * 90 ) //90 minutes
				break

			case 6:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_6", 60 * 180 ) //180 minutes, i.e. 3 hours
				break

			case 7:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_7", 60 * 360 ) //360 minutes, i.e. 6 hours
				break

			case 8:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_8", 60 * 720 ) //720 minutes, i.e. 12 hours
				break

			case 9:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_9", 60 * 1440 ) //1 day
				break

			case 10:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_10", 60 * 1440 * 3 ) //3 days
				break

			case 11:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_11", 60 * 1440 * 5 )  //5 days
				break

			case 12:
			default:
				banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_12", 60 * 1440 * 7 ) //7 days, i.e. a week
				break
		}
	}
	else
	{
		banLengthInSeconds = GetCurrentPlaylistVarInt( "ranked_abandon_penalty_1", 60 * 10 ) //10 minutes
	}

	return banLengthInSeconds
}
#endif

