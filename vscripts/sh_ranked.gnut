//////////////////////////////
// STRYDER LOOKUP CALLBACKS //
//////////////////////////////
void function _InitXMergedPlatformRankedData( entity player )
{
	string lastPlat = ""
	foreach( int pId, string platformId in HARDWARE_TO_MERGED_PLATFORM )
	{
		if ( platformId == lastPlat ) // PS4 & PS5 | X1 & XB5 are same xMergePlat
			continue

		lastPlat = platformId

		player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME ), SHARED_RANKED_ROOKIE_FLOOR_VALUE )
		player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_PROVISIONAL_MATCH_COUNT_PERSISTENCE_VAR_NAME ), 0 )
		player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_SHOW_RANKED_SUMMARY_PERSISTENCE_VAR_NAME ), 0 )

		// "graduate" players immediately if Provisionals are *not* active.
		if ( GetConVarBool( RANKED_PROVISIONAL_MATCH_CONVAR_KILL_SWITCH ) )
			player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_PROVISIONAL_MATCH_HAS_PROGRESSED_OUT_PERSISTENCE_VAR_NAME ), 1 )
		else
			player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_PROVISIONAL_MATCH_HAS_PROGRESSED_OUT_PERSISTENCE_VAR_NAME ), 0 )

		                  
		player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, RANKED_TOP_5_STREAK_PERSISTENCE_VAR_NAME ), 0 )

		for (int i = 0; i < RANKED_NUM_PROVISIONAL_MATCHES; i++)
		{
			player.SetPersistentVar( format( XPROG_PERSISTENCE_FORMAT_STRING, platformId, format ( RANKED_PROVISONAL_MATCH_RESULTS_FORMAT_STRINGS, string ( i )  ), 0 ) , 0 )
		}
        

		RankedTrials_ResetXMergePlatformPersistenceData( player, platformId )
	}
}

void function Ranked_OnStryderConfirmSeasonOrSplitStart( entity player, string stryderLadderName, int rankScore, int rankPos )
{
	string periodGUIDString = Ranked_GetSeasonGUIDStringFromStryderLadderName( stryderLadderName )
	ItemFlavor rankedPeriod = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( periodGUIDString ) )
	Assert( rankedPeriod == Ranked_GetCurrentActiveRankedPeriod(), "StartPlayerRankedPeriod did not start the current ranked period." )

	if ( ItemFlavor_GetGUID( rankedPeriod ) == player.GetPersistentVarAsInt( RANKED_LAST_INITIALIZED_PERIOD_GUID_VAR_NAME ) )
		return // we got a duplicate start so do nothing.

	player.SetPersistentVar( RANKED_LAST_INITIALIZED_PERIOD_GUID_VAR_NAME, ItemFlavor_GetGUID( rankedPeriod ) )

	ItemFlavor previousPeriod = expect ItemFlavor ( GetPrecedingRankedPeriod( rankedPeriod ) )
	int prevRankScore         = Ranked_GetHistoricalRankScore( player, ItemFlavor_GetGUIDString( previousPeriod ) )

	SharedRankedDivisionData oldDivData = GetCurrentRankedDivisionFromScore( prevRankScore )
	SharedRankedDivisionData newDivData = GetCurrentRankedDivisionFromScore( rankScore )
	// a reset *might* not have actually triggered a division change for a player who doesn't play ranked much
	if ( oldDivData.index != newDivData.index )
	{
		if ( PIN_IsPlayerAdded( player ) )
			PIN_PlayerRankedPlayDivisionChange( player, oldDivData.divisionName, newDivData.divisionName, eItemType.calevent_rankedperiod )
		else
			Assert( false, "ERROR: Ranked - we somehow got a response from Stryder for a player who wasn't registered for PIN." )
	}

	if ( Ranked_IsRankedV2SecondSplit( rankedPeriod ) )
	{
		StatsHook_TransferWinStreak( player, ItemFlavor_GetGUIDString( previousPeriod ), periodGUIDString )
	}
	else
	{
		_InitXMergedPlatformRankedData( player )
	}

	Ranked_SetHistoricalRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME, rankScore, periodGUIDString )
	Ranked_SetHistoricalRankedPersistenceData( player, "highestRankedScore", rankScore, periodGUIDString )

	// we invalidate the rewardSeq here IF Provisional are *active*; then set it to 0 when the player gradautes from Provisionals
	if ( !GetConVarBool( RANKED_PROVISIONAL_MATCH_CONVAR_KILL_SWITCH ) )
		SetRankedPersistenceData( player, "rewardSeq", GRX_INVALID_SEQUENCE_NUMBER )

	if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod ) // TODO: for QA testing only
		Ranked_SetHistoricalRankedPersistenceData( player, "rankedInitialized", 1, periodGUIDString )

	Remote_CallFunction_UI( player, "ServerToUI_Ranked_NotifyRankedPeriodScoreChanged" )
}

void function Ranked_OnStryderConfirmEndSeasonOrSplitScore( entity player, string stryderLadderName, int rankScore, int rankPos, bool doRankedReset = true )
{
	printf( "RankedDebug: %s %s period=%s score=%d pos=%d", FUNC_NAME(), player.GetPlayerName(), stryderLadderName, rankScore, rankPos )
	Assert( rankPos != 0 && rankScore != SHARED_RANKED_INVALID_RANK_SCORE, format( "received an invalid value from Stryder for end of period %s.", stryderLadderName ) )
	if ( rankPos == 0 || rankScore == SHARED_RANKED_INVALID_RANK_SCORE )
		return // don't action. we should try again because Stryder gave us bad data.

	string periodGUIDString                 = Ranked_GetSeasonGUIDStringFromStryderLadderName( stryderLadderName )
	ItemFlavor rankedPeriod                 = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( periodGUIDString ) )
	string rankedLadderPersistenceFieldName = "endSeriesLadderPosition"

	bool isEndingASplit = ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod && Ranked_GetStryderLadderNameForHistoricalRankedPeriod( rankedPeriod, true ) == stryderLadderName
	if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod && SharedRankedPeriod_HasSplits( rankedPeriod ) )
	{
		if ( isEndingASplit )
		{
			rankedLadderPersistenceFieldName = "endFirstSplitLadderPosition"

			Ranked_SetHistoricalRankedPersistenceData( player, "firstSplitRankedScore", rankScore, periodGUIDString )

			// anyone ending a split currently didn't play the second phase, so just set their ladder pos to prevent trying to end an unplayed second split
			// if we use this logic for non-Cal-Event "splits," just block on check if CalEvent type
			// TODO: needed for QA only for testing - need to avoid clobbering data for QA testers who spoof into second period
			if ( Ranked_GetHistoricalRankScore( player, periodGUIDString ) <= SHARED_RANKED_ROOKIE_FLOOR_VALUE )
			{
				Ranked_SetHistoricalRankedPersistenceData( player, "endSeriesLadderPosition", -1, periodGUIDString )
				Ranked_SetHistoricalRankedPersistenceData( player, "highestRankedScore", GetConVarInt( "ranked_current_period_start_score" ), periodGUIDString )
			}
		}
	}

	Ranked_SetHistoricalRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME, rankScore, periodGUIDString )
	Ranked_SetHistoricalRankedPersistenceData( player, "highestRankedScore", rankScore, periodGUIDString )
	Ranked_SetHistoricalRankedPersistenceData( player, rankedLadderPersistenceFieldName, rankPos, periodGUIDString )

	//Set stats needed for badges
	StatsHook_SetRankedScore( player, MATCHRANKEDMODE_RANKED, periodGUIDString, rankScore )
	int badgeAwardLevel = Ranked_CalculateBadgeAwardLevelStat( player, rankScore, rankedPeriod, isEndingASplit )
	printf( "RankedDebug: %s %s period=%s score=%d badge_level=%d", FUNC_NAME(), player.GetPlayerName(), periodGUIDString, rankScore, badgeAwardLevel )
	StatsHook_SetRankedBadgeLevel( player, MATCHRANKEDMODE_RANKED, periodGUIDString, badgeAwardLevel )

	// reset the CLUI notification for non-Rookies in Seasons 13 - 16, *all* in Ranked 2.0, and *all* (Bronze+) in pre-S13
	// don't reset on splits, because we always need to end both halves of a split as we don't track whether a player only played in one half of a split
	SharedRankedTierData historicalTier = Ranked_GetHistoricalRankedDivisionFromScoreAndLadderPosition( rankScore, rankPos, periodGUIDString ).tier
	if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.ranked_2pt0_period || ( !isEndingASplit && ( historicalTier.index > 0 || CompareRankedPeriodStartTime( rankedPeriod , GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( RANKED_SEASON_13_GUIDSTRING ) ) ) < 0 ) ) )
		player.SetPersistentVar( "rankedRewardsAcknowledged", false )
	else
		player.SetPersistentVar( "rankedRewardsAcknowledged", true )

	if ( player.p.grxInitialized && GRX_IsInventoryReady( player ) ) // player.p.grxInitialized guarantees GRXScriptState exists
		Ranked_GiveRankedSeasonRewards( player )

	if ( doRankedReset )
		Ranked_HandleRankedResets( player ) // Just call this instead of trying to reset only that ranked period because this might not be the most recent expired period
}


void function Ranked_OnPlayerRankedLadderPositionFound( entity player, string rankedPeriodName, int rankPos, table<string, int> platformPositions )
{
	// Ranked Rumble position
	// NOTE: platformLadderPosition removed - not available in EHIScriptStruct
	// Cross-platform ladder positions skipped

	string ladderNameForLatestPeriod = Ranked_GetStryderLadderNameForLatestRankedPeriod()
	if ( ladderNameForLatestPeriod == rankedPeriodName )
	{
		if ( ( player in file.playersToCheckLadderPositions ) == false )
			return

		GetEHIScriptStruct( player ).rankedLadderPosition = rankPos
		file.playersToCheckLadderPositions[ player ] = false
		player.SetPlayerNetInt( "nv_currentRankedLadderPosition", rankPos )
	}
}

/////////////////////
// RESET FUNCTIONS //
/////////////////////
void function Ranked_HandleRankedResets( entity player )
{
	#if DEVELOPER
		//if ( GetConVarBool( "persistence_development_mode", false ) )
		if ( DEV_ShouldIgnorePersistence() )
			return
	#endif

	if ( !IsLobby() )
		return

	if ( IsPrivateMatch() )
		return

	if ( !GetCurrentPlaylistVarBool( "ranked_end_series_stryder_check", true ) )
		return

	if ( !IsMatchmakingServer() )
		return // Necessary because EndPlayerRankedPeriod() will cause an error when called outside of party dedis.

	ItemFlavor ornull activeRankedPeriod = Ranked_GetCurrentActiveRankedPeriod()
	if ( activeRankedPeriod == null )
		return

	expect ItemFlavor( activeRankedPeriod )
	int lastInitializedGUID = player.GetPersistentVarAsInt( RANKED_LAST_INITIALIZED_PERIOD_GUID_VAR_NAME )
	if ( IsValidItemFlavorGUID( lastInitializedGUID ) &&
			Ranked_GetStryderSequenceIdForHistoricalRankedPeriod( GetItemFlavorByGUID( lastInitializedGUID ), false ) >= Ranked_GetStryderSequenceIdForHistoricalRankedPeriod( activeRankedPeriod, false ) )
		return // If the current ranked season was initialized we don't need to check on previous ones.

	#if DEVELOPER
		// TODO: Make a Jira for once Dev Tool does this
		// in DEV ONLY, make sure we set this for QV accounts
		SetDemotionProtectionBuffer ( player, DEMOTION_BUFFER_MAX )
	#endif

	array<ItemFlavor> rankedPeriodList = Ranked_GetAllRankedPeriodsInAscendingChronologicalOrder()
	foreach ( ItemFlavor rankedPeriod in rankedPeriodList )
	{
		string rankedPeriodGUID = ItemFlavor_GetGUIDString( rankedPeriod )

		if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod )
		{
			if ( bool( Ranked_GetHistoricalRankedPersistenceData( player, "rankedInitialized", rankedPeriodGUID ) ) )
				continue
		}

		ItemFlavor ornull previousRankedPeriod = GetPrecedingRankedPeriod( rankedPeriod )
		if ( previousRankedPeriod != null )
		{
			expect ItemFlavor( previousRankedPeriod )
			string previousRankedPeriodGUID = ItemFlavor_GetGUIDString( previousRankedPeriod )
			bool playedGamesInPeriod = Ranked_PlayedGamesInPeriod( player, previousRankedPeriodGUID )

			// Check if we need to finalize first split of prior period with Styder
			// 0 is default in Persistence. Either want SHARED_RANKED_INVALID_LADDER_POSITION *OR* > 0
			if ( SharedRankedPeriod_HasSplits( previousRankedPeriod ) )
			{
				if ( playedGamesInPeriod && Ranked_GetHistoricalLadderPosition( player, previousRankedPeriodGUID, true ) == 0 )
				{
					string firstSplitStryderLadderName = Ranked_GetStryderLadderNameForHistoricalRankedPeriod( previousRankedPeriod, true )
					ConfirmPlayerRankedPeriod( player, firstSplitStryderLadderName, true, RANKED_2PT0_NON_SPLIT )
					return
				}
			}

			// Check if we need to finalize second - or only - split of prior period with Styder
			if ( playedGamesInPeriod && Ranked_GetHistoricalLadderPosition( player, previousRankedPeriodGUID ) == 0 )
			{
				string stryderPeriodName = Ranked_GetStryderLadderNameForHistoricalRankedPeriod( previousRankedPeriod, false )
				ConfirmPlayerRankedPeriod( player, stryderPeriodName, true, Ranked_GetRankedV2SplitStatus( previousRankedPeriod ) )
				return
			}

			// if they didn't play, just set their Ladder Pos to finalized default
			if ( !playedGamesInPeriod )
			{
				if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod )
					Ranked_SetHistoricalRankedPersistenceData( player, "endFirstSplitLadderPosition", SHARED_RANKED_INVALID_LADDER_POSITION, previousRankedPeriodGUID )

				Ranked_SetHistoricalRankedPersistenceData( player, "endSeriesLadderPosition", SHARED_RANKED_INVALID_LADDER_POSITION, previousRankedPeriodGUID )
			}
		} // END if ( previousRankedPeriod != null )

		if ( rankedPeriod == activeRankedPeriod )
			break // don't run the loop past the current stated ranked period; handles ConVar overrides, etc

		if ( ItemFlavor_GetType( rankedPeriod ) == eItemType.calevent_rankedperiod )
			Ranked_SetHistoricalRankedPersistenceData( player, "rankedInitialized", 1, rankedPeriodGUID )
	} // END foreach ( ItemFlavor rankedPeriod ... )

	if ( GetPlayerAccountLevel( player ) >= Ranked_GetRankedLevelRequirement() )
		ConfirmPlayerRankedPeriod( player, Ranked_GetStryderLadderNameForLatestRankedPeriod(), false, Ranked_GetRankedV2SplitStatus( expect ItemFlavor( Ranked_GetCurrentActiveRankedPeriod() ) ) )
}
#endif // SERVER


