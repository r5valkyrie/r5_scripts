#if SERVER || CLIENT
bool function Ranked_IsMatchOverForPlayer( entity player )
//Slightly different from player.p.hasMatchParticipationEnded, mainly used for abandon checks. Has to run on the client as well.
{
	if ( GetGameState() >= eGameState.WinnerDetermined )
		return true

	//Note that if you disconnect when you are the last person on your team alive this check means you are not abandoning. If you quit via menus while you are the last person your team alive this check means you *ARE* abandoning.
	if ( GetGameState() >= eGameState.Playing && GetPlayerArrayOfTeam_Alive( player.GetTeam() ).len() == 0 ) //We no longer spawn players on connect automatically, so cannot just check to see that we have no players alive on team.
		return true

	if ( PlayerMatchState_GetFor( player ) >= ePlayerMatchState.NORMAL )
	{
		switch ( player.GetPlayerNetInt( "respawnStatus" ) )
		{
			case eRespawnStatus.PICKUP_DESTROYED:
			// Perk_CanTeammateCraftPlayerBanner not available — fall through
			case eRespawnStatus.SQUAD_ELIMINATED: //i.e. can't be respawned anymore
				return true
		}
	}

	return false
}
#endif


#if SERVER || CLIENT
bool function Ranked_IsDeadAndCanExitWithoutPenalty( entity player )
{
	if ( IsAlive( player ) )
		return false

	if ( PlayerMatchState_GetFor( player ) < ePlayerMatchState.NORMAL )
		return false

	// We allow the dead player to exit the game without penalty only after a leaver
	// timer has started and finished.  The leaver penalty timer starts as soon as
	// one of the following conditions has been met:
	//
	// 1. The player's banner is picked up or crafted before it expires
	// 2. The banner expires without being collected or crafted

	int respawnStatus = player.GetPlayerNetInt( "respawnStatus" )
	float abandonPenaltyWaitPeriod = GetCurrentPlaylistVarFloat( "ranked_respawn_banner_pickedup_timeout", RANKED_LEAVER_PENALTY_TIME_LIMIT_SEC )
	float timeOfDeath = Time() // GetDeathTime() not available

	bool bannerCanBeCrafted = false // Perk_CanTeammateCraftPlayerBanner not available
      
                                
       
	float exitWithoutAbandonTime = 0.0

	// If the banner expired and hasn't been picked up or crafted,
	// we just need to check if we've waited long enough
	if ( respawnStatus == eRespawnStatus.PICKUP_DESTROYED )
	{
		if ( !bannerCanBeCrafted )
			return true

		exitWithoutAbandonTime = timeOfDeath + RESPAWN_DNA_LIFETIME + abandonPenaltyWaitPeriod
		return Time() > exitWithoutAbandonTime
	}

	// If the player's banner is in some teammate's hands, it may have
	// been pulled from the death box, or it may have been crafted after expiring
	if ( respawnStatus == eRespawnStatus.WAITING_FOR_DELIVERY )
	{
		float timeBannerRecovered = player.GetPlayerNetTime( "respawnBannerPickedUpTime" )
		Assert( timeBannerRecovered > -1 )

		bool bannerRecoveredBeforeBoxTimerExpired = ( timeBannerRecovered - timeOfDeath ) <= RESPAWN_DNA_LIFETIME

		if ( bannerRecoveredBeforeBoxTimerExpired )
			exitWithoutAbandonTime = timeBannerRecovered + abandonPenaltyWaitPeriod
		else
			exitWithoutAbandonTime = timeOfDeath + RESPAWN_DNA_LIFETIME + abandonPenaltyWaitPeriod

		return Time() > exitWithoutAbandonTime
	}

	// If we are in some other respawn state (e.g WAITING_FOR_PICKUP or WAITING_FOR_DROPPOD), the timer hasn't
	// started or we're in the process of being respawned
	return false
}

bool function Ranked_HasPlayerWaitedTooLongAfterBannerWasPickedUp( entity player )
{
	if ( IsAlive( player ) )
		return false

	if ( PlayerMatchState_GetFor( player ) < ePlayerMatchState.NORMAL )
		return false

	if ( player.GetPlayerNetInt( "respawnStatus" ) !=  eRespawnStatus.WAITING_FOR_DELIVERY )
		return false

	Assert( player.GetPlayerNetTime( "respawnBannerPickedUpTime" ) > -1 )
	float timeSinceBeaconPickedUp = Time() - player.GetPlayerNetTime( "respawnBannerPickedUpTime" )

	return (timeSinceBeaconPickedUp > GetCurrentPlaylistVarFloat( "ranked_respawn_banner_pickedup_timeout", 150.0 ))
}
#endif


