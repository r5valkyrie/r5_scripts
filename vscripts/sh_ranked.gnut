void function Ranked_OnPlayerConnected( entity player )
{
	#if DEVELOPER
	DEV_script_ranked_debug ( "Ranked_OnPlayerConnected " + player.GetPlayerName() + " has connected." )

	if ( DEV_ShouldIgnorePersistence() )
		return
	#endif

	#if DEVELOPER
	//if player without MMR
	if ( !player.IsBot() && !HasPlayerMMR(player) )
	{
		DEV_script_ranked_debug ( "Ranked_OnPlayerConnected " + player.GetPlayerName() + " without; setting MMR." )

		//acceptable values are 0 to 50
		float maxMMR = GetCurrentPlaylistVarFloat ( "Ranked_MMR_Random_Max", 50 )
		float minMMR = GetCurrentPlaylistVarFloat ( "Ranked_MMR_Random_Min", 0 )

		//acceptable values are 2 to 69.5
		float maxVariance = GetCurrentPlaylistVarFloat ( "Ranked_Variance_Random_Max", 69.5 )
		float minVariance = GetCurrentPlaylistVarFloat ( "Ranked_Variance_Random_Min", 2 )

		float mmr = RandomFloatRange ( minMMR, maxMMR )
		float variance = RandomFloatRange ( minVariance, maxVariance )

		SetPlayerMmrUtil (  player,  mmr,  variance )
	}

	if ( player.IsBot() )
	{
		DEV_script_ranked_debug ( "Ranked_OnPlayerConnected " + player.GetPlayerName() + " is a bot; setting MMR." )

		//We MUST to set a MMR
		if ( GetCurrentPlaylistVarBool ("Ranked_MMR_Random", true  )  )
		{
			//acceptable values are 0 to 50
			float maxMMR = GetCurrentPlaylistVarFloat ( "Ranked_MMR_Random_Max", 50 )
			float minMMR = GetCurrentPlaylistVarFloat ( "Ranked_MMR_Random_Min", 0 )

			//acceptable values are 2 to 69.6
			float maxVariance = GetCurrentPlaylistVarFloat ( "Ranked_Variance_Random_Max", 69.5 )
			float minVariance = GetCurrentPlaylistVarFloat ( "Ranked_Variance_Random_Min", 2 )

			float mmr = RandomFloatRange ( minMMR, maxMMR )
			float variance = RandomFloatRange ( minVariance, maxVariance )

			SetPlayerMmrUtil (  player,  mmr,  variance )
		}
		else
		{
			//assume we are setting a value;
			float mmr = GetCurrentPlaylistVarFloat ( "Ranked_MMR_Set" , 25 )
			float variance = GetCurrentPlaylistVarFloat ( "Ranked_Variance_Set" , 10 )

			SetPlayerMmrUtil (  player,  mmr,  variance )
		}

		if ( GetCurrentPlaylistVarBool ( "Ranked_BotRankedTier_Random" , true ) )
		{
			int maxLPForBot = GetCurrentPlaylistVarInt ( "Ranked_BotRankedTier_Random_Max", 15000 )
			int minLPForBot = GetCurrentPlaylistVarInt ( "Ranked_BotRankedTier_Random_Min", 0 )
			SetPlayerRankScore ( player, RandomIntRangeInclusive( minLPForBot, maxLPForBot ), SHARED_RANKED_INVALID_RANK_SCORE )
		}
		else if (GetCurrentPlaylistVarInt ( "Ranked_BotRankSet_LP" , -1 ) > 0 )
		{
			int lpToSet = GetCurrentPlaylistVarInt ( "Ranked_BotRankSet_LP" , 0 )
			SetPlayerRankScore ( player, lpToSet, SHARED_RANKED_INVALID_RANK_SCORE )
		}

	}
	#endif

	Assert( !IsLobby() )

	Ranked_SetXProgMergedPersistenceData( player, RANKED_SHOW_RANKED_SUMMARY_PERSISTENCE_VAR_NAME, GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) ? 1 : 0 )

	SetRankedGameData( player, "lastGameRankedForgiveness", 0 )
	SetRankedGameData( player, "lastGameRankedAbandon", 0 )
	SetRankedGameData( player, "lastGameAbandonForgiveness", 0 )

	//Set these scores all to 0 in the case that a server disconnects etc we don't show misleading info.
	SetRankedGameData( player, "lastGameKillScore", 0 )
	SetRankedGameData( player, "lastGamePlacementScore", 0 )
	SetRankedGameData( player, "lastGamePenaltyPointsForAbandoning", 0 )
	SetRankedGameData( player, "lastGameLossProtectionAdjustment", 0 )
	SetRankedGameData( player, "lastGameTierDerankingProtectionAdjustment", 0 )

	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
		return

	int score = GetPlayerRankScore( player )
	Ranked_UpdateEHIRankScore( ToEHI( player ), score )
	player.SetPlayerNetInt( "nv_currentRankedScore", score )

                        
                                                                                   
  
                                      
  
	     

	if ( Ranked_ShouldShowRankedBadge () )
	{
		Ranked_InitPrevRankBadges ( player )
	}

       

	SharedRankedDivisionData currentDivision = GetCurrentRankedDivisionFromScore( score ) //Deliberately only doing score, so will give us Master instead of Apex.
                   
	//If the player is in provisional, entry cost stays at zero
	int costOfEntry                          = ( Ranked_HasFinishedProvisionalMatches ( player ) ) ? -1 * Ranked_GetCostForEntry( currentDivision ) : 0

      
                                                                         
                                     
                                                                
       

	#if DEVELOPER
		DEV_script_ranked_debug ( "Setting inMatchRankScoreProgress for " + player.GetPlayerName() + " at the start of game with value: " + costOfEntry )
	#endif

	player.SetPlayerNetInt( "inMatchRankScoreProgress", costOfEntry )

	file.playerToMaxTeamSizeThisGameTable[ ToEHI( player ) ] <- 0
	array< entity > teamPlayers = GetPlayerArrayOfTeam( player.GetTeam() )
	foreach ( teamPlayer in teamPlayers )
	{
		EHI teamPlayerEHI = ToEHI( teamPlayer )
		if ( file.playerToMaxTeamSizeThisGameTable[ teamPlayerEHI ] < teamPlayers.len() )
			file.playerToMaxTeamSizeThisGameTable[ teamPlayerEHI ] = teamPlayers.len()

		if ( file.playerToMaxTeamSizeThisGameTable[ teamPlayerEHI ]  ==  GetMaxTeamPlayers() )
			teamPlayer.SetPlayerNetBool( "rankedDidPlayerEverHaveAFullTeam", true )
	}

	// TODO: Stryder handles this as well?
	thread SharedRanked_WaitRanked_CheckPlayerXPRequirement( player )

	if ( GetGameState() >= eGameState.PickLoadout ) // Handle rare case of players connecting late, past character select
	{
		if ( Ranked_ShouldCheckLadderPositionForPlayer( player ) && !(player in file.playersToCheckLadderPositions) ) // Check ladder position if they should be on the ladder
		{
			//printt( "Adding player " + player + " to list of players to check ladder position past character select"  )
			file.playersToCheckLadderPositions[ player ] <- true
			string periodName       = Ranked_GetStryderLadderNameForLatestRankedPeriod()
			LookupRankedPosForPlayers( periodName, [ player ] )
		}
	}

	//TODO needs to be fixed,  because someone could have died, and invalid information could be determined ...
	//if ( GetGameState() >= eGameState.Playing )
	//{
	//	MMR_Rank_MatchMMRCalculate()
	//}
}


void function SharedRanked_WaitRanked_CheckPlayerXPRequirement( entity player )
{
	EndSignal( player, "OnDestroy" )

	if ( player.IsBot() )
		return

	if ( GetCurrentPlaylistVarBool( RANKED_DEV_PLAYTEST_PLAYLIST_VAR, false ) )
		return

	// wait one frame to let all OnConnect callback execute
	WaitFrame()

	if ( GetPlayerAccountLevel( player ) < Ranked_GetRankedLevelRequirement() )
	{
		printt( "SharedRanked_WaitRanked_CheckPlayerXPRequirement - Kick player", player )
		KickMatchmakingCheater( player ) // forfeit and disconnect with appropriate message
	}
}


bool function Ranked_ShouldCheckLadderPositionForPlayer( entity player )
{
	int rankScore = GetPlayerRankScore( player )
	if ( file.ladderOnlyDivision != null )
		return rankScore >= expect SharedRankedDivisionData ( file.ladderOnlyDivision ).scoreMin

	if ( file.topRankedDivisionData.emblemDisplayMode == emblemDisplayMode.DISPLAY_LADDER_POSITION )
		return rankScore >= file.topRankedDivisionData.scoreMin

	return false
}
