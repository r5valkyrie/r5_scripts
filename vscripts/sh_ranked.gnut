void function ServerToClient_Ranked_UpdatePlayerPrevRankedScore( entity player, int score )
{
	if ( IsLobby() )
		return

	if ( score == SHARED_RANKED_INVALID_RANK_SCORE )
		return

	if ( !IsValid( player ) )
		return

	EHI playerEHI = ToEHI( player )
	Ranked_UpdateEHIRankScorePrevSeason( playerEHI, score )
}

void function ServerToClient_Ranked_UpdatePlayerPrevLadderPos( entity player, int pos )
{
	if ( IsLobby() )
		return

	if ( pos == SHARED_RANKED_INVALID_LADDER_POSITION )
		return

	if ( !IsValid( player ) )
		return

	EHI playerEHI = ToEHI( player )
	Ranked_UpdateEHIRankedLadderPositionPrevSeason( playerEHI, pos )
}
#endif

SharedRankedDivisionData function Ranked_GetHistoricalRankedDivisionFromScoreAndLadderPosition( int rankScore, int ladderPosition, string rankedSeasonGUID )
{
	if ( Ranked_PeriodHasLadderOnlyDivision( rankedSeasonGUID ) )
	{
		int historicalNumPlayersOnLadder = Ranked_GetHistoricalNumPlayersOnLadder( rankedSeasonGUID )
		if ( ladderPosition != SHARED_RANKED_INVALID_LADDER_POSITION && ladderPosition > 0 && ladderPosition <= historicalNumPlayersOnLadder ) //Need to explicitly check for 0 since 0 is default in persistence :(
			return Ranked_GetHistoricalLadderOnlyDivision( rankedSeasonGUID )
	}

	return Ranked_GetHistoricalRankedDivisionFromScore( rankScore, rankedSeasonGUID )

	unreachable
}

array<SharedRankedTierData> function Ranked_GetHistoricalRankedTiers( string rankedSeasonGUID )
{
	return file.historicalRankedTiers[rankedSeasonGUID]
}

int function Ranked_GetHistoricalLadderPosition( entity player, string rankedSeasonGUID, bool forFirstSplit = false )
{
	Assert( rankedSeasonGUID in file.historicalRankedDivisions )
	ItemFlavor historicalRankedPeriod = GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( rankedSeasonGUID ) )

	if ( !SharedRankedPeriod_HasSplits( historicalRankedPeriod ) || !forFirstSplit )
		return expect int ( Ranked_GetHistoricalRankedPersistenceData( player, "endSeriesLadderPosition", rankedSeasonGUID ) )

	if ( SharedRankedPeriod_HasSplits( historicalRankedPeriod ) && forFirstSplit )
		return expect int ( Ranked_GetHistoricalRankedPersistenceData( player, "endFirstSplitLadderPosition", rankedSeasonGUID ) )

	unreachable
}

bool function Ranked_PlayerDeservesRewardsInPeriod(entity player, string rankedPeriodGUID )
{
	// we invalidate the rewardSeq var at season start and only set it to 0 when a player graduates from Provisionals
	return Ranked_GetHistoricalRankedPersistenceData( player, "rewardSeq", rankedPeriodGUID ) != GRX_INVALID_SEQUENCE_NUMBER
}


var function Ranked_GetHistoricalRankedPersistenceData( entity player, string persistenceField, string rankedSeasonGUID )
{
	#if DEVELOPER
		if ( DEV_ShouldIgnorePersistence() )
			return null
	#endif

	Assert( rankedSeasonGUID in file.historicalRankedTiers )
	if ( ItemFlavor_GetType( GetItemFlavorByGUID( ConvertItemFlavorGUIDStringToGUID( rankedSeasonGUID ) ) ) == eItemType.ranked_2pt0_period )
	{
		Assert( RANKED_2PT0_PERSISTENCE_FIELDS.contains( persistenceField ) )
		if ( !(RANKED_2PT0_PERSISTENCE_FIELDS.contains( persistenceField )) )
			return null
		#if UI
			return GetPersistentVar( "rankedPeriodData[" + rankedSeasonGUID + "]." + persistenceField )
		#else
			return player.GetPersistentVar( "rankedPeriodData[" + rankedSeasonGUID + "]." + persistenceField )
		#endif
	}
	else
	{
		#if UI
			return GetPersistentVar( "allRankedData[" + rankedSeasonGUID + "]." + persistenceField )
		#else
			return player.GetPersistentVar( "allRankedData[" + rankedSeasonGUID + "]." + persistenceField )
		#endif
	}

	unreachable
}


int function GetPrevSeasonPeakPlayerRankScore( entity player )
{
#if UI
	if ( !IsFullyConnected() )
		return 0
#endif

#if CLIENT
	if ( !IsConnected() )
		return 0
#endif

	#if SERVER
		int score = -1
		ItemFlavor ornull latestRankedPeriod = Ranked_GetCurrentActiveRankedPeriod()

		if ( latestRankedPeriod == null )
			return 0

		expect ItemFlavor ( latestRankedPeriod )

		ItemFlavor ornull previousRankedPeriod = GetPrecedingRankedPeriod( latestRankedPeriod )

		if ( previousRankedPeriod == null )
			return 0

		expect ItemFlavor ( previousRankedPeriod )

		if ( SharedRankedPeriod_HasSplits( previousRankedPeriod ) )
		{
			score = Ranked_GetHistoricalRankScoreAcrossSplitsForPlayer ( player, previousRankedPeriod )
		}
		else
		{
			string previousRankedPeriodRef = ItemFlavor_GetGUIDString( previousRankedPeriod )
			score = Ranked_GetHistoricalRankScore ( player, previousRankedPeriodRef, true )
		}

		if ( score == -1 )
			return 0

		return score
	#endif

	#if CLIENT
		Assert( !IsLobby() )
		EHI playerEHI = ToEHI( player )
		return GetEHIScriptStruct( playerEHI ).rankScorePrevSeason
	#endif

	#if UI
		if ( !IsLobby() )
		{
			EHI playerEHI = ToEHI( player )
			return GetEHIScriptStruct( playerEHI ).rankScorePrevSeason
		}
		else
		{
			Assert( player == GetLocalClientPlayer() )
			int score = -1
			ItemFlavor ornull latestRankedPeriod = Ranked_GetCurrentActiveRankedPeriod()

			if ( latestRankedPeriod == null )
				return 0

			expect ItemFlavor ( latestRankedPeriod )

			ItemFlavor ornull previousRankedPeriod = GetPrecedingRankedPeriod( latestRankedPeriod )

			if ( previousRankedPeriod == null )
				return 0

			expect ItemFlavor ( previousRankedPeriod )

			if ( SharedRankedPeriod_HasSplits( previousRankedPeriod ) )
			{
				score = Ranked_GetHistoricalRankScoreAcrossSplitsForPlayer ( player, previousRankedPeriod )
			}
			else
			{
				string previousRankedPeriodRef = ItemFlavor_GetGUIDString( previousRankedPeriod )
				score = Ranked_GetHistoricalRankScore ( player, previousRankedPeriodRef, true )
			}

			if ( score == -1 )
				return 0

			return score
		}
	#endif

	unreachable
}


int function GetPlayerRankScore( entity player )
{
#if UI
	if ( !IsFullyConnected() )
		return 0
#endif

#if CLIENT
	if ( !IsConnected() )
		return 0
#endif

	#if SERVER
		// GetPlayerRankScoreFromClientData not available — use persistence data directly
		int score = GetRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME )
		return score
	#endif

	#if CLIENT
		Assert( !IsLobby() )
		EHI playerEHI = ToEHI( player )
		return GetEHIScriptStruct( playerEHI ).rankScore
	#endif

	#if UI
		if ( !IsLobby() )
		{
			EHI playerEHI = ToEHI( player )
			return GetEHIScriptStruct( playerEHI ).rankScore
		}
		else
		{
			Assert( player == GetLocalClientPlayer() )

			int score
			if ( GetCurrentPlaylistVarBool( "use_user_stats_for_rp", true ) )
			{
				CommunityUserInfo ornull cui = GetUserInfo( GetPlayerHardware(), GetPlayerUID() )

				if ( cui == null )
				{
					score = GetRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME )
				}
				else
				{
				expect CommunityUserInfo( cui )
				score = cui.rankScore
			}
			}
			else
			{
				score = GetRankedPersistenceData( player, RANKED_CURRENT_SCORE_PERSISTENCE_VAR_NAME )
			}

			return score
		}
	#endif

	unreachable
}

