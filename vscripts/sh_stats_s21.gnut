void function StatsHook_S21_Solo_Games_Wins( entity player )
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) || !IsValid( player ) )
	{
		return
	}

	if ( !Stats_PlayerIsValidForStats( player ) )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_solo_games_wins ), 1 )
}

void function StatsHook_S21_Solo_Placement_Top_10_with_10_Legends( entity player, string characterGUID )
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SOLOS ) )
	{
		return
	}
	
	if ( !IsValid( player ) )
	{
		return
	}

	if ( !Stats_PlayerIsValidForStats( player ) )
	{
		return
	}

	table< string, int > characterGUIDToBitmaskMap = StatsDefs_GetCharacterGUIDToBitmaskMap()
	if ( !( characterGUID in characterGUIDToBitmaskMap ) )
	{
		Warning( format( "Character with SAID %s does not have stats enabled; skipping write to stats.gamemode_solo_placement_top_10_with_10_legends", characterGUID ) )
		return
	}

	StatEntry stat = ResolveStatEntry( CAREER_STATS.gamemode_solo_placement_top_10_with_10_legends )
	__SetFlagStat_Int( player, stat, characterGUIDToBitmaskMap[ characterGUID ], false )
}
                                     

                               
bool function StatsCheck_S21_Quads_IsValid( entity player )
{
	if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_QUADS ) )
	{
		return false
	}

	if ( !IsValid( player ) || !Stats_PlayerIsValidForStats( player ) )
	{
		return false
	}

	return true
}

void function StatsHook_S21_Quad_GamesPlayed( entity player, int amount )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	if ( amount <= 0 )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_games_played ), amount )
}

void function StatsHook_S21_Quad_DamageDone( entity player, int amount )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	if ( amount <= 0 )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_damage_done ), amount )
}

void function StatsHook_S21_Quad_DamageDoneMaxSingleGame( entity player, int amount )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	if ( amount <= 0 )
	{
		return
	}

	int oldMaxDamage = GetStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_damage_done_max_in_one_game ), eStatGetWhen.CURRENT )
	if ( amount < oldMaxDamage )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_damage_done_max_in_one_game ), amount - oldMaxDamage )
}

void function StatsHook_S21_Quad_Kills( entity player, int amount )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	if ( amount <= 0 )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_kills ), amount )
}

void function StatsHook_S21_Quad_PlacementTop5( entity player )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_placement_top_5 ), 1 )
}

void function StatsHook_S21_Quad_PremadeWin( entity player )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	bool isFullPremadeParty = player.GetPartySize() == 4 // 4 since we're in quads
	if ( !isFullPremadeParty )
	{
		return
	}


	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_premade_win ), 1 )
}

void function StatsHook_S21_Quad_PlacementTop5With10Legends( entity player, string characterGUID )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	table< string, int > characterGUIDToBitmaskMap = StatsDefs_GetCharacterGUIDToBitmaskMap()
	if ( !( characterGUID in characterGUIDToBitmaskMap ) )
	{
		Warning( format( "Character with SAID %s does not have stats enabled; skipping write to stats.gamemode_quad_placement_top_5_with_10_legends", characterGUID ) )
		return
	}

	StatEntry stat = ResolveStatEntry( CAREER_STATS.gamemode_quad_placement_top_5_with_10_legends )
	__SetFlagStat_Int( player, stat, characterGUIDToBitmaskMap[ characterGUID ], false )
}

void function StatsHook_S21_Quad_Knockdowns( entity player )
{
	if ( !StatsCheck_S21_Quads_IsValid( player ) )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_quad_knockdowns ), 1 )
}
                                     

                       
void function StatsHook_S21_BigTDM_GamesPlayed( entity player, int amount )
{
	if ( !BigTDM_IsModeEnabled() )
	{
		return
	}

	if ( !IsValid( player ) || !Stats_PlayerIsValidForStats( player ) )
	{
		return
	}

	if ( amount <= 0 )
	{
		return
	}

	__IncrementStat_Int( player, ResolveStatEntry( CAREER_STATS.gamemode_bigtdm_games_played ), amount )
}
                             

#endif // SERVER
                          