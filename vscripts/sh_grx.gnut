#if CLIENT
void function ClientCodeCallback_GRXPackOpened( array<int> balanceDiffs, array<int> newItems, int packError )
{
	ItemFlavorBag bag

	for ( int currencyIndex = 0; currencyIndex < GRX_CURRENCY_COUNT; currencyIndex++ )
	{
		ItemFlavor currency = GRX_CURRENCIES[currencyIndex]
		int diff            = balanceDiffs[currencyIndex]
		if ( diff != 0 )
		{
			bag.flavors.append( currency )
			bag.quantities.append( diff )
		}
	}

	foreach ( int itemGRXIndex in newItems )
	{
		ItemFlavor flav = GetItemFlavorByGRXIndex( itemGRXIndex )
		bag.flavors.append( flav )
		bag.quantities.append( 1 )

		Newness_TEMP_MarkItemAsNewAndInformServer( flav )
	}

	#if GRX_DEBUG_PRINTS
		if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
		{
			GRXDbg( null, "" )
			foreach ( int flavIndex, ItemFlavor flav in bag.flavors )
			{
				GRXDbg( null, "",
					"flav", DEV_DescItemFlavor( flav ),
					"name", Localize( ItemFlavor_GetLongName( flav ) ),
					"qty", bag.quantities[flavIndex] )
			}
		}
	#endif

	// Assert( fileLevel.mostRecentPackOpeningResultsOrNull == null ) // it's ok if the results haven't been used for some pack openings
	if ( packError != GRX_INVENTORYERROR_NONE )
	{
		bag.associatedError = packError
		#if GRX_DEBUG_PRINTS
			if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
				GRXDbg( null, "", "packError", packError )
		#endif
	}

	#if DEVELOPER
		int menuHeirloomOverrideGUID = DEV_GetMenuHeirloomOverrideGUID()

		if ( menuHeirloomOverrideGUID >= 0 )
		{
			ItemFlavor item = GetItemFlavorByGUID( menuHeirloomOverrideGUID )
			bag.flavors.append( item )
			bag.flavors.append( item )
			bag.flavors.append( item )
			bag.quantities.append( 1 )
			bag.quantities.append( 1 )
			bag.quantities.append( 1 )
			bag.associatedError = GRX_INVENTORYERROR_NONE
		}
		else if ( DEV_GRX_ForcePackResults_resultsOrNull != null )
		{
			printt( "PACK RESULTS FORCED!!" )
			bag = expect ItemFlavorBag(DEV_GRX_ForcePackResults_resultsOrNull)
		}
	#endif

	RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Start", bag.associatedError )
	foreach ( int flavIdx, ItemFlavor flav in bag.flavors )
		RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Entry", ItemFlavor_GetGUID( flav ), bag.quantities[flavIdx] )
	RunUIScript( "ClientToUI_WORKAROUND_GRXPackOpened_Finish" )

	fileLevel.mostRecentPackOpeningResultsOrNull = bag
}
#endif


#if SERVER
int function GRX_GrantRewards( entity player, GrantRewardsConfig cfg )
{
	bool isGrantAsync = false

	Assert( IsItemFlavorBagValid( cfg.what, true, eValidation.ASSERT ) )

	ItemFlavorBag immediateItems
	ItemFlavorBag grxItems

	foreach ( int thingIdx, ItemFlavor thingFlav in cfg.what.flavors )
	{
		if ( ItemFlavor_IsItemDisabledForGRX( thingFlav ) )
			return eGrantRewardsResult.ASYNC // prevent bad Marketplace calls and mark as ASYNC even though we're failing so that we can retry

		int thingQty = cfg.what.quantities[thingIdx]

		Assert( ItemFlavor_GetGRXMode( thingFlav ) != eItemFlavorGRXMode.OWNERSHIP_TARGET )
		bool isGRXFlav = (ItemFlavor_GetGRXMode( thingFlav ) != eItemFlavorGRXMode.NONE)

		bool isVoucher = (ItemFlavor_GetType( thingFlav ) == eItemType.voucher)
		if ( isVoucher )
		{
			bool rewardVoucherUsingGRX = __VoucherRewardImmediateOrGRXLogic( thingFlav )
			Assert( rewardVoucherUsingGRX == isGRXFlav )
		}

		if ( isGRXFlav )
		{
			grxItems.flavors.append( thingFlav )
			grxItems.quantities.append( thingQty )

			if ( ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.CURRENCY
			|| ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.CONSUMABLE
			|| ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.PACK )
			{
				Assert( cfg.rewardSequenceName != "", "Cannot give currency or stackable items without using a reward sequence" )
			}
		}
		else
		{
			Assert( isVoucher, format(
				"GRX_GrantRewards called with an item that must be a GRX item but is not: %s",
				string(ItemFlavor_GetAsset( thingFlav )) ) )
			immediateItems.flavors.append( thingFlav )
			immediateItems.quantities.append( thingQty )
		}
	}

	#if GRX_DEBUG_PRINTS
		if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
		{
			GRXDbg( player, "",
				"calledFrom", FUNC_NAME( 1 ),
				"immediateItems", DEV_DescribeItemFlavorBag( immediateItems ),
				"grxItems", DEV_DescribeItemFlavorBag( grxItems ),
				"sourceFlav", DEV_DescItemFlavor( cfg.sourceFlav ),
				"sourceExtraData", cfg.sourceExtraData,
				"showCeremony", cfg.showCeremony,
				"markAsNew", cfg.markAsNew,
				"allowAlreadyOwned", cfg.allowAlreadyOwned,
				"rewardSequenceName", cfg.rewardSequenceName,
				"rewardSequenceExpectedIdx", cfg.rewardSequenceExpectedIdx,
				"rewardSequenceDesiredIdx", cfg.rewardSequenceDesiredIdx )
		}
	#endif

	Assert( !(immediateItems.flavors.len() > 0 && grxItems.flavors.len() > 0), format(
		"Called GRX_GrantRewards with items that are rewarded immediately AND items that are awarded asynchronously. This is not yet supported. (immediate=%s; async=%s)",
		DEV_DescribeItemFlavorBag( immediateItems ), DEV_DescribeItemFlavorBag( grxItems ) ) )

	if ( immediateItems.flavors.len() > 0 )
	{
		foreach ( int thingIdx, ItemFlavor thingFlav in immediateItems.flavors )
		{
			int thingQty = cfg.what.quantities[thingIdx]
			if ( ItemFlavor_GetType( thingFlav ) == eItemType.voucher )
			{
				__VoucherDoImmediateReward( player, thingFlav, thingQty, cfg.sourceFlav )
			}
		}
	}

	if ( grxItems.flavors.len() > 0 || cfg.rewardSequenceName != "" )
	{
		bool functionref(bool, bool) putItemsInPersistenceQueue = bool function( bool doGive, bool doCeremony ) : (player, cfg, grxItems) {
			bool hadIssues = false
			// todo(dw): make this support multiple item flavors and quantities greater than 1 (if necessary)

			if ( grxItems.flavors.len() == 0 )
			{
				return !hadIssues
			}

			foreach ( int thingIdx, ItemFlavor thingFlav in grxItems.flavors )
			{
				if ( ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.CURRENCY
				|| ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.CONSUMABLE
				|| ItemFlavor_GetGRXMode( thingFlav ) == eItemFlavorGRXMode.PACK )
				{
					Assert( !doGive, format( "To give more than currency, packs or other stackables with GRX_GrantRewards, you need to use a reward sequence (%s).", DEV_DescribeItemFlavorBag( grxItems ) ) )
					if ( doGive )
						hadIssues = true

					if ( hadIssues )
						return !hadIssues
				}
			}

			bool startingDoGive = doGive
			foreach( int index, ItemFlavor singleRewardItemFlav in grxItems.flavors )
			{
				doGive = startingDoGive
				int singleRewardQuantity = grxItems.quantities[ index ]

				if ( GRX_IsInventoryReady( player ) && GRX_HasItem( player, ItemFlavor_GetGRXIndex( singleRewardItemFlav ) ) )
				{
					if ( !cfg.allowAlreadyOwned )
						Warning( "Passed an item flavor to GRX_GrantRewards that the player already owns: %s", string(ItemFlavor_GetAsset( singleRewardItemFlav )) )
					// If somehow a player already owns the item, just let things be
					doGive = false
				}

				if ( doGive || doCeremony )
				{
					int singleRewardItemFlavGUID = ItemFlavor_GetGUID( singleRewardItemFlav )

					int chosenPersistentArrayIdx = -1
					for ( int persistentArrayIdx = 0; persistentArrayIdx < QUEUED_REWARDS_MAX_COUNT; persistentArrayIdx++ )
					{
						Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
						int existingGUID = player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ) )
						if ( existingGUID == singleRewardItemFlavGUID )
						{
							Warning( "Passed an item flavor to GRX_GrantRewards that is already queued: %s", string(ItemFlavor_GetAsset( singleRewardItemFlav )) )
							chosenPersistentArrayIdx = -2
						}
						else if ( existingGUID == 0 && chosenPersistentArrayIdx == -1 )
						{
							chosenPersistentArrayIdx = persistentArrayIdx
						}
					}

					if ( chosenPersistentArrayIdx == -1 && doGive && GetConVarBool( "mtx_allowClearUnackedRewards" ) )
					{
						// We've run out of empty slots; try to clear out a reward that has been granted but not acknowledged
						for ( int i = 0; i < QUEUED_REWARDS_MAX_COUNT; ++i  )
						{
							bool isRewardGiven = expect bool( player.GetPersistentVar( format( "grxQueuedRewards[%d].rewardGiven", i ) ) )
							bool isRewardAcknowledged = expect bool ( player.GetPersistentVar( format( "grxQueuedRewards[%d].rewardAcknowledged", i ) ) )
							if ( isRewardGiven && !isRewardAcknowledged )
							{
								ClearQueuedPersistenceAward( player, i )
								chosenPersistentArrayIdx = i
								break
							}
						}
					}

					if ( chosenPersistentArrayIdx >= 0 )
					{
						Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].sourceGUID", chosenPersistentArrayIdx ), cfg.sourceFlav != null ? ItemFlavor_GetGUID( expect ItemFlavor( cfg.sourceFlav ) ) : 0 )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].sourceGUID_extraData", chosenPersistentArrayIdx ), cfg.sourceExtraData )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGUIDs[0]", chosenPersistentArrayIdx ), ItemFlavor_GetGUID( singleRewardItemFlav ) )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardQuantities[0]", chosenPersistentArrayIdx ), singleRewardQuantity )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGiven", chosenPersistentArrayIdx ), doGive ? false : true )
						player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardAcknowledged", chosenPersistentArrayIdx ), doCeremony ? false : true )
					}
					else if ( chosenPersistentArrayIdx == -1 )
					{
						// We ran out of slots!
						bool isFatal = true
#if ASSERTS
						isFatal = GetCurrentPlaylistVarBool( "grx_reward_queue_full_is_fatal", true )

						string errMsg = format( "GRX_GrantRewards could not queue any more rewards for player %s. Tried to queue '%s' (x%d) and there was already:",
							string(player), string(ItemFlavor_GetAsset( singleRewardItemFlav )), singleRewardQuantity )

						for ( int persistentArrayIdx = 0; persistentArrayIdx < QUEUED_REWARDS_MAX_COUNT; persistentArrayIdx++ )
						{
							Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
							errMsg += format( "\n - '%s' (x%d)",
								string(ItemFlavor_GetAsset( GetItemFlavorByGUID( player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ) ) )) ),
								player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardQuantities[0]", persistentArrayIdx ) )
							)
						}

						if ( isFatal )
						{
							Assert( false, errMsg )
						}
						else
						{
							Warning( errMsg )
						}
#endif // ASSERTS
						if ( isFatal )
						{
							if ( doGive && GetConVarBool( "script_R5DEV_220022_Disconnect" ) )
							{
								//TODO(chin): What happens if we are in a bad spot where the rewards are not given yet? Probably real bad news!
								//Now that we've cleared it out, disconnect the player and make them go through the same flow again, now hopefully with space in the array
								thread GRX_DisconnectPlayerWithMessage( player, "#DISCONNECT_SCRIPTKICK_GRXSLOTS" )
							}
						}

						hadIssues = true
					}
				}
			}
			return !hadIssues
		}

		void functionref( bool wasSuccessful ) onDone = void function( bool wasSuccessful ) : ( player, cfg, grxItems ) {
			if ( cfg.markAsNew )
				Newness_MarkItemFlavorsAsNewForPlayer( player, grxItems.flavors )
		}

		// IF the grant comes with its rewardSequence, it will be marked as new with DisplayQueuedRewardsGiven() instead of the onDone callback above.
	    // But DisplayQueuedRewardsGiven() overrides cfg.markAsNew so adding an assert to prevent marking rewards as new incorrectly.
		if ( cfg.markAsNew == false && cfg.showCeremony == true )
		{
			Assert( false, format( "Called GRX_GrantRewards with cfg.markAsNew == false, but its ceremony dialog will mark rewards as new : flav=%s, rewardSeqName=%s",
				ItemFlavor_GetHumanReadableRefForPIN_Slow( expect ItemFlavor( cfg.sourceFlav ) ), cfg.rewardSequenceName ) )
		}

		if ( cfg.rewardSequenceName == "" )
		{
			bool doGive       = true
			bool wasSuccesful = putItemsInPersistenceQueue( doGive, cfg.showCeremony )
			if ( wasSuccesful )
			{
				onDone( wasSuccesful )
			}
			else
			{
				isGrantAsync = true  // Mark it as async, even though we're not actually starting a query. This will prevent things like challenges from advancing, so we try to give the reward again later.
			}
		}
		else
		{
			if ( !IsLobby() )
			{
				isGrantAsync = true
				return (isGrantAsync ? eGrantRewardsResult.ASYNC : eGrantRewardsResult.DONE) // Cannot do GRX operations mid-match
			}

			int currentSeqNum  = GRX_GetSequenceNumber( player, cfg.rewardSequenceName ) // don't need to check validity of seq, because that will happen based on expected/desired value
			int expectedSeqNum = cfg.rewardSequenceExpectedIdx
			int desiredSeqNum  = cfg.rewardSequenceDesiredIdx
			Assert( desiredSeqNum > expectedSeqNum ) // (D > E)

			if ( currentSeqNum == expectedSeqNum )
			{
				// (C == E)
				// Marketplace and persistence are in sync
				// (C5 E5 D6)

				// Fallthrough -- do operation
			}
			else if ( currentSeqNum > expectedSeqNum )
			{
				// (C > E)
				// Marketplace is ahead of script
				// (C5 E2 D3)

				if ( desiredSeqNum > currentSeqNum )
				{
					// (D > C)
					// Script is SKIPPING OVER the current Marketplace seq num. Shouldn't be possible...
					// (C5 E2 D9)
					Assert( false, "Desired seq num > current seq num. " + cfg.rewardSequenceName + ". Current Seq Num: " + string( currentSeqNum ) + ", expected seq num: " + string( expectedSeqNum ) + ", desired seq num: " + string( desiredSeqNum ) )
					
					return eGrantRewardsResult.ASYNC // don't do op
				}

				if ( GetCurrentPlaylistVarBool( "challenge_persistence_marketplace_mismatch_fix", true ) )
				{
					// Assume rewards given OK
					onDone( true )
					return eGrantRewardsResult.DONE
				}
				else
				{
					// Fallthrough -- try operation
				}
			}
			else if ( currentSeqNum < expectedSeqNum )
			{
				// (C < E)
				// Marketplace is behind script
				// (C5 E8 D9)
				Assert( false, "currentSeqNum < expectedSeqNum. " + cfg.rewardSequenceName +  ". Current Seq Num: " + string( currentSeqNum ) + ", expected seq num: " + string( expectedSeqNum ) + ", desired seq num: " + string( desiredSeqNum ) )
				return eGrantRewardsResult.ASYNC // don't do op
			}
			else unreachable

			ScriptGRXOperationInfo operation
			if ( cfg.rewardSequenceQueryGoalID != -1 )
			{
				Assert( cfg.rewardSequenceQueryGoalID == GRX_HTTPQUERYGOAL_GIVE_EVENT_SEQUENCE_REWARD ||
						cfg.rewardSequenceQueryGoalID == GRX_HTTPQUERYGOAL_GIVE_BONUS_UNKNOWN_SEQUENCE_REWARD ||
						cfg.rewardSequenceQueryGoalID == GRX_HTTPQUERYGOAL_GIVE_QUEST_SEQUENCE_REWARD ||
						cfg.rewardSequenceQueryGoalID == GRX_HTTPQUERYGOAL_GIVE_HEIRLOOM_SEQUENCE_REWARD , format( "%d is an invalid reward sequence query goal", cfg.rewardSequenceQueryGoalID ) )
				operation.expectedQueryGoal = cfg.rewardSequenceQueryGoalID
			}
			else
			{
				cfg.rewardSequenceQueryGoalID = GRX_HTTPQUERYGOAL_GIVE_BONUS_UNKNOWN_SEQUENCE_REWARD
				operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_BONUS_UNKNOWN_SEQUENCE_REWARD
			}
			operation.doOperationFunc = (void function( int opID ) : ( player, cfg, currentSeqNum, desiredSeqNum, grxItems )
			{
				GRX_GiveSequenceRewardEasy( player, opID, cfg.rewardSequenceQueryGoalID, cfg.rewardSequenceName, currentSeqNum, desiredSeqNum, grxItems )
			})
			operation.onDoneCallback = (void function( int status ) : ( player, cfg, desiredSeqNum, putItemsInPersistenceQueue ) {
				bool wasSuccessful = (status == eScriptGRXOperationStatus.DONE_SUCCESS)

				if ( wasSuccessful && GRX_GetSequenceNumber( player, cfg.rewardSequenceName ) < desiredSeqNum )
				{
					Assert( false, format(
						"Expected reward sequence %s for player %s to be at %d but it was at %d",
						cfg.rewardSequenceName, string(player), desiredSeqNum, GRX_GetSequenceNumber( player, cfg.rewardSequenceName ) ) )
					wasSuccessful = false
				}

				if ( cfg.onAsyncGrantRewardComplete != null )
					cfg.onAsyncGrantRewardComplete( wasSuccessful )

				if ( wasSuccessful && cfg.showCeremony )
				{
					bool wasCeremonyQueueSuccessful = putItemsInPersistenceQueue( false, cfg.showCeremony )
					Assert( wasCeremonyQueueSuccessful )
				}
			})
			QueueGRXOperation( player, operation )
			isGrantAsync = true
		}
	}

	return (isGrantAsync ? eGrantRewardsResult.ASYNC : eGrantRewardsResult.DONE)
}
#endif


#if SERVER
void function GRX_DisconnectPlayerWithMessage( entity player, string errorMessage )
{
	EndSignal( player, "OnDestroy" )

	WaitFrame() // wait one frame to let all OnConnect callbacks execute
	DisconnectWithMessage( player, errorMessage )
}
#endif

#if SERVER
void function GRX_GiveBitMaskSequenceReward( entity player, int queryScriptId, int queryGoal, string seqName, int seqRangeStart, int seqNum, array< int > items, array< int > currencies )
{
	if ( seqNum != (seqRangeStart | seqNum) ) // To prevent unexpected bit revert, e.g. seqRangeStart = ...0010 -> seqNum = ...0100, set bit 3 but bit 2 has reverted
	{
		Assert( false, format( "GRX_GiveBitMaskSequenceReward bit mask invalid, seqRangeStart:%d seqNum:%d", seqRangeStart, seqNum ) )
		return
	}
	GRX_GiveSequenceReward( player, queryScriptId, queryGoal, seqName, seqNum, items, currencies )
}
#endif

#if SERVER
void function GRX_GiveSequenceRewardEasy_Internal( entity player, int queryScriptId, int queryGoal, string seqName, int seqRangeStart, int seqNum, ItemFlavorBag flavBag, bool isBitMask )
{
	//#if GRX_DEBUG_PRINTS
	printf( GRX_DBG_PREFIX(), "seqName: %s, seqRangeStart: %i, seqNum: %i, items: [%s]", seqName, seqRangeStart, seqNum, DEV_DescribeItemFlavorBag( flavBag ) )
	//#endif
	array<int> currencyCounts
	currencyCounts.resize( GRX_CURRENCY_COUNT, 0 )
	array<int> grxIndices = []

	foreach ( int flavIdx, ItemFlavor flav in flavBag.flavors )
	{
		int flavQty = flavBag.quantities[ flavIdx ]
		if ( ItemFlavor_GetType( flav ) == eItemType.account_currency )
		{
			currencyCounts[ GRXCurrency_GetCurrencyIndex( flav ) ] += flavQty
		}
		else
		{
			for ( int i = 0; i < flavQty; i++ )
			{
				if ( ItemFlavor_GetGRXMode( flav ) == eItemFlavorGRXMode.REGULAR && GRX_HasItem( player, ItemFlavor_GetGRXIndex( flav ) ) )
					continue

				grxIndices.append( ItemFlavor_GetGRXIndex( flav ) )
			}
		}
	}
	if ( isBitMask )
	{
		GRX_GiveBitMaskSequenceReward( player, queryScriptId, queryGoal, seqName, seqRangeStart, seqNum, grxIndices, currencyCounts )
	}
	else
	{
		GRX_GiveSequenceReward( player, queryScriptId, queryGoal, seqName, seqNum, grxIndices, currencyCounts )
	}
}
#endif

#if SERVER
void function GRX_GiveSequenceRewardEasy( entity player, int queryScriptId, int queryGoal, string seqName, int seqRangeStart, int seqNum, ItemFlavorBag flavBag )
{
	GRX_GiveSequenceRewardEasy_Internal( player, queryScriptId, queryGoal, seqName, seqRangeStart, seqNum, flavBag, false )
}
#endif

#if SERVER
void function GRX_GiveBitMaskSequenceRewardEasy( entity player, int queryScriptId, int queryGoal, string seqName, int seqRangeStart, int seqNum, ItemFlavorBag flavBag )
{
	GRX_GiveSequenceRewardEasy_Internal( player, queryScriptId, queryGoal, seqName, seqRangeStart, seqNum, flavBag, true )
}
#endif

#if SERVER
void function GRX_MarkAsNewIfAppropriate( entity player, ItemFlavor flav )
{
	if ( !IsValid( player ) )
		return // this is often called from a GRX operation complete callback

	if ( ItemFlavor_GetGRXMode( flav ) != eItemFlavorGRXMode.REGULAR )
		return

	int grxIndex     = ItemFlavor_GetGRXIndex( flav )
	bool isItemOwned = GRX_HasItem( player, grxIndex )

	if ( isItemOwned )
	{
		Newness_MarkItemFlavorsAsNewForPlayer( player, [flav] )
	}
}
#endif


