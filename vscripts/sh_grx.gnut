#if SERVER || CLIENT || UI
bool function GRX_IsItemCoveredByOfferRestrictions( ItemFlavor flav )
{
	if ( ItemFlavor_GetType( flav ) == eItemType.account_pack )
	{
		// Heirlooms are technically apex packs but we don't want them to be affected by offer restrictions
		if ( ItemFlavor_GetQuality( flav, eRarityTier.NONE ) == eRarityTier.MYTHIC )
			return false

		// The basic and bundle battlepasses are technically packs and we don't want to restrict purchases for them
		ItemFlavor ornull activeBattlePass = GetActiveBattlePass()
		if ( activeBattlePass != null )
		{
			expect ItemFlavor( activeBattlePass )
			ItemFlavor basicPassPack = BattlePass_GetBasicPurchasePack( activeBattlePass )
			ItemFlavor bundlePassPack = BattlePass_GetBundlePurchasePack( activeBattlePass )

			if ( flav == basicPassPack || flav == bundlePassPack )
				return false
		}
		return true
	}

	return false
}
#endif

#if UI
ItemFlavorBag function GRX_MakeItemFlavorBagFromPriceArray( array<int> prices )
{
	ItemFlavorBag priceBag
	foreach ( int currencyIndex, int currencyQuantity in prices )
	{
		ItemFlavor currencyFlav = GRX_CURRENCIES[currencyIndex]

		if ( currencyQuantity <= 0 )
			continue

		priceBag.flavors.append( currencyFlav )
		priceBag.quantities.append( currencyQuantity )
	}
	return priceBag
}
#endif

#if SERVER && DEVELOPER
void function GenerateGRXPDef()
{
	DEV_PDefGen_BeginStruct( "sQueuedRewardData" )
	DEV_PDefGen_AddField_GUID( "sourceGUID" )
	DEV_PDefGen_AddField_Int( "sourceGUID_extraData" )
	DEV_PDefGen_AddField_GUIDArray_IntKey( "rewardGUIDs", QUEUED_REWARDS_MAX_ITEMS_COUNT )
	DEV_PDefGen_AddField_IntArray_IntKey( "rewardQuantities", QUEUED_REWARDS_MAX_ITEMS_COUNT )
	DEV_PDefGen_AddField_Bool( "rewardGiven" )
	DEV_PDefGen_AddField_Bool( "rewardAcknowledged" )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "GRX" )
	DEV_PDefGen_AddField_StructArray_IntKey( "sQueuedRewardData", "grxQueuedRewards", QUEUED_REWARDS_MAX_COUNT )

	DEV_PDefGen_EndFieldGroup()
}
#endif


