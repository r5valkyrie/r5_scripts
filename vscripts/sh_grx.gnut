struct PlayerGRXScriptState
// Structure is used by both SERVER and UI to keep script simple, even though we'll only have 1 copy of this struct in the UI
{
	#if SERVER
		bool WORKAROUND_updateCachedStatsNextClean = false
		bool WORKAROUND_blockAutoOperations = false // used to avoid infinite retries
		bool gaveAnyQueuedRewardsSinceLastReady = false
		bool isOfferRefreshSuppressed = false
	#endif

	#if SERVER || CLIENT || UI
		bool isInventoryReady
		bool isInventoryValidated = false
		bool hasInventoryEverBeenClean = false
		int  marketplaceEdition = -1
		bool isOfferRestricted = false
	#endif

	#if SERVER || UI
		int          inventoryState = GRX_INVENTORYSTATE_UNINITIALIZED
		array<int>   balances
		array<GRXUserInfoBalances> currencies

		int                           nextScriptQueryId = GRX_SCRIPT_QUERY_IDENTIFIER_START_INDEX
		array<ScriptGRXOperationInfo> operationQueue
		ScriptGRXOperationInfo ornull activeOperationOrNull = null

		bool isAutoOperationQueued = false

		GRXUserInfo& WORKAROUND_lastCodeUserInfo

		#if SERVER
			table<int, bool> queryGoalBlacklist
			bool             isQueueingServersideScriptGRXOperations = false
			bool             PROTO_haveWeGreenlightedUIForGRX = false
		#elseif UI
			bool areOffersReady
			int giftingLimitResetDate = 0

			array< GRXContainerInfo > containers
		#endif

		#if SERVER || UI
			int giftingLimitCounter = -1
		#endif
	#endif
}
#endif


