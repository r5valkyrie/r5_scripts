#if UI
bool function DisplayQueuedRewardsGiven()
{
	// returns true if a reward display menu was opened

	entity player = GetLocalClientPlayer()

	if ( !IsLocalClientEHIValid() )
		return false

	for ( int persistentArrayIdx = 0; persistentArrayIdx < QUEUED_REWARDS_MAX_COUNT; persistentArrayIdx++ )
	{
		Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
		SettingsAssetGUID ornull rewardItemFlavGUID = GetQueuedRewardOrNull( persistentArrayIdx )
		if ( rewardItemFlavGUID == null )
			continue

		expect SettingsAssetGUID( rewardItemFlavGUID )
		ItemFlavor rewardItemFlav = GetItemFlavorByGUID( rewardItemFlavGUID )

		Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
		int quantity = expect int(  GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].rewardQuantities[0]", persistentArrayIdx )  ) ) //See R5DEV-77438  and R5DEV-194461 for documentation as to why this function exists.

		SettingsAssetGUID sourceItemFlavGUID   = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].sourceGUID", persistentArrayIdx ) ) ) //See R5DEV-77438  and R5DEV-194461 for documentation as to why this function exists.
		int sourceItemExtraData                = expect int( GetDialogFlowTablesValueOrPersistence( format( "grxQueuedRewards[%d].sourceGUID_extraData", persistentArrayIdx ) ) ) //See R5DEV-77438  and R5DEV-194461 for documentation as to why this function exists.
		ItemFlavor ornull sourceItemFlav       = null
		if ( sourceItemFlavGUID != 0 )
		{
			if ( IsValidItemFlavorGUID( sourceItemFlavGUID ) )
				sourceItemFlav = GetItemFlavorByGUID( sourceItemFlavGUID )
			else
				Warning( "Found unregistered ItemFlavorGUID " + string(sourceItemFlavGUID) + ". This is probably because the source asset has been deleted from Bakery." )
		}

		if ( IsInvalidTypeForRewardCeremony( rewardItemFlav.typeIndex ) )
		{
			GRX_MarkRewardAcknowledged( rewardItemFlavGUID, persistentArrayIdx )
			continue
		}

		string titleText = "#GENERIC_REWARD_RECEIVED"
		string descText  = ""
		string headerText = ""
		bool noShowLow   = false
		if ( sourceItemFlav != null )
		{
			expect ItemFlavor( sourceItemFlav )
			switch( ItemFlavor_GetType( sourceItemFlav ) )
			{
				case eItemType.challenge:
				{
					int tierIdx = sourceItemExtraData

					int tierCount = Challenge_GetTierCount( sourceItemFlav )

					if ( tierCount <= 0 ) // fix for case where the challenge has no tiers, which means we deleted the stat for it
					{
						descText = ""
					}
					else
					{
						descText = Challenge_GetDescription( sourceItemFlav, tierIdx )
					}

					if ( Challenge_GetTimeSpanKind( sourceItemFlav ) == eChallengeTimeSpanKind.EVENT_SPECIAL_2 )
					{
						titleText = ItemFlavor_GetShortDescription( sourceItemFlav )
						descText = ItemFlavor_GetLongDescription( sourceItemFlav )
					}
					else
					{
						titleText = "#CHALLENGE_COMPLETED_HEADER"
					}
					break
				}

				case eItemType.calevent_collection:
				{
					titleText = ItemFlavor_GetLongName( sourceItemFlav )
					descText = "#LOGIN_REWARD"

					// todo(dw): temp solution for auto-equipping Halloween music pack
					if ( ItemFlavor_GetType( rewardItemFlav ) == eItemType.music_pack )
					{
						thread (void function() : (rewardItemFlav) {
							RequestSetItemFlavorLoadoutSlot( WaitForLocalClientEHI(), Loadout_MusicPack(), rewardItemFlav )
						})()
					}

					break
				}

				case eItemType.calevent_login:
				{
					titleText = ItemFlavor_GetLongName( sourceItemFlav )
					descText = ItemFlavor_GetLongDescription( sourceItemFlav )
					break
				}

				case eItemType.quest:
				{
					titleText = ItemFlavor_GetLongName( sourceItemFlav )
					descText = ItemFlavor_GetLongDescription( sourceItemFlav )
					break
				}

				default: Assert( false )
			}
		}
		else
		{
			descText = ItemFlavor_GetLongName( rewardItemFlav )
		}

		BattlePassReward rewardInfo
		rewardInfo.level = -1
		rewardInfo.flav = rewardItemFlav
		rewardInfo.quantity = quantity
		ShowRewardCeremonyDialog(
			headerText,
			titleText,
			descText,
			[rewardInfo],
			false,
			false,
			noShowLow,
			true )

		GRX_MarkRewardAcknowledged( rewardItemFlavGUID, persistentArrayIdx )
		Newness_TEMP_MarkItemAsNewAndInformServer( rewardItemFlav )

		return true // (dw): can only display one at a time (:
	}

	return false
}
#endif


#if SERVER
void function ClientCallback_acknowledge_reward( entity player, int persistentArrayIdx, int rewardItemFlavGUID )
{
	Assert( IsValid( player ) )
	if ( persistentArrayIdx < 0 || persistentArrayIdx >= QUEUED_REWARDS_MAX_COUNT )
	{
		Assert( false )
		return
	}

	Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
	if ( rewardItemFlavGUID != player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ) ) )
	{
		Assert( false )
		return
	}

	if ( player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGiven", persistentArrayIdx ) ) == 0 )
	{
		Assert( false )
		return
	}

	if ( player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardAcknowledged", persistentArrayIdx ) ) == 1 )
	{
		Assert( false )
		return
	}

	player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardAcknowledged", persistentArrayIdx ), 1 ) // todo(dw): this bool isn't actually needed?

	// clear the slot
	Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
	ClearQueuedPersistenceAward( player, persistentArrayIdx )
}
#endif

#if SERVER
void function ClientCallback_SetOfferRefreshSuppressed( entity player, bool isSuppressed )
{
	if ( !( player in fileLevel.playerGRXStateMap ) )
	{
		return // Player has disconnected
	}

	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( player )
	scriptState.isOfferRefreshSuppressed = isSuppressed
}
#endif // SERVER

#if SERVER
void function ClearQueuedPersistenceAward( entity player, int persistentArrayIdx )
{
	if ( persistentArrayIdx < 0 || persistentArrayIdx >= QUEUED_REWARDS_MAX_COUNT )
	{
		Assert( false, "persistentArrayIdx " + persistentArrayIdx + " out of range - must be greater than or equal to 0 and less than " + QUEUED_REWARDS_MAX_COUNT )
		return
	}
	player.SetPersistentVar( format( "grxQueuedRewards[%d].sourceGUID", persistentArrayIdx ), 0 )
	player.SetPersistentVar( format( "grxQueuedRewards[%d].sourceGUID_extraData", persistentArrayIdx ), 0 )
	player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ), 0 )
	player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardQuantities[0]", persistentArrayIdx ), 0 )
	player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGiven", persistentArrayIdx ), false )
	player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardAcknowledged", persistentArrayIdx ), false )
}
#endif

#if SERVER
bool function OperationQueueHasQueryGoal( PlayerGRXScriptState scriptState, int queryGoal )
{
	foreach( ScriptGRXOperationInfo op in scriptState.operationQueue )
	{
		if ( op.expectedQueryGoal == queryGoal )
		{
			return true
		}
	}
	return false
}
#endif

#if SERVER || UI
void function RunGRXOperations( entity player, PlayerGRXScriptState scriptState )
{
	if ( !scriptState.isInventoryReady )
		return

	if ( scriptState.activeOperationOrNull != null )
		return

#if SERVER
	RunGRXAutoOperations( player, scriptState )
#endif

	if ( scriptState.operationQueue.len() == 0 )
	{
		#if SERVER
			if ( !scriptState.PROTO_haveWeGreenlightedUIForGRX )
			{
				scriptState.PROTO_haveWeGreenlightedUIForGRX = true
				Remote_CallFunction_UI( player, "ServerToUI_PROTO_YouAreGreenLightedForGRX" )
			}
		#endif
		return
	}

	ScriptGRXOperationInfo operationInfo = scriptState.operationQueue[0] // leave next operation on the queue
	scriptState.activeOperationOrNull = operationInfo

	operationInfo.status = eScriptGRXOperationStatus.RUNNING

#if GRX_DEBUG_PRINTS
	if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
	{
#if UI
		float time = UITime()
#else
		float time = Time()
#endif // UI
		GRXDbg( player, "script operation running",
			"culprit", operationInfo.DEV_culprit,
			"id", operationInfo.id,
			"age", time - operationInfo.DEV_queueTime )
	}
#endif

	//operationInfo.doOperationFunc( operationInfo.id )
	// todo(dw): workaround for code mutex deadlock (R5DEV-50597)
	#if SERVER
		operationInfo.WORKAROUND_player = player
	#endif
	thread WORKAROUND_CallOperationDoFuncOnFrameEnd( operationInfo )
}
void function WORKAROUND_CallOperationDoFuncOnFrameEnd( ScriptGRXOperationInfo operationInfo )
{
#if SERVER
	if ( !IsValid( operationInfo.WORKAROUND_player ) )
		return

	EndSignal( operationInfo.WORKAROUND_player, "OnDisconnecting" )
#endif

	WaitEndFrame()

	if ( operationInfo.status != eScriptGRXOperationStatus.RUNNING )
	{
		#if GRX_DEBUG_PRINTS
			if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
				printt( GRX_DBG_PREFIX(), "operationInfo.status != eScriptGRXOperationStatus.RUNNING", operationInfo.status )
		#endif
		return
	}

		#if SERVER
		#endif

	// (dw): a workaround within a workaround... code may have started a query in the interim
#if SERVER
	while( IsValid( operationInfo.WORKAROUND_player ) && GRX_GetUserInfo( operationInfo.WORKAROUND_player ).queryState != GRX_HTTPQUERYSTATE_NONE )
		WaitFrame()

	if ( !IsValid( operationInfo.WORKAROUND_player ) )
	{
		HandleGRXQueryCompleted( operationInfo.WORKAROUND_player, operationInfo.id, operationInfo.expectedQueryGoal, GRX_HTTPQUERYSTATE_ERROR, false )
		return
	}
#elseif UI
	float startTime = UITime()
	while( GRX_GetUserInfo().queryState != GRX_HTTPQUERYSTATE_NONE )
	{
		#if GRX_DEBUG_PRINTS
			if ( UITime() - startTime > 5.0 )
			{
				printt( GRX_DBG_PREFIX(), "while( GRX_GetUserInfo().queryState != GRX_HTTPQUERYSTATE_NONE ) running for more than 5.0s", GRX_GetUserInfo().queryState )
				startTime = UITime()
			}
		#endif
		WaitFrame()
	}

	if ( !fileLevel.WORKAROUND_isInLifetime )
	{
		// Operation queue will be obliterated shortly because we're shutting down.
		return
	}
#endif

	#if SERVER
		PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( operationInfo.WORKAROUND_player )
		if ( operationInfo.expectedQueryGoal in scriptState.queryGoalBlacklist )
		{
			string queryName = operationInfo.expectedQueryGoal in GRXQueryGoalsToNames ? GRXQueryGoalsToNames[operationInfo.expectedQueryGoal] : "Query Name Not Found"
			Warning( "GRX query goal %i (%s) is in the queryGoalBlacklist due to a previous failure. Ending this query with error. Goal info: %s", operationInfo.expectedQueryGoal, queryName, operationInfo.DEV_goalInfo )
			HandleGRXQueryCompleted( operationInfo.WORKAROUND_player, operationInfo.id, operationInfo.expectedQueryGoal, GRX_HTTPQUERYSTATE_ERROR, false )
			return
		}
	#endif

	operationInfo.doOperationFunc( operationInfo.id )
}
#endif


#if SERVER
void function RunGRXAutoOperations( entity player, PlayerGRXScriptState scriptState )
{
	if ( !IsLobby() )
		return

	if ( scriptState.WORKAROUND_blockAutoOperations )
		return

	if ( scriptState.isAutoOperationQueued )
		return


	if ( GetCurrentPlaylistVarBool( "grx_autoopen_ephemeral_packs", true ) )
	{
		array<ItemFlavor> ephemeralPackFlavorList = []
		ephemeralPackFlavorList.extend( GetAllItemFlavorsOfType( eItemType.account_currency_bundle ) )
		foreach ( ItemFlavor packFlav in GetAllItemFlavorsOfType( eItemType.account_pack ) )
		{
			if ( GRXPack_IsEphemeral( packFlav ) )
				ephemeralPackFlavorList.append( packFlav )
		}

		foreach ( ItemFlavor packFlav in ephemeralPackFlavorList )
		{
			if ( GRX_GetPackCount( player, ItemFlavor_GetGRXIndex( packFlav ) ) > 0 )
			{
				ScriptGRXOperationInfo operation
				operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_AUTOOPEN_PACK
				operation.doOperationFunc = (void function( int opID ) : ( player, packFlav ) {
					GRX_OpenPack( player, opID, ItemFlavor_GetGRXIndex( packFlav ) )
				})
				operation.onDoneCallback = (void function( int status ) : ( scriptState ) {
					// XXX: if this call fails, we can have a pack count that is wrong with Marketplace. When Marketplace thinks we have zero, we
					// don't want this call to loop indefinitely. We will retry next connect when we can refresh our counts again.
					bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
					if ( !didOperationSucceed )
					{
						scriptState.WORKAROUND_blockAutoOperations = true
					}
				})
				operation._isAutoOperation = true
				QueueGRXOperationInternal( player, operation, scriptState )

				return // we have an auto-operation to process, return for now
			}
		}
	}

	if ( GetCurrentPlaylistVarBool( "grx_queued_rewards_processing_enabled", true ) )
	{
		for ( int persistentArrayIdx = 0; persistentArrayIdx < QUEUED_REWARDS_MAX_COUNT; persistentArrayIdx++ )
		{
			Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
			SettingsAssetGUID rewardItemFlavGUID = player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGUIDs[0]", persistentArrayIdx ) )
			if ( rewardItemFlavGUID == 0 )
				continue

			if ( !IsValidItemFlavorGUID( rewardItemFlavGUID, eValidation.DONT_ASSERT ) )
			{
				if ( GetCurrentPlaylistVarBool( "grx_purge_unknown_guid_rewards", true ) )
				{
					Warning( "Purging unknown ItemFlavor GUID " + rewardItemFlavGUID + " found in grxQueuedRewards." )
					ClearQueuedPersistenceAward( player, persistentArrayIdx )
				}
				else
				{
					Assert( false, "Unknown ItemFlavor GUID " + rewardItemFlavGUID + " found in grxQueuedRewards." )
				}
				continue
			}

			ItemFlavor rewardItemFlav = GetItemFlavorByGUID( rewardItemFlavGUID )

			bool rewardGiven        = (player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardGiven", persistentArrayIdx ) ) > 0)
			bool rewardAcknowledged = (player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardAcknowledged", persistentArrayIdx ) ) > 0)
			if ( rewardGiven )
			{
				Assert( !rewardAcknowledged )
				continue
			}

			Assert( QUEUED_REWARDS_MAX_ITEMS_COUNT == 1 )
			int quantity = player.GetPersistentVarAsInt( format( "grxQueuedRewards[%d].rewardQuantities[0]", persistentArrayIdx ) )
			Assert( quantity == 1 )

			int grxIndex = ItemFlavor_GetGRXIndex( rewardItemFlav, eValidation.DONT_ASSERT )
			if ( grxIndex == -1 ) // we've got an invalid GRX index, almost certainly because we moved an item out of GRX flow. Purge it.
			{
				ClearQueuedPersistenceAward( player, persistentArrayIdx )
				continue
			}

			if ( GRX_HasItem( player, ItemFlavor_GetGRXIndex( rewardItemFlav ) ) )
			{
				scriptState.gaveAnyQueuedRewardsSinceLastReady = true
				player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGiven", persistentArrayIdx ), true )
				if ( rewardAcknowledged )
					ClearQueuedPersistenceAward( player, persistentArrayIdx )
				continue
			}

			if ( ItemFlavor_IsItemDisabledForGRX( rewardItemFlav ) )
			{
				ClearQueuedPersistenceAward( player, persistentArrayIdx )
				continue
			}

			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_ITEM
			operation.doOperationFunc = (void function( int opID ) : ( player, rewardItemFlav ) {
				int grxIndex = ItemFlavor_GetGRXIndex( rewardItemFlav )
				GRX_GiveCosmetic( player, opID, grxIndex )
			})
			operation.onDoneCallback = (void function( int status ) : ( player, scriptState, persistentArrayIdx, rewardItemFlav, rewardAcknowledged ) {
				int grxIndex             = ItemFlavor_GetGRXIndex( rewardItemFlav )
				bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
				if ( didOperationSucceed )
				{
					bool isItemOwned = GRX_HasItem( player, grxIndex )

					if ( isItemOwned )
					{
						scriptState.gaveAnyQueuedRewardsSinceLastReady = true
						player.SetPersistentVar( format( "grxQueuedRewards[%d].rewardGiven", persistentArrayIdx ), true )
						if ( rewardAcknowledged )
							ClearQueuedPersistenceAward( player, persistentArrayIdx )
					}
					else
					{
						Assert( false, format( "GRX_QueueGiveReward operation for '%s' for '%s' succeeded but GRX_HasItem(..) then returned false",
							string(ItemFlavor_GetAsset( rewardItemFlav )), string(player) ) )
						didOperationSucceed = false
					}
				}

				if ( !didOperationSucceed )
				{
					Warning( format( "GRX Auto Operation failed for %s which is now blocking *ALL* subsequent auto operations. This item has a valid GRX ref but may not be setup in Marketplace yet.",
						string(ItemFlavor_GetAsset( rewardItemFlav )) ) )
					scriptState.WORKAROUND_blockAutoOperations = true
				}
			})
			operation._isAutoOperation = true
			operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( rewardItemFlav )
			QueueGRXOperationInternal( player, operation, scriptState )

			return // we have an auto-operation to process, return for now
		}
	}
}
#endif



