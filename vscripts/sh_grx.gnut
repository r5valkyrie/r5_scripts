#if SERVER
void function ShGRX_OnClientConnectionCompleted( entity player )
{
	PlayerGRXScriptState scriptState
	scriptState.isInventoryReady = false
	player.p.grxInitialized = true // TODO: R5DEV-350205 instead, store the scriptState here
	fileLevel.playerGRXStateMap[player] <- scriptState

	// Cache the player's previously logged in timestamp before we update the persistence var in
	// Lobby_OnClientConnectionCompleted.
	// lastTimeLoggedIn and ServerCallback_UpdatePlayerLastLoggedInTimestamp not available
	// int lastLoggedIn = 0
	// Remote_CallFunction_UI( player,"ServerCallback_UpdatePlayerLastLoggedInTimestamp", lastLoggedIn )
	HandleGRXCodeUserInfoUpdated( player, GRX_GetUserInfo( player ) )
}
#endif


#if SERVER
void function GRX_OnPlayerDisconnected( entity player )
{
	if ( IsLobby() )
	{
		if ( player in fileLevel.playerGRXStateMap )
			delete fileLevel.playerGRXStateMap[ player ]
	}

	player.p.grxInitialized = false
}
#endif

#if SERVER
bool function GRX_IsPlayerGRXScriptStateRegistered( entity player )
{
	return IsValid( player ) && player in fileLevel.playerGRXStateMap
}
#endif // SERVER

#if SERVER || CLIENT || UI
PlayerGRXScriptState function GetPlayerGRXScriptState( entity player )
{
	#if SERVER
		return fileLevel.playerGRXStateMap[player]
	#elseif CLIENT || UI
		#if CLIENT
			Assert( player == GetLocalClientPlayer() )
		#elseif UI
			Assert( player == GetLocalClientPlayer()
			|| player == null /* weird bug when level is shutting down */
			|| GetLocalClientPlayer() == null /* weird bug when level is shutting down */ )
		#endif

		return fileLevel.localGRXState
	#endif
}
#endif


#if SERVER
void function CodeCallback_GRXUserInfoUpdated( entity player, GRXUserInfo codeUserInfo )
// code can call this very early
{
	if ( !IsValid( player ) || !(player in fileLevel.playerGRXStateMap) )
		return

	if ( IsValid( player ) && player in fileLevel.playerGRXStateMap && IsLobby() == false ) // we've seen this player before in this Match dedi
		return // don't worry about refreshing, because we already have their state info

	HandleGRXCodeUserInfoUpdated( player, codeUserInfo )
}
#elseif UI
void function UICodeCallback_GRXUserInfoUpdated( GRXUserInfo codeUserInfo )
{
	if ( !fileLevel.WORKAROUND_isInLifetime )
	{
		fileVM.WORKAROUND_wasUserInfoUpdatedBeforeLevelInit = true
		return
	}

	HandleGRXCodeUserInfoUpdated( GetLocalClientPlayer(), codeUserInfo )

	if ( fileVM.WORKAROUND_delayedOffersState != GRX_OFFERSSTATE_UNINITIALIZED )
	{
		HandleGRXOffersRefreshed( fileVM.WORKAROUND_delayedOffersState, fileVM.WORKAROUND_delayedCraftingOffers, fileVM.WORKAROUND_delayedStoreOffers )

		fileVM.WORKAROUND_delayedOffersState = GRX_OFFERSSTATE_UNINITIALIZED
		fileVM.WORKAROUND_delayedCraftingOffers = []
		fileVM.WORKAROUND_delayedStoreOffers = []
	}
}
#endif

