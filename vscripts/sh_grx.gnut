#if SERVER || UI
void function HandleGRXQueryCompleted( entity player, int queryScriptId, int queryGoal, int queryState, bool notifyOffersDirty )
// code may do a query before the script VM even finished initializing
{
	#if GRX_DEBUG_PRINTS
		if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
		{
			GRXDbg( player, "",
				"queryScriptId", queryScriptId,
				"queryGoal", queryGoal,
				"queryState", queryState )
		}
	#endif

	/*
		Script-initiated GRX operations

		UI:
			- open pack (GRX_HTTPQUERYGOAL_OPEN_PACK)
			- purchase item from store (GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER)
			- craft item from customize menu (GRX_HTTPQUERYGOAL_CRAFT_ITEM)
			- purchase battle pass (optionally with some starter bonus levels) (GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER)
			- purchase battle pass levels (GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER)
			- gift an offer to a friend (GRX_HTTPQUERYGOAL_GIFT_OFFER)

		Server:
			- grant account level rewards (GRX_HTTPQUERYGOAL_GIVE_SEQUENCE_REWARD)
			- grant battlepass rewards (GRX_HTTPQUERYGOAL_GIVE_SEQUENCE_REWARD)
			- auto-open currency packs (GRX_HTTPQUERYGOAL_OPEN_PACK)
			- remove rewards from inventory (GRX_HTTPQUERYGOAL_DELETE_ITEMS)

		Unused:
			- GRX_HTTPQUERYGOAL_GIVE_CURRENCY
			- GRX_HTTPQUERYGOAL_GIVE_ITEM
			- GRX_HTTPQUERYGOAL_REFRESH_USER_INFO
	*/

	#if SERVER
		if ( !IsValid( player ) || !(player in fileLevel.playerGRXStateMap) )
			return

		PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( player )

		bool needsStateUpdateCall = false

		// +stats stuff
		if ( queryGoal != 0 &&  ( queryGoal != GRX_HTTPQUERYGOAL_REFRESH_USER_INFO ) && ( queryGoal != GRX_HTTPQUERYGOAL_GIFT_OFFER )  )
		{
			// The following query goals could grant you an item, so we need to update the appropriate stats once the inventory is clean after they happen.
			// GRX_HTTPQUERYGOAL_AUTOOPEN_PACK
			// GRX_HTTPQUERYGOAL_CRAFT_ITEM
			// GRX_HTTPQUERYGOAL_GIVE_ACCOUNT_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BATTLEPASS_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BONUS_EA_ACCESS_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BONUS_EA_PREMIER
			// GRX_HTTPQUERYGOAL_GIVE_BONUS_PS_PLUS_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BONUS_TWITCH_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BONUS_UNKNOWN_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BUNDLE_FOUNDER_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_BUNDLE_STARTER_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_CURRENCY
			// GRX_HTTPQUERYGOAL_GIVE_ITEM
			// GRX_HTTPQUERYGOAL_OPEN_PACK
			// GRX_HTTPQUERYGOAL_PURCHASE_CHARACTER
			// GRX_HTTPQUERYGOAL_PURCHASE_STORE_OFFER
			// GRX_HTTPQUERYGOAL_PURCHASE_PACK
			// GRX_HTTPQUERYGOAL_TRANSFER_ENTITLEMENTS
			// GRX_HTTPQUERYGOAL_DELETE_ITEMS
			// GRX_HTTPQUERYGOAL_GIVE_QUEST_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_EVENT_SEQUENCE_REWARD
			// GRX_HTTPQUERYGOAL_GIVE_HEIRLOOM_SEQUENCE_REWARD
			// (This is pretty much all query goals except GRX_HTTPQUERYGOAL_REFRESH_USER_INFO)
			scriptState.WORKAROUND_updateCachedStatsNextClean = true
			needsStateUpdateCall = true
		}
		// -stats stuff

		if ( queryGoal == GRX_HTTPQUERYGOAL_TRANSFER_ENTITLEMENTS && queryState == GRX_HTTPQUERYSTATE_NOERROR )
			TryGiveFirstPartyEntitlements( player )
	#else
		PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( player )
	#endif

	if ( queryScriptId == -1 || queryScriptId == 0 )
		return // == -1 means it's a code-initiated query

#if SERVER
	if ( queryScriptId < 0 )
	{
		if ( needsStateUpdateCall )
			UpdatePlayerGRXScriptState( player )
		return // < 0 means it's a UI-initiated query, not for us
	}
#elseif UI
	if ( queryScriptId > 0 )
		return // >= 0 means it's a server-initiated query, not for us
#endif

	#if UI
		if ( fileLevel.HACK_allowOneBadQueryCompleteCallBecauseOfUIScriptReset && scriptState.activeOperationOrNull == null )
		{
			fileLevel.HACK_allowOneBadQueryCompleteCallBecauseOfUIScriptReset = false
			return
		}
	#endif

	Assert( scriptState.activeOperationOrNull != null, "Looks like a GRX query was initiated without using QueueGRXOperation. This is dangerous!" )

	ScriptGRXOperationInfo operationInfo = expect ScriptGRXOperationInfo( scriptState.activeOperationOrNull )

	Assert( operationInfo.id == queryScriptId )

	Assert( queryGoal == operationInfo.expectedQueryGoal ) // just to be sure

	operationInfo._codeQueryState = queryState

	if ( queryState == GRX_HTTPQUERYSTATE_INTERRUPTED )
	{
		operationInfo.status = eScriptGRXOperationStatus.DONE_INTERRUPTED
	}
	else if ( queryState == GRX_HTTPQUERYSTATE_ERROR )
	{
		#if SERVER
			if( !(operationInfo.expectedQueryGoal in scriptState.queryGoalBlacklist) )
			{
				scriptState.queryGoalBlacklist[operationInfo.expectedQueryGoal] <- true
				string queryName = operationInfo.expectedQueryGoal in GRXQueryGoalsToNames ? GRXQueryGoalsToNames[operationInfo.expectedQueryGoal] : "Query Name Not Found"
				Warning( "GRX query goal %i (%s) failed, adding to blacklist. Goal Info: %s", operationInfo.expectedQueryGoal, queryName, operationInfo.DEV_goalInfo )
			}
		#endif
		operationInfo.status = eScriptGRXOperationStatus.DONE_FAILED
	}
	else
	{
		operationInfo.status = eScriptGRXOperationStatus.DONE_SUCCESS
	}

	#if GRX_DEBUG_PRINTS
		if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
		{
			GRXDbg( player, "script operation done",
				"culprit", operationInfo.DEV_culprit,
				"id", operationInfo.id,
				"status", GetEnumString( "eScriptGRXOperationStatus", operationInfo.status ) )
		}
	#endif
	if ( operationInfo.onDoneCallback != null )
		operationInfo.onDoneCallback( operationInfo.status )
	Signal( operationInfo, "ScriptGRXOperationDone" )

	#if UI
		if ( operationInfo.status != eScriptGRXOperationStatus.DONE_SUCCESS )
			ShowGRXErrorDialogue( "" )

		if ( GetConVarBool( "mtx_hardenDirtyOffers" ) && notifyOffersDirty )
		{
			scriptState.areOffersReady = false
		}
	#endif

	if ( operationInfo._isAutoOperation )
	{
		Assert( scriptState.isAutoOperationQueued )
		scriptState.isAutoOperationQueued = false
	}
	scriptState.activeOperationOrNull = null
	scriptState.operationQueue.remove( 0 )

	UpdatePlayerGRXScriptState( player )
}
#endif

#if SERVER
bool function CodeCallback_GRXCheckStoreOfferPurchase( entity player, GRXStoreOffer codeOffer, int purchaseQuantity )
{
	if ( !GRX_IsInventoryReady( player ) )
	{
		printt("CodeCallback_GRXCheckStoreOfferPurchase - returning false because player inventory and/or offer is not ready")
		return false
	}

	foreach ( int itemIdx in codeOffer.items )
	{
		ItemFlavor flav  = GetItemFlavorByGRXIndex( itemIdx )
		bool canPurchase = CanPlayerPurchaseGRXOffer( player, codeOffer, flav, purchaseQuantity )
		#if GRX_DEBUG_PRINTS
			if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
			{
				GRXDbg( player, "",
					"flav", DEV_DescItemFlavor( flav ),
					"purchaseQuantity", purchaseQuantity,
					"canPurchase", canPurchase )
			}
		#endif
		if ( !canPurchase )
			return false
	}

	return true
}

bool function CanPlayerPurchaseGRXOffer( entity player, GRXStoreOffer codeOffer, ItemFlavor flav, int purchaseQuantity )
{
	Assert( IsLobby() )
	if ( !IsLobby() )
	{
		printt("CanPlayerPurchaseGRXOffer - returning false because not in lobby")
		return false
	}

	Assert( GRX_IsInventoryReady( player ) )

	if ( GRX_IsOfferRestricted( player ) && GRX_IsOfferRestrictedByOfferAttributes( codeOffer ) )
	{
		printt("CanPlayerPurchaseGRXOffer - returning false because player is offer restricted and" +  codeOffer.offerAlias + "is covered by attribute restrictions")
		return false
	}

	foreach ( ItemFlavor pass in GetAllItemFlavorsOfType( eItemType.battlepass ) )
	{
		bool isBattlePassRelated = false
		if ( flav == pass )
		{
			isBattlePassRelated = true
			if ( !CanPlayerPurchaseBattlePass( player, pass ) )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is a battlepass outside a pack and CanPlayerPurchaseBattlePass is false")
				return false
			}
		}

		if ( flav == BattlePass_GetBasicPurchasePack( pass ) )
		{
			isBattlePassRelated = true
			if ( !CanPlayerPurchaseBattlePass( player, pass ) )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is a basic battlepass and CanPlayerPurchaseBattlePass is false")
				return false
			}
		}

		if ( flav == BattlePass_GetBundlePurchasePack( pass ) )
		{
			isBattlePassRelated = true
			if ( !CanPlayerPurchaseBattlePass( player, pass ) )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is a premium battlepass and CanPlayerPurchaseBattlePass is false")
				return false
			}
			if ( GetPlayerBattlePassPurchasableLevels( ToEHI( player ), pass ) < 25 )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is a premium battlepass and GetPlayerBattlePassPurchasableLevels is < 25")
				return false
			}
		}

		if ( flav == BattlePass_GetXPPurchaseFlav( pass ) )
		{
			isBattlePassRelated = true
			if ( purchaseQuantity > GetPlayerBattlePassPurchasableLevels( ToEHI( player ), pass ) )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is an XP flav and purchaseQuantity" + purchaseQuantity + "> GetPlayerBattlePassPurchasableLevels")
				return false
			}
		}

		if ( GetGlobalSettingsAsset( ItemFlavor_GetAsset( pass ), "bubblePurchaseFlav" ) != $"" && flav == BattlePass_GetXPPurchaseLegendTokenFlav( pass ) )
		{
			isBattlePassRelated = true
			if ( !CanPlayerPurchaseBattlePassLevelsWithLegendTokens( player, pass ) )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is an XP Legend Token flav and CanPlayerPurchaseBattlePassLevelsWithLegendTokens is false")
				return false
			}
			if ( GetPlayerBattlePassPurchasableLevelsWithLegendTokens( ToEHI(player), pass ) < purchaseQuantity )
			{
				printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is an XP Legend Token flav and GetPlayerBattlePassPurchasableLevelsWithLegendTokens < " + purchaseQuantity)
				return false
			}
		}

		if ( isBattlePassRelated && pass != GetPlayerActiveBattlePass( player ) )
		{
			printt("CanPlayerPurchaseGRXOffer - returning false because isBattlePassRelated and pass " +  string(ItemFlavor_GetAsset( pass )) + "is not active battle pass")
			return false
		}
	}

	foreach ( ItemFlavor event in GetAllItemFlavorsOfType( eItemType.calevent_collection ) )
	{
		// make sure players can't buy the heirloom if it's the reward of the CURRENT & ACTIVE Collection Event
		if ( CalEvent_IsActive( event, GetUnixTimestamp() ) && flav == HeirloomEvent_GetPrimaryCompletionRewardItem( event ) )
		{
			printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  string(ItemFlavor_GetAsset( flav )) + "is a HeirloomEvent_GetPrimaryCompletionRewardItem for an ACTIVE CollectionEvent")
            Assert( false )
			return false
		}

		// Handle case where multi-item offers containing event packs couldn't be purchased due to max event pack count (R5DEV-176563)
		bool allowPurchaseToExceedMaxEventPacks = false
		if ( codeOffer.items.len() > 1 )
		{
			ItemFlavor eventPackFlav = CollectionEvent_GetMainPackFlav( event )
			foreach ( int itemIdx in codeOffer.items )
			{
				ItemFlavor offerItemFlav = GetItemFlavorByGRXIndex( itemIdx )
				if ( eventPackFlav == offerItemFlav )
					allowPurchaseToExceedMaxEventPacks = true
			}
		}

		if ( allowPurchaseToExceedMaxEventPacks )
			continue

		if ( flav == CollectionEvent_GetMainPackFlav( event )
		&& CollectionEvent_GetCurrentMaxEventPackPurchaseCount( event, player ) < 1 )
		{
			printt("CanPlayerPurchaseGRXOffer - returning false because flav" +  ItemFlavor_GetAsset( flav ) + "is == CollectionEvent_GetMainPackFlav( event ) and CollectionEvent_GetCurrentMaxEventPackPurchaseCount( event, player ) < 1")
			return false // todo(dw): check quantity (see R5DEV-94467)
		}
	}

	return true
}
#endif


#if UI
void function UICodeCallback_GRXOffersRefreshed( int offersState, array< GRXCraftingOffer > craftingOffers, array< GRXStoreOffer > storeOffers )
{
	#if GRX_DEBUG_PRINTS
		if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
		{
			GRXDbg( null, "",
				"offersState", offersState,
				"craftingOffers", craftingOffers.len(),
				"storeOffers", storeOffers.len() )
		}
	#endif

	if ( fileLevel.WORKAROUND_isInLifetime )
	{
		HandleGRXOffersRefreshed( offersState, craftingOffers, storeOffers )
	}
	else
	{
		fileVM.WORKAROUND_delayedOffersState = offersState
		fileVM.WORKAROUND_delayedCraftingOffers = craftingOffers
		fileVM.WORKAROUND_delayedStoreOffers = storeOffers
	}
}
#endif

#if UI
void function UICodeCallback_GRXOffersRefreshedIncremental( array< GRXStoreOffer > codeOffers )
{
#if GRX_DEBUG_PRINTS
	if ( !fileLevel.GRX_DEBUG_PRINTS_disableTemporarily )
	{
		GRXDbg( null, "", "storeOffers", codeOffers.len() )
	}
#endif // GRX_DEBUG_PRINTS

	foreach ( GRXStoreOffer codeOffer in codeOffers )
	{
		if ( !( codeOffer.offerAlias in fileLevel.offerAliasToOfferMap ) )
		{
			Warning( "Failed to incrementally update %s, existing offer not found!", codeOffer.offerAlias )
			continue
		}

		GRXScriptOffer existingOffer = fileLevel.offerAliasToOfferMap[codeOffer.offerAlias]

		bool hadValidPrices = GRXOffer_IsValid( existingOffer )

		existingOffer.prices.clear()
		existingOffer.priceAliases.clear()

		array<string> offerProblems = []

		GRX_InitScriptOfferPricesFromStoreOffer( codeOffer, existingOffer, offerProblems )

		if ( offerProblems.len() > 0 )
		{
			Warning( "Incrementally-updated offer %s has problems: - %s", codeOffer.offerAlias, offerProblems.join( " - " ) )
			return
		}

		bool hasValidPrices = GRXOffer_IsValid( existingOffer )

		if ( hasValidPrices )
		{
			SetOriginalPriceForGRXScriptOffer( existingOffer )
		}

		if ( hasValidPrices != hadValidPrices )
		{
			GRX_InitScriptOfferLocation( existingOffer, true )
		}

		existingOffer.purchaseCount = codeOffer.purchaseCount
		existingOffer.ineligibilityCode = codeOffer.ineligibilityCode
	}

	// Offers might have been locally invalidated, set them back to ready
	PlayerGRXScriptState scriptState = GetPlayerGRXScriptState( GetLocalClientPlayer() )
	scriptState.areOffersReady = true

	foreach ( void functionref() cb in fileLevel.onGRXOffersRefreshedCallbacks )
	{
		cb()
	}
}
#endif // UI

