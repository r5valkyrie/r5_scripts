array<StartSet> s_playerStarts
void function InitPlayerStarts()
{
	s_playerStarts = clone( START_SETS.getrandom() )
	s_playerStarts.randomize()
}

void functionref() s_ambientSkitStartupFunc = null
void function RegisterAmbientSkitStartupFunc( void functionref() func )
{
	Assert( s_ambientSkitStartupFunc == null )
	s_ambientSkitStartupFunc = func
}

void function RollObjectivesForMode( array<string> zoneGroupsToRestrict, array<string> zoneGroupsToBlock )
{
	//array<string> objectiveTypes = ObjectiveSystem_GetAllTypes()
	array<string> objectiveTypes =
	[
		//"breachandclear",
		//"mistdefend",

		"shackattack",

                  
                   
                      
                     
               
                  
                 
              
                            
	]
	objectiveTypes.randomize()

	int attemptIndex = -1
	array<ObjectiveInstance> objectives
	while ( objectives.len() < 4 )
	{
		++attemptIndex
		string objectiveType = objectiveTypes[attemptIndex % objectiveTypes.len()]

		///// Quick hard-code:
		//if ( attemptIndex == 0 )
		//	objectiveType = "movingcastle"
		////
		ObjectiveInstance ornull oi = Objectives_LaunchObjective( objectiveType, [] )
		if ( oi == null)
		{
			Warning( "%s() - Couldn't launch objective type '%s'.", FUNC_NAME(), objectiveType )
			continue
		}

		expect ObjectiveInstance( oi )
		objectives.append( oi )

		switch( oi.launchData.ambientOverrideType )
		{
			case eAmbientOverrideType.RESTRICTED:
				zoneGroupsToRestrict.extend( oi.launchData.zoneGroups )
				break
			case eAmbientOverrideType.BLOCKED:
				zoneGroupsToBlock.extend( oi.launchData.zoneGroups )
				break
		}
		printf( "%s() - Attempt #%d, launched objective #%d - '%s'", FUNC_NAME(), attemptIndex, (objectives.len() - 1), oi.objectiveType )
	}

	printf( "%s() - Launched %d objectives.", FUNC_NAME(), objectives.len() )
}

                  
                               
                                     
 
                                             
  
                                                       
                                                       
  

                                                              
 
                        

