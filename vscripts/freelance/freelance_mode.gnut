void function SetupExtractionSites()
{
	s_extractionSites.clear()

	// Containment
	{
		ExtractionSiteInfo info
		info.center = <-648.0, 16000.0, 0.0>
		info.radius = 10000

		info.shipSpots.append( { origin = <-1885.16089, 20321.4023, 4550.0>, angles = <0, 50, 0> } )			// NW, Watchtower
		info.shipSpots.append( { origin = <2374.86084, 10600.8135, 3003.60913>, angles = <0, 40, 0> } )			// SE
		info.shipSpots.append( { origin = <-3215.15747, 10170.9463, 3520.84497>, angles = <0, -23, 0> } )		// SW
		info.shipSpots.append( { origin = <-4319.81055, 17763.8965, 3117.16089>, angles = <0, -100, 0> } )		// NW, containers

		s_extractionSites.append( info )
	}

	// South-Central
	{
		ExtractionSiteInfo info
		info.center = <-6415.0, -25000.0, 0.0>
		info.radius = 9000

		info.shipSpots.append( { origin = <-6154.41602, -29697.8789, 2540.57642>, angles = <0, -164, 0> } )		// S,  cliffs
		info.shipSpots.append( { origin = <-7387.95215, -17779.2754, 3450.79248>, angles = <0, -45, 0> } )		// NW, Skulltown SE
		info.shipSpots.append( { origin = <-9265.36719, -25024.7578, 3425.88867>, angles = <0, 65, 0> } )		// SW, tall building
		info.shipSpots.append( { origin = <-4172.25098, -22596.9102, 3207.78418>, angles = <0, -175, 0> } )		// center, near respawn beacon

		s_extractionSites.append( info )
	}

	// Broken Forest
	{
		ExtractionSiteInfo info
		info.center = <24000.0, 6655.0, 0.0>
		info.radius = 8000

		info.shipSpots.append( { origin = <28422.3887, 3603.91406, 4042.06885>, angles = <0, -45, 0> } )		// SE, landing platform
		info.shipSpots.append( { origin = <20018.4121, 10944.8525, 4886.92969>, angles = <0, -175, 0> } )		// N,  Cliff
		info.shipSpots.append( { origin = <20913.5, 6171.95654, 4750.80664>, angles = <0, -50, 0> } )			// W,  broken buildings
		info.shipSpots.append( { origin = <24420.0879, 7477.60352, 4260.60791>, angles = <0, 15, 0> } )			// W,  broken buildings

		s_extractionSites.append( info )
	}

	// Western Desert
	{
		ExtractionSiteInfo info
		info.center = <-16500.0, 2000.0, 0.0>
		info.radius = 8000

		info.shipSpots.append( { origin = <-16329.3838, -396.795898, 3311.83154>, angles = <0, -70, 0> } )			// Center, cliff
		info.shipSpots.append( { origin = <-18701.9238, 3800.17383, 4000.0>, angles = <0, -90, 0> } )				// Top of the tower
		info.shipSpots.append( { origin = <-12079.5703, 5166.30713, 3380.22729>, angles = <0, 90, 0> } )			// E, Near Bunker
		//info.shipSpots.append( { origin = <-15750.0, 58.4491, 6900.0>, angles = <0, -100, -30> } )					// It is balloon.
		info.shipSpots.append( { origin = <-15750.0, 58.4491, 5500.0>, angles = <0, -100, -30> } )					// It is balloon.

		s_extractionSites.append( info )
	}

	////////////////

	s_extractionBigCircles.clear()

	//
	{
		ExtractionSiteInfo info
		info.center = <0.0, 2000.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <-10000.0, 0.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <15000.0, 0.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <-10000, -10000.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <-10000, 10000.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <13000, 14000.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
	//
	{
		ExtractionSiteInfo info
		info.center = <16000, -6000.0, 0.0>
		info.radius = 25000
		s_extractionBigCircles.append( info )
	}
}

//

void function ChooseExtractionSite()
{
	s_extractSiteIndex = RandomIntRange( 0, s_extractionSites.len() )
	s_extractDropshipIndex = RandomIntRange( 0, s_extractionSites[s_extractSiteIndex].shipSpots.len() )

	s_extractBigCircleIndex = -1
	{
		ExtractionSiteInfo site = s_extractionSites[s_extractSiteIndex]

		array<int> possible
		foreach( int index, ExtractionSiteInfo big in s_extractionBigCircles )
		{
			if ( IsCircleAInsideCircleB( site.center, site.radius, big.center, big.radius ) )
				possible.append( index )
		}

		if ( possible.len() > 0 )
			s_extractBigCircleIndex = possible.getrandom()
	}
}

bool function IsCircleAInsideCircleB( vector originA, float radiusA, vector originB, float radiusB )
{
	float dist = Distance( originA, originB )
	if ( radiusB >= (dist + radiusA) )
		return true
	return false
}

///////

void function FreelanceMode_SetCurrentPhase( int modePhase, float goalTime )
{
	SetGlobalNetTime( NV_MODE_PHASE_GOALTIME, goalTime )
	SetGlobalNetTime( NV_MODE_PHASE_STARTEDTIME, Time() )
	SetGlobalNetInt( NV_MODE_PHASE, modePhase )
}

void function FreelanceMode_SetIsVictoryForAll( bool isVictoryForAll )
{
	SetGlobalNetBool( NV_MODE_IS_VICTORY_FOR_ALL, isVictoryForAll )
}

void function FreelanceMode_ModeWait( float duration, array<string> extraWorldSignals )
{
	waitthread function() : (duration, extraWorldSignals)
	{
		EndSignal( svGlobal.worldspawn, SIG_MODE_JUMP_AHEAD )
		foreach ( signal in extraWorldSignals )
			EndSignal( svGlobal.worldspawn, signal )

		wait duration
	}()

	// If the game finished, don't advance:
	int gs = GetGameState()
	if ( gs > eGameState.Playing )
	{
		printf( "%s() - Finished wait, but gamestate is now '%s', so not advancing.", FUNC_NAME(), GetEnumStringSlow( eGameState, gs ) )
		WaitForever()
	}
}

void function FreelanceMode_Signal( string worldSignal )
{
	Signal( svGlobal.worldspawn, worldSignal )
}

void function FreelanceMode_SignalWhenObjectiveCompletes( ObjectiveInstance oi, string signal )
{
	thread function() : (oi, signal)
	{
		RegisterSignal( signal )
		for( ;; )
		{
			WaitFrame()
			if ( oi.objectiveState >= eObjectiveState.COMPLETED )
				break
		}
		FreelanceMode_Signal( signal )
	}()
}

#if DEVELOPER
void function DEV_ModeSkipAhead()
{
	FreelanceMode_Signal( SIG_MODE_JUMP_AHEAD )
}
#endif // DEV

entity function SpawnSafeZone( vector origin, float radius )
{
	entity newZone = SafeZone_CreateEnt( origin, radius, Survival_Loot_GetDefaultRealm() )
	foreach ( player in GetPlayerArray() )
		newZone.Minimap_AlwaysShow( 0, player )
	return newZone
}

entity function SpawnSafeZoneNoLine( vector origin, float radius )
{
	entity newZone = SafeZone_CreateEnt_NoLine( origin, radius, Survival_Loot_GetDefaultRealm() )
	foreach ( player in GetPlayerArray() )
		newZone.Minimap_AlwaysShow( 0, player )
	return newZone
}

void function LaunchEncounterAtPlayersIn( float waitTime )
{
	wait waitTime

	for ( int idx = 0; idx < MAX_SQUADS; ++idx )
	{
		int team              = GetTeamFromSquadID( idx )
		array<entity> players = GetPlayerArrayOfTeam( team )
		if ( players.len() == 0 )
			continue

		Encounters_LaunchEncounter( "spectrehitsquad", players )
		wait 15.0
	}
}

void function DoSplashReminderAtPlayersIn( float waitTime )
{
	wait waitTime

	if ( s_extractBigCircleIndex >= 0 )
	{
		ExtractionSiteInfo preSite = s_extractionBigCircles[s_extractBigCircleIndex]
		s_safeZonePre = SpawnSafeZoneNoLine( preSite.center, preSite.radius )
		SurveyBeacons_RemoveSurveyZones()
	}

	DoFreelanceModeSplashToAll( eModeSplash.Extraction_Reminder )
}

Cylinder function GetExtractionAreaForPreview()
{
	Cylinder result
	if ( s_extractionSites.len() == 0 )
		return result

	if ( IsValid( s_safeZonePre ) || (s_extractBigCircleIndex < 0) )
	{
		ExtractionSiteInfo es = s_extractionSites[s_extractSiteIndex]
		result.origin = es.center
		result.radius = es.radius
		return result
	}

	ExtractionSiteInfo preSite = s_extractionBigCircles[s_extractBigCircleIndex]
	result.origin = preSite.center
	result.radius = preSite.radius
	return result
}

entity s_safeZone
entity s_safeZonePre
void function MainModeThread()
{
	waitthread IntroSkyDiveInThread()

	//periodically do debug dump
	//thread function()
	//{
	//	const float DUMP_INTERVAL = 240.0
	//	for ( int i = 0; i < floor( 900 / DUMP_INTERVAL ); i++ )
	//	{
	//		wait DUMP_INTERVAL
	//		SkDebug_OnGameEndDump()
	//	}
	//}()

	//////
	// Prologue / Insertion:
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_prologue", 20.0 )
		//delaythread( 2.0 ) PlayRadioDialogueToAll( "ObMatchStart_GoExplore" )
		FreelanceMode_ModeWait( delta, [] )
	}

	//////
	// Exploration
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_exploration", 900.0 )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.Exploration, (Time() + delta) )

		thread DoSplashReminderAtPlayersIn( delta - 360.0 )
		thread LaunchEncounterAtPlayersIn( delta - 180.0 )

		FreelanceMode_ModeWait( delta, [] )
	}

	if ( IsValid( s_safeZonePre ) )
		s_safeZonePre.Destroy()

	ExtractionSiteInfo extractionSite = s_extractionSites[s_extractSiteIndex]
	table<string, vector> dropshipSpot = extractionSite.shipSpots[s_extractDropshipIndex]

	//////
	// Get to the LZ
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_gettothelz", 180.0 )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.GetToTheLZ, (Time() + delta) )

		// create LZ area:
		s_safeZone = SpawnSafeZone( extractionSite.center, extractionSite.radius )
		SurveyBeacons_RemoveSurveyZones()

		if ( GetCurrentPlaylistVarBool( "freelance_mode_extraction_reinforcements", true ) )
			thread FinalCircleReinforcementsThread( extractionSite.center, (extractionSite.radius * 0.5) )

		delaythread( 2.0 ) PlayRadioDialogueToAll( "Obj_Evac_ProceedToEvacCircle" )
		ClientMusic_PlayCustomTrackToAll( eMusicTrack.GetToTheLZ )
		FreelanceMode_ModeWait( delta, [] )
	}

	s_extractShip = FreelanceMode_SpawnExtractionDropship( dropshipSpot.origin, dropshipSpot.angles )
	wait( 2.0 )

	//////
	// Get on the Dropship
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_getontheship", 65.0 )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.GetOnTheDropship, (Time() + delta) )

		if ( IsValid( s_safeZone ) )
			s_safeZone.Destroy()

		delaythread( 1.0 ) PlayRadioDialogueToAll( "Obj_Evac_ShipArrived" )
		ClientMusic_PlayCustomTrackToAll( eMusicTrack.GetOnTheDropship )
		FreelanceMode_ModeWait( delta, [SIG_MODE_EVERYONE_IS_ON_BOARD_THE_EXTRACTION] )
		wait( 2.0 )
		Signal( svGlobal.worldspawn, SIG_MODE_EXTRACTION_GO_NOW )
		wait( 2.0 )
	}

	//////
	// Game Over
	{
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.GameOver, Time() )

		SetGameState( eGameState.WinnerDetermined )

		while( GetGameState() < eGameState.Resolution )
			WaitFrame()

		WaitFrame()

		foreach( player in GetPlayerArray() )
			Remote_CallFunction_NonReplay( player, "ServerCallback_ShowDeathScreen" )

		while( GetGameState() < eGameState.Postmatch )
			WaitFrame()

		SkDebug_OnGameEndDump()
	}
}

void function MainModeThread_ZombieRun()
{
	waitthread IntroInsertionThread_ZombieRun()

	//////
	// Prologue / Insertion:
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_prologue", 20.0 )
		//delaythread( 2.0 ) PlayRadioDialogueToAll( "ObMatchStart_GoExplore" )
		FreelanceMode_ModeWait( delta, [] )
	}

	//////
	// Exploration
	{
		float delta = GetCurrentPlaylistVarFloat( "freelance_mode_seconds_exploration", 900.0 )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.Exploration, (Time() + delta) )

		//thread DoSplashReminderAtPlayersIn( delta - 360.0 )
		//thread LaunchEncounterAtPlayersIn( delta - 180.0 )

		FreelanceMode_ModeWait( delta, [] )
	}

	//////
	// Game Over
	{
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.GameOver, Time() )

		SetGameState( eGameState.WinnerDetermined )

		while( GetGameState() < eGameState.Resolution )
			WaitFrame()

		WaitFrame()

		foreach( player in GetPlayerArray() )
			Remote_CallFunction_NonReplay( player, "ServerCallback_ShowDeathScreen" )

		while( GetGameState() < eGameState.Postmatch )
			WaitFrame()

		SkDebug_OnGameEndDump()
	}
}

void function StartMainModeThread()
{
	if ( GetCurrentPlaylistVarBool( "freelance_mode_zombierun", false ) )
	{
		thread MainModeThread_ZombieRun()
		return
	}

	if ( GetCurrentPlaylistVarBool( "freelance_mode_standard", true ) )
		thread MainModeThread()
}


///////
// Intro Fly-In
//

entity function GetSkydiveLeaderForPlayers( array<entity> players )
{
	if ( players.len() == 0 )
		return null

	foreach ( entity player in players )
	{
		if ( player.GetPlayerNetBool( "isJumpmaster" ) )
			return player
	}

	return players[0]
}

void function ResetUltimateCharge( entity player )
{
	entity ult = player.GetOffhandWeapon( OFFHAND_ULTIMATE )
	if ( !IsValid( ult ) )
		return
	ult.SetWeaponPrimaryClipCountAbsolute( 0 )
	ult.RegenerateAmmoReset()
}

void function FreelanceMode_StartTeamInsertionThread_Skydive( int team, vector insertOrigin, vector insertAngles, vector viewAngles )
{
	array<entity> players = GetPlayerArrayOfTeam( team )
	if ( players.len() == 0 )
		return

	thread function() : (team, players, insertOrigin, insertAngles, viewAngles)
	{
		vector newAngles = <15, VectorToAngles( viewAngles ).y, 0>
		foreach( player in players )
			player.SetAngles( newAngles )

		thread RespawnPlayersInDropshipAtPoint( players, insertOrigin, insertAngles, true, false, "npc_dropship_intro" )
		wait 12.0
		{
			array<entity> playersPreJump = GetPlayerArrayOfTeam( team )  // update the list
			entity leader = GetSkydiveLeaderForPlayers( playersPreJump )
			if ( IsValid( leader ) )
				PlayBattleChatterLineToSpeakerAndTeam( leader, "bc_imJumpmaster" )
		}
		wait 4.75
		array<entity> playersPostWait = GetPlayerArrayOfTeam( team )  // update the list
		entity leader = GetSkydiveLeaderForPlayers( playersPostWait )
		foreach( player in playersPostWait )
		{
			SetPlayerIntroDropSettings( player )
			ResetUltimateCharge( player )
			GiveSpawnLoadout( player )
			thread PlayerSkyDive( player, leader.GetViewVector(), playersPostWait, leader, false, false )
			thread PlayerPostSkydiveFixupsThread( player )
		}
		if ( IsValid( leader ) )
			PlayBattleChatterLineToSpeakerAndTeam( leader, "bc_podLeaderLaunch" )
	}()
}

void function FreelanceMode_StartTeamInsertionThread_Dropoff( int team, vector insertOrigin, vector insertAngles, vector viewAngles )
{
	array<entity> players = GetPlayerArrayOfTeam( team )
	if ( players.len() == 0 )
		return

	thread function() : (team, players, insertOrigin, insertAngles, viewAngles)
	{
		vector newAngles = <40, ClampAngle( VectorToAngles( viewAngles ).y + 180.0 ), 0>
		foreach( player in players )
			player.SetAngles( newAngles )

		thread RespawnPlayersInDropshipAtPoint( players, insertOrigin, insertAngles, true, false, "npc_dropship_intro" )
		wait 12.0
		array<entity> playersPostWait = GetPlayerArrayOfTeam( team )  // update the list
		foreach( player in playersPostWait )
		{
			thread PlayerExitsShip( player )
		}
	}()
}
void function PlayerExitsShip( entity player )
{
	if ( !IsAlive( player ) )
		return
	player.EndSignal( "OnDeath" )

	ResetUltimateCharge( player )
	player.FreezeControlsOnServer()
	float startTime = Time()
	while ( true )
	{
		WaitFrame()

		//failsafe to unfreeze player controls
		if ( ( Time() - startTime ) > 5.0 )
			break

		//don't unfreeze player controls till they hit the ground
		if ( ( player.GetOrigin().z - OriginToGround( player.GetOrigin() ).z ) < 24 )
			break
	}
	player.UnfreezeControlsOnServer()
	GiveSpawnLoadout( player )
	player.p.survivalLandedOnGround = true
}

void function IntroSkyDiveInThread()
{
	foreach ( player in GetPlayerArray() )
		player.p.respawnCount = 1    // to skip some checks

	if ( FreelanceMode_GetCurrentPhase() < eFreelanceModePhase.Insertion )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.Insertion, 0 )

	const float MY_SCALE = 1500.0
	const vector MY_BASE = <6630.0, 4200.0, 0.0>
	const vector[3] DROPSHIP_POSITIONS = [
				MY_BASE + <0, (1.0 * MY_SCALE) ,32500>,
				MY_BASE + <(0.866 * MY_SCALE), (-0.5 * MY_SCALE), 32500>,
				MY_BASE + <(-0.866 * MY_SCALE), (-0.5 * MY_SCALE), 32500>
	]
	const vector[3] DROPSHIP_ROTATIONS = [<0,90,0>, <0,-30,0>, <0,210,0>]

	for ( int idx = 0; idx < MAX_SQUADS; ++idx )
	{
		int team = GetTeamFromSquadID( idx )

		vector viewAngles = <15, VectorToAngles( MY_BASE - DROPSHIP_ROTATIONS[idx] ).y, 0>
		FreelanceMode_StartTeamInsertionThread_Skydive( team, DROPSHIP_POSITIONS[idx], DROPSHIP_ROTATIONS[idx], viewAngles )
	}

	/*
	wait ( 5.0 )
	DoFreelanceModeSplashToAll( eModeSplash.Initial )

	wait ( 15.0 )
	DoFreelanceModeSplashToAll( eModeSplash.Falling_NoteObjectives )

	wait ( 10.0 )
	DoFreelanceModeSplashToAll( eModeSplash.Falling_NoteOtherSquads )

	wait ( 10.0 )
	DoFreelanceModeSplashToAll( eModeSplash.Falling_NoteSidequests )
	*/
}

void function IntroInsertionThread_ZombieRun()
{
	foreach ( player in GetPlayerArray() )
		player.p.respawnCount = 1    // to skip some checks

	if ( FreelanceMode_GetCurrentPhase() < eFreelanceModePhase.Insertion )
		FreelanceMode_SetCurrentPhase( eFreelanceModePhase.Insertion, 0 )

	//<16250.8457, 23688.3789, 5037.58545>		// Two Spines, north

	const vector[3] DROPSHIP_POSITIONS = [
		<-14702.8379, 23284.9023, 3910.52563>,		// Slum Lakes, plateau
		<31735.3633, 20141.4355, 3935.27319>,		// Relay/Wetlands, cliffside
		<-21366.7715, -8771.75684, 2878.4231>,		// Outide Airbase
		//<0, 0, 0>  // Todo, South-East, (near tower?)
	]

	const vector[3] DROPSHIP_ROTATIONS = [
		<0, 150, 0>,
		<0, 40, 0>,
		<0, 180, 0>,
		//<0, 0, 0>
	]

	//<16250.8457, 23688.3789, 5037.58545>

	array<int> startIndices
	for ( int ii = 0; ii < DROPSHIP_POSITIONS.len(); ++ii )
		startIndices.append( ii )
	startIndices.randomize()

	for ( int idx = 0; idx < MAX_SQUADS; ++idx )
	{
		int team = GetTeamFromSquadID( idx )

		int startIndex = startIndices[idx % startIndices.len()]
		vector viewAngles = <15, DROPSHIP_ROTATIONS[startIndex].y, 0>
		FreelanceMode_StartTeamInsertionThread_Dropoff( team, DROPSHIP_POSITIONS[startIndex], DROPSHIP_ROTATIONS[startIndex], viewAngles )
	}

	wait ( 5.0 )
	DoFreelanceModeSplashToAll( eModeSplash.Initial_Zombie )
}

void function PlayerPostSkydiveFixupsThread( entity player )
{
	AssertIsNewThread()
	player.EndSignal( "OnDestroy" )

	wait( 1.0 )
	for( ; ; )
	{
		WaitFrame()
		if ( !player.Player_IsSkydiving() )
			break
		if ( player.IsOnGround() )
			break
	}

	const float DEFAULT_ZOOM_LEVEL_ON_GROUND = 2.5
	player.SetMinimapZoomScale( DEFAULT_ZOOM_LEVEL_ON_GROUND, 3.0 )

	wait( 1.0 )
	MapZones_RefreshZoneCalloutForPlayer( player )
}


