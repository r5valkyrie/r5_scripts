void function PveBlockerOnSpawn( entity blocker )
{
	//_gamemode_survival already disables all mission-specific blockers by default and reconnects navmesh
	Assert( blocker.HasKey( "script_noteworthy" ), "Blocker brush at " + blocker.GetOrigin() + " needs a valid script_noteworthy" )
	file.pveBrushBlockers.append( blocker )
}

void function PveBlockerDisable( entity blocker )
{
	if ( !IsValid( blocker ) )
		return
	blocker.Hide()
	blocker.NotSolid()
	ToggleNPCPathsForEntity( blocker, true )

}

void function PveBlockerEnable( entity blocker )
{
	if ( !IsValid( blocker ) )
		return
	blocker.Show()
	blocker.Solid()
	ToggleNPCPathsForEntity( blocker, false )

}

void function PveBlockerDisableByName( string scriptNoteworthy )
{
	int blockersDisabled = 0
	foreach( blocker in file.pveBrushBlockers )
	{
		if ( !IsValid( blocker ) )
			continue

		if ( blocker.kv.script_noteworthy != scriptNoteworthy )
			continue

		PveBlockerDisable( blocker )
		blockersDisabled++
	}

	if ( blockersDisabled == 0 )
		Warning( "%s() - Tried to disable blockers with script_noteworthy '%s' but zero blockers found", FUNC_NAME(), scriptNoteworthy )
}

void function PveBlockerEnableByName( string scriptNoteworthy )
{
	int blockersEnabled = 0
	foreach( blocker in file.pveBrushBlockers )
	{
		if ( !IsValid( blocker ) )
			continue

		if ( blocker.kv.script_noteworthy != scriptNoteworthy )
			continue

		PveBlockerEnable( blocker )
		blockersEnabled++
	}

	if ( blockersEnabled == 0 )
		Warning( "%s() - Tried to enable blockers with script_noteworthy '%s' but zero blockers found", FUNC_NAME(), scriptNoteworthy )

}

array <entity> function PveBlockersGetByScriptNoteworthy( string scriptNoteworthy )
{
	array <entity> blockers
	foreach( blocker in file.pveBrushBlockers )
	{
		if ( !IsValid( blocker ) )
			continue

		if ( blocker.kv.script_noteworthy != scriptNoteworthy )
			continue

		blockers.append( blocker )
	}

	return blockers
}


void function CreditNPCKillToPlayer( entity npc, entity player )
{
	int oldKills = player.GetPlayerNetInt( "kills" )
	player.SetPlayerNetInt( "kills", (oldKills + 1) )
}

int[4] s_squadKillTotals
void function CreditNPCKillToSquad( entity npc, int squadID )
{
	s_squadKillTotals[squadID] += 1

	if ( s_squadKillTotals[squadID] == (s_squadKillsGoal / 2) )
	{
		int team = GetTeamFromSquadID( squadID )
		foreach( teamPlayer in GetPlayerArrayOfTeam( team ) )
			DoFreelanceModeSplashToPlayer( teamPlayer, eModeSplash.KillGoalInProgress )
	}
	if ( s_squadKillTotals[squadID] == s_squadKillsGoal )
	{
		int team = GetTeamFromSquadID( squadID )
		foreach( teamPlayer in GetPlayerArrayOfTeam( team ) )
			DoFreelanceModeSplashToPlayer( teamPlayer, eModeSplash.KillGoalReached )
	}
}

