void function StartUpMode()
{
	// Squad starts:
	array<string> zoneGroupsThatSquadsStartIn
#if 0
	if ( false )
	{
		{
			InitPlayerStarts()
			array<int> startZones
			foreach( StartSet set in s_playerStarts )
			{
				int zoneId = MapZones_GetZoneForOrigin( set.arrival )
				if ( zoneId < 0 )
				{
					vector dropped = DropSpawnToFloor( set.arrival, HULL_HUMAN )
