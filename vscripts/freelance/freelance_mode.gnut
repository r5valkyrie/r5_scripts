const string INTRO_SHIP_ENGINE_SOUND = "HoverTank_Mvmt_Engine" // "HoverTank_Mvmt_Engine_survival"
void function DropShipEngineSoundThread( entity ship )
{
	AssertIsNewThread()
	ship.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function () : ( ship )
		{
			if ( !IsValid( ship ) )
				return

			StopSoundOnEntity( ship, INTRO_SHIP_ENGINE_SOUND )
		}
	)

	EmitSoundOnEntity( ship, INTRO_SHIP_ENGINE_SOUND )
	WaitForever()
}
