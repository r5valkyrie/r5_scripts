array<entity> s_playersThatExtracted
const string SIG_STOPBOUNCING = "ShipStopBouncing"
entity function FreelanceMode_SpawnExtractionDropship( vector origin, vector angles )
{
	RegisterSignal( SIG_MODE_EVERYONE_IS_ON_BOARD_THE_EXTRACTION )
	RegisterSignal( SIG_STOPBOUNCING )

	origin = (origin + EXTRACT_EXTRA_ORIGIN)
	angles = (angles + EXTRACT_EXTRA_ROTATION)

	entity ship = CreateExpensiveScriptMoverModel( MODEL_EXTRACTION_DROPSHIP, origin, angles, SOLID_VPHYSICS, 9999999 )
	entity node = CreateScriptMover( "spawndropship_mover", origin, angles )
	SetTeam( ship, eNpcTeam.FRIENDLY )
	ship.SetParent( node, "REF" )
	thread PlayAnimTeleport( ship, IDLE_EXTRACTION_DROPSHIP, node, "REF" )

	AddEntityDestroyedCallback( ship, void function ( entity ent ) : (ship, node)
	{
		foreach ( player in GetPlayerArray() )
		{
			if ( player.GetParent() == ship )
			{
				player.ClearParent()
				if ( IsInvincible( player ) )
					ClearInvincible( player )
			}
		}

		node.Destroy()
	} )

	thread function() : ( ship, node, origin, angles )
	{
		ship.EndSignal( "OnDestroy" )
		ship.Hide()
		waitthread WarpinEffect( ship, ship.GetModelName(), IDLE_EXTRACTION_DROPSHIP, ship.GetOrigin(), ship.GetAngles() )
		ship.Show()
		EmitSoundOnEntity( ship, INTRO_SHIP_ENGINE_SOUND )

		node.NonPhysicsSetMoveModeLocal( true )
		thread EndingDropshipHoverBounce( node )
		thread EndingDropshipHoverRoll( node, angles )

		ExtractShipInfo info

		//entity trigger = SpawnRadiusTrigger( (origin + AnglesToRight( angles ) * 75.0), 120.0, 350.0, 40.0 )
		entity trigger = SpawnRadiusTrigger( (origin + AnglesToForward( angles ) * -100.0), 120.0, 350.0, 40.0 )
		trigger.ConnectOutput( "OnStartTouch", void function ( entity trigger, entity activator, entity caller, var value ) : (ship, info)
		{
			if ( !IsValid( trigger ) )
				return
			if ( !IsValid( activator ) )
				return
			if ( !activator.IsPlayer() )
				return
			if ( activator.GetParent() )
				return

			printf( "Boarding: '%s'", string( activator ) )

			int index = CountPlayersAttachedTo( ship )
			string tag = EXTRACT_TAGS[index % EXTRACT_TAGS.len()]
			int attachID = ship.LookupAttachment( tag )
			vector attachOrigin = ship.GetAttachmentOrigin( attachID )
			vector attachAngles = ship.GetAttachmentAngles( attachID )

			entity player = activator
			info.playersOnShip.append( player )
			thread function() : (player, attachOrigin, attachAngles, ship, tag)
			{
				player.EndSignal( "OnDestroy" )
				ship.EndSignal( "OnDestroy" )

				MakeInvincible( player )
				if ( player.Player_IsSkydiving() )
				{
					//player.Player_EndSkydive()
					player.Anim_Stop()
					WaitFrame()	// the ol' "just wait two frames and it'll work" trick
					WaitFrame()	// the ol' "just wait two frames and it'll work" trick
				}

				player.SetOrigin( attachOrigin )
				player.SetParent( ship, tag, false, 1.0 )
				player.SnapEyeAngles( FlattenAngles( attachAngles ) )
				ScreenFadeFromBlack( player, 0.25, 0.25 )
				player.SetGroundEntity( ship )
			}()
		})

		OnThreadEnd( function() : (trigger)
		{
			if ( IsValid( trigger ) )
				trigger.Destroy()
		})

		// Waypoint thread:
		entity wp = CreateWaypoint_ObjectiveEnt( ship, "#PVE_WAYPOINT_EVACSHIP", <0,0,0>, $"rui/hud/common/evac_location_enemy" )
		thread function() : ( wp )
		{
			for( ;; )
			{
				wp.EndSignal( "OnDestroy" )
				Waypoint_BumpAnnounceEffect( wp )
				wait 10.0
			}
		}()

		// Early finish thread:
		thread function() : ( ship )
		{
			for( ;; )
			{
				ship.EndSignal( "OnDestroy" )
				WaitFrame()
				if ( CountPlayersAttachedTo( ship ) == GetPlayerArray_Alive().len() )
					FreelanceMode_Signal( SIG_MODE_EVERYONE_IS_ON_BOARD_THE_EXTRACTION )
			}
		}()

		WaitSignal( svGlobal.worldspawn, SIG_MODE_EXTRACTION_GO_NOW )

		//
		wp.Destroy()
		node.Signal( SIG_STOPBOUNCING )
		node.NonPhysicsMoveTo( (node.GetOrigin() + <0, 0, 1000>), (3.0 + WARPINFXTIME), (3.0 + WARPINFXTIME), 0.0 )
		wait( 1.5 )

		trigger.Destroy()
		foreach( player in GetPlayerArray() )
		{
			if ( info.playersOnShip.contains( player ) )
			{
				ClientMusic_PlayCustomTrackOnClient( player, eMusicTrack.DropshipSafe )
				DoFreelanceModeSplashToPlayer( player, eModeSplash.Extraction_Victory )
				s_playersThatExtracted.append( player )
			}
			else
			{
				ClientMusic_PlayCustomTrackOnClient( player, eMusicTrack.DropshipMissed )
				DoFreelanceModeSplashToPlayer( player, eModeSplash.Extraction_Failed )
			}
		}

		wait( 1.5 )

		PlayWarpFxOnPlayers( info.playersOnShip )

		const vector DESTINATION = <27900.0, -6400.0, -27500.0>
		wait WARPINFXTIME
		EmitSoundAtPosition( 0, ship.GetOrigin(), "dropship_mp_epilogue_warpout", ship )
		WarpoutEffectFPS( ship )
		ship.ClearParent()
		thread PlayAnimTeleport( ship, IDLE_EXTRACTION_DROPSHIP_FINISH, DESTINATION, <0, 0, 0> + EXTRACT_EXTRA_ROTATION )
		WaitFrame()
		EmitSoundAtPosition( 0, DESTINATION, "dropship_warpin", ship )
	}()

	return ship
}

void function EndingDropshipHoverBounce( entity node )
{
	node.EndSignal( "OnDestroy" )
	node.EndSignal( SIG_STOPBOUNCING )
	vector localO = node.GetLocalOrigin()
	while ( true )
	{
		float time = RandomFloatRange( 2.0, 4.0 )
		node.NonPhysicsMoveTo( localO + <0,0,RandomFloatRange(5,10)>, time, time * 0.5, time * 0.5 )
		wait time

		time = RandomFloatRange( 2.0, 4.0 )
		node.NonPhysicsMoveTo( localO + <0,0,RandomFloatRange(-5,-10)>, time, time * 0.5, time * 0.5 )
		wait time
	}
}

void function EndingDropshipHoverRoll( entity node, vector angles )
{
	node.EndSignal( "OnDestroy" )
	node.EndSignal( SIG_STOPBOUNCING )
	while ( true )
	{
		float time = RandomFloatRange( 3, 4 )
		node.NonPhysicsRotateTo( angles + <0,0,RandomFloatRange(3,5)>, time, time * 0.5, time * 0.5 )
		wait time

		time = RandomFloatRange( 3, 4 )
		node.NonPhysicsRotateTo( angles + <0,0,RandomFloatRange(-3,-5)>, time, time * 0.5, time * 0.5 )
		wait time
	}
}
#endif // SERVER


//////////
// Match Awards

#if SERVER
ItemFlavor ornull s_postGame_quest = null
int s_postGame_questGUID = -1
int s_postGame_questMissionIndex = -1
bool s_postGame_questIsSuccess
array<entity> s_postGame_questIsFirstTimeVictory

ItemFlavor ornull function FreelanceMode_GetStartofMatchActiveQuest()
{
	return s_postGame_quest
}
int function FreelanceMode_GetStartOfMatchActiveQuestMissionIndex()
{
	return s_postGame_questMissionIndex
}

void function SetupForActiveQuestMission()
{
	ItemFlavor ornull quest = SeasonQuest_GetActiveSeasonQuest( GetUnixTimestamp() )
	if ( quest == null )
		return

	s_postGame_quest = quest
	expect ItemFlavor( quest )
	int missionIndex = SeasonQuest_GetMissionIndexForPlaylistName( quest, GetCurrentPlaylistName() )

	s_postGame_questGUID = ItemFlavor_GetGUID( quest )
	s_postGame_questMissionIndex = missionIndex
}

void function FreelanceMode_PostGame_QuestMissionMarkSuccess()
{
	s_postGame_questIsSuccess = true
}

void function FreelanceMode_PostGame_MarkFirstTimeVictoryForPlayer( entity player )
{
	s_postGame_questIsFirstTimeVictory.append( player )
}

void function FreelanceMode_PostGame_MarkPlayerAsExtracted( entity player )
{
	s_playersThatExtracted.append( player )
}

void function FreelanceMode_MarkMissionSuccessForGivenPlayers( array<entity> players )
{
	FreelanceMode_PostGame_QuestMissionMarkSuccess()

	ItemFlavor ornull quest = FreelanceMode_GetStartofMatchActiveQuest()
	if ( quest != null )
	{
		expect ItemFlavor( quest )
		int missionIndex = FreelanceMode_GetStartOfMatchActiveQuestMissionIndex()
		if ( missionIndex >= 0 )
		{
			foreach ( player in players )
			{
				bool isFirstTime = SeasonQuest_RecordNewMissionSuccessForPlayerIfAllowed( player, quest, missionIndex )
				if ( isFirstTime )
					FreelanceMode_PostGame_MarkFirstTimeVictoryForPlayer( player )
			}
		}
		else
		{
			Warning( "This playlist '%s' is not part of the current season quest, so not recording the victory.", GetCurrentPlaylistName() )
		}
	}
}

void function FreelanceMode_FinalizeMatchDataForPlayer( entity player )
{
	player.SetPersistentVar( "pve.postGame_isValid", true )

	GameSummary_GetPlayerData( player )
	int secondsPlayed = CalcSecondsAliveForPlayer( player )
	int kills = player.GetPlayerNetInt( "kills" )
	bool didExtract = s_playersThatExtracted.contains( player )

	player.SetPersistentVar( "pve.postGame_questGUID", s_postGame_questGUID )
	player.SetPersistentVar( "pve.postGame_questMissionIndex", s_postGame_questMissionIndex )
	player.SetPersistentVar( "pve.postGame_questIsSuccess", s_postGame_questIsSuccess )
	player.SetPersistentVar( "pve.postGame_questIsFirstTimeVictory", s_postGame_questIsFirstTimeVictory.contains( player ) )

	player.SetPersistentVar( "pve.postGame_secondsPlayed", secondsPlayed )
	player.SetPersistentVar( "pve.postGame_kills", kills )
	player.SetPersistentVar( "pve.postGame_didExtract", didExtract )
}

void function FreelanceMode_SetCommentaryDisables()
{
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.PILOT_KILL, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_MOVING, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.FINAL_CIRCLE_MOVING, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_CLOSING_TO_NOTHING, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CARE_PACKAGE_DROPPING, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.FIRST_BLOOD, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.HALF_PLAYERS_ALIVE, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.HALF_SQUADS_ALIVE, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.HOVER_TANK_INBOUND, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.ROUND_TIMER_STARTED, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.FIRST_CIRCLE_MOVING, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_MOVES_1MIN, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_MOVES_10SEC, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_MOVES_30SEC, false )
	SurvivalCommentary_SetEventEnabled( eSurvivalEventType.CIRCLE_MOVES_45SEC, false )
}
