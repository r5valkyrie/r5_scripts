struct ExtractionSiteInfo
{
	vector center
	float radius
	array<table<string, vector> > shipSpots
}
array<ExtractionSiteInfo> s_extractionSites
array<ExtractionSiteInfo> s_extractionBigCircles
int s_extractSiteIndex
int s_extractDropshipIndex
int s_extractBigCircleIndex

void function DoItYYY( int siteIdx, int shipIdx, int bigCircleIdx )
{
	if ( IsValid( s_extractShip ) )
		s_extractShip.Destroy()
	if ( IsValid( s_safeZone ) )
		s_safeZone.Destroy()
	if ( IsValid( s_safeZonePre ) )
		s_safeZonePre.Destroy()

	SetupExtractionSites()
	ChooseExtractionSite()
	if ( siteIdx >= 0 )
		s_extractSiteIndex = siteIdx
	if ( shipIdx >= 0 )
		s_extractDropshipIndex = shipIdx
	if ( bigCircleIdx >= 0 )
		s_extractBigCircleIndex = bigCircleIdx

	ExtractionSiteInfo site = s_extractionSites[s_extractSiteIndex]
	table<string, vector> spot = site.shipSpots[s_extractDropshipIndex]
	s_safeZone = SpawnSafeZone( site.center, site.radius )
	s_extractShip = FreelanceMode_SpawnExtractionDropship( spot.origin, spot.angles )

	ExtractionSiteInfo preSite = s_extractionBigCircles[s_extractBigCircleIndex]
	s_safeZonePre = SpawnSafeZoneNoLine( preSite.center, preSite.radius )
}

int function CountAliveInArray( array<entity> arr )
{
	int result = 0
	foreach( ent in arr )
	{
		if ( IsAlive( ent ) )
			++result
	}
	return result
}

