				Assert( zoneId >= 0 )
				zoneGroupsThatSquadsStartIn.append( MapZones_GetZoneGroupForZone( zoneId ) )
			}
			foreach( groupName in zoneGroupsThatSquadsStartIn )
				printf( "%s() - Team start: '%s'", FUNC_NAME(), groupName )
		}
	}
#endif	// 0

	//
	SetupExtractionSites()
	ChooseExtractionSite()

	//
	array<string> zoneGroupsToRestrict
	array<string> zoneGroupsToBlock
	zoneGroupsToRestrict.extend( zoneGroupsThatSquadsStartIn )
	if ( GetCurrentPlaylistVarBool( "freelance_mode_objectives", false ) )
		RollObjectivesForMode( zoneGroupsToRestrict, zoneGroupsToBlock )

	if ( GetCurrentPlaylistVarBool( "freelance_mode_zombierun", false ) )
		DEV_LaunchObjectiveCount( "breachandclear", 31 )

                  
                                                  
                                                 
                                                     
                                                    

                                

                                                                        
                         

                                                                           
  
                                         
                             
  
                        
