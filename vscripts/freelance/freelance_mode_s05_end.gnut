void function SCB_HatchOpenMoment()
{
	entity emitter = GetClosest( GetEntArrayByScriptName( "Canyonlands_Mu2_Emit_OminousHatch" ), GetLocalViewPlayer().GetOrigin() )
	if ( IsValid( emitter ) )
		emitter.SetEnabled( true )
