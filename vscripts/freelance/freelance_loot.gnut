		case $"mdl/Weapons/rspn101_dmr/w_rspn101_dmr.rmdl":
			lootRef = "mp_weapon_dmr"
			break
		case $"mdl/Weapons/defender/w_defender.rmdl":
			lootRef = "mp_weapon_defender"
			break
		case $"mdl/Weapons/sentinel/w_sentinel.rmdl":
			lootRef = "mp_weapon_sentinel"
			break

