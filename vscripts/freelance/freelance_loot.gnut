			break
		case $"mdl/Weapons/p2011/w_p2011.rmdl":
			lootRef = "mp_weapon_semipistol"
			break
		case $"mdl/Weapons/p2011_auto/w_p2011_auto.rmdl":
			lootRef = "mp_weapon_autopistol"
			break
		case $"mdl/Weapons/b3wing/w_b3wing.rmdl":
			lootRef = "mp_weapon_wingman"
			break

			//SMGs
		case $"mdl/Weapons/alternator_smg/w_alternator_smg.rmdl":
			lootRef = "mp_weapon_alternator_smg"
			break
		case $"mdl/Weapons/r97/w_r97.rmdl":
			lootRef = "mp_weapon_r97"
			break
		case $"mdl/techart/mshop/weapons/class/smg/prowler/prowler_base_w.rmdl":
			lootRef = "mp_weapon_pdw"
			break

			//Shotguns
