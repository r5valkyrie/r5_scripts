			break

		//Attachments - special case (loot resource targets the weapon it wants to be an attachment of in LevelEd)
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_mods_mag_v2b.rmdl":
			return STRING_ATTACHMENT_MAG
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_mods_optic_cq_hcog_r1.rmdl":
			return STRING_ATTACHMENT_SCOPE
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_mods_suppr_v2b.rmdl":
			return STRING_ATTACHMENT_BARREL
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_stock_folded_regular.rmdl":
			return STRING_ATTACHMENT_STOCK
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_mods_chip.rmdl":
			return STRING_ATTACHMENT_HOPUP
			break

		default:
			Warning( "%s() - Unhandled asset name: '%s'", FUNC_NAME(), string( modelAsset ) )
			lootRef = ""
	}

	if ( lootRef != "" && lootLevel > 0 && !isWeaponAttachment )
		lootRef = GetTieredLootRef( lootRef, lootLevel )

	if ( lootRef != "" )
		Assert( SURVIVAL_Loot_IsRefValid( lootRef ), "Invalid loot ref: " + lootRef )

	return lootRef
}

int function GetWeaponAttachmentTypeFromString( string ref )
{
	if ( ref == STRING_ATTACHMENT_MAG )
		return eWeaponAttachmentType.MAG
	if ( ref == STRING_ATTACHMENT_SCOPE )
		return eWeaponAttachmentType.SCOPE
	if ( ref == STRING_ATTACHMENT_BARREL )
		return eWeaponAttachmentType.BARREL
	if ( ref == STRING_ATTACHMENT_HOPUP )
		return eWeaponAttachmentType.HOPUP
	if ( ref == STRING_ATTACHMENT_STOCK)
		return eWeaponAttachmentType.STOCK

	Assert( false, "Unhandled string: " + ref )

	unreachable
}
string function GetTieredLootRef( string lootRef, int lootLevel )
{
	//Backpacks
	if ( lootRef == "backpack_pickup_lv1" )
	{
		if ( lootLevel == 0 || lootLevel == 1 )
			return lootRef
		else if ( lootLevel == 2 )
			return "backpack_pickup_lv2"
		else if ( lootLevel == 3 )
			return "backpack_pickup_lv3"
		else
			return "backpack_pickup_lv4_revive_boost"
	}

	//Body shields
	if ( lootRef == "armor_pickup_lv1" )
	{
		if ( lootLevel == 0 || lootLevel == 1 )
			return lootRef
		else if ( lootLevel == 2 )
			return "armor_pickup_lv2"
		else if ( lootLevel == 3 )
			return "armor_pickup_lv3"
		else
			return "armor_pickup_lv4_all_fast"
	}


	//Helmet
	if ( lootRef == "helmet_pickup_lv1" )
	{
		if ( lootLevel == 0 || lootLevel == 1 )
			return lootRef
		else if ( lootLevel == 2 )
			return "helmet_pickup_lv2"
		else if ( lootLevel == 3 )
			return "helmet_pickup_lv3"
		else
			return "helmet_pickup_lv4_abilities"
	}

	//Knockdown shields
	if ( lootRef == "incapshield_pickup_lv1" )
	{
		if ( lootLevel == 0 || lootLevel == 1 )
			return lootRef
		else if ( lootLevel == 2 )
			return "incapshield_pickup_lv2"
		else if ( lootLevel == 3 )
			return "incapshield_pickup_lv3"
		else
			return "incapshield_pickup_lv4_selfrevive"
	}

	//Weapons
	if ( lootLevel == 4 )
	{
		//return the "gold" variant if it exists for level 4
		string lootRefCandidate = lootRef + WEAPON_LOCKEDSET_SUFFIX_GOLD
		if ( SURVIVAL_Loot_IsRefValid( lootRefCandidate ) )
			return lootRefCandidate
	}

	return lootRef
}

LootWeaponAttachments function GetAllAttachmentsForWeapon( string weaponRef, int lootLevel )
{
	Assert ( weaponRef.find( "mp_weapon" ) >= 0, "Invalid mp_weapon name: " + weaponRef )

	//Get all supported attachments of the specified tier and return a random assortment, one for each slot
	int maxTier = lootLevel
	int minTier = lootLevel
	if ( lootLevel == 4 )
		minTier = 3 //if a weapon doesn't have a gold attachment, still want at least a purple to spawn

	array<LootData> lootAttachmentData = SURVIVAL_Loot_GetByType_InLevel( eLootType.ATTACHMENT, maxTier, minTier )
	LootWeaponAttachments weaponAttachments
	array<LootData> validAttachments

	foreach( LootData data in lootAttachmentData )
	{
		//no inval;id attachments
		if ( !CanAttachToWeapon( data.ref, weaponRef ) )
			continue

		//no dupes
		if ( validAttachments.contains( data ) )
			continue

		//add to appropriate array
		if ( data.attachmentStyle.find( "sight" ) >= 0 )
			weaponAttachments.attachmentRefsScopes.append( data.ref )

		else if ( data.attachmentStyle.find( "mag" ) >= 0 )
			weaponAttachments.attachmentRefsMag.append( data.ref )

		else if ( data.attachmentStyle.find( "barrel" ) >= 0 )
			weaponAttachments.attachmentRefsBarrel.append( data.ref )

		else if ( data.attachmentStyle.find( "stock" ) >= 0 )
			weaponAttachments.attachmentRefsGrip.append( data.ref )

		else if ( data.attachmentStyle.find( "hopup" ) >= 0 )
			weaponAttachments.attachmentRefsHopups.append( data.ref )

		else if ( data.attachmentStyle.find( "hopupMulti_a" ) >= 0 )
			weaponAttachments.attachmentRefsHopups.append( data.ref )

		else if ( data.attachmentStyle.find( "hopupMulti_b" ) >= 0 )
			weaponAttachments.attachmentRefsHopups.append( data.ref )

		else
			printf( "%s() -Unhandled attachementStyle %s", FUNC_NAME(), data.attachmentStyle )

		//add to processed attachments so we dont dupe
		validAttachments.append( data )
	}

	return weaponAttachments
}

string function GetAttachmentLootRefForWeapon( int attachmentType, string weaponRef, int lootLevel )
{
	Assert ( weaponRef.find( "mp_weapon" ) >= 0 )
	//Get all supported attachments of the specified tier and return a random assortment, one for each slot
	int maxTier = lootLevel
	int minTier = lootLevel
	array<LootData> lootAttachmentData = SURVIVAL_Loot_GetByType_InLevel( eLootType.ATTACHMENT, maxTier, minTier )
	LootWeaponAttachments weaponAttachments = GetAllAttachmentsForWeapon( weaponRef, lootLevel )

	array<string> attachments
	if ( attachmentType == eWeaponAttachmentType.MAG )
		attachments = weaponAttachments.attachmentRefsMag
	if ( attachmentType == eWeaponAttachmentType.STOCK )
		attachments = weaponAttachments.attachmentRefsGrip
	if ( attachmentType == eWeaponAttachmentType.BARREL )
		attachments = weaponAttachments.attachmentRefsBarrel
	if ( attachmentType == eWeaponAttachmentType.SCOPE )
		attachments = weaponAttachments.attachmentRefsScopes
	if ( attachmentType == eWeaponAttachmentType.HOPUP )
		attachments = weaponAttachments.attachmentRefsHopups

	if ( attachments.len() > 0 )
		return attachments.getrandom()
	else
		return ""

	unreachable
}

array<string> function GetAdditionalLootRefsForLootSpawn( LootSpawn lootSpawn, int maxAttachments = -1 )
{
	//Some loot spawners want additonal loot to always spawn with them
	//EXAMPLE: I put a level-2 R-301 in the level, I would like it to spawn with a random collection of valid attachments of that level

	string lootRef = lootSpawn.lootRef
	int lootLevel = lootSpawn.lootLevel
	array<string> additionalRefs

	//currently only care about spawning weapon attachments
	if ( lootRef.find( "mp_weapon" ) != 0 )
		return additionalRefs

	//no attachments needed for level 0 weapons
	if ( lootLevel == 0 )
		return additionalRefs

	//Gold weapon (and other locked sets), no need to spawn additional attachments
	if ( WeaponLootRefIsLockedSet( lootRef ) )
		return additionalRefs

	//check if any supported attachments at all for weapon
	LootData weaponData = SURVIVAL_Loot_GetLootDataByRef( lootRef )
	if ( weaponData.supportedAttachments.len() == 0 )
		return additionalRefs

	//Get all supported attachments of the specified tier and return a random assortment, one for each slot
	LootWeaponAttachments weaponAttachments = GetAllAttachmentsForWeapon( lootRef, lootLevel )

	if ( weaponAttachments.attachmentRefsBarrel.len() > 0 )
		additionalRefs.append( weaponAttachments.attachmentRefsBarrel.getrandom() )

	if ( weaponAttachments.attachmentRefsMag.len() > 0 )
		additionalRefs.append( weaponAttachments.attachmentRefsMag.getrandom() )

	if ( weaponAttachments.attachmentRefsHopups.len() > 0 )
		additionalRefs.append( weaponAttachments.attachmentRefsHopups.getrandom() )

	if ( weaponAttachments.attachmentRefsScopes.len() > 0 )
		additionalRefs.append( weaponAttachments.attachmentRefsScopes.getrandom() )

	if ( weaponAttachments.attachmentRefsGrip.len() > 0 )
		additionalRefs.append( weaponAttachments.attachmentRefsGrip.getrandom() )

	additionalRefs.randomize()

	if ( maxAttachments > 0 && maxAttachments < additionalRefs.len() )
		additionalRefs.resize( maxAttachments )

	return additionalRefs

}
