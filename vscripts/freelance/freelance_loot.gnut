		case $"mdl/weapons_r5/loot/w_loot_wep_iso_shield_battery_large.rmdl":
			lootRef = "health_pickup_combo_large"
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_shield_battery_small.rmdl":
			lootRef = "health_pickup_combo_small"
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_phoenix_kit_v1.rmdl":
			lootRef = "health_pickup_combo_full"
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_ultimate_accelerant.rmdl":
			lootRef = "health_pickup_ultimate"
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_ammo_sc.rmdl":
			lootRef = BULLET_AMMO
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_ammo_hc.rmdl":
			lootRef = HIGHCAL_AMMO
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_ammo_shg.rmdl":
			lootRef = SHOTGUN_AMMO
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_ammo_sniper.rmdl":
			lootRef = SNIPER_AMMO
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_wep_ammo_nrg.rmdl":
			lootRef = SPECIAL_AMMO
			break
		case $"mdl/humans_r5/loot/w_loot_char_backpack_heavy.rmdl":
			lootRef = "backpack_pickup_lv1"
			break
			//Shields
		case $"mdl/weapons_r5/loot/_master/w_loot_cha_shield_upgrade_body.rmdl":
			lootRef = "armor_pickup_lv1"
			break
		case $"mdl/weapons_r5/loot/_master/w_loot_cha_shield_upgrade_head.rmdl":
			lootRef = "helmet_pickup_lv1"
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_shield_down_v1.rmdl":
			lootRef = "incapshield_pickup_lv1"
			break

			//Grenades
		case $"mdl/weapons/grenades/w_thermite_grenade.rmdl":
			lootRef = "mp_weapon_thermite_grenade"
			break
		case $"mdl/weapons/grenades/w_loot_m20_f_grenade_projectile.rmdl":
			lootRef = "mp_weapon_frag_grenade"
			break
		case $"mdl/weapons_r5/loot/w_loot_wep_iso_shuriken.rmdl":
			lootRef = GRENADE_EMP_WEAPON_NAME
			break

			//Pistols
		case $"mdl/Weapons/pstl_sa3/w_pstl_sa3.rmdl":
