			break
		case $"mdl/Weapons/lmg_hemlok/w_lmg_hemlok.rmdl":
			lootRef = "mp_weapon_lmg"
			break
		case $"mdl/Weapons/lstar/w_lstar.rmdl":
			lootRef = "mp_weapon_lstar"
