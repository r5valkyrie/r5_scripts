			break
		case $"mdl/techart/mshop/weapons/class/assault/flatline/flatline_base_w.rmdl":
			lootRef = "mp_weapon_vinson"
			break
		case $"mdl/Weapons/m1a1_hemlok/w_hemlok.rmdl":
			lootRef = "mp_weapon_hemlok"
			break
		case $"mdl/techart/mshop/weapons/class/assault/g7/g7_base_w.rmdl":
