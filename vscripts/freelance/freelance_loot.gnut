void function PVELoot_InitForGameMode()
{
	if ( Freelance_IsHubLevel() )
		return

	AddCallback_GameStateEnter( eGameState.Playing, OnGameStateEnterPlaying )
}

void function OnGameStateEnterPlaying()
{
	thread PVELootGarbageCollectionThread()

}

// --------------------------------------------------------------------------------------
//
//	Loot drops
//
// --------------------------------------------------------------------------------------

array<entity> function LootDrop_( vector dropOrg, string refOrGroup, float chance, int countOverride )
{
	string ref = GetRefOrRefFromGroup( refOrGroup.tolower() )
	if ( ref == "blank" )
		return []

	if ( chance < 1.0 )
	{
		float roll = RandomFloat( 1.0 )
		if ( roll > chance )
			return []
	}

	int countPerDropRaw = SURVIVAL_Loot_GetLootDataByRef( ref ).countPerDrop
	int totalCount = ((countOverride >= 0) ? countOverride : countPerDropRaw)
	int countPerDrop = minint( countPerDropRaw, totalCount )
	int numDrops = ceil( totalCount.tofloat() / countPerDrop.tofloat() ).tointeger()

	array<entity> results
	for( int i = 0; i < numDrops; i++ )
	{
		vector vel = RandomVec( 150 )
		vel = Normalize( <vel.x,vel.y,250> )
		entity lootEnt = SURVIVAL_ThrowLootFromPoint( dropOrg, vel, ref, countPerDrop, null, null )
		MarkLootForGarbageCollection( lootEnt, Time() )
		results.append( lootEnt )
	}
	return results
}

array<entity> function LootDrop( vector origin, string refOrGroup )
{
	return LootDrop_( origin, refOrGroup, 1.0, -1 )
}

array<entity> function LootDropChance( vector origin, string refOrGroup, float chance )
{
	return LootDrop_( origin, refOrGroup, chance, -1 )
}

array<entity> function AmmoDrop( vector origin, string refOrGroup, int count )
{
	return LootDrop_( origin, refOrGroup, 1.0, count )
}
array<entity> function AmmoDropChance( vector origin, string refOrGroup, int count, float chance )
{
	return LootDrop_( origin, refOrGroup, chance, count )
}

////

void function RollAmmoDropsForPlayer( vector org, float chance, entity player )
{
	                             
		if ( IsPlayerShadowZombie( player ) )
			return
                                    

	array<string> ammoTypes = GetAmmoPoolTypesUsedByPlayer( player )
	ammoTypes.randomize()
	foreach( int index, string ammoType in ammoTypes )
	{
		if ( index >= 2 )
			break
		AmmoDropChance( org, ammoType, -1, chance )
	}
}

// --------------------------------------------------------------------------------------
//
//	Loot garbage collection
//
// --------------------------------------------------------------------------------------
struct LootItem
{
	entity ent
	float timeDropped
}

const float PVE_LOOT_DESPAWN_TIME = 180.0


array<LootItem> s_pveLootCollectionArray

void function PVELootGarbageCollectionThread()
{
	for ( ;; )
	{
#if DEVELOPER
		float preFrameTime = Time()
#endif

		PVELootGarbageCollection()

#if DEVELOPER
		float postFrameTime = Time()
		Assert( preFrameTime == postFrameTime, format( "PVELootGarbageCollection() stalled for %.2f seconds. Should have no waits.", (postFrameTime - preFrameTime) ) )
#endif

		wait 0.2
	}
}

void function PVELootGarbageCollection()
{
	if ( s_pveLootCollectionArray.len() <= 0 )
		return

	LootItem item = s_pveLootCollectionArray[0]

	if ( Time() > item.timeDropped + PVE_LOOT_DESPAWN_TIME )
	{
		printf( "Garbage collecting PVE loot item %s.", string( item ) )
		s_pveLootCollectionArray.remove( 0 )
		if ( IsValid( item.ent ) )
			item.ent.Destroy()
	}

	return
}

//could insertion sort, but just gonna assume
void function MarkLootForGarbageCollection( entity ent , float timeDropped )
{
	LootItem item
	item.ent = ent
	item.timeDropped = timeDropped
	s_pveLootCollectionArray.append( item )
}

entity function CreateLegendDeathbox( SkitInstance si, vector origin, vector angles, array<string> lootRefs, int character, string flagToSpawn = "" )
{
	array<entity> items
	foreach( lootRef in lootRefs )
	{
		LootData data = SURVIVAL_Loot_GetLootDataByRef( lootRef )
		entity item   = SpawnGenericLoot( data.ref, origin, < -1, -1, -1 >, data.countPerDrop )
		items.append( item )
	}

	//Hack...need a better way to do this
	string playerName
	int characterIndex
	//9 - pathfinder
	//10 - wraith
	//11 - wattson
	//12 - crypto
	//13 - revenant
	//14 - loba


	if ( character == eLegendType.CHARACTER_OCTANE )
	{
		playerName = "Octane"
		characterIndex = 8
	}
	else if ( character == eLegendType.CHARACTER_WATTSON )
	{
		playerName = "Wattson"
		characterIndex = 11
	}
	else
		playerName = "#INITIAL_PLAYER_NAME"

	string hint = "#DEATHBOX_HINT"
	//hint = Localize( hint, playerName )
	entity box = CreateUtilityDeathBox( origin, angles, items, hint )
	box.SetNetInt( "ownerEHI", 0 )
	//box.SetNetInt( "overrideRUIType", 2 )
	box.SetNetInt( "characterIndex", characterIndex )
	box.SetCustomOwnerName( playerName )

	if ( flagToSpawn != "" )
	{
		box.MakeInvisible()
		box.NotSolid()
		thread FakeAnimateDeathBoxOnFlag( si, box, flagToSpawn )
	}

	return box
}

void function FakeAnimateDeathBoxOnFlag( SkitInstance si, entity box, string flag )
{
	AssertIsNewThread()
	SkFlagWait( si, flag )

	vector origin = box.GetOrigin()
	vector angles = box.GetAngles()
	vector restPos = origin
	vector fallPos = restPos + < 0, 0, 54 >
	entity mover = CreateScriptMover( "fakeanimatedeathboxonflag_mover", restPos, angles, 0 )
	box.SetParent( mover, "", true )
	box.MakeVisible()
	box.Solid()
	mover.NonPhysicsMoveTo( fallPos, 0.5, 0.0, 0.5 )
	wait 0.5
	mover.NonPhysicsMoveTo( restPos, 0.5, 0.5, 0.0 )
	wait 0.5
	if ( IsValid( box ) )
		box.ClearParent()
	mover.Destroy()
}

