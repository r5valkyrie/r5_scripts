const string STRING_ATTACHMENT_MAG = "attachment_mag"
const string STRING_ATTACHMENT_SCOPE = "attachment_scope"
const string STRING_ATTACHMENT_BARREL = "attachment_barrel"
const string STRING_ATTACHMENT_STOCK = "attachment_stock"
const string STRING_ATTACHMENT_HOPUP = "attachment_hopup"

struct LootWeaponAttachments
{
	array<string> attachmentRefsBarrel
	array<string> attachmentRefsMag
	array<string> attachmentRefsHopups
	array<string> attachmentRefsScopes
