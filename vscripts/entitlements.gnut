table<entity, bool> checkedPlayerRewardsSet = {}

global table<string, array< ItemFlavor > > eaAccessRewardRefs
global table<string, array< ItemFlavor > > psPlusRewardRefs

global table< int, table<ItemFlavor, array< ItemFlavor > > > entitlementRewardMap
global table< int, table<ItemFlavor, array< int > > > entitlementRewardCountsMap

global table<entity, bool> playersToCheckForUpgrade
global array< ItemFlavor > upgradableAccessRewardRefs

#if UI
struct DialogQueueEntry
{
	asset assetRef
	int entitlementGUID
	string persistenceVarName
}
array< DialogQueueEntry > dialogQueue
#endif

const string GENERIC_ACKNOWLEDGEMENT_PVAR = "genericEntitlementsAcknowledgement"

const string entitlementSequenceNameTemplate = "%s_SequenceRewardVariable"
const string entitlementPersistenceStructName = "entitlementsSequenceRewards"

global enum eEntitlementType
{
	FIRSTPARTY,
	TWITCH_PRIME,
	TWITCH_DROPS,
	_COUNT
}

global enum eFirstPartyRewardType
{
	PS_PLUS,
	XBOX_GOLD,
	_COUNT
}

struct FileStruct_LifetimeLevel
{
#if UI
	bool hasRunMenuEntitlementsFirstTime = false
	bool hasEntitlementsInitialized = false
#endif
}
FileStruct_LifetimeLevel& fileLevel

void function Entitlements_LevelInit()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

	entitlementRewardMap.clear()
	entitlementRewardCountsMap.clear()
	for ( int entitlementType = 0; entitlementType < eEntitlementType._COUNT; entitlementType++ )
	{
		entitlementRewardMap[entitlementType] <- {}
		entitlementRewardCountsMap[entitlementType] <- {}
	}

	//eaAccessRewardRefs["founders_pack"] <- []
	//eaAccessRewardRefs["starters_pack"] <- []

	AddCallback_RegisterRootItemFlavors( void function() {
		array<asset> entitlementAssetArray = GetBaseItemFlavorsFromArray( "entitlements" )
		entitlementAssetArray.reverse() // Reversed to show newest first. New entries are generally added at the end of the list in bakery.
		foreach ( asset entitlementAsset in entitlementAssetArray )
			RegisterItemFlavorFromSettingsAsset( entitlementAsset )

		foreach ( asset apexCoinAsset in GetBaseItemFlavorsFromArray( "apexCoinAmounts" ) )
			RegisterItemFlavorFromSettingsAsset( apexCoinAsset )
	} )

	AddCallback_OnItemFlavorRegistered( eItemType.character_skin, UnlockFuncRegister )
	AddCallback_OnItemFlavorRegistered( eItemType.weapon_skin, UnlockFuncRegister )
	AddCallback_OnItemFlavorRegistered( eItemType.gladiator_card_frame, UnlockFuncRegister )
	AddCallback_OnItemFlavorRegistered( eItemType.gladiator_card_badge, UnlockFuncRegister )

	AddCallback_OnItemFlavorRegistered( eItemType.entitlement, EntitlementRegister )

	#if SERVER && DEVELOPER
		AddCallback_GeneratePDef( GenerateEntitlementsPDef )
	#endif

	#if SERVER || CLIENT
		Remote_RegisterServerFunction( "ClientCallback_MarkEntitlementMenuSeen", "int", 0, INT_MAX )
		Remote_RegisterUIFunction( "ServerToUI_EntitlementInitialized" )
	#endif

	#if SERVER
		AddCallbackOrMaybeCallNow_OnAllItemFlavorsRegistered( EntitlementsPopulate )
		AddCallback_FirstTimeInventoryClean( EntitlementsDoFirstTimeInventoryIsClean )
	#endif
}

#if SERVER
void function EntitlementsDoFirstTimeInventoryIsClean( entity player )
{
	thread EntitlementsDoFirstTimeInventoryIsCleanThread( player )
}
#endif

#if SERVER
void function EntitlementsDoFirstTimeInventoryIsCleanThread( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDisconnecting" )

	do {
		WaitFrame()
		if ( !IsValid( player ) )
		{
			return
		}
	} while ( !HasChallengeThreadCompletedForPlayer( player ) )

	if ( GetActiveBattlePass() != null && !Challenges_AreStatCallbacksRegistered( player ) )
	{
		printt("Challenge thread completed without registering challenge stat callbacks. Exiting without granting entitlements.")
		return
	}

	if ( player in checkedPlayerRewardsSet )
		return

	checkedPlayerRewardsSet[player] <- true

	if ( expect bool( player.GetPersistentVar( GENERIC_ACKNOWLEDGEMENT_PVAR ) ) == false )
		player.SetPersistentVar( GENERIC_ACKNOWLEDGEMENT_PVAR, true )

	string playerPlatform = player.GetPlayerPlatformName().tolower()

	DoFirstPartyEntitlements( player, playerPlatform )

	DoTwitchPrime( player )

	DoTwitchDrops( player )

	if ( GetCurrentPlaylistVarBool( "ea_access_gives_premium_pass", false ) )
		thread TryGivePremiumPassForEAAccess( player )

	Remote_CallFunction_UI( player, "ServerToUI_EntitlementInitialized" )
}
#endif

#if SERVER
void function DoFirstPartyEntitlements( entity player, string playerPlatform )
{
	if ( GetCurrentPlaylistVarBool( "allow_entitlement_upgrade", true ) )
	{
		// Conversion of old EA Access/PS Plus Pack 01 rewards from entitlement based into marketplace
		//
		// If a player has the "accessAcknowledged" bit or "plusAcknowledged" bit set in persistence, that means that at some point in the past they
		// were detected as having owned those entitlements, and were shown a popup stating such.
		// Now, we use these bits to give marketplace items.  Once all of these items are shown as owned (checkedItemCount == ownedItemCount below)
		// we clear the bit from persistence, so that we're not running marketplace queries for players every time they connect.
		//
		// This should be "safe" since the script that would initially set those bits has since been removed.

		if ( player.GetPersistentVarAsInt( "accessAcknowledged" ) > 0 )
		{
			// Meh.
			if ( !upgradableAccessRewardRefs.contains( GetItemFlavorByAsset( $"settings/itemflav/gcard_badge/account/ea_access_member.rpak" ) ) )
				upgradableAccessRewardRefs.append( GetItemFlavorByAsset( $"settings/itemflav/gcard_badge/account/ea_access_member.rpak" ) )

			int checkedItemCount = 0
			int ownedItemCount = 0

			foreach ( ItemFlavor flavor in upgradableAccessRewardRefs )
			{
				Assert( ItemFlavor_GetGRXMode( flavor ) == eItemFlavorGRXMode.REGULAR, "Invalid mode for function " + ItemFlavor_GetGRXMode( flavor ) + " " + string(ItemFlavor_GetAsset( flavor )) )

				if ( ItemFlavor_HasUnlockFunc( flavor ) )
				{
					string unlockFuncKey = ItemFlavor_GetUnlockFuncKey( flavor )
					if ( unlockFuncKey == "origin_access_on_pc" && !(playerPlatform == "pc" || playerPlatform == "pc_steam") )
						continue
					else if ( unlockFuncKey == "ea_access_on_xbox" && !(playerPlatform == "x1") )
						continue
				}

				checkedItemCount++
				if ( GRX_HasItem( player, ItemFlavor_GetGRXIndex( flavor ) ) )
				{
					ownedItemCount++
					continue
				}

				ScriptGRXOperationInfo operation
				operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_ITEM
				operation.doOperationFunc = (void function( int opID ) : ( player, flavor )
				{
					GRX_GiveCosmetic( player, opID, ItemFlavor_GetGRXIndex( flavor ) )
				})
				operation.onDoneCallback = (void function( int status ) : ( player, flavor ) {
					bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
					if ( !didOperationSucceed )
						return

					GRX_MarkAsNewIfAppropriate( player, flavor )
				})
				operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( flavor )
				QueueGRXOperation( player, operation, false )
			}

			if ( checkedItemCount == ownedItemCount )
				player.SetPersistentVar( "accessAcknowledged", false )
		}
	}

	TryGiveFirstPartyEntitlements( player )
}
#endif

#if SERVER
// Determines if any of an entitlement's items are stackable.
bool function EntitlementUsesRewardSequence( array<ItemFlavor> itemList )
{
	foreach( ItemFlavor flavor in itemList )
	{
		if ( ItemFlavorIsStackable( flavor ) )
		{
			return true
		}
	}
	return false
}
#endif

#if SERVER
// Returns a table of all rewards and their counts for a given entitlement.
table< ItemFlavor, int > function GetEntitlementRewardsTable( ItemFlavor entitlementFlav, int entitlementType )
{
	Assert( entitlementFlav in entitlementRewardMap[entitlementType] && entitlementFlav in entitlementRewardCountsMap[entitlementType],
		   "Could not get rewards table for entitlement." )
	table< ItemFlavor, int > rewardsTable
	array<ItemFlavor> itemList = entitlementRewardMap[entitlementType][entitlementFlav]
	array<int> itemCounts = entitlementRewardCountsMap[entitlementType][entitlementFlav]
	for ( int i = 0; i < itemList.len(); ++i )
	{
		rewardsTable[itemList[i]] <- itemCounts[i]
	}
	return rewardsTable
}
#endif

#if SERVER
void function SetEntitlementAsGivenInPlayerState( entity player, int entitlementType, string entitlementRef, ItemFlavor entitlementFlav )
{
	switch( entitlementType )
	{
		case eEntitlementType.TWITCH_PRIME:
		{
			player.UserWasGivenTwitchPrimeReward( entitlementRef )
			return
		}
		case eEntitlementType.TWITCH_DROPS:
		{
			string menuPersistenceName = Entitlement_GetMenuPersistenceVarName( entitlementFlav )
			if ( menuPersistenceName != GENERIC_ACKNOWLEDGEMENT_PVAR )
				player.SetPersistentVar( menuPersistenceName, 0 )
			return
		}
	}
}
#endif

#if SERVER
// Executes a reward sequence for an entitlement. NOTE: This function should only be called for entitlements with
// stackable items (packs, currency, consumables). Otherwise, you don't need an reward sequence. Just simply check if
// the player owns each item in the entitlement.
void function HandleRewardSequenceForEntitlement( entity player, ItemFlavor entitlementFlav, int entitlementType, string entitlementRef, int queryGoal )
{
	// Check if the reward is already acknowledged from previous sessions
	if ( player.GetPersistentVarAsInt( Entitlement_GetMenuPersistenceVarName( entitlementFlav ) ) > 0 )
		return

	ScriptGRXOperationInfo operation
	operation.expectedQueryGoal = queryGoal
	operation.DEV_goalInfo = "entitlement_" + entitlementRef
	ItemFlavorBag rewards = MakeItemFlavorBag( GetEntitlementRewardsTable( entitlementFlav, entitlementType ) )
	operation.doOperationFunc = ( void function( int opID ) : ( player, entitlementFlav, rewards, queryGoal )
	{
		string entitlementSequenceName = format( entitlementSequenceNameTemplate,
												ItemFlavor_GetHumanReadableRefForPIN_Slow( entitlementFlav ) )
		GRX_GiveSequenceRewardEasy( player, opID, queryGoal, entitlementPersistenceStructName + "." + entitlementSequenceName, 0, 1, rewards )
	})
	operation.onDoneCallback = ( void function( int status ) : ( player, entitlementFlav, entitlementType, entitlementRef, rewards ) {
		bool didOperationSucceed = ( status == eScriptGRXOperationStatus.DONE_SUCCESS )
		if ( !didOperationSucceed )
		{
			return
		}

		foreach ( ItemFlavor reward in rewards.flavors )
		{
			GRX_MarkAsNewIfAppropriate( player, reward )
		}
		SetEntitlementAsGivenInPlayerState( player, entitlementType, entitlementRef, entitlementFlav )
	} )
	QueueGRXOperation( player, operation, false )
}
#endif

#if SERVER
void function DoTwitchPrime( entity player )
{
	// Twitch Prime entitlements
	foreach ( ItemFlavor entitlementFlav, array<ItemFlavor> itemList in (entitlementRewardMap[eEntitlementType.TWITCH_PRIME]) )
	{
		string twitchPrimeRef = Entitlement_GetTwitchPrimeRef( entitlementFlav )
		if ( !player.DoesUserHaveTwitchPrimeReward( twitchPrimeRef ) )
		{
			continue
		}

		// If any of these items are stackable, go into reward sequence flow.
		// if NONE are stackable, do the existing individual granting flow.
		if ( EntitlementUsesRewardSequence( itemList ) )
		{
			HandleRewardSequenceForEntitlement( player, entitlementFlav,  eEntitlementType.TWITCH_PRIME, twitchPrimeRef, GRX_HTTPQUERYGOAL_GIVE_AMAZON_PRIME_SEQUENCE_REWARD )
			continue
		}
		foreach ( ItemFlavor flavor in itemList )
		{
			Assert( ItemFlavor_GetGRXMode( flavor ) == eItemFlavorGRXMode.REGULAR, "Invalid mode for function " + ItemFlavor_GetGRXMode( flavor ) )
			if ( GRX_HasItem( player, ItemFlavor_GetGRXIndex( flavor ) ) )
				continue

			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_ITEM
			operation.doOperationFunc = (void function( int opID ) : ( player, flavor )
			{
				GRX_GiveCosmetic( player, opID, ItemFlavor_GetGRXIndex( flavor ) )
			})
			operation.onDoneCallback = (void function( int status ) : ( player, twitchPrimeRef, flavor ) {
				bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
				if ( !didOperationSucceed )
					return

				GRX_MarkAsNewIfAppropriate( player, flavor )

				player.UserWasGivenTwitchPrimeReward( twitchPrimeRef )
			})
			operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( flavor )
			QueueGRXOperation( player, operation, false )
		}
	}
}
#endif

#if SERVER
void function DoTwitchDrops( entity player )
{
	// Twitch Drops entitlements
	// Keep user's inventory consistent with whatever Drops entitlements Twitch says they've claimed
	// If they've claimed items on Twitch that don't exist in their inventory, add them.
	// If they've got items in their inventory that don't exist on Twitch, remove them.

	//if ( player.AreTwitchDropsInitialized() )
	{
		// Array to collect items we might want to delete when managing inventory
		array<ItemFlavor> itemsToRemove = []
		array<ItemFlavor> entitlementsToReset = []

		foreach ( ItemFlavor entitlementFlav, array<ItemFlavor> itemList in (entitlementRewardMap[eEntitlementType.TWITCH_DROPS]) )
		{
			// Determine if we think the player has claimed any entitlements on Twitch
			string twitchDropsRef = Entitlement_GetTwitchPrimeRef( entitlementFlav )
			//if ( !player.DoesUserHaveTwitchDrops( twitchDropsRef ) )
			{
			//	continue
			}

			// If any of these items are stackable, go into reward sequence flow.
			// If NONE are stackable, do the existing individual granting flow.
			if ( EntitlementUsesRewardSequence( itemList ) )
			{
				HandleRewardSequenceForEntitlement( player, entitlementFlav, eEntitlementType.TWITCH_DROPS, twitchDropsRef, GRX_HTTPQUERYGOAL_GIVE_TWITCH_DROP_SEQUENCE_REWARD )
				continue
			}

			bool hasDropsToAward = false//player.DoesUserHaveTwitchDrops( twitchDropsRef )

			foreach ( ItemFlavor flavor in itemList )
			{
				Assert( ItemFlavor_GetGRXMode( flavor ) == eItemFlavorGRXMode.REGULAR, "Invalid mode for function " + ItemFlavor_GetGRXMode( flavor ) )
				bool hasItemInInventory = GRX_HasItem( player, ItemFlavor_GetGRXIndex( flavor ) )

				// Perform MTX add/remove, depending:
				if ( hasDropsToAward )
				{
					if ( !hasItemInInventory )
					{
						// Grant item to player, mark as new in inventory
						ScriptGRXOperationInfo operation
						operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_ITEM
						operation.doOperationFunc = (void function( int opID ) : ( player, flavor )
						{
							GRX_GiveCosmetic( player, opID, ItemFlavor_GetGRXIndex( flavor ) )
						})
						operation.onDoneCallback = ( void function( int status ) : ( player, twitchDropsRef, flavor, entitlementFlav ) {
							bool didOperationSucceed = ( status == eScriptGRXOperationStatus.DONE_SUCCESS )
							if ( !didOperationSucceed )
								return

							// Because these items may have been deleted before, explicitly reset persistence

							// Reset menu persistence (MOTD)
							string menuPersistenceName = Entitlement_GetMenuPersistenceVarName( entitlementFlav )
							if ( menuPersistenceName != GENERIC_ACKNOWLEDGEMENT_PVAR )
								player.SetPersistentVar( menuPersistenceName, 0 )

							// Reset other persistence ("new" red dot that appears in inventory)
							GRX_MarkAsNewIfAppropriate( player, flavor )
						})
						operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( flavor )
						QueueGRXOperation( player, operation, false )
					}
				}
				else // No Drops awarded
				{
					if ( hasItemInInventory )
					{
						itemsToRemove.append( flavor )
						string itemRemoved = ItemFlavor_GetHumanReadableRefForPIN_Slow( flavor )
						PIN_TwitchDropItemRemoved( player, itemRemoved )
						entitlementsToReset.append( entitlementFlav )
					}
				}
			}
		}

		if ( itemsToRemove.len() > 0 && GetConVarBool( "script_enable_twitch_drops_clawback" ) == true )
		{
			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_DELETE_ITEMS
			operation.doOperationFunc = ( void function( int opID ) : ( player, itemsToRemove, entitlementsToReset )
			{
				RemoveCosmeticItems( player, opID, itemsToRemove, entitlementsToReset )
			})

			operation.onDoneCallback = (void function( int status ) : ( player, itemsToRemove )
			{
				if ( status != eScriptGRXOperationStatus.DONE_SUCCESS )
					return

				if ( IsValid( player ) )
					ValidateGRXSpecificLoadoutSlotsForItemFlavors( player, itemsToRemove )
			})

			QueueGRXOperation( player, operation, false )
		}
	}
}
#endif

#if SERVER
void function TryGivePremiumPassForEAAccess( entity player )
{
	EndSignal( player, "OnDestroy" )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	ItemFlavor ornull activeBattlePass = GetActiveBattlePass()
	if ( activeBattlePass != null )
	{
		expect ItemFlavor( activeBattlePass )

		bool hasPremium = DoesPlayerOwnBattlePass( player, activeBattlePass )
		bool hasBasicPack = GRX_GetPackCount( player, ItemFlavor_GetGRXIndex( BattlePass_GetBasicPurchasePack( activeBattlePass ) ) ) > 0
		bool hasBundlePack = GRX_GetPackCount( player, ItemFlavor_GetGRXIndex( BattlePass_GetBundlePurchasePack( activeBattlePass ) ) ) > 0

		if ( IsEAAccessPremiumMember( player ) && !hasPremium && !hasBasicPack && !hasBundlePack )
		{
			ItemFlavor purchasePack = BattlePass_GetBasicPurchasePack( activeBattlePass )
			printt( "------- GIVE BATTLE PASS FOR EA ACCESS -----------" )

			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_BONUS_EA_PREMIER
			operation.doOperationFunc = (void function( int opID ) : ( player, purchasePack, activeBattlePass )
			{
				string eaAccessSequenceName         = format( "battlePasses[%s].grxEaAccessPremium", ItemFlavor_GetGUIDString( activeBattlePass ) )
				ItemFlavorBag what = MakeItemFlavorBag( { [purchasePack] = 1, } )
				GRX_GiveSequenceRewardEasy( player, opID, GRX_HTTPQUERYGOAL_GIVE_BONUS_EA_PREMIER, eaAccessSequenceName, 0, 1, what )
			})
			operation.onDoneCallback = (void function( int status ) : ( player, purchasePack ) {
				bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
				if ( !didOperationSucceed )
					return
				Remote_CallFunction_UI( player, "ServerCallback_GotBPFromPremier" )

			})
			QueueGRXOperation( player, operation, false )
		}
	}
}
#endif

#if SERVER
void function TryGiveFirstPartyEntitlements( entity player )
{
	if ( !IsLobby() )
		return

	foreach ( ItemFlavor entitlementFlav, array<ItemFlavor> itemList in (entitlementRewardMap[eEntitlementType.FIRSTPARTY]) )
	{
		int enumVal = Entitlement_GetEntitlementEnumVal( entitlementFlav )
		if ( enumVal == BLOODHOUND_LIFELINE_PACK )
			continue

		if ( !player.HasEntitlement( enumVal ) )
			continue

		foreach ( ItemFlavor flavor in itemList )
		{
			Assert( ItemFlavor_GetGRXMode( flavor ) == eItemFlavorGRXMode.REGULAR, "Invalid mode for function " + ItemFlavor_GetGRXMode( flavor ) )
			if ( GRX_HasItem( player, ItemFlavor_GetGRXIndex( flavor ) ) )
				continue

			ScriptGRXOperationInfo operation
			operation.expectedQueryGoal = GRX_HTTPQUERYGOAL_GIVE_ITEM
			operation.doOperationFunc = (void function( int opID ) : ( player, flavor )
			{
				GRX_GiveCosmetic( player, opID, ItemFlavor_GetGRXIndex( flavor ) )
			})
			operation.onDoneCallback = (void function( int status ) : ( player, enumVal, flavor ) {
				bool didOperationSucceed = (status == eScriptGRXOperationStatus.DONE_SUCCESS)
				if ( !didOperationSucceed )
					return

				GRX_MarkAsNewIfAppropriate( player, flavor )

				// do nothing for now with the entitlement ID
			})
			operation.DEV_goalInfo = ItemFlavor_GetGRXAlias( flavor )
			QueueGRXOperation( player, operation, false )
		}
	}
}
#endif

#if SERVER

void function RemoveCosmeticItems( entity player, int opID, array<ItemFlavor> itemsToRemove, array<ItemFlavor> entitlementsToReset )
{
	array<int> idxsToRemove = []
	foreach ( ItemFlavor flavor in itemsToRemove )
	{
		idxsToRemove.append( ItemFlavor_GetGRXIndex( flavor ) )
	}

	GRX_RemoveCosmetics( player, opID, idxsToRemove )

	// Reset the persistence state for each item we removed
	// This is done before we affirm the delete, to err on the side of not showing a popup for deleted items if the response arrives late.
	foreach ( ItemFlavor flavor in itemsToRemove )
	{
		// "new" red dot in menu titles
		SettingsAssetGUID GUID = ItemFlavor_GetGUID( flavor )
		Newness_MarkItemFlavorGUIDAsNotNewForPlayer( player, GUID )
	}

	// Reset menu persistence for the "parent" entitlement of each item we removed
	foreach (ItemFlavor entitlementFlav in entitlementsToReset)
	{
		// MOTD
		string menuPersistenceName = Entitlement_GetMenuPersistenceVarName( entitlementFlav )
		if ( menuPersistenceName != GENERIC_ACKNOWLEDGEMENT_PVAR )
			player.SetPersistentVar( menuPersistenceName, 0 )
	}
}

#endif


#if SERVER || CLIENT || UI
void function UnlockFuncRegister( ItemFlavor flavor )
{
	if ( !ItemFlavor_HasUnlockFunc( flavor ) )
		return

	string unlockFuncKey = ItemFlavor_GetUnlockFuncKey( flavor )
	if ( unlockFuncKey in eaAccessRewardRefs )
		eaAccessRewardRefs[unlockFuncKey].append( flavor )
	else if ( unlockFuncKey in psPlusRewardRefs )
		psPlusRewardRefs[unlockFuncKey].append( flavor )
	else if ( unlockFuncKey == "origin_access_on_pc" || unlockFuncKey == "ea_access_on_xbox" )
		upgradableAccessRewardRefs.append( flavor )
}
#endif


#if SERVER || CLIENT || UI
int function Entitlement_GetEntitlementType( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement )

	string typeString = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "entitlementType" )
	switch ( typeString )
	{
		case "firstparty":
			return eEntitlementType.FIRSTPARTY

		case "twitch_prime":
			return eEntitlementType.TWITCH_PRIME

		case "twitch_drops":
			return eEntitlementType.TWITCH_DROPS
	}

	Assert( false, "Unhandled entitlement type '" + typeString + "' for " + string(ItemFlavor_GetAsset( flavor )) )
	return -1
}
#endif


#if SERVER || CLIENT || UI
int function Entitlement_GetEntitlementEnumVal( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement )

	string enumString = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "enum" )

	Assert( enumString in getconsttable() )
	return expect int( getconsttable()[ enumString ] )
}
#endif


#if SERVER || CLIENT || UI
string function Entitlement_GetEntitlementEnumValAsString( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement )

	string enumString = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "enum" )
	Assert( enumString != "" )

	return enumString
}
#endif


#if SERVER || CLIENT || UI
string function Entitlement_GetMenuTitleText( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement )
	return GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "menuTitleText" )
}
#endif

#if SERVER || CLIENT || UI
// NOTE(rk): Can be used for both Drops and Prime entitlements
string function Entitlement_GetTwitchPrimeRef( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement, "Flavor " + ItemFlavor_GetHumanReadableRefForPIN_Slow( flavor ) + " isn't an entitlement.")

	string twitchRef = GetGlobalSettingsString( ItemFlavor_GetAsset( flavor ), "twitchRef" )
	Assert( twitchRef != "" )

	return twitchRef
}
#endif


#if SERVER || CLIENT || UI
string function Entitlement_GetMenuPersistenceVarName( ItemFlavor flavor )
{
	Assert( ItemFlavor_GetType( flavor ) == eItemType.entitlement )

	asset entitlementAsset = ItemFlavor_GetAsset( flavor )

	if ( GetGlobalSettingsBool( entitlementAsset, "isMenuEnabled" ) == false )
		return GENERIC_ACKNOWLEDGEMENT_PVAR

	string persistenceVarName = GetGlobalSettingsString( entitlementAsset, "menuPersistenceVarName" )
	if ( persistenceVarName == "" )
	{
		switch ( Entitlement_GetEntitlementType( flavor ) )
		{
			case eEntitlementType.FIRSTPARTY:
				persistenceVarName = Entitlement_GetEntitlementEnumValAsString( flavor )
				break

			case eEntitlementType.TWITCH_PRIME:
				persistenceVarName = Entitlement_GetTwitchPrimeRef( flavor )
				break

			case eEntitlementType.TWITCH_DROPS:
				persistenceVarName = Entitlement_GetTwitchPrimeRef( flavor )
				break

			default:
				Assert( false, "Unhandled entitlement type for " + string(ItemFlavor_GetAsset( flavor )) )
		}

		persistenceVarName += "Acknowledged"
	}

	return persistenceVarName
}
#endif


