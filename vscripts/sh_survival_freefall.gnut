		bool hasSkydiveEmotes = GetValidPlayerSkydiveEmotes( player ).len() > 0
		RuiSetBool( file.skydiveRui, "skydiveAvailable", isFreefallEmoteAvailable && hasSkydiveEmotes )
	}
