#if SERVER
void function Skydive_EnterGameStateResolution()
{
	foreach(player in GetPlayerArray_Alive() )
	{
		//if ( player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
			EndPlayerSkyDive( player )
	}
}
