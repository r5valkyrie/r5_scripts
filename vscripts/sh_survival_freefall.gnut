void function CodeCallback_PlayerSkydiveBegin( entity player )
{
#if SERVER
	// printf( "CodeCallback_PlayerSkydiveBegin (Server)" )

	foreach ( callbackFunc in file.Callbacks_OnPlayerFreefallBegin )
		callbackFunc( player )

	// Start up the smoke effects

	array<SkyDiveTrailFXStruct> smokeFX = GetSkyDiveTrailPackageForPlayerWithOverrides( player ).smokeColorFX

	foreach( fxStruct in smokeFX )
	{
		int smokeAttachID = player.LookupAttachment( fxStruct.attachName )

		// There is a rare bug where this attachment doesn't exist. Instead of crashing, just don't play the vfx if the attachment point is missing
		if ( smokeAttachID == ATTACHMENTID_INVALID )
			continue

		vector smokeColor
		if ( fxStruct.useSkyDiveSmokeColorForTeam  )
			smokeColor = GetSkydiveSmokeColorForTeam( player.GetTeam() )
		else
			smokeColor = fxStruct.controlPoint

		entity smokeTrailFX = StartParticleEffectOnEntityWithPos_ReturnEntity( player, GetParticleSystemIndex( fxStruct.fx ), fxStruct.attachType, smokeAttachID, <0,0,0>, VectorToAngles( <0,0,-1> ) )
		EffectSetControlPointVector( smokeTrailFX, 1, smokeColor )
		player.p.freefallSmokeFX.append( smokeTrailFX )
	}
	table< int, ItemFlavor > skydives = GetValidPlayerSkydiveEmotes( player )
	// Per @Justin Doan, we have this extra check for holosprays/quips due to an issue where players could holospray during an emote but not the other way around, so this rectifies the issue
	array<ItemFlavor> emotes = ItemFlavor_GetQuipArrayForCharacter( player, LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() ) )
	bool emoteAvailable = ( ( skydives.len() > 0 || emotes.len() > 0 ) && !player.p.skydiveEmotesDisabled ) //if skydive emotes disabled by playlist var "disable_skydive_emotes_postdrop" , don't make them available

	player.SetPlayerNetBool( "freefallEmoteAvailable", emoteAvailable )
#else
	// printf( "CodeCallback_PlayerSkydiveBegin (Client)" )

//--------Removing Wind and Contrail FX-They were only playing on ability skyward------------

	// if ( IsLocalViewPlayer( player ) )
	// {
	// 	int fxID = GetParticleSystemIndex( PLAYER_WIND_FX )
	// 	int attachID = player.LookupAttachment( "REF" )
	// 	player.p.freefallWindEffectHandle = StartParticleEffectOnEntityWithPos( player, fxID, FX_PATTACH_POINT_FOLLOW_NOROTATE, attachID, <0,0,0>, VectorToAngles( <0,0,-1> ) )

	// 	foreach( string attachment in file.contrailAttachments )
	// 	{
	// 		int handle = StartParticleEffectOnEntity( player, GetParticleSystemIndex( CONTRAIL_FX ), FX_PATTACH_POINT_FOLLOW_NOROTATE, player.LookupAttachment( attachment ) )
	// 		EffectSetControlPointVector( handle, 2, < 0, 0, 0 > )
	// 		player.p.freefallContrailFXHandles.append( handle )
	// 	}
	// }
#endif //if SERVER
}

void function CodeCallback_PlayerSkydiveEnd( entity player )
{
	player.Anim_Stop()

#if SERVER
	// printf( "CodeCallback_PlayerSkydiveEnd (Server)" )

	foreach( entity ent in player.p.freefallSmokeFX )
	{
		EffectStop( ent )
		ent.Destroy()
	}
	player.p.freefallSmokeFX.clear()

	StopAllSkydiveSounds( player )

	foreach ( callbackFunc in file.Callbacks_OnPlayerFreefallEnd )
		callbackFunc( player )

                        
                                                        
   
                                             
   
       
#else
	// printf( "CodeCallback_PlayerSkydiveEnd (Client)" )

	foreach( int handle in player.p.freefallContrailFXHandles )
	{
		if ( EffectDoesExist( handle ) )
		{
			EffectStop( handle, true, false )
		}
	}
	player.p.freefallContrailFXHandles.clear()

	if ( EffectDoesExist( player.p.freefallWindEffectHandle ) )
	{
		EffectStop( player.p.freefallWindEffectHandle, true, false )
	}
	player.p.freefallWindEffectHandle = -1
#endif
}

void function CodeCallback_PlayerSkydiveMove( entity player )
{
#if SERVER
	// printf( "CodeCallback_PlayerSkydiveMove (Server)" )

	//#####################################
	// 		     GROUND DUST FX
	//#####################################

	bool slowZone = false //player.Player_IsSkydiveAnticipating() // S3: entity method not available
	if ( slowZone && (Time() - player.p.freefallLastGroundFXTime) >= SKYDIVE_JETWASH_FREQUENCY )
	{
		player.RumbleEffect( 10, 0, 0.0 )
		vector start = player.GetOrigin() - < 0, 0, 60 >
		vector end = start - < 0, 0, SKYDIVE_JETWASH_DIST_FROM_GROUND >
		TraceResults downTraceResult = TraceLine( start, end, [player], TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
		if ( downTraceResult.fraction < 1.0 )
		{
			PlayImpactFXTable( downTraceResult.endPos, player, "human_land_jetwash" )
			player.p.freefallLastGroundFXTime = Time()
		}
	}
#else
	// printf( "CodeCallback_PlayerSkydiveMove (Client)" )

	float elapsedTime = Time() - 0.0 /*player.Player_GetSkydiveStartTime() S3: not available*/
	if ( elapsedTime >= 2.0 )
	{
		float speed = player.GetVelocity().Length()
		float alpha = GraphCapped( speed, SKYDIVE_CONTRAIL_SPEED_MIN, SKYDIVE_CONTRAIL_SPEED_MAX, 0.0, 1.0 )
		foreach ( int handle in player.p.freefallContrailFXHandles )
		{
			if ( EffectDoesExist( handle ) )
			{
				EffectSetControlPointVector( handle, 2, < alpha, 0, 0 > )
			}
		}
	}
#endif
}

void function CodeCallback_PlayerSkydiveAnticipateBegin( entity player )
{
#if SERVER
	// printf( "CodeCallback_PlayerSkydiveAnticipateBegin (Server)" )

	foreach ( callbackFunc in file.Callbacks_OnPlayerSkydiveAnticipateBegin )
		callbackFunc( player )

	player.Anim_DisableUpdatePosition()

	player.SetPlayerNetBool( "freefallEmoteAvailable", false )

	SkyDiveTrailPackage package = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
	StopSoundOnEntity( player, package.DropSequenceTravel1P )
	StopSoundOnEntity( player, package.DropSequenceTravel3P )
	StopSoundOnEntity( player, package.InGameFlightTravel1P )
	StopSoundOnEntity( player, package.InGameFlightTravel3P )

	if ( GetNV_FreefallIsFromPlane( player ) )
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceLandStart1P )
		EmitSoundOnEntityExceptToPlayer( player, player, package.DropSequenceLandStart3P )
	}
	else
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, package.InGameFlightLandStart1P )
		EmitSoundOnEntityExceptToPlayer( player, player, package.InGameFlightLandStart3P )
	}

	int playerTeam = player.GetTeam()

	if ( player.p.freefallLandingFX.len() == 0 )
	{
		array<SkyDiveTrailFXStruct> landingFX = GetSkyDiveTrailPackageForPlayerWithOverrides( player ).jumpJetLandFX

		if ( false ) //( player.Skydive_IsFromUpdraft() ) // S3: entity method not available
		{
			int updraftFXID = GetParticleSystemIndex( UPDRAFT_FX )
			entity updraftFXLeft = StartParticleEffectOnEntity_ReturnEntity( player, updraftFXID, FX_PATTACH_POINT_FOLLOW, player.LookupAttachment( "vent_left" ) )
			entity updraftFXRight = StartParticleEffectOnEntity_ReturnEntity( player, updraftFXID, FX_PATTACH_POINT_FOLLOW, player.LookupAttachment( "vent_right" ) )
			SetTeam( updraftFXLeft, playerTeam )
			SetTeam( updraftFXRight, playerTeam )

			Assert( landingFX.len() >= 1 )

			SkyDiveTrailFXStruct fxStruct = landingFX[0]

			vector landingFXColor
			if ( fxStruct.useSkyDiveSmokeColorForTeam  )
				landingFXColor = GetSkydiveSmokeColorForTeam( playerTeam )
			else
				landingFXColor = fxStruct.controlPoint

			EffectSetControlPointVector( updraftFXLeft, 1, landingFXColor )
			EffectSetControlPointVector( updraftFXRight, 1, landingFXColor )
			player.p.freefallLandingFX.append( updraftFXLeft )
			player.p.freefallLandingFX.append( updraftFXRight )
		}
		else
		{
			foreach( fxStruct in landingFX )
			{
				int landingFXID = GetParticleSystemIndex( fxStruct.fx )
				int attachID= player.LookupAttachment( fxStruct.attachName )
				if( attachID == ATTACHMENTID_INVALID )
					continue

				entity handle = StartParticleEffectOnEntity_ReturnEntity( player, landingFXID, fxStruct.attachType, attachID )
				SetTeam( handle, playerTeam )
				vector landingFXColor
				if ( fxStruct.useSkyDiveSmokeColorForTeam  )
				{
					landingFXColor = GetSkydiveSmokeColorForTeam( playerTeam )
				}
				else
				{
					landingFXColor = fxStruct.controlPoint
				}
				EffectSetControlPointVector( handle, 1, landingFXColor )
				player.p.freefallLandingFX.append( handle )

			}
		}

	}

	// Kill the smoke effects
	foreach( entity ent in player.p.freefallSmokeFX )
	{
		EffectStop( ent )
		ent.Destroy()
	}
	player.p.freefallSmokeFX.clear()
#else
	// printf( "CodeCallback_PlayerSkydiveAnticipateBegin (Client)" )
#endif
}

void function CodeCallback_PlayerSkydiveAnticipateEnd( entity player )
{
#if SERVER
	// printf( "CodeCallback_PlayerSkydiveAnticipateEnd (Server)" )
	SkyDiveTrailPackage package = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
	StopSoundOnEntity( player, package.DropSequenceLandStart1P )
	StopSoundOnEntity( player, package.DropSequenceLandStart3P )
	StopSoundOnEntity( player, package.InGameFlightLandStart1P )
	StopSoundOnEntity( player, package.InGameFlightLandStart3P )

	foreach( entity ent in player.p.freefallLandingFX )
	{
		EffectStop( ent )
		ent.Destroy()
	}
	player.p.freefallLandingFX.clear()

	player.RumbleEffect( 0, 0, 0.0 )

	table< int, ItemFlavor > emotes = GetValidPlayerSkydiveEmotes( player )

	//if ( emotes.len() > 0 && !player.Player_IsSkydiveAnticipating() && !player.p.skydiveEmotesDisabled)
		player.SetPlayerNetBool( "freefallEmoteAvailable", true )

	if ( !player.IsMarkedForDeletion() )
	{
		if ( GetNV_FreefallIsFromPlane( player ) )
		{
			EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceTravel1P  )
			EmitSoundOnEntityExceptToPlayer( player, player, package.DropSequenceTravel3P )
		}
		else
		{
			EmitSoundOnEntityOnlyToPlayer( player, player, package.InGameFlightTravel1P )
			EmitSoundOnEntityExceptToPlayer( player, player, package.InGameFlightTravel3P)
		}

		array<SkyDiveTrailFXStruct> smokeFX = GetSkyDiveTrailPackageForPlayerWithOverrides( player ).smokeColorFX

		foreach( fxStruct in smokeFX )
		{
			int smokeAttachID = player.LookupAttachment( fxStruct.attachName )

			if( smokeAttachID == ATTACHMENTID_INVALID )
				continue

			vector smokeColor
			if ( fxStruct.useSkyDiveSmokeColorForTeam  )
				smokeColor = GetSkydiveSmokeColorForTeam( player.GetTeam() )
			else
				smokeColor = fxStruct.controlPoint

			entity smokeTrailFX = StartParticleEffectOnEntityWithPos_ReturnEntity( player, GetParticleSystemIndex( fxStruct.fx ), fxStruct.attachType, smokeAttachID, <0,0,0>, VectorToAngles( <0,0,-1> ) )
			EffectSetControlPointVector( smokeTrailFX, 1, smokeColor )
			player.p.freefallSmokeFX.append( smokeTrailFX )
		}
	}
#else
	// printf( "CodeCallback_PlayerSkydiveAnticipateEnd (Client)" )
#endif
}



#if CLIENT
bool function EmoteMenuOnHold()
{
	return ( GetCurrentPlaylistVarBool( "skydive_emote_hold_for_wheel", true ) )
}

void function Freefall_OnPlayerCreated( entity skyDivingPlayer )
{
	thread Freefall_OnPlayerCreated_threaded( skyDivingPlayer  )
}

//Note: Added this to destroy any freefall rui's that had been drawn from spectators before respawning
void function Client_OnPlayerSpawned( entity localPlayer )
{
                      
                                       
         
                            
	if( file.skydiveRui != null )
	{
		RuiDestroyIfAlive( file.skydiveRui )
		file.skydiveRui = null
	}
}

void function Freefall_OnPlayerCreated_threaded( entity skyDivingPlayer )
{
	WaitFrame() //HACKY, needed because otherwise FX don't get properly created
	if ( !IsValid( skyDivingPlayer  )  )
		return
	UpdatePlayerSkydiveTrailFriendlyEnemyFX( skyDivingPlayer  )
}

#endif //if client



