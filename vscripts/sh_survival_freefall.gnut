void function SurvivalFreefall_Init()
{
	#if DEVELOPER
		if ( IsCaptureCameraEnabled() ) // Capture camera settings
		{
			SKYDIVE_THIRD_PERSON_START_HEIGHT = -50.0

			#if CLIENT
				SKYDIVE_THIRD_PERSON_NORMAL_DIST = 200.0
				SKYDIVE_THIRD_PERSON_SLOW_DIST = 170.0
				SKYDIVE_THIRD_PERSON_FAST_DIST = 400.0
			#endif // CLIENT
		}
	#endif // DEVELOPER

	Remote_RegisterServerFunction( "ClientCallback_StopFreefallFollowMode" )
	Remote_RegisterServerFunction( "ClientCallback_SkydiveEmote", "int", INT_MIN, INT_MAX )
	Remote_RegisterServerFunction( "ClientCallback_SkydiveEmoteNext" )

	#if SERVER
		PrecacheParticleSystem( PLAYER_WIND_FX )
		//PrecacheParticleSystem( SKYDIVE_SMOKE_FX )
		PrecacheParticleSystem( SKYDIVE_SMOKE_COLOR_FX )
		PrecacheParticleSystem( JUMPJET_FRIENDLY_SKYDIVE )
		PrecacheParticleSystem( JUMPJET_ENEMY_SKYDIVE )
		PrecacheParticleSystem( JUMPJET_VALK_SKYDIVE_FRIENDLY )
		PrecacheParticleSystem( JUMPJET_VALK_SKYDIVE_ENEMY )
		PrecacheParticleSystem( JUMPJET_LAND_FX )
		PrecacheParticleSystem( UPDRAFT_FX )
		PrecacheImpactEffectTable( "human_land_jetwash" )

		if ( file.shouldFillSkyWithClouds )
			PrecacheModel( CLOUD_MODEL )

		RegisterSignal( "PlayerSkyDive" )
		RegisterSignal( "EndPlayerSkyDive" )
		RegisterSignal( "SkydiveEmote_Cancel" )
		RegisterSignal( "PlayerBootsOnGround" )
		RegisterSignal( "PlayerSkydiveFromCurrentPosition" )
		RegisterSignal( "PlayerFallAssistanceDetection" )
                      
                                
                                   
      

		AddSpawnCallback_ScriptName( "skydive_boundary", AddSkydiveBoundaryVolume )
		                             
			AddSpawnCallback_ScriptName( REDEPLOY_BALLOON_SKYDIVE_TRIGGER_SCRIPT_NAME, ForcedSkydiveTriggerThink )
        
		AddSpawnCallback_ScriptName( "zipline_skydive", ForcedSkydiveTriggerThink )
		AddSpawnCallbackEditorClass( "trigger_multiple", "trigger_skydive", ForcedSkydiveTriggerThink )
		AddSpawnCallback_ScriptName( "skydive_tower", SkydiveTowerEntitySpawned )
		AddSpawnCallback_ScriptName( "jump_tower", SkydiveTowerEntitySpawned )
		AddSpawnCallback_ScriptName( "jump_tower_flag", SkydiveTowerEntitySpawned )


			file.nearbySquadsQuickchatEnabled = GetCurrentPlaylistVarBool( "freefall_nearby_squads_quickchat_enabled", true )
			                      
				if ( !GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_WINTEREXPRESS ) )
         
				{
					if ( file.nearbySquadsQuickchatEnabled )
						Survival_AddCallback_PlayerFreefallEnd( Skydive_CheckAndAnnounceNearbySquads )
				}


		AddCallback_OnClientDisconnected( OnPlayerDisconnected )

		AddCallback_PlayerClassChanged( Skydive_CustomTrailsInit  )
		#if SERVER
			AddCallback_GameStateEnter( eGameState.Resolution, Skydive_EnterGameStateResolution)
		#endif

	#endif
	RegisterSignal( "ReleaseDropEmote" )
	RegisterSignal( "FreefallEnded" )
	#if CLIENT
		RegisterSignal( "FreefallStarted" )
		RegisterSignal( "LerpCameraDistOverTime" )
		RegisterSignal( "LerpCameraHeightOverTime" )
		RegisterSignal( "WaitForUnfollow" )

		PrecacheParticleSystem( CONTRAIL_FX )
		AddCreateCallback( "player", Freefall_OnPlayerCreated  )
		AddCallback_LocalClientPlayerSpawned( Client_OnPlayerSpawned )


		file.nearbySquadsMinimapEnabled = GetCurrentPlaylistVarBool( "freefall_nearby_squads_minimap_enabled", true )

	#endif

	//skydiveSmokeColors.randomize()
}

