#if SERVER
// The GetNV_FreefallIsFromPlane check is used to determine if a player that is skydiving should be treated as if they had respawned ( show enemies pings on minimap, show skydive trails, play squad landed near vo etc )
// However, we have respawn styles that respawn a player in a skydive without a plane ent but still want all the above functionality without the need for a plane entity
bool function Skydive_IsPlaneExpectedForSkydiveRespawn()
{
	#if DEVELOPER
		// Dev has debug that allows this behaviour
		return false
	#endif

                      
                                       
               
                            

	                         
		if ( ForcedSpawn_UseForcedSpawning() )
			return false
                                

	if ( GetRespawnStyle() == eRespawnStyle.SPAWN_GROUP_SKYDIVE )
		return false

	return true
}
#endif