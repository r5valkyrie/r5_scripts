SkyDiveTrailPackage function GetSkyDiveTrailPackageForPlayerWithOverrides( entity player ) //Exists on server, and client
{
	if ( IsPrivateMatch() )
		return SkydiveTrail_GetSkyDiveTrailPackageFromItemFlavor( GetItemFlavorByAsset( SKYDIVE_TRAIL_DEFAULT ) )

	int index = player.GetPlayerNetInt( "skyDiveTrailOverrideIndex" )
	//printt( "player " + player + ", index : " + index )
	if ( index == -1  )
	{
		SkyDiveTrailPackage package =  SkydiveTrail_GetSkyDiveTrailPackageForPlayer( player )
		//printt( "Package smokeColor 0th element? " + package.smokeColorFX[0].fx )
		return SkydiveTrail_GetSkyDiveTrailPackageForPlayer( player )
	}


	return SkydiveTrail_GetPackageForIndex( index )
}

#if SERVER

void function Survival_AddCallback_PlayerFreefallBegin( void functionref(entity) callbackFunc )
{
	Assert( !file.Callbacks_OnPlayerFreefallBegin.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with Survival_AddCallback_PlayerFreefallBegin" )
	file.Callbacks_OnPlayerFreefallBegin.append( callbackFunc )
}

void function Survival_AddCallback_PlayerFreefallEnd( void functionref(entity) callbackFunc )
{
	Assert( !file.Callbacks_OnPlayerFreefallEnd.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with Survival_AddCallback_OnPlayerFreefallEnd" )
	file.Callbacks_OnPlayerFreefallEnd.append( callbackFunc )
}

void function Survival_RemoveCallback_PlayerFreefallEnd( void functionref(entity) callbackFunc )
{
	Assert( file.Callbacks_OnPlayerFreefallEnd.contains( callbackFunc ), "Callback " + string( callbackFunc ) + " does not exist." )
	file.Callbacks_OnPlayerFreefallEnd.fastremovebyvalue( callbackFunc )
}

void function SetOnPlayerSkydiveCustomTrailsCallback( void functionref(entity ) callbackFunc )
{
	file.OnPlayerSkydiveCustomTrailsInitFunc = callbackFunc
}

void function Survival_AddCallback_PlayerSkydiveAnticipateBegin( void functionref(entity) callbackFunc )
{
	Assert( !file.Callbacks_OnPlayerSkydiveAnticipateBegin.contains( callbackFunc ), "Already added " + string( callbackFunc ) + " with Callbacks_OnPlayerSkydiveAnticipateBegin" )
	file.Callbacks_OnPlayerSkydiveAnticipateBegin.append( callbackFunc )
}


void function Skydive_CheckAndAnnounceNearbySquads( entity skydiver )
{
	if ( !IsValid( skydiver ) )
		return

	if ( !skydiver.p.enableSkydiveDetection )
		return

	table<int, entity> closestEnemyPlayersOfTeam = {}
	array<entity> players = GetPlayerArrayEx( "any", TEAM_ANY, TEAM_ANY, skydiver.GetOrigin(), SKYDIVE_ENEMY_DETECT_RANGE )
	int ownerTeam = skydiver.GetTeam()
	vector skydiverOrigin = skydiver.GetOrigin()

	foreach ( player in players )
	{
		if ( !player.DoesShareRealms( skydiver ) || player == skydiver || player.IsObserver() )
			continue

		int playerTeam = player.GetTeam()

		if ( IsFriendlyTeam( ownerTeam, playerTeam ) )
			continue

		if ( playerTeam == 0 || playerTeam == 1 )
			continue

		if ( !( playerTeam in closestEnemyPlayersOfTeam ) )
		{
			closestEnemyPlayersOfTeam[ playerTeam ] <- player
		}
		else
		{
			// replace the representative of a given team if the other team member is closer to the skydiver
			float curDist = Distance2D( skydiverOrigin, closestEnemyPlayersOfTeam[ playerTeam ].GetOrigin() )
			float newDist = Distance2D( skydiverOrigin, player.GetOrigin() )

			if ( newDist < curDist )
			{
				closestEnemyPlayersOfTeam[ playerTeam ] <- player
			}
		}
	}

	// if a team falls in Apex and no one is around to hear it, it doesn't make a sound
	if ( closestEnemyPlayersOfTeam.len() <= 0 )
		return

	                            
		// Run logic in Rev Army that checks for Rev enemies
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_SHADOW_ARMY ) )
		{
			// if a player fell from the plane, announce there's another team nearby
			int teamAlliance = AllianceProximity_GetAllianceFromTeam( ownerTeam )
			if ( GetNV_FreefallIsFromPlane( skydiver ) )
			{
				if ( teamAlliance == SHADOWARMY_LEGEND_ALLIANCE )
					BroadcastCommsActionToTeam( skydiver, eCommsAction.QUICKCHAT_SKYDIVE_REV_NEARBY, GetTeamEnt( ownerTeam ), skydiver.GetOrigin(), eCommsFlags.NONE, "" )
				else
					BroadcastCommsActionToTeam( skydiver, eCommsAction.QUICKCHAT_SKYDIVE_SKINBAG_NEARBY, GetTeamEnt( ownerTeam ), skydiver.GetOrigin(), eCommsFlags.NONE, "" )
			}

			// regardless of whether a team has fallen from a plane, announce that a team has landed teams in the area
			foreach ( team, player in closestEnemyPlayersOfTeam )
			{
				teamAlliance = AllianceProximity_GetAllianceFromTeam( team )

				if ( teamAlliance == SHADOWARMY_LEGEND_ALLIANCE )
					BroadcastCommsActionToTeam( player, eCommsAction.QUICKCHAT_SKYDIVE_REV_NEARBY, GetTeamEnt( team ), player.GetOrigin(), eCommsFlags.NONE, "" )
				else
					BroadcastCommsActionToTeam( player, eCommsAction.QUICKCHAT_SKYDIVE_SKINBAG_NEARBY, GetTeamEnt( team ), player.GetOrigin(), eCommsFlags.NONE, "" )
			}

			return
		}
                                   

	// if a player fell from the plane, announce there's another team nearby
	if ( GetNV_FreefallIsFromPlane( skydiver ) )
		BroadcastCommsActionToTeam( skydiver, eCommsAction.QUICKCHAT_SKYDIVE_ENEMIES_NEARBY, GetTeamEnt( ownerTeam ), skydiver.GetOrigin(), eCommsFlags.NONE, "" )

	// regardless of whether a team has fallen from a plane, announce that a team has landed teams in the area
	foreach ( team, player in closestEnemyPlayersOfTeam )
		BroadcastCommsActionToTeam( player, eCommsAction.QUICKCHAT_SKYDIVE_ENEMIES_NEARBY, GetTeamEnt( team ), player.GetOrigin(), eCommsFlags.NONE, "" )
}


void function AddSkydiveBoundaryVolume( entity ent )
{
	file.skydiveBoundaryVolumes.append( ent )
}

bool function IsPointInsideSkydiveBoundary( vector point )
{
	if ( GetCurrentPlaylistVarBool( "ignore_skydive_boundries", false ) == true )
		return false

	foreach( entity volume in file.skydiveBoundaryVolumes )
	{
		if ( volume.ContainsPoint( point ) )
			return true
	}
	return false
}

void function Skydive_CustomTrailsInit( entity player  )
{
	if ( !LoadoutSlot_IsReady( ToEHI( player ), Loadout_Character() ) )
		return

	if ( file.OnPlayerSkydiveCustomTrailsInitFunc != null  )
	{
		file.OnPlayerSkydiveCustomTrailsInitFunc( player  )
	}

}

void function SetOverrideSkydiveTrailPackageForPlayer( SkyDiveTrailPackage package, entity player )
{
	EHI playerEHI = ToEHI( player  )
	int packageIndex = SkydiveTrail_GetIndexForPackage( package )
	player.SetPlayerNetInt( "skyDiveTrailOverrideIndex", packageIndex )
}

void function ForcedSkydiveTriggerThink( entity trigger )
{
	if ( GetCurrentPlaylistVarBool( "skydive_ziplines_enabled", true ) == false )
	{
		trigger.Destroy()
		return
	}

                              
	if ( GetEditorClass( trigger ) == "" && trigger.GetScriptName() != REDEPLOY_BALLOON_SKYDIVE_TRIGGER_SCRIPT_NAME)
      
                                       
       
		Warning( "!!! Warning !!! Skydive trigger using deprecated script_name at: " + trigger.GetOrigin() )

	if ( trigger.GetScriptName() == "zipline_skydive" && GetEditorClass( trigger ) == "trigger_skydive" )
	{
		Warning( "!!! Warning !!! Skydive trigger has both script_name and is a skydive_trigger. Discarding! Located at: " + trigger.GetOrigin() )
		return
	}

	EndSignal( trigger, "OnDestroy" )

	trigger.SetEnterCallback( ForcedSkydiveTriggerThink_EnterCallback )
}

void function ForcedSkydiveTriggerThink_EnterCallback( entity trigger, entity player )
{
	if ( !IsValid( player ) )
		return

	if ( !player.IsPlayer() )
		return

	if ( PlayerMatchState_GetFor( player ) == ePlayerMatchState.SKYDIVE_FALLING )
		return

	if ( player.IsNoclipping() )
		return

	if ( Bleedout_IsBleedingOut( player ) )
		return

	//if ( player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
		return

	if ( HoverVehicle_IsPlayerInAnyVehicle( player ) )
		return

	//if ( player.Player_IsSkywardLaunching() || player.Player_IsSkywardFollowing() )
		return

	// Fix for R5DEV-482606: Player shouldn't die or be able to go to illicit locations via skydive tower in training.
	if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_TRAINING ) )
		return

	vector initialVelocity = < 0, 0, 0 >
	if ( trigger.HasKey( "initial_vert_velocity" ) )
		initialVelocity += < 0, 0, float( trigger.kv.initial_vert_velocity ) >
	if ( trigger.HasKey( "initial_fwd_velocity" ) )
		initialVelocity += player.GetForwardVector() * float( trigger.kv.initial_fwd_velocity )

	                             
	if ( trigger.GetScriptName() == REDEPLOY_BALLOON_SKYDIVE_TRIGGER_SCRIPT_NAME)
	{
		initialVelocity += player.GetForwardVector() * RedeployBalloon_GetSkydiveVelOverride()
		//TODO: Add unique pin for redeploy balloon
		PIN_Interact ( player, "MapToy_jump_tower_skydive_start" )
	}
	else
       
	PIN_Interact ( player, "MapToy_jump_tower_skydive_start" )

	thread ForcedSkydiveTriggerThink_EnterCallback_Spinoff( player, initialVelocity )
}

void function ForcedSkydiveTriggerThink_EnterCallback_Spinoff ( entity player, vector initialVelocity )
{
	                        
		Control_PrintSkydiveDebug( player, " ForcedSkydiveTriggerThink_EnterCallback_Spinoff going to wait for PlayerSkydiveFromCurrentPositionWithInitVelocity" )
                               
	waitthread PlayerSkydiveFromCurrentPositionWithInitVelocity( player, initialVelocity )

	                        
		Control_PrintSkydiveDebug( player, " ForcedSkydiveTriggerThink_EnterCallback_Spinoff finished waiting for PlayerSkydiveFromCurrentPositionWithInitVelocity to complete" )
                               

	if ( IsValid( player ) )
		PIN_PlayerLandedOnGround ( player, "redeploy_land" )
}

void function SkydiveTowerEntitySpawned( entity ent )
{
	if ( GetCurrentPlaylistVarBool( "skydive_ziplines_enabled", true ) == false )
		thread DeleteEntityAfterAllEntitiesLoaded( ent )
}

void function DeleteEntityAfterAllEntitiesLoaded( entity ent )
{
	FlagWait( "EntitiesDidLoad" )
	WaitFrame()
	ent.Destroy()
}

void function PlayerSkydiveThirdPersonEnable( entity player )
{
	player.SetTrackEntity( player )
	player.SetTrackEntityPitchLookMode( "orbit" )
	player.SetTrackEntityYawLookMode( "orbit" )
	player.SetTrackEntityDistanceMode( "scriptOffsetClientOnly" )
	player.SetTrackEntityMinYaw( -180 )
	player.SetTrackEntityMaxYaw( 180 )
	player.SetTrackEntityMinPitch( -89 )
	player.SetTrackEntityMaxPitch( 89 )
	player.SetTrackEntityOffsetDistance( SKYDIVE_THIRD_PERSON_START_DIST )
	player.SetTrackEntityOffsetHeight( SKYDIVE_THIRD_PERSON_START_HEIGHT )
	//if ( player.Skydive_IsFromUpdraft() ) // S3: entity method not available
	//{
	//	player.SetTrackEntityBlendInTimes( 1.25, 0.75, 0.3 )
	//}
}

void function OnPlayerDisconnected( entity player )
{
	if ( !IsValid( player ) )
		return

	//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
		return

	// This player may be jumpmaster so make sure to free any players following
	ClearChildren( player, true )
}

void function SkydiveTest()
{
	foreach( entity player in GetPlayerArray() )
	{
		player.ClearParent()
		player.SetOrigin( <0,0,35000> )
		                        
			Control_PrintSkydiveDebug( player, " SkydiveTest going to trigger PlayerSkydiveFromCurrentPosition" )
                                
		thread PlayerSkydiveFromCurrentPosition( player )
	}
}

void function PlayerSkydiveFromCurrentPosition( entity player, bool useSpawnJumpSounds = false )
{
	                        
		Control_PrintSkydiveDebug( player, " PlayerSkydiveFromCurrentPosition going to trigger PlayerSkydiveFromCurrentPositionWithInitVelocity" )
                               
	thread PlayerSkydiveFromCurrentPositionWithInitVelocity( player, < 0, 0, 0 >, false, useSpawnJumpSounds )
}

void function PlayerSkydiveFromCurrentPositionWithInitVelocity( entity player, vector velocity, bool enableSkydiveDetection = true, bool useSpawnJumpSounds = false  )
{
	Signal( player, "PlayerSkydiveFromCurrentPosition" )
	EndSignal( player, "PlayerSkydiveFromCurrentPosition" )

	player.Signal( "PhaseTunnel_EndPlacement" )

	player.p.skydiveDecoysFired = 0 //Resetting Mirage's decoy counter so he can use his hidden passive with skydive towers.
	player.Zipline_Stop()
	SetPlayerIntroDropSettings( player )
	                        
		Control_PrintSkydiveDebug( player, " PlayerSkydiveFromCurrentPositionWithInitVelocity going to wait for PlayerSkyDive" )
                               

	waitthread PlayerSkyDive( player, player.GetViewVector(), [player], player, false, true, velocity, enableSkydiveDetection, useSpawnJumpSounds )

	                        
		Control_PrintSkydiveDebug( player, " PlayerSkydiveFromCurrentPositionWithInitVelocity finished waiting for PlayerSkyDive" )
                               
}

void function PlayerSkydiveLandingFromCurrentPosition( entity player )
{
	Signal( player, "PlayerSkydiveFromCurrentPosition" )
	EndSignal( player, "PlayerSkydiveFromCurrentPosition" )

	player.Signal( "PhaseTunnel_EndPlacement" )

	player.p.skydiveDecoysFired = 0 //Resetting Mirage's decoy counter so he can use his hidden passive with skydive towers.
	player.Zipline_Stop()
	SetPlayerIntroDropSettings( player )
	waitthread PlayerSkyDive( player, player.GetViewVector(), [player], player, false, false )
}

void function PlayerSkyDive( 	entity player, vector driverViewVector, array<entity> squadPlayers, entity leaderPlayer,
		 					 	bool jumpingFromPlane = true, bool freefallEnabled = true, vector initialVelocity = < 0, 0, 0 >,
								bool enableSkydiveDetection = true,  bool useSpawnJumpSounds = false,
								bool constrainedDive = false, vector constrainedDiveDestination = < 0, 0, 0 >, float constrainedDive2DRadius = CONSTRAINEDDIVE_RADIUS_DEFAULT )
{
	                        
		Control_PrintSkydiveDebug( player, " PlayerSkyDive starting" )
                               
	// Lets us restart this thread and kill previous thread for dev testing
	Signal( player, "PlayerSkyDive" )
	EndSignal( player, "PlayerSkyDive" )
	EndSignal( player, "EndPlayerSkyDive" )
	EndSignal( player, "OnDeath" )

	if ( IsValid( svGlobal.levelEnt ) ) // prevents crash with restarting the map during droship phase
	{
		EndSignal( svGlobal.levelEnt, "DevPlaneTest" )
	}
	EndSignal( player, "DeathTotem_PreRecallPlayer" )

	SetPlayerIntroDropSettings( player )

	array<entity> jumpJetFX
	//if( !player.Skydive_IsFromSkywardLaunch() ) // S3: entity methods not available
	//	player.Player_BeginSkydive( initialVelocity )

	SetNV_FreefallIsFromPlane( player, jumpingFromPlane )
	player.p.freefallEnabled = freefallEnabled
	player.p.enableSkydiveDetection = enableSkydiveDetection

	                      
		MatchBehaviorPlayer_RecordDropInfo( player )
       

	OnThreadEnd(
		function() : ( player, leaderPlayer, jumpJetFX, jumpingFromPlane )
		{
			if ( IsValid( player ) )
			{
				                        
					Control_PrintSkydiveDebug( player, " PlayerSkyDive OnThreadEnd" )
                                  
				player.Anim_Stop()

				if ( IsValid( player.GetParent() ) && IsValid( leaderPlayer ) )
				{
					player.ClearParent()
					PutEntityInSomewhatSafeSpot( player, null, null, leaderPlayer.GetOrigin(), player.GetOrigin() )
				}
				else
				{
					player.ClearParent()
					if ( !player.IsZiplining() )
						PutEntityInSomewhatSafeSpot( player, null, null, player.GetOrigin(), player.GetOrigin() )
				}

				thread DisableSkydiveThirdPerson( player, jumpingFromPlane )

				// This track started when we entered the plane, stopping it again (second time) will trigger a fadeout
				// Disabled, see below:
				//string music = GetMusicForJump( player )
				//if ( music.len() > 0 )
				//	StopMusicOnPlayer( player, music )

				// Defensive fix for R5DEV-64285 & R5DEV-72479; late connecting clients can have music started on them,
				// but the function that would have stopped it is "in the past" and will never do so.  Defensively stop
				// all music playing on the player at this point.
				if ( GetCurrentPlaylistVarBool( "should_stop_music_on_skydive", true ) )
					StopAllMusicOnPlayer( player )

				StopAllSkydiveSounds( player )

				SkyDiveTrailPackage package = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
				if ( GetNV_FreefallIsFromPlane( player ) )
				{
					EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceLandStop1P )
					EmitSoundOnEntityExceptToPlayer( player, player, package.DropSequenceLandStop3P )
				}
				else
				{
					EmitSoundOnEntityOnlyToPlayer( player, player, package.InGameFlightLandStop1P )
					EmitSoundOnEntityExceptToPlayer( player, player, package.InGameFlightLandStop3P )
				}

				player.Skydive_SetFreelookMode( false )
				player.p.skydiveFreelookEnabled = 0
				//if ( player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
				//{
				//	player.Player_EndSkydive() // S3: entity method not available
				//}

				HeatMapStat( player, "Sur_Skydive_Landing", player.GetOrigin() )
				Signal( player, "PlayerBootsOnGround" )

				ClearPlayerIntroDropSettings( player )

				foreach( input in file.freecamInputs )
				{
					RemoveButtonPressedPlayerInputCallback( player, input, Freelook_Enable )
					RemoveButtonReleasedPlayerInputCallback( player, input, Freelook_Disable )
				}
			}
		}
	)

	foreach( input in file.freecamInputs )
	{
		AddButtonPressedPlayerInputCallback( player, input, Freelook_Enable )
		AddButtonReleasedPlayerInputCallback( player, input, Freelook_Disable )
	}

	if ( PlayerHasPassive( player, ePassives.PAS_MIRAGE ) )
	{
		thread AllowDecoyDrop( player )
	}

	// Trigger a new stage of the song for the descent
	string music = GetMusicForJump( player )
	if ( music.len() > 0 )
		SignalSoundOnEntity( player, music )

	player.ClearInvulnerable()
	//if( !player.Skydive_IsFromSkywardLaunch() ) // S3: entity method not available
			player.ClearParent()

	if ( player.GetPlayerNetBool( "playerInPlane" ) )
		ClearPlayerPlaneViewMode( player )
	Remote_CallFunction_NonReplay( player, "ServerCallback_ClearHints" )

	AddCinematicFlag( player, CE_FLAG_HIDE_MAIN_HUD )
	if ( jumpingFromPlane )
		PlayerMatchState_Set( player, ePlayerMatchState.SKYDIVE_FALLING )
	//Survival_SetInventoryEnabled( player, false )

	if ( GetNV_FreefallIsFromPlane( player ) )
		PIN_PlayerJumpedFromPlane( player, squadPlayers.len() - 1 )

	vector planeVelocity = leaderPlayer.GetVelocity()
	vector launchOffset = GetSkydiveFormationOffset( player, squadPlayers, leaderPlayer )

	// Other squad mates get their view snapped to match the driver so it's easier to fly together. This should probably be a lerp but we don't have that ability
	if ( player != leaderPlayer	/*&& !player.Skydive_IsFromSkywardLaunch()*/ ) // S3: entity method not available
	{
		float dot = DotProduct( driverViewVector, AnglesToForward( player.CameraAngles() ) )
		if ( DotToAngle( dot ) > 35.0 )
			thread SnapEyeAnglesWithFade( player, VectorToAngles( driverViewVector ) )
	}

	vector playerOrigin = player.GetOrigin()
	if ( GetNV_FreefallIsFromPlane( player ) )
	{
		float startingYaw = FlattenAngles( VectorToAngles( driverViewVector ) ).y
		player.SnapFeetAngles( <0, startingYaw, 0> )
	}

	SkydivePlayerData skydiveData
	skydiveData.player = player

	if ( !( player in file.skydivePlayerDataLookup ) )
		file.skydivePlayerDataLookup[ player ] <- skydiveData
	file.skydivePlayerDataLookup[ player ] = skydiveData

	//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ && !player.Skydive_IsFromSkywardLaunch() )
	//{
	//	player.Player_BeginSkydive( <0, 0, 0> ) // S3: entity method not available
	//}

	//if( !player.Skydive_IsFromSkywardLaunch() ) // S3: entity method not available
		PlayerSkydiveThirdPersonEnable( player )

	thread SkydiveAttractLeviathan( player )

	thread StatsHook_TrackSkyDiveDistance( player )

	int forceStandHandle = player.PushForcedStance( FORCE_STANCE_STAND )
	OnThreadEnd(
		function() : ( player, forceStandHandle )
		{
			if ( IsValid( player ) )
			{
				player.RemoveForcedStance( forceStandHandle )
			}
		}
	)

	// Jump Jet FX (Last entire jump duration)

		int team = player.GetTeam()

		//TODO(chin): Figure out how Valk works with custom skydive trails
		if ( HasPlayerSettingMod( player, "valk_skydive" ) )
		{
			vector smokeColor = GetSkydiveSmokeColorForTeam( player.GetTeam() )
			foreach ( string attachment in file.jumpJetAttachments )
			{
				int valkFriendlyID = GetParticleSystemIndex( JUMPJET_VALK_SKYDIVE_FRIENDLY )
				entity valkSkydiveFX = StartParticleEffectOnEntity_ReturnEntity( player, valkFriendlyID, FX_PATTACH_POINT_FOLLOW, player.LookupAttachment( attachment ) )
				SetTeam( valkSkydiveFX, team )
				valkSkydiveFX.SetStopType( "destroyImmediately" )
				EffectSetControlPointVector( valkSkydiveFX, 1, smokeColor  )
				valkSkydiveFX.kv.VisibilityFlags = ENTITY_VISIBLE_TO_FRIENDLY
				jumpJetFX.append( valkSkydiveFX )

				int valkEnemyID = GetParticleSystemIndex( JUMPJET_VALK_SKYDIVE_ENEMY )
				entity valkEnemyFX = StartParticleEffectOnEntity_ReturnEntity( player, valkEnemyID, FX_PATTACH_POINT_FOLLOW, player.LookupAttachment( attachment ) )
				SetTeam( valkEnemyFX, team )
				valkEnemyFX.kv.VisibilityFlags = ENTITY_VISIBLE_TO_ENEMY
				EffectSetControlPointVector( valkEnemyFX, 1, smokeColor )
				jumpJetFX.append( valkEnemyFX )
			}
		}

	//#################

	SkyDiveTrailPackage package = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
	if ( GetNV_FreefallIsFromPlane( player ) || useSpawnJumpSounds )
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceLaunch1P )
	}

	if ( player == leaderPlayer )
	{
		if ( GetNV_FreefallIsFromPlane( player ) || useSpawnJumpSounds )
		{
			EmitSoundOnEntityExceptToPlayer( player, player, package.DropSequenceLaunch3P  )
		}
		else
		{
			EmitSoundOnEntityOnlyToPlayer( player, player, package.InGameFlightLaunch1P )
			EmitSoundOnEntityExceptToPlayer( player, player, package.InGameFlightLaunch3P )
		}
	}

	if ( GetNV_FreefallIsFromPlane( player ) || useSpawnJumpSounds )
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceTravel1P )
		EmitSoundOnEntityExceptToPlayer( player, player, package.DropSequenceTravel3P )
	}
	else
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, package.InGameFlightTravel1P )
		EmitSoundOnEntityExceptToPlayer( player, player, package.InGameFlightTravel3P )
	}

	                        
		Control_PrintSkydiveDebug( player, " PlayerSkyDive going to wait for SkyDiveMovement" )
                               

	waitthread SkyDiveMovement( player, skydiveData, driverViewVector, launchOffset, planeVelocity, leaderPlayer, constrainedDive, constrainedDiveDestination, constrainedDive2DRadius )

	                        
		Control_PrintSkydiveDebug( player, " PlayerSkyDive completed wait for SkyDiveMovement" )
                               
}

void function AllowDecoyDrop( entity player )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "FreefallEnded" )

	WaitFrame() //Allows NetVars to be set

	if( !IsValid( player ) )
		return

	float decoyDropDelay     = 2.0

	bool isSkydiveFollower = player.GetPlayerNetEnt( "skydiveFollowPlayer" ) != null
	if( !player.GetPlayerNetBool( "isJumpingWithSquad"  ) && isSkydiveFollower )
		decoyDropDelay = 0.5 // When not diving from the Jump Ship, allow Mirage to fire his clones faster

	wait decoyDropDelay

	player.p.skydiveDecoysFired = 0

	AddButtonPressedPlayerInputCallback( player, file.decoyInput, AttemptDecoyDrop )

	OnThreadEnd(
		function() : ( player )
		{
			RemoveButtonPressedPlayerInputCallback( player, file.decoyInput, AttemptDecoyDrop )
		}
	)

	WaitSignal( player, "FreefallEnded" )
}

void function EndPlayerSkyDive( entity player )
{
	Signal( player, "EndPlayerSkyDive" )
}

void function SkydiveAttractLeviathan( entity player )
{
	player.EndSignal( "OnDeath" )
	wait RandomFloatRange( 2.0, 4.0 )
	Leviathan_ConsiderLookAtEnt( player, RandomFloatRange( 10, 20 ), 0.1 )
	wait 5.0
	Leviathan_ConsiderLookAtEnt( player, RandomFloatRange( 10, 20 ), 0.1 )
}

void function SkydiveIntroAnim( entity player )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "PlayerSkyDive" )
	EndSignal( player, "BleedOut_OnStartDying" )
	if ( IsValid( svGlobal.levelEnt ) )
	{
		EndSignal( svGlobal.levelEnt, "DevPlaneTest" )
	}

	wait RandomFloatRange( 0.0, 0.75 )
}

void function SkyDiveMovement( entity player, SkydivePlayerData skydiveData, vector driverViewVector, vector launchOffset, vector planeVelocity, entity leaderPlayer, bool constrainedDive = false, vector constrainedDiveDestination = < 0, 0, 0 >, float constrainedDive2DRadius = 0.0 )
{
	                        
		Control_PrintSkydiveDebug( player, " SkyDiveMovement starting" )
                               

	int forwardPoseID = player.LookupPoseParameterIndex( "freefall_pitch" )
	int sidePoseID = player.LookupPoseParameterIndex( "freefall_yaw" )
	Assert( forwardPoseID >= 0 )
	Assert( sidePoseID >= 0 )

	float strafeAmount

	if ( !player.IsBot() )
		player.SetPlayerNetBool( "freefallActive", true )

	EndSignal( player, "OnDeath" )
	EndSignal( player, "PlayerSkyDive" )
	EndSignal( player, "BleedOut_OnStartDying" )
	if ( IsValid( svGlobal.levelEnt ) )
	{
		EndSignal( svGlobal.levelEnt, "DevPlaneTest" )
	}
	EndSignal( player, "DeathTotem_PreRecallPlayer" )

	//#####################################
	// LAUNCH OUT OF PLANE
	//#####################################

	// Launch out of plane with no control (we need this to get squad members into formation smoothly)
	if ( GetNV_FreefallIsFromPlane( player ) )
	{
		entity planeEnt
                         
                                              
                       
    
                                                  
    
       
        
		{
			planeEnt = Sur_GetPlaneEnt()
		}

		if ( IsValid( planeEnt ) )
		{
			vector launchEndPoint = player.GetOrigin() + ( driverViewVector * 500 ) + ( planeVelocity * 0.6 )
			launchEndPoint = OffsetPointRelativeToVector( launchEndPoint, launchOffset, driverViewVector )

			vector jumpDir = FlattenVec( driverViewVector )//FlattenVector( Normalize( launchEndPoint - mover.GetOrigin() ) )
			strafeAmount = GraphCapped( fabs( ( acos( DotProduct( planeEnt.GetForwardVector(), jumpDir ) ) * 180 / PI ) - 90 ), 0, 90, STRAFE_AMOUNT_MAX, 0.0 )
			// invert strafeAmount if we are looking out the right side of the plane
			if ( DotProduct( planeEnt.GetRightVector(), jumpDir ) > 0.0 )
				strafeAmount *= -1.0

			player.SetPoseParameterOverTime( forwardPoseID, 50, SKYDIVE_LAUNCH_NO_CONTROL_DURATION * 0.5 )
			player.SetVelocity( (launchEndPoint - player.GetOrigin()) / SKYDIVE_LAUNCH_NO_CONTROL_DURATION)

			thread SkydiveIntroAnim( player )
			wait SKYDIVE_LAUNCH_NO_CONTROL_DURATION
		}
		else
		{
			// If we are actually expecting a plane for the skydive but don't have one, assert
			Assert( !Skydive_IsPlaneExpectedForSkydiveRespawn(), "Tried to skydive but there is no plane entity" )
		}
	}

                       
           
                              
   
                                                                                                              
                                               
                                                                                             
                               
                                       
                                                     
                                               
                                          
                                                      
                                               
   
       
       

	//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
	{
		if ( !player.IsBot() )
		{
			player.SetPlayerNetBool( "freefallActive", false )
		}
		                        
			Control_PrintSkydiveDebug( player, " SkyDiveMovement breaking out early" )
                                

		return
	}

	//#####################################
	// PLAYER HAS CONTROL
	//#####################################

	// if constrainedDive, don't let player move past constrainedDive2DRadius from destLoc.
	if( constrainedDive )
	{
		//player.Player_SkydiveSetScriptConstraint( constrainedDiveDestination, constrainedDive2DRadius ) // S3: entity method not available
	}

	float prevTime = Time()
	bool slowZone = !player.p.freefallEnabled
	float lastSlowZoneChangeTime = 0
	float diveAngleGoal
	float actualDiveAngle
	float minGlideAngle
	float angleChangeRate
	float forwardPoseValue
	float sidePoseValue
	float lastGroundFXTime = 0.0
	float unfollowTime = -UNFOLLOW_CONTROL_BLEND_DURATION
	bool jumpJetFixEnabled = GetCurrentPlaylistVarBool( "skydive_jumpjet_fix", true )

	bool isFollowing = false
	player.p.skydiveIsFollowing = false

	SkydivePlayerData followPlayerData
	if ( player != leaderPlayer && IsValid( leaderPlayer ) && leaderPlayer in file.skydivePlayerDataLookup )
	{
		followPlayerData = file.skydivePlayerDataLookup[leaderPlayer]
		isFollowing = true
		player.p.skydiveIsFollowing = true
		player.SetPlayerNetEnt( "skydiveFollowPlayer", leaderPlayer )
		vector oldLocalOrigin = CalcWorldToLocalOrigin_Entity( leaderPlayer, player.GetOrigin() )
		player.Skydive_FollowPlayer( leaderPlayer )
		//if( !player.Skydive_IsFromSkywardLaunch() ) // S3: entity method not available
			player.SetLocalOrigin( <launchOffset.y, launchOffset.x, launchOffset.z> )
	}

	OnThreadEnd(
		function() : ( player, skydiveData )
		{
			if ( IsValid( player ) )
			{
				Signal( player, "FreefallEnded" )

				player.RumbleEffect( 0, 0, 0.0 )

				if (!player.IsBot())
				{
					player.SetPlayerNetBool( "freefallActive", false )
				}
				                        
					Control_PrintSkydiveDebug( player, " SkyDiveMovement OnThreadEnd" )
                                  
			}
		}
	)

	#if DEVELOPER
		float botLastForwardInputTime = 0.0
		float botNextForwardInputTime = 0.0
		float botLastForwardInput = 0.0
		float botNextForwardInput = 0.0

		float botLastRightInputTime = 0.0
		float botNextRightInputTime = 0.0
		float botLastRightInput = 0.0
		float botNextRightInput = 0.0

		float botLastViewVecTime = Time()
		float botNextViewVecTime = Time() + RandomFloatRange( 3.0, 5.0 )
		vector botLastViewVec = driverViewVector
		vector botNextViewVec = driverViewVector
	#endif

	const float LOCKED_FORWARD_INPUT = 1.0
	const float LOCKED_FORWARD_SPEED = 900

	while( true )
	{
		float dt = Time() - prevTime
		prevTime = Time()
		float elapsedTime = Time() - 0.0 /*player.Player_GetSkydiveStartTime() S3: not available*/

		float inputForward = player.GetInputAxisForward()

		float inputRight = player.GetInputAxisRight()
		vector horizonVec = AnglesToForward( FlattenAngles( player.GetAngles() ) )
		vector rightVec = AnglesToRight( FlattenAngles( player.GetAngles() ) )

		inputForward = Clamp( inputForward, -1.0, 1.0 )
		inputRight = Clamp( inputRight, -1.0, 1.0 )

		if ( slowZone && ( inputForward > 0.5 || inputForward < -0.5 || inputRight > 0.5 || inputRight < -0.5 ) )
			player.p.skydiveIsFollowing = false

		if ( isFollowing )
		{
			// Player can break out of follow mode by giving some stick input, or if follow target isn't skydiving anymore
			//if ( !player.p.skydiveIsFollowing || !IsValid( player.GetParent() ) || !IsValid( leaderPlayer ) || !IsAlive( leaderPlayer ) || !leaderPlayer.IsSkydiving() /*Player_IsSkydiving not in S3*/ || !player.Skydive_IsFollowing() )
			{
				isFollowing = false
				unfollowTime = Time()

				if ( player.Skydive_IsFollowing() )
				{
					player.Skydive_StopFollowing()
				}

				player.SetPlayerNetEnt( "skydiveFollowPlayer", null )
				player.SetVelocity( followPlayerData.velocity )

				WaitFrame()
				continue
			}
		}
		else
		{
			#if DEVELOPER
			// Bots fly random paths, turning, speeding up and slowing down
			if ( player == leaderPlayer && player.IsBot() )
			{
				if ( Time() >= botNextForwardInputTime )
				{
					botLastForwardInputTime = Time()
					botNextForwardInputTime = Time() + RandomFloatRange( 2.0, 4.0 )
					botLastForwardInput = botNextForwardInput
					botNextForwardInput = RandomFloatRange( -1.0, 1.0 )
				}

				if ( Time() >= botNextRightInputTime )
				{
					botLastRightInputTime = Time()
					botNextRightInputTime = Time() + RandomFloatRange( 3.0, 6.0 )
					botLastRightInput = botNextRightInput
					botNextRightInput = RandomFloatRange( -0.5, 0.5 )
				}

				if ( Time() >= botNextViewVecTime )
				{
					botLastViewVecTime = Time()
					botNextViewVecTime = Time() + RandomFloatRange( 4.0, 7.0 )
					botLastViewVec = botNextViewVec
					botNextViewVec = AnglesToForward( < RandomFloatRange( -20.0, 90.0 ), RandomFloatRange( 0.0, 360.0 ), 0.0 > )
				}

				inputForward = GraphCapped( Time(), botLastForwardInputTime, botNextForwardInputTime, botLastForwardInput, botNextForwardInput )
				inputRight = GraphCapped( Time(), botLastRightInputTime, botNextRightInputTime, botLastRightInput, botNextRightInput )
			}
			#endif

			// Handle constrainedDive.
			const float CONSTRAINEDDIVE_MOVEMOD = 0.1
			inputRight = constrainedDive ? inputRight * CONSTRAINEDDIVE_MOVEMOD : inputRight

			skydiveData.inputForward = inputForward
			skydiveData.inputRight = inputRight

			//#####################################
			// 		CALCULATE DIVE ANGLE
			//#####################################

			actualDiveAngle = player.Skydive_GetDiveAngle();
			skydiveData.diveAngle = actualDiveAngle
		}

		//#####################################
		//     		PLAYER ROTATION
		//#####################################

		#if DEVELOPER
			bool outOfBounds = false
		#endif

		if ( isFollowing )
		{
			//#####################################
			// 			 FOLLOW MODE
			//#####################################

			actualDiveAngle = followPlayerData.diveAngle
		}
		else
		{
			//#####################################
			//     CALCULATE STRAFE MOVEMENT
			//#####################################

			strafeAmount = player.Skydive_GetStrafeAngle();

			//#####################################
			// 		CALCULATE NEW VELOCITY
			//#####################################

			vector newVelocity = player.GetVelocity()

			#if DEVELOPER
				if ( SKYDIVE_DEBUG )
				{
					printt( "lockforward: Player Skydive Speed == " + Length( newVelocity ) )
				}
			#endif // DEVELOPER

			// Don't allow us to move the player into a boundary volume
			vector newPlayerPos = player.GetOrigin() + (newVelocity * dt)

			if ( newPlayerPos.z > MAX_WORLD_COORD_BUFFER || IsPointInsideSkydiveBoundary( newPlayerPos ) )
			{
				// Dive us straight down
				newVelocity = < 0, 0, -newVelocity.Length() >

				#if DEVELOPER
					outOfBounds = true
				#endif
			}
			else
			{
				if ( newPlayerPos.x > MAX_WORLD_COORD_BUFFER || newPlayerPos.x < -MAX_WORLD_COORD_BUFFER )
					newVelocity = < 0, newVelocity.y, newVelocity.z >
				if ( newPlayerPos.y > MAX_WORLD_COORD_BUFFER || newPlayerPos.y < -MAX_WORLD_COORD_BUFFER )
					newVelocity = < newVelocity.x, 0, newVelocity.z >
				if ( newPlayerPos.z > MAX_WORLD_COORD_BUFFER || newPlayerPos.z < -MAX_WORLD_COORD_BUFFER )
					newVelocity = < newVelocity.x, newVelocity.y, 0 >
			}

			// Set the new velocity of the player
			player.SetVelocity( newVelocity )
			skydiveData.velocity = newVelocity
		}

		//#####################################
		//     		GROUND DETECTION
		//#####################################

		if ( !player.p.freefallEnabled )
		{
			slowZone = true
		}
		else
		{
			//slowZone = player.Player_IsSkydiveAnticipating()
		}

		//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
		{
			if ( !player.IsBot() )
			{
				player.SetPlayerNetBool( "freefallActive", false )
			}

			player.Signal( "FreefallEnded" )

			MapZones_RefreshZoneCalloutForPlayer( player )

			player.RumbleEffect( 0, 0, 0.0 )
			                        
				Control_PrintSkydiveDebug( player, " SkyDiveMovement breaking out early in while loop" )
                                 
			return
		}

		//#####################################
		// 		  		DEBUG
		//#####################################
	
		#if DEVELOPER
			if ( SKYDIVE_DEBUG )
			{
				vector newVelocity = player.GetVelocity()

				string debugString = "-- SkyDive --"
				debugString += "\n" + format( "Duration: %.2f", elapsedTime )
				//debugString += "\n" + format( "Speed: %.2f (%.2f max)", movementSpeed, maxAllowedSpeed )
				debugString += "\n" + format( "Dive Angle Goal: %.2f", diveAngleGoal )
				debugString += "\n" + format( "Actual Dive Angle: %.2f (%.2f min)", actualDiveAngle, minGlideAngle )
				//debugString += "\n" + format( "Distance to collision: %.2f", distanceFromCollision )
				debugString += "\n" + format( "Out Of Bounds: %s", outOfBounds ? "true" : "false" )

				DebugDrawScreenText( 0.05, 0.5, debugString )

				vector minFallVector = VectorRotateAxis( horizonVec, rightVec, -minGlideAngle )

				//DebugDrawAngles( rotator.GetOrigin(), rotator.GetAngles(), 0.1 )

				//DebugDrawLine( lastPos, mover.GetOrigin(), COLOR_MAGENTA, true, 20.0 )
				//DebugDrawLine( player.GetOrigin(), player.GetOrigin() + Normalize( horizonVec ) * 100, <255, 255, 255>, true, 0.1 )
				DebugDrawLine( player.GetOrigin(), player.GetOrigin() + Normalize( rightVec ) * 100, <200, 200, 200>, true, 0.1 )
				//DebugDrawLine( player.GetOrigin(), player.GetOrigin() + Normalize( newVelocity ) * 100, <255, 255, 0>, true, 0.1 )
				//DebugDrawLine( player.GetOrigin(), player.GetOrigin() + minFallVector * 125, <0, 255, 0>, true, 0.1 )

				//DebugDrawRotatedBox( traceStart, mins, maxs, VectorToAngles( traceEnd - traceStart ), <255, 255, 0>, true, 0.1 )
				//DebugDrawLine( player.GetOrigin(), player.GetOrigin() + newVelocity, <255, 255, 255>, true, 0.1 )
			}
		#endif

		WaitFrame()
	}
}

void function Freelook_Enable( entity player )
{
	player.p.skydiveFreelookEnabled++
	player.Skydive_SetFreelookMode( true )
	player.SetPlayerNetBool( "skydiveFreelookActive", true )
}

void function Freelook_Disable( entity player )
{
	player.p.skydiveFreelookEnabled = int( max( player.p.skydiveFreelookEnabled - 1, 0 ) )
	if ( player.p.skydiveFreelookEnabled <= 0 )
	{
		player.Skydive_SetFreelookMode( false )
		player.SetPlayerNetBool( "skydiveFreelookActive", false )
	}
}

void function SnapEyeAnglesWithFade( entity player, vector angles )
{
	EndSignal( player, "OnDeath" )
	thread ScreenFadeToBlack( player, 0.5, 0.0 )
	wait 0.5
	player.SnapEyeAngles( angles )
	thread ScreenFadeFromBlack( player, 0.5, 0 )
}

vector function GetSkydiveFormationOffset( entity player, array<entity> squadPlayers, entity leaderPlayer )
{
	if ( player == leaderPlayer )
		return < 0, 0, 0 >

	int index = 0
	foreach( entity _player in squadPlayers )
	{
		if ( _player == leaderPlayer )
			continue
		if ( _player == player )
			break
		index++
	}

	int countBack = ( index + 2 ) / 2
	vector offset = < 50, -50, 15 > * countBack

	if ( index % 2 == 0 )
		offset.x *= -1

	return offset
}

void function FillSkyWithClouds()
{
	if ( IsTestMap() )
		return

	if ( !file.shouldFillSkyWithClouds )
		return

	int MAP_EXTENTS = 53248
	float MAX_HEIGHT = SURVIVAL_GetPlaneHeight() - 2000 //GetEntByScriptName( "hover_tank_start_node1" ).GetOrigin().z - 2000
	float MIN_HEIGHT = SURVIVAL_GetAirburstHeight() + 2000
	Assert( MAX_HEIGHT > MIN_HEIGHT, "The maps airburst height is too close to the plane height. The plane height must be more than 4000 units higher than the airburst height. If this is a problem we can adjust this logic." )
	int GRID_COUNT_XY = 4
	int GRID_COUNT_Z = 3
	int COVERAGE_MAX = 20
	int COVERAGE_MIN = 5
	float JITTER_DIST_XY = 3000.0
	float JITTER_DIST_Z = 1000.0

	foreach( entity model in file.cloudModels )
		model.Destroy()
	file.cloudModels.clear()

	for( float zIt = 0 ; zIt < GRID_COUNT_Z ; zIt++ )
	{
		float z = MAX_HEIGHT - ( zIt * (( MAX_HEIGHT - MIN_HEIGHT ) / ( GRID_COUNT_Z - 1 )) )
		for( float yIt = 0 ; yIt < GRID_COUNT_XY ; yIt++ )
		{
			float y = -MAP_EXTENTS + ( yIt * (( MAP_EXTENTS * 2 ) / ( GRID_COUNT_XY - 1 )) )
			for( float xIt = 0 ; xIt < GRID_COUNT_XY ; xIt++ )
			{
				float x = -MAP_EXTENTS + ( xIt * (( MAP_EXTENTS * 2 ) / ( GRID_COUNT_XY - 1 )) )
				vector cloudPos = <x + RandomFloatRange(-JITTER_DIST_XY,JITTER_DIST_XY), y + RandomFloatRange(-JITTER_DIST_XY,JITTER_DIST_XY), z + RandomFloatRange(-JITTER_DIST_Z,JITTER_DIST_Z)>
				float chance = GraphCapped( zIt, 0, GRID_COUNT_Z - 1, COVERAGE_MAX, COVERAGE_MIN )
				if ( RandomInt( 100 ) >= chance )
					continue
				//DebugDrawSphere( cloudPos, 512, <255, 0, 0>, true, 99.0 )
				entity model = CreatePropDynamic( CLOUD_MODEL, cloudPos, <0,RandomInt(359),0> )
				file.cloudModels.append( model )
			}
		}
	}
}

void function DisableSkydiveThirdPerson( entity player, bool jumpingFromPlane )
{
	                        
		Control_PrintSkydiveDebug( player, " DisableSkydiveThirdPerson starting" )
                               
	if ( !IsValid( player ) )
		return

	player.ClearTrackEntitySettings()
	player.Solid()

	vector velocity = player.GetVelocity()

	//if ( player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
	{
		//player.Player_EndSkydive() // S3: entity method not available
		player.Anim_Stop()
	}

	if ( player in file.skydivePlayerDataLookup )
		delete file.skydivePlayerDataLookup[ player ]

	                        
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_EXPLORE ) && ShGameModeExplore_GetPlanePassNumber() > 1 )
			jumpingFromPlane = false
       

	player.ClearFirstDeployForAllWeapons()
	if ( jumpingFromPlane )
	{
		//player.ResetFirstDeployForMeleeWeapons() // S3: entity method not available
	}
	
	SkyDiveTrailPackage package = GetSkyDiveTrailPackageForPlayerWithOverrides( player )
	EmitSoundOnEntityOnlyToPlayer( player, player, package.DropSequenceCameraTransition1P )
	player.p.inThirdPersonTransition = true
	HolsterAndDisableWeapons( player )
	
	// 1.5 second delay so that the third-person -> first-person camera
	// transition has time to finish
	wait 1.5
	
	if ( !IsValid( player ) )
		return

	DeployAndEnableWeaponsWithSlowDeploy( player, 0.0 )
	player.p.inThirdPersonTransition = false
	                        
		Control_PrintSkydiveDebug( player, " DisableSkydiveThirdPerson reached function end" )
                               
}

void function ClientCallback_StopFreefallFollowMode( entity player )
{
	if ( IsValid( player ) )
		player.p.skydiveIsFollowing = false
}

void function PlayerFallAssistanceDetection( entity player )
{
	if ( GetCurrentPlaylistVarBool( "jumpjet_fall_assistance", false ) == false )
		return

	float FREEFALL_JETPACK_ACTIVATION_VELOCITY = 650
	float FREEFALL_JETPACK_ACTIVATION_MIN_HEIGHT = 750

	Signal( player, "PlayerFallAssistanceDetection" )
	EndSignal( player, "PlayerFallAssistanceDetection" )
	EndSignal( player, "OnDeath" )
	EndSignal( player, "OnDestroy" )

	float lastZiplineOrGrappleTime = 0.0
	float lastUpwardVelocityTime = 0.0
	bool noclipDebounceActive = false

	while( true )
	{
		WaitFrame()

		if ( player.IsNoclipping() )
		{
			noclipDebounceActive = true
			continue
		}

		//if ( player.IsOnGround() || IsValid( player.GetParent() ) || player.IsSkydiving() /*Player_IsSkydiving not in S3*/ || Bleedout_IsBleedingOut( player ) )
		{
			noclipDebounceActive = false
			continue
		}

		if ( player.IsGrapplePulling() || player.IsMountingZipline() || IsValid( player.Zipline_GetActiveZipline() ) )
		{
			lastZiplineOrGrappleTime = Time()
			continue
		}

		vector velocity = player.GetVelocity()

		if ( velocity.z > 0 )
		{
			lastUpwardVelocityTime = Time()
			continue
		}

		if ( Time() - lastZiplineOrGrappleTime < 2.0 )
			continue

		if ( Time() - lastUpwardVelocityTime < 2.0 )
			continue

		if ( noclipDebounceActive )
			continue

		float speed = velocity.Length()
		vector traceEnd = player.GetOrigin() + ( Normalize( velocity ) * SKYDIVE_SLOWDOWN_DIST_FROM_GROUND )
		TraceResults result = TraceLine( player.GetOrigin(), traceEnd, [ player ], TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
		float distFromGround = Distance( player.GetOrigin(), result.endPos )

		//DebugDrawLine( player.GetOrigin(), traceEnd, <255, 255, 0>, true, 0.1 )
		//printt( "Fall Assistance", speed, distFromGround )

		if ( speed >= FREEFALL_JETPACK_ACTIVATION_VELOCITY && distFromGround >= FREEFALL_JETPACK_ACTIVATION_MIN_HEIGHT )
		{
			thread PlayerSkydiveLandingFromCurrentPosition( player )
			return
		}
	}
}

void function ClientCallback_SkydiveEmote( entity player, int index )
{
	printt( "SERVER EMOTE" )

	//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
		return

	//if ( player.Player_IsSkydiveAnticipating() )
		return

	if ( !player.GetPlayerNetBool( "freefallEmoteAvailable" ) )
		return

	bool validIndex = IsValidArrayIndex( index, NUM_SKYDIVE_EMOTE_SLOTS )
	Assert( validIndex, format( "%i does NOT index NUM_SKYDIVE_EMOTE_SLOTS", index ) )
	if ( !validIndex )
		return

	ItemFlavor emoteFlav = GetPlayerSkydiveEmote( player, index )
	if ( SkydiveEmote_IsTheEmpty( emoteFlav ) )
		return

	player.p.lastSkydiveEmote = index
	thread ActivateSkydiveEmote( player, emoteFlav )
}

void function ClientCallback_SkydiveEmoteNext( entity player )
{
	//if ( !player.IsSkydiving() /*Player_IsSkydiving not in S3*/ )
		return

	//if ( player.Player_IsSkydiveAnticipating() )
		return

	if ( !player.GetPlayerNetBool( "freefallEmoteAvailable" ) )
		return

	table< int, ItemFlavor > emotes = GetValidPlayerSkydiveEmotes( player )

	// Related to Jira R5DEV-572636. This seems to happen if the player has no skydive emotes but does have quips since CodeCallback_PlayerSkydiveBegin sets the above net var if quips/holosprays are available
	if ( emotes.len() == 0 )
		return

	array< ItemFlavor > emoteArray
	foreach ( flav in emotes )
	{
		emoteArray.append( flav )
	}


	int index
	if ( player.p.lastSkydiveEmote == -1 )
	{
		index = ( emoteArray.len() - 1 )
	}
	else
	{
		index = (player.p.lastSkydiveEmote + emoteArray.len() - 1) % emoteArray.len()
	}

	ItemFlavor emoteFlav = emoteArray[ index ]
	if ( SkydiveEmote_IsTheEmpty( emoteFlav ) )
		return

	player.p.lastSkydiveEmote = index
	thread ActivateSkydiveEmote( player, emoteFlav )
}

void function Freefall_CancelSkydiveEmote( entity player )
{
	if ( IsValid( player ) )
	{
		player.Signal( "SkydiveEmote_Cancel" )
	}
}

void function ActivateSkydiveEmote( entity player, ItemFlavor emoteFlav )
{
	EndSignal( player, "OnDeath" )
	EndSignal( player, "SkydiveEmote_Cancel" )

	OnThreadEnd( function() : ( player ) {
		if ( IsValid( player ) )
		{
			table<int, ItemFlavor> emotes = GetValidPlayerSkydiveEmotes( player )
			//if ( emotes.len() > 0 && !player.Player_IsSkydiveAnticipating() && !player.p.skydiveEmotesDisabled ) //if not disabled by playlist var allow freefall emotes
				player.SetPlayerNetBool( "freefallEmoteAvailable", true )
		}
	} )

	player.SetPlayerNetBool( "freefallEmoteAvailable", false )

                         
	SkydiveEmoteProjector_CancelProjector( player )
      

	asset animSeq = SkydiveEmote_GetAnimSeq( emoteFlav )
	player.Anim_PlayOnly( animSeq )

	if( !IsValid( player.GetParent() ) )
		player.Anim_DisableUpdatePosition()

	player.Anim_EnablePrediction()
	player.Anim_EnableFadeOut()

	bool canVocalizeEmote = true

	if ( ( player in file.playerToLastVocalizedEmoteTime ) )
	{
		canVocalizeEmote = Time() - file.playerToLastVocalizedEmoteTime[player] > ( 2 * ( player.GetSequenceDuration( animSeq ) + POST_EMOTE_DEBOUNCE ) )
	}

	if ( canVocalizeEmote )
	{
		string skydiveBcEventName = SkydiveEmote_GetBcEvent( emoteFlav )
		PlayBattleChatterLineToSpeakerAndTeam( player, skydiveBcEventName )
		file.playerToLastVocalizedEmoteTime[player] <- Time()
	}

	wait player.GetSequenceDuration( animSeq )
	wait POST_EMOTE_DEBOUNCE
}

#endif //SERVER


