// === Platform/Hardware ===

string function GetUnspoofedPlayerHardware()
{
	return "PC"
}

int function GetHardwareFromName( string name )
{
	switch ( name )
	{
		case "PC":
			return HARDWARE_PC
		case "PC_STEAM":
			return HARDWARE_PC_STEAM
		case "PS4":
			return HARDWARE_PS4
		case "PS5":
			return HARDWARE_PS5
		case "X1":
			return HARDWARE_XBOXONE
		case "XB5":
			return HARDWARE_XB5
		case "NX":
			return HARDWARE_NX
	}
	return HARDWARE_PC
}

string function GetNameFromHardware( int hardware )
{
	switch ( hardware )
	{
		case HARDWARE_PC:
			return "PC"
		case HARDWARE_PC_STEAM:
			return "PC_STEAM"
		case HARDWARE_PS4:
			return "PS4"
		case HARDWARE_PS5:
			return "PS5"
		case HARDWARE_XBOXONE:
			return "X1"
		case HARDWARE_XB5:
			return "XB5"
		case HARDWARE_NX:
			return "NX"
	}
	return "PC"
}

