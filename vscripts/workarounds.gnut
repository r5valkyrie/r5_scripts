// === Workarounds/Utilities ===

string function WORKAROUND_AnimAssetToAnimString( asset animAsset )
{
	string assetAsString = string( animAsset )
	return assetAsString.slice( 2, assetAsString.len() - 1 )
}

void function WORKAROUND_PreventScriptErrors()
{
}

string function LocalizeNumber( ... )
{
	if ( vargc > 0 )
		return "" + vargv[0]
	return "0"
}

string function FormatNumber( string format, var number )
{
	return FormatAndLocalizeNumber( format, number, false )
}

