// Get a random element from an array using a seeded RNG
var function ArrayGetRandomSeeded( array arr, int seed )
{
	var rngSeed = CreateRandomSeed( seed )
	int idx = RandomIntRangeSeeded( rngSeed, 0, arr.len() )
	return arr[idx]
}

void function ArrayRandomizeSeeded( array arr, int seed )
{
	var rngSeed = CreateRandomSeed( seed )
	for ( int i = arr.len() - 1; i > 0; i-- )
	{
		int j = RandomIntRangeInclusiveSeeded( rngSeed, 0, i )
		var temp = arr[i]
		arr[i] = arr[j]
		arr[j] = temp
	}
}


array<vector> function ShuffleVectorArray( array<vector> arr )
{
	array<vector> result = clone arr
	for ( int i = result.len() - 1; i > 0; i-- )
	{
		int j = RandomInt( i + 1 )
		vector temp = result[i]
		result[i] = result[j]
		result[j] = temp
	}
	return result
}

// Custom loadout/spectating/character assignment implementations
void function TakeLoadoutRelatedWeapons( entity player )
{
#if SERVER
	ItemFlavor character = LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() )

	if(IsValid(player.GetOffhandWeapon( OFFHAND_SLOT_FOR_CONSUMABLES )))
		player.TakeOffhandWeapon( OFFHAND_SLOT_FOR_CONSUMABLES )

	if(IsValid(player.GetNormalWeapon( WEAPON_INVENTORY_SLOT_PRIMARY_2 )))
		player.TakeNormalWeaponByIndexNow( WEAPON_INVENTORY_SLOT_PRIMARY_2 )

	if(IsValid(player.GetOffhandWeapon( OFFHAND_MELEE )))
		player.TakeOffhandWeapon( OFFHAND_MELEE )

	if(IsValid(player.GetOffhandWeapon( OFFHAND_TACTICAL )))
		player.TakeOffhandWeapon( OFFHAND_TACTICAL )
	if(IsValid(player.GetOffhandWeapon( OFFHAND_ULTIMATE )))
		player.TakeOffhandWeapon( OFFHAND_ULTIMATE )

	TakeAllPassives( player )
#endif
}

void function PlayerStopSpectating( entity player )
{
	#if SERVER
	player.SetPlayerNetInt( "spectatorTargetCount", 0 )
	player.SetSpecReplayDelay( 0 )
	player.StopObserverMode()
	#endif
}

