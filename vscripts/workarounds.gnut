string function GetDaysHoursRemainingLoc( int days, int hours )
{
	string dateFormat = "#DAYS_HOURS_REMAINING"

	if ( hours == 1 )
	{
		dateFormat = "#DAYS_HOUR_REMAINING"
	}
	if ( days == 1 )
	{
		if ( hours == 1 )
		{
			dateFormat = "#DAY_HOUR_REMAINING"
		}
		else
		{
			dateFormat = "#DAY_HOURS_REMAINING"
		}
	}

	return dateFormat
}

