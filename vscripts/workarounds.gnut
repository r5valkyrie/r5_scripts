// === Platform/Hardware (SERVER || CLIENT implementations for global-scope declarations) ===

int function GetHardwareFromName( string name )
{
	switch ( name )
	{
		case "PC":
			return HARDWARE_PC
		case "PC_STEAM":
			return HARDWARE_PC_STEAM
		case "PS4":
			return HARDWARE_PS4
		case "PS5":
			return HARDWARE_PS5
		case "X1":
			return HARDWARE_XBOXONE
		case "XB5":
			return HARDWARE_XB5
		case "NX":
			return HARDWARE_NX
	}
	return HARDWARE_PC
}

