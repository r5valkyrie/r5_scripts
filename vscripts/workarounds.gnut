float function MetersToInches( float meters )
{
	return( meters * METERS_TO_INCHES )
}

float function MetersToInchesSqr( float meters )
{
	float inches = MetersToInches( meters )
	return( inches * inches )
}

vector function GetRandomPointInCircle( vector origin, float radius )
{
	float t  = 2 * PI * RandomFloat( 1 )
	float r  = sqrt( RandomFloat( 1.0 ) ) * radius
	float x  = r * cos( t )
	float y  = r * sin( t )
	vector p = <x, y, 0> + origin
	return p
}

string function replace( string original, string search, string replacement )
{
	string result = ""
	int searchLen = search.len()
	int i = 0
	while ( i < original.len() )
	{
		if ( i + searchLen <= original.len() && original.slice( i, i + searchLen ) == search )
		{
			result += replacement
			i += searchLen
		}
		else
		{
			result += original.slice( i, i + 1 )
			i++
		}
	}
	return result
}

