// GetPlayerUID is UI-only native, CLIENT uses GetPlatformUID on entity
string function GetPlayerUID()
{
	entity player = GetLocalClientPlayer()
	if ( IsValid( player ) )
		return player.GetPlatformUID()
	return ""
}

// Wraps existing function
// Note: Using int instead of EHI because EHI typedef isn't defined yet at load time
string function GetPlayerNameFromEHI( int ehi )
{
	return GetDisplayablePlayerNameFromEHI( ehi )
}

// stub - privacy/anonymization not available
string function GetObfuscatedIdFromPlayer( entity player )
{
	return ""
}

// Checks if local player is alive and not in replay
bool function IsLocalPlayerAlive_NonReplay()
{
	if ( IsWatchingReplay() )
		return false
	entity player = GetLocalClientPlayer()
	return IsValid( player ) && IsAlive( player )
}

// Checks if player is in bleedout or being revived
bool function IsInBleedoutOrRevive( entity player )
{
	if ( !IsValid( player ) )
		return false
	if ( Bleedout_IsBleedingOut( player ) )
		return true
	if ( player.ContextAction_IsReviving() || player.ContextAction_IsBeingRevived() )
		return true
	return false
}

