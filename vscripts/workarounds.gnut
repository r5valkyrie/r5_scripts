// === Time ===

void function WaitForUnixTime( int unixTime )
{
	while ( true )
	{
		float delay = float(unixTime - GetUnixTimestamp())
		if ( delay <= 0.0 )
			break
		wait min( 1.0, delay )
	}
}

bool function GetIsDSTActive()
{
	return false
}

int function GetUnixTimePDT()
{
	return GetUnixTimestamp() + (-7 * SECONDS_PER_HOUR)
}

string function RLocalDateTime( int unixTime )
{
	return GetDateTimeString( unixTime )
}

string function RLocalTime( int unixTime )
{
	return GetDateTimeString( unixTime )
}

