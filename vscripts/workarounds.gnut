// Checks if player is in bleedout or being revived
bool function IsInBleedoutOrRevive( entity player )
{
	if ( !IsValid( player ) )
		return false
	if ( Bleedout_IsBleedingOut( player ) )
		return true
	if ( player.ContextAction_IsReviving() || player.ContextAction_IsBeingRevived() )
		return true
	return false
}

