string function replace( string original, string search, string replacement )
{
	string result = ""
	int searchLen = search.len()
	int i = 0
	while ( i < original.len() )
	{
		if ( i + searchLen <= original.len() && original.slice( i, i + searchLen ) == search )
		{
			result += replacement
			i += searchLen
		}
		else
		{
			result += original.slice( i, i + 1 )
			i++
		}
	}
	return result
}

