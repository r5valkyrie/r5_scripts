void function ClientCallback_DeleteCupEntry( entity player, SettingsAssetGUID cupID )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

#if DEV
	int pDataIndex = Cups_GetPlayersPDataIndexForCupID( player, cupID )
	if ( pDataIndex >= 0 )
	{
		string persistentDataKey = format( "cups[%d]", pDataIndex )
		string squadID = expect string(player.GetPersistentVar( persistentDataKey + ".squadID" ))
		CupsDeleteSquadEntry( player, cupID, squadID )
		player.SetPersistentVar( persistentDataKey + ".active", false )
	}
#endif //DEV
}

void function Cups_ClearLastMatchPlayed( entity player )
{
	string persistentDataKey = "cupsLastMatchPlayed"
	player.SetPersistentVar( persistentDataKey + ".cupID", 0 )
}

void function ClientCallback_DeleteCupsLastMatchPlayed( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) ) return
#if DEV
	Cups_ClearLastMatchPlayed( player )
#endif //DEV
}

bool function Cups_IsCupRewardGranted( entity player, SettingsAssetGUID cupID )
{
	CupBakeryAssetData cupData  = Cups_GetCupBakeryAssetDataFromGUID( cupID )
	ItemFlavor cupContainerFlav = CupFlavor_GetEvent( cupData.itemFlavor )
	string rewardSeqName        = CupEvent_GetRewardSequenceName( cupContainerFlav )
	bool rewardItemsGranted     = GRX_GetSequenceNumber( player, rewardSeqName ) > 0
                      
		return rewardItemsGranted && RankedRumble_BadgeTierHasSet( player, cupContainerFlav )
      
                           
       
}

void function Cups_CheckAndAwardCupRewards( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDisconnecting" )

	while ( !GRX_IsInventoryReady( player ) )
		WaitFrame()
	
	array< SettingsAssetGUID > cupIDsToQueryTierResults = [ ]
	foreach ( UserCupEntryData cupEntry in Cups_GetPlayersFullPCupData( player ) )
	{
		if( Cups_HasGracePeriodEndedForCup( cupEntry.cupID ) )
		{
			if( Cups_IsCupRewardGranted( player, cupEntry.cupID ) || cupEntry.numMatches == 0 )
			{
				string persistentDataKey = format( "cups[%d]", cupEntry.cupIndex )
				player.SetPersistentVar( persistentDataKey + ".active", false )
			}
			else
			{
				// Need to query final cup tier
				cupIDsToQueryTierResults.append( cupEntry.cupID )
			}
		}
		else if ( !Cups_IsValidCupID( cupEntry.cupID ) )
		{
			// Remove cup from persistence as bakery data no longer exists
			string persistentDataKey = format( "cups[%d]", cupEntry.cupIndex )
			player.SetPersistentVar( persistentDataKey + ".active", false )

			//TODO: Send request to Stryder to clear out redis data
		}
	}

	if( cupIDsToQueryTierResults.len() > 0 )
	{
		// Send Stryder request to query final cup tier
		//CupsGetUserRewardTierData( player, cupIDsToQueryTierResults )
	}
}

void function ResetPlayerCupPersistence( entity player, int pDataIndex )
{
	string persistentDataKey = format( "cups[%d]", pDataIndex )
	player.SetPersistentVar( persistentDataKey+".active", false )
	player.SetPersistentVar( persistentDataKey+".cupID", 0 )
	player.SetPersistentVar( persistentDataKey+".numMatches", 0 )
	player.SetPersistentVar( persistentDataKey+".squadID", "" )
}

void function CodeCallback_CupsGetRegisteredCupsResponse( entity player, table< SettingsAssetGUID, string > registeredCups )
{
	array<UserCupEntryData> playersPersistentData = Cups_GetPlayersFullPCupData( player )

	array<int> updatedPDataIndices = []

	foreach ( SettingsAssetGUID cupID, string squadID in registeredCups )
	{
		if( !Cups_IsValidCupID( cupID ) )
		{
			Warning( "Player "+player+" is registered to a cup with an invalid ID ("+cupID+"), please clear this data from Stryder" )
		}

		int pDataIndex = -1;
		foreach( UserCupEntryData pDataEntry in playersPersistentData )
		{
			if( pDataEntry.cupID == cupID )
				pDataIndex = pDataEntry.cupIndex
		}

		if( pDataIndex < 0 )
			pDataIndex = Cups_GetNextAvailablePersistentDataSlot( player )

		if( pDataIndex < 0 )
		{
			Warning( "Player "+player+" is registered for cup "+cupID+" but there's no available Persistent Data Slot!" )
			continue
		}

		updatedPDataIndices.append( pDataIndex )

		string persistentDataKey = format( "cups[%d]", pDataIndex )
		player.SetPersistentVar( persistentDataKey+".active", true )
		player.SetPersistentVar( persistentDataKey+".cupID", cupID )
		player.SetPersistentVar( persistentDataKey+".squadID", squadID )
	}

	for ( int pDataIndex = 0; pDataIndex < MAX_REGISTERED_CUPS; ++pDataIndex )
	{
		if( updatedPDataIndices.contains( pDataIndex ) )
			continue

		ResetPlayerCupPersistence( player, pDataIndex )
	}


	if( player in fileLevel.syncPersistenceCompleteCallbacks && fileLevel.syncPersistenceCompleteCallbacks[player] != null )
	{
		void functionref() callback = expect void functionref()( fileLevel.syncPersistenceCompleteCallbacks[player])
		callback()
		fileLevel.syncPersistenceCompleteCallbacks[player] = null
	}
}

void function Cups_SyncStryderAndPersistence( entity player, void functionref() onCompleteCallback )
{
	Assert( !( player in fileLevel.syncPersistenceCompleteCallbacks ) || fileLevel.syncPersistenceCompleteCallbacks[player] == null )

	if( !( player in fileLevel.syncPersistenceCompleteCallbacks ) )
		fileLevel.syncPersistenceCompleteCallbacks[player] <- onCompleteCallback
	else
		fileLevel.syncPersistenceCompleteCallbacks[player] = onCompleteCallback

	//CupsGetRegisteredCups( player )
}

void function Cups_OnClientConnectedToLobby( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

	printt( "Cups_OnClientConnectedToLobby" )

	Cups_SyncStryderAndPersistence( player, void function() : (player) {
		if( IsValid( player ) )
		{
			thread Cups_CheckAndAwardCupRewards( player )
			                     
				RankedRumble_CheckLadderPosition( player )
				RankedRumble_CheckAutoEnroll( player )
				Ranked_SetLastGameParticipationScore( player, 0 )
                             
		}
	} )
}

void function Cups_OnGameStateEnterPreMatch()
{
	if( !GetConVarBool( "cups_enabled" ) ) return

	if( !Cups_IsMatchValidForCups() ) return;

	printt( "Cups_OnGameStateEnterPreMatch" )

	table<string, int> squadRequests
	bool querySquads = false

	foreach ( var squadLeaderIndex, array<entity> squad in GetAllMatchReservationParties() )
	{
		foreach( entity player in squad )
		{
			Cups_ClearLastMatchPlayed( player )
		}

		// Query squads crossplay state
		bool squadCrossPlayEnabled = true
		foreach ( entity squadMember in squad )
		{
			//if( !squadMember.IsCrossPlay() )
			//	squadCrossPlayEnabled = false
		}
		if( !squadCrossPlayEnabled ) continue

                     
		if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_RANKED ) )
		{
			if ( RankedRumble_IsRunningRankedRumble() )
			{
				foreach( entity player in squad )
				{
					foreach ( UserCupEntryData cupEntry in Cups_GetPlayersFullPCupData( player ) )
					{
						CupBakeryAssetData cupData = Cups_GetCupBakeryAssetDataFromGUID( cupEntry.cupID )
						if ( !RankedRumble_IsCupRankedRumble( cupData.itemFlavor ) )
							continue
						if ( !RankedRumble_IsCupMatchPlayerPlatform( cupEntry.cupID, player ) )
							continue
						if( !CalEvent_IsActive( cupData.containerItemFlavor, GetUnixTimestamp() ) ) continue
						string squadID = Cups_GetPlayersPCupData( player, cupEntry.cupID ).squadID
						if ( squadID.len() > 0 )
						{
							UserCupEntryData cupEntryData = Cups_GetPlayersPCupData( player, cupEntry.cupID )

							if( cupEntryData.numMatches >= cupData.numMatches ) continue // this player has already completed this cup

							if( !( squadID in fileLevel.squadCupScores ) )
							{
								CupMatchTracking newMatchTracking
								newMatchTracking.cupID = cupEntry.cupID
								newMatchTracking.numMembersInSquad = 1
								fileLevel.squadCupScores[ squadID ] <- newMatchTracking
								squadRequests[ squadID ] <- cupEntry.cupID
								querySquads = true
								break
							}
						}
					}
				}
			}
		}
		else
                          
		{
			//We only need a single players cup entries as the whole registered squad needs to be match for it to count and solo cups don't count when you're in squad.
			foreach ( UserCupEntryData cupEntry in Cups_GetPlayersFullPCupData( squad[0] ) )
			{
				if( !Cups_IsValidCupID( cupEntry.cupID ) ) continue

				CupBakeryAssetData cupData = Cups_GetCupBakeryAssetDataFromGUID( cupEntry.cupID )

				if( squad.len() != cupData.squadSize ) continue
				if( !Cups_IsCupGameMode( cupEntry.cupID ) ) continue
				if( !CalEvent_IsActive( cupData.containerItemFlavor, GetUnixTimestamp() ) ) continue

				string squadID = Cups_GetCupSquadIDFromSquad( cupEntry.cupID, squad )
				if ( squadID.len() > 0 )
				{
					UserCupEntryData cupEntryData = Cups_GetPlayersPCupData( squad[0], cupEntry.cupID )

					if( cupEntryData.numMatches >= cupData.numMatches ) continue // Squad has already completed this cup

					if( !( squadID in fileLevel.squadCupScores ) )
					{
						CupMatchTracking newMatchTracking
						newMatchTracking.cupID = cupEntry.cupID
						newMatchTracking.numMembersInSquad = squad.len()
						fileLevel.squadCupScores[ squadID ] <- newMatchTracking
						squadRequests[ squadID ] <- cupEntry.cupID
						querySquads = true
					}
				}
			}
		}
	}
	if( querySquads )
	{
		// Grab full cup data of eligible players to confirm cup game eligibility
		//CupsGetMatchesPlayedForUsers( squadRequests )
	}
}

void function Cups_OnPlayerMatchParticipationEnded( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) || !Cups_IsMatchValidForCups() )
		return
	CupMatchTracking ornull cupMatchData = Cups_GetCupMatchTrackingDataForPlayer( player )
	if( cupMatchData == null )
		return
	printt("Cups_OnPlayerMatchParticipationEnded")

	expect CupMatchTracking(cupMatchData)

	CupBakeryAssetData cup = Cups_GetCupBakeryAssetDataFromGUID( cupMatchData.cupID )
	int matchCount = cupMatchData.prevNumMatchesCompleted + 1

	// Store cupID & matchNum in persistance for display on match summary screen
	string persistentDataKey = "cupsLastMatchPlayed"
	player.SetPersistentVar( persistentDataKey+".cupID", cupMatchData.cupID )
	player.SetPersistentVar( persistentDataKey+".matchNum", matchCount )

	int persistenceDataIndex = Cups_GetPlayersPDataIndexForCupID( player, cupMatchData.cupID )
	if ( persistenceDataIndex < 0 )
	{
		Warning( "Unable to update cup entry persistence. Invalid cups persistence index." )
	}
	else
	{
		persistentDataKey = format( "cups[%d]", persistenceDataIndex )
		player.SetPersistentVar( persistentDataKey+".numMatches", matchCount )

		// Clear Cup "seen" in the UI if we just finished our last match, to get the new tag back
		if ( matchCount == cup.numMatches )
			player.SetPersistentVar( persistentDataKey+".uiSeen", false )
	}

	CupsPlayerMatchSummary playerSummary
	playerSummary.playerLegendName = ItemFlavor_GetCharacterRef( LoadoutSlot_GetItemFlavor( ToEHI( player ), Loadout_Character() ) )
	//playerSummary.playerUID = player.GetPlayerUID()
	//playerSummary.playerHardware = player.GetHardwareName()


	// Add player stats to fileLevel playerSummary
	foreach ( CupStatPoints statPointData in cup.statPoints )
	{
		StatEntry statEntry = GetStatEntryByRef( statPointData.statRef )
		int startValue = GetStat_Int( player, statEntry, eStatGetWhen.START_OF_CURRENT_MATCH )
		int endValue = GetStat_Int( player, statEntry, eStatGetWhen.CURRENT )

		int statChange = endValue - startValue
		int additionalScore = minint( statChange, statPointData.hasStatLimit ? statPointData.statLimit : statChange )
		additionalScore = int( floor( additionalScore * statPointData.pointsRate ) )

		CupsMatchStatInformation statInfo
		statInfo.statRef = statPointData.statRef
		statInfo.statChange = statChange
		statInfo.pointsGained = additionalScore

		cupMatchData.squadPointsGained += statInfo.pointsGained

		playerSummary.statInformation.push( statInfo )
	}

	cupMatchData.matchSummaryData.playerSummaries.push( playerSummary )

	cupMatchData.numMembersEliminated++
	if( cupMatchData.numMembersEliminated == cupMatchData.numMembersInSquad )
	{
		for ( int i = 0; i < cupMatchData.matchSummaryData.playerSummaries.len(); i++ )
		{
			cupMatchData.matchSummaryData.playerSummaries[i].playerPlacement = Survival_GetCurrentRank( player )
			int placementScore = Cups_GetPointsForPlacement( cup, Survival_GetCurrentRank( player ) )
			cupMatchData.squadPointsGained += placementScore
		}
		//TODO: Ensure working with duos & trios
		//CupsSetMatchResultsData( player, cupMatchData.cupID, cupMatchData.squadPointsGained, cupMatchData.prevNumMatchesCompleted + 1, cupMatchData.matchSummaryData.playerSummaries )
	}
}

CupMatchTracking ornull function Cups_GetCupMatchTrackingDataForPlayer( entity player )
{
	if( !GetConVarBool( "cups_enabled" ) || !Cups_IsMatchValidForCups() )
		return null

	array<UserCupEntryData> usersRegisteredCupData = Cups_GetPlayersFullPCupData( player )
	foreach( UserCupEntryData userEntryData in usersRegisteredCupData )
	{
		if ( userEntryData.squadID in fileLevel.squadCupScores && userEntryData.cupID == fileLevel.squadCupScores[ userEntryData.squadID ].cupID )
			return fileLevel.squadCupScores[ userEntryData.squadID ]
	}

	return null
}

CupsPlayerMatchSummary ornull function CupMatchTracking_GetPlayerSummary( CupMatchTracking matchTracking, entity player )
{
	foreach ( CupsPlayerMatchSummary playerSummary in matchTracking.matchSummaryData.playerSummaries )
	{

	}

	Warning( "matchTracking struct does not contain summary for player: " + player )
	return null
}

void function ClientCallback_ReRollCup( entity player, SettingsAssetGUID cupID )
{
	if( !GetConVarBool( "cups_enabled" ) || !Cups_IsValidCupID( cupID ) || !GRX_IsInventoryReady( player ) )
		return

	thread _ReRollCupThread( player, cupID )
}

void function _ReRollCupThread( entity player, SettingsAssetGUID cupID )
{
	Assert( IsNewThread() )

	CupBakeryAssetData cup = Cups_GetCupBakeryAssetDataFromGUID( cupID )

	if( cup.maximumNumberOfReRolls < 1 )
		return

	while( !GRX_IsInventoryReady( player ) )
		WaitFrame()

	int numReRollTokens = maxint( GRX_GetConsumableCount( player, ItemFlavor_GetGRXIndex( cup.reRollToken ) ), 0 )
	if ( numReRollTokens > cup.maximumNumberOfReRolls )
		return

	UserCupEntryData pData = Cups_GetPlayersPCupData( player, cupID )
	if( pData.cupID == cupID )
	{
		string squadID = pData.squadID
		Cups_Register_OnGetReRollCount_Callback( bool function( SettingsAssetGUID cupID, string squadID, int reRollCount ) : (player, numReRollTokens, pData) {
			if ( !IsValidPlayer( player ) ) // Cancel rerolling when the player is disconnected. This will be call the next time player clicks the reroll button.
				return true

			if ( pData.cupID != cupID || pData.squadID != squadID )
				return false
			if( reRollCount < numReRollTokens )
			{
				//CupsRerollCup( player, pData.cupID, pData.squadID )
				ClearPersistenceForReroll( player, pData.cupID )
			}
			return true
		} )
		//CupsGetReRollCount( pData.cupID, pData.squadID )
	}
}

void function ClearPersistenceForReroll( entity player, int cupID )
{
	for( int i = 0; i < MAX_REGISTERED_CUPS; i++ )
	{
		string persistentDataKey = format( "cups[%d]", i )
		bool cupIsActive = expect bool( player.GetPersistentVar( persistentDataKey+".active" ) )
		if( cupIsActive && cupID == player.GetPersistentVarAsInt( persistentDataKey+".cupID" ) )
		{
			player.SetPersistentVar( persistentDataKey+".numMatches", 0 )
			player.SetPersistentVar( persistentDataKey+".score", 0 )
			break
		}
	}
}

void function Cups_Register_OnGetReRollCount_Callback(bool functionref(SettingsAssetGUID/* cupID*/, string/* squadID*/, int/* reRollCount*/) callback)
{
	Assert( !fileLevel.cupReRollCountCallbacks.contains( callback ), "Attempting to re-register OnGetReRollCount callback!" )
	fileLevel.cupReRollCountCallbacks.append( callback )
}

void function Cups_UnRegister_OnGetReRollCount_Callback(bool functionref(SettingsAssetGUID/* cupID*/, string/* squadID*/, int/* reRollCount*/) callback)
{
	fileLevel.cupReRollCountCallbacks.removebyvalue( callback )
}

void function ClientCallback_GrantAllCupRewards( entity player, SettingsAssetGUID cupID )
{
	if( !GetConVarBool( "cups_enabled" ) || !Cups_IsValidCupID(cupID) )
		return

#if DEV
	CupBakeryAssetData cupData = Cups_GetCupBakeryAssetDataFromGUID( cupID )
	ItemFlavor cupContainerFlav = CupFlavor_GetEvent( cupData.itemFlavor )

	array<int> rewardTiers = []
	for( int index = 0; index < cupData.tiers.len(); index++ )
	{
		rewardTiers.append( index )
	}
	int ladderPosition = 100
	float percentage = 1.5

	GrantCupRewards( player, cupID, ladderPosition, rewardTiers, percentage )
#endif //DEV
}␀