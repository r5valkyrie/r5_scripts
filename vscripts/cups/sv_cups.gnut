global struct CupMatchTracking
{
	int             cupID
	int             numMembersInSquad
	int             previousLeaderboardPosition = 0
	int             numMembersEliminated = 0
	int             prevNumMatchesCompleted = 0
	int             squadPointsGained = 0
	bool            isEligible = true
	CupMatchSummary matchSummaryData
}

struct FileStruct_LifetimeLevel
{
	table< string, CupMatchTracking > squadCupScores
	array<bool functionref(SettingsAssetGUID/* cupID*/, string/* squadID*/, int/* reRollCount*/)> cupReRollCountCallbacks
	table< entity, void functionref() ornull > syncPersistenceCompleteCallbacks
}

FileStruct_LifetimeLevel& fileLevel

void function SvCups_Init()
{
	FileStruct_LifetimeLevel newFileLevel
	fileLevel = newFileLevel

#if DEV && !SP
	AddCallback_GeneratePDef( Cups_GenerateCupsPDef )
#endif
	AddCallback_GameStateEnter( eGameState.Prematch, Cups_OnGameStateEnterPreMatch )
}


#if DEV && !SP
void function Cups_GenerateCupsPDef()
{
	DEV_PDefGen_BeginStruct( "sCupRegistrationData", "The data to save per registered cup" )
	DEV_PDefGen_AddField_Bool( "active" )
	DEV_PDefGen_AddField_GUID( "cupID" )
	DEV_PDefGen_AddField_String( "squadID", 128 )
	DEV_PDefGen_AddField_Int( "score" )
	DEV_PDefGen_AddField_Int( "numMatches" )
	DEV_PDefGen_AddField_Bool( "uiSeen" )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginStruct( "sCupLastMatchPlayedData", "The data to save last cup match played" )
	DEV_PDefGen_AddField_GUID( "cupID" )
	DEV_PDefGen_AddField_Int( "matchNum" )
	DEV_PDefGen_EndStruct()

	DEV_PDefGen_BeginFieldGroup( "cups" )
	DEV_PDefGen_AddField_StructArray_IntKey( "sCupRegistrationData", "cups", MAX_REGISTERED_CUPS )
	DEV_PDefGen_AddField_Struct( "sCupLastMatchPlayedData", "cupsLastMatchPlayed" )
	DEV_PDefGen_AddField_Bool( "seenCupsPopup" )
	DEV_PDefGen_EndFieldGroup()
}
#endif //DEV && !SP

void function ClientCallback_RegisterForCup( entity player, SettingsAssetGUID cupID )
{
	if ( !IsValidItemFlavorGUID( cupID ) )
		return
                     
	//Ranked rumble must be registered through auto-enroll
	ItemFlavor cupFlavor = GetItemFlavorByGUID( cupID )
	if ( !RankedRumble_IsCupRankedRumble( cupFlavor ) )
                          
		Cups_ServerRegisterForCup( player, cupID )
}

void function Cups_ServerRegisterForCup( entity player, SettingsAssetGUID cupID )
{
	if( !GetConVarBool( "cups_enabled" ) ) return
	//TODO: Limitations in Cups_GetSquadEligibility should be moved to here
	//TODO: The cup entry requirement validation of this function only works for solos and only covers account level as cup entry requirement.
	//TODO: For duos & trios as well as other entry reqs future work will be needed to add these checks as part of the party registration consensus

	printt( "Cups_ServerRegisterForCup :" + cupID )
	//if( !Cups_IsValidCupID( cupID ) || !Cups_IsCupActive( cupID ) || !player.IsCrossPlay() )
	//	return

	int nextCupIndex = Cups_GetNextAvailablePersistentDataSlot( player )
	if( nextCupIndex >= 0 )
	{
		CupBakeryAssetData bakeryData = Cups_GetCupBakeryAssetDataFromGUID( cupID )

		// Validate player account level meets minimum cup entry requirement
		if ( bakeryData.entryRestrictions.hasMinLevelLimit )
		{
			int currentXP    = player.GetPersistentVarAsInt( "xp" )
			int currentLevel = GetAccountLevelForXP( currentXP ) + 1 //GetAccountLevelForXP returns 1 less than the displayed level
			if ( bakeryData.entryRestrictions.minEntryLevel > currentLevel )
				return
		}

		string persistentDataKey = format( "cups[%d]", nextCupIndex )
		player.SetPersistentVar( persistentDataKey+".active", true )
		player.SetPersistentVar( persistentDataKey+".cupID", cupID )
		bool isCupRankedRumble = false
		                     
			isCupRankedRumble = RankedRumble_IsCupRankedRumble( bakeryData.itemFlavor )
        
		//CupsRegisterForCup( player, cupID, isCupRankedRumble, ItemFlavor_GetGUID( bakeryData.containerItemFlavor ), bakeryData.entryRestrictions.hasMMREntryRequirement, bakeryData.entryRestrictions.requiredMMRBucket, Ranked_GetStryderLadderNameForLatestRankedPeriod(), bakeryData.tiers )
	}
	//TODO: sbryan R5DEV-515469 Respond to client as we can't add a new registration due to all p-data slots in use.
}

void function CodeCallback_CupsRegistrationCallback( entity player, bool success, int cupID, string squadID )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

	if ( !IsValid( player ) )
		return

	if ( IsDisconnected( player ) )
		return

	int cupIndex = Cups_GetPlayersPDataIndexForCupID( player, cupID )
	Assert( cupIndex >= 0 )

	if( !success )
	{
		ResetPlayerCupPersistence( player, cupIndex )
		return
	}

	string persistentDataKey = format( "cups[%d]", cupIndex )
	player.SetPersistentVar( persistentDataKey+".squadID", squadID )
	player.SetPersistentVar( persistentDataKey+".score", 0 )
	player.SetPersistentVar( persistentDataKey+".numMatches", 0 )
}

void function CodeCallback_CupsOnTierBoundsResponse( SettingsAssetGUID cupID, array< int > tierScoreBounds )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

	printt("Tier Score Bounds Response for cup", cupID)
	for( int i = 0; i < tierScoreBounds.len(); ++i )
	{
		printt( "\t" + (i+1) + ") " + tierScoreBounds[i] )
	}
}

void function CodeCallback_CupsOnMatchesPlayedResponse( table< string, table< string, int > > responseData )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

	printt( "CodeCallback_CupsOnMatchesPlayedResponse" )
	foreach( string squadID, table< string, int > squadResponse in responseData )
	{
		if( squadID in fileLevel.squadCupScores )
		{
			CupMatchTracking squadMatchTracking = fileLevel.squadCupScores[ squadID ]
			CupBakeryAssetData cupData = Cups_GetCupBakeryAssetDataFromGUID( squadMatchTracking.cupID )
			int matchesPlayed = squadResponse["matchesPlayed"]
			if( matchesPlayed < cupData.numMatches )
			{
				// Squad is eligible for cup
				squadMatchTracking.prevNumMatchesCompleted     = matchesPlayed
				squadMatchTracking.previousLeaderboardPosition = squadResponse["currentLeaderboardPosition"]
			}
			else
			{
				squadMatchTracking.isEligible = false
			}
		}
	}
}

void function CodeCallback_CupsOnUserRewardTiersResponse( entity player, SettingsAssetGUID cupID, int ladderPosition, array< int > rewardTiers, float percentage )
{
	if( !GetConVarBool( "cups_enabled" ) )
		return

	if ( !Cups_IsValidCupID(cupID) )
		return

	printt( "CodeCallback_CupsOnUserRewardTiersResponse" )

	GrantCupRewards( player, cupID, ladderPosition, rewardTiers, percentage )
}

void function GrantCupRewards( entity player, SettingsAssetGUID cupID, int ladderPosition, array< int > rewardTiers, float percentage )
{
	if( !GRX_IsInventoryReady( player ) )
		return

	CupBakeryAssetData cupData = Cups_GetCupBakeryAssetDataFromGUID( cupID )
	string sequenceName = CupEvent_GetRewardSequenceName( CupFlavor_GetEvent( cupData.itemFlavor ) )
	int sequenceNumber = GRX_GetSequenceNumber( player, sequenceName )
	if( sequenceNumber > 0 ) // Already received cup rewards, but still need to handle ranked badge
	{
		                     
			RankedRumble_SetBadgeTier( player, cupData, ladderPosition, rewardTiers, percentage )
        
		return
	}
	if( sequenceNumber == GRX_INVALID_SEQUENCE_NUMBER )
	{
		#if DEV
			Assert( false, sequenceNumber + " is not a valid reward sequence" )
		#endif
		return
	}

	table< ItemFlavor, int > bagContents
	for( int i = 0; i < rewardTiers.len(); ++i )
	{
		foreach( CupTierRewardData rewardData in cupData.tiers[rewardTiers[i]].rewardData )
		{
			ItemFlavor rewardFlavor = GetItemFlavorByAsset( rewardData.reward )
			if( rewardFlavor in bagContents )
				bagContents[ rewardFlavor ] += rewardData.quantity
			else
				bagContents[ rewardFlavor ] <- rewardData.quantity
		}
	}
	                     
		if ( RankedRumble_IsContainerRankedRumble( cupData.containerItemFlavor ) )
		{
			bagContents[expect ItemFlavor( RankedRumble_GetBadge( cupData.containerItemFlavor ) )] <- 1
		}
       

	ItemFlavorBag rewardsToGive = MakeItemFlavorBag( bagContents )

	// Grant Rewards
	GrantRewardsConfig grc
	grc.what = rewardsToGive
	grc.showCeremony = true

	// Reward Sequence
	grc.rewardSequenceName = sequenceName
	grc.rewardSequenceExpectedIdx = 0
	grc.rewardSequenceDesiredIdx = 1
	                     
	grc.onAsyncGrantRewardComplete = void function( bool wasSuccessful ) : ( player, cupData, ladderPosition, rewardTiers, percentage ) {
		if ( wasSuccessful )
			RankedRumble_SetBadgeTier( player, cupData, ladderPosition, rewardTiers, percentage )
	}
       

	GRX_GrantRewards( player, grc )
}

void function CodeCallback_CupsOnGetReRollCountResponse( SettingsAssetGUID cupID, string squadID, int reRollCount )
{
	foreach ( bool functionref(SettingsAssetGUID/* cupID*/, string/* squadID*/, int/* reRollCount*/) cb in fileLevel.cupReRollCountCallbacks )
	{
		if( cb(cupID, squadID, reRollCount ) )
			Cups_UnRegister_OnGetReRollCount_Callback( cb )
	}
}

//Debug command to populate Match History with random stat data
void function ClientCallback_SetCupMatchHistory( entity player, SettingsAssetGUID cupID, int matchNumber, int squadPlacement  )
{
	if( !GetConVarBool( "cups_enabled" ) ) return

#if DEV

	if( !Cups_IsValidCupID( cupID ) )
		return

	int cupIndex = Cups_GetPlayersPDataIndexForCupID( player, cupID )
	if ( cupIndex < 0 )
		return

	CupMatchSummary matchSummary = DEV_GenerateDummyMatchHistory(cupID, squadPlacement, [ player ] )

	CupsSetMatchResultsData( player, cupID, matchSummary.squadCalculatedScore, matchNumber, matchSummary.playerSummaries )

	string persistentDataKey = format( "cups[%d]", cupIndex )
	int numMatchesPlayed = player.GetPersistentVarAsInt( persistentDataKey+".numMatches" )
	if ( matchNumber >= numMatchesPlayed )
	{
		player.SetPersistentVar( persistentDataKey+".numMatches", numMatchesPlayed + 1 )
	}

#endif //DEV
}

