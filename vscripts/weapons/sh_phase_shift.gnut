#if SERVER
void function SetPhaseShiftMover( entity ent, entity mover )
{
	if ( IsValid( ent.e.phaseShiftMover ) )
	{
		ent.e.phaseShiftMover.TransferChildrenTo( mover )
		ent.e.phaseShiftMover.Destroy()
	}

	ent.e.phaseShiftMover = mover
}
#endif