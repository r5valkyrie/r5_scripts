//Create a cloud of gas that stims any player that walks through it
entity function StimGasCloudCreate( vector gasCloudOrigin )
{
	//entity stimGasEnt = CreateInfoTarget( gasCloudOrigin, <0, 0, 0> )
	entity stimGasEnt = CreatePropScript( $"mdl/dev/empty_model.rmdl", gasCloudOrigin )
	float gasCloudRadius = 128
	float gasCloudHeight = 64
	vector gasCloudAngles = <0, 0, 0>
	entity trigger = CreateEntity( "trigger_cylinder" )
	trigger.SetCylinderRadius( gasCloudRadius )
	trigger.SetAboveHeight( gasCloudHeight)
	trigger.SetBelowHeight( 8 )
	trigger.SetOrigin( gasCloudOrigin )
	trigger.SetParent( stimGasEnt, "", true, 0.0 )
	trigger.kv.triggerFilterNpc = "none"
	DispatchSpawn( trigger )
	trigger.SetEnterCallback( StimGasTriggerOnTriggered )

	stimGasEnt.LinkToEnt( trigger )
	StartParticleEffectOnEntity_ReturnEntity( stimGasEnt, GetParticleSystemIndex( STIM_GAS_CLOUD_FX ), FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	thread StimGasSound( stimGasEnt )

	return stimGasEnt
}

void function StimGasSound( entity stimGasEnt )
{
	FlagWait( "GamePlaying" ) //sound doesn't play if gas is spawned on map load
	if ( !IsValid( stimGasEnt ) )
		return
	EmitSoundOnEntity( stimGasEnt, "gastrap_traploop" )
}

void function StimGasCloudDelete( entity stimGasEnt )
{
	array <entity> linkedEnts = stimGasEnt.GetLinkEntArray()
	//shut down fx, delete trigger, sounds, etc
	foreach( ent in linkedEnts )
	{
		if ( IsValid( ent ) )
			ent.Destroy()
	}

	stimGasEnt.Destroy()
}

void function StimGasTriggerOnTriggered( entity trigger, entity ent )
{
	if ( !ent.IsPlayer() )
		return
	entity player = ent

	//HACK: using windTunnelStartTime to track last time player got stimmed
	float stimCooldown
	if ( ( Time() - player.e.windTunnelStartTime ) < 4 )
		return

	player.e.windTunnelStartTime = Time()
	//end any previous stim
	player.Signal( "EndStim" )
	StopSoundOnEntity( player, "pilot_stimpack_deactivate_1P" )
	StopSoundOnEntity( player, "pilot_stimpack_deactivate_3P" )

	EmitSoundOnEntityOnlyToPlayer( player, player, "pilot_stimpack_activate_1P" )
	EmitSoundOnEntityExceptToPlayer( player, player, "pilot_stimpack_activate_3P" )
	//thread StimGasScreenFlash( player )
	StimPlayer( player, 6.0 )

}

void function StimGasScreenFlash( entity player )
{
	if ( !IsAlive( player ) )
		return
	float flashTime = 0.1
	player.EndSignal( "OnDeath" )
	ScreenFade( player, 255, 255, 255, 255, flashTime, flashTime, FFADE_OUT | FFADE_PURGE )
	wait flashTime
	ScreenFade( player, 255, 255, 255, 255, flashTime, flashTime, FFADE_IN | FFADE_PURGE )

}


#else // #if SERVER


//CLIENT
void function StimVisualsEnabled( entity ent, int statusEffect, bool actuallyChanged )
{
	if ( ent != GetLocalViewPlayer() )
		return

	entity player = ent

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	Signal( player, "WreckingBall_CleanupFX" )

	Chroma_StartStimEffect()

	int fxHandle = StartParticleEffectOnEntity( cockpit, s_cockpitFx, FX_PATTACH_ABSORIGIN_FOLLOW, ATTACHMENTID_INVALID )
	thread StimScreenFXThink( player, fxHandle, cockpit )
}

void function StimVisualsDisabled( entity ent, int statusEffect, bool actuallyChanged )
{
	if ( ent != GetLocalViewPlayer() )
		return

	Chroma_EndStimEffect()

	ent.Signal( "EndStim" )
}

void function StimScreenFXThink( entity player, int fxHandle, entity cockpit )
{
	player.EndSignal( "EndStim" )
	player.EndSignal( "OnDeath" )
	cockpit.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( fxHandle )
		{
			if ( !EffectDoesExist( fxHandle ) )
				return

			EffectStop( fxHandle, false, true )
			ScreenFlash( 2, 2, 2, 0.2, 0.2 )
		}
	)

	for ( ;; )
	{
		float velocityX = Length( player.GetVelocity() )

		if ( !EffectDoesExist( fxHandle ) )
			break

		velocityX = GraphCapped( velocityX, 0.0, 360, 5, 200 )
		EffectSetControlPointVector( fxHandle, 1, <velocityX,999,0> )
		WaitFrame()
	}
}





#endif // #else // #if SERVER
