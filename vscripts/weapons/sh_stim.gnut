global function StimShared_Init
global function StimPlayer
global function StimPlayerWithOffhandWeapon

#if SERVER
global function StimGasCloudCreate
global function StimGasCloudDelete
const asset STIM_GAS_CLOUD_FX = $"P_stimgas_sm" // P_smokescreen_FD
#endif // SERVER


const float STIM_EFFECT_DEFAULT_SEVERITY = 0.15	// assuming 'movement_speedboost_extraScale' is 2.0


int s_cockpitFx
int s_headFx
int s_bodyFx
void function StimShared_Init()
{
	s_cockpitFx = PrecacheParticleSystem( $"P_pilot_stim_hld_FP" )
	s_headFx = PrecacheParticleSystem( $"P_stim_3p_head" )
	s_bodyFx = PrecacheParticleSystem( $"P_stim_3p_body" )
	#if SERVER
	PrecacheParticleSystem( STIM_GAS_CLOUD_FX )
	#else
	StatusEffect_RegisterEnabledCallback( eStatusEffect.stim_visual_effect, StimVisualsEnabled )
	StatusEffect_RegisterDisabledCallback( eStatusEffect.stim_visual_effect, StimVisualsDisabled )
	#endif

	RegisterSignal( "EndStim" )
	RegisterSignal( "StopEndlessStim" )
}

void function StimPlayer( entity player, float duration )
{
	StimPlayer_Internal( player, duration, STIM_EFFECT_DEFAULT_SEVERITY, null )
}

void function StimPlayerWithOffhandWeapon( entity player, float duration, entity offhandWeapon )
{
	StimPlayer_Internal( player, duration, STIM_EFFECT_DEFAULT_SEVERITY, offhandWeapon )
}

const float USE_TIME_INFINITE = -1.0
void function StimPlayer_Internal( entity player, float duration, float effectSeverity, entity offhandWeapon )
{
	int endlessStatusEffectHandle = 0
	if ( duration == USE_TIME_INFINITE )
	{
		endlessStatusEffectHandle = StatusEffect_AddEndless( player, eStatusEffect.speed_boost, effectSeverity )
	}
	else
	{
#if CLIENT
		if ( InPrediction() )
#endif
		{
			GivePlayerSettingsMods( player, [ "stim_sprint" ] )
		}
		thread RemovePlayerClassModAfterDuration( player, "stim_sprint", duration )

		StatusEffect_AddTimed( player, eStatusEffect.anti_slow, 0.5, duration + 0.5, 0.5 ) // sound is slightly off
		StatusEffect_AddTimed( player, eStatusEffect.speed_boost, effectSeverity, duration + 0.5, 0.5 ) // sound is slightly off
		StatusEffect_AddTimed( player, eStatusEffect.stim_visual_effect, 1.0, duration, duration )
	}

#if SERVER
	thread StimThink( player, duration, endlessStatusEffectHandle, offhandWeapon )

#else // SERVER
	if ( IsFirstTimePredicted() )
		ScreenFlash( 2, 3.5, 2, 0.15, 0.3 )

	entity cockpit = player.GetCockpit()
	if ( !IsValid( cockpit ) )
		return

	HealthHUD_ClearFX( player )
#endif // else // SERVER
}

void function RemovePlayerClassModAfterDuration( entity player, string mod, float duration )
{
	player.EndSignal( "OnDeath" )

	OnThreadEnd(
		function() : ( player, mod )
		{
			TakePlayerSettingsMods( player, [ "stim_sprint" ] )
		}
	)

	wait duration
}

#if SERVER
void function StimThink( entity player, float duration, int endlessStatusEffectHandle, entity offhandWeapon )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnChangedPlayerClass_ActuallyChanged" )
	player.EndSignal( "EndStim" )
	if ( endlessStatusEffectHandle != 0 )
		player.EndSignal( "StopEndlessStim" )
	player.EndSignal( "BleedOut_OnStartDying" )
	player.EndSignal( "ExtendedUseHolster" )
	player.EndSignal( "RoundEnd")
	player.EndSignal( "OnSyncedMelee" )

	if ( player.IsPlayer() )
	{
		// Do seperate 1P and 3P sounds for this player
		EmitSoundOnEntityOnlyToPlayer( player, player, "octane_stimpack_loop_1P" )
		EmitSoundOnEntityExceptToPlayer( player, player, "octane_stimpack_loop_3P" )
	}
	else
	{
		// It's an NPC to just play the 3P on it
		EmitSoundOnEntity( player, "octane_stimpack_loop_3P" )
	}

	int attachmentIndex = player.LookupAttachment( "HEADFOCUS" )

	entity stimFX = StartParticleEffectOnEntity_ReturnEntity( player, s_headFx, FX_PATTACH_POINT_FOLLOW, attachmentIndex )
	stimFX.SetOwner( player )
	stimFX.kv.VisibilityFlags = (ENTITY_VISIBLE_TO_FRIENDLY | ENTITY_VISIBLE_TO_ENEMY) // not owner only

	int attachmentIndexBody = player.LookupAttachment( "CHESTFOCUS" )

	entity stimBodyFX = StartParticleEffectOnEntity_ReturnEntity( player, s_bodyFx, FX_PATTACH_POINT_FOLLOW, attachmentIndexBody )
	stimBodyFX.SetOwner( player )
	stimBodyFX.kv.VisibilityFlags = (ENTITY_VISIBLE_TO_FRIENDLY | ENTITY_VISIBLE_TO_ENEMY) // not owner only

	OnThreadEnd(
		function() : ( player, stimFX, stimBodyFX, endlessStatusEffectHandle, offhandWeapon )
		{
			if ( !IsValid( player ) )
				return
			if ( IsValid( stimFX ) )
				EffectStop( stimFX )
			if ( IsValid( stimBodyFX ) )
				EffectStop( stimBodyFX )

			//Cancel the stim speed if the ability is interrupted by being knocked down. Don't want to cancel the timed effects early since they're doing their fadeout time.
			if ( IsValid( offhandWeapon ) && (offhandWeapon == player.GetOffhandWeapon( OFFHAND_LEFT )) && offhandWeapon.IsWeaponCharging() && (offhandWeapon.GetWeaponChargeFraction() < 0.98) )
			{
				StatusEffect_StopAllOfType( player, eStatusEffect.anti_slow )
				StatusEffect_StopAllOfType( player, eStatusEffect.speed_boost )
				StatusEffect_StopAllOfType( player, eStatusEffect.stim_visual_effect )
				offhandWeapon.SetWeaponChargeFraction( 1 )
				offhandWeapon.SetWeaponPrimaryClipCount( 0 )
			}

			StopSoundOnEntity( player, "octane_stimpack_loop_1P" )
			StopSoundOnEntity( player, "octane_stimpack_loop_3P" )

			if ( endlessStatusEffectHandle != 0 )
				StatusEffect_Stop( player, endlessStatusEffectHandle )

			player.Signal( "EndStim" )
		}
	)

	if ( duration == USE_TIME_INFINITE )
		WaitForever()

	wait duration - 2.0

	if ( player.IsPlayer() )
	{
		EmitSoundOnEntityOnlyToPlayer( player, player, "octane_stimpack_deactivate_1P" )
		EmitSoundOnEntityExceptToPlayer( player, player, "octane_stimpack_deactivate_3P" )
	}
	else
	{
		StopSoundOnEntity( player, "octane_stimpack_deactivate_3P" )
	}

	wait 2.0
}



