bool function PickupMainWeapon( entity pickup, entity player, int pickupFlags = 0, entity deathBox = null )
{
	array<entity> primaryWeapons = SURVIVAL_GetPrimaryWeapons( player )
               
                                                                                         
                                                                                                                                                                              
	     
		bool doDropCurrentWeapon     = (pickupFlags & PICKUP_FLAG_FROM_MENU) > 0 && primaryWeapons.len() > 1
       
	bool dontSwitchWeapon        = (pickupFlags & PICKUP_FLAG_DONT_SWITCH_WEAPONS) > 0

	return GiveMainWeapon_Internal( pickup, player, doDropCurrentWeapon, false, deathBox, dontSwitchWeapon )
}


bool function SwapMainWeapon( entity pickup, entity player, int pickupFlags = 0, entity deathBox = null, bool toSling = false )
{
	return GiveMainWeapon_Internal( pickup, player, true, true, deathBox, false, toSling )
}

bool function GiveMainWeapon_Internal( entity pickup, entity player, bool dropCurrentWeapon, bool doPickupPrint, entity deathBox, bool dontSwitchWeapon, bool isSlingWeapon = false )
{
	entity activeWeapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )

	if ( activeWeapon != null )
	{
		if ( activeWeapon.IsDiscarding() )
			return false

		if ( activeWeapon.IsWeaponOffhand() )
		{
			var offhandAllowsPickups = activeWeapon.GetWeaponInfoFileKeyField( "offhand_allow_player_interact" )
			if ( !offhandAllowsPickups || offhandAllowsPickups <= 0 )
				return false
		}
	}

	if( isSlingWeapon )
	{
		if ( !dropCurrentWeapon && !IsPlayerWeaponSlingEmpty( player ) )
			return false
	}
	else
	{
		array<entity> primaryWeapons = SURVIVAL_GetPrimaryWeapons( player )
                
                                                                                         
                                                                                                                               
		     
		if ( !dropCurrentWeapon && primaryWeapons.len() > 1 )
        
			return false
	}

	// this means your weapons are disabled
	if ( dropCurrentWeapon && !IsValid( activeWeapon ) )
		return false

	if ( GetCurrentPlaylistVarBool( "enable_pickup_check_fix", true ) )
	{
		if ( dropCurrentWeapon && !SURVIVAL_PlayerAllowedToPickup( player ) )
			return false
	}

	#if SERVER
		LootData pickupData = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )

		array<string> lootTags = pickupData.lootTags

		bool doFirstDeploy = SURVIVAL_CountPrimaryWeapons( player ) <= 0 || !isSlingWeapon
		SURVIVAL_GiveMainWeapon( player, pickup, lootTags, activeWeapon, dropCurrentWeapon, deathBox, doPickupPrint, dontSwitchWeapon, [], doFirstDeploy, isSlingWeapon )
	#endif

	return true
}


bool function PickupGroundEquipment( entity pickup, entity player, int pickupFlags = 0, entity deathBox = null )
{
	LootData data   = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )
	string ref      = data.ref
	LootTypeData lt = GetLootTypeData( data.lootType )
	return EquipEquipment( pickup, player, lt.equipmentSlot, deathBox )
}


bool function EquipEquipment( entity pickup, entity player, string equipSlot, entity deathBox )
{
	LootData newEquipData = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )

	string newEquip       = newEquipData.ref
	LootData oldEquipData = EquipmentSlot_GetEquippedLootDataForSlot( player, equipSlot )
	EquipmentSlot es      = Survival_GetEquipmentSlotDataByRef( equipSlot )

	LootTypeData lt     = GetLootTypeData( newEquipData.lootType )
	LootRef lootRef     = SURVIVAL_CreateLootRef( newEquipData, pickup )
	LootActionStruct as = lt.groundActionFunc( player, lootRef )

	if ( as.action == eLootAction.NONE )
		return false

	#if SERVER
		if ( oldEquipData.ref != "" && !SURVIVAL_EquipmentPretendsToBeBlank( oldEquipData.ref ) )
		{
			vector origin = GetThrowOrigin( player )
			vector fwd    = AnglesToForward( player.EyeAngles() )

			//Create tracking event for players with tracking passive.
			if ( es.trackingVisionExchangePOI != -1 )
				TrackingVision_CreatePOI( es.trackingVisionExchangePOI, player, pickup.GetOrigin(), player.GetTeam(), player )

			                    
			if( UpgradeCore_IsEquipmentArmorCore( oldEquipData.ref ) && oldEquipData.lootType == eLootType.ARMOR )
			{
				int shieldAmount = SURVIVAL_GetPlayerShieldHealthFromArmor( player ) + GetPlayerExtraShields( player )
				int tier = GetShieldTierFromShieldAmount( shieldAmount )
				string newRef = UpgradeCore_GetShieldCoreRefForTier( tier )
				oldEquipData = SURVIVAL_Loot_GetLootDataByRef( newRef )
			}
         

			entity drop = SpawnGenericLoot( oldEquipData.ref, origin )
			SetItemSpawnSource( drop, eSpawnSource.PLAYER_DROP, player )
			BroadcastItemDrop( player, oldEquipData.ref, drop )

			if ( oldEquipData.lootType == eLootType.ARMOR )
			{
				int dropShieldHealth = SURVIVAL_GetPlayerShieldHealthFromArmor( player )

				                    
					dropShieldHealth += GetPlayerExtraShields( player )
					SetPlayerExtraShields( player, 0 )
          

				int extraProperty    = 0

				if ( EvolvingArmor_IsEquipmentEvolvingArmor( oldEquipData.ref ) )
					extraProperty = EvolvingArmor_GetEvolutionProgress( player )

				printf( "LootDebug: Setting dropped Armor health to %i and evoProgress to %i", dropShieldHealth, extraProperty )

				SetPropSurvivalMainPropertyOnEnt( drop, dropShieldHealth )
				SetPropSurvivalExtraPropertyOnEnt( drop, extraProperty )

				                           
				StatsHook_OnArmorSwapped( player, newEquipData, oldEquipData )
          

				drop.AddUsableValue( USABLE_BLOCK_CONTINUOUS_USE )
			}

			if ( oldEquipData.lootType == eLootType.GADGET )
			{
				SetPropSurvivalMainPropertyOnEnt( drop, Inventory_GetSurvivalPropertyValueForEquipment( player, equipSlot ) )
				drop.SetClipCount( Inventory_GetSurvivalPropertyValueForEquipment( player, equipSlot ) ) //solves REPLACE case - giving proper update
			}

			if ( oldEquipData.lootType == eLootType.INCAPSHIELD )
			{
				PassiveAxiom_OnItemDropped( player, oldEquipData.ref, drop )
			}

			if ( IsValid( deathBox ) && deathBox.GetTargetName() == DEATH_BOX_TARGETNAME )
			{
				AddToDeathBox( drop, deathBox )
			}
			else
			{
				FakePhysicsThrow( player, drop, fwd * 100, true )
			}
		}
		else
		{
			//Create tracking event for players with tracking passive.
			TrackingVision_CreatePOI( es.trackingVisionPickupPOI, player, pickup.GetOrigin(), player.GetTeam(), player )
		}

		int evoProgress = 0
		if ( EvolvingArmor_IsEquipmentEvolvingArmor( newEquipData.ref ) )
			evoProgress = GetPropSurvivalExtraPropertyFromEnt( pickup )

		SURVIVAL_GivePlayerEquipment( player, newEquip, GetPropSurvivalMainPropertyFromEnt( pickup ), deathBox, equipSlot, true, GetPropSurvivalExtraPropertyFromEnt( pickup ) )

		if ( EvolvingArmor_IsEquipmentEvolvingArmor( newEquipData.ref ) )
			EvolvingArmor_SetEvolutionProgress( player, GetPropSurvivalExtraPropertyFromEnt( pickup ) )
	#endif

	                         
		if ( newEquip == "helmet_pickup_lv5_sunglasses" )
		{
			Heatwave_OnSunglassesPickup(player)
		}
                                 

	return true
}

bool function ExtendedSwap( entity pickup, entity player, void functionref( entity, entity, ExtendedUseSettings ) successFunc, int pickupFlags = 0, entity deathBox = null, bool toSling = false )
{
	LootData data   = SURVIVAL_Loot_GetLootDataByIndex( pickup.GetSurvivalInt() )
	ExtendedUseSettings settings

	#if CLIENT
		settings.loopSound = "UI_Survival_PickupTicker"
		//Audio is not needed on loot swap as audio is playing from the item being picked up - Anthony to fix later
		//settings.successSound = data.pickupSound_1p
		settings.successPlayPickupEffect = true
		settings.displayRui = $"ui/extended_use_hint.rpak"
		settings.displayRuiFunc = DisplayRuiForMainWeaponSwap
		settings.icon = $""
		settings.hint = toSling ? "#SWAP_EXTENDED_USE": SURVIVAL_GetStringForLootAction( eLootAction.SWAP )
		settings.holdHint = toSling ? "%use_alt%" : "%use_long%"
		settings.successFunc = MarkAsUsed
	#else
		settings.successSound = data.pickupSound_3p
		settings.entityArg = deathBox
	#endif
	settings.successFunc = successFunc
	settings.duration = 0.3
	settings.useInputFlag = toSling ? IN_USE_ALT : IN_USE_LONG

	thread ExtendedUse( pickup, player, settings )

	return false
}


void function ExtendedTrySwapWeapon( entity ent, entity player, ExtendedUseSettings settings )
{
	#if SERVER
		entity deathBox = settings.entityArg
		entity slingWeapon = GetPlayerSlingWeapon( player )

		if ( SwapMainWeapon( ent, player, 0, deathBox, IsPlayerHoldingSlingWeapon( player ) ) )
		{
			SURVIVAL_PlayerPickedupItem( ent, player, 1, eLootAction.EQUIP, 0 )

			if( IsValid( slingWeapon ) && slingWeapon != GetPlayerSlingWeapon( player ) )
				UpdateWeaponSlingEquipmentSlot( player )
		}
	#else
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )
		PlayLootPickupFeedbackFX( ent )
		//Audio is not needed on loot swap as audio is playing from the item being picked up - Anthony to fix later
		//EmitSoundOnEntity( player, data.pickupSound_1p )
	#endif
}


void function ExtendedTrySwapEquipment( entity ent, entity player, ExtendedUseSettings settings )
{
	#if SERVER
		entity deathBox = settings.entityArg
		if ( PickupGroundEquipment( ent, player, 0, deathBox ) )
			SURVIVAL_PlayerPickedupItem( ent, player, 1, eLootAction.EQUIP, 0 )
	#else
		LootData data = SURVIVAL_Loot_GetLootDataByIndex( ent.GetSurvivalInt() )
		PlayLootPickupFeedbackFX( ent )
		//Audio is not needed on loot swap as audio is playing from the item being picked up - Anthony to fix later
		//EmitSoundOnEntity( player, data.pickupSound_1p )
	#endif
}

#if CLIENT
void function DisplayRuiForMainWeaponSwap( entity ent, entity player, var rui, ExtendedUseSettings settings )
{
	RuiSetString( rui, "holdButtonHint", settings.holdHint )
	RuiSetString( rui, "hintText", settings.hint )
	RuiSetGameTime( rui, "startTime", Time() )
	RuiSetGameTime( rui, "endTime", Time() + settings.duration )
}

void function MarkAsUsed( entity ent, entity player, ExtendedUseSettings settings )
{
	ent.e.lastUseTime = Time()
}
#endif