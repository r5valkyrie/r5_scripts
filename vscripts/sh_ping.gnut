// ----- Capture Objective Pings
// These are Pings that function a little differently from normal pings.
// First, a ping is created on each objective for each team or alliance in the mode ( this allows players to ping the objective through walls, and allows the base ping to be owned by the mode not the player )
// When players ping an objective it counts how many players from each team or alliance have pinged it to let them know how many players are going for that objective
// When objective states change the pings are destroyed and re-created for the new objective state ( defend or attack )
// The objectives can be pinged by pinging the in world representation of the capture point ( flag in Control for example ) as well as the objective icon ( in world and from the map )

#if SERVER || CLIENT
bool function CaptureObjectivePing_IsUsingCaptureObjectivePings()
{
	return GetCurrentPlaylistVarBool( "is_using_capture_objective_pings", false )
}
#endif // SERVER || CLIENT

#if SERVER
// Create starter pings on an objective ( this is a system made ping that players can then ping so the objectives can be pinged through walls )
void function CaptureObjectivePing_CreateStarterPingsOnObjective( entity objectiveWaypoint, entity pingTraceBlocker, int startingPingType = ePingType.PING_CAPTURE_OBJECTIVE_ATTACK, vector pingOffset = < 0, 0, 0 > )
{
	if ( !IsValid( pingTraceBlocker ) )
	{
		Assert( false, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " running with invalid pingTraceBlocker, no ping will be created. Use CaptureObjectivePing_CreateObjectivePingTraceBlocker to generate a pingTraceBlocker for the objective" )
		return
	}

	bool isUsingAlliances = AllianceProximity_IsUsingAlliances()
	int firstTeamOrAllianceIndex = isUsingAlliances ? ALLIANCE_A : TEAM_MULTITEAM_FIRST
	int teamOrAllianceIndexMax = isUsingAlliances ? ALLIANCE_A + AllianceProximity_GetMaxNumAlliances() : TEAM_MULTITEAM_FIRST + MAX_TEAMS

	for ( int index = firstTeamOrAllianceIndex; index < teamOrAllianceIndexMax; index++ )
	{
		CaptureObjectivePing_CreateStarterPingOnObjectiveForTeamOrAlliance( objectiveWaypoint, pingTraceBlocker, index, startingPingType, pingOffset )
	}
}
#endif // SERVER

#if SERVER
// Create a starter ping on an objective for a specific team or alliance ( this is a system made ping that players can then ping so the objectives can be pinged through walls )
void function CaptureObjectivePing_CreateStarterPingOnObjectiveForTeamOrAlliance( entity objectiveWaypoint, entity pingTraceBlocker, int teamOrAlliance, int startingPingType = ePingType.PING_CAPTURE_OBJECTIVE_ATTACK, vector pingOffset = < 0, 0, 0 > )
{
	if ( !IsValid( pingTraceBlocker ) )
	{
		Assert( false, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " running with invalid pingTraceBlocker, no ping will be created. Use CaptureObjectivePing_CreateObjectivePingTraceBlocker to generate a pingTraceBlocker for the objective" )
		return
	}

	bool isUsingAlliances = AllianceProximity_IsUsingAlliances()
	int team = isUsingAlliances ? AllianceProximity_GetRepresentativeTeamForAlliance( teamOrAlliance ) : teamOrAlliance
	entity starterPing = CreateWaypoint_Objective_StarterPing( startingPingType, pingTraceBlocker, objectiveWaypoint.GetOrigin() + pingOffset, team )
	file.captureObjectivePingStarterPings.append( starterPing )
	AddEntityDestroyedCallback( starterPing, CaptureObjectivePing_OnObjectiveStarterPingDestroyed )
}
#endif // SERVER

#if SERVER
// Destroy a Capture Objective Starter Ping and ensure it gets removed from the array tracking the pings
void function CaptureObjectivePing_DestroyStarterPingOnObjective( entity pingToDestroy )
{
	if ( IsValid( pingToDestroy ) )
	{
		file.captureObjectivePingStarterPings.fastremovebyvalue( pingToDestroy )
		pingToDestroy.Destroy()
	}
}
#endif // SERVER

#if SERVER
// Create a traceblocker for objective pings so players can ping objective markers directly in world
const vector TRACEBLOCKER_HEIGHT_OFFSET = < 0 ,0, 100 >
entity function CaptureObjectivePing_CreateObjectivePingTraceBlocker( entity wp, vector traceblockerBoxMins, vector traceblockerBoxMaxs, string objectiveWaypointScriptName, bool drawDebug = false )
{
	entity traceBlocker = null
	if ( IsValid( wp ) )
	{
		// Need a parent entity for pings. Also allow players to ping the in world representation of the objective marker directly.
		traceBlocker = CreateTraceBlockerVolume( wp.GetOrigin() - TRACEBLOCKER_HEIGHT_OFFSET, 30, true, CONTENTS_NOGRAPPLE | CONTENTS_NOCLIMB | CONTENTS_BLOCK_PING, TEAM_MILITIA, objectiveWaypointScriptName, wp )
		traceBlocker.SetBox( traceblockerBoxMins, traceblockerBoxMaxs )
		traceBlocker.SetOwner( wp )

		#if DEVELOPER
			if ( drawDebug )
				DebugDrawBox( traceBlocker.GetOrigin(), traceblockerBoxMins, traceblockerBoxMaxs, 0, 0, 255, 1, 90.0 )
		#endif // DEV
	}

	return traceBlocker
}
#endif // SERVER

#if CLIENT
// Filter out created waypoints to manage an array of objective starter pings on the Client.
void function CaptureObjectivePing_OnPlayerWaypointCreated( entity wp )
{
	if ( IsValid( wp ) && wp.GetWaypointType() == eWaypoint.PING_LOCATION && IsValid( wp.GetOwner() ) )
	{
		entity objectiveWaypoint = wp.GetOwner()

		if ( objectiveWaypoint.GetNetworkedClassName() != PLAYER_WAYPOINT_CLASSNAME )
			return

		if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) && !file.captureObjectivePingStarterPings.contains( wp ) )
			file.captureObjectivePingStarterPings.append( wp )
	}
}
#endif // CLIENT

#if CLIENT
// Filter out destroyed waypoints to manage an array of objective starter pings on the Client.
void function CaptureObjectivePing_OnPlayerWaypointDestroyed( entity wp )
{
	if ( IsValid( wp ) && wp.GetWaypointType() == eWaypoint.PING_LOCATION && IsValid( wp.GetOwner() ) && file.captureObjectivePingStarterPings.contains( wp ) )
		file.captureObjectivePingStarterPings.fastremovebyvalue( wp )
}
#endif // CLIENT

#if SERVER || CLIENT
// Get an array of the objective pings created by script that are used by players to ping objectives
array < entity > function CaptureObjectivePing_GetStarterPingsArray()
{
	return file.captureObjectivePingStarterPings
}
#endif // SERVER || CLIENT

#if SERVER || CLIENT
// Set the function to be used to determine if a waypoint is a Capture Objective Ping Objective Waypoint
void function CaptureObjectivePing_AddCallback_SetIsCaptureObjectivePingObjectiveWaypoint( bool functionref( entity ) func )
{
	file.getIsCaptureObjectivePingObjectiveWPFunction = func
}
#endif // SERVER || CLIENT

#if SERVER || CLIENT
// Determine if the comms action is related to a Capture Objective Ping
bool function CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( entity waypoint )
{
	if ( file.getIsCaptureObjectivePingObjectiveWPFunction == null )
	{
		Assert( false, "CAPTURE OBJECTIVE PING: Running " + FUNC_NAME() + " with no function defined to check if a waypoint is an objective waypoint, make sure a function is set using CaptureObjectivePing_AddCallback_SetIsCaptureObjectivePingObjectiveWaypoint" )
		return false
	}

	return file.getIsCaptureObjectivePingObjectiveWPFunction( waypoint )
}
#endif // SERVER || CLIENT

#if SERVER
// Track created Objective Pings to keep an updated count of the pings
void function CaptureObjectivePing_OnObjectivePinged( entity player, entity wp, entity pingEnt, int pingType )
{
	if ( !IsValid( pingEnt ) || !IsValid( player ) || !IsValid( wp )  )
		return

	entity objectiveWaypoint = pingEnt.GetOwner()
	if ( !IsValid( objectiveWaypoint ) )
		return

	if ( objectiveWaypoint.GetClassName() != PLAYER_WAYPOINT_CLASSNAME )
		return

	int waypointTeam = wp.GetTeam()
	int waypointTeamOrAlliance = AllianceProximity_IsUsingAlliances() ? AllianceProximity_GetAllianceFromTeam( waypointTeam ) : waypointTeam
	int playerTeam = player.GetTeam()

	// Do different team validity checks depending on if this is an alliance based mode or a squad based mode
	if ( AllianceProximity_IsUsingAlliances() )
	{
		// Make sure the team of the waypoint is defined in an alliance, unexpected teams will crash the game.
		if ( !AllianceProximity_IsTeamInAnAlliance( wp.GetTeam() ) )
			return
	}
	else
	{
		// Make sure the team of the waypoint is valid and matches the players team
		if ( waypointTeam < TEAM_MULTITEAM_FIRST || waypointTeam >= TEAM_MULTITEAM_FIRST + MAX_TEAMS || waypointTeam != playerTeam )
			return
	}

	if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
	{
		if ( player in file.playerToCaptureObjectivePingTable )
		{
			entity oldPing = file.playerToCaptureObjectivePingTable[ player ]
			if ( IsValid( oldPing ) )
			{
				if ( oldPing == wp )
				{
					Remote_CallFunction_NonReplay( player, "ServerCallback_CaptureObjectivePing_UpdateLastPingedObjective", player, wp, pingEnt, true )
					CaptureObjectivePing_OnPlayerCancelledObjectivePing( oldPing, player )
					return
				}
				CaptureObjectivePing_OnPlayerCancelledObjectivePing( oldPing, player )
			}
		}

		if ( pingType != ePingType.PING_CAPTURE_OBJECTIVE_ATTACK && pingType != ePingType.PING_CAPTURE_OBJECTIVE_DEFEND )
			return

		Remote_CallFunction_NonReplay( player, "ServerCallback_CaptureObjectivePing_UpdateLastPingedObjective", player, wp, pingEnt, false )
		file.playerToCaptureObjectivePingTable[ player ] <- wp

		// Set the player's personal objective ping status so we can display some text showing it to other players on the same team.
		int objectiveID = CaptureObjectivePing_GetObjectiveIndexFromWaypoint( objectiveWaypoint )
		switch( objectiveID )
		{
			case eCapturePingObjectiveIndex.OBJ_A:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_A )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_A )
				break
			case eCapturePingObjectiveIndex.OBJ_B:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_B )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_B )
				break
			case eCapturePingObjectiveIndex.OBJ_C:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_C )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_C )
				break
			case eCapturePingObjectiveIndex.OBJ_D:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_D )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_D )
				break
			case eCapturePingObjectiveIndex.OBJ_E:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_E )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_E )
				break
			case eCapturePingObjectiveIndex.OBJ_F:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_F )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_F )
				break
			case eCapturePingObjectiveIndex.OBJ_G:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_G )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_G )
				break
			case eCapturePingObjectiveIndex.OBJ_H:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_H )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_H )
				break
			case eCapturePingObjectiveIndex.OBJ_I:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_I )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_I )
				break
			case eCapturePingObjectiveIndex.OBJ_J:
				if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.ATTACK_J )
				else
					{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.DEFEND_J )
				break
			default:
				Assert( false, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " Tried to update ping on unsupported objective ID: " + objectiveID + " supported IDs are 0 to " + ( eCapturePingObjectiveIndex._count - 1 ) )
				break
		}

		int pingCount = 1
		// If this objective already has a ping count being tracked at the teams index in the array of tables, update the count. Otherwise create a table entry at the teams index
		if ( objectiveWaypoint in file.objectiveToCaptureObjectivePingCountTableArray[ waypointTeamOrAlliance ] )
		{
			pingCount = file.objectiveToCaptureObjectivePingCountTableArray[ waypointTeamOrAlliance ][ objectiveWaypoint ]
			pingCount++
			file.objectiveToCaptureObjectivePingCountTableArray[ waypointTeamOrAlliance ][ objectiveWaypoint ] = maxint( pingCount, 0 )
		}
		else
		{
			file.objectiveToCaptureObjectivePingCountTableArray[ waypointTeamOrAlliance ][ objectiveWaypoint ] <- pingCount
		}

		// Make sure the ping count gets updated
		CaptureObjectivePing_UpdatePingCountOnObjective( objectiveWaypoint, waypointTeamOrAlliance )
	}
}
#endif // SERVER

#if SERVER
// ToDo: R5DEV-567005 : Complete refactor to support Capture Objective Pings. There should be a way to keep the count without needing to do server callbacks on respawn. The waypoint should have this info
// Update objective ping counts on the Client when the player respawns ( Client data gets destroyed after kill replay )
void function CaptureObjectivePing_OnPlayerPostRespawned( entity player )
{
	if ( !IsValid( player ) )
		return

	int playerTeamOrAlliance = AllianceProximity_IsUsingAlliances() ? AllianceProximity_GetAllianceFromTeam( player.GetTeam() ) :  player.GetTeam()

	if ( file.objectiveToCaptureObjectivePingCountTableArray.len() > playerTeamOrAlliance )
	{
		// Update ping counts for each objective
		foreach ( objective, pingCountForObjective in file.objectiveToCaptureObjectivePingCountTableArray[ playerTeamOrAlliance ] )
		{
			CaptureObjectivePing_UpdatePingCountOnObjective( objective, playerTeamOrAlliance, player )
		}
	}
}
#endif // SERVER

#if CLIENT
// Add a callback function to trigger when the ping count changes on an objective
void function CaptureObjectivePing_AddCallback_OnObjectivePingCoundChanged( void functionref( entity, int, int ) callBackFunc )
{
	Assert( !file.onObjectivePingCountChangedCallbackFunctions.contains( callBackFunc ), "Already added " + string( callBackFunc ) + " with " + FUNC_NAME() )
	file.onObjectivePingCountChangedCallbackFunctions.append( callBackFunc )
}
#endif // CLIENT

#if CLIENT || SERVER
// Determine if the player has pinged an objective they already had a ping on
bool function CaptureObjectivePing_DidPlayerPingSameObjective( entity player, entity wp, entity pingEnt )
{
	if ( !IsValid( pingEnt ) || !IsValid( player ) || !IsValid( wp ) )
		return false

	entity objectiveWaypoint = pingEnt.GetOwner()
	if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
	{
		#if CLIENT
			entity oldPing = file.lastLocalCaptureObjectivePing
			if ( IsValid( oldPing ) && oldPing == wp )
				return true
		#endif // CLIENT

		#if SERVER
		if ( player in file.playerToCaptureObjectivePingTable )
		{
			entity oldPing = file.playerToCaptureObjectivePingTable[ player ]
			if ( IsValid( oldPing ) && oldPing == wp )
				return true
		}
		#endif // SERVER
	}
	return false
}
#endif // CLIENT || SERVER

#if CLIENT
// Update the last objective the player pinged locally
void function ServerCallback_CaptureObjectivePing_UpdateLastPingedObjective( entity pingingPlayer, entity wp, entity pingedEnt, bool isDestroying )
{
	entity localPlayer = GetLocalViewPlayer()

	if ( !IsValid( wp ) || !IsValid( pingedEnt ) ||!IsValid( pingingPlayer ) || !IsValid( localPlayer ) )
		return

	if ( pingingPlayer != localPlayer )
		return

	entity objectiveWaypoint = pingedEnt.GetOwner()
	if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
	{
		if ( isDestroying )
			file.lastLocalCaptureObjectivePing = null
		else
			file.lastLocalCaptureObjectivePing = wp
	}
}
#endif // CLIENT

#if CLIENT
// Get the last objective pinged by the local client
entity function CaptureObjectivePing_GetLastPingedObjective()
{
	return file.lastLocalCaptureObjectivePing
}
#endif // CLIENT

#if CLIENT
// Update the text on the objective ping
// ToDo: R5DEV-567005 : Complete refactor to support Capture Objective Pings using Alliances. Investigate a way to combine this with ServerCallback_CaptureObjectivePing_UpdateObjectivePingCounts to avoid double server callbacks
void function ServerCallback_CaptureObjectivePing_UpdateObjectivePingText( entity wp, int pingType, int pingCount, bool doesPlayerHavePingOnObjective )
{
	if ( IsValid( wp ) && IsValid( wp.wp.ruiHud ) && pingCount >= 0 )
	{
		if ( pingType == ePingType.PING_CAPTURE_OBJECTIVE_DEFEND || pingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
		{
			// Update ping text based on whether the player has already pinged the objective and the ping count
			string promptText = ""

			if ( pingCount <= 0 ) // There are no pings on this objective, use Rally Text
			{
				promptText = Localize( "#PROMPT_PING_CONTROL_OBJECTIVE" )
			}
			else // There are pings on this objective
			{
				if ( doesPlayerHavePingOnObjective )
				{
					if ( pingCount == 1 ) // Player has a ping on this objective and there are no other pings, player gets Cancel text
					{
						promptText = Localize( "#PROMPT_CANCELED_PING" )
					}
					else // Player has a ping on this objective and there are other pings, player gets Cancel text with ping count
					{
						promptText = Localize( "#PROMPT_PING_CONTROL_OBJECTIVE_CANCEL", pingCount )
					}
				}
				else // Player doesn't have a ping on this objective and but there are other pings already on it, player gets Join text with ping count
				{
					promptText = Localize( "#PROMPT_PING_CONTROL_OBJECTIVE_JOIN", pingCount )
				}
			}

			promptText = promptText + " `1%ping%`0"
			RuiSetString( wp.wp.ruiHud, "pingPrompt", promptText )
		}
	}
}
#endif // CLIENT

#if CLIENT
// Update ping count for objective pings on the Client
void function ServerCallback_CaptureObjectivePing_UpdateObjectivePingCounts( entity objectiveWaypoint, int teamOrAlliance, int count )
{
	// This should never happen, we resize the array in the Init
	Assert( file.objectiveToCaptureObjectivePingCountTableArray.len() > teamOrAlliance, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " Tried to grab a table of objective pings to ping count for teamOrAlliance: " + teamOrAlliance + " but the array didn't contain the teamOrAlliance index" )
	if ( file.objectiveToCaptureObjectivePingCountTableArray.len() <= teamOrAlliance )
		return

	// Ensure the count is valid
	int pingCountMax = AllianceProximity_IsUsingAlliances() ? AllianceProximity_GetMaxNumPlayersPerAlliance() + 1 : GetExpectedSquadSize() + 1
	if ( count < 0 || count > pingCountMax )
		return

	if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
	{
		file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ] <- count

		foreach ( callbackFunc in file.onObjectivePingCountChangedCallbackFunctions )
		{
			callbackFunc( objectiveWaypoint, teamOrAlliance, count )
		}
	}
}
#endif // CLIENT

#if SERVER
// Trigger an update to the ping text based on the Objective Ping Count
// By default we update the ping count for all player on the team or alliance
// If a player entity is passed in, we only update the ping count for the player
void function CaptureObjectivePing_UpdatePingCountOnObjective( entity objectiveWaypoint, int teamOrAlliance, entity player = null )
{
	if ( !CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
		return

	entity pingToUpdate
	int pingType = ePingType.PING_CAPTURE_OBJECTIVE_ATTACK
	bool isUsingAlliances = AllianceProximity_IsUsingAlliances()
	foreach ( ping in file.captureObjectivePingStarterPings )
	{
		if ( !IsValid( ping ) )
			continue

		int pingTeamOrAlliance = isUsingAlliances ? AllianceProximity_GetAllianceFromTeam( ping.GetTeam() ) : ping.GetTeam()

		if ( pingTeamOrAlliance != teamOrAlliance )
			continue

		int objectiveWaypointPingType = Waypoint_GetPingTypeForWaypoint( ping )
		if ( objectiveWaypointPingType == ePingType.PING_CAPTURE_OBJECTIVE_DEFEND || objectiveWaypointPingType == ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
		{
			if ( IsValid( ping.GetParent() ) && IsValid( ping.GetParent().GetOwner() ) )
			{
				entity pingedObjective = ping.GetParent().GetOwner()
				if ( pingedObjective == objectiveWaypoint )
				{
					pingToUpdate = ping
					pingType = objectiveWaypointPingType
					break
				}
			}
		}
	}

	if ( !IsValid( pingToUpdate ) )
		return

	int pingCount = CaptureObjectivePing_GetPingCountForObjectiveForTeamOrAlliance( objectiveWaypoint, teamOrAlliance )

	// If a player entity was passed into the function we only update the counts for the specified player. Otherwise, update the whole team or alliance
	array < entity > playersToUpdateArray
	if ( IsValid( player ) )
		playersToUpdateArray = [ player ]
	else
		playersToUpdateArray = isUsingAlliances ? AllianceProximity_GetAllPlayersInAlliance( teamOrAlliance, false ) : GetPlayerArrayOfTeam( teamOrAlliance )

	foreach ( entity playerToUpdate in playersToUpdateArray )
	{
		if ( !IsValid( playerToUpdate ) )
			continue

		bool doesPlayerHavePingOnThisObjective = false
		if ( playerToUpdate in file.playerToCaptureObjectivePingTable )
		{
			entity objectivePing = file.playerToCaptureObjectivePingTable[ playerToUpdate ]
			if ( IsValid( objectivePing ) && IsValid( objectivePing.GetParent() ) && IsValid( objectivePing.GetParent().GetOwner() ) )
			{
				if ( objectivePing.GetParent().GetOwner() == objectiveWaypoint )
					doesPlayerHavePingOnThisObjective = true
			}
		}
		Remote_CallFunction_NonReplay( playerToUpdate, "ServerCallback_CaptureObjectivePing_UpdateObjectivePingText", pingToUpdate, pingType, pingCount, doesPlayerHavePingOnThisObjective )
		Remote_CallFunction_NonReplay( playerToUpdate, "ServerCallback_CaptureObjectivePing_UpdateObjectivePingCounts", objectiveWaypoint, teamOrAlliance, pingCount )
	}
}
#endif // SERVER

#if CLIENT || SERVER
// Get the current Ping Count for the objective for the selected team or alliance
int function CaptureObjectivePing_GetPingCountForObjectiveForTeamOrAlliance( entity wp, int teamOrAlliance )
{
	int pingCount = 0

	// Should never happen, we resize the array in the Init
	Assert( file.objectiveToCaptureObjectivePingCountTableArray.len() > teamOrAlliance, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " Tried to grab a table of objective pings to ping count for teamOrAlliance: " + teamOrAlliance + " but the array didn't contain the teamOrAlliance index" )
	if ( file.objectiveToCaptureObjectivePingCountTableArray.len() <= teamOrAlliance )
		return pingCount

	if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( wp ) && wp in file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ] )
		pingCount = file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ wp ]

	return pingCount
}
#endif // CLIENT || SERVER

#if SERVER
// Track destroyed Objective Pings to keep an updated count of the pings
void function CaptureObjectivePing_OnObjectiveStarterPingDestroyed( entity wp )
{
	if ( IsValid( wp.GetParent() ) && IsValid( wp.GetParent().GetOwner() ) )
	{
		entity objectiveWaypoint = wp.GetParent().GetOwner()
		if ( objectiveWaypoint.GetClassName() != PLAYER_WAYPOINT_CLASSNAME )
			return

		int team = wp.GetTeam()
		bool isUsingAlliances = AllianceProximity_IsUsingAlliances()
		int teamOrAlliance = isUsingAlliances ? AllianceProximity_GetAllianceFromTeam( team ) : team

		// This should never happen, we resize the array in the Init
		Assert( file.objectiveToCaptureObjectivePingCountTableArray.len() > teamOrAlliance, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " Tried to grab a table of objective pings to ping count for team or alliance: " + teamOrAlliance + " but the array didn't contain the index" )
		if ( file.objectiveToCaptureObjectivePingCountTableArray.len() <= teamOrAlliance )
			return

		int pingCount = 0
		if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
		{
			// If this objective already has a ping count being tracked at the team/alliance index in the array of tables, update the count. Otherwise create a table entry at the team/alliance index
			if ( objectiveWaypoint in file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ] )
			{
				pingCount = file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ]
				pingCount = maxint( pingCount - 1, 0 )
				file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ] = pingCount
			}
			else
			{
				file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ] <- pingCount
			}

			// Update the ping counts on the Client
			array < entity > playersToUpdateArray = isUsingAlliances ? AllianceProximity_GetAllPlayersInAlliance( teamOrAlliance, false ) : GetPlayerArrayOfTeam( teamOrAlliance )
			foreach( playerToUpdate in playersToUpdateArray )
			{
				if ( IsValid( playerToUpdate ) )
				{
					// Update player to ping table
					if ( playerToUpdate in file.playerToCaptureObjectivePingTable && file.playerToCaptureObjectivePingTable[ playerToUpdate ] == wp )
					{
						delete file.playerToCaptureObjectivePingTable[ playerToUpdate ]
						Remote_CallFunction_NonReplay( playerToUpdate, "ServerCallback_CaptureObjectivePing_UpdateLastPingedObjective", playerToUpdate, wp,  wp.GetParent(), true )
						{} // playerToUpdate.SetTargetInfoPingValue( eGameModeObjectivePingValue.NONE )
					}

					// Update ping count
					Remote_CallFunction_NonReplay( playerToUpdate, "ServerCallback_CaptureObjectivePing_UpdateObjectivePingCounts", objectiveWaypoint, teamOrAlliance, pingCount )
				}
			}
		}
	}
}
#endif // SERVER

#if SERVER
// Track destroyed Objective Pings to keep an updated count of the pings
void function CaptureObjectivePing_OnPlayerCancelledObjectivePing( entity wp, entity player )
{
	if ( IsValid( player ) && IsValid( wp.GetParent() ) && IsValid( wp.GetParent().GetOwner() ) )
	{
		entity objectiveWaypoint = wp.GetParent().GetOwner()
		if ( objectiveWaypoint.GetClassName() != PLAYER_WAYPOINT_CLASSNAME )
			return

		int team = wp.GetTeam()
		bool isUsingAlliances = AllianceProximity_IsUsingAlliances()
		int teamOrAlliance = isUsingAlliances ? AllianceProximity_GetAllianceFromTeam( team ) : team

		// This should never happen, we resize the array in the Init
		Assert( file.objectiveToCaptureObjectivePingCountTableArray.len() > teamOrAlliance, "CAPTURE OBJECTIVE PING: " + FUNC_NAME() + " Tried to grab a table of objective pings to ping count for team or alliance: " + teamOrAlliance + " but the array didn't contain the index" )
		if ( file.objectiveToCaptureObjectivePingCountTableArray.len() <= teamOrAlliance )
			return

		int pingCount = 0
		if ( CaptureObjectivePing_GetIsCaptureObjectivePingObjectiveWaypoint( objectiveWaypoint ) )
		{
			// If this objective already has a ping count being tracked at the team/alliance index in the array of tables, update the count. Otherwise create a table entry at the team/alliance index
			if ( objectiveWaypoint in file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ] )
			{
				pingCount = file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ]
				pingCount--
				file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ] = maxint( pingCount, 0 )
			}
			else
			{
				file.objectiveToCaptureObjectivePingCountTableArray[ teamOrAlliance ][ objectiveWaypoint ] <- pingCount
			}

			// Update player to ping table
			if ( player in file.playerToCaptureObjectivePingTable )
				delete file.playerToCaptureObjectivePingTable[ player ]

			// Set the player's personal objective ping status so we can display some text showing it to other players on the same team.
			{} // player.SetTargetInfoPingValue( eGameModeObjectivePingValue.NONE )

			// Make sure the ping count gets updated
			CaptureObjectivePing_UpdatePingCountOnObjective( objectiveWaypoint, teamOrAlliance )
		}
	}
}
#endif // SERVER

