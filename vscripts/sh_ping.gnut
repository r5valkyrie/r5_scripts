		if ( IsValid( reviveShieldEnt ) )
		{
			result.hitEnt = reviveShieldEnt
			result.pingType = IsEnemyTeam( playerTeam, reviveShieldEnt.GetTeam() ) ? ePingType.ENEMY_REVIVING : ePingType.LOCATION
			return result
