#if CLIENT
void function Ping_SetMapWaypoint( entity player, vector origin, bool pingEnemy = false )
{
	if ( !IsAlive( player ) )
		return

	if ( !IsPingEnabledForPlayer( player ) )
		return

	int ticketID = GetNewTicketID()

	if( !pingEnemy )
		Remote_ServerCallFunction( CMDNAME_PING_MAP_WAYPOINT, int( origin.x ), int( origin.y ), ticketID, false )
	else
		Remote_ServerCallFunction( CMDNAME_PING_MAP_WAYPOINT, int( origin.x ), int( origin.y ), ticketID, true )

                      
                                                      
   
                   
   
                           

	EmitSoundOnEntity( GetLocalViewPlayer(), PING_SOUND_LOCAL_CONFIRM )
}
#endif


#if SERVER
void function ClientCallback_PingMapWaypoint( entity player, int posX, int posY, int ticketID, bool pingEnemy )
{
	if ( !IsAlive( player ) )
	{
		printf( "%s() - Ignoring ping from dead player: '%s'.", FUNC_NAME(), string( player ) )
		return
	}

	if ( !IsPingEnabledForPlayer( player ) )
		return

	const float RESOLUTION = 128.0
	float newX = int( posX / RESOLUTION + 0.5 * signum( posX ) ) * RESOLUTION
	float newY = int( posY / RESOLUTION + 0.5 * signum( posY ) ) * RESOLUTION

	vector origin
	int ms = PlayerMatchState_GetFor( player )
	if ( ms < ePlayerMatchState.NORMAL )
	{
		TraceResults result = TraceLine( <newX, newY, 10000.0>, <newX, newY, -10000.0>, [], TRACE_MASK_BLOCKLOS, TRACE_COLLISION_GROUP_NONE )
		if ( result.hitSky || (result.fraction > 0.99) )
		{
			printf( "%s() - Trace-down ping at (%d, %d) --> (%.2f, %.2f) failed for player '%s'.", FUNC_NAME(), posX, posY, newX, newY, string( player ) )
			return
		}
		origin = result.endPos
	}
	else
	{
		vector playerOrigin = player.GetOrigin()
		origin = <newX, newY, playerOrigin.z>
		if ( Distance2D( origin, playerOrigin ) < 1000.0 )
			origin = playerOrigin
	}

	if ( pingEnemy )
	{
		if ( !CanPlayerPingDebounce( player, ePingType.ENEMY_GENERAL ) )
			return
	}
	else
	{
		if ( !CanPlayerPingDebounce( player, ePingType.MAP_WAYPOINT ) )
			return
	}


	printt( "Map Ping pos: " + origin )

	if ( !PositionIsInMapBounds( origin ) )
		return

                      
                                                      
   
         
   
       

	                            
	if( MapPing_SnapToGround_Enabled() )
	{
		origin = GetGroundPositionOpenToSky( origin )
	}
       

	if ( !pingEnemy )
		CreateWaypoint_Ping_Location( player, ePingType.MAP_WAYPOINT, null, origin, ticketID, false, false, pingWheelIndex.PING_MAP )
	else
		CreateWaypoint_Ping_Location( player, ePingType.ENEMY_GENERAL, null, origin, ticketID, false, false, pingWheelIndex.PING_MAP )

                         
                                                                
  
                                               
  
                               
}
#endif


#if SERVER
bool function CanPlayerPingDebounce( entity player, int pingType, float waitMax = 0.5, float waitMin = 0.2 )
{
	// This feel ok to me now. - Roger
	// It only allows one ping every 0.5 seconds.
	// If you try to spam it, it will block future pings until you pause for 0.3.
	// forcing you to wait longer feels like it stopped working.

	float lastPingTime = file.nextPingTypeTimes[player][pingType]

	if ( Time() - lastPingTime < waitMax )
	{
		file.nextPingTypeTimes[player][pingType] = Time() - waitMin;
		return false
	}

	file.nextPingTypeTimes[player][pingType] = Time();
	return true
}
#endif


#if SERVER
void function ClientCallback_PingNewLootOutsideDeathbox( entity player, entity lootEnt, int ticketID, vector pingOrigin )
{
	HandlePingNewLoot( player, lootEnt, null, ticketID, pingOrigin )
}

void function ClientCallback_PingNewLootDeathbox( entity player, entity lootEnt, entity deathBox, int ticketID, vector pingOrigin )
{
	HandlePingNewLoot( player, lootEnt, deathBox, ticketID, pingOrigin )
}

void function ClientCallback_PingNewLootGrabber( entity player, entity lootEnt, entity grabber, int ticketID, vector pingOrigin )
{
	HandlePingNewLoot( player, lootEnt, grabber, ticketID, pingOrigin )
}

void function HandlePingNewLoot( entity player, entity lootEnt, entity deathBox, int ticketID, vector pingOrigin )
{
	if ( !IsAlive( player ) )
	{
		printf( "%s() - Ignoring ping from dead player: '%s'.", FUNC_NAME(), string( player ) )
		return
	}

	if ( !IsValid( lootEnt ) )
	{
		printt( format( "PingLoot: player '%s' - couldn't find valid lootEnt", player.GetPlayerName() ) )
		return
	}
	if ( !SURVIVAL_IsKnownLootItem( lootEnt ) )
	{
		printt( format( "PingLoot: player '%s' - given entity is not a known loot lootEnt: '%s'", player.GetPlayerName(), string( lootEnt ) ) )
		return
	}

	// [ JIRA: R5DEV-335946 ] Ping Exploit Prevention:
	// 	- player must pass debounce test so no spamming occurs.
	//	- If loot item:
	//		- player ( or drone ) must be facing loot and be within range.

	float facingAngleThreshold = 45.0
	float checkDistMax = 1024.0
	float closeByDist = 128.0

	vector pingerOrigin = pingOrigin
	vector pingerFacing = player.GetPlayerOrNPCViewVector()

	// ---- Start Block: Checks added for R5DEV-335946

	// DEBOUNCE: Prevent Spamming
	if( !IsPingDebounceExcepted( player ))
	{
		if( !CanPlayerPingDebounce( player, ePingType.LOOT ) )
			return
	}

	bool isFacingExempted = false
	vector checkPos = lootEnt.GetOrigin()
	vector ornull wpOverridePos
	entity TargetEnt = lootEnt
	if ( IsValid( deathBox ) && deathBox.GetNetworkedClassName() == "prop_loot_grabber" )
	{
		checkPos = deathBox.GetOrigin()
		wpOverridePos = deathBox.GetWorldSpaceCenter() + 16.0 * AnglesToForward( <0, 20.0 * Time(), 0> )
		isFacingExempted  = true
	}

	// If Crypto is viewing from his drone, the drone's origin and facing becomes the pinger location and facing.
	if( IsValid( player.p.cryptoActiveCamera ) && player.p.cryptoActiveCamera.IsPlayerInVehicle( player ))
	{
		pingerOrigin = player.p.cryptoActiveCamera.GetOrigin()
		pingerFacing = player.p.cryptoActiveCamera.GetForwardVector()
	}
	else
	{
		pingerOrigin = player.GetOrigin()
		// The checkDistMax is greatly increased.
		if ( IsPlayerZoomedIn( player ) )
			checkDistMax = 5000 // Number determined through experimentation
	}

	// Calculate Distance
	float checkDist = Distance( pingerOrigin, checkPos )

	printt( "checkDist == " + checkDist )

	// Increase the facing angle threshold if the player is really close to the item.
	if( checkDist <= closeByDist )
	{
		facingAngleThreshold = 180.0
	}

	// Check how directly pinger is facing target.
	vector directionToTarget = checkPos - pingerOrigin
	directionToTarget = Normalize( directionToTarget )
	float dot = DotProduct( directionToTarget, pingerFacing )
	float angleFacingToTarget = DotToAngle( dot )

	if(!isFacingExempted && ( angleFacingToTarget > facingAngleThreshold ))
	{
		printt( format( "----- %s: player '%s' is not facing %s directly enough at %s degrees.", FUNC_NAME(), player.GetPlayerName(), string( lootEnt ), string( angleFacingToTarget ) ) )
		#if DEVELOPER
			//DebugDrawArrow( pingerOrigin, checkPos, 32, 255, 0, 0, true, 30 )
		#endif
		return
	}

	// ---- End Block: Checks added for R5DEV-335946

	// DEV_Ping_devPrintsOn( true ) to see debug prints.
	#if DEVELOPER
		if( file.devPrintsOn )
		{
			printt( format( "***** %s():", FUNC_NAME()) )
			printt( " - PingNewLoot: player.GetOrigin()       == " + player.GetOrigin() )
			printt( " - PingNewLoot: lootEnt.GetOrigin()      == " + lootEnt.GetOrigin() )
			printt( " - PingNewLoot: pingOrigin               == " + pingOrigin )
			printt( " - PingNewLoot: Distance( pingOrigin, player.GetOrigin() ) == " + Distance( pingOrigin, player.GetOrigin()) )
			printt( " - PingNewLoot: Distance( pingerOrigin, checkPos ) == " + checkDist )
		}
	#endif

	if ( checkDist > checkDistMax )
	{
		printt( format( "----- %s: player '%s' - given entity at %s is too far away from the given ping origin of %s: '%s'", FUNC_NAME(), player.GetPlayerName(), string( pingerOrigin ), string( checkPos ), string( lootEnt ) ) )
		#if DEVELOPER
			//DebugDrawArrow( pingerOrigin, checkPos, 32, 255, 0, 0, true, 30 )
		#endif
		return
	}

	printt( format( "+++++ %s(): player '%s' - pinging loot lootEnt: '%s'", FUNC_NAME(), player.GetPlayerName(), string( lootEnt ) ) )
	CreateWaypoint_Ping_Loot( player, lootEnt, wpOverridePos, ticketID, deathBox )
}

bool function IsPingDebounceExcepted( entity player )
{
	// TODO: In case we need to make exceptions to the debounce check, put them here.
	return false
}

// -----
#endif

#if SERVER
void function ClientCallback_PingReply( entity player, entity wp, int pingReply )
{
	if ( !IsValid( wp ) )
		return

	if ( !IsAlive( player ) && !GameMode_IsActive( eGameModes.CONTROL ) )
	{
		printf( "%s() - Ignoring ping reply from dead player: '%s'.", FUNC_NAME(), string( player ) )
		return
	}

	bool playerIsOwner = (IsValid( player ) && (player == wp.GetOwner()))

	ReplyCommsActionInfo caInfo = Ping_GetCommsActionForWaypointReply( player, wp, pingReply )

	bool checkTeam = (IsPVEMode() ? false : true) && !IsBitFlagSet( caInfo.commsFlags, eCommsFlags.BROADCAST_TO_WAYPOINT_OWNER )

	// For alliances we don't want to break out when teams are mismatched
	if ( AllianceProximity_IsUsingAlliances() )
		checkTeam = false

	if ( checkTeam && (wp.GetTeam() != player.GetTeam()) && (wp.GetTeam() != TEAM_UNASSIGNED) )
	{
		Warning( "%s() - Team mismatch on '%s'.  %d != %d", FUNC_NAME(), string( wp ), wp.GetTeam(), player.GetTeam() )
		return
	}

	printf( "Ping Reply from '%s' - reply type #%d on '%s'", string( player), pingReply, string( wp ) )
	bool didAnything         = false
	entity commSubjectEnt    = player
	vector commSubjectOrigin = player.GetOrigin()
	string itemRef			 = ""
	switch( pingReply )
	{
		case ePingReply.BLANK:
			break

		case ePingReply.THANKS:
			commSubjectEnt = wp.GetOwner()

		case ePingReply.JOIN:
		case ePingReply.OK:
		case ePingReply.NEGATIVE:
		case ePingReply.I_CANNOT:
		case ePingReply.HOLD_ON:
		case ePingReply.RESPAWN_YES:
		case ePingReply.COMING_TO_HELP:
			didAnything = PlayerConfirmWaypoint( player, wp, pingReply )
			commSubjectEnt = wp.GetOwner()
			break

                   
		case ePingReply.CAREPACKAGE_INSIGHT_FUTURE_REPLY:
			didAnything = PlayerConfirmWaypoint( player, wp, pingReply )
			commSubjectEnt = wp
			itemRef = wp.GetWaypointString( 0 )
			break

		case ePingReply.CAREPACKAGE_INSIGHT_REPLY:
			didAnything = PlayerConfirmWaypoint( player, wp, pingReply )
			commSubjectEnt = null
			itemRef = wp.GetWaypointString( 0 )
			break
      

                       
                                                   
                                                               
                                 
                                                                   
        
      

		case ePingReply.OWNER_ANNOUNCE:
			if ( playerIsOwner )
			{
				Waypoint_TriggerTargetHighlightForPing( wp )
				didAnything = true
			}
			break

		case ePingReply.OWNER_CANCEL:
			if ( playerIsOwner )
			{
				DeleteWaypoint_Safe( player, wp )
				commSubjectEnt = null
				didAnything = true
			}
			break

		case ePingReply.LOOT_DIBS:
			commSubjectEnt = Waypoint_GetItemEntForLootWaypoint( wp )
			didAnything = PlayerAttemptDibsOnLootWaypoint( player, wp )
			break

		case ePingReply.LOOT_UNDIBS:
			didAnything = PlayerAttemptDibsOnLootWaypointUndo( player, wp )
			commSubjectEnt = wp.wp.oldOwner
			break

		case ePingReply.GENERAL_WAYPOINT_CALLOUT:
		case ePingReply.SKYDIVE_LAUNCHER:
			didAnything = PlayerConfirmWaypoint( player, wp, pingReply )
			commSubjectEnt = wp
			commSubjectOrigin = wp.GetOrigin()
			break

		case ePingReply.REPLY_HOLOSPRAY_LIKE:
			array<entity> likes = EmoteIcon_Waypoint_GetLinkedPlayers( wp )
			didAnything = wp.GetOwner() != player && !likes.contains( player )
			commSubjectEnt = wp

			if ( didAnything )
				EmoteIcon_Waypoint_LinkPlayer( wp, player )

			break

                            
		case ePingReply.RECOVER_DEATHBOX:
			// get the deathbox from the "marker" ping
			entity deathbox = wp.GetWaypointEntity( 0 )

			if ( IsValid( deathbox ) )
			{
				// create a ping
				entity wpNew = CreateWaypoint_Ping_Location( player, ePingType.PING_MY_LAST_DEATH_BOX, deathbox, deathbox.GetOrigin(), -1, true )
				wpNew.SetAbsOrigin( deathbox.GetOrigin() + <0, 0, 60> )
				wpNew.SetParent( deathbox )

				// destroy the old "marker" ping
				// use the same logic as above in the ePingReply.OWNER_CANCEL case
				if ( playerIsOwner )
				{
					DeleteWaypoint_Safe( player, wp )
				}
				didAnything = true
			}
			break
      

		case ePingReply.CAPTURE_OBJECTIVE_PING_DEFEND:
			didAnything = true
			commSubjectEnt = wp
			CaptureObjectivePing_OnObjectivePinged( player, wp, wp.GetParent(), ePingType.PING_CAPTURE_OBJECTIVE_DEFEND )
			break

		case ePingReply.CAPTURE_OBJECTIVE_PING_ATTACK:
			didAnything = true
			commSubjectEnt = wp
			CaptureObjectivePing_OnObjectivePinged( player, wp, wp.GetParent(), ePingType.PING_CAPTURE_OBJECTIVE_ATTACK )
			break
	}

	if ( didAnything && ( caInfo.commsAction != eCommsAction.BLANK ) && !IsBitFlagSet( caInfo.commsFlags, eCommsFlags.SILENCE ) )
	{
		player.TrackPlayerPing()
		BroadcastCommsActionToTeam( player, caInfo.commsAction, commSubjectEnt, commSubjectOrigin, caInfo.commsFlags, itemRef )
	}

	if ( IsValid( wp ) )
	{
		Waypoint_ClearPlayerSimilarPingsForReply( player, wp, pingReply )
		Waypoint_SetPingResponseForSquadMember( wp, player.GetTeamMemberIndex(), pingReply )
		Waypoint_NetNotify( wp, eWaypointNotifyType.UPDATE_PING_RESPONSES )
	}

	PIN_Ping( player, GetEnumString( "ePingReply", pingReply ).tolower(), wp, IsValid( wp ) ? wp.GetOrigin() : player.GetOrigin() )
}
#endif


#if SERVER
entity function GetEntFromArg( array<string> args, int argIndex, string debugFuncName )
{
	if ( argIndex >= args.len() )
		return null

	int eHandle = int( args[0] )
	entity ent  = GetEntityFromEncodedEHandle( eHandle )
	if ( !IsValid( ent ) )
	{
		printt( format( "%s: couldn't find valid ent for ehandle: 0x%x", debugFuncName, eHandle ) )
		return null
	}

	return ent
}
#endif


