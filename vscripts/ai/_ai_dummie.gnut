// TODO: the old dummie. Switch to v20 dummie when available.
const asset MODEL_NPC_DUMMIE_COMBAT =	$"mdl/humans/class/medium/dummie_medium_combat.rmdl"
const asset MODEL_NPC_DUMMIE_TRAINING = $"mdl/humans/class/medium/dummie_medium_training.rmdl"

const asset WEAPON_NPC_COMBATDUMMIE_RIFLE =	$"npc_weapon_hemlok"
const asset WEAPON_NPC_COMBATDUMMIE_SHOTGUN = $"npc_weapon_energy_shotgun"
const asset WEAPON_NPC_COMBATDUMMIE_ENERGY = $"npc_weapon_lstar"

// Shooting

void function Dummie_Init()
{
	PrecacheModel( MODEL_NPC_DUMMIE_COMBAT )
	PrecacheModel( MODEL_NPC_DUMMIE_TRAINING )
	PrecacheWeapon( WEAPON_NPC_COMBATDUMMIE_RIFLE )
	PrecacheWeapon( WEAPON_NPC_COMBATDUMMIE_SHOTGUN )
	PrecacheWeapon( WEAPON_NPC_COMBATDUMMIE_ENERGY )
	PrecacheScriptString( FIRING_RANGE_DUMMIE_SCRIPT_NAME )

	PrecacheParticleSystem( DUMMIE_FX_SPAWN )
	PrecacheParticleSystem( DUMMIE_FX_DESPAWN )

	AddDamageCallback( FIRING_RANGE_DUMMIE_SCRIPT_NAME, OnTrainingDummyTookDamage )
	AddHeadshotCallback( FIRING_RANGE_DUMMIE_SCRIPT_NAME, OnTrainingDummyTookHeadshot )

	AddDamageCallback( FIRING_RANGE_COMBAT_DUMMIE_SCRIPT_NAME, OnTrainingDummyTookDamage )
	AddHeadshotCallback( FIRING_RANGE_COMBAT_DUMMIE_SCRIPT_NAME, OnTrainingDummyTookHeadshot )

	RegisterSignal( "StopDummieBehavior" )
	RegisterSignal( "StopCrouch" )
	RegisterSignal( "StayNearHomePosDone" )
	RegisterSignal( "PlayerDriven_DummieTargeting_Start" )

	                   
		table< int, float > offParms
		offParms[ eDummieShooting_ParameterTypes.SHOTDELAY ] 					<- -1.0
		offParms[ eDummieShooting_ParameterTypes.SHOTACCURACY ] 				<- -1.0
		offParms[ eDummieShooting_ParameterTypes.MAXDUMMIESPERPLAYER ] 			<- -1.0
		dummieShooting_Parms_BySetting[ eDummie_Selector_Shooting.OFF ] 		<- offParms
		dummieShooting_Parms_BySetting[ eDummie_Selector_Shooting.FULLCOMBAT ] 	<- offParms

		table< int, float > easyParms
		easyParms[ eDummieShooting_ParameterTypes.SHOTDELAY ] 				<-3.0
		easyParms[ eDummieShooting_ParameterTypes.SHOTACCURACY ] 			<- 0.25
		easyParms[ eDummieShooting_ParameterTypes.MAXDUMMIESPERPLAYER ] 	<- 1.0
		dummieShooting_Parms_BySetting[ eDummie_Selector_Shooting.EASY ] <- easyParms

		table< int, float > mediumParms
		mediumParms[ eDummieShooting_ParameterTypes.SHOTDELAY ] 			<- 1.5
		mediumParms[ eDummieShooting_ParameterTypes.SHOTACCURACY ] 			<- 0.5
		mediumParms[ eDummieShooting_ParameterTypes.MAXDUMMIESPERPLAYER ] 	<- 2.0
		dummieShooting_Parms_BySetting[ eDummie_Selector_Shooting.MEDIUM ] 	<- mediumParms

		table< int, float > hardParms
		hardParms[ eDummieShooting_ParameterTypes.SHOTDELAY ] 				<- 0.75
		hardParms[ eDummieShooting_ParameterTypes.SHOTACCURACY ] 			<- 0.75
		hardParms[ eDummieShooting_ParameterTypes.MAXDUMMIESPERPLAYER ] 	<- 3.0
		dummieShooting_Parms_BySetting[ eDummie_Selector_Shooting.HARD ] 	<- hardParms
                          
}

