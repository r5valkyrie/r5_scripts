void function SetRandomFireForAnimatedNPC( entity npc, bool enabled )
{
	if ( !IsValid( npc ) )
		return

	if ( enabled )
	{
		npc.DisableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING )
		// npc.SetRandomFireForScriptedAnim( true )
		// npc.SetRandomFireMaxDelay( 1.0 )
		// npc.SetRandomFireAccuracy( 0.8 )
	}
	else
	{
		npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING )
		// npc.SetRandomFireForScriptedAnim( false )
	}
}

// TODO: Fix shield for this function.
entity function SpawnNPCCombatDummie( vector spawnOrigin, vector spawnAngles, int shieldLevel )
{
	entity npc = CreateNPCFromAISettings( FIRING_RANGE_COMBAT_DUMMIE_SCRIPT_NAME, MY_RANDOM_DUMMIE_TEAM, spawnOrigin, spawnAngles )
	npc.kv.spawnflags = (SF_NPC_ALLOW_SPAWN_SOLID | SF_NPC_NO_PLAYER_PUSHAWAY)
	DispatchSpawn( npc )

	asset weaponType = WEAPON_NPC_COMBATDUMMIE_RIFLE
	array<string> weaponMods = []
	int skinIndex = 0	// silver
	float moveSpeedScale = 1.0

	SetNPCShieldLevel( npc, shieldLevel )

	// TODO: Difficulty can be set here for weapons, grade and movescale.
	int style = RandomIntRange( 0, 2 )
	switch( style )
	{
		case 0:
			weaponType = WEAPON_NPC_COMBATDUMMIE_SHOTGUN
			break
		case 1:
			weaponType = WEAPON_NPC_COMBATDUMMIE_RIFLE
			break
		case 2:
			weaponType = WEAPON_NPC_COMBATDUMMIE_ENERGY
			weaponMods = ["death_spectre"]
			moveSpeedScale = 1.5
			break
	}

	npc.SetTitle( "" )
	npc.DisallowZiplines()
	npc.SetNPCMoveSpeedScale( moveSpeedScale )

	TakeAllWeapons( npc )
	npc.GiveWeapon( string( weaponType ), WEAPON_INVENTORY_SLOT_PRIMARY_0, weaponMods )
	npc.EnableNPCFlag( NPC_NO_WEAPON_DROP )

	npc.SetScriptName( FIRING_RANGE_DUMMIE_SCRIPT_NAME )

	npc.SetChanceToHitEnabled( true )
	CommonSpawnInfantryBehavior( npc, spawnOrigin )

	// NOTE: Damage and Headshot Callbacks are addded in _gamemode_survival.nut.

	                   
	AddEntityCallback_OnKilled ( npc, void function ( entity npc, var damageInfo )
	{
		entity attacker = DamageInfo_GetAttacker(damageInfo)
		if ( IsValid(attacker))
		{
			if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
			{
				PIN_DummieKilled( attacker, damageInfo, npc.GetOrigin() )
				if( attacker.IsPlayer() )
				{
					Remote_CallFunction_NonReplay ( attacker, "FR_DynamicStats_OnDummieKilled" )
				}
			}
			DummieTarget_PlayerLists_RemoveFromAll( npc )

			                  
				// FR_Nessie_OnDummyKilled( attacker, npc ) // S3: Nessie not available
         
		}
	} )
                          

	// npc.SetNetworkDistanceCullEnabled( false ) // S3: not available
	return npc
}

void function PIN_DummieKilled( entity attacker, var damageInfo, vector deathLocation )
{
	int contextID = eFiringRangeSettingsPINRecordContext.DUMMIEKILLED

	string weaponName = ""
	entity weapon = DamageInfo_GetWeapon( damageInfo )
	if( IsValid( weapon ) )
	{
		weaponName = weapon.GetWeaponClassName()
	}

	string attackerName = ""
	if( IsValid( attacker ) )
	{
		if( attacker.IsPlayer() )
		{
			attackerName = attacker.GetPlayerName()
		}
		else
		{
			attackerName = attacker.GetScriptName()
		}
	}

	PIN_Record_CustomizeRangeSettings( attacker, contextID, attackerName, weaponName, deathLocation )
}

void function DummieDespawn( entity dummie )
{
	if( !IsValid( dummie ) )
		return

	// Clean up if player was targeted by this dummie.
	entity targetedPlayer = dummie.GetEnemy()
	if( IsValid( targetedPlayer ) && targetedPlayer.IsPlayer() )
	{
                   
		DummiesTargetingPlayerList_Remove( targetedPlayer, dummie )
                         
	}

	DummieFX_Despawn( dummie )
	dummie.Destroy()
}

void function DummieFX_Despawn( entity dummie )
{
	if( !IsValid( dummie ) )
		return

	vector dummiePos = dummie.GetOrigin()
	StartParticleEffectInWorld( GetParticleSystemIndex( DUMMIE_FX_DESPAWN ), dummiePos, <0, 1, 0> ) // S3: no ForRealms variant
	//PlayImpactFXTable( dummiePos, dummie, DUMMIE_FX_DESPAWN ) //this is a particle system refernce, we can add impact table if we want terrain reaction/splash etc
	//EmitSoundOnEntity( dummie, DUMMIE_SOUND_DESPAWN  )
	EmitSoundAtPosition( TEAM_UNASSIGNED, dummie.GetOrigin(), DUMMIE_SOUND_DESPAWN, dummie )
}

void function DummieFX_Spawn_Thread( entity dummie, bool doSpawnFX = true, bool doDummieHighlight = true  )
{
	EndSignal( dummie, "OnDestroy" )

	if( IsValid( dummie ) )
	{
		dummie.Highlight_Enable()
		vector dummiePos = dummie.GetOrigin()

		if( doSpawnFX )
		{
			StartParticleEffectInWorld( GetParticleSystemIndex( DUMMIE_FX_SPAWN ), dummiePos, <0, 1, 0> ) // S3: no ForRealms variant
			//PlayImpactFXTable( dummiePos, dummie, DUMMIE_FX_SPAWN ) //this is a particle system refernce, we can add impact table if we want terrain reaction/splash etc

			EmitSoundOnEntity( dummie, DUMMIE_SOUND_SPAWN )
		}

		if( doDummieHighlight )
		{
			AddSonarDetectionForPropScript( dummie )
		}
	}
}

entity function SpawnNPCTrainingDummy( vector spawnOrigin, vector spawnAngles, int shieldLevel = 1, bool detatchChildren = false )
{
	vector spawnLoc = spawnOrigin + < 0, 0, 32 >
	entity npc = CreateNPCFromAISettings( "npc_training_dummy", MY_RANDOM_DUMMIE_TEAM, spawnLoc, spawnAngles )
	npc.kv.spawnflags = (SF_NPC_ALLOW_SPAWN_SOLID | SF_NPC_NO_PLAYER_PUSHAWAY)
	DispatchSpawn( npc )

	npc.SetTitle( "" )
	npc.DisallowZiplines()

	SetNPCShieldLevel( npc, shieldLevel )

	TakeAllWeapons( npc )
	// Note: NPCs will need npc weapons assigned to them or else they cannot fire them ever. Below we're giving
	//	mp_weapon_rspn101 so this npc will not be able to shoot.
	npc.GiveWeapon( "mp_weapon_rspn101", WEAPON_INVENTORY_SLOT_PRIMARY_0, [] )
	npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )

	npc.SetScriptName( FIRING_RANGE_DUMMIE_SCRIPT_NAME )

	AddEntityCallback_OnDamaged( npc, void function ( entity npc, var damageInfo )
	{
		int dpFlags = DamageInfo_GetCustomDamageType( damageInfo )
		dpFlags = (dpFlags | (DF_DISSOLVE | DF_INSTANT))
		dpFlags = (dpFlags & ~(DF_GIB))
		DamageInfo_SetCustomDamageType( damageInfo, dpFlags )

		DamageInfo_AddDamageFlags( damageInfo, GetShieldFlagsForTrainingDummyDamage( npc ) )
	} )

	AddEntityCallback_OnGrappled( npc, void function ( entity player, entity npc, vector hitpos, vector hitNormal )
	{
		thread function() : ( player, npc )
		{
			while( IsAlive( player ) && player.IsGrappleActive() )
				WaitFrame()
			wait 0.25
			if ( !IsAlive( npc ) )
				return
			TakeAllWeapons( npc )
			//npc.Dissolve( ENTITY_DISSOLVE_CORE )

			// NOTE: Uncommenting the TakeDamage below instead of using Die() will yield a code crash that's captured in R5DEV-471220.
			//npc.TakeDamage( 500000, null, null, { damageSourceId=damagedef_suicide } )
			npc.Die( null, null, { damageSourceId=damagedef_suicide }  )
		}()
	} )

	                   
		                  
			// S3: GetChildren() not available, Nessie easter egg disabled
		// if ( detatchChildren )
		// {
		// 	...
		// }
        

	AddEntityCallback_OnKilled ( npc, void function ( entity npc, var damageInfo )
	{
		entity attacker = DamageInfo_GetAttacker(damageInfo)
		if ( IsValid(attacker) && attacker.IsPlayer() )
		{
			if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
			{
				PIN_DummieKilled( attacker, damageInfo, npc.GetOrigin() )
				if( attacker.IsPlayer() )
				{
					Remote_CallFunction_NonReplay ( attacker, "FR_DynamicStats_OnDummieKilled" )
				}
			}
			DummieTarget_PlayerLists_RemoveFromAll( npc )

			                  
				// FR_Nessie_OnDummyKilled( attacker, npc ) // S3: Nessie not available
         
		}
	} )

		#if DEVELOPER
			thread DEV_DrawSpeed( npc )
		#endif // DEVELOPER
                          

	// npc.SetNetworkDistanceCullEnabled( false ) // S3: not available
	thread PushNPCDownToGroundThread( npc, spawnOrigin )
	return npc
}

void function PushNPCDownToGroundThread( entity npc, vector spawnLoc )
{
	npc.EndSignal( "JumpPad_DummieInAir" ) // For if a jump pad is placed right at the dummie's spawn point.
	npc.EndSignal( "OnDestroy" )

	//wait for NPC to fully spawn in and allow it to fall to ground natrually if able
	wait 1

	while ( IsValid( npc ) )
	{
		if ( npc.GetOrigin().z > spawnLoc.z || !( npc.IsOnGround() ) )
		{
			vector trace = GetGroundPosition( npc.GetOrigin(), spawnLoc + < 0, 0, -20 >, [ npc ] ).endPos
			npc.SetOrigin( trace )
		}
		else
		{
			return
		}

		wait 0.1
	}
}

void function SetNPCShieldLevel( entity npc, int shieldLevel )
{
	int skinIndex = 1	// Silver
	int maxHealth = 100
	int maxShields = 100
	int grade = 2

	switch (shieldLevel)
	{
                                
          
                          
                 
            
                  
        
                                      

		case 0: //old behavior
		skinIndex = 1    // Red
		maxShields = 100
		grade = 2
		break;

		case 1:
			skinIndex = 4    // black. zero is suppoose to be silver, but it don't work
			maxShields = TRAININGDUMMY_SHIELD_LV1_MAXHEALTH
			grade = 0
			break

		case 2:
			skinIndex = 3    // blue
			maxShields = TRAININGDUMMY_SHIELD_LV2_MAXHEALTH
			grade = 1
			break

		case 3:
			skinIndex = 6    // Purple
			maxShields = TRAININGDUMMY_SHIELD_LV3_MAXHEALTH
			grade = 2
			break

		// Note: Grade 3 / case 4: is Gold, which is basically purple but with 2x healing.
		case 4:
			skinIndex = 1    // Red
			maxShields = TRAININGDUMMY_SHIELD_LV4_MAXHEALTH
			grade = 4
			break
	}
	npc.SetGrade( grade )
	npc.SetSkin( skinIndex )

	npc.SetMaxHealth( maxHealth )
	npc.SetHealth( maxHealth )
	npc.SetShieldHealthMax( maxShields )
	npc.SetShieldHealth( maxShields )
}

entity function SpawnNPCTreasureDummie( vector spawnOrigin, vector spawnAngles, int style )
{
	entity npc = SpawnNPCCombatDummie( spawnOrigin, spawnAngles, style )

	AddEntityCallback_OnKilled( npc, void function ( entity npc, var damageInfo ) : ()
	{
		//vector org = (wasExecution ? victim.GetWorldSpaceCenter() : victim.EyePosition())
		vector org = npc.EyePosition()
		array<string> refs
		array<string> lootDropTypes = ["care_package_1_L", "care_package_1_R", "care_package_1_C"]
		foreach( dropType in lootDropTypes )
			refs.append( SURVIVAL_GetWeightedItemFromGroup( dropType ) )

		// LootTicks_SpawnLootTickLoot( npc, org, <0, 0, 1>, refs ) // S3: loot tick system not available

		//
		{
			vector origin 	= npc.GetWorldSpaceCenter()
			int expFX 		= GetParticleSystemIndex( $"P_impact_exp_smll_air" )

			StartParticleEffectInWorld( expFX, origin, <0,0,0> )
			EmitSoundAtPosition( npc.GetTeam(), origin, "LootTick_Explosion", npc )
			EmitSoundAtPosition( npc.GetTeam(), origin, "LootTick_Vocal_Death", npc )

			npc.Gib( <0,0,100> )
		}
	} )

	// S3: Loot tick eye FX not available (LOOT_TICK_EYE_FX, COLORID_FX_LOOT_TIER0)
	// {
	// 	...eye FX setup...
	// }

	// npc.SetNetworkDistanceCullEnabled( false ) // S3: not available
	return npc
}

int function GetShieldFlagsForTrainingDummyDamage( entity npc )
{
	if ( npc.GetShieldHealth() <= 0 )
		return 0

	int maxShields = npc.GetShieldHealthMax()

	int result = 0 //DAMAGEFLAG_VICTIM_ARMORED
	if ( maxShields >= TRAININGDUMMY_SHIELD_LV4_MAXHEALTH )
		result = (result | DAMAGEFLAG_ARMOR5)
	else if ( maxShields >= TRAININGDUMMY_SHIELD_LV3_MAXHEALTH )
		result = (result | DAMAGEFLAG_ARMOR3)
	else if ( maxShields >= TRAININGDUMMY_SHIELD_LV2_MAXHEALTH )
		result = (result | DAMAGEFLAG_ARMOR2)
	else
		result = (result | DAMAGEFLAG_ARMOR1)

	return result
}

// ----- Damage Callbacks.

void function OnTrainingDummyTookDamage( entity damagedEnt, var damageInfo )
{
	if ( damagedEnt.IsPlayer() && !damagedEnt.IsTitan() )
	{
		if ( (DamageInfo_GetCustomDamageType( damageInfo ) & (DF_DOOMED_HEALTH_LOSS)) == 0 )
		{
			ItemFlavor victimCharacter = LoadoutSlot_GetItemFlavor( ToEHI( damagedEnt ), Loadout_Character() )

			// S3: Survival_DamageShouldSlowDownPlayer / Survival_ShouldBypassCharacterDamageScale not available
			// Damage slow handled by engine in S3

			float damageScale = CharacterClass_GetDamageScale( victimCharacter )

			if ( !IsBitFlagSet( DamageInfo_GetCustomDamageType( damageInfo ), DF_BULLET ) && GetCurrentPlaylistVarBool( "damage_scale_filtered", false ) )
				damageScale = 1.0

			if ( damageScale != 1 )
				DamageInfo_Print( damageInfo, "scl " + damageScale )

			DamageInfo_ScaleDamage( damageInfo, damageScale )

                            
                                                      
                                                                  
     
                                                                      
                             
                                           
                                                                                    
     
                                  

			DamageInfo_AddDamageFlags( damageInfo, GetShieldFlagsForTrainingDummyDamage( damagedEnt ) )

			// S3: Survival_GetBodyshotDamageScale not available, use playlist var directly
			float bodyshotDamageScale = GetCurrentPlaylistVarFloat( "survival_bodyshot_damage_scale", 1.0 )

			DamageInfo_ScaleDamage( damageInfo, bodyshotDamageScale )
			DamageInfo_Print( damageInfo, "scaled by" + bodyshotDamageScale + " from playlist var" )
		}
	}
}

void function OnTrainingDummyTookHeadshot( entity damagedEnt, var damageInfo )
{
	if ( !IsTrainingDummie( damagedEnt ) )
		return

	if ( (DamageInfo_GetCustomDamageType( damageInfo ) & DF_DOOMED_HEALTH_LOSS) != 0 )
		return

	if ( !IsValidHeadShot( damageInfo, damagedEnt ) )
		return

	                  
		//setpos for testing this: Make sure dummy strafing is off and you might need to try a couple times
		//setpos -6688.792969 1889.152588 -83.979477;setang -89.000000 44.336212 0.000000
		entity inflictor = DamageInfo_GetInflictor( damageInfo )
		if ( IsValid( inflictor ) )
		{
			int damageSource = DamageInfo_GetDamageType( damageInfo )
			entity weapon = DamageInfo_GetWeapon( damageInfo )
			if ( IsValid( weapon ) && weapon.GetWeaponClassName() == "mp_weapon_throwingknife")
			{
				if ( inflictor.GetTimeSinceSpawning() > 5.7 )
				{
					vector damageDir = DamageInfo_GetDamageForceDirection( damageInfo )
					float damageDirDotUp = DotProduct( damageDir, <0,0,1> )
					if ( damageDirDotUp < .9 )
					{
						// FR_Nessie_DidKnifeLobShot( damagedEnt ) // S3: Nessie not available
					}
				}
			}
		}
       

	//Crate Wingman - SUPER SKULL - Does flat set damage on headshots. Ignores helmets. Also exists in OnPlayerTookHeadshot
	entity weapon = DamageInfo_GetWeapon( damageInfo )

	if ( IsValid( weapon ) )
	{
		string weaponName = weapon.GetWeaponClassName()
		if ( weapon.HasMod( "hopup_headshot_dmg_elite" ) || weapon.HasMod( "hopup_headshot_dmg_elite_ghorse" ) )
		{
			float damage = DamageInfo_GetDamage( damageInfo )
			damage = GetWeaponInfoFileKeyField_GlobalFloat ( weaponName, "skullpiercer_elite_damage" )
			DamageInfo_SetDamage( damageInfo, damage )
			DamageInfo_Print( damageInfo, "damage " + damage + " ignore helmet from Elite Skullpiercer." )

			//Rampart Walls Amped damage modifier

			if ( !IsValid( inflictor ) )
				return

			if ( inflictor.HasWeaponMod( "amped_damage" ) || inflictor.HasWeaponMod( "amped_damage_alt" ) )
			{
				DamageInfo_ScaleDamage( damageInfo, 1.2 )
			}
			return
		}
	}
	//

	// "Get" the helmet level here, based on armor level or white helmet depending on playlist var.
	string equippedHelmet
	int realm = GetCombatRangeRealm( damagedEnt )
	//if( GetCurrentPlaylistVarBool( TRAININGDUMMY_PLAYLISTVAR_MATCH_ARMORHELMS, false ) )
	if( Dummie_Helmets_Match_Shields( realm ) )
	{
		int maxShields = damagedEnt.GetShieldHealthMax()
		switch( maxShields )
		{
			case TRAININGDUMMY_SHIELD_LV1_MAXHEALTH:
				equippedHelmet = "helmet_pickup_lv1"
				break

			case TRAININGDUMMY_SHIELD_LV2_MAXHEALTH:
				equippedHelmet = "helmet_pickup_lv2"
				break

			case TRAININGDUMMY_SHIELD_LV3_MAXHEALTH:
				equippedHelmet = "helmet_pickup_lv3"
				break

			case TRAININGDUMMY_SHIELD_LV4_MAXHEALTH:
				equippedHelmet = "helmet_pickup_lv4"
				break
			default:
				break
		}
	}
	else // Without Armor-Helmet Matching, all dummies get White Helmet.
	{
		equippedHelmet = "helmet_pickup_lv1"
	}

	LootData data

	if ( SURVIVAL_Loot_IsRefValid( equippedHelmet ) )
		data = SURVIVAL_Loot_GetLootDataByRef( equippedHelmet )

	float headshotScalar = -1

	int tier = data.tier
	switch ( tier )
	{
		case 1:
			DamageInfo_AddCustomDamageType( damageInfo, DF_HEADSHOT )
			headshotScalar = GetCurrentPlaylistVarFloat( "helmet_lv1", 0.8 )
			break

		case 2:
			DamageInfo_AddCustomDamageType( damageInfo, DF_HEADSHOT )
			headshotScalar = GetCurrentPlaylistVarFloat( "helmet_lv2", 0.6 ) //0.50
			break

		case 3:
			DamageInfo_AddCustomDamageType( damageInfo, DF_HEADSHOT )
			headshotScalar = GetCurrentPlaylistVarFloat( "helmet_lv3", 0.5 ) //0.35
			break

		case 0:
		case 4:
			DamageInfo_AddCustomDamageType( damageInfo, DF_HEADSHOT )
			headshotScalar = GetCurrentPlaylistVarFloat( "helmet_lv4", 0.5 ) //0.35
			break
	}

	if ( headshotScalar > 0 )
	{
		float damage    = DamageInfo_GetDamage( damageInfo )
		//we might want to look at using DamageInfo_GetDamageCriticalHitScale in the future? For now, I'm using what HandleLocationBasedDamage uses
		float critScale = GetHeadshotDamageMultiplierFromDamageInfo( damageInfo )

		//damage hasn't been rounded yet, so we can divide to get the accurate non-crit damage
		float nonCritDamage = damage / critScale
		float critDamage    = damage - nonCritDamage
		damage = nonCritDamage + headshotScalar * critDamage
		DamageInfo_SetDamage( damageInfo, damage )
		DamageInfo_Print( damageInfo, "damage " + damage + " from hs shld scalar " + headshotScalar )
	}

	// S3: Survival_GetHeadshotDamageScale not available, use playlist var directly
	float headshotDamageScale = GetCurrentPlaylistVarFloat( "survival_headshot_damage_scale", 1.0 )
	DamageInfo_ScaleDamage( damageInfo, headshotDamageScale )
	DamageInfo_Print( damageInfo, "scaled by" + headshotDamageScale + " from playlist var" )
}

bool function Dummie_Helmets_Match_Shields( int realm )
{
	// playlist Var will FORCE match.
	bool plv_Match = GetCurrentPlaylistVarBool( TRAININGDUMMY_PLAYLISTVAR_MATCH_ARMORHELMS, false )

	bool helmetMatchShields = false
	if( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_FIRING_RANGE ) )
	{
		helmetMatchShields = FRSetting_DummieHelmetMatchShields_Get( realm )
	}
	return( plv_Match || helmetMatchShields )
}

// -------------------
// ----- Behavior Functions
// -------------------

                         
void function Dummie_Choose_And_Perform_Behavior_BySpawnPoint( entity dummie, entity spawnPt, table< int, bool > behaviorSettings )
{
	int realm = dummie.GetRealms()[ 0 ]

	if( FullCombatDummies_IsEnabled( realm ) )
		return

	// Look at spawnPt and gather its settings.
	bool spawnPtCanCrouch = false
	bool spawnPtCanStrafe = true
	bool spawnPtFacing    = false
	if( spawnPt.HasKey( "can_crouch" ))
	{
		spawnPtCanCrouch = spawnPt.GetValueForKey( "can_crouch" ) == "1" ? true : false
	}
	if( spawnPt.HasKey( "cannot_strafe" ))
	{
		spawnPtCanStrafe = spawnPt.GetValueForKey( "cannot_strafe" ) == "1" ? false : true
	}
	if( spawnPt.HasKey( "does_spawnpt_face" ))
	{
		spawnPtFacing = spawnPt.GetValueForKey( "does_spawnpt_face" ) == "1" ? true : false
	}

	// Look at the spawn point and what's allowed vs. the Behavior Table, and make it do a valid behavior.
	// use HasKey() and GetValueForKey() to determine what's valid behavior for selected spawn point.
	table< int, bool > resultBehaviorBools
	resultBehaviorBools[ eDummieBehaviorType.CANSTAND ] 		<- behaviorSettings[ eDummieBehaviorType.CANSTAND ]
	resultBehaviorBools[ eDummieBehaviorType.CANCROUCH ] 		<- behaviorSettings[ eDummieBehaviorType.CANCROUCH ] && spawnPtCanCrouch
	resultBehaviorBools[ eDummieBehaviorType.RANDINTERVALS ] 	<- behaviorSettings[ eDummieBehaviorType.RANDINTERVALS ]
	resultBehaviorBools[ eDummieBehaviorType.STAYINPLACE ] 		<- behaviorSettings[ eDummieBehaviorType.STAYINPLACE ]
	resultBehaviorBools[ eDummieBehaviorType.STRAFE ] 			<- behaviorSettings[ eDummieBehaviorType.STRAFE ] && spawnPtCanStrafe

	Dummie_Choose_And_Perform_Behavior( dummie, resultBehaviorBools )
}

void function Dummie_Choose_And_Perform_Behavior( entity dummie, table< int, bool > behaviorBools )
{
	if( !IsValid( dummie ) )
		return

	int realm = dummie.GetRealms()[ 0 ]

	if( FullCombatDummies_IsEnabled( realm ) )
		return

	// Look at behavior bools and construct a list of possible behaviors. Then run a randomly chosen behavior.
	array< void functionref( entity, vector, vector, bool, bool, float, float ) > behaviorFuncs

	bool canStand 	= behaviorBools[ eDummieBehaviorType.CANSTAND ]
	bool canCrouch 	= behaviorBools[ eDummieBehaviorType.CANCROUCH ]
	float intervalMin
	float intervalMax

	if( behaviorBools[ eDummieBehaviorType.STAYINPLACE ] )
	{
		behaviorFuncs.append( Dummie_Behavior_StayInPlace_Thread )
		if( behaviorBools[ eDummieBehaviorType.RANDINTERVALS ] )
		{
			intervalMin = INTERVALMIN_STRAFE
			intervalMax = INTERVALMAX_STRAFE
		}
		else
		{
			intervalMin = INTERVALMAX_STRAFE
			intervalMax = INTERVALMAX_STRAFE
		}
	}

	if( behaviorBools[ eDummieBehaviorType.STRAFE ] )
	{
		behaviorFuncs.append( Dummie_Behavior_Strafe_Thread )
		behaviorFuncs.append( Dummie_Behavior_Strafe_Thread )

		if( behaviorBools[ eDummieBehaviorType.RANDINTERVALS ] )
		{
			intervalMin = INTERVALMIN_STRAFE
			intervalMax = INTERVALMAX_STRAFE
		}
		else
		{
			intervalMin = INTERVALMAX_STRAFE
			intervalMax = INTERVALMAX_STRAFE
		}
	}

	// Default to StayInPlace if the settings are buggered.
	if( behaviorFuncs.len() == 0 )
	{
		behaviorBools[ eDummieBehaviorType.STAYINPLACE ] = true
		behaviorFuncs.append( Dummie_Behavior_StayInPlace_Thread )
	}

	void functionref( entity, vector, vector, bool, bool, float, float ) behaviorToRun = behaviorFuncs.getrandom()
	thread behaviorToRun( dummie, dummie.GetOrigin(), dummie.GetAngles(), canStand, canCrouch, intervalMin, intervalMax )

	                   
		AddEntityCallback_OnPostDamaged( dummie, DummieShooting_OnDamaged_React )
		thread DummieShooting_WatchPlayerMenuState_Thread( dummie )
                          
}

                   
void function DummieShooting_OnDamaged_React( entity dummie, var damageInfo )
{
	if( !IsAlive( dummie ))
		return

	// Check health vs. damage.
	float damage = DamageInfo_GetDamage( damageInfo )
	if( damage <=0 )
		return

	// TODO: Check Damage Type and only do this for direct shots.

	if( dummie.GetHealth() <= damage )
		return

	// Don't react to attackers more than once every few moments.
	const float DAMAGEREACT_DEBOUNCE = 1.0
	float timeBetweenReacts = Time() - dummie.e.lastDamagedTime
	if( timeBetweenReacts < DAMAGEREACT_DEBOUNCE )
		return

	dummie.e.lastDamagedTime = Time()

	int realm = GetCombatRangeRealm( dummie )
	if(!Dummie_NonFullCombat_Shooting_IsEnabled( realm  ))
		return

	// If someone is attacking this dummie and the dummie is facing this new threat, untarget its current player
	// and target this new attacker.
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if( IsValid( attacker ) && attacker.IsPlayer() && IsFacing( dummie, attacker, DUMMIE_FACES_PLAYER_ANGLE_THRESHOLD, false, true ) )
	{
		entity currentTarget = dummie.GetEnemy()
		if( currentTarget == attacker )
			return

		bool attackerIsBetterChoiceThanCurrentTarget = true

		// TODO: Revisit this to make it work.
		//if( IsValid( currentTarget ) )
		//{
		//	float distSqAttacker 	  = DistanceSqr( dummie.GetOrigin(), attacker.GetOrigin() )
		//	float distSqCurrentTarget = DistanceSqr( dummie.GetOrigin(), currentTarget.GetOrigin() )
		//	attackerIsBetterChoiceThanCurrentTarget = distSqAttacker <= distSqCurrentTarget
		//}

		if( attackerIsBetterChoiceThanCurrentTarget )
		{
			// Drop current target.
			DummieTargeting_UnTargetCurrent( dummie )

			// Get rid of oldest targeter for the attacker to make room for this dummie.
			DummiesTargetingPlayerList_RemoveEarliestTargeter( attacker )

			// Target attacker.
			DummieTargeting_TryTargetPlayer( dummie, attacker )
		}
	}
}

void function DummieShooting_WatchPlayerMenuState_Thread( entity dummie )
{
	dummie.EndSignal( "OnDeath", "OnDestroy" )

	OnThreadEnd(
		function(): ( dummie )
		{
			DummieTarget_PlayerLists_RemoveFromAll( dummie )
		}
	)

	int realm = GetCombatRangeRealm( dummie )
	while( dummie.GetHealth() > 0 )
	{
		entity playerTargeted = dummie.GetEnemy()
		if( Dummie_NonFullCombat_Shooting_IsEnabled( realm ) )
		{
			if( IsValid( playerTargeted ) && playerTargeted.IsPlayer())
			{
				if( MenuOpen_DontShoot( playerTargeted ) )
				{
					// dummie.SetRandomFireForScriptedAnim( false )
				}
				else
				{
					// dummie.SetRandomFireForScriptedAnim( true )
				}
			}
		}
		wait( 0.2 )
	}
}

bool function MenuOpen_DontShoot( entity player )
{
	bool has_dontshoot_when_menuopen = GetCurrentPlaylistVarBool( "has_dummies_dontshoot_when_menuopen", false )
	bool menuOpen = CustomizeRangeMenu_IsOpen( player )
	return( has_dontshoot_when_menuopen && menuOpen )
}

bool function Dummie_NonFullCombat_Shooting_IsEnabled( int realm )
{
	int shootingSetting = FRSetting_DummieShooting_Get( realm )
	return(( shootingSetting > eDummie_Selector_Shooting.OFF ) && ( shootingSetting < eDummie_Selector_Shooting.FULLCOMBAT ))
}

bool function DummieShooting_Player_Has_MaxDummies( entity player )
{
	int realm = GetCombatRangeRealm( player )
	return( file.dummiesTargetingPlayer[ player ].len() == DummieShootingParm_Get_MaxDummiesPerPlayer( realm ) )
}
                         

void function CodeCallback_OnScriptedNPCTouchPropDynamic( entity npc, entity prop )
{
	#if DEVELOPER
	//	printt( "\n>>>>>> CodeCallback_OnScriptedNPCTouchPropDynamic:  " + npc + " touch " + prop + "\n" )
	#endif

	Assert( IsValid( npc ) )

	int realm = npc.GetRealms()[0]
	bool strafingOn = FRDummie_BehaviorData_Get( realm )[ eDummieBehaviorType.STRAFE ]
	if ( !strafingOn )
		return

                   
	if ( FRSetting_DummieShooting_Get( realm ) == eDummie_Selector_Shooting.FULLCOMBAT )
		return


	if ( npc in file.dummieTouchProp )
	{
		if ( file.dummieTouchProp[npc] != prop )
		{
			file.dummieTouchProp[npc] = prop
			#if DEVELOPER
			printt( "\n>> CodeCallback_OnScriptedNPCTouchPropDynamic: " + npc + " touched new prop " + prop + " before clearing touched prop " + file.dummieTouchProp[npc] )
			#endif
		}
	}
	else
	{
		file.dummieTouchProp[npc] <- prop
	}
                         
	#if DEVELOPER
	//printt( "\n>> CodeCallback_OnScriptedNPCTouchPropDynamic: num dummies touching props is " + file.dummieTouchProp.len() + "\n" )
	#endif
}

void function Dummie_SetModifierAndUpdate( entity dummie, int mod, bool value )
{
	Assert( dummie.IsNPC() )

	if ( value != dummie.IsActivityModifierActive( mod ) )
		dummie.SetActivityModifier( mod, value )
	
	// dummie.Anim_ScriptedResetActivity( 0.25, true ) // S3: not available
}

void function Dummie_Behavior_Strafe_Thread(  entity dummie, vector homePos, vector homeAngles, bool canStandParm, bool canCrouchParm, float intervalMin, float intervalMax )
{
	if( !IsValid( dummie ) )
		return

	if( !dummie.IsEntAlive() )
		return

	bool canStand = canStandParm
	bool canCrouch = canCrouchParm

	const int SPEEDNDX_WALK 	= 1
	const int SPEEDNDX_RUN 		= 2
	const int SPEEDNDX_RANDOM	= 3

	const string ACT_RUNTOHOMEPOINT = "ACT_SPRINT_FORWARD"
	const float INTERVAL_RETURNTOHOMEPOS = 1.0

	dummie.Signal( "StopDummieBehavior" )
	EndSignal( dummie, "StopDummieBehavior", "OnDestroy", "OnDeath" )

	array< string > strafeActions_L
	array< string > strafeActions_R

	// Note: In order to support the desired strafe states,
	// we will assign the currently existing Activities in the following manner:
	//	- ACT_WALK_AIM_LEFT/RIGHT 	= Crouch ADS strafes.
	//		- Anims: dummie_crouchWalk_L/R_AIM
	//	- ACT_RUN_LEFT/RIGHT 		= Crouch strafes.
	//		- Anims: dummie_crouchWalk_L/R ( derived from crouchWalk_L/R_AIM )
	//	- ACT_RUN_AIM_LEFT/RIGHT 	= Standing ADS strafes.
	//		- Anims: dummie_run_L/R_AIM
	//	- ACT_SPRINT_LEFT/RIGHT		= Standing strafes.
	//		- Anims: dummie_sprint_L/R

	int speed = FRSetting_DummieSpeed_Get( dummie.GetRealms()[0] )

	bool isRandIntervals = !( intervalMin == intervalMax )

	// For non-random intervals, we want the distance traveled to be the same for all movement modes. So, we
	// need to scale the time we move.
	table < int, float > timeMods
	// Crouch ADS Strafe
	timeMods[ "ACT_WALK_AIM_LEFT" ] 	<- 4.34	// 173.5/40
	timeMods[ "ACT_WALK_AIM_RIGHT" ] 	<- 4.34	// 173.5/40
	// Crouch Strafe
	timeMods[ "ACT_RUN_LEFT" ] 			<- 2.17	// 173.5/80
	timeMods[ "ACT_RUN_RIGHT" ] 		<- 2.17	// 173.5/80
	// Stand ADS Strafe
	timeMods[ "ACT_RUN_AIM_LEFT" ] 		<- 2	// 173.5/86.75
	timeMods[ "ACT_RUN_AIM_RIGHT" ] 	<- 2	// 173.5/86.75
	// Stand Strafe
	timeMods[ "ACT_SPRINT_LEFT" ] 		<- 1	// 173.5/173.5
	timeMods[ "ACT_SPRINT_RIGHT" ] 		<- 1	// 173.5/173.5


	if( canCrouch )
	{
		// ACT_WALK_AIM_LEFT/RIGHT == Crouch ADS strafe
		if(( speed == SPEEDNDX_WALK ) || (( speed == SPEEDNDX_RANDOM ) && !canStand ))
		{
			strafeActions_L.append( "ACT_WALK_AIM_LEFT" )
			strafeActions_R.append( "ACT_WALK_AIM_RIGHT" )
		}

		// ACT_RUN_LEFT/RIGHT == crouch strafe
		if(( speed == SPEEDNDX_RUN ) || ( speed == SPEEDNDX_RANDOM ))
		{
			strafeActions_L.append( "ACT_RUN_LEFT" )
			strafeActions_R.append( "ACT_RUN_RIGHT" )
		}
	}

	if( canStand )
	{
		// ACT_RUN_AIM_LEFT/RIGHT == Standing ADS Strafe
		if(( speed == SPEEDNDX_WALK ) || ( speed == SPEEDNDX_RANDOM ))
		{
			strafeActions_L.append( "ACT_RUN_AIM_LEFT" )
			strafeActions_R.append( "ACT_RUN_AIM_RIGHT" )
		}

		// ACT_SPRINT_LEFT/RIGHT == Standing Strafe.
		if(( speed == SPEEDNDX_RUN ) || ( speed == SPEEDNDX_RANDOM ))
		{
			strafeActions_L.append( "ACT_SPRINT_LEFT" )
			strafeActions_R.append( "ACT_SPRINT_RIGHT" )
		}
	}

	string currentAction
	float moveTimeTotal
	int homePosCheck
	bool doStrafeL = CoinFlip() // Toggle between left and right strafes.

	vector lastPos
	vector currentPos
	int stuckCount
	float timeDelta
	const int STUCKCOUNTTHRESHOLD = 3
	const float STUCKDISTSQR = 36// 6 squared
	float checkStuckTime
	const float CHECKSTUCK_TIMEINTERVAL = 0.5
	float lastDistance
	float currentDistance
	float currentSpeed
	const float RETURNHOME_CHECKSTUCK_SPEEDMOD = 0.5
	const float RETURNHOME_CHECKSTUCK_TIMEINTERVAL = 0.3

	const string NO_GROUNDENTITY_ANIM = "ACT_FALL"

	                   
		OnThreadEnd(
			function() : ( dummie, homePos, homeAngles, currentAction )
			{
				if ( dummie in file.dummieTouchProp )
					delete file.dummieTouchProp[dummie]

				Dummie_BehaviorEnd( dummie, homePos, homeAngles, currentAction )
			}
		)
                         

	while( dummie.IsEntAlive() )
	{
		currentAction = doStrafeL ? strafeActions_L.getrandom() : strafeActions_R.getrandom()
		moveTimeTotal      = RandomFloatRange( intervalMin, intervalMax )

		// If we're near the Home Point, just move halfway out.
		if( Distance2DSqr( dummie.GetOrigin(), homePos ) <= RETURNDIST_HOMEPOS_SQR )
			moveTimeTotal = moveTimeTotal / 2

		// If we're doing non-Random intervals, scale the time based on the movement mode.
		if( !isRandIntervals )
		{
			moveTimeTotal *= timeMods[ currentAction ]
		}

		float startTime = Time()
		float currentTime = Time()

		lastPos = dummie.GetOrigin()
		stuckCount = 0
		timeDelta = 0.2
		checkStuckTime = 0
		while( ( currentTime - startTime < moveTimeTotal ) && ( Distance2DSqr( dummie.GetOrigin(), homePos ) <= MAXDIST_HOMEPOS_SQR ) && ( stuckCount <= STUCKCOUNTTHRESHOLD  ))
		{
			if ( !IsValid( dummie.GetGroundEntity() ) )
				dummie.Anim_ScriptedPlayActivityByName( NO_GROUNDENTITY_ANIM , true, 0.25 )
			else
				dummie.Anim_ScriptedPlayActivityByName( currentAction, true, 0.25 )

			wait timeDelta
			currentTime = Time()
			                   
			if ( dummie in file.dummieTouchProp )
			{
				entity prop = file.dummieTouchProp[dummie]
				delete file.dummieTouchProp[dummie]

				if ( IsValid( prop ) )
				{
					vector toProp = (prop.GetOrigin() - dummie.GetOrigin())
					if ( DotProduct( toProp, dummie.GetRightVector() ) > 0 )
					{
						if ( !doStrafeL )
							break
					}
					else
					{
						if ( doStrafeL )
							break
					}
				}
			}
                           
			// Check to see if Dummie is stuck, i.e. not moving significantly over a period of time.
			checkStuckTime += timeDelta
			if( checkStuckTime >= CHECKSTUCK_TIMEINTERVAL )
			{
				currentPos = dummie.GetOrigin()
				#if DEVELOPER
					if( debugMovement )
					{
						DebugDrawSphere( lastPos, 64, 192, 192, 192, true, 1.0 )
						DebugDrawSphere( currentPos, 64, 0, 255, 0, true, 1.0 )
					}
				#endif
				float distSq = Distance2DSqr( currentPos, lastPos )
				if ( distSq < STUCKDISTSQR ) // Stuck if dummie didn't move 10 units within 0.1 seconds.
				{
					stuckCount++
					#if DEVELOPER
						if( debugMovement )
						{
							DebugDrawSphere( currentPos, 64, 255, 0, 0, true, timeDelta )
						}
					#endif
				}
				lastPos = currentPos
				checkStuckTime = 0
			}
		}

		// Flip Direction now that we're done strafing one way.
		doStrafeL = !doStrafeL

		// If our last strafe took us out of range, then deterministically strafe back toward home pos.
		homePosCheck = Dummie_CheckHomePosDist( dummie, homePos )
		if( homePosCheck != eHomePosCheck.INRANGE )
		{
			dummie.ai.pauseScriptedFaceTarget = true

			// The strafe-return version.
			vector facing = homePos - dummie.GetOrigin()
			vector facingAng = VectorToAngles( facing )
			facingAng.x = 0
			switch( homePosCheck )
			{
				case eHomePosCheck.TOOFAR_RIGHT:
					doStrafeL = true
					currentAction = strafeActions_L.getrandom()
					facingAng = AnglesCompose( facingAng, < 0, -90, 0 > ) // Turn the facing to the right 90 degrees
					break
				case eHomePosCheck.TOOFAR_LEFT:
					doStrafeL = false
					currentAction = strafeActions_R.getrandom()
					facingAng = AnglesCompose( facingAng, < 0, 90, 0 > ) // Turn the facing to the left  90 degrees
					break
			}
			dummie.SetAngles( facingAng )

			lastDistance = Distance( homePos, dummie.GetOrigin() )
			stuckCount = 0
			timeDelta = 0.1
			checkStuckTime = 0
			currentSpeed = 173.5 / max( timeMods[currentAction], FLT_EPSILON )
			while( dummie.IsEntAlive() && ( Distance2DSqr( dummie.GetOrigin(), homePos ) > RETURNDIST_HOMEPOS_SQR ) )
			{
				wait timeDelta

				if ( !IsValid( dummie.GetGroundEntity() ) )
				{
					dummie.Anim_ScriptedPlayActivityByName( NO_GROUNDENTITY_ANIM , true, 0.25 )
					checkStuckTime = 0.0
				}
				else
				{
					dummie.Anim_ScriptedPlayActivityByName( currentAction, true, 0.1 )
					checkStuckTime += timeDelta
				}

				#if DEVELOPER
					if ( dummiePrint )
					{
						DebugDrawText( dummie.GetOrigin() + < 0.0, 0.0, 40.0 >, "Distance to Home Sqr: " +  Distance2DSqr( dummie.GetOrigin(), homePos ) + ", Thresh Dist Sqr: " + RETURNDIST_HOMEPOS_SQR, true, timeDelta )
						DebugDrawText( dummie.GetOrigin() + < 0.0, 0.0, 30.0 >, "Stuck Count: " + stuckCount, true, timeDelta )
					}
				#endif

				if ( checkStuckTime > RETURNHOME_CHECKSTUCK_TIMEINTERVAL )
				{
					// As long as we are making some progress toward the home position,
					// then we're not stuck.  Progress is measured against (some fraction of) the distance
					// we would have travelled if there was an unobstructed path to the home position.
					currentDistance = Distance( homePos, dummie.GetOrigin() )
					if ( ( lastDistance - currentDistance) < ( currentSpeed * checkStuckTime * RETURNHOME_CHECKSTUCK_SPEEDMOD ) )
					{
						stuckCount++
					}
					#if DEVELOPER
						if ( dummiePrint )
						{
							DebugDrawText( dummie.GetOrigin() + < 0.0, 0.0, 20.0 >, "Strafe speed: " + currentSpeed + ", Required Speed: " + currentSpeed * RETURNHOME_CHECKSTUCK_SPEEDMOD, true, checkStuckTime )
							DebugDrawText( dummie.GetOrigin() + < 0.0, 0.0, 10.0 >, "Radial Speed: " + ( (lastDistance - currentDistance) / max( FLT_EPSILON, checkStuckTime) ), true, checkStuckTime )
						}
					#endif
					checkStuckTime = 0
					lastDistance = currentDistance
				}

				if ( stuckCount > STUCKCOUNTTHRESHOLD )
				{
					homePos = dummie.GetOrigin()
					break
				}

				#if DEVELOPER
					if ( dummiePrint )
					{
						DebugDrawSphere( dummie.GetOrigin(), 3, 0, 255, 0, true, 0.1 )
						DebugDrawText( dummie.GetOrigin(), currentAction, true, 0.1 )
						DebugDrawSphere( homePos, 3, 255, 0, 0, true, 0.1 )
						//DEV_DummiePrint( format( "%s(): Dummie too far from homePos. Running back to wtihin 100 units of homePos.", FUNC_NAME() ) )
					}
				#endif
			}
		}

		if( dummie.ai.pauseScriptedFaceTarget )
		{
			dummie.SetAngles( homeAngles )
			dummie.ai.pauseScriptedFaceTarget = false
		}
	}
}

#if DEVELOPER
void function DEV_DrawSpeed( entity ent )
{
	ent.EndSignal( "OnDeath" )
	ent.EndSignal( "OnDestroy" )

	vector lastPos = ent.GetOrigin()
	vector currPos

	float lastTime = Time()
	float currTime

	float distance
	float timeDelta
	float speed

	string speedText

	float interval = 0.2

	while( IsValid( ent ) )
	{
		wait( interval )

		currTime = Time()
		currPos = ent.GetOrigin()

		distance = Distance( currPos, lastPos )
		timeDelta = currTime - lastTime
		speed = distance / timeDelta
		speedText = "speed:" + speed
		if( showDummieSpeed )
			DebugDrawText( ent.GetOrigin(), speedText, true, interval  )

		lastPos = currPos
		lastTime = currTime
	}
}
#endif

int function Dummie_CheckHomePosDist( entity dummie, vector homePos )
{
	if( !dummie.IsEntAlive() )
		return eHomePosCheck.DEADCHECK
		
	// Check distance from HomePos. If too far from HomePos, strafe in the direction toward HomePos to go back.
	float distToHomePosSqr = Distance2DSqr( dummie.GetOrigin(), homePos )
	
	if( distToHomePosSqr > MAXDIST_HOMEPOS_SQR )
	{
		vector dummiePos = dummie.GetOrigin()
		vector homePosToDummie = Normalize( dummiePos - homePos )
		float dot = DotProduct( homePosToDummie, dummie.GetRightVector() )

		if( dot < 0 )
			return eHomePosCheck.TOOFAR_LEFT
		else
			return eHomePosCheck.TOOFAR_RIGHT
	}

	return eHomePosCheck.INRANGE
}

void function Dummie_Behavior_StayInPlace_Thread(  entity dummie, vector homePos, vector homeAngles, bool canStandParm, bool canCrouchParm, float intervalMin, float intervalMax )
{
	dummie.Signal( "StopDummieBehavior" )
	EndSignal( dummie, "StopDummieBehavior", "OnDestroy", "OnDeath" )

	bool canStand = canStandParm
	bool canCrouch = canCrouchParm

	// canStand and canCrouch should NEVER both be false.
	if( !canStand && !canCrouch )
		canStand = true

	array< string > standActions
	array< string > crouchActions

	if( canCrouch )
	{
		//crouchActions.append( "ACT_CROUCH" )
		crouchActions.append( "ACT_CROUCHIDLE" )
	}

	if( canStand )
	{
		standActions.append( "ACT_IDLE" )
		standActions.append( "ACT_IDLE_COMBAT" )
	}

	float waitTime
	string currentAction
	bool wasCrouch = false

	while( dummie.IsEntAlive() )
	{
		if( canStand )
		{
			currentAction = standActions.getrandom()
			dummie.Anim_ScriptedPlayActivityByName( currentAction, true, 0.1 )
			if( wasCrouch )
				EmitSoundOnEntity( dummie, "Dummie_CrouchStand_3P" )
			waitTime = RandomFloatRange( intervalMin, intervalMax )
			wasCrouch = false
			wait( waitTime )
		}

		if( canCrouch )
		{
			if( !wasCrouch )
			{
				currentAction = crouchActions.getrandom()
				dummie.Anim_ScriptedPlayActivityByName( currentAction, true, 0.1 )
				EmitSoundOnEntity( dummie, "Dummie_CrouchDown_3P" )
			}
			waitTime = RandomFloatRange( intervalMin, intervalMax )
			wasCrouch = true
			wait( waitTime )
		}
	}

	OnThreadEnd(
		function() : ( dummie, homePos, homeAngles, currentAction )
		{
			Dummie_BehaviorEnd( dummie, homePos, homeAngles, currentAction )
		}
	)
}

// -------------------

void function Dummie_BehaviorEnd( entity dummie, vector homePos, vector homeAngles, string currentAction )
{
	if( !IsValid( dummie ) )
		return

	if( dummie.IsEntAlive() )
	{
		dummie.SetOrigin( homePos )
		dummie.SetAngles( homeAngles )
	}
}

