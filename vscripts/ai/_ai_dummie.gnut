// -------------------
// Targeting Management
// -------------------

void function DummieTargeting_RegisterPlayer( entity player )
{
	if( !IsValid( player ) )
		return

	if( !( player in file.dummiesTargetingPlayer ))
		file.dummiesTargetingPlayer[ player ] <- []

	thread PlayerDriven_DummieTargeting_Thread( player )
}

void function DummieTargeting_UnregisterPlayer( entity player )
{
	if( player in file.dummiesTargetingPlayer )
	{
		delete file.dummiesTargetingPlayer[ player ]
	}
}

// -----

void function PlayerDriven_DummieTargeting_Thread( entity player )
{
	player.Signal( "PlayerDriven_DummieTargeting_Start" )
	player.EndSignal( "OnDisconnecting", "OnDestroy", "PlayerDriven_DummieTargeting_Start" )

	int realm = GetCombatRangeRealm( player )

	int shootingSetting

	// Parameters by setting
	float shotDelayBySetting
	float shotAccuracyBySetting
	float maxTimeOnOneTarget

	array< entity > frDummies
	array< entity > crDummies
	array< entity > allDummies
	array< entity > allDummiesSorted

	// We'll clear out the dummies targeting this player for every X loops
	// So new dummies can shoot at player.
	const int LOOP_TO_REFRESH = 4
	int loopCount = 1

	float waitTime = 0.5
	table< int, float > waitTimeByDifficulty
	waitTimeByDifficulty[ eDummie_Selector_Shooting.OFF ] 		<- 0.5
	waitTimeByDifficulty[ eDummie_Selector_Shooting.EASY ] 		<- 1.20
	waitTimeByDifficulty[ eDummie_Selector_Shooting.MEDIUM ] 	<- 1.0
	waitTimeByDifficulty[ eDummie_Selector_Shooting.HARD ] 		<- 0.55
	waitTimeByDifficulty[ eDummie_Selector_Shooting.FULLCOMBAT ]<- 0.5

	while( IsValid( player ) )
	{

		// Uncomment to debug
		//#if DEVELOPER
		//	printt( format( "%s(): Loop for %s @ Time == %s", FUNC_NAME(), player.GetPlayerName(), string( Time() ) ) )
		//#endif // DEVELOPER

		// Update waitTime based on difficulty set.
		shootingSetting = FRSetting_DummieShooting_Get( realm )
		waitTime = waitTimeByDifficulty[ shootingSetting ]

		// Get all the Dummies in the realm.
		frDummies = FRDummies_Get( realm )
		crDummies = CRDummies_Get( realm )
		allDummies = []
		allDummies.extend( frDummies )
		allDummies.extend( crDummies )
		if( allDummies.len() == 0 )
		{
			wait( waitTime )
			continue
		}

		// If it's not appropriate for dummies to shoot, wait and try again.
		//shootingSetting = FRSetting_DummieShooting_Get( realm )
		//if(( shootingSetting == eDummie_Selector_Shooting.OFF ) || ( shootingSetting == eDummie_Selector_Shooting.FULLCOMBAT ))
				
		if( !Dummie_NonFullCombat_Shooting_IsEnabled( realm ) )
		{
			// Turn off all shooting if shooting turned off.
			foreach( dummie in allDummies )
			{
				if( IsValid( dummie ) )
				{
					// dummie.SetRandomFireForScriptedAnim( false )
				}
			}
			DummiesTargetingPlayerList_Clear( player )
			wait( waitTime )
			continue
		}

		// ---- Shooting is ON! Let's go...
		if( loopCount == LOOP_TO_REFRESH )
		{
			DummiesTargetingPlayerList_Clear( player )
			loopCount = 1
		}

		ArrayRemoveInvalid( allDummies )
		// Sort the dummies by distance to this player.
		allDummiesSorted = ArrayClosest( allDummies, player.GetOrigin() )

		// Test each dummie and potentially target player until the cap is reached or there are no dummies left.
		foreach( dummie in allDummiesSorted )
		{
			// Check facing and try to target.
			bool dummieFacingPlayer = IsFacing( dummie,	player,	DUMMIE_FACES_PLAYER_ANGLE_THRESHOLD, false, true )
			bool playerFacingDummie = IsFacing( player,	dummie,	PLAYER_FACES_DUMMIE_ANGLE_THRESHOLD, false, false )
			entity currentTarget = dummie.GetEnemy()

			// Target this player if:
			//	- Menu is not open or we're not doing "Menu Open Don't Shoot"
			//	- Player and Dummie are facing each other somewhat.
			//	- The player is either not targeting anyone valid OR is already target this player.

			if( !MenuOpen_DontShoot( player ) && ( dummieFacingPlayer && playerFacingDummie ) && (( !IsValid( currentTarget ) ) || ( currentTarget == player )))
			{
				// Randomize the chance of attacking so if the player sits still the dummies that shoot will have a probability of changing
				// when targeting refreshes every few loops.
				int chanceToAttack = RandomInt( 100 )
				if( chanceToAttack <= 60 )
				{
					bool targetingSuccessful = DummieTargeting_TryTargetPlayer( dummie, player )
					if( targetingSuccessful )
					{
						//// uncomment to Debug
						//#if DEVELOPER
						//	DebugDrawSphere( dummie.GetOrigin(), 25, COLOR_RED, true, waitTime * 0.9 )
						//#endif // DEVELOPER

						if( DummieShooting_Player_Has_MaxDummies( player ) )
							break
					}
				}
				else
				{
					// uncomment to Debug
					//#if DEVELOPER
					//	DebugDrawCube( dummie.GetOrigin(), 20, COLOR_GREEN, true, waitTime * 0.9)
					//#endif // DEVELOPER
					DummieTargeting_UnTargetCurrent( dummie )
				}
			}
			else if( currentTarget == player ) // If dummie's current target is player, but not facing, free the dummie.
			{
				// uncomment to Debug
				//#if DEVELOPER
				//	DebugDrawCube( dummie.GetOrigin(), 20, COLOR_BLUE, true, waitTime * 0.9)
				//#endif // DEVELOPER
				DummieTargeting_UntargetPlayer( dummie, player )
			}
		}
		
		wait( waitTime )
		loopCount++
	}
}

table< int, float > function DummieShootingParms_Get_All( int realm )
{
	int dummieShootSetting = FRSetting_DummieShooting_Get( realm )
	return dummieShooting_Parms_BySetting[ dummieShootSetting ]
}

float function DummieShootingParm_Get_ShotDelay( int realm )
{
	int dummieShootSetting = FRSetting_DummieShooting_Get( realm )
	table< int, float > parms = dummieShooting_Parms_BySetting[ dummieShootSetting ]
	return( parms[  eDummieShooting_ParameterTypes.SHOTDELAY ] )
}

float function DummieShootingParm_Get_ShotAccuracy( int realm )
{
	int dummieShootSetting = FRSetting_DummieShooting_Get( realm )
	table< int, float > parms = dummieShooting_Parms_BySetting[ dummieShootSetting ]
	return( parms[  eDummieShooting_ParameterTypes.SHOTACCURACY ] )
}

int function DummieShootingParm_Get_MaxDummiesPerPlayer( int realm )
{
	int dummieShootSetting = FRSetting_DummieShooting_Get( realm )
	table< int, float > parms = dummieShooting_Parms_BySetting[ dummieShootSetting ]
	return( int( parms[  eDummieShooting_ParameterTypes.MAXDUMMIESPERPLAYER ] ))
}

// -----

void function DummiesTargetingPlayerList_Add( entity player, entity targeter )
{
	string errorMsg = format( "%s(): Player Invalid.", FUNC_NAME() )
	Assert( IsValid( player ), errorMsg )

	errorMsg = format( "%s(): Player %s not in file.dummiesTargetingPlayer.", FUNC_NAME(), player.GetPlayerName() )
	Assert( ( player in file.dummiesTargetingPlayer ), errorMsg )

	if( !file.dummiesTargetingPlayer[ player ].contains( targeter ) )
		file.dummiesTargetingPlayer[ player ].append( targeter )
}

void function DummiesTargetingPlayerList_Remove( entity player, entity targeter )
{
	string errorMsg = format( "%s(): Player Invalid.", FUNC_NAME() )
	Assert( IsValid( player ), errorMsg )

	errorMsg = format( "%s(): Player %s not in file.dummiesTargetingPlayer.", FUNC_NAME(), player.GetPlayerName() )
	Assert( ( player in file.dummiesTargetingPlayer ), errorMsg )

	if( file.dummiesTargetingPlayer[ player ].contains( targeter ) )
		file.dummiesTargetingPlayer[ player ].removebyvalue( targeter )
}

void function DummiesTargetingPlayerList_RemoveEarliestTargeter( entity player )
{
	string errorMsg = format( "%s(): Player Invalid.", FUNC_NAME() )
	Assert( IsValid( player ), errorMsg )

	errorMsg = format( "%s(): Player %s not in file.dummiesTargetingPlayer.", FUNC_NAME(), player.GetPlayerName() )
	Assert( ( player in file.dummiesTargetingPlayer ), errorMsg )

	if( file.dummiesTargetingPlayer[ player ].len() == 0 )
		return

	entity oldestTargeter = file.dummiesTargetingPlayer[ player ][ 0 ]
	file.dummiesTargetingPlayer[ player ].remove( 0 )
	if( IsValid( oldestTargeter ) )
	{
		DummieTargeting_UntargetPlayer( oldestTargeter, player )
	}
}

void function DummiesTargetingPlayerList_Clear( entity player )
{
	string error = format( "%s(): player invalid.", FUNC_NAME() )
	Assert( IsValid( player ), error )

	foreach( dummie in file.dummiesTargetingPlayer[ player ] )
	{
		DummieTargeting_UntargetPlayer( dummie, player )
	}
}

void function DummieTarget_PlayerLists_RemoveFromAll( entity dummie )
{
	foreach( player, targetList in file.dummiesTargetingPlayer )
	{
		if( !IsValid( player ) )
			continue
		
		if( targetList.contains( dummie ) )
		{
			targetList.removebyvalue( dummie )
		}
	}
}

bool function DummieShooting_Dummie_IsTargetingPlayer( entity dummie, entity player )
{
	if( !( IsValid( player ) ) )
		return false

	if( !( IsValid( dummie ) ) )
		return false

	if( !( player in file.dummiesTargetingPlayer ) )
		return false

	return( file.dummiesTargetingPlayer[ player ].contains( dummie ) )
}

bool function DummieTargeting_TryTargetPlayer( entity dummie, entity player )
{
	if( !IsValid( player ) )
		return false

	if( !IsValid( dummie ) )
		return false

	if( !player.IsPlayer() )
		return false

	if( !( player in file.dummiesTargetingPlayer ) )
		file.dummiesTargetingPlayer[ player ] <- []

	int realm = GetCombatRangeRealm( player )

	// if Dummie is not already targeting this player, add the player to the appropriate target list.
	bool isAlreadyTargetingPlayer = DummieShooting_Dummie_IsTargetingPlayer( dummie, player )
	if( !isAlreadyTargetingPlayer )
	{
		if( !DummieShooting_Player_Has_MaxDummies( player ))
		{
			// Remove dummie from previous target's list.
			entity previousPlayer = dummie.GetEnemy()

			if( IsValid( previousPlayer ))
			{
				DummieTargeting_UntargetPlayer( dummie, previousPlayer )
			}

			// Add this dummie to the new player's targeting list
			DummiesTargetingPlayerList_Add( player, dummie )
		}
		else
		{
			// dummie.SetRandomFireForScriptedAnim( false )
			return false
		}
	}

	// TODO: We can scale accuracy based on how dead-on the player is facing this dummie ( Make dummies to the side miss ).

	// Parameters
	float duration = DummieShootingParm_Get_ShotDelay( realm )
	float accuracy = DummieShootingParm_Get_ShotAccuracy( realm )
	
	// Set the target and enable shooting.
	// dummie.LockEnemy( player ) // S3: not available
	// dummie.SetRandomFireMaxDelay( duration )
	// dummie.SetRandomFireAccuracy( accuracy )
	dummie.DisableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING )
	// dummie.SetRandomFireForScriptedAnim( true )
	return true
}

void function DummieTargeting_UnTargetCurrent( entity dummie )
{
	entity targetCurrent = dummie.GetEnemy()

	// It's ok to call this function with no enemy.
	if( !IsValid( targetCurrent ) )
		return

	// Defensive scripting against Dummie somehow acquiring a non-player target.
	if( !targetCurrent.IsPlayer() )
	{
		dummie.ClearEnemy()
		// dummie.SetRandomFireForScriptedAnim( false )
		return
	}

	string errorMsg = format( "Error in %s(): Dummie Target is not in file.dummiesTargetingPlayer.", FUNC_NAME() )
	Assert( ( targetCurrent in file.dummiesTargetingPlayer ), errorMsg )

	DummieTargeting_UntargetPlayer( dummie, targetCurrent )
}

void function DummieTargeting_UntargetPlayer( entity dummie, entity player )
{
	// Safeguard against the possibility of code setting non-player enemies
	if( player.IsPlayer() )
	{
		string errorMsg = format( "Error in %s(): Player not in file.dummiesTargetingPlayer.", FUNC_NAME() )
		Assert(( player in file.dummiesTargetingPlayer ), errorMsg)

		// Remove from list
		if( file.dummiesTargetingPlayer[ player ].contains( dummie ) )
		{
			file.dummiesTargetingPlayer[ player ].removebyvalue( dummie )
		}
	}

	// Clear target and stop shooting.
	if( IsValid( dummie ) )
	{
		dummie.ClearEnemy()
		dummie.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING )
		// dummie.SetRandomFireForScriptedAnim( false )
	}
}

                         
