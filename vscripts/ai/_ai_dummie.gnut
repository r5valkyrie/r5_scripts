entity function SpawnCombatDummieAtCrosshair( entity player, int style )
{
	vector origin = GetPlayerCrosshairOrigin( player )
	vector eyeAngles = player.EyeAngles()
	vector angles = <0.0, (eyeAngles.y + 180.0), 0.0>

	entity npc = SpawnNPCCombatDummie( origin, angles, style )
	AddToUltimateRealm( player, npc )
	return npc
