void function NPCFollowsPlayer( entity npc, entity leader, float followTargetMoveTolerance = -1, float followGoalCombatTolerance = -1, float followGoalTolerance = -1 )
{
	Assert( IsAlive( npc ) )
	Assert( leader.IsPlayer() )

	//npc.SetBossPlayer( leader )

	// team
	SetTeam( npc, leader.GetTeam() )

	if ( IsSpectre( npc ) )
	{
		string squadName = GetPlayerSpectreSquadName( leader )
		SetSquad( npc, squadName )
	}

	//thread DieOnPlayerDisconnect( npc, leader )
	//Highlight_SetOwnedHighlight( npc, "friendly_ai" )

	NpcFollowsEntity( npc, leader, followTargetMoveTolerance, followGoalCombatTolerance, followGoalTolerance )
}

void function NPCFollowsNPC( entity npc, entity leader, float followTargetMoveTolerance = -1, float followGoalCombatTolerance = -1, float followGoalTolerance = -1 )
{
	Assert( IsAlive( npc ) )
	Assert( IsAlive( leader ) )
	Assert( leader.IsNPC() )

	// team
	SetTeam( npc, leader.GetTeam() )

	// squad
	string squadNameOwner = expect string( leader.Get( "squadname" ) )
	if ( squadNameOwner != "" && leader.GetClassName() == npc.GetClassName() )
		SetSquad( npc, squadNameOwner )

	NpcFollowsEntity( npc, leader, followTargetMoveTolerance, followGoalCombatTolerance, followGoalTolerance )
}

void function NpcFollowsEntity( entity npc, entity leader, float followTargetMoveTolerance = -1, float followGoalCombatTolerance = -1, float followGoalTolerance = -1 )
{
	// stop scripted things
	//npc.Signal( "StopHardpointBehavior" )

	if ( leader.IsPlayer() && leader.p.followPlayerOverride != null )
	{
		leader.p.followPlayerOverride( npc, leader )
		return
	}

	// follow!
	int followBehavior = GetDefaultNPCFollowBehavior( npc )
	npc.InitFollowBehavior( leader, followBehavior )
	npc.DisableBehavior( "Assault" )
	npc.DisableNPCFlag( NPC_ALLOW_PATROL | NPC_ALLOW_INVESTIGATE | NPC_USE_SHOOTING_COVER )
	npc.EnableBehavior( "Follow" )

	//Set target move tolerance to change follow position when follow target moves
	if ( followTargetMoveTolerance != -1 )
		npc.SetFollowTargetMoveTolerance( followTargetMoveTolerance )

	//Set goal tolerance when in combat
	if ( followGoalCombatTolerance != -1 )
		npc.SetFollowGoalCombatTolerance( followGoalCombatTolerance ) //Set goal tolerance when in combat

	//Set goal tolerance when not in combat
	if ( followGoalTolerance != -1 )
		npc.SetFollowGoalTolerance( followGoalTolerance )
}

void function ClearFollowBehavior( entity npc )
{
	if ( !IsAlive( npc ) )
		return

	//not sure why all the commented stuff makes them just freeze and stand still, looks like just turning off "Follow" is enough

	//npc.SetOwner( null )
	//npc.ClearBossPlayer()
	//npc.EnableBehavior( "Assault" )
	//npc.EnableNPCFlag( NPC_ALLOW_PATROL | NPC_ALLOW_INVESTIGATE | NPC_USE_SHOOTING_COVER )
	npc.DisableBehavior( "Follow" )
}


/////////////////////////////////////////////////////////////////////////////////////////////////
bool function HasEnemyWithinDist( entity npc, float dist )
{
	float distSq = dist * dist

	array<entity> enemies
	entity closestEnemy = npc.GetClosestEnemy()
	if ( closestEnemy )
		enemies.append( closestEnemy )

	entity currentEnemy = npc.GetEnemy()
	if ( currentEnemy && currentEnemy != closestEnemy )
		enemies.append( currentEnemy )

	if ( enemies.len() == 0 )
		return false

	vector origin = npc.GetOrigin()
	foreach ( enemy in enemies )
	{
		if ( DistanceSqr( origin, enemy.GetOrigin() ) < distSq )
			return true
	}

	return false
}

SpawnPointFP function FindSpawnPointForNpcCallin( entity npc, asset model, string anim )
{
	float yaw = npc.EyeAngles().y

	vector npcView 				= AnglesToForward( npc.EyeAngles() )
	FlightPath flightPath 		= GetAnalysisForModel( model, anim )

	CallinData drop
	InitCallinData( drop )
	SetCallinStyle( drop, eDropStyle.NEAREST_YAW_FALLBACK )
	SetCallinOwnerEyePos( drop, npc.EyePosition() )
	drop.dist 			= 800
	drop.origin 		= npc.GetOrigin() + npcView * 250
	drop.yaw 			= yaw

	vector angles = <0,yaw,0>
 	SpawnPointFP spawnPoint = GetSpawnPointForStyle( flightPath, drop )
	if ( spawnPoint.valid )
		return spawnPoint

	//if it didn't find one where he was looking - try near him
	drop.origin 		= npc.GetOrigin()
	spawnPoint = GetSpawnPointForStyle( flightPath, drop )

	return spawnPoint
}

void function WaitForSquadInCombat( array<entity> squad )
{
	table master = {}

	//when the thread ends, let child threads now
	OnThreadEnd(
		function() : ( master )
		{
			Signal( master, "OnDestroy" )
		}
	)

	foreach ( guy in squad )
	{
		thread CombatTracker( guy, master )
	}

	WaitSignal( master, "squadInCombat" )
}

void function CombatTracker( entity guy, table master )
{
	EndSignal( master, "OnDestroy" )
	EndSignal( guy, "OnDeath", "OnDestroy" )
	if ( !IsAlive( guy ) )
		return

	while ( guy.GetNPCState() != "combat" )
		guy.WaitSignal( "OnStateChange" )

	Signal( master, "squadInCombat" )
}

void function WaitForNpcInCombat( entity npc )
{
	while ( npc.GetNPCState() != "combat" )
		npc.WaitSignal( "OnStateChange" )
}

int function GetNpcHullType( entity npc )
{
	string aiSettings = npc.GetAISettingsName()
	return int( Dev_GetAISettingByKeyField_Global( aiSettings, "HullType" ) )
}

//////////////////////////////////////////////////////////////////////////////////////////////////////
// "SPAWN AI" DEV MENU Fuctions
//////////////////////////////////////////////////////////////////////////////////////////////////////
const float CROSSHAIR_VERT_OFFSET = 32

vector function GetPlayerCrosshairOriginRaw( entity player )
{
	if ( player.HasThirdPersonAttackFocus() )
		return player.GetThirdPersonAttackFocus()

	vector angles = player.EyeAngles()
	vector forward = AnglesToForward( angles )
	vector origin = player.EyePosition()

	vector start = origin
	vector end = origin + forward * 50000
	TraceResults result = TraceLine( start, end )
	vector crosshairOrigin = result.endPos

	return crosshairOrigin
}

vector function GetPlayerCrosshairOrigin( entity player )
{
	return (GetPlayerCrosshairOriginRaw( player ) + <0,0,CROSSHAIR_VERT_OFFSET> )
}

void function DEV_TeleportAllBotsToCrosshair( entity player )
{
	vector pos = GetPlayerCrosshairOrigin( player )
	foreach( bot in GetPlayerArray() )
	{
		if ( !bot.IsBot() )
			continue
		if ( bot.GetParent() != null )
			continue

		bot.SetOrigin( pos )
	}
}

void function DEV_TeleportAllPlayersTo( vector pos )
{
	foreach( thisPlayer in GetPlayerArray() )
		thisPlayer.SetOrigin( pos )
}

void function DEV_TeleportAllPlayersToCrosshair( entity player )
{
	vector pos = GetPlayerCrosshairOrigin( player )
	foreach( thisPlayer in GetPlayerArray() )
	{
		if ( player == thisPlayer )
			continue
		thisPlayer.SetOrigin( pos )
	}
}

void function DEV_SpawnWeaponAtCrosshair( string weaponName, array<string> mods = [] )
{
	printt( "script thread DEV_SpawnWeaponAtCrosshair( \"" + weaponName + "\")" )

	Assert( IsNewThread(), "Must be threaded off due to precache issues" )

	entity player = GetPlayerArray()[ 0 ]
	if ( !IsValid( player ) )
		return
	vector origin = GetPlayerCrosshairOrigin( player )
	vector angles = <0,0,0>
	entity weapon = CreateWeaponEntityByNameWithPhysics( weaponName, origin, angles )
	weapon.SetMods( mods )
}

void function SetAISettingsWrapper( entity npc, string settings )
{
	npc.SetAISettings( settings )

	// This assert was added at some point to enforce designers naming things correctly so people can easily see
	// the parent npc it was derived from, if any (example: npc_soldier_lmg is derived from the base npc_soldier)
	//Assert( settings.find( npc.GetClassName() ) == 0, settings + " settings file needs the string " + npc.GetClassName() + " added to the actual npc name string as a prefix." )
}

