float function GetBubbleShieldDuration( entity player )
{
	if ( PlayerHasPassive( player, ePassives.PAS_LONGER_BUBBLE ) )
		return EMBARK_TIMEOUT + 10.0
	else
		return EMBARK_TIMEOUT

	unreachable
}

