global function DropPod_Init
global function CreateDropPod
global function InitFireteamDropPod
global function LaunchAnimDropPod
global function GetDropPodAnimDuration
global function NPCsDeployFromDroppod
global function IsDroppodSpawner
global function SpawnDroppodSpawner
global function DroppodActivate
global function TryOpenDroppodDoor
global function Spawn_DropPodSquadCustom
global function CleanupDroppod
global function AnimateAirdropPod
global function DropPodOnImpactFXAndShake
global function JetwashFX
global function DropPod_ClearLandingZone

global const DROPPOD_MODEL = $"mdl/vehicle/droppod_fireteam/droppod_fireteam.rmdl"
const DROPPOD_DOOR_MODEL = $"mdl/vehicle/droppod_fireteam/droppod_fireteam_door.rmdl"
const DROPPOD_IMPACT_EFFECT = $"P_impact_dpod_default"

const string SOUND_CARE_PACKAGE_DROP = "survival_intro_pod_launch_3P"
const string SOUND_CARE_PACKAGE_AIRBURST = "survival_droppod_airburst_3p"
const string SOUND_CARE_PACKAGE_HOVER_START = "hovertank_mvmt_thrusterstart"
const string SOUND_CARE_PACKAGE_HOVER_LOOP = "hovertank_mvmt_thrusters"
const string SOUND_CARE_PACKAGE_HOVER_STOP = "hovertank_mvmt_thrusterstop"
const string SOUND_CARE_PACKAGE_LAND = "survival_droppod_landing_3p"

const DROPPOD_MOVER_SCRIPTNAME = "droppod_mover"

global enum eDropPodFlag
{
	NONE =							0,
	DISSOLVE_AFTER_DISEMBARKS =		(1<<0),
	SHOULD_PUSH_PLAYERS = 			(1<<1),
	SHOULD_DAMAGE_PLAYERS = 		(1<<2),
	SHOULD_ALWAYS_EXPLODE_DOOR =	(1<<3),
	TAKES_DAMAGE = 					(1<<4),
}

global struct DroppodStruct
{
	entity door
	bool openDoor = false
	int numGuys = 0
	int flags = 0
}

struct
{
	table<entity, DroppodStruct> droppodTable
	float dropPodAnimDuration = 0.0
} file

void function DropPod_Init()
{
	PrecacheModel( DROPPOD_MODEL )
	PrecacheModel( DROPPOD_DOOR_MODEL )
	PrecacheScriptString( DROPPOD_MOVER_SCRIPTNAME )

	//RegisterSignal( "OnLaunch" )
	RegisterSignal( "OnImpact" )
	RegisterSignal( "npc_deployed" )
	RegisterSignal( "OpenDoor" )
	RegisterSignal( "DroppodLanded" )
	RegisterSignal( "StopBraking" )

	PrecacheEffect( DROPPOD_IMPACT_EFFECT )
	PrecacheEffect( $"droppod_trail" )
	PrecacheEffect( $"droppod_airburst" )

	// Get and store the anim length for droppod drop sequence
	entity dropPod = CreateDropPod()
	file.dropPodAnimDuration = dropPod.GetSequenceDuration( "pod_testpath" )
	dropPod.Destroy()

	AddDamageCallbackSourceID( eDamageSourceId.landing_zone, DropPod_OnLandingZoneDamage )
}

entity function CreateDropPod( vector origin = <0,0,0>, vector angles = <0,0,0> )
{
	entity prop_dynamic = CreateEntity( "prop_dynamic" )

	PrepareDroppodModel( prop_dynamic )

	if ( origin != <0,0,0> )
		prop_dynamic.SetOrigin( origin )

	if ( angles != <0,0,0> )
		prop_dynamic.SetAngles( angles )

	DispatchSpawn( prop_dynamic )

	return prop_dynamic
}

void function PrepareDroppodModel( entity droppod )
{
	droppod.SetValueForModelKey( DROPPOD_MODEL )
	droppod.kv.contents = int( droppod.kv.contents ) & ~CONTENTS_TITANCLIP
	droppod.kv.fadedist = -1
	droppod.kv.renderamt = 255
	droppod.kv.rendercolor = "255 255 255"
	droppod.kv.solid = 6 // 0 = no collision, 2 = bounding box, 6 = use vPhysics, 8 = hitboxes only
}

DroppodStruct function InitFireteamDropPod( entity pod, int flags = 0, int team = TEAM_NPC_HOSTILE_TO_ALL )
{
	if ( IsBitFlagSet( flags, eDropPodFlag.TAKES_DAMAGE ) )
	{
		pod.SetMaxHealth( 100 )
		pod.SetHealth( 100 )
		pod.SetDamageNotifications( true )
		pod.SetTakeDamageType( DAMAGE_YES )
		SetTeam( pod, team )
		AddEntityCallback_OnDamaged( pod, OnDropPodDamaged )
		AddEntityCallback_OnPostDamaged( pod, OnDropPodPostDamaged )
	}

	pod.NotSolid()

	DroppodStruct droppodData
	droppodData.flags = flags
	droppodData.door = CreateDropPodDoor( pod )
	file.droppodTable[ pod ] <- droppodData

	pod.Anim_Play( "idle" )

	return droppodData
}

void function OnDropPodDamaged( entity pod, var damageInfo )
{
	if ( DamageInfo_GetDamage( damageInfo ) <= 0 )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( IsValid( attacker )  )
	{
		if ( IsFriendlyTeam(attacker.GetTeam(), pod.GetTeam() ) )
		{
			DamageInfo_SetDamage( damageInfo, 0.0 )
		}
	}
}

void function OnDropPodPostDamaged( entity pod, var damageInfo )
{
	if ( DamageInfo_GetDamage( damageInfo ) <= 0 )
		return

	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( IsValid( attacker ) && attacker.IsPlayer() )
	{
		// make the numbers % of device health
		//float damageToDisplay = 100.0 * DamageInfo_GetDamage( damageInfo ) / pod.GetMaxHealth()
		float damageToDisplay = DamageInfo_GetDamage( damageInfo )
		//if ( damageToDisplay > 0 )
		//	damageToDisplay = max( damageToDisplay, 1.0 )

		attacker.NotifyDidDamage(
			pod, DamageInfo_GetHitBox( damageInfo ),
			DamageInfo_GetDamagePosition( damageInfo ), DamageInfo_GetCustomDamageType( damageInfo ),
			damageToDisplay,
			DamageInfo_GetDamageFlags( damageInfo ), DamageInfo_GetHitGroup( damageInfo ),
			DamageInfo_GetWeapon( damageInfo ), DamageInfo_GetDistFromAttackOrigin( damageInfo )
		)
	}
}

entity function CreateDropPodDoor( entity pod )
{
	string attachment = "hatch"
	int attachIndex = pod.LookupAttachment( attachment )
	vector origin = pod.GetAttachmentOrigin( attachIndex )
	vector angles = pod.GetAttachmentAngles( attachIndex )

	entity prop_physics = CreateEntity( "prop_physics" )
	SetTargetName( prop_physics, "door" + UniqueString() )
	prop_physics.SetValueForModelKey( DROPPOD_DOOR_MODEL )
	// Start Asleep
	// Debris - Don't collide with the player or other debris
	// Generate output on +USE
	prop_physics.kv.spawnflags = 261 // non solid for now
	prop_physics.kv.fadedist = -1
	prop_physics.kv.physdamagescale = 0.1
	prop_physics.kv.inertiaScale = 1.0
	prop_physics.kv.renderamt = 0
	prop_physics.kv.rendercolor = "255 255 255"

	DispatchSpawn( prop_physics )

	prop_physics.SetOrigin( origin )
	prop_physics.SetAngles( angles )
	prop_physics.SetParent( pod, "HATCH", false )
	prop_physics.MarkAsNonMovingAttachment()

	return prop_physics
}

void function LaunchAnimDropPod( entity dropPod, vector targetOrigin, vector targetAngles, entity animRef = null )
{
	EndSignal( dropPod, "OnDestroy" )
	dropPod.EnableRenderAlways()

	entity ref = animRef
	if ( ref == null )
	{
		ref = CreateOwnedScriptMover( dropPod )
		ref.SetOrigin( targetOrigin )
		ref.SetAngles( targetAngles )
	}

	OnThreadEnd(
		function () : ( dropPod, ref )
		{
			if ( IsValid( dropPod ) )
			{
				dropPod.ClearParent()
			}

			if ( IsValid( ref ) )
				ref.Destroy()
		}
	)

	AddAnimEvent( dropPod, "OnImpact", DropPodOnImpactFXAndShake )

	bool warpFall = dropPod.HasKey( "script_hotdrop" ) && dropPod.kv.script_hotdrop == "Warpfall"

	FirstPersonSequenceStruct sequence
	sequence.thirdPersonAnim = "pod_testpath"
	sequence.blendTime 			= 0.0
	sequence.attachment 		= "ref"
	sequence.useAnimatedRefAttachment		= true

	if ( warpFall )
	{
		DroppodStruct droppodData = file.droppodTable[ dropPod ]

		dropPod.Hide()
		droppodData.door.Hide()

		EmitSoundOnEntity( dropPod, "spectre_drop_pod_warpfall" )

		PlayFX( TURBO_WARP_FX, dropPod.GetOrigin() + <0,0,5888>, dropPod.GetAngles() )
		wait WARPFALL_FX_DELAY

		dropPod.Show()
		droppodData.door.Show()

		sequence.setInitialTime 	= 4.0
	}
	else
	{
		EmitSoundOnEntity( dropPod, "spectre_drop_pod" )
	}

	waitthread FirstPersonSequence( sequence, dropPod, ref )
	dropPod.DisableRenderAlways()
}

void function DropPodOnImpactFXAndShake( entity droppod )
{
	DroppodStruct data = file.droppodTable[ droppod ]
	bool shouldPushPlayers = bool(data.flags & eDropPodFlag.SHOULD_PUSH_PLAYERS)
	bool shouldDamagePlayers = bool(data.flags & eDropPodFlag.SHOULD_DAMAGE_PLAYERS)

	vector origin = droppod.GetOrigin()
	vector angles = droppod.GetAngles()

	//PlayImpactFXTable( origin, droppod, HOTDROP_IMPACT_FX_TABLE ) //todo: sometimes this attaches to the player viewmodel
	CreateShake( origin, 7, 0.15, 1.75, 768 )
	//PlayFX( DROPPOD_IMPACT_EFFECT, origin, angles )

	//if ( !shouldDamagePlayers )
	//	droppod.SetNeverCrush( true ) // S3: entity method not available

	droppod.Solid()

	if ( shouldPushPlayers )
		thread PushPlayerAndCreateDropPodCollision( droppod, origin )
	if ( shouldDamagePlayers )
		RadiusDamage_DamageDef( damagedef_crush, origin, droppod, droppod, 300, 2000, 12, 128, 0 )
}

void function PushPlayerAndCreateDropPodCollision( entity pod, vector origin )
{
	EndSignal( pod, "OnDestroy" )

	entity point_push = CreateEntity( "point_push" )
	point_push.kv.spawnflags = 8
	point_push.kv.enabled = 1
	point_push.kv.magnitude = 140.0 * 0.75 //Compensate for reduced player gravity to match R1
	point_push.kv.radius = 192.0
	point_push.SetOrigin( origin + <0,0,32> )
	DispatchSpawn( point_push )

	OnThreadEnd(
		function() : ( point_push )
		{
			point_push.Destroy()
		}
	)

	while ( CheckPlayersIntersectingEntity( pod, 250 ) )
		wait 0.1
}

float function GetDropPodAnimDuration()
{
	Assert( file.dropPodAnimDuration > 0.0 )
	return file.dropPodAnimDuration
}

void function NPCsDeployFromDroppod( entity pod, array<entity> guys )
{
	DroppodStruct droppodData = file.droppodTable[ pod ]
	droppodData.openDoor = true
	pod.Signal( "OpenDoor" )

	if ( guys.len() >= 1 )
	{
		SetAnim( guys[0], "drop_pod_exit_anim", "pt_dp_exit_a" )
		SetAnim( guys[0], "drop_pod_idle_anim", "pt_dp_idle_a" )
	}

	if ( guys.len() >= 2 )
	{
		SetAnim( guys[1], "drop_pod_exit_anim", "pt_dp_exit_b" )
		SetAnim( guys[1], "drop_pod_idle_anim", "pt_dp_idle_b" )
	}

	if ( guys.len() >= 3 )
	{
		SetAnim( guys[2], "drop_pod_exit_anim", "pt_dp_exit_c" )
		SetAnim( guys[2], "drop_pod_idle_anim", "pt_dp_idle_c" )
	}

	if ( guys.len() >= 4 )
	{
		SetAnim( guys[3], "drop_pod_exit_anim", "pt_dp_exit_d" )
		SetAnim( guys[3], "drop_pod_idle_anim", "pt_dp_idle_d" )
	}

	foreach ( guy in guys )
	{
		if ( IsAlive( guy ) )
		{
			guy.SetDeathNotifications( true )
			thread NPCExitDroppod( guy, pod )
		}
	}

	thread DroppodActivate( pod )
}

void function NPCExitDroppod( entity guy, entity pod )
{
	DroppodStruct droppodData = file.droppodTable[ pod ]

	EndSignal( guy, "OnDeath" )
	EndSignal( guy, "OnDestroy" )

	OnThreadEnd(
		function() : ( droppodData )
		{
			droppodData.numGuys--
		}
	)

	droppodData.numGuys++

	string idleAnim
	string exitAnim

	if ( !droppodData.openDoor )
	{
		guy.SetEfficientMode( true )

		guy.SetParent( pod, "ATTACH", false )

		idleAnim = string( GetAnim( guy, "drop_pod_idle_anim" ) )
		if ( guy.LookupSequence( idleAnim ) != -1 )
			guy.Anim_ScriptedPlay( idleAnim )

		pod.WaitSignal( "OpenDoor" )

		guy.SetEfficientMode( false )
	}


	guy.SetParent( pod, "ATTACH", false )

	exitAnim = string( GetAnim( guy, "drop_pod_exit_anim" ) )
	bool exitAnimExists = guy.LookupSequence( exitAnim ) != -1
	if ( exitAnimExists )
		guy.Anim_ScriptedPlay( exitAnim )

	guy.ClearParent()

	if ( exitAnimExists )
		WaittillAnimDone( guy )
	guy.Signal( "npc_deployed" )
}

void function DroppodActivate( entity pod )
{
	DroppodStruct droppodData = file.droppodTable[ pod ]

	OnThreadEnd(
		function() : ( pod )
		{
			DroppodStruct droppodData = file.droppodTable[pod]
			float delay = ( IsBitFlagSet( droppodData.flags, eDropPodFlag.DISSOLVE_AFTER_DISEMBARKS ) ? 0.0 : 10.0)
			thread CleanupDroppod( pod, delay )
		}
	)

	EndSignal( pod, "OnDestroy" )

	TryOpenDroppodDoor( pod )

	while ( droppodData.numGuys > 0 )
		WaitFrame()
}

void function TryOpenDroppodDoor( entity pod )
{
	DroppodStruct droppodData = file.droppodTable[ pod ]
	bool shouldExplodeDoor = bool(droppodData.flags & eDropPodFlag.SHOULD_ALWAYS_EXPLODE_DOOR)

	if ( !shouldExplodeDoor && DropPodDoorInGround( pod ) )
		droppodData.door.Destroy()
	else
		DropPodOpenDoor( pod, droppodData.door )
}

bool function DropPodDoorInGround( entity pod )
{
	string attachment = "hatch"
	int attachIndex = pod.LookupAttachment( attachment )
	vector end = pod.GetAttachmentOrigin( attachIndex )

	string originAttachment = "origin"
	int originAttachIndex = pod.LookupAttachment( originAttachment )
	vector start = pod.GetAttachmentOrigin( originAttachIndex )

	TraceResults result = TraceLine( start, end, pod, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )

	return result.fraction < 1.0
}

void function DropPodOpenDoor( entity pod, entity door )
{
	door.ClearParent()
	door.SetOrigin( door.GetOrigin() + (door.GetForwardVector() * 5) )
	door.SetVelocity( door.GetForwardVector() * 500 )
	EmitSoundOnEntity( pod, "droppod_door_open" )
}

void function CleanupDroppod( entity pod, float delay )
{
	if ( delay > 0 )
		wait delay

	if ( !IsValid( pod ) )
		return

	if ( !( pod in file.droppodTable ) )
		return

	DroppodStruct droppodData = file.droppodTable[ pod ]

	if ( IsValid( droppodData.door ) )
		droppodData.door.Dissolve( ENTITY_DISSOLVE_CORE, <0,0,0>, 500 )

	EmitSoundAtPosition( TEAM_UNASSIGNED, pod.GetOrigin(), "droppod_dissolve", pod )

	delete file.droppodTable[ pod ]

	bool dissolvePod = true
	if ( pod.HasKey( "dissolve" ) && pod.kv.dissolve == "0" )
		dissolvePod = false

	foreach ( ent in pod.e.attachedEnts )
		ent.NotSolid()

	if ( dissolvePod )
	{
		pod.NotSolid()
		pod.Dissolve( ENTITY_DISSOLVE_CORE, <0,0,0>, 500 )
	}
}

array<entity> function CreateNPCSFromSpawnFuncsCustom( array<entity functionref( int, vector, vector, table )> spawnFuncsWithDispatch, array<table> customData, int team, vector spawnOrigin, vector spawnAngles )
{
	array<entity> dropEnts = []

	for ( int idx = 0; idx < spawnFuncsWithDispatch.len(); idx++ )
	{
		entity functionref( int, vector, vector, table ) spawnFuncWithDispatch = spawnFuncsWithDispatch[idx]
		entity ent = spawnFuncWithDispatch( team, spawnOrigin, spawnAngles, customData[idx] )

		dropEnts.append( ent )
	}

	ArrayRemoveDead( dropEnts )
	return dropEnts
}

void function Spawn_DropPodSquadCustom( array<entity functionref( int, vector, vector, table )> spawnfuncs, array<table> customData, array<entity> npcsToReturn, int team, entity spawnPoint, int dropPodFlags, float doorOpenDelay )
{
	vector spawnOrigin = spawnPoint.GetOrigin()
	vector spawnAngles = spawnPoint.GetAngles()
	spawnPoint.e.spawnPointInUse = true

	entity dropPod = CreateDropPod()
	InitFireteamDropPod( dropPod, dropPodFlags, team )
	waitthread LaunchAnimDropPod( dropPod, spawnOrigin, spawnAngles )

	if ( Flag( "disable_npcs" ) )
		return

	wait doorOpenDelay

	if ( !IsValid( dropPod ) )
		return

	npcsToReturn = CreateNPCSFromSpawnFuncsCustom( spawnfuncs, customData, team, spawnOrigin, spawnAngles )
	NPCsDeployFromDroppod( dropPod, npcsToReturn )
	spawnPoint.e.spawnPointInUse = false

	return
}

bool function IsDroppodSpawner( entity ent )
{
	if ( !IsSpawner( ent ) )
		return false

	table spawnerKeyValues = ent.GetSpawnEntityKeyValues()

	if ( !( "editorclass" in spawnerKeyValues ) )
		return false

	return spawnerKeyValues.editorclass == "script_droppod"
}

void function SpawnDroppodSpawner( entity dropPodSpawner )
{
	table spawnerKeyValues = dropPodSpawner.GetSpawnEntityKeyValues()

	entity dropPod = dropPodSpawner.SpawnEntity()
	PrepareDroppodModel( dropPod )
	DispatchSpawn( dropPod )

	InitFireteamDropPod( dropPod )

	vector origin = StringToVector( string( spawnerKeyValues.origin ) )
	vector angles = StringToVector( string( spawnerKeyValues.angles ) )
	int npcType = int( spawnerKeyValues.npcType )
	int team = int( spawnerKeyValues.teamnumber )

	waitthread LaunchAnimDropPod( dropPod, origin, angles )

	array<entity> linkedEnts = dropPod.GetLinkEntArray()
	entity moveTarget
	array<entity> npcSpawners
	foreach ( entity linkedEnt in linkedEnts )
	{
		if ( GetEditorClass( linkedEnt ) == "info_move_target" )
			moveTarget = linkedEnt
		else if ( IsSpawner( linkedEnt ) )
			npcSpawners.append( linkedEnt )
	}

	Assert( npcSpawners.len() <= 4, "Droppod at " + origin + " has too many spawners linked. Max is 4" )

	array<entity> npcs
	if ( npcSpawners.len() > 0 )
	{
		// Use linked spawners
		foreach ( entity npcSpawner in npcSpawners )
		{
			entity npc = npcSpawner.SpawnEntity()
			DispatchSpawn( npc )
			npcs.append( npc )
		}
	}
	else
	{
		// Create NPCs based on the selected type
		entity functionref( int, vector, vector ) spawnFunc

		switch ( npcType )
		{
			default:
				Assert( false, "Unhandled NPCType on droppod spawner" )
				return
		}

		for ( int i = 0; i < 4; i++ )
		{
			entity npc = spawnFunc( team, origin, angles )
			DispatchSpawn( npc )
			npcs.append( npc )
		}
	}

	ArrayRemoveDead( npcs )
	Assert( npcs.len() > 0, "Spawned DropPod with no NPCs" )

	foreach ( entity npc in npcs )
	{
		if ( IsValid( moveTarget ) )
			thread AssaultMoveTarget( npc, moveTarget )

		// If the NPC spawner linked to a move target directly then use that instead
		thread AssaultLinkedMoveTarget( npc )
	}

	NPCsDeployFromDroppod( dropPod, npcs )
}



void function AnimateAirdropPod( entity dropPod, vector origin, vector angles, string animationName )
{
	dropPod.EndSignal( "OnDestroy" )

	thread JetwashFX( dropPod )

	AddAnimEvent( dropPod, "DroppodLanded", OnDroppodLanded )
	AddAnimEvent( dropPod, "DroppodPushAway", OnDroppodPushAway )

	entity mover = CreateScriptMover( DROPPOD_MOVER_SCRIPTNAME, dropPod.GetOrigin(), dropPod.GetAngles() )
	dropPod.SetParent( mover )

	OnThreadEnd(
		function() : ( dropPod, mover )
		{
			if ( IsValid( dropPod ) )
			{
				dropPod.ClearParent()
			}
			if ( IsValid( mover ) )
			{
				mover.Destroy()
			}
		}
	)

	waitthread PlayAnim( dropPod, animationName )

	dropPod.Signal( "StopBraking" )
}

void function OnDroppodLanded( entity dropPod )
{
	Signal( dropPod, "DroppodLanded" )

	TraceResults results = TraceLine( dropPod.GetOrigin() + <0,0,64>, dropPod.GetOrigin() - <0,0,256>, dropPod, TRACE_MASK_NPCWORLDSTATIC, TRACE_COLLISION_GROUP_NONE )

	entity shake = CreateShake( results.endPos, 16, 150, 1.0, 4000 )
	shake.kv.spawnflags = 4 // SF_SHAKE_INAIR
	if( IsValid( dropPod ) )
	{
		shake.RemoveFromAllRealms()
		shake.AddToOtherEntitysRealms( dropPod )
	}
	PlayImpactFXTable( results.endPos, dropPod, "droppod_impact" )

	float triggerRadius = 72
	DropPod_ClearLandingZone( results.endPos, dropPod, triggerRadius, triggerRadius )
}

void function DropPod_ClearLandingZone( vector pos, entity inflictor, float innerRadius, float outerRadius, bool debugDraw = false )
{
	RadiusDamage(
		pos,									// origin
		svGlobal.worldspawn,					// owner
		inflictor,		 						// inflictor
		1000,									// pilot damage
		1000,									// heavy armor damage
		innerRadius,							// inner radius
		outerRadius,							// outer radius
		SF_ENVEXPLOSION_NO_NPC_SOUND_EVENT,		// explosion flags
		0, 										// distanceFromAttacker
		0, 										// explosionForce
		DF_SKIPS_DOOMED_STATE,					// damage flags
		eDamageSourceId.landing_zone					// damage source id
	)

	HoverVehicle_WakeVehiclesIntersectingEntity( inflictor )

	#if DEVELOPER
		if ( debugDraw )
		{
			 //DebugDrawCylinder( pos, <270.0, 0.0, 0.0>, innerRadius, 20.0, <255, 0, 0>, true, 5.0 )
			 //DebugDrawCylinder( pos, <270.0, 0.0, 0.0>, outerRadius, 20.0, <255, 0, 0>, true, 5.0 )
		}
	#endif
}

void function DropPod_OnLandingZoneDamage( entity target, var damageInfo )
{
	if ( !target.IsPlayer() )
		return

	DamageInfo_ScaleDamage( damageInfo, 0.0 )
}

void function OnDroppodPushAway( entity dropPod )
{
	thread OnDroppodPushAwayThread( dropPod )
}

void function OnDroppodPushAwayThread( entity dropPod )
{
	entity trigger = CreateEntity( "trigger_cylinder" )
	trigger.RemoveFromAllRealms()
	trigger.AddToOtherEntitysRealms( dropPod )
	trigger.SetRadius( 100 ) // S3: SetCylinderRadius → SetRadius
	trigger.SetAboveHeight( 256 )
	trigger.SetBelowHeight( 32 )
	trigger.SetOrigin( dropPod.GetOrigin() )
	trigger.SetEnterCallback( PushAway )
	trigger.kv.triggerFilterNpc = "all"
	trigger.kv.triggerFilterPlayer = "all"
	trigger.kv.triggerFilterNonCharacter = 0
	DispatchSpawn( trigger )

	trigger.SetParent( dropPod, "REF", false, 0.0 )
	trigger.SearchForNewTouchingEntity()  // set this to catch an entity in the trigger right away

	EndSignal( dropPod, "OnDestroy" )
	EndSignal( trigger, "OnDestroy" )

	OnThreadEnd(
		function () : ( trigger )
		{
			if ( IsValid( trigger ) )
				trigger.Destroy()
		}
	)

	dropPod.WaitSignal( "DroppodLanded" )
}

void function PushAway( entity trigger, entity ent )
{
	if ( ent.DoesShareRealms( trigger ) )
		thread PushAwayThread( trigger, ent )
}

void function PushAwayThread( entity trigger, entity ent )
{
	EndSignal( trigger, "OnDestroy" )
	EndSignal( ent, "OnDestroy" )

	while( trigger.IsTouching( ent ) )
	{
		vector v = Normalize( ent.GetOrigin() - trigger.GetOrigin() )

		v = Normalize( <v.x,v.y,0> )

		if ( Length( v ) < 0.5 )
			v = <1,0,0>

		ent.SetVelocity( v*350 )
		WaitFrame()
	}
}

void function JetwashFX( entity vehicle )
{
	vehicle.EndSignal( "StopBraking" )

	while ( IsValid( vehicle ) )
	{
		int attach = vehicle.LookupAttachment( "ORIGIN" )

		vector origin = vehicle.GetOrigin()

		if ( attach != 0 )
			origin = vehicle.GetAttachmentOrigin( attach )
		TraceResults result = TraceLine( origin - <0,0,60>, origin - <0,0,2000>, vehicle, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
		if ( result.fraction < 1.0 )
		{
			PlayImpactFXTable( result.endPos, vehicle, "dropship_dust" )
		}
		wait 0.2
	}
}