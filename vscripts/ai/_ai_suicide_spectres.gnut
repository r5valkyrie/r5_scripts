const float SPECTRE_MAX_SIGHT_DIST = 3000.0
void function MakeSuicideSpectre( entity spectre )
{
	if ( IsCreature( spectre ) ) // For whatever reason, loot ticks are creatures so they get filtered out here
		return

	spectre.SetAimAssistAllowed( true )
	spectre.SetAllowMelee( false )
	DisableLeeching( spectre )

	spectre.SetNPCMoveSpeedScale( 1.0 )

	spectre.EnableNPCMoveFlag( NPCMF_IGNORE_CLUSTER_DANGER_TIME | NPCMF_PREFER_SPRINT )
	spectre.DisableNPCMoveFlag( NPCMF_FOLLOW_SAFE_PATHS )

	spectre.kv.allowShoot = 0

	// Frag drones do suicide spectre behavior but we don't want them doing the enemy changed sounds so filter them out
	if ( !IsFragDrone( spectre ) && !IsTick( spectre ) )
		spectre.SetEnemyChangeCallback( SuicideSpectreEnemyChanged )

	spectre.SetLookDistOverride( SPECTRE_MAX_SIGHT_DIST )
	//spectre.SetHearingSensitivity( 10 ) //1 is default
	spectre.EnableNPCFlag( NPC_MUTE_TEAMMATE )

	spectre.ai.suicideSpectreExplosionDelay = -1

	AddAnimEvent( spectre, "frag_drone_armed", FragDroneArmed )
	thread SpectreWaitToExplode( spectre )
}

void function FragDroneArmed( entity npc )
{
	npc.ai.fragDroneArmed = true
}

void function FragDroneDeath( entity spectre, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	FragDroneDeath_Think( spectre, damageInfo )
}

// for reloadscripts
void function FragDroneDeath_Think( entity tick, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	//printf( "%s() - health: %d, killedSelf: %s, attacker: %s", FUNC_NAME(), tick.GetHealth(), (tick.ai.fragDroneKilledSelfWithSelfDestruct ? "YES" : "no"), string( attacker ) )

	vector pos = tick.GetOrigin()
	int tagID = tick.LookupAttachment( "CHESTFOCUS" )
	vector fxOrg = tick.GetAttachmentOrigin( tagID )

	if ( ( tick.ai.fragDroneInertWhenKilled && !tick.ai.fragDroneKilledSelfWithSelfDestruct ) || tick.ai.lootTickExplode )
	{
		switch( tick.ai.lootTickHighestLootLevel )
		{
                               
			case VALENTINES_SPECIAL_EVENT_LOOT_TIER:
				//Play Date Night Explosion
				EmitSoundAtPosition( tick.GetTeam(), pos, "DateNight_LootTick_Explosion", tick )
				EmitSoundAtPosition( tick.GetTeam(), pos, "LootTick_Vocal_Death", tick )
				break
      

                    

			case GOLDEN_HORSE_SPECIAL_EVENT_LOOT_TIER:
				//TODO: Golden Horse Explosion?
				EmitSoundAtPosition( tick.GetTeam(), pos, "Goldenhorse_LootTick_Cactuar_Explosion", tick )
				EmitSoundAtPosition( tick.GetTeam(), pos, "Goldenhorse_LootTick_Cactuar_Death", tick )
				break
      

			default:
				EmitSoundAtPosition( tick.GetTeam(), pos, "LootTick_Explosion", tick )
				EmitSoundAtPosition( tick.GetTeam(), pos, "LootTick_Vocal_Death", tick )
				break

		}

		if ( tick.ai.lootTickExplode )
		{
			tick.Gib( <0,0,100> )
			int expFX = GetParticleSystemIndex( FX_LOOT_TICK_EXPLOSION )
			entity fx = StartParticleEffectInWorld_ReturnEntity( expFX, fxOrg, tick.GetAngles() )

			switch( tick.ai.lootTickHighestLootLevel )
			{
                               
				case VALENTINES_SPECIAL_EVENT_LOOT_TIER:
					//We're currently playing the heart explosion on top of the normal explosion
					//which contains bits of loot tick
					EffectSetControlPointColorById( fx, 1, COLORID_HUD_LOOT_TIER_SPECIAL )
					Valentines_LootTickDeathFX( tick, damageInfo )
					break
      
                    

				case GOLDEN_HORSE_SPECIAL_EVENT_LOOT_TIER:
					//We're currently playing the heart explosion on top of the normal explosion
					//which contains bits of loot tick
					EffectSetControlPointColorById( fx, 1, COLORID_HUD_LOOT_TIER_GH )
					//Valentines_LootTickDeathFX( tick, damageInfo )
					StartParticleEffectInWorld( GetParticleSystemIndex( GOLDEN_HORSE_LOOT_TICK_VFX ), tick.GetOrigin() + <0, 0, 32>, tick.GetAngles() )
					break
      

				default:
					EffectSetControlPointColorById( fx, 1, COLORID_FX_LOOT_TIER0 + tick.ai.lootTickHighestLootLevel )
					break
			}

			thread DestroyFXAfterDelay_Thread( fx, 3.0 )
		}
		else
		{
			EmitSoundAtPosition( tick.GetTeam(), pos, "LootTick_Explosion", tick )
			EmitSoundAtPosition( tick.GetTeam(), pos, "LootTick_Vocal_Death", tick )
			int expFX = GetParticleSystemIndex( $"P_impact_exp_smll_air" )
			StartParticleEffectInWorld( expFX, fxOrg, tick.GetAngles() )
		}
		return
	}

	string expSFX
	if ( tick.mySpawnOptions_aiSettings == "npc_frag_drone_throwable" )
		expSFX = SFX_FRAGDRONE_EXPLODE
	else
		expSFX = SFX_TICK_EXPLODE
	int expFX = GetParticleSystemIndex( FX_SPECTRE_EXPLOSION )

	int team = GetExplosionTeamBasedOnGamemode( tick )

	RadiusDamage_DamageDefSimple( damagedef_frag_drone_throwable_PLAYER, pos, attacker, tick, 0 )
	EmitSoundAtPosition( tick.GetTeam(), pos, expSFX, tick )
	CreateShake( pos, 10, 105, 1.25, 768 )
	StartParticleEffectInWorld( expFX, fxOrg, <0,0,0> )

	/*
	int damageType = DamageInfo_GetCustomDamageType( damageInfo )
	damageType = (damageType | DF_GIB)
	DamageInfo_SetDamage( damageInfo, (tick.GetMaxHealth() + 1) )
	DamageInfo_SetCustomDamageType( damageInfo, damageType )
	*/
	tick.Gib( <0,0,100> ) //Used to do .Destroy() on the frag drones immediately, but this meant you can't display the obiturary correctly. Instead, since it's dead already just hide it
}

                               
void function Valentines_LootTickDeathFX( entity lootTick, var damageInfo )
{
	//Spawn Valentines Day VFX
	vector angles = lootTick.GetAngles()

	//Spin vfx so the heart faces the attacker (get the best angle every time)
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( IsValid( attacker ) )
	{
		vector dir = VectorToAngles( attacker.GetOrigin() - lootTick.GetOrigin() )
		angles = <0, dir.y, 0>
	}
	StartParticleEffectInWorld( GetParticleSystemIndex( VALENTINES_LOOT_TICK_VFX ), lootTick.GetOrigin() + <0, 0, 32>, angles )
}
      

entity function GetNPCAttackerEnt( entity npc, entity attacker )
{
	entity owner = npc.GetBossPlayer()
	bool ownerIsPlayer = owner != null && owner.IsPlayer()

	return ownerIsPlayer ? owner : npc
}

void function SuicideSpectreEnemyChanged( entity spectre )
{
	// Spectre "Speaks"
	if ( ( RandomFloat( 1.0 ) ) < 0.02 )
		EmitSoundOnEntity( spectre, "diag_imc_spectre_gs_spotenemypilot_01_1" )
}

