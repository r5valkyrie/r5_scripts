\************************************************************************************************/
void function OnFragDroneDamaged( entity spectre, var damageInfo )
{
	if ( IsCreature( spectre ) && !spectre.IsMechanical() ) //PROTO: prototyping an organic spider off of the tick AI
		return

	SpectreSuicideOnDamaged( spectre, damageInfo )
}


void function SpectreSuicideOnDamaged( entity npc, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	int damageType 	= DamageInfo_GetCustomDamageType( damageInfo )

	if ( npc.ai.fragDroneCanKnockback )
	{
		if ( attacker.IsPlayer() && IsBitFlagSet( damageType, DF_MELEE ) && npc.IsInterruptable() )
		{
			vector origin = npc.GetOrigin()
			origin.z += 10
			npc.SetOrigin( origin )

			npc.ai.fragDronePunchedAway = true
			npc.ai.suicideSpectreExplodingAttacker = attacker

			npc.EnableNPCFlag( NPC_IGNORE_ALL )
			npc.ClearEnemy()
			npc.ClearEnemyMemory()

			npc.Anim_Stop()
			npc.Anim_Play( "sd_angry_idle" )

			vector playerForward = attacker.GetForwardVector()
			playerForward.z = 0.25
			npc.SetVelocity( Normalize( playerForward ) * 1500.0 )

			DamageInfo_SetDamage( damageInfo, 0 )
		}
	}

	DamageInfo_SetCustomDamageType( damageInfo, damageType )

	//if ( npc.ai.lootTickExplode )
	//	DamageInfo_AddCustomDamageType( damageInfo, DF_NO_INDICATOR )


	if ( !IsAlive( npc ) )
		return

	entity inflictor 			= DamageInfo_GetInflictor( damageInfo )
	float damage				= DamageInfo_GetDamage( damageInfo )
	int damageSourceId 			= DamageInfo_GetDamageSourceIdentifier( damageInfo )

	// No pain anims for suicide spectres
	DamageInfo_AddDamageFlags( damageInfo, DAMAGEFLAG_NOPAIN )

	/*if ( !npc.ai.fragDroneInertWhenKilled && !npc.ai.lootTickExplode )
		npc.Signal( "SuicideSpectreExploding" )*/

	if ( !IsValid( inflictor ) || !inflictor.IsPlayer() )
	{
		if ( npc.ai.suicideSpectreExplodingAttacker == null )
		{
			if ( !npc.ai.fragDroneInertWhenKilled && !npc.ai.lootTickExplode && npc.ai.fragDroneArmed )
			{
				if ( ((npc.GetHealth() - damage) <= 0) || (IsValid( inflictor ) && IsTick( inflictor )) )
				{
					float explosionTime = GetSpectreExplosionTime( npc )
					SetSuicideSpectreExploding( npc, attacker, explosionTime )
					DamageInfo_SetDamage( damageInfo, 0 )
					return
				}
			}
		}
		else
		{
			// already exploding
			DamageInfo_SetDamage( damageInfo, 0 )
			return
		}

		DamageInfo_SetDamage( damageInfo, damage )
	}
}

void function OnDamagedByFragDrone( entity victim, var damageInfo )
{
	if ( !IsValid( victim ) || !victim.IsPlayer() )
		return

	float curTime = Time()
	if ( victim in file.playerLastDamagedTime && file.playerLastDamagedTime[ victim ] + DRONE_EXPLOSION_IMMUNITY_TIME > curTime )
	{
		DamageInfo_SetDamage( damageInfo, 0.0 )
		return
	}

	file.playerLastDamagedTime[ victim ] <- curTime
}

void function PlayWarningFXOnMPFragDrone( entity drone )
{
	thread PlayWarningFXOnMPFragDrone_Internal( drone )
}

void function PlayWarningFXOnMPFragDrone_Internal( entity drone )
{
	array<entity> fxEnts
	int attachementIndex = drone.LookupAttachment( "head_base" )
	entity fxEnt = StartParticleEffectOnEntity_ReturnEntity( drone, PILOT_THROWN_TICK_WARNING_FX, FX_PATTACH_POINT_FOLLOW, attachementIndex )
	fxEnts.append( fxEnt )

	EndSignal( drone, "OnDeath", "OnDestroy" )

	OnThreadEnd(
		function() : ( fxEnts )
		{
			foreach ( ent in fxEnts )
				EffectStop( ent )
		}
	)

	WaitForever()
}
#endif

#if CLIENT
void function PlayWarningFXOnSPTick( entity tick ) //Moved from server script to client because of way too many fx handles.
{
	thread PlayWarningFXOnSPTick_Internal( tick )
}

void function PlayWarningFXOnSPTick_Internal( entity tick ) //Moved from server script to client because of way too many fx handles.
{
	array<int> fxEnts

	//First play the warning FX on the head base
	int headBaseAttachmentIndex = tick.LookupAttachment( "head_base" )
	int headBaseFXEnt = StartParticleEffectOnEntity( tick, AI_GENERATED_TICK_WARNING_FX, FX_PATTACH_POINT_FOLLOW, headBaseAttachmentIndex )
	fxEnts.append( headBaseFXEnt )

	//Then play warn_beams on head_light attachments
	for ( int i = 1; i < 26; ++i )
	{
		string attachmentName = "head_light_" + i
		int attachementIndex = tick.LookupAttachment( attachmentName )
		int fxEnt = StartParticleEffectOnEntity( tick, AI_GENERATED_TICK_WARNING_BEAMS_FX, FX_PATTACH_POINT_FOLLOW, attachementIndex )
		fxEnts.append( fxEnt )
	}

	tick.EndSignal( "OnDeath" )

	OnThreadEnd(
		function() : ( fxEnts )
		{
			foreach ( ent in fxEnts )
				EffectStop( ent, false, true )
		}
	)

	WaitForever()
}
#endif