#if SERVER
const FX_SPECTRE_EXPLOSION				= $"P_drone_frag_exp"
const asset FX_LOOT_TICK_EXPLOSION		= $"P_loot_tick_exp_CP"
                               
const asset VALENTINES_LOOT_TICK_VFX = $"P_Deathfx_HeartSmoke"
      
                    
const asset GOLDEN_HORSE_LOOT_TICK_VFX = $"P_loot_tick_CT_exp_CP"
      
int PILOT_THROWN_TICK_WARNING_FX
#elseif CLIENT
int AI_GENERATED_TICK_WARNING_FX
int AI_GENERATED_TICK_WARNING_BEAMS_FX
#endif

struct
{
	#if SERVER
		int chainExplosionIndex
		float lastChainExplosionTime
		float startupDelay

		table< string, array<string> > spectreAnims
		float nextOverloadTime
		table< entity, float > playerLastDamagedTime
	#endif
} file

#if SERVER
const SFX_TICK_OVERLOAD 				= "corporate_spectre_overload_beep"
const SFX_TICK_EXPLODE 					= "corporate_spectre_death_explode"

const SFX_FRAGDRONE_OVERLOAD 			= "weapon_sentryfragdrone_preexplo"
const SFX_FRAGDRONE_EXPLODE 			= "weapon_sentryfragdrone_explo"
const SFX_FRAGDRONE_SUPERPURSUIT		= "weapon_sentryfragdrone_superpursuit"

const float DRONE_EXPLOSION_IMMUNITY_TIME = 1.0
#endif

void function SuicideSpectres_Init()
{
	#if SERVER
	RegisterSignal( "SuicideSpectreExploding" )

	PrecacheParticleSystem( FX_SPECTRE_EXPLOSION )
	PrecacheParticleSystem( FX_LOOT_TICK_EXPLOSION )
	                               
		PrecacheParticleSystem( VALENTINES_LOOT_TICK_VFX )
       
	                    
		PrecacheParticleSystem( GOLDEN_HORSE_LOOT_TICK_VFX )
       

	PILOT_THROWN_TICK_WARNING_FX = PrecacheParticleSystem( $"P_drone_frag_warn_sm" )

	file.spectreAnims[ "spectreSearch" ] <- []
	file.spectreAnims[ "spectreSearch" ].append( "sp_suicide_spectre_search" )
	file.spectreAnims[ "spectreSearch" ].append( "sp_suicide_spectre_search_B" )
	file.spectreAnims[ "spectreSearch" ].append( "sp_suicide_spectre_search_C" )

	AddDamageCallback( "npc_frag_drone", OnFragDroneDamaged )
	AddDeathCallback( "npc_frag_drone", FragDroneDeath )
	AddDamageCallbackSourceID( eDamageSourceId.damagedef_frag_drone_throwable_PLAYER, OnDamagedByFragDrone )
	#endif

	Remote_RegisterClientFunction( "PlayWarningFXOnSPTick", "entity" )

	#if CLIENT
		AI_GENERATED_TICK_WARNING_FX = PrecacheParticleSystem( $"P_drone_frag_warn" )
		AI_GENERATED_TICK_WARNING_BEAMS_FX = PrecacheParticleSystem( $"P_drone_frag_warn_beams" )
	#endif
}

