	}
}


bool function CodeCallback_CanStartCustomWeaponActivity( entity player, int activity )
{
	if ( activity in s_callbacksCanStartCustomWeaponActivity )
	{
		foreach ( func in s_callbacksCanStartCustomWeaponActivity[ activity ] )
		{
			if ( !func( player, activity ) )
				return false
		}
	}

	return true
}


string function CodeCallback_CheckPassThroughAddsMods( entity player, entity hitEnt, string currWeaponName )
{
	entity passingEntOrWeapon = null
	array<string> currMods = []
	vector hitPos = <0,0,0>
	Warning("Found code callback CodeCallback_CheckPassThroughAddsMods, but its type of string functionref( entity, entity, entity, string, array< string >, vector ) doesn't match the required type of string functionref( entity, entity, string )")
	foreach ( func in s_callbacksOnPassThrough )
	{
		func( player, hitEnt, hitPos )
	}

	if ( !IsValid( player ) )
		return ""

	if ( StatusEffect_HasSeverity( hitEnt, eStatusEffect.pass_through_amps_weapon ) )
	{
		if ( passingEntOrWeapon.IsProjectile() )
		{
			if ( currMods.contains( "amped_damage" ) || currMods.contains( "amped_damage_alt" ) )
			{
				#if SERVER
					if ( IsAmpedWallEnt( hitEnt ) )
						hitEnt.TakeDamage( hitEnt.GetMaxHealth(), player, player, { damageSourceId = passingEntOrWeapon.ProjectileGetDamageSourceID() } )
				#endif
			}
		}
		else if ( passingEntOrWeapon.IsWeaponX() )
		{
			if ( currMods.contains( "amped_damage" ) || currMods.contains( "amped_damage_alt"  ) )
			{
				#if SERVER
					if ( IsAmpedWallEnt( hitEnt ) )
						hitEnt.TakeDamage( hitEnt.GetMaxHealth(), player, player, { damageSourceId = passingEntOrWeapon.GetDamageSourceID() } )
				#endif
			}

			if ( passingEntOrWeapon.GetWeaponBaseClassName() == "mp_weapon_energy_ar" )
			{
				return "amped_damage_alt"
			}
		}

                                  
                                                         
    
                             
    
        
		return "amped_damage"
	}

	//%if HAS_SILVERSHOT
	//	if ( hitEnt.GetScriptName() == BALLISTIC_ENTANGLEMENT_FLOOR_PLATFORM_SCRIPTNAME )
	//		return "silvershot_no_impact_fx"
	//%endif

	return ""
}


