void function Bounty_CleanUp( entity dataPad )
{
	if ( IsValid( dataPad ) )
	{
		entity mover = dataPad.GetParent()

		if ( IsValid( mover ) )
			mover.Destroy()

		if ( IsValid( dataPad ) )
			dataPad.Destroy()
	}
}

void function Bounty_TrackRavenSpawn( entity player )
{
	EndSignal( player, "OnDestroy" )
	EndSignal( player, "OnDeath" )

	int spawnOrder = 0
	int playerTeam = player.GetTeam()
	array< entity > players = GetPlayerArrayOfTeam_Alive( playerTeam )
	vector spawnLocation = player.GetOrigin() + <RandomInt( 75 ), RandomInt( 75 ), 0>
	vector safeSpotOnNavmesh = NavMesh_GetClosestPoint( spawnLocation )
	entity hunt
	if ( Bounty_ShouldSpawnHunt( player ) )
	{
		if ( players.len() > 0 )
		{
			if ( player.entindex() == players[spawnOrder].entindex() )
			{
				hunt = Bounty_SpawnWhiteRaven( player, safeSpotOnNavmesh, < 90, 90, 90 >, players )
			}

			spawnOrder++
			if ( spawnOrder >= players.len() )
			{
				spawnOrder = 0
			}
		}
	}

	OnThreadEnd(
		function() : ( hunt )
		{
			Bounty_CleanUp( hunt )
		}
	)

	while ( IsValid( player ) )
	{
		wait BOUNTY_SPAWN_INTERVAL

		Bounty_CleanUp( hunt )

		if ( Bounty_ShouldSpawnHunt( player ) )
		{
			players = GetPlayerArrayOfTeam_Alive( playerTeam )

			if ( players.len() > 0 && spawnOrder < players.len() )
			{
				if ( player.entindex() == players[spawnOrder].entindex() )
				{
					spawnLocation = player.GetOrigin() + < RandomInt( 75 ), RandomInt( 75 ), 0 >
					safeSpotOnNavmesh = NavMesh_GetClosestPoint( spawnLocation )
					hunt = Bounty_SpawnWhiteRaven( player, safeSpotOnNavmesh, < 90, 90, 90 >, players )
				}
				spawnOrder++
				if ( spawnOrder >= players.len() )
				{
					spawnOrder = 0
				}
			}
			else
			{
				spawnOrder = 0
				if ( player.entindex() == players[spawnOrder].entindex() )
				{
					spawnLocation = player.GetOrigin() + < RandomInt( 75 ), RandomInt( 75 ), 0 >
					safeSpotOnNavmesh = NavMesh_GetClosestPoint( spawnLocation )
					hunt = Bounty_SpawnWhiteRaven( player, safeSpotOnNavmesh, < 90, 90, 90 >, players )
				}
				spawnOrder++
				if ( spawnOrder >= players.len() )
				{
					spawnOrder = 0
				}
			}
		}
	}
}

bool function Bounty_ShouldSpawnHunt( entity player )
{
	if ( !IsValid( player ) )
		return false

	int hunterTeam = player.GetTeam()

	if ( hunterTeam in file.hunterTeamsRecord || hunterTeam in file.preyTeamsRecord )
		return false

	array< int > availablePreyTeams
	array< int > teams = GetAllValidPlayerTeams()
	int aliveTeamsCount = 0

	foreach ( playerTeam in teams )
	{
		if ( GetPlayerArrayOfTeam_Alive( playerTeam ).len() >= 1 )
		{
			aliveTeamsCount++
		}
	}

	if ( aliveTeamsCount <= 2 )
	{
		return false
	}

	foreach ( team in teams )
	{
		if ( team != hunterTeam && GetPlayerArrayOfTeam_Alive( team ).len() >= 1 && !( team in file.preyTeamsRecord ) && !( team in file.hunterTeamsRecord ) )
		{
			availablePreyTeams.append( team )
		}
	}

	//does not allow prey team to hunt its hunter
	if ( hunterTeam in file.preyTeamsRecord )
	{
		availablePreyTeams.removebyvalue( file.preyTeamsRecord[hunterTeam] )
	}

	int closesPreyTeam = -1
	float closesDistance = FLT_MAX

	foreach ( preyTeam in availablePreyTeams )
	{
		array< entity > preyPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )

		float distanceSqr = DistanceSqr( player.GetOrigin(), preyPlayers[0].GetOrigin() )

		if ( distanceSqr < closesDistance && distanceSqr < MAX_DISTANCE_ALLOWED_SQR )
		{
			closesPreyTeam = preyTeam
			closesDistance = distanceSqr
		}

	}

	if ( closesPreyTeam != -1 )
	{
		return true
	}

	return false
}

entity function Bounty_SpawnWhiteRaven( entity player, vector birdOrigin, vector birdAngles, array< entity > players )
{
	if ( !IsValid( player ) )
		return null

	entity dataPad = SpawnGenericLoot( "sh_bounty_hunt", birdOrigin + < 0, 0, 25 >, birdAngles, 1 )
	dataPad.SetSkin( 3 )
	dataPad.SetOwner( player )
	SetTeam( dataPad, player.GetTeam() )
	EmitSoundOnEntity( dataPad, HUNT_DATAPAD_SPAWN_SOUND )
	//bird.SetScriptName( TRACKING_VISION_BIRD_SCRIPTNAME )
	//dataPad.SetVisibilityFlags( ENTITY_VISIBLE_TO_OWNER )

	foreach ( friendlyPlayer in players )
	{
		Remote_CallFunction_NonReplay( friendlyPlayer, "ServerToClient_Bounty_ActivateWhiteRavenIconRUI", friendlyPlayer, dataPad )
		Remote_CallFunction_NonReplay( friendlyPlayer, "ServerToClient_ActivateDataPadFX", friendlyPlayer, dataPad )
	}

	entity mover = CreateScriptMover( "hunt_datapad_rotator", birdOrigin, birdAngles )
	dataPad.SetParent( mover )

	thread Rotate_DataPad_Thread( dataPad, mover, player )

	return dataPad
}

void function Rotate_DataPad_Thread( entity dataPad, entity mover, entity owner )
{
	EndSignal( dataPad, "OnDestroy" )
	EndSignal( mover, "OnDestroy" )

	const float interval = 1.0 // I suggest tweaking this to affect rotation speed
	const vector angleDelta = < 0.0, 0.0, 179.0 >

	while ( IsValid( dataPad ) && IsValid( mover ) )
	{
		mover.NonPhysicsRotateTo( mover.GetAngles() + angleDelta, interval, 0.0, 0.0 )

		wait interval

		if ( !Bounty_ShouldSpawnHunt( owner ) )
		{
			dataPad.Destroy()
			mover.Destroy()
		}
	}
}

