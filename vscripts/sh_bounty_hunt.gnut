void function BountyHunt_Init()
{
	PrecacheModel( TEMP_HUNT_PAD )
	PrecacheParticleSystem( VFX_HUNT_LOOTTICK_SPAWN )
	PrecacheParticleSystem( VFX_HUNT_DATAPAD_IDEL )
	PrecacheParticleSystem( VFX_THE_HUNT_LOCK_ON )

	RegisterSignal( BOUNTY_END_SIGNAL )

	RegisterNetworkedVariable( HUNT_NETVAR_STATE, SNDC_PLAYER_EXCLUSIVE, SNVT_INT, eBountyHuntState.NONE )
	RegisterNetworkedVariable( HUNT_NETVAR_THREAT_LEVEL, SNDC_PLAYER_EXCLUSIVE, SNVT_INT, eBountyHuntThreatLevel.NONE )
	RegisterNetworkedVariable( HUNT_NETVAR_PREY_REMAINING, SNDC_PLAYER_EXCLUSIVE, SNVT_INT, 0 )
	RegisterNetworkedVariable( HUNT_NETVAR_TOTAL_PREY, SNDC_PLAYER_EXCLUSIVE, SNVT_INT, 0 )
	RegisterNetworkedVariable( HUNT_NETVAR_END_TIME, SNDC_PLAYER_EXCLUSIVE, SNVT_TIME, -1 )

	#if CLIENT
		RegisterNetVarIntChangeCallback( HUNT_NETVAR_STATE, OnBountyHuntStateChanged_Client )
		RegisterNetVarIntChangeCallback( HUNT_NETVAR_THREAT_LEVEL, OnBountyHuntThreatLevelChanged_Client )
		RegisterNetVarIntChangeCallback( HUNT_NETVAR_PREY_REMAINING, OnBountyHuntPreyRemainingChanged_Client )
		RegisterNetVarIntChangeCallback( HUNT_NETVAR_TOTAL_PREY, OnBountyHuntTotalPreyChanged_Client )
		RegisterNetVarTimeChangeCallback( HUNT_NETVAR_END_TIME, OnBountyHuntEndTimeChanged_Client )
	#endif

	Remote_RegisterClientFunction( "ServerToClient_HandleShowEnemyLocation", "entity", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_ActivateDataPadFX", "entity", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_Bounty_ActivateWhiteRavenIconRUI", "entity", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_DisplayHuntStart", "entity" )
	Remote_RegisterClientFunction( "ServerToClient_SendHuntAnnouncement", "int", 0, eBountyHuntAnnouncements.COUNT )
	Remote_RegisterClientFunction( "ServerToClient_ApplyHunterVFX", "entity", "int", 0, ABSOLUTE_MAX_TEAMS + 1 )
	Remote_RegisterClientFunction( "ServerToClient_ClientHuntEndSignal", "entity" )
#if SERVER


	AddCallback_OnPlayerKilled( Bounty_OnPlayerKill )
	AddCallback_OnPlayerRespawned( Bounty_OnPlayerRespawned )
	AddCallback_OnSurvivalDeathFieldStageChanged( OnDeathfieldStageChanged )
#endif

#if CLIENT
	Hunt_OverrideGameState()
	Hunt_CreateStateDataTable()
	Hunt_CreateAnnouncementDataTable()
	AddCallback_GameStateEnter( eGameState.Playing, Bounty_CreateNestedHuntHud )
#endif

	RegisterCustomItemPickupAction( "sh_bounty_hunt", Bounty_ItemPickup )
}

#if SERVER
void function GiveBounty( entity player )
{
	if ( !IsValid( player ) )
		return

	int hunterTeam = player.GetTeam()

	if ( hunterTeam in file.hunterTeamsRecord || hunterTeam in file.preyTeamsRecord )
		return

	array < int > availablePreyTeams
	array < int > teams = GetAllValidPlayerTeams()
	int aliveTeamsCount = 0

	foreach ( playerTeam in teams )
	{
		if ( GetPlayerArrayOfTeam_Alive( playerTeam ).len() >= 1 )
		{
			aliveTeamsCount++
		}
	}

	if ( aliveTeamsCount <= 2 )
	{
		return
	}

	foreach ( team in teams )
	{
		if ( team != hunterTeam && GetPlayerArrayOfTeam_Alive( team ).len() >= 1 && !( team in file.preyTeamsRecord ) && !( team in file.hunterTeamsRecord ) )
		{
			availablePreyTeams.append( team )
		}
	}

	//does not allow prey team to hunt its hunter
	if ( hunterTeam in file.preyTeamsRecord )
	{
		availablePreyTeams.removebyvalue( file.preyTeamsRecord[hunterTeam] )
	}

	int closesPreyTeam = -1
	float closesDistance = FLT_MAX

	foreach ( preyTeam in availablePreyTeams )
	{
		array < entity > preyPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )

		float distanceSqr = DistanceSqr( player.GetOrigin(), preyPlayers[0].GetOrigin() )

		if ( distanceSqr < closesDistance )
		{
			closesPreyTeam = preyTeam
			closesDistance = distanceSqr
		}
	}

	thread PlayFirstPersonAnimation( player, ANIM_THE_HUNT_PICK_UP )

	if ( closesPreyTeam != -1 )
	{
		//int preyTeam = availablePreyTeams[RandomInt( availablePreyTeams.len() )]
		file.hunterTeamsRecord[ hunterTeam ] <- closesPreyTeam
		file.preyTeamsRecord[ closesPreyTeam ] <- hunterTeam
		if ( closesDistance <= CLOSE_DISTANCE_SQR )
		{
			BOUNTY_DURATION = 240
		}
		else if	( closesDistance >= FAR_DISTANCE_SQR )
		{
			BOUNTY_DURATION = 480
		}
		else
		{
			BOUNTY_DURATION = 360
		}
		HuntStart( player, hunterTeam, closesPreyTeam )
	}
}

void function PingPreyLocation( entity attacker, entity victim )
{
	CreateWaypoint_Ping_Location( attacker, ePingType.THE_HUNT_AREA_HUNTER, victim, victim.GetOrigin(), -1, false, true )
}

void function PingHunterLocation( entity attacker, entity victim )
{
	CreateWaypoint_Ping_Location( attacker, ePingType.THE_HUNT_AREA_PREY, victim, victim.GetOrigin(), -1, false, true )
}

void function HuntStart( entity hunter, int hunterTeam, int preyTeam )
{
	thread TrackHunt_Thread( hunter, hunterTeam, preyTeam )
	thread Bounty_PingTeams_Thread( hunterTeam, preyTeam )
	thread Bounty_UpdatePreyThreatMeter_Thread( hunterTeam, preyTeam )
	Bounty_HandleBountyStatusEffect_Start( hunterTeam, preyTeam )

	array< entity > hunterTeamPlayers = GetPlayerArrayOfTeam_Alive( hunterTeam )
	array< entity > preyTeamPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )

	foreach ( hunterPlayer in hunterTeamPlayers )
	{
		PlayBattleChatterLineToPlayer( "bc_Hunt_BeginHunter", hunterPlayer, hunterPlayer )
	}

	foreach ( preyPlayer in preyTeamPlayers )
	{
		Remote_CallFunction_NonReplay( preyPlayer, "ServerToClient_ApplyHunterVFX", preyPlayer, hunterTeam )
		PlayBattleChatterLineToPlayer( "bc_Hunt_BeginPrey", preyPlayer, preyPlayer )
	}


}

void function TrackHunt_Thread( entity hunter, int hunterTeam, int preyTeam )
{
	float bailTime = Time() + BOUNTY_DURATION

	OnThreadEnd(
		function() : ( hunterTeam, preyTeam )
		{
			array< entity > hunterTeamPlayers = GetPlayerArrayOfTeam_Alive( hunterTeam )
			array< entity > preyTeamPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )

			if ( hunterTeam in file.hunterTeamsRecord )
			{
				if ( hunterTeamPlayers.len() >= 1 && preyTeamPlayers.len() >= 1 )
				{
					foreach ( hunter in hunterTeamPlayers )
					{
						Remote_CallFunction_NonReplay( hunter, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_EXPIRED )
						PlayBattleChatterLineToPlayer( "bc_Hunt_FailHunter", hunter, hunter )
						hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
					}
				}
			}

			if ( preyTeam in file.preyTeamsRecord )
			{
				Bounty_HuntFinish( hunterTeam, preyTeam )
				if ( preyTeamPlayers.len() >= 1 && hunterTeamPlayers.len() >= 1 )
				{
					foreach ( prey in preyTeamPlayers )
					{
						Remote_CallFunction_NonReplay( prey, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.PREY_SUCCESS )
						Remote_CallFunction_NonReplay( prey, "ServerToClient_ClientHuntEndSignal", prey )
						prey.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
						PlayBattleChatterLineToPlayer( "bc_Hunt_FailPrey", prey, prey )
						UpgradeCore_IncrementXP( prey, 200, false, eUpgradeXPActions.HUNTSURVIVED, true )
					}
				}
			}
		}
	)

	bool hasNotifiedHuntersOfLowTime = false
	while ( Time() < bailTime )
	{
		if ( GetPlayerArrayOfTeam_Alive( hunterTeam ).len() <= 0 )
		{
			break
		}
		if ( GetPlayerArrayOfTeam_Alive( preyTeam ).len() <= 0 )
		{
			break
		}

		// If our remaining time is low, we update the Hunter UI state to show low time
		if ( !hasNotifiedHuntersOfLowTime )
		{
			float timeRemaining = bailTime - Time()
			if ( timeRemaining <= SECONDS_PER_MINUTE )
			{
				hasNotifiedHuntersOfLowTime = true

				array< entity > hunterTeamPlayers = GetPlayerArrayOfTeam_Alive( hunterTeam )
				foreach ( hunterPlayer in hunterTeamPlayers )
				{
					hunterPlayer.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.HUNTER_LOW_TIME )
					EmitSoundOnEntityOnlyToPlayer( hunterPlayer, hunterPlayer, HUNT_TIME_RUNNING_OUT_SOUND )
				}
			}
		}

		wait 1
	}
}

void function Bounty_PingTeams_Thread( int hunterTeam, int preyTeam )
{
	while ( hunterTeam in file.hunterTeamsRecord )
	{
		array< entity > preyPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )
		foreach ( target in preyPlayers )
		{
			Assert( IsValid( target ) )
			if ( IsAlive( target  ) )
			{
				array < entity > hunterPlayers = GetPlayerArrayOfTeam_Alive( hunterTeam )
				foreach ( hunterPlayer in hunterPlayers )
				{
					Remote_CallFunction_NonReplay( hunterPlayer, "ServerToClient_HandleShowEnemyLocation", hunterPlayer, target )
					float distanceSqr = DistanceSqr( hunterPlayer.GetOrigin(), target.GetOrigin() )
					if ( distanceSqr >= PREY_DETECT_RANGE_CLOSE_SQR )
					{
						PingPreyLocation( hunterPlayer, target )
					}
					else
					{
						PingPreyLocation( hunterPlayer, target )
						PingHunterLocation( target, hunterPlayer )
					}
				}
			}
		}

		wait PREY_SCAN_TIME
	}
}

void function Bounty_UpdatePreyThreatMeter_Thread( int hunterTeam, int preyTeam )
{
	while ( hunterTeam in file.hunterTeamsRecord )
	{
		array< entity > preyPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )
		foreach ( target in preyPlayers )
		{
			Assert( IsValid( target ) )
			if ( IsAlive( target ) )
			{
				float closestDistance = FLT_MAX
				array< entity > hunterPlayers = GetPlayerArrayOfTeam_Alive( hunterTeam )
				foreach ( hunterPlayer in hunterPlayers )
				{
					float distance = DistanceSqr( hunterPlayer.GetOrigin(), target.GetOrigin() )
					if ( distance < closestDistance )
						closestDistance = distance
				}

				// If no hunters are left alive and we just haven't been updated about it yet, let's not set the state
				if ( hunterPlayers.len() > 0 )
				{
					// Set High/Medium/Low here
					int threatLevel = eBountyHuntThreatLevel.LOW

					if ( closestDistance >= PREY_DETECT_RANGE_MID_SQR )
					{
						threatLevel = eBountyHuntThreatLevel.LOW
					}
					else if ( closestDistance >= PREY_DETECT_RANGE_CLOSE_SQR && closestDistance < PREY_DETECT_RANGE_MID_SQR )
					{
						threatLevel = eBountyHuntThreatLevel.MEDIUM
					}
					else
					{
						threatLevel = eBountyHuntThreatLevel.HIGH
					}

					// Set the threat state for the prey player
					target.SetPlayerNetInt( HUNT_NETVAR_THREAT_LEVEL, threatLevel )
				}
			}
		}

		wait HUNTER_SCAN_TIME
	}
}

void function Bounty_HuntFinish( int hunterTeam, int preyTeam )
{
	//Bounty_HandleBountyStatusEffect_End( hunterTeam, preyTeam )

	delete file.hunterTeamsRecord[hunterTeam]
	delete file.preyTeamsRecord[preyTeam]
}

void function SpawnBountyReward( entity player, vector location )
{
	array< string > rewards = SURVIVAL_GetMultipleWeightedItemsFromGroup( "crate_weapons_earlygame", 1 )
	foreach ( thing in file.lootRefs )
	{
		rewards.append( thing )
	}
	vector spawnLocation = location + <RandomInt( 75 ), RandomInt( 75 ), 0>
	vector safeSpotOnNavmesh = NavMesh_GetClosestPoint( spawnLocation )

	entity tick = LootTicks_SpawnLootTickAtOrigin( safeSpotOnNavmesh, <0, 0, 0>, rewards, 5 )
	tick.SetSkin( 108 )
	PutEntityInSafeSpot( tick, null, null, safeSpotOnNavmesh, safeSpotOnNavmesh )

	EmitSoundOnEntity( tick, HUNT_LOOT_TICK_SPAWN_SOUND )

	int fxIndex = GetParticleSystemIndex( VFX_HUNT_LOOTTICK_SPAWN )

	thread CreateLootBeam( tick )

	StartParticleEffectInWorld( fxIndex, safeSpotOnNavmesh, <0, 0, 0> )
}

void function CreateLootBeam( entity tick )
{
	tick.EndSignal( "OnDeath" )
	tick.EndSignal( "OnDestroy" )

	int beamIndex = GetParticleSystemIndex( FX_AIRDROP_BEAM_CP )
	entity beamFx = StartParticleEffectInWorld_ReturnEntity( beamIndex, tick.GetOrigin(), tick.GetAngles() + <0, 180, 0> )
	EffectSetControlPointColorById( beamFx, 1, COLORID_HUD_LOOT_TIER_SPECIAL )
	OnThreadEnd(
		function() : ( beamFx )
		{
			if ( IsValid( beamFx ) )
				beamFx.Destroy()
		}
	)
	WaitForever()
}

bool function Bounty_CheckForTeamBleedout( int team )
{
	array<entity> teamPlayers = GetPlayerArrayOfTeam( team )
	foreach ( entity teamPlayer in teamPlayers )
	{
		if ( IsAlive( teamPlayer ) && !Bleedout_IsBleedingOut( teamPlayer ) )
			return false

		if ( IsAlive( teamPlayer ) && Bleedout_IsBleedingOut( teamPlayer ) && ( Bleedout_GetSelfResEnabled( teamPlayer ) || Bleedout_IsPlayerGettingFirstAid( teamPlayer ) ) )
			return false
	}

	return true
}

void function Bounty_OnPlayerKill( entity victim, entity attacker, var damageInfo )
{
	if ( IsValid( victim ) && IsValid( attacker ) )
	{
		int attackTeam = attacker.GetTeam()
		int victimTeam = victim.GetTeam()

		if ( victimTeam in file.diedTeams )
			return

		if ( Bounty_CheckForTeamBleedout( victimTeam ) )
		{
			//check if hunter killed prey
			if ( attackTeam in file.hunterTeamsRecord )
			{
				if ( file.hunterTeamsRecord[attackTeam] == victimTeam )
				{
					array< entity > hunterPlayers = GetPlayerArrayOfTeam_Alive( attackTeam )
					foreach ( hunter in hunterPlayers )
					{
						UpgradeCore_IncrementXP( hunter, 500, false, eUpgradeXPActions.HUNTSUCCESS, true )
						Remote_CallFunction_NonReplay( hunter, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_SUCCESS )
						PlayBattleChatterLineToPlayer( "bc_Hunt_SuccessHunter", hunter, hunter )
						hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
					}
					SpawnBountyReward( attacker, victim.GetOrigin() )
					file.diedTeams[ victimTeam ] <- true
				}
			}
			//check if prey killed hunter
			if ( attackTeam in file.preyTeamsRecord )
			{
				if ( file.preyTeamsRecord[attackTeam] == victimTeam )
				{
					array< entity > preyPlayers = GetPlayerArrayOfTeam_Alive( attackTeam )
					foreach ( prey in preyPlayers )
					{
						UpgradeCore_IncrementXP( prey, 500, false, eUpgradeXPActions.HUNTSUCCESS, true )
						Remote_CallFunction_NonReplay( prey, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.PREY_KILLED_HUNTERS )
						PlayBattleChatterLineToPlayer( "bc_Hunt_FailPrey", prey, prey )
						prey.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
						Remote_CallFunction_NonReplay( prey, "ServerToClient_ClientHuntEndSignal", prey )
					}
					SpawnBountyReward( attacker, victim.GetOrigin() )
					file.diedTeams[ victimTeam ] <- true
				}
			}
			//if a hunter team died by some other reason
			if ( victimTeam in file.hunterTeamsRecord )
			{
				if ( file.hunterTeamsRecord[victimTeam] != attackTeam )
				{
					int preyTeam = file.hunterTeamsRecord[victimTeam]
					array< entity > preyPlayers = GetPlayerArrayOfTeam_Alive( preyTeam )
					foreach ( prey in preyPlayers )
					{
						UpgradeCore_IncrementXP( prey, 200, false, eUpgradeXPActions.HUNTSURVIVED, true )
						Remote_CallFunction_NonReplay( prey, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.PREY_SUCCESS )
						prey.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
						Remote_CallFunction_NonReplay( prey, "ServerToClient_ClientHuntEndSignal", prey )
					}
					file.diedTeams[ victimTeam ] <- true
				}
			}
			//if a prey team died by some other reason
			if ( victimTeam in file.preyTeamsRecord )
			{
				if ( file.preyTeamsRecord[victimTeam] != attackTeam )
				{
					int hunterTeam = file.preyTeamsRecord[victimTeam]
					array< entity > hunterPlayer = GetPlayerArrayOfTeam_Alive( hunterTeam )
					foreach ( hunter in hunterPlayer )
					{
						Remote_CallFunction_NonReplay( hunter, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_POACHED )
						PlayBattleChatterLineToPlayer( "bc_Hunt_FailHunter", hunter, hunter )
						hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
					}
				}
				file.diedTeams[ victimTeam ] <- true
			}
		}
		else
		{
			// If any targets are stil alive, we need to update the Hunter's HUD showing how many players are still alive
			//check if hunter killed prey
			if ( attackTeam in file.hunterTeamsRecord )
			{
				if ( file.hunterTeamsRecord[attackTeam] == victimTeam )
				{
					int totalPreyCount = GetPlayerArrayOfTeam( victimTeam ).len()
					int remainingPreyCount = GetPlayerArrayOfTeam_Alive( victimTeam ).len()
					array< entity > hunterPlayers = GetPlayerArrayOfTeam_Alive( attackTeam )
					foreach ( hunter in hunterPlayers )
					{
						// Update that player's remaining prey count & flash the status update bar
						hunter.SetPlayerNetInt( HUNT_NETVAR_TOTAL_PREY, totalPreyCount )
						hunter.SetPlayerNetInt( HUNT_NETVAR_PREY_REMAINING, remainingPreyCount )
						// TODO We may bring this splash back, currently being discussed
						//Remote_CallFunction_NonReplay( hunter, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_MARK_ELIMINATED )
						hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.HUNTER_PULSE )
					}
				}
			}

			//if a prey died by some other reason
			if ( victimTeam in file.preyTeamsRecord )
			{
				if ( file.preyTeamsRecord[victimTeam] != attackTeam )
				{
					int totalPreyCount = GetPlayerArrayOfTeam( victimTeam ).len()
					int remainingPreyCount = GetPlayerArrayOfTeam_Alive( victimTeam ).len()
					int hunterTeam = file.preyTeamsRecord[victimTeam]
					array< entity > hunterPlayer = GetPlayerArrayOfTeam_Alive( hunterTeam )
					foreach ( hunter in hunterPlayer )
					{
						// Update that player's remaining prey count & flash the status update bar
						hunter.SetPlayerNetInt( HUNT_NETVAR_TOTAL_PREY, totalPreyCount )
						hunter.SetPlayerNetInt( HUNT_NETVAR_PREY_REMAINING, remainingPreyCount )
						// TODO We may bring this splash back, currently being discussed
						//Remote_CallFunction_NonReplay( hunter, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_MARK_POACHED )
						hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.HUNTER_PULSE )
					}
				}
			}
		}
	}
}

void function Bounty_OnPlayerRespawned( entity player )
{
	if ( IsValid( player ) )
	{
		// Check if the player is on a prey team
		int playerTeam = player.GetTeam()
		if ( playerTeam in file.preyTeamsRecord )
		{
			// Get prey team player counts
			int totalPreyCount = GetPlayerArrayOfTeam( playerTeam ).len()
			int remainingPreyCount = GetPlayerArrayOfTeam_Alive( playerTeam ).len()

			int hunterTeam = file.preyTeamsRecord[playerTeam]
			array< entity > hunterPlayer = GetPlayerArrayOfTeam_Alive( hunterTeam )
			foreach ( hunter in hunterPlayer )
			{
				// Update that player's remaining prey count & flash the status update bar
				hunter.SetPlayerNetInt( HUNT_NETVAR_TOTAL_PREY, totalPreyCount )
				hunter.SetPlayerNetInt( HUNT_NETVAR_PREY_REMAINING, remainingPreyCount )
				hunter.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.HUNTER_PULSE )
			}
		}
		else
		{
			player.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
		}

	}
}

void function OnDeathfieldStageChanged( int stage, float nextCircleStartTime )
{
	if ( GameModeVariant_IsActive( eGameModeVariants.SURVIVAL_THE_HUNT ) )
	{
		if ( file.canGetHunt == false )
		{
			file.canGetHunt = true
			//delay it a bit allow all players to land before start the hunt
			thread PlayHuntAvaiableCommentary_thread()
		}
	}
}

void function PlayHuntAvaiableCommentary_thread()
{
	wait GetTheHuntStartWaitTime()
	array< entity > playerArray = GetPlayerArray()
	foreach ( player in playerArray )
	{
		if ( IsValid( player ) )
		{
			if ( IsAlive( player ) )
			{
				thread Bounty_TrackRavenSpawn( player )
				player.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.NONE )
				WaitFrame()
				if ( IsValid( player ) )
				{
					player.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.AVAILABLE )
					Remote_CallFunction_NonReplay( player, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTS_AVAILABLE )
				}

			}
		}
	}
	thread PlayCommentaryLineToAllPlayers( PickCommentaryLineFromBucket( eSurvivalCommentaryBucket.HUNT_AVAIABLE ) )
}

void function Bounty_HandleBountyStatusEffect_Start( int hunterTeam, int preyTeam )
{
	array< entity > hunterPlayers = GetPlayerArrayOfTeam( hunterTeam )
	array< entity > preyPlayers = GetPlayerArrayOfTeam( preyTeam )

	// Get the prey team counts for the Hunter HUD
	int totalPreyCount = GetPlayerArrayOfTeam( preyTeam ).len()
	int remainingPreyCount = preyPlayers.len()

	float bountyEndTime = Time() + BOUNTY_DURATION

	foreach ( hunterPlayer in hunterPlayers )
	{
		if ( IsValid( hunterPlayer ) )
		{
			//int effectHandle = StatusEffect_AddTimed( hunterPlayer, eStatusEffect.has_active_bounty, 1.0, BOUNTY_DURATION, 0.0 )
			//file.effectRecord[hunterPlayer] <- effectHandle

			// Send the prey counts to the hunter
			hunterPlayer.SetPlayerNetInt( HUNT_NETVAR_TOTAL_PREY, totalPreyCount )
			hunterPlayer.SetPlayerNetInt( HUNT_NETVAR_PREY_REMAINING, remainingPreyCount )

			// Set the end time for the UI
			hunterPlayer.SetPlayerNetTime( HUNT_NETVAR_END_TIME, bountyEndTime )

			// Send hunter messaging
			Remote_CallFunction_NonReplay( hunterPlayer, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.HUNTER_START )
			hunterPlayer.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.HUNTER_INTRO )
		}
	}

	foreach ( preyPlayer in preyPlayers )
	{
		if ( IsValid( preyPlayer ) )
		{
			//int effectHandle = StatusEffect_AddTimed( preyPlayer, eStatusEffect.has_active_bounty, 1.0, BOUNTY_DURATION, 0.0 )
			//file.effectRecord[preyPlayer] <- effectHandle

			// Set the end time for the UI
			preyPlayer.SetPlayerNetTime( HUNT_NETVAR_END_TIME, bountyEndTime )

			// Send prey messaging
			Remote_CallFunction_NonReplay( preyPlayer, "ServerToClient_SendHuntAnnouncement", eBountyHuntAnnouncements.PREY_START )
			preyPlayer.SetPlayerNetInt( HUNT_NETVAR_THREAT_LEVEL, eBountyHuntThreatLevel.NONE )
			preyPlayer.SetPlayerNetInt( HUNT_NETVAR_STATE, eBountyHuntState.PREY )
		}
	}
}

void function Bounty_HandleBountyStatusEffect_End( int hunterTeam, int preyTeam )
{
	array< entity > hunterPlayers = GetPlayerArrayOfTeam( hunterTeam )
	array< entity > preyPlayers = GetPlayerArrayOfTeam( preyTeam )

	foreach ( hunterPlayer in hunterPlayers )
	{
		if ( hunterPlayer in file.effectRecord )
		{
			if ( IsValid( hunterPlayer ) )
			{
				StatusEffect_Stop( hunterPlayer, file.effectRecord[hunterPlayer] )
			}
		}
	}

	foreach ( preyPlayer in preyPlayers )
	{
		if ( preyPlayer in file.effectRecord )
		{
			if ( IsValid( preyPlayer ) )
			{
				StatusEffect_Stop( preyPlayer, file.effectRecord[preyPlayer] )
			}

		}
	}
}
