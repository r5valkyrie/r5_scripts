const int FPS_THRESHOLD_DEFAULT_VALUE = 55

#if SERVER
const asset CANYONLANDS_TESTING_POINTS = $"datatable/map_metrics/canyonlands_testing_points.rpak"
const asset DESERTLANDS_TESTING_POINTS = $"datatable/map_metrics/desertlands_testing_points.rpak"
const asset OLYMPUS_TESTING_POINTS = $"datatable/map_metrics/olympus_testing_points.rpak"
const asset TROPICS_TESTING_POINTS = $"datatable/map_metrics/tropic_island_testing_points.rpak"
const asset DIVIDED_MOON_TESTING_POINTS = $"datatable/map_metrics/divided_moon_testing_points.rpak"

const array<string> INTERNAL_MAP_NAMES = [ "canyonlands", "desertlands", "olympus", "tropic_island", "divided_moon" ]
const array<asset> ADDITIONAL_POINTS_DATATABLES = [ CANYONLANDS_TESTING_POINTS, DESERTLANDS_TESTING_POINTS, OLYMPUS_TESTING_POINTS, TROPICS_TESTING_POINTS, DIVIDED_MOON_TESTING_POINTS ]

const int MAPMETRICS_NAVMESH_MAXDISTANCE = 250
const int GRID_SQUARE_SIDE_LENGTH_DEFAULT_VALUE = 4096
const float TIME_FOR_GPU_PROFILER_TO_COLLECT_DATA = 12.0
const bool MAPMETRICS_TIMING = false
const bool MAPMETRICS_DEBUG = false
const float TRACE_START_HEIGHT = 30000

const string MAPMETRICS_MOVER_SCRIPTNAME = "mapmetrics_mover"

struct ScreenshotPoint
{
	Point point
	string fileName
}
#endif

#if CLIENT
const int FRAME_TIME_BUFFER_SIZE = 32
const float FRAME_TIME_MIN_WAIT = 1.0 // sec
const float FRAME_TIME_MAX_WAIT = 3.0 // sec
const float FRAME_TIME_RETRY_WAIT = 1.0 // sec
const float FRAME_TIME_MAX_RETRIES = 3
const float FRAME_TIME_STDEV_TOLERANCE = 0.0001 // Means +/- .1ms before frames considered stable
#endif

struct
{
	#if SERVER
		bool stopMapMetrics
		float startTime
	#endif

	#if CLIENT
		array<int> bandwidthInArray
		array<int> bandwidthOutArray
		string metricsFileName
		string metricsDataBuffer
		array<string> metricsDataCategories
		bool metricsOutputRSON
		float stabilityThreshold

		bool oldDvsEnable
		bool oldPerfMetricsDrawingEnabled
		int oldPerfMetrics
		int	oldFpsMax
		int oldVsyncMode
		int oldNotFocusSleep
		bool exitOnCompletion
	#endif

	int fpsThreshold
} file


void function MapMetrics_Init()
{
	#if SERVER
		if ( GetCurrentPlaylistName().find( "map_metrics" ) != -1 )
			AddCallback_OnPlayerMatchStateChanged( MapMetrics_OnPlayerMatchStateChanged )

		RegisterSignal( "ClientRecordMetricsData" )
	#endif
}

void function MapMetrics_RegisterNetworking()
{
	if ( GetCurrentPlaylistName().find( "map_metrics" ) < 0 )
		return

	Remote_RegisterClientFunction( "MapMetrics_ClientTakeScreenshot", "entity", "vector", -MAX_MAP_BOUNDS, MAX_MAP_BOUNDS, 32, "vector", -200.0, 200.0, 32 )
	Remote_RegisterClientFunction( "MapMetrics_ClientBeginMapMetrics", "int", 0, INT_MAX )
	Remote_RegisterClientFunction( "MapMetrics_ClientEndMapMetrics" )
	Remote_RegisterClientFunction( "MapMetrics_ClientRecordDataPoint", "entity", "vector", -32000.0, 32000.0, 32, "vector", -200.0, 200.0, 32, "int", -100, 100 )

	Remote_RegisterServerFunction( "MapMetrics_OnClientRecordMetricsData", "int", 0, INT_MAX )
	Remote_RegisterServerFunction( "MapMetrics_OnClientTakeScreenshot" )
}

#if SERVER
void function MapMetrics_OnPlayerMatchStateChanged( entity player, int oldValue, int newValue  )
{
	if ( newValue != ePlayerMatchState.NORMAL )
		return
	thread MapMetrics_ServerRunMainLoop( player )
}

void function MapMetrics_ServerBeginMapMetrics( entity player, entity mover, array<entity> hurtTriggers, array<entity> oobTriggers )
{
	// Set player traits
	player.SetAngles( <0, 0, 0> )
	player.SnapEyeAngles( <0, 0, 0> )
	player.SetParent( mover, "", false )
	player.SetInvulnerable()
	player.FreezeControlsOnServer()
	//player.FreezeHudControlsOnServer()

	// Disable hurt triggers
	foreach ( entity trigger in hurtTriggers )
		trigger.Disable()

	// Disable oob triggers
	foreach ( entity trigger in oobTriggers )
		trigger.Disable()

	SetConVarBool( "idleKickTime_never_kick", true )
	SetConVarBool( "viewDrift", false )

	#if MAPMETRICS_TIMING
		printt( "MAP METRICS: STARTING TO CAPTURE MAP METRICS..." )
	#endif

	file.stopMapMetrics = false
	file.fpsThreshold = GetCurrentPlaylistVarInt( "map_metrics_fps_threshold", FPS_THRESHOLD_DEFAULT_VALUE )
	file.startTime = Time()
}

void function MapMetrics_ServerEndMapMetrics( entity player, entity mover, array<entity> hurtTriggers, array<entity> oobTriggers )
{
	player.ClearParent()
	player.ClearInvulnerable()
	player.UnfreezeControlsOnServer()
	//player.UnfreezeHudControlsOnServer()

	// Re-enable hurt triggers
	foreach ( entity trigger in hurtTriggers )
		trigger.Enable()

	// Re-enable oob triggers
	foreach ( entity trigger in oobTriggers )
		trigger.Enable()

	SetConVarBool( "viewDrift", true )

	#if MAPMETRICS_TIMING
		float elapsedTime = Time() - file.startTime
		printt( "MAP METRICS: DONE COLLECTING FPS DATA\n" + "MAP METRICS: Time spent collecting fps data: " + elapsedTime + " seconds" )
	#endif

	file.stopMapMetrics = false
	file.fpsThreshold = 0
	file.startTime = 0
}

int function GetMapRadius()
{
	return MAX_MAP_BOUNDS.tointeger()
}

array<Point> function GetSamplePoints( entity player, array<entity> hurtTriggers, array<entity> oobTriggers )
{
	array<Point> outPositions = []

	int gridSquareSideLength = GetCurrentPlaylistVarInt( "map_metrics_grid_square_side_length", GRID_SQUARE_SIDE_LENGTH_DEFAULT_VALUE )

	int MAP_EXTENTS             = GetMapRadius()
	int GRID_SQUARE_SIDE_LENGTH = gridSquareSideLength
	int numIterations           = ( MAP_EXTENTS * 2 ) / GRID_SQUARE_SIDE_LENGTH

	for ( float yIt = 0; yIt <= numIterations; yIt++ )
	{
		float y = -MAP_EXTENTS + (yIt * GRID_SQUARE_SIDE_LENGTH)
		for ( float xIt = 0; xIt <= numIterations; xIt++ )
		{
			float x = -MAP_EXTENTS + (xIt * GRID_SQUARE_SIDE_LENGTH)
			array< vector > points = [<0,0,0>,<0,0,0>]//NavMesh_GetPointsInDifferentElevations( < x, y, 0.0 > )

			foreach ( vector point in points )
			{
				// Skip if trace result is in a hurt trigger.
				bool isInHurtTrigger = false
				foreach ( entity trigger in hurtTriggers )
				{
					if ( trigger.ContainsPoint( point ) )
					{
						isInHurtTrigger = true
						break
					}
				}
				if ( isInHurtTrigger )
					continue;

				// Skip if trace result is in an OOB trigger.
				bool isInOOBTrigger  = false
				foreach ( entity trigger in oobTriggers )
				{
					if ( trigger.ContainsPoint( point ) )
					{
						isInOOBTrigger = true
						break
					}
				}
				if ( isInOOBTrigger )
					continue

				// Passed all checks, generate sample points looking N/S/E/W
				for ( int dir = 0; dir < 4; dir++ )
				{
					Point samplePoint
					samplePoint.origin = point
					samplePoint.angles = <0, 90 * dir, 0>
					outPositions.append( samplePoint )
				}
			}
		}
	}

	return outPositions
}

void function MapMetrics_ServerRunMainLoop( entity player )
{
	Assert( GetPlayerArray().len() == 1, "There must be exactly one player in the map to run map metrics. Found " + GetPlayerArray().len() )

	entity mover = CreateScriptMover( MAPMETRICS_MOVER_SCRIPTNAME, player.GetOrigin(), <0, 0, 0> )
	array<entity> hurtTriggers = GetEntArrayByClass_Expensive( "trigger_hurt" )
	array<entity> oobTriggers = GetEntArrayByClass_Expensive( "trigger_out_of_bounds" )
	MapMetrics_ServerBeginMapMetrics( player, mover, hurtTriggers, oobTriggers )

	array<ScreenshotPoint> screenshotPoints = []

	int gridSquareSideLength = GetCurrentPlaylistVarInt( "map_metrics_grid_square_side_length", GRID_SQUARE_SIDE_LENGTH_DEFAULT_VALUE )
	Remote_CallFunction_NonReplay( player, "MapMetrics_ClientBeginMapMetrics", gridSquareSideLength )

	OnThreadEnd( function() : ( player, mover, hurtTriggers, oobTriggers, screenshotPoints ) {

		Remote_CallFunction_NonReplay( player, "MapMetrics_ClientEndMapMetrics" )

		//TODO: screenshots don't work on console builds.  Need to hook into devnet for screenshots functionality on console.
		//thread CollectScreenShots( screenshotPoints, player, mover )

		MapMetrics_ServerEndMapMetrics( player, mover, hurtTriggers, oobTriggers )

		mover.Destroy()
	} )

	//Wait a few moments for the GPU profiler to start collecting data.
	wait TIME_FOR_GPU_PROFILER_TO_COLLECT_DATA

	if ( file.stopMapMetrics )
		return

	array<Point> samplePoints = ReadAdditionalPointsFromFile()
	if ( !GetCurrentPlaylistVarBool( "map_metrics_only_additional_points", false ) )
		samplePoints.extend( GetSamplePoints( player, hurtTriggers, oobTriggers ) )

	for ( int i = 0; i < samplePoints.len(); i++ )
	{
		if ( file.stopMapMetrics )
			return
		waitthread MapMetrics_ReportFPSAtPoint_Thread( player, mover, samplePoints[i], screenshotPoints )
	}
}

array<Point> function ReadAdditionalPointsFromFile()
{
	array<Point> additionalTestingPoints
	var dt

	string currentMapName = GetMapName()
	bool foundDataTable = false
	for ( int i = 0; i < INTERNAL_MAP_NAMES.len(); i++ )
	{
		string internalMapName = INTERNAL_MAP_NAMES[i]
		if ( currentMapName.find( internalMapName ) != -1 )
		{
			dt = GetDataTable( ADDITIONAL_POINTS_DATATABLES[i] )
			foundDataTable = true
			break
		}
	}

	if ( !foundDataTable )
		return additionalTestingPoints

	int rowCount = GetDataTableRowCount( dt )
	int posCol = GetDataTableColumnByName( dt, "position" )
	int angCol = GetDataTableColumnByName( dt, "angle" )

	for ( int i = 0; i < rowCount; i++ )
	{
		Point newPoint
		newPoint.origin = GetDataTableVector( dt, i, posCol )
		newPoint.angles = GetDataTableVector( dt, i, angCol )
		additionalTestingPoints.append( newPoint )
	}

	return additionalTestingPoints
}

void function MapMetrics_ReportFPSAtPoint_Thread( entity player, entity mover, Point point, array<ScreenshotPoint> screenshotPoints )
{
	mover.SetOrigin( point.origin )
	mover.SetAngles( <0, 0, 0> )
	player.SnapEyeAngles( point.angles )

	int zoneId = MapZones_GetZoneForOrigin( point.origin )
	Remote_CallFunction_NonReplay( player, "MapMetrics_ClientRecordDataPoint", player, point.origin, point.angles, zoneId )
	int fps = expect int( WaitSignal( player, "ClientRecordMetricsData" ).fps )

	if ( fps < file.fpsThreshold )
	{
		ScreenshotPoint newScreenshotPoint
		newScreenshotPoint.point.origin = point.origin
		newScreenshotPoint.point.angles = point.angles
		newScreenshotPoint.fileName = CreateScreenShotFileName( point.origin, point.angles )
		screenshotPoints.append( newScreenshotPoint )
	}
}

void function CollectScreenShots( array<ScreenshotPoint > screenshotPoints, entity player, entity mover )
{
	#if MAPMETRICS_TIMING
		float startTime = Time()
		printt( "MAP METRICS: Starting to capture screenshots for low fps spots..." )
	#endif

	foreach( ScreenshotPoint screenshotPoint in screenshotPoints )
	{
		mover.SetOrigin( screenshotPoint.point.origin )
		mover.SetAngles( <0, 0, 0> )
		player.SnapEyeAngles( screenshotPoint.point.angles )

		wait 0.2

		Remote_CallFunction_NonReplay( player, "MapMetrics_ClientTakeScreenshot", player, screenshotPoint.point.origin, screenshotPoint.point.angles )
		WaitSignal( player, "ClientRecordMetricsData" )
	}

	#if MAPMETRICS_TIMING
		printt( "MAP METRICS: DONE COLLECTING SCREENSHOTS" )

		float timeSpent = Time() - startTime
		printt( "MAP METRICS: Time spent collecting screenshots: " + timeSpent )

		printt( "##############################" )
		printt( " DONE COLLECTING METRICS DATA " )
		printt( "##############################" )
	#endif
}

void function MapMetrics_OnClientRecordMetricsData( entity player, int fps )
{
	player.Signal( "ClientRecordMetricsData", { fps = fps } )
}

void function MapMetrics_OnClientTakeScreenshot( entity player )
{
	player.Signal( "ClientRecordMetricsData" )
}

#endif //SERVER

#if CLIENT
void function MapMetrics_ClientTakeScreenshot( entity player, vector position, vector angles )
{
	string screenshotFileName = CreateScreenShotFileName( position, angles )
	player.ClientCommand( "jpeg " + screenshotFileName )
	Remote_ServerCallFunction( "MapMetrics_OnClientTakeScreenshot" )
}

const string METRICS_FPS = "FPS"
const string METRICS_MEMORY = "Free memory"
const string METRICS_VIEWPORT_SCALE = "Viewport scale"
const string METRICS_NET_IN = "Network Bandwidth In (KiB/s)"
const string METRICS_NET_OUT = "Network Bandwidth Out (KiB/s)"

void function MapMetrics_InitFile( int fpsThreshold, int gridSize, array<string> metricsCategories )
{
	string mapName = GetMapName()
	string hardware = GetPlatformName()
	string buildType = GetBuildType()
	string buildString = GetGameVersion()

	int buildNum = buildString.slice( buildString.find( "#" ) + 1 ).tointeger()
	file.metricsFileName = format( "metrics_%s_%s_CL#%i.%s", mapName, hardware, buildNum, file.metricsOutputRSON ? "mtr" : "csv" )
	file.metricsDataCategories = metricsCategories

	if ( file.metricsOutputRSON )
	{
		// this sucks, arguably, but we don't have code support for generating rsons from script, so it's really the best we can do
		file.metricsDataBuffer +=
			"{\n" +
			"\t\"VisualisationData\": { \"AutoresolveName\":\"" + mapName + "\" },\n" +
			"\t\"SampleDateTime\":\"" + GetDateTimeString( GetUnixTimestamp() ) + "\",\n" +
			"\t\"RootNode\": {\n" +
			"\t\t\"Name\":\"" + mapName + "\",\n" +
			"\t\t\"Hardware\":\"" + hardware + "\",\n" +
			"\t\t\"BuildID\":" + buildNum + ",\n" +
			"\t\t\"FPSThreshold\":" + fpsThreshold + ",\n" +
			"\t\t\"GridSize\":" + gridSize + ",\n" +
			"\t\t\"Children\": {\n" +
			"\t\t\t\"RProf\": [\n"
	}
	else
	{
		file.metricsDataBuffer = "Hardware,Build ID,Map,Fps Threshold,Grid Square Side Length,Zone,Zone name,Position"
		foreach( string category in metricsCategories )
		{
			file.metricsDataBuffer += ","
			file.metricsDataBuffer += category
		}
		file.metricsDataBuffer += "\n"

		file.metricsDataBuffer += format( "%s,%s,%s,%i,%i", hardware, buildString + " (" + buildType + ")", mapName, fpsThreshold, gridSize )
		foreach( string category in metricsCategories )
		{
			file.metricsDataBuffer += ","
		}
		file.metricsDataBuffer += "\n"
	}

	#if MAPMETRICS_DEBUG
		printt( "MAP METRICS: metricsFileName: " + file.metricsFileName + ",fpsThreshold: " + file.fpsThreshold )
	#endif
}

void function MapMetrics_AppendSnapshotToFile( vector position, vector angles, int zoneId, string zoneName, table<string, float> metricsKeyValues )
{
	if ( file.metricsOutputRSON )
	{
		vector forward = AnglesToForward( angles )
	
		file.metricsDataBuffer +=
			"\t\t\t\t{\n" +
			"\t\t\t\t\t\"Name\":\"" + format( "RPROFx%fy%fz%fdx%fdy%fdz%f", position.x, position.y, position.z, forward.x, forward.y, forward.z ) + "\",\n" +
			"\t\t\t\t\t\"MetricsSet\": {\n" +
			"\t\t\t\t\t\t\"Context\": \"Ingame Rprof\",\n" +
			"\t\t\t\t\t\t\"ZoneID\":" + zoneId + ",\n" +
			"\t\t\t\t\t\t\"ZoneName\":\"" + zoneName + "\",\n" +
			"\t\t\t\t\t\t\"Position\": { x:" + position.x + ", y:" + position.y + ", z:" + position.z + " },\n" +
			"\t\t\t\t\t\t\"Direction\": { x:" + forward.x + ", y:" + forward.y + ", z:" + forward.z + " },\n" +
			"\t\t\t\t\t\t\"Metrics\": {\n"


		foreach( string category in file.metricsDataCategories )
		{
			file.metricsDataBuffer +=
			"\t\t\t\t\t\t\t\"" + category + "\":" + metricsKeyValues[ category ] + ",\n"
		}

		file.metricsDataBuffer +=
			"\t\t\t\t\t\t}\n" +
			"\t\t\t\t\t}\n" +
			"\t\t\t\t},\n"
	}
	else
	{
		file.bandwidthInArray.append( metricsKeyValues[ METRICS_NET_IN ].tointeger() )
		file.bandwidthOutArray.append( metricsKeyValues[ METRICS_NET_OUT ].tointeger() )

		file.metricsDataBuffer += ",,,,,"
		file.metricsDataBuffer += zoneId + ","
		file.metricsDataBuffer += zoneName + ","
		file.metricsDataBuffer += "setpos " + position.x + " " + position.y + " " + position.z + "; setang " + angles.x + " " + angles.y + " " + angles.z

		foreach( string category in file.metricsDataCategories )
		{
			file.metricsDataBuffer += ","
			file.metricsDataBuffer += metricsKeyValues[ category ].tostring()
		}
		file.metricsDataBuffer += "\n"
	}
}

void function MapMetrics_ClientEndMapMetrics()
{
	//RecordNetworkBandwidth()

	if ( file.metricsOutputRSON )
	{
		file.metricsDataBuffer +=
			"\t\t\t]\n" +
			"\t\t}\n" +
			"\t}\n" +
			"}\n"
	}

	WriteMetricsDataToFile( file.metricsFileName, "map_metrics", file.metricsDataBuffer, true )

	file.metricsDataBuffer = ""
	file.metricsFileName = ""
	file.fpsThreshold = 0

	//Restore client convars
	SetConVarBool( "dvs_enable", file.oldDvsEnable )
	SetConVarBool( "perf_metrics_drawing_enabled", file.oldPerfMetricsDrawingEnabled )
	SetConVarInt( "perf_metrics", file.oldPerfMetrics )
	SetConVarInt( "fps_max", file.oldFpsMax )
	SetConVarInt( "not_focus_sleep", file.oldNotFocusSleep )
	if ( HasConVar( "mat_vsyncMode" ) )
		SetConVarInt( "mat_vsyncMode", file.oldVsyncMode )

	if ( file.exitOnCompletion )
	{
		#if MAPMETRICS_DEBUG
			printt( "MAP METRICS: exiting game client" )
		#endif
		ExitGameClient()
	}
}

void function MapMetrics_ClientBeginMapMetrics( int gridSize )
{
	string buildVersion = GetGameVersion()

	file.exitOnCompletion = GetCurrentPlaylistVarBool( "map_metrics_exit_on_completion", false ) || Dev_CommandLineHasParm( "-mapmetricsexitoncompletion" )
	file.metricsOutputRSON = GetCurrentPlaylistVarBool( "map_metrics_output_rson", false ) || Dev_CommandLineHasParm( "-mapmetricsrson" )
	file.fpsThreshold = GetCurrentPlaylistVarInt( "map_metrics_fps_threshold", FPS_THRESHOLD_DEFAULT_VALUE )
	file.stabilityThreshold = GetCurrentPlaylistVarFloat( "map_metrics_stability_threshold", FRAME_TIME_STDEV_TOLERANCE )
	bool adaptiveScalingOn = GetCurrentPlaylistVarBool( "map_metrics_adaptive_scaling", false )

	array<string> metricsLabels = [ METRICS_FPS, METRICS_MEMORY, METRICS_VIEWPORT_SCALE, METRICS_NET_IN, METRICS_NET_OUT ]
	for ( int i = 0; i < GetPerfDataLabelCount(); i++ )
	{
		metricsLabels.append( GetPerfDataLabelName( i ) );
	}

	MapMetrics_InitFile( file.fpsThreshold, gridSize, metricsLabels )

	// Save old client convar values
	file.oldDvsEnable = GetConVarBool( "dvs_enable" )
	file.oldPerfMetricsDrawingEnabled = GetConVarBool( "perf_metrics_drawing_enabled" )
	file.oldPerfMetrics = GetConVarInt( "perf_metrics" )
	file.oldFpsMax = GetConVarInt( "fps_max" )
	file.oldNotFocusSleep = GetConVarInt( "not_focus_sleep" )
	if ( HasConVar( "mat_vsyncMode" ) )
		file.oldVsyncMode = GetConVarInt( "mat_vsyncMode" )

	// Set client convars necessary for gathering metrics data
	SetConVarBool( "dvs_enable", adaptiveScalingOn )
	SetConVarBool( "perf_metrics_drawing_enabled", false )
	SetConVarInt( "perf_metrics", 3 )
	SetConVarInt( "fps_max", 0 )
	SetConVarInt( "not_focus_sleep", 0 )
	if ( HasConVar( "mat_vsyncMode" ) )
		SetConVarInt( "mat_vsyncMode", 0 )
}

void function MapMetrics_ClientRecordDataPoint( entity player, vector position, vector angles, int zoneId )
{
	thread MapMetrics_ClientRecordDataPoint_Thread( player, position, angles, zoneId )
}

void function WaitForFPSToSettle()
{
	float startTime = Time()

	wait FRAME_TIME_MIN_WAIT

	array<float> frameTimeBuffer
	for ( int i = 0; i < FRAME_TIME_BUFFER_SIZE; i++ )
	{
		frameTimeBuffer.append( RenderFrameTime() )
		WaitFrame()
	}

	while( Time() - startTime < FRAME_TIME_MAX_WAIT )
	{
		float variance = CalculateFloatArrayVarianceWithGivenPercentile( frameTimeBuffer, 1.0 )
		float stdev = sqrt( variance )
		bool isStable = stdev < file.stabilityThreshold;
		if ( isStable )
			break

		frameTimeBuffer.fastremove( 0 )
		frameTimeBuffer.append( RenderFrameTime() )
		WaitFrame()
	}
}

void function MapMetrics_ClientRecordDataPoint_Thread( entity player, vector position, vector angles, int zoneId )
{
	waitthread WaitForFPSToSettle()

	// Add a bit of buffer to the FPS threshold so that spots that are very close to the threshold
	// but on the "good" side still get retested, because FPS has frame-to-frame variance and these
	// spots may actually be below the threshold when sampled again.
	int testThreshold = file.fpsThreshold + 5

	// If FPS is below the threshold, retry a few times to make sure it's not due to fluctuations from
	// teleporting to a new spot (i.e. tex streaming or model streaming). Hypothetically the FPS should
	// have settled after the above wait and be a representative value, but we'll do some retries just
	// for good measure. The idea is that spots that actually have bad performance will continue to be
	// bad and the retries should reflect that.
	//
	// However, we don't want to bias too much towards good results, so we take the min FPS out
	// of FRAME_TIME_MAX_RETRIES.
	int fps = int( RoundToNearestInt( 1.0 / RenderFrameTime() ) )
	if( fps < testThreshold )
	{
		int retryFps = 2 * file.fpsThreshold
		for( int i = 0; i < FRAME_TIME_MAX_RETRIES; i++ )
		{
			wait FRAME_TIME_RETRY_WAIT
			int thisFps = int( RoundToNearestInt( 1.0 / RenderFrameTime() ) )
			retryFps = int( min( retryFps, thisFps ) )
		}
		fps = retryFps
	}

	string zoneName = "#NOT_IN_NAMED_ZONE"
	if ( zoneId != -1 )
		zoneName = GetZoneNameForZoneId( zoneId )

	if ( zoneName == "" )
		zoneName = "#NOT_IN_NAMED_ZONE"

	table<string, float> metricsData
	metricsData[ METRICS_FPS ] <- fps.tofloat()
	metricsData[ METRICS_MEMORY ] <- GetFreeMemoryBytes()
	metricsData[ METRICS_VIEWPORT_SCALE ] <- GetClientViewportScaling().tofloat()
	metricsData[ METRICS_NET_IN ] <- ( GetNetworkBandwithIn() / 1024 ).tofloat()
	metricsData[ METRICS_NET_OUT ] <- ( GetNetworkBandwithOut() / 1024 ).tofloat()

	for ( int i = 0; i < GetPerfDataLabelCount(); i++ )
	{
		metricsData[ GetPerfDataLabelName( i ) ] <- GetPerfDataAverage( i )
	}

	MapMetrics_AppendSnapshotToFile( position, angles, zoneId, zoneName, metricsData )

	//if( fps < file.fpsThreshold )
	//{
	//Todo: Screenshots currently don't work on console
	//string screenshotFileName = CreateScreenShotFileName( position, angles )
	//file.metricsDataBuffer += "screenshot: " + screenshotFileName + ".jpg\n"
	//}

	Remote_ServerCallFunction( "MapMetrics_OnClientRecordMetricsData", fps )
}

void function RecordNetworkBandwidth()
{
	if( file.bandwidthInArray.len() < 2 )
		return

	file.bandwidthInArray.sort()
	file.bandwidthOutArray.sort()

	int maxIndex = int( 0.9 * file.bandwidthInArray.len() ) //only need values up to 90th percentile per online tech
	int maxBandwidthIn = file.bandwidthInArray[maxIndex - 1] / 1024
	int maxBandwidthOut = file.bandwidthOutArray[maxIndex - 1] / 1024

	float varianceIn =  CalculateIntArrayVarianceWithGivenPercentile( file.bandwidthInArray, 0.9 ) / ( 1024 * 1024 )
	float varianceOut = CalculateIntArrayVarianceWithGivenPercentile( file.bandwidthOutArray, 0.9 ) / ( 1024 * 1024 )

	string networkBandwidthInLine =  "\nMax network bandwidth in (ignoring outliers): " + maxBandwidthIn + " KiB/s\nVariance (ignoring outliers): " + varianceIn + " (KiB/s)^2\n"
	string networkBandwidthOutLine = "\nMax network bandwidth out (ignoring outliers): " + maxBandwidthOut + " KiB/s\nVariance (ignoring outliers): " + varianceOut + " (KiB/s)^2\n"

	file.metricsDataBuffer += networkBandwidthInLine
	file.metricsDataBuffer += networkBandwidthOutLine

	file.bandwidthInArray.clear()
	file.bandwidthOutArray.clear()
}

#endif //CLIENT

#if SERVER
void function StopRunningMapMetrics()
{
	file.stopMapMetrics = true
}

void function ShowWorldGrid( int gridSquareSideLength = -1, int gridHeight = 3000, float displayTime = 20.0 )
{
	if ( gridSquareSideLength == -1 )
		gridSquareSideLength = GetCurrentPlaylistVarInt( "map_metrics_grid_square_side_length", GRID_SQUARE_SIDE_LENGTH_DEFAULT_VALUE )

	int MAP_EXTENTS             = GetMapRadius()
	int GRID_SQUARE_SIDE_LENGTH = gridSquareSideLength
	int GRID_HEIGHT             = gridHeight
	int numIterations           = ( MAP_EXTENTS * 2 ) / GRID_SQUARE_SIDE_LENGTH

	for ( float yIt = 0; yIt <= numIterations; yIt++ )
	{
		float y = -MAP_EXTENTS + (yIt * GRID_SQUARE_SIDE_LENGTH)
		vector start = <-MAP_EXTENTS, y, GRID_HEIGHT>
		vector end = <MAP_EXTENTS, y, GRID_HEIGHT>
		DebugDrawLine( start, end, int(COLOR_GREEN.x), int(COLOR_GREEN.y), int(COLOR_GREEN.z), true, displayTime )
	}

	for ( float xIt = 0; xIt <= numIterations; xIt++ )
	{
		float x = -MAP_EXTENTS + (xIt * GRID_SQUARE_SIDE_LENGTH)
		vector start = <x, -MAP_EXTENTS, GRID_HEIGHT>
		vector end = <x, MAP_EXTENTS, GRID_HEIGHT>
		DebugDrawLine( start, end, int(COLOR_GREEN.x), int(COLOR_GREEN.y), int(COLOR_GREEN.z), true, displayTime )
	}
}

void function ShowTracePositions( int gridSquareSideLength = GRID_SQUARE_SIDE_LENGTH_DEFAULT_VALUE, float displayTime = 20.0 )
{
	entity player 				= GetPlayerArray()[0]
	array<entity> hurtTriggers 	= GetEntArrayByClass_Expensive( "trigger_hurt" )
	array<entity> oobTriggers 	= GetEntArrayByClass_Expensive( "trigger_out_of_bounds" )

	array<Point> samplePoints = GetSamplePoints( player, hurtTriggers, oobTriggers )
	vector prevPos = <0, 0, 0>
	foreach ( Point point in samplePoints )
	{
		if ( point.origin.x == prevPos.x && point.origin.y == prevPos.y && point.origin.z == prevPos.z )
			continue

		vector start = <point.origin.x, point.origin.y, TRACE_START_HEIGHT>
		vector end = point.origin

		DebugDrawLine( start, end, int(COLOR_GREEN.x), int(COLOR_GREEN.y), int(COLOR_GREEN.z), false, displayTime )
		DebugDrawSphere( end, 16.0, int(COLOR_YELLOW.x), int(COLOR_YELLOW.y), int(COLOR_YELLOW.z), false, displayTime, 4 )

		prevPos = point.origin
	}
}
#endif //SERVER

string function CreateScreenShotFileName( vector position, vector angles )
{
	return "setpos_" + position.x + "_" + position.y + "_" + position.z + ",setang_" + angles.x + "_" + angles.y + "_" + angles.z
}
