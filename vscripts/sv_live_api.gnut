
// Client -> Server Net Messages
global function ClientCallback_LiveAPI_JoinObservers
global function ClientCallback_LiveAPI_LeaveObservers

// Init
global function LiveAPI_ServerInit
// Wrappers
global function LiveAPI_SendOnePlayerEvent
global function LiveAPI_SendTwoPlayerEvent
global function LiveAPI_SendCombatInstanceEvent
global function LiveAPI_SendOnePlayerItemEvent
global function LiveAPI_SendOnePlayerLinkedEntityEvent
global function LiveAPI_SendRespawnEvent
global function LiveAPI_SendIntEvent
global function LiveAPI_SendInventoryAction
global function LiveAPI_SendInventoryActionWeapon
global function LiveAPI_SendAmmoChangedEvent
global function LiveAPI_SendArenasBuyMenuAction
global function LiveAPI_SendMatchSetup
global function LiveAPI_OnUpgradeCoreSelected
global function LiveAPI_OnUpgradeTierLevelChange
struct
{
	array< entity > observerList
} file

// The serverside segment of this system will only function in a Private Match
// If you have cl_LiveAPI_spectator_only 0 on the client, you'll get clientside events
// but not serverside events unless you're in a Private Match
bool function LiveAPI_ShouldLog()
{
    int session = GetConVarInt( "liveapi_session" )
    return session != 0
}

void function ClientCallback_LiveAPI_JoinObservers( entity player )
{
    if ( !LiveAPI_ShouldLog() )
        return

    if ( !IsSpectator( player ) )
        return

    // No duplicates
	if ( file.observerList.find( player ) > -1 )
        return

	file.observerList.append( player )

	LiveAPI_SendMatchSetup( player )
}

void function ClientCallback_LiveAPI_LeaveObservers( entity player )
{
    if ( !LiveAPI_ShouldLog() )
        return

	int foundIndex = -1
    foreach ( index, target in file.observerList )
    {
        if ( player == target )
        {
            foundIndex = index
            break
        }
    }

    if ( foundIndex == -1 )
        return

    file.observerList.remove( foundIndex )
}

void function LiveAPI_SendMatchSetup( entity player )
{
	if ( !LiveAPI_ShouldLog() )
		return

	string playlistName = GetCurrentPlaylistVarString( "name", "" )
	if ( playlistName == "" )
		return

    Remote_CallFunction_NonReplay( player, "ServerCallback_LiveAPI_LogNetwork_MatchSetup" )
}

void function LiveAPI_SendOnePlayerEvent( int eventIndex, entity playerOne )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_OnePlayer", eventIndex, playerOne )
    }
}

void function LiveAPI_SendOnePlayerLinkedEntityEvent( int eventIndex, entity playerOne, entity linkedEntity )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_OnePlayerAndEnt", eventIndex, playerOne, linkedEntity )
    }
}

void function LiveAPI_SendTwoPlayerEvent( int eventIndex, entity playerOne, entity playerTwo )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_TwoPlayer", eventIndex, playerOne, playerTwo )
