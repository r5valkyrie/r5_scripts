}

void function LiveAPI_SendCombatInstanceEvent( int eventIndex, entity attacker, entity victim, int damageSourceId, int damageInflicted, entity awardedTo = null )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
		{
			if ( awardedTo != null )
				Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_CombatInstance", eventIndex, attacker, victim, awardedTo, damageSourceId, damageInflicted )
			else
				Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_CombatInstanceUnawarded", eventIndex, attacker, victim, damageSourceId, damageInflicted )
		}
    }
}

void function LiveAPI_SendOnePlayerItemEvent( int eventIndex, entity player, string itemRef )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
        {
            LootData itemData = SURVIVAL_Loot_GetLootDataByRef( itemRef )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_OnePlayerItem", eventIndex, player, itemData.index )
        }
    }
}

