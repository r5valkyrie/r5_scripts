void function LiveAPI_SendRespawnEvent( entity player, int playerListBitMask )
{
    if ( !LiveAPI_ShouldLog() )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_RespawnTeam", player, playerListBitMask )
    }
}

void function LiveAPI_OnTeammatesRespawned( entity player, entity beacon, array<entity> playerList )
{
    int playerListBitMask = 0
    foreach ( teammate in playerList )
    {
        playerListBitMask += 1 << teammate.GetTeamMemberIndex()
    }

    LiveAPI_SendRespawnEvent( player, playerListBitMask )
}

void function LiveAPI_SendInventoryActionEntity( int eventIndex, entity player, entity entityRef, int quantity = 1, string lootRef = "")
{
    if ( !LiveAPI_ShouldLog() )
        return

    if ( !IsValid( entityRef ) )
        return

    if ( !IsValid( player ) )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
        {
            LootData itemData = SURVIVAL_Loot_GetLootDataByRef( lootRef )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_InventoryAction", eventIndex, player, itemData.index, entityRef, quantity )
        }
    }
}

void function LiveAPI_SendInventoryActionWeapon( int eventIndex, entity player, entity weapon, int quantity = 1 )
{
    if ( !LiveAPI_ShouldLog() )
        return

    if ( !IsValid( weapon ) )
        return

    if ( !IsValid( player ) )
        return

    string ref = weapon.GetWeaponClassName()
    if ( !SURVIVAL_Loot_IsRefValid( ref ) )
        return

    foreach ( observer in file.observerList )
    {
        if ( IsValid( observer ) )
        {
            LootData itemData = SURVIVAL_Loot_GetLootDataByRef( ref )
            Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_InventoryAction", eventIndex, player, itemData.index, weapon, quantity )
        }
    }
}

void function LiveAPI_SendInventoryAction( int eventIndex, entity player, string itemRef, entity entityRef = null, int quantity = 1 )
{
    if ( !LiveAPI_ShouldLog() )
        return

	foreach ( observer in file.observerList )
	{
		if ( IsValid( observer ) )
		{
			LootData itemData = SURVIVAL_Loot_GetLootDataByRef( itemRef )
			if ( entityRef != null )
				Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_InventoryAction", eventIndex, player, itemData.index, entityRef, quantity )
			else
				Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_InventoryActionNoEnt", eventIndex, player, itemData.index, quantity )
		}
	}
}

