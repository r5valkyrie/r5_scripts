// Events
void function LiveAPI_OnPlayerDamaged( entity player, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )

    // PVP already gets recorded, this is for other things like world damage.
    if ( attacker != null && attacker.IsPlayer() )
        return

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
    int damageInflicted = int( floor( DamageInfo_GetDamage( damageInfo ) ) )
    float damageAsFloat = DamageInfo_GetDamage( damageInfo )
    entity inflictor = DamageInfo_GetInflictor( damageInfo )

    LiveAPI_SendCombatInstanceEvent( eLiveAPI_EventTypes.playerDamaged, attacker, player, damageSourceId, damageInflicted )
}

void function LiveAPI_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
    if ( !IsValid( victim ) )
        return

    if ( !victim.IsPlayer() )
        return

    entity awardedTo = attacker
    if ( Bleedout_IsBleedingOut( victim ) )
    {
        entity bleedoutAttacker = Bleedout_GetBleedoutAttacker( victim )
        if ( IsValid( bleedoutAttacker ) && bleedoutAttacker.IsPlayer() )
            awardedTo = bleedoutAttacker
    }

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	int damageInflicted = int( floor( DamageInfo_GetDamage( damageInfo ) ) )

	LiveAPI_SendCombatInstanceEvent( eLiveAPI_EventTypes.playerKilled, attacker, victim, damageSourceId, damageInflicted, awardedTo )
}

void function LiveAPI_OnPlayerAssist( entity attacker, entity victim )
{
	if ( !IsValid( attacker ) || !IsValid ( victim ) )
		return

	if ( !attacker.IsPlayer() || !victim.IsPlayer() )
		return

	LiveAPI_SendTwoPlayerEvent( eLiveAPI_EventTypes.playerAssist, attacker, victim )
}

void function LiveAPI_OnGameSummaryStatChanged( entity player, int statNameEnum, int oldVal, int newVal )
{
	if( !IsValid( player ) )
		return

	if( !( 0 <= statNameEnum && statNameEnum < eStatNames._Count ) )
		return

	foreach ( observer in file.observerList )
	{
		if ( IsValid( observer ) )
			Remote_CallFunction_NonReplay( observer, "ServerCallback_LiveAPI_LogNetwork_PlayerIntStatChanged", player, statNameEnum, newVal )
	}
}

void function LiveAPI_OnSquadEliminated( int teamIndex )
{
	LiveAPI_SendIntEvent( eLiveAPI_EventTypes.squadEliminated, teamIndex )
}

void function LiveAPI_OnPlayerDisconnected( entity player )
{
    if ( !LiveAPI_ShouldLog() )
        return

    // Find the player in the observer list
    int index = file.observerList.find( player )
    if ( index >= 0 )
    {
        file.observerList.remove( index )
    }
}

void function LiveAPI_OnPlayerUsedOffhandWeapon( entity player, entity offhandWeapon )
{
    if ( !IsValid( player ) )
        return
    if ( !IsValid( offhandWeapon ) )
        return

    entity tacticalAbility = player.GetOffhandWeapon( OFFHAND_LEFT )
    entity ultimateAbility = player.GetOffhandWeapon( OFFHAND_INVENTORY )

    // We only care if it's a player's tac ability or their ultimate.
    if ( offhandWeapon != tacticalAbility && offhandWeapon != ultimateAbility )
        return

    LiveAPI_SendOnePlayerLinkedEntityEvent( eLiveAPI_EventTypes.playerAbilityUsed, player, offhandWeapon )
}

void function LiveAPI_OnPlayerObserverTargetChanged( entity observer, entity newTarget )
{
    if ( !observer.IsObserver() || observer.GetTeam() != TEAM_SPECTATOR )
        return

    if ( !IsValid( newTarget ) )
        return

    LiveAPI_SendTwoPlayerEvent( eLiveAPI_EventTypes.observerSwitched, observer, newTarget )
}

void function LiveAPI_LootPickedUp( entity player, entity pickup, string ref, int unitsPickedUp, bool willDestroy, entity deathBox, int pickupFlags )
{
    LiveAPI_SendInventoryActionEntity( eLiveAPI_EventTypes.inventoryPickUp, player, pickup, unitsPickedUp, ref )
}

void function LiveAPI_OnUpgradeCoreSelected( entity player, int upgradeIndex )
{
	LiveAPI_SendUpgradeCoreEvent( player, eLiveAPI_EventTypes.legendUpgradeSelected, upgradeIndex )
}

void function LiveAPI_OnUpgradeTierLevelChange( entity player, int tierLevel )
{
	LiveAPI_SendUpgradeCoreEvent( player, eLiveAPI_EventTypes.playerUpgradeTierChanged, tierLevel )
}

// Initialize
void function LiveAPI_ServerInit()
{
    AddDamageFinalCallback( "player", LiveAPI_OnPlayerDamaged )
    Survival_AddCallback_OnSquadEliminated( LiveAPI_OnSquadEliminated )
    AddCallback_OnClientDisconnected( LiveAPI_OnPlayerDisconnected )

    AddCallback_OnPlayerUsedOffhandWeapon( LiveAPI_OnPlayerUsedOffhandWeapon )

    Loot_AddCallback_OnPlayerLootPickup( LiveAPI_LootPickedUp )

    AddCallback_OnTeammatesRespawned( LiveAPI_OnTeammatesRespawned )
	AddCallback_OnPlayerKilled( LiveAPI_OnPlayerKilled )
	AddCallback_OnPlayerAssist( LiveAPI_OnPlayerAssist )

	Survival_AddCallback_OnPlayerGameSummaryStatChanged( LiveAPI_OnGameSummaryStatChanged )

    AddCallback_OnPlayerObserverTargetChanged( LiveAPI_OnPlayerObserverTargetChanged )
}␀