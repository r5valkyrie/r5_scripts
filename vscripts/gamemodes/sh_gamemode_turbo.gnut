#if SERVER || CLIENT
global function Sh_Survival_BattleRush_Init
#endif

#if SERVER
global function BattleRush_PlayEndMusic
global function BattleRush_ClientCallback_StopMusic
global function BattleRush_ClientCallback_PlayJumpMusic

const int MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_0 = 21
const int MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_1 = 15
const int MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_2 = 12
const int MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_3 = 9
const int MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_4 = 6
#endif

const string MUSIC_BATTLERUSH_JUMP = "Music_Turbo_Jump"
#if CLIENT

global function BattleRush_ServerCallback_PlayMatchEndMusic
global function BattleRush_ServerCallback_UpdateMusicRampLevel
global function BattleRush_ServerCallback_PlayGameplayMusic
global function BattleRush_ServerCallback_PlayJumpMusic
global function BattleRush_StopCharSelectMusic
global function AutoCards_ServerCallback_RetrievalNotice

// MUSIC
const string MUSIC_BATTLERUSH_GAMEPLAY = "Music_Turbo_Gameplay"
const string MUSIC_BATTLERUSH_VICTORY = "Music_Turbo_Victory"
const string MUSIC_BATTLERUSH_DEFEAT = "Music_Turbo_Loss"
const string MUSIC_BATTLERUSH_LOAD = "Music_Turbo_Load"
const string MUSIC_BATTLERUSH_CHARSELECT = "Music_Turbo_CharacterSelect"
const string MUSIC_BATTLERUSH_PODIUM = "Music_Turbo_Podium"
const array< float > MUSIC_BATTLERUSH_RAMPUP_CONTROLLER_VALUES = [50.0, 100.0, 150.0, 200.0] // Indexed by eBattleRushMusicRampLevels, these are the controller values for the corresponding music levels
const int MUSIC_RAMPUP_LEVEL_NOT_SET = -1
#endif

#if SERVER || CLIENT
const int MUSIC_RAMP_MIN = 0
const int MUSIC_RAMP_MAX = 4
#endif

#if CLIENT
enum eBattleRushMusicRampLevels
{
	STAGE_1,
	STAGE_2,
	STAGE_3,
	STAGE_FINAL,
	_count
}
#endif //CLIENT

struct
{
#if SERVER
	bool firstFreefall
#endif
#if CLIENT
	// Ramp up Music
	entity musicEntity // Music entity used to play ramp up music as the match progresses
	int musicRampUpLevel = MUSIC_RAMPUP_LEVEL_NOT_SET
#endif
} file

#if SERVER || CLIENT
void function Sh_Survival_BattleRush_Init()
{
	Sh_Survival_BattleRush_RegisterNetworking()

#if CLIENT
	AddCallback_ClientOnPlayerConnectionStateChanged( BattleRush_OnPlayerConnectionStateChanged )
	SURVIVAL_AddCallback_OnDeathFieldStartShrink(OnDeathFieldStartShrink_Client)
	AddCallback_OnCharacterSelectMenuOpened( OnCharacterSelectOpened )
	AddCallback_GameStateEnter( eGameState.Resolution, Client_OnResolution )
	AddCallback_GameStateEnter( eGameState.WaitingForPlayers, OnWaitingForPlayers_Client )
	AddCallback_GameStateEnter( eGameState.PickLoadout, OnPickLoadout_Client )
	AddCallback_OnPlayerDisconnected( OnPlayerDisconnected )

#endif

#if SERVER
	Survival_AddCallback_PlayerFreefallBegin( OnPlayerFreefallBegin )
	AddCallback_OnDeathBoxSpawned( AutoGrabBanners )
	AddCallback_OnPlayerKilled( OnPlayerKilled )
	file.firstFreefall = true
#endif

}
#endif

#if SERVER || CLIENT
void function Sh_Survival_BattleRush_RegisterNetworking()
{
	Remote_RegisterClientFunction( "BattleRush_ServerCallback_PlayGameplayMusic" )
	Remote_RegisterClientFunction( "BattleRush_ServerCallback_PlayMatchEndMusic", "bool" )
	Remote_RegisterClientFunction( "BattleRush_ServerCallback_UpdateMusicRampLevel", "int", MUSIC_RAMP_MIN, MUSIC_RAMP_MAX )
	Remote_RegisterClientFunction( "AutoCards_ServerCallback_RetrievalNotice" )
	Remote_RegisterServerFunction( "BattleRush_ClientCallback_StopMusic" )
	Remote_RegisterServerFunction( "BattleRush_ClientCallback_PlayJumpMusic" )

}
#endif //SERVER / CLIENT


#if SERVER
void function OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	array<entity> players
	players = GetPlayerArray_Alive()

	int alivePlayers = players.len()

	switch ( alivePlayers )
	{
		case MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_0:
			BattleRush_UpdateMusicRampForPlayers(0)
			break
		case MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_1:
			BattleRush_UpdateMusicRampForPlayers(1)
			break
		case MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_2:
			BattleRush_UpdateMusicRampForPlayers(2)
			break
		case MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_3:
			BattleRush_UpdateMusicRampForPlayers(3)
			break
		case MUSIC_BATTLERUSH_RAMP_PLAYERCOUNT_STAGE_4:
			BattleRush_UpdateMusicRampForPlayers(4)
			break
		default:
			return
	}
}
#endif // SERVER

#if SERVER
void function OnPlayerTouchGround( entity player )
{
	if( !IsValidPlayer( player ) )
		return

	StopSoundOnEntity( player, MUSIC_BATTLERUSH_JUMP )
	Remote_CallFunction_NonReplay( player, "BattleRush_ServerCallback_PlayGameplayMusic")
	RemovePlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, OnPlayerTouchGround )
}
#endif //SERVER

#if SERVER
void function BattleRushSetWinnerFunctionality( int winningAlliance )
{
	// Play a different stinger depending on if the player won or lost and then trigger victory music based on the winning Alliance
	array < entity > allPlayerAndSpectatorArray = GetPlayerArrayIncludingSpectators()
	foreach( entity player in allPlayerAndSpectatorArray )
	{
		if ( IsValid( player ) )
		{
			StopAllMusicOnPlayer( player )
			bool didLegendsWin = winningAlliance == player.GetTeam()
			Remote_CallFunction_NonReplay( player, "BattleRush_ServerCallback_PlayMatchEndMusic", didLegendsWin )
		}
	}
}
#endif // SERVER

#if SERVER
void function OnPlayerFreefallBegin (entity player)
{
	if (file.firstFreefall == false)
		return

	AddPlayerMovementEventCallback( player, ePlayerMovementEvents.TOUCH_GROUND, OnPlayerTouchGround )
	string music = MUSIC_BATTLERUSH_JUMP
	if ( music.len() > 0 )
	{
		SignalSoundOnEntity( player, music )
	}

	file.firstFreefall = false
}
#endif // SERVER


#if CLIENT
void function BattleRush_OnPlayerConnectionStateChanged( entity player )
{
	if ( IsValid( player ) && player == GetLocalClientPlayer() )
	{
		// This function runs for connnects and disconnects, we only care about a reconnect
		if ( player.IsConnectionActive() )
		{
			ResetMusicRampUpAtLevelForClient()
		}
	}
}
#endif // CLIENT

#if CLIENT
void function OnCharacterSelectOpened()
{
	entity player = GetLocalClientPlayer()
	if ( IsValid( player ) )
	{
		BattleRush_PlayCharSelectMusic()
	}
}
#endif // CLIENT

#if CLIENT
void function AutoCards_ServerCallback_RetrievalNotice()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	AnnouncementData announcement = Announcement_Create( "#WAR_GAMESMODE_AUTO_CARDS_NOTICE" )
	announcement.drawOverScreenFade = true
	Announcement_SetHideOnDeath( announcement, true )
	Announcement_SetDuration( announcement, 8.0 )
	Announcement_SetPurge( announcement, true )
	Announcement_SetStyle( announcement, ANNOUNCEMENT_STYLE_QUICK )
	Announcement_SetSoundAlias( announcement, "" )
	Announcement_SetTitleColor( announcement, GetKeyColor( COLORID_HUD_HEAL_COLOR ) )
	AnnouncementFromClass( player, announcement )
}
#endif


