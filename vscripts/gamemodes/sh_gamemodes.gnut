global struct GamemodeSettings
{
	string devName = ""
	array<void functionref()> serverInits
	array<void functionref()> clientInits
	array<void functionref()> sharedInits
	IntFromEntityCompare scoreCompareFunc
	array<string> scoreboardColumnTitles
	array<int> scoreboardColumnScoreTypes
	array<int> scoreboardColumnNumDigits
	string gameModeEndingConversation = ""
	void functionref(entity) customIntroAnnouncementFunc
}

global struct GameModeVariantSettings
{
	string devName = ""
	string name_localized = ""
	asset icon = $""
	int /*eGameModes*/ baseMode
	string playlist_flag = ""
	array<void functionref()> serverInits
	array<void functionref()> clientInits
	array<void functionref()> sharedInits
}

// Don't remove items from this list once the game is in production
// Durango online analytics needs the numbers for each mode to stay the same
// DO NOT CHANGE THESE VALUES AFTER THEY HAVE GONE LIVE
global enum eGameModes
{
	invalid				= -1,
	SURVIVAL 			= 0,
	//TEAM_DEATHMATCH 	= 1,
	//GAMEMODE_SP	 	= 2,
	FREELANCE 			= 3,
	CONTROL				= 5,
	FREEDM		 		= 6,
	_count
}

global enum eGameModeVariants
{
	invalid = -1,
	SURVIVAL_FIRING_RANGE,
	SURVIVAL_TRAINING,
	SURVIVAL_RANKED,
	SURVIVAL_AIRDROPEXTRA,
	SURVIVAL_CAMPFIRE,
	SURVIVAL_EXPLORE,
	SURVIVAL_FRAGNCLEAR,
	SURVIVAL_GOLDEN_HORSE,
	SURVIVAL_RECRUIT,
	SURVIVAL_SHADOW_ARMY,
	SURVIVAL_SHADOW_ROYALE,
	SURVIVAL_HARDCORE,
	SURVIVAL_HEATWAVE, 
	SURVIVAL_BATTLE_RUSH, 
	SURVIVAL_VALENTINES_S15,
	SURVIVAL_WINTEREXPRESS,
	SURVIVAL_THE_HUNT,
	SURVIVAL_HALLOWEEN_18_1, 
	SURVIVAL_STRIKEOUT,             
	SURVIVAL_SOLOS,          
	SURVIVAL_QUADS,     
	FREEDM_TDM,
	FREEDM_GUNGAME,     
	FREEDM_LOCKDOWN,
	FREEDM_SCROUNGE,
	_count
}

// Taken from _gamestate.nut so that is would be available on all VMs
global enum eWinReason
{
	DEFAULT,
	SCORE_LIMIT,
	TIME_LIMIT,
	ELIMINATION,
	LOCKOUT, // Special early end state in Control Mode when 1 team holds all the objectives
	TEAM_FORFEIT, // Special early end state when the enemy team quits or forfeits if that is an option
	OBJECTIVE_COMPLETED, // Used by gamemodes that have a specific objective win condition
	_count
}

struct
{
	table<int /*eGameModes*/, GamemodeSettings> gameModeDefs
	table<int /*eGameModeVariants*/, GameModeVariantSettings> variantDefs

	table<string, int> gameModesStringToIdMap
} file

void function GameModes_Init()
{
	// okirkham: the intention here is basically to convert these defs from what they are currently (lots of random settings, lots of which could just be set from gamemode scripts)
	// to essentially the bare minimum to setup the mode, so tell the game essentially "how do i know this mode/variant is enabled?" "what should i do if it is enabled?"
	// having stuff tied to gamemode init here generally feels like r1/r2 cruft at this point, things like gamemode names, icons etc are very much all playlist-driven now

	// we register gamemodes (core stuff, like survival, freedm, modes that our other modes are based off) using GameMode_Create and the other GameMode_* functions
	// modes that are based on other modes (so BR ltms, freedm-based modes, and other weird cases like winter express) are registered using GameModeVariant_Create and the other GameModeVariant_* functions

	GameMode_Create( eGameModes.SURVIVAL, SURVIVAL )
	#if SERVER
		GameMode_AddServerInit( eGameModes.SURVIVAL, GamemodeSurvival_Init )
	#elseif CLIENT
		GameMode_AddClientInit( eGameModes.SURVIVAL, ClGamemodeSurvival_Init )
	#endif
	#if !UI
		GameMode_AddSharedInit( eGameModes.SURVIVAL, GamemodeSurvivalShared_Init )
	#endif

	GameModeVariant_Create( eGameModeVariants.SURVIVAL_FIRING_RANGE, eGameModes.SURVIVAL )
	GameModeVariant_SetPlaylistFlag( eGameModeVariants.SURVIVAL_FIRING_RANGE, "survival_firingrange" )
	#if CLIENT || SERVER
		GameModeVariant_AddSharedInit( eGameModeVariants.SURVIVAL_FIRING_RANGE, FiringRangeGameMode_Init )
	#endif

	                                           
		#if CLIENT || SERVER
			GameModeVariant_AddSharedInit( eGameModeVariants.SURVIVAL_FIRING_RANGE, CombatRange_Init )
		#endif

		#if UI
			AddCallback_UI_FeatureTutorialDialog_PopulateTabsForMode( CombatRange_PopulateAboutText, COMBATRANGE )
			AddCallback_UI_FeatureTutorialDialog_SetTitle( FeatureTutorial_GetGameModeName, COMBATRANGE )
		#endif // UI
       

	GameModeVariant_Create( eGameModeVariants.SURVIVAL_TRAINING, eGameModes.SURVIVAL )
	GameModeVariant_SetPlaylistFlag( eGameModeVariants.SURVIVAL_TRAINING, "survival_training" )
	#if CLIENT || SERVER
		GameModeVariant_AddSharedInit( eGameModeVariants.SURVIVAL_TRAINING, ShSurvivalTraining_Init )
		GameModeVariant_AddSharedInit( eGameModeVariants.SURVIVAL_TRAINING, ShTutorial_Init )
	#endif

	GameModeVariant_Create( eGameModeVariants.SURVIVAL_RANKED, eGameModes.SURVIVAL )
	GameModeVariant_SetDevName( eGameModeVariants.SURVIVAL_RANKED, GAMEMODE_SURVIVAL_RANKED )
	GameModeVariant_SetName( eGameModeVariants.SURVIVAL_RANKED, "#PL_TRIO_RANKED" )
	GameModeVariant_SetPlaylistFlag( eGameModeVariants.SURVIVAL_RANKED, "is_ranked_game" )

                       
                                                                                          
                                                                                                        

                      
                                                                                                 
        
       

                              
                                                                                        
                                                                                               
                      
                                                                                                            
        
       

