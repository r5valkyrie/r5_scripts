#if SERVER || CLIENT
const string SQUAD_STRIKES_REF = "Squad_Strikes"
const string STRIKEOUT_RESPAWN_DISABLED = "Strikeout_Squad_Spawning_Disabled"
const float STRIKEOUT_RESPAWNS_DISABLED_ANNOUNCEMENT_DURATION = 7.0
const float STRIKEOUT_SQUAD_ELIMINATED_ANNOUNCEMENT_DURATION = 4.0
const float STRIKEOUT_FREEFALL_ANNOUNCEMENT_DURATION = 7.0
const int STRIKEOUT_FREEFALL_ANNOUNCEMENT_PRIORTIY = 1000
const asset DEATH_SCREEN_RUI = $"ui/strikeout_squad_summary_header_data.rpak"

const asset P_WPN_STRIKEOUT_SHIELD = $"P_3strikes_shield_p1"
const asset P_WPN_STRIKEOUT_SHIELD_IMPACT = $"P_3strikes_impact_ripple"
#endif

struct
{
#if SERVER
	int 					  strikesMaximum
	table <entity, ArmorData> playerArmorData
#endif
#if CLIENT || UI
	int	localClientPlayerSquadStrikes									= 0
	int localViewPlayerSquadStrikes										= 0
	int	lastSquadStrikesAnnouncement									= 0
#endif
#if UI
	bool respawnDisabled = false
#endif
} file

#if SERVER || CLIENT
void function Sh_Survival_Strikeout_Init()
{
	Sh_Survival_Strikeout_RegisterNetworking()

	PrecacheParticleSystem( P_WPN_STRIKEOUT_SHIELD )
	PrecacheParticleSystem( P_WPN_STRIKEOUT_SHIELD_IMPACT )
	AddCallback_EntitiesDidLoad( Strikeout_EntitiesDidLoad )
#if CLIENT
	RegisterNetVarIntChangeCallback( SQUAD_STRIKES_REF, Strikeout_StrikesChanged)
	Strikeout_OverrideGameState()
	
	Obituary_SetVerticalOffset( 60 )
	AddCallback_PlayerFreefallActiveChanged( StrikeOut_PlayerFreefallActiveChanged )

	DeathScreen_SetIsPlayerWaitingForRespawnFunc( Strikeout_IsPlayerWaitingForRespawn )
#endif

#if SERVER
	AddCallback_OnPlayerKilled( Survival_Strikeout_OnPlayerKilled )
	AddCallback_GameStateEnter( eGameState.Playing, Strikeout_BuildPlayerArmorTable )
	AddCallback_OnPlayerKilled( StoreAllChargeForPlayer )
	SURVIVAL_AddCallback_OnDeathFieldStopShrink( OnDeathFieldStopShrink )
	AddCallback_OnPlayerRespawned( OnPlayerRespawned )
	AddCallback_OnPlayerRespawned( RestoreChargesForPlayer )
	AddCallback_OnPlayerPostRespawned( RemoveMythicWeapons )
	file.strikesMaximum =  GetStartingRespawnCount()
	AddCallback_OnDeathBoxSpawned(GamemodeUtility_DestroyDeathboxOnDelay)
	RegisterSignal( "Strikeout_StopFX" )
	AddCallback_OnClientConnectionRestored(OnPlayerReconnect )
	AddCallback_OnClientDisconnected( OnPlayerDisconnect )
#endif

                      
	#if SERVER
		MatchBehaviorPlayer_AddEndedCallback( Strikeout_OnMatchBehaviorEnd )
	#endif // #if SERVER
                                
}
#endif

#if SERVER || CLIENT
void function Sh_Survival_Strikeout_RegisterNetworking()
{
	RegisterNetworkedVariable( SQUAD_STRIKES_REF, SNDC_PLAYER_EXCLUSIVE, SNVT_INT, 0)
	RegisterNetworkedVariable( STRIKEOUT_RESPAWN_DISABLED, SNDC_PLAYER_EXCLUSIVE, SNVT_BOOL, false)
	Remote_RegisterClientFunction( "ServertoClient_SquadElimationAnnouncement", "int", 1, 4)
	Remote_RegisterClientFunction( "ServertoClient_UpdateStrikeoutRui", "entity")
	Remote_RegisterClientFunction( "ServerCallback_Strikeout_SetDeathScreenCallbacks" )
	Remote_RegisterClientFunction( "ServertoClient_RespawnsDisabledAnnouncement" )
}

void function Strikeout_EntitiesDidLoad()
{
	thread __EntitiesDidLoad()
}

void function __EntitiesDidLoad()
{
	SurvivalCommentary_SetHost( eSurvivalHostType.OCTANE )
	return
}

#endif

#if SERVER
void function Strikeout_StopKnockDownVFX(entity player)
{
	Signal( player, "Strikeout_StopFX" )
}
#endif //SERVER

#if SERVER
int function GetSquadStrikes(entity player)
{
	if ( !IsValid( player ) )
		return 0

	return player.GetPlayerNetInt( SQUAD_STRIKES_REF )
}
#endif //SERVER

#if SERVER
void function SetSquadStrikes(entity player, int newValue)
{
	if ( !IsValid( player ) )
		return
	player.SetPlayerNetInt( SQUAD_STRIKES_REF, newValue )
}
#endif //SERVER

#if SERVER
void function Strikeout_BuildPlayerArmorTable()
{
	array<entity> players = GetPlayerArray()

	foreach ( player in players)
	{
		ArmorData armorData = ArmorData_Get(player)
		file.playerArmorData[player] <- armorData
	}

}
#endif //SERVER

#if SERVER
void function Survival_Strikeout_OnPlayerKilled( entity victim, entity attacker, var damageInfo )
{
	if ( !IsValid( victim ) )
		return

	int victimTeam = victim.GetTeam()
	int deathStage   = SURVIVAL_GetCurrentDeathFieldStage()
	int disableStage =  GetPlaylistVar_RespawnDisabledDeathstage()

	if ( deathStage >= disableStage)
	{
		if ( GamePlayingOrSuddenDeath() )
			CheckForAndTrySetEliminationModeWinner()
	}

	if ( GetPlayerArrayOfTeam_Alive( victimTeam ).len() <= 0 )
	{
		int strikes = GetSquadStrikes( victim )
		int newValue = ( strikes + 1 )
		array<entity> squadArray = GetPlayerArrayOfTeam( victimTeam )
		foreach ( squadmember in squadArray)
		{
			SetSquadStrikes( squadmember, newValue )
		}

		if (strikes < file.strikesMaximum )
		{
			ArmorData armordata = ArmorData_Get( victim )
			file.playerArmorData[victim] <- armordata
		}
		else if ( strikes >= file.strikesMaximum )
		{
			if (IsValid( attacker ) )
				PlaySquadWipeAnnouncement(attacker )

			if ( GamePlayingOrSuddenDeath() )
				CheckForAndTrySetEliminationModeWinner()
		}
	}

	if ( !IsValid( attacker ) )
		return

	if ( DamageInfo_GetAttacker( damageInfo ).IsPlayer() && GetPlaylistVar_AmmoOnKillEnabled())
		SpawnAmmoForAttacker(victim, damageInfo )
}
#endif //SERVER

#if SERVER
void function PlaySquadWipeAnnouncement( entity player )
{
	if( !player.IsPlayer() )
		return
		
	int squad = player.GetTeam()
	array<entity> squadArray = GetPlayerArrayOfTeam( squad )
	int diceRoll = RandomIntRange( 1, 4 )
	foreach ( squadmate in squadArray)
		Remote_CallFunction_NonReplay(squadmate, "ServertoClient_SquadElimationAnnouncement", diceRoll )
}
#endif //SERVER

#if SERVER
void function SpawnAmmoForAttacker( entity victim, var damageInfo )
{
	float ammoCount = GetPlaylistVar_AmmoOnKillMultiplier()
	int ammoStacks = GetPlaylistVar_AmmoOnKillBoxesToSpawn()
	for ( int i = 0; i < ammoStacks; i++ )
	{
		SpawnAmmoForRandomWeapon( victim, damageInfo, ammoCount )
	}
}
#endif //SERVER

#if SERVER
void function OnDeathFieldStopShrink( table<int,DeathFieldData> deathFieldData )
{
	int deathStage   = SURVIVAL_GetCurrentDeathFieldStage() + 1  // this is the death stage we're finishing so we want the next stage
	int disableStage =  GetPlaylistVar_RespawnDisabledDeathstage()

	if ( deathStage == disableStage)
	{
		foreach( player in GetPlayerArray() )
		{
			Remote_CallFunction_NonReplay(player, "ServertoClient_RespawnsDisabledAnnouncement" )
			player.SetPlayerNetBool( STRIKEOUT_RESPAWN_DISABLED, true )
		}
	}
}
#endif //SERVER

