	{
		const int SPIDERJUNGLE_SKIN_COUNT = 3
		skinIdx = RandomIntRangeInclusive( 1, SPIDERJUNGLE_SKIN_COUNT ) // duplicate of default skin. BUG: R5DEV-279020
