void function CommonSpawnInitNPC( entity npc )
{
	AddEntityCallback_OnKilled( npc, OnNPCKilled )
	AddEntityCallback_OnDamaged( npc, OnNPCDamaged )
	AddEntityCallback_OnPostDamaged( npc, OnNPCPostDamaged )
	AddEntityCallback_OnPostShieldDamage( npc, OnNPCPostShieldDamage )
	//AddEntityCallback_OnShieldBreak( npc, OnShieldBreak )
	npc.EnableNPCFlag( NPC_NO_MOVING_PLATFORM_DEATH ) //TODO: find a better solution for doors sometimes killing these guys
	npc.ai.hasDeathFieldImmunity = false //primarily for robots/wildlife. can make this more granular when we get to doing soldiers

	HookPlayerSpotting( npc )

	npc.SetAutoSquad()
}

void function HookPlayerSpotting( entity npc )
{
	thread function() : (npc)
	{
		npc.EndSignal( "OnDestroy" )
		npc.EndSignal( "OnDeath" )

		for ( ;; )
		{
			table details = WaitSignal( npc, "OnFoundEnemy" )
			//printf( "%s() - OnFoundEnemy", FUNC_NAME() )
			//PrintTable( details )
			entity target = expect entity( details.value )
			if ( !IsValid( target ) )
				continue
			if ( !target.IsPlayer() )
				continue
			if ( !IsEnemyTeam( npc.GetTeam(), target.GetTeam() ) )
				continue

			//printf( "Player '%s' spotted by enemy NPC: %s", string( target ), string( npc ) )
			if ( isNetworkingRegistered == true )
			{
				target.SetPlayerNetTime( NV_LastSpottedByNPC, Time() )
			}
		}
	}()
}

