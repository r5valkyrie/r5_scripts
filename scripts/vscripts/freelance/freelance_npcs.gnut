		return

	bool wasExecution = (DamageInfo_GetDamageSourceIdentifier( damageInfo ) == eDamageSourceId.human_execution)
	vector org = (wasExecution ? victim.GetWorldSpaceCenter() : victim.EyePosition())

	float weaponDropChance = 0.20
	string healthItem

	switch( victim.ai.npcType )
	{
                   
		case eNPC.PROWLER:
			//LootDropChance( org, (CoinFlip() ? "health_pickup_combo_small" : "health_pickup_health_small" ), GetCurrentPlaylistVarFloat( "loot_drop_chance_health_item_small_prowler", 0.1 ) )
			//RollAmmoDropsForKiller( org, 0.6, damageInfo )
			//RollAmmoDrops( org, 0.05 )
			break
		case eNPC.DIRE_PROWLER:
			//LootDropChance( org, (CoinFlip() ? "health_pickup_combo_small" : "health_pickup_health_small" ), GetCurrentPlaylistVarFloat( "loot_drop_chance_health_item_small_shadow_prowler", 0.05 ) )
			//RollAmmoDropsForKiller( org, 0.6, damageInfo )
			//RollAmmoDrops( org, 0.05 )
			break
		case eNPC.SPECTRE:
			//LootDropChance( org, (CoinFlip() ? "health_pickup_combo_small" : "health_pickup_health_small" ), 0.25 )
			//RollAmmoDropsForKiller( org, 0.75, damageInfo )
			//RollAmmoDrops( org, 0.1 )
			//LootDropChance( org, "ordnance_drops", 0.2 )
			//InstantHealthPickup_DropForAll( 2, 1, org )
			break
		case eNPC.DEATH_SPECTRE:
			//LootDropChance( org, (CoinFlip() ? "health_pickup_combo_small" : "health_pickup_health_small" ), 0.40 )
			//RollAmmoDropsForKiller( org, 0.9, damageInfo )
			//RollAmmoDrops( org, 0.2 )
			//LootDropChance( org, "health_3", 0.50 )
