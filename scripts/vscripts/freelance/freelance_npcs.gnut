}

bool function ShouldStartWithExecutionEnabled( entity npc )
{
	return false
}

void function NPCEnableExecution( entity npc )
{
	if ( !GetCurrentPlaylistVarBool( "ai_execution_enabled",  true) )
		return

	if ( npc.ai.executionHasBeenEnbled )
	{
		Warning( "%s() - Already enabled on npc: '%s'", FUNC_NAME(), string( npc ) )
		return
	}

	thread function () : (npc)
	{
		npc.EndSignal( "OnDeath" )
		npc.SetUsableByGroup( "pilot" )
		npc.AddUsableValue( USABLE_CUSTOM_HINTS | USABLE_NO_FOV_REQUIREMENTS | USABLE_SHRINK_USEABLE_BOX | USABLE_BLOCK_CONTINUOUS_USE )
		npc.ai.executionHasBeenEnbled = true

		for ( ;; )
		{
			table inputTable  = npc.WaitSignal( "OnPlayerUseLong" )
			entity playerUser = expect entity( inputTable.player )

			if ( TryStartSyncedMelee( playerUser, npc ) )
			{
				playerUser.p.nagCounter.executions = -1 // to stop hints
				WaitFrame()
			}
		}
	}()
}

void function DoNag_Executions( entity npc, entity attacker )
{
	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
		return
	if ( attacker.p.nagCounter.executions < 0 )
		return

	thread function() : ( npc, attacker )
	{
		npc.EndSignal( "OnDestroy" )
		npc.EndSignal( "OnDeath" )
		attacker.EndSignal( "OnDestroy" )
		attacker.EndSignal( "OnDeath" )

		wait ( 3.0 )

		if ( attacker.p.nagCounter.executions < 0 )
			return

		attacker.p.nagCounter.executions++
		switch( attacker.p.nagCounter.executions )
		{
			case 1:
			case 5:
			case 15:
				//DoFreelanceModeSplashToPlayer( attacker, eModeSplash.CombatHint_ShieldBreaks )
				break
		}
	}()
}

void function DoNag_SniperVSRobots( entity npc, entity attacker )
{
	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
		return

	if ( attacker.p.nagCounter.sniperVSRobots < 0 )
		return

	thread function() : ( attacker )
	{
		attacker.EndSignal( "OnDestroy" )
		attacker.EndSignal( "OnDeath" )
		wait ( 1.0 )

		if ( attacker.p.nagCounter.sniperVSRobots < 0 )
			return

		attacker.p.nagCounter.sniperVSRobots = -1	// no more
		//DoFreelanceModeSplashToPlayer( attacker, eModeSplash.CombatHint_SnipersHurtRobots )
	}()
}

void function DoNag_ShotgunsVSWildlife( entity npc, entity attacker )
{
	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
		return

	if ( attacker.p.nagCounter.shotgunsVSWildlife < 0 )
		return

	thread function() : ( attacker )
	{
		attacker.EndSignal( "OnDestroy" )
		attacker.EndSignal( "OnDeath" )
		wait ( 1.0 )

		if ( attacker.p.nagCounter.shotgunsVSWildlife < 0 )
			return
		attacker.p.nagCounter.shotgunsVSWildlife = -1	// no more
		//DoFreelanceModeSplashToPlayer( attacker, eModeSplash.CombatHint_ShotgunsHurtWildlife )
	}()
}

