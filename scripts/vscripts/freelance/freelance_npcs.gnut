}

bool function KilledNpcShouldThrowLoot( entity victim, var damageInfo )
{
	if ( victim.ai.shouldDisableLootDrops )
		return false

	int damageSourceId = DamageInfo_GetDamageSourceIdentifier( damageInfo )
	entity attacker = DamageInfo_GetAttacker( damageInfo )

	if ( GetCurrentPlaylistVarBool( "npc_drop_loot", true ) == false )
		return false

	if ( IsValid( attacker ) && attacker.IsPlayer() ) //npcs killing each other shouldn't throw loot
		return true

	if ( damageSourceId == damagedef_suicide )
		return false
	if ( damageSourceId == damagedef_despawn )
		return false

	return true
}

