void function InitRankAndHealth( entity npc, NpcSpawnInfo spInfo, NpcRegistrationInfo regInfo )
{
	int healthRank = ClampInt( spInfo.npcRank, 0, (regInfo.healthTiers.len() - 1) )
	array<int> set = regInfo.healthTiers[healthRank]
	int maxHealth = set[0]
	int maxShields = ((set.len() > 1) ? set[1] : 0)

	npc.SetGrade( spInfo.npcRank )
	npc.SetMaxHealth( maxHealth )
	npc.SetHealth( maxHealth )
	npc.SetShieldHealthMax( maxShields )
	npc.SetShieldHealth( maxShields )

	if ( ShouldStartWithExecutionEnabled( npc ) )
		NPCEnableExecution( npc )
}

void function SetupNPCExecutionHandling( entity npc, bool enableHighlight = true )
{
	AddEntityCallback_OnPostDamaged( npc, void function ( entity npc, var damageInfo ) : ( enableHighlight )
	{
		if ( npc.ai.executionHasBeenEnbled )
			return
		if ( !IsAlive( npc ) )
			return

		float damage = DamageInfo_GetDamage( damageInfo )
		if ( damage <= 0.0 )
			return
		int health = npc.GetHealth()
		int healthNext = (health - int( damage ))
		if ( healthNext <= 0 )
			return

		int healthMax = npc.GetMaxHealth()
		int healthThreshold = (healthMax / 2)
		if ( healthNext > healthThreshold )
			return

		/*if ( !npc.ContextAction_IsActive() && npc.IsInterruptableForScriptedAnim() )
		{
			//npc.Anim_ScriptedPlayActivityByName( "ACT_STUNNED", true, false, 0.1 )
			npc.Anim_ScriptedPlayActivityByName( "ACT_BIG_FLINCH", true, false, 0.1 )
			npc.EnableNPCFlag( NPC_PAIN_IN_SCRIPTED_ANIM )
		}*/

		if( enableHighlight )
		{
			Highlight_SetEnemyHighlight( npc, "enemy_sonar" )
		}
		NPCEnableExecution( npc )
	} )
}

entity function NPCSpawn_Spectre( NpcSpawnInfo info )
{
	entity npc = CreateNPCFromAISettings( "npc_spectre_outlands", info.npcTeamOverride, info.spawnOrigin, info.spawnAngles )
	DispatchSpawn( npc )

	npc.SetSkin( 0 )

	HideCrit( npc )
	npc.SetPreventCrits( true )

	npc.SetChanceToHitEnabled( true )

	npc.e.forceHeadshotDeath = true

	npc.kv.defenseActive = true

	TakeAllWeapons( npc )
	npc.GiveWeapon( string( GetNPCAsset( eNPC.SPECTRE, eNPCAsset.WEAPON_0 ) ), WEAPON_INVENTORY_SLOT_PRIMARY_0, [] )
	npc.EnableNPCFlag( NPC_NO_WEAPON_DROP )
	npc.ai.damageFlagsVulnerable = (DF_SNIPER)

	SetupNPCExecutionHandling( npc, false )
	CommonSpawnInitNPC( npc )
	CommonSpawnInfantryBehavior( npc, info.spawnOrigin )
	return npc
}

entity function NPCSpawn_DeathSpectre( NpcSpawnInfo info )
{
	entity npc = CreateNPCFromAISettings( "npc_spectre_outlands", info.npcTeamOverride, info.spawnOrigin, info.spawnAngles )
