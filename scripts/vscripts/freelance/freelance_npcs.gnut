	npc.ai.damageFlagsVulnerable = (DF_SNIPER)

	CommonSpawnInitNPC( npc )
	CommonSpawnInfantryBehavior( npc, info.spawnOrigin )
	return npc
}
   
entity function NPCSpawn_SpiderJungle( NpcSpawnInfo info )
{
	entity npc = CreateNPCFromAISettings( "npc_spider", info.npcTeamOverride, info.spawnOrigin, info.spawnAngles )
