entity function NPCSpawn_DireProwler( NpcSpawnInfo info )
{
	entity npc = CreateNPCFromAISettings( "npc_prowler", info.npcTeamOverride, info.spawnOrigin, info.spawnAngles )
	DispatchSpawn( npc )

	npc.SetTitle( "#NPC_DIREPROWLER_UI_TITLE" )

	int skinIdx = npc.GetSkinIndexByName( "ShadowSqaud" )
	npc.SetSkin( skinIdx )

	npc.ai.damageFlagsVulnerable = (DF_SHOTGUN)

	npc.ai.preventFriendlyDamage = true

	CommonSpawnInitNPC( npc )

	npc.SetNPCMoveSpeedScale( 1.25 ) //slightly faster since health is low

	const asset SHADOW_TRAIL_FX = $"P_Bshadow_body"

	//entity eyeGlow = StartParticleEffectOnEntity_ReturnEntity( npc, GetParticleSystemIndex( GetObjectiveAsset_FX( "PROWLER_EYEGLOW_SHADOW_FX" ) ), FX_PATTACH_POINT_FOLLOW, npc.LookupAttachment( "EYEGLOW" ) )
	//eyeGlow.DisableHibernation()

	if ( npc.LookupAttachment( "CHESTFOCUS" ) > 0 )
	{
		entity smokeFx = StartParticleEffectOnEntity_ReturnEntity( npc, GetParticleSystemIndex( SHADOW_TRAIL_FX ), FX_PATTACH_POINT_FOLLOW, npc.LookupAttachment( "CHESTFOCUS" ) )
		smokeFx.DisableHibernation()
	}

	//
	AddEntityCallback_OnKilled( npc, void function ( entity npc, var damageInfo ) : ()
	{
		thread NpcShadowDeath( npc )
	} )

	npc.SetSoundCodeControllerValue( 100.0 )

	AddEntityCallback_OnDamaged( npc, OnProwlerDamaged )
	return npc
}
void function OnProwlerDamaged( entity npc, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( IsValid( attacker ) && attacker.IsPlayer() )
		OnPlayerDamagedProwler( attacker, npc, damageInfo )
}

void function NpcShadowDeath( entity npc )
{
	const asset DEATH_TOTEM_SHADOW_DEATH_FX = $"P_BShadow_death"
	vector deathOrigin = npc.GetOrigin()
	vector deathFXOrigin = deathOrigin + <0,0,64>
	thread CreateAirShake( deathOrigin, 2, 50, 1 )
	EmitSoundAtPosition( TEAM_ANY, deathFXOrigin, "ShadowLegend_Shadow_DeathVanish", npc )

	int attach_id       = npc.LookupAttachment( "CHESTFOCUS" )
	vector effectOrigin = npc.GetAttachmentOrigin( attach_id )
	vector effectAngles = npc.GetAttachmentAngles( attach_id )
	StartParticleEffectOnEntity_ReturnEntity( npc, GetParticleSystemIndex( DEATH_TOTEM_SHADOW_DEATH_FX ), FX_PATTACH_POINT_FOLLOW, attach_id )

	npc.MakeInvisible()
	npc.NotSolid()

	wait 1
	if ( IsValid( npc ) )
		npc.Destroy()
}

