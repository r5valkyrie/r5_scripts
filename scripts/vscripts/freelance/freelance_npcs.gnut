{
}

void function OnNPCKilled( entity victim, var damageInfo )
{
	if ( GetCurrentPlaylistVarBool( "freelance_npcs_drop_loot_on_death", false ) == true )
		DoItemDropForDeath( victim, damageInfo )

	entity killer = DamageInfo_GetAttacker( damageInfo )

	if ( IsValid( killer ) )
	{
		if ( DamageInfo_GetDamageSourceIdentifier( damageInfo ) == eDamageSourceId.human_execution )
		{
			//thread OnSuccessfulSyncedMelee( victim, killer, damageInfo  )

			bool killerIsPlayer = (IsValid( killer ) && killer.IsPlayer())
			if ( killerIsPlayer && (killer.p.nagCounter.killedGruntsWithExecutions == 0) )
			{
				//DoFreelanceModeSplashToPlayer( killer, eModeSplash.CombatHint_GruntFinishers )
				killer.p.nagCounter.killedGruntsWithExecutions = 1
			}
		}
	}

	// Remove real weapon:
	{
		entity currentWeapon = victim.GetActiveWeapon( eActiveInventorySlot.mainHand )
		if ( IsValid( currentWeapon ) )
			victim.TakeWeaponByEntNow( currentWeapon )
	}
}

int function GetShieldFlagsForDmg( entity npc )
{
	if ( npc.GetShieldHealth() <= 0 )
		return 0

	int result = DAMAGEFLAG_VICTIM_ARMORED

	switch( npc.GetGrade() )
	{
		case 0:
			result = (result | DAMAGEFLAG_ARMOR1)
			break
		case 1:
			result = (result | DAMAGEFLAG_ARMOR2)
			break
		case 2:
			result = (result | DAMAGEFLAG_ARMOR3)
			break
		case 3:
			result = (result | DAMAGEFLAG_ARMOR4)
			break
	}

	return result
}

void function OnNPCDamaged( entity npc, var damageInfo )
{
	if ( s_damageflagWeaknessScalar != 1.0 )
	{
		int dmgFlags = DamageInfo_GetCustomDamageType( damageInfo )
		int matchedFlags = (dmgFlags & npc.ai.damageFlagsVulnerable)
		if ( matchedFlags != 0 )
		{
			printf( "NPC '%s' is vulnerable to: %s", string( npc ), GetDescStringForDamageFlags( matchedFlags ) )
			DamageInfo_ScaleDamage( damageInfo, s_damageflagWeaknessScalar )
			DamageInfo_AddCustomDamageType( damageInfo, DF_CRITICAL )

			if ( matchedFlags == DF_SNIPER )
				DoNag_SniperVSRobots( npc, DamageInfo_GetAttacker( damageInfo ) )
			if ( matchedFlags == DF_SHOTGUN )
				DoNag_ShotgunsVSWildlife( npc, DamageInfo_GetAttacker( damageInfo ) )
		}
	}

	DamageInfo_AddDamageFlags( damageInfo, GetShieldFlagsForDmg( npc ) )
}

