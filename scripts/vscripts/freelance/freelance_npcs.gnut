void function CommonSpawnInfantryBehavior( entity npc, vector behaviorOrigin )
{
	npc.kv.AlwaysAlert = false

	//npc.SetDefaultSchedule( "SCHED_PATROL_PATH" )
	npc.SetDefaultSchedule( "" )
	npc.EnableNPCFlag( 0
		| NPC_NO_LISTEN_TEAMMATE		//
