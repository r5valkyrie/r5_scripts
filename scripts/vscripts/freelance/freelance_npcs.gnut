float s_difficultyDamageScale_0 = 1.0
float s_difficultyDamageScale_1 = 1.0
float s_difficultyDamageScale_2 = 1.0
float s_difficultyDamageScale_3 = 1.0
void function CacheDifficultyDamageScalesFromPlaylist()
{
	s_difficultyDamageScale_0 = GetCurrentPlaylistVarFloat( "difficulty_damage_scaling_0", 1.0 )
	s_difficultyDamageScale_1 = GetCurrentPlaylistVarFloat( "difficulty_damage_scaling_1", 1.0 )
	s_difficultyDamageScale_2 = GetCurrentPlaylistVarFloat( "difficulty_damage_scaling_2", 1.0 )
	s_difficultyDamageScale_3 = GetCurrentPlaylistVarFloat( "difficulty_damage_scaling_3", 1.0 )
}
float function GetDamageScaleForDifficulty()
{
	int diff = DIFFICULTY_NORMAL
	switch( diff )
	{
		case 0:
			return s_difficultyDamageScale_0
		case 1:
			return s_difficultyDamageScale_1
		case 2:
			return s_difficultyDamageScale_2
		case 3:
			return s_difficultyDamageScale_3
	}

	Assert( false, "Unhandled difficulty scale." )
	return s_difficultyDamageScale_2
}

void function OnPlayerDamaged_DifficultyScaling( entity target, var damageInfo )
{
	float scale = GetDamageScaleForDifficulty()
	if ( scale == 1.0 )
		return
	DamageInfo_ScaleDamage( damageInfo, scale )
}


void function OnPlayerDamaged_RepeatBulletDamageShield( entity target, var damageInfo )
{
	entity attacker = DamageInfo_GetAttacker( damageInfo )
	if ( !IsValid( attacker ) )
		return

	if ( !(attacker.IsNPC() && attacker.ai.allowsPlayerBurstShield) )
		return

	int damageType = DamageInfo_GetCustomDamageType( damageInfo )
	bool isBullet = IsBitFlagSet( damageType, DF_BULLET ) ? true : false
	if ( !isBullet )
		return

	const float BULLET_SAFETY_TIME = 0.5
	bool wasRecentlyHit = WasRecentlyHitByEntityWithDamagetype( target, attacker, damageType, BULLET_SAFETY_TIME )
	if ( wasRecentlyHit )
	{
		printt( "BULLET_REPEAT_SHIELD - Nullifying repeat hit from: " + attacker )
		DamageInfo_SetDamage( damageInfo, 0 )
		return
	}
}

