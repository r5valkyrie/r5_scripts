typedef npcSpawnFunc_t entity functionref( NpcSpawnInfo )
struct NpcRegistrationInfo
{
	npcSpawnFunc_t spawnFunc
	int defaultTeam = -1		// eNpcTeam.*

	array<array<int> > healthTiers
}

NpcRegistrationInfo[eNPC._count] s_spawnRegistrationInfos

void function RegisterNPCType( int npcType, int defaultTeam, array<array<int> > healthTiers, npcSpawnFunc_t spawnFunc )
{
	NpcRegistrationInfo regInfo = s_spawnRegistrationInfos[npcType]

	regInfo.defaultTeam = defaultTeam
	regInfo.spawnFunc = spawnFunc
	regInfo.healthTiers = clone healthTiers
}

void function SetupNPCTypes()
{
	//Season 5.0: might want to adjust health on-the-fly with playlist vars
	                   
		int prowlerHealth = GetCurrentPlaylistVarInt( "health_prowler", 114 )
		int shadowProwlerHealth = GetCurrentPlaylistVarInt( "health_shadow_prowler", 20 )
       
	//Season 11.0: Goliath and Spider
                
		int jungleSpiderHealth = GetCurrentPlaylistVarInt( "health_jungle_spider", 42 )

	// type						// team default			//=========  [Health, Shield] Tiers =========
         
		RegisterNPCType( eNPC.PROWLER,				eNpcTeam.WILDLIFE,		[ [ prowlerHealth ], 		[prowlerHealth],		[prowlerHealth]			],	NPCSpawn_Prowler )
		RegisterNPCType( eNPC.DIRE_PROWLER,			eNpcTeam.WILDLIFE,		[ [shadowProwlerHealth],	[shadowProwlerHealth],	[shadowProwlerHealth]	],	NPCSpawn_DireProwler )
         
		int spectreHealth = GetCurrentPlaylistVarInt( "armory_health_spectre", 150 )
		RegisterNPCType( eNPC.SPECTRE,				eNpcTeam.LEGION,		[ [ spectreHealth, 0],		[ spectreHealth, 0],	[ spectreHealth, 0],	],	NPCSpawn_Spectre )
		RegisterNPCType( eNPC.DEATH_SPECTRE,		eNpcTeam.LEGION,		[ [125, 75],	[125, 75],	[125, 75],		],	NPCSpawn_DeathSpectre )               
		RegisterNPCType( eNPC.SPIDER_JUNGLE,		eNpcTeam.INFECTED,		[ [jungleSpiderHealth],	[jungleSpiderHealth], [jungleSpiderHealth] ],	NPCSpawn_SpiderJungle )                   
}

entity function SpawnNPCDetailed( NpcSpawnInfo infoRaw )
{
	NpcSpawnInfo spInfo = clone infoRaw

	NpcRegistrationInfo regInfo = s_spawnRegistrationInfos[spInfo.npcType]
	spInfo.npcTeamOverride = ((spInfo.npcTeamOverride >= 0) ? spInfo.npcTeamOverride : regInfo.defaultTeam)

	entity ent = regInfo.spawnFunc( spInfo )
	ent.ai.npcType = spInfo.npcType
	InitRankAndHealth( ent, spInfo, regInfo )
	return ent
}

entity function SpawnNPC( int npcType, vector spawnOrigin, vector spawnAngles, int rank = 0 )
{
	NpcSpawnInfo info
	info.npcType = npcType
	info.spawnOrigin = spawnOrigin
	info.spawnAngles = spawnAngles
	info.npcRank = rank

	return SpawnNPCDetailed( info )
}

#if DEVELOPER
entity function DEV_CrosshairSpawn( int npcType, int rank = 0 )
{
	entity player = GP()

	NpcSpawnInfo info
	info.npcType = npcType
	info.spawnOrigin = GetPlayerCrosshairOrigin( player )
	info.spawnAngles = (player.GetAngles() + <0, 180, 0>)
	info.npcRank = rank

	return SpawnNPCDetailed( info )
}
#endif // #if DEVELOPER

////////////////

vector function CalcHullCenterForOrigin( vector origin, int hullType )
{
	vector mins = GetBoundsMin( hullType )
	vector maxs = GetBoundsMax( hullType )
	vector result = origin + ((mins + maxs) * 0.5)

	return result
}

///////////////////

entity function DropPodSpawnWrapper( int team, vector origin, vector angles, table spawnInfo )
{
	Assert( team == TEAM_ANY )
	int npcType = expect int(spawnInfo.npcType)
	int rank = expect int(spawnInfo.rank)
	entity result = SpawnNPC( npcType, origin, angles, rank )
	return result
}

array<entity> function PVE_TestDropPod( vector dropPos, int npcType, int spawnCount, int rank = 0 )
{
	entity marker = CreateEntity( "info_target" )
	DispatchSpawn( marker )
	marker.SetOrigin( dropPos )

	table spawnInfo
	spawnInfo.npcType <- npcType // eNPC.SPECTRE
	spawnInfo.rank <- rank

	array<entity functionref( int, vector, vector, table )> spawnfuncs
	array<table> customData
	spawnfuncs.resize( spawnCount, DropPodSpawnWrapper )
	customData.resize( spawnCount, spawnInfo )

	//int podFlags = eDropPodFlag.DISSOLVE_AFTER_DISEMBARKS
	array<entity> spawnedEnts
	//waitthread Spawn_DropPodSquadCustom( spawnfuncs, customData, spawnedEnts, TEAM_ANY, marker, podFlags, 0 )

	marker.Destroy()
	return spawnedEnts
}



