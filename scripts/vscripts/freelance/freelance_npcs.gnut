void function OnPlayerDamaged( entity player, var di )
{
	OnPlayerDamaged_DifficultyScaling( player, di )
	OnPlayerDamaged_RepeatBulletDamageShield( player, di )
	OnPlayerDamaged_HandleProwlerDamage( player, di )

	entity attacker = DamageInfo_GetAttacker( di )
	if ( Bleedout_IsBleedingOut( player ) && IsValid( attacker ) && attacker.IsNPC() )
		DamageInfo_ScaleDamage( di, s_playerBleedoutNPCDamageScale )
}

struct PlayerProwlerCombatHistory
{
	float lastGotDamagedTime = -9999.0
	int meleeHintCounter
	int meleeHintTimesHinted
}
table<entity, PlayerProwlerCombatHistory> s_mapPlayerToPlayerProwlerCombatHistory
PlayerProwlerCombatHistory function GetPlayerProwlerCombatHistory( entity player )
{
	Assert( player.IsPlayer() )
	if ( !(player in s_mapPlayerToPlayerProwlerCombatHistory) )
	{
		PlayerProwlerCombatHistory newHistory
		s_mapPlayerToPlayerProwlerCombatHistory[player] <- newHistory
	}

	return s_mapPlayerToPlayerProwlerCombatHistory[player]
}

void function OnPlayerDamaged_HandleProwlerDamage( entity player, var di )
{
	if ( DamageInfo_GetDamageSourceIdentifier( di ) != eDamageSourceId.prowler_melee )
		return

	int rawDamage = int( DamageInfo_GetDamage( di ) )
	if ( rawDamage <= 0 )
		return

	if ( GetCurrentPlaylistVarBool( "prowlercombat_damagescale_enabled", true ) )
	{
		int lowhealthThreshold = GetProwlerDamageScaleLowhealthThreshold( player )
		float lowhealthScalar = GetProwlerDamageScaleLowhealthScalar( player )
		int deathProtectionMinHP = GetProwlerDamageScaleDeathProtectMinHp( player )

		int playerShield = player.GetShieldHealth()
		int playerHealth = player.GetHealth()

		int damage = rawDamage
		if ( playerShield > 0 )
		{
			damage = minint( playerShield, damage )
		}
		else
		{
			if ( (playerHealth - damage) < lowhealthThreshold )
				damage = int( damage * lowhealthScalar )

			if ( playerHealth > deathProtectionMinHP )
			{
				damage = minint( (playerHealth - 1), damage )
			}
		}

		vector damageOrigin = DamageInfo_GetDamagePosition( di )
		int scriptDamageType = DamageInfo_GetCustomDamageType( di )
		int damageType = DamageInfo_GetDamageType( di )
		entity attacker = DamageInfo_GetAttacker( di )
		printf( "%s() - Scaled %d -> %d dmg for player with health:%d shields:%d  (%s)", FUNC_NAME(), rawDamage, damage, playerHealth, playerShield, string( player ) )
		if ( damage != rawDamage )
			DamageInfo_SetDamage( di, damage )
	}
}

int function GetProwlerDamageTeamCount( entity player )
{
	int team = player.GetTeam()
	if ( IsTeamRabid( team ) )
		return 1

	// 2: count players connected
	// 1: count players not bleeding out
	// 0: count players alive
	switch( GetCurrentPlaylistVarInt( "prowlercombat_player_counting_style", 0 ) )
	{
		case 2:
			return GetPlayerArrayOfTeam( team ).len()
		case 1:
			return GetPlayerArrayOfTeam( team ).len()
	}

	return GetPlayerArrayOfTeam_Alive( team ).len()
}

float function GetProwlerDamageImmunityWindow( entity player )
{
	int playerCount = GetProwlerDamageTeamCount( player )
	if ( playerCount >= 3 )
		return GetCurrentPlaylistVarFloat( "prowlercombat_immunity_window_time_trios", 0.75 )
	else if ( playerCount == 2 )
		return GetCurrentPlaylistVarFloat( "prowlercombat_immunity_window_time_duos", 0.75 )

	return GetCurrentPlaylistVarFloat( "prowlercombat_immunity_window_time_solos", 0.75 )
}

float function GetProwlerDamageScaleLowhealthScalar( entity player )
{
	int playerCount = GetProwlerDamageTeamCount( player )
	if ( playerCount >= 3 )
		return GetCurrentPlaylistVarFloat( "prowlercombat_damagescale_lowhealth_scalar_trios", 0.5 )
	else if ( playerCount == 2 )
		return GetCurrentPlaylistVarFloat( "prowlercombat_damagescale_lowhealth_scalar_duos", 0.5 )

	return GetCurrentPlaylistVarFloat( "prowlercombat_damagescale_lowhealth_scalar_solos", 0.5 )
}

int function GetProwlerDamageScaleLowhealthThreshold( entity player )
{
	int playerCount = GetProwlerDamageTeamCount( player )
	if ( playerCount >= 3 )
		return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_lowhealth_threshold_trios", 60 )
	else if ( playerCount == 2 )
		return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_lowhealth_threshold_duos", 60 )

	return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_lowhealth_threshold_solos", 60 )
}

int function GetProwlerDamageScaleDeathProtectMinHp( entity player )
{
	int playerCount = GetProwlerDamageTeamCount( player )
	if ( playerCount >= 3 )
		return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_deathprotection_minhp_trios", 5 )
	else if ( playerCount == 2 )
		return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_deathprotection_minhp_duos", 5 )

	return GetCurrentPlaylistVarInt( "prowlercombat_damagescale_deathprotection_minhp_solos", 5 )
}

