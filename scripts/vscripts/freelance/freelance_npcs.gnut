#if DEVELOPER
void function DebugDrawOverlay( array<entity> npcs )
{
	int skitWithGC = 0
	int skit = 0
	int orphanedWithGC = 0
	int orphaned = 0

	foreach ( entity npc in npcs )
	{
		if ( npc.ai.skitId >= 0 )
			++skit

		else
			++orphaned
	}

	string promptText = format(
			""
			+"%3d - skit AI\n"
			+"%3d - skit AI to gc\n"
			+"%3d - orphaned to gc\n"
			+"%3d - orphaned\n"
			+"\n-------------------------",
		skit,
		skitWithGC,
		orphanedWithGC,
		orphaned
	)

	//DebugDrawScreenText( 0.01, 0.35, promptText )
}

bool function IsNPCOrphanedNoGC( entity npc )
{
	if ( npc.ai.skitId >= 0 )
		return false

	return true
}

void function DebugDrawEntsInWorld( array<entity> npcs )
{
	foreach ( npc in npcs )
	{
		vector color = (IsNPCOrphanedNoGC( npc ) ? <255, 10, 10> : <255, 0, 200>)
		vector markPos = CalcHullCenterForOrigin( npc.GetOrigin(), GetNpcHullType( npc ) )
		array<int> colorRGB = [ int( color.x ), int( color.y ), int( color.z ) ]
		DebugDrawMark( markPos, 30.0, colorRGB, true, 0.15 )
	}
}


bool s_debugDrawFrame = false
void function DEV_NPC_ToggleOverlay()
{
	s_debugDrawFrame = !s_debugDrawFrame
}

bool function NPCDebugOverlayIsActive()
{
	return s_debugDrawFrame
}

void function DebugFrameThread()
{
	while ( true )
	{
		if ( s_debugDrawFrame )
		{
			array<entity> npcs = GetNPCArray()
			DebugDrawOverlay( npcs )
			DebugDrawEntsInWorld( npcs )
		}

		WaitFrame()
	}
}
#endif // DEV


