string function GetRandomAmmoRef()
{
	float roll = RandomFloat( 0.5 )
	string ammoString
	if ( roll < 0.10 )
		return BULLET_AMMO
	if ( roll < 0.20 )
		return HIGHCAL_AMMO
	if ( roll < 0.30 )
		return SPECIAL_AMMO
	if ( roll < 0.40 )
		return SNIPER_AMMO

	return SHOTGUN_AMMO
}

