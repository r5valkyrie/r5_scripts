#if SERVER
global function AI_Loot_SpawnReward
global function SpawnAndThrowItemFromNPC

global struct TeamLootTracker
{
	float         epicLootChance = 0.0
	array<string> droppedLoot
}

global struct AILootSpawnParams
{
	string playlistVarPrefix

	bool ammoDropEnabled
	float ordnanceChance
	float helmetChance
	float consumableChance
	float epicConsumableChance
	float ammoRatio
	float attachmentDropChance

	float ammoRadius

	//these are used for wildlife primarly
	vector center
	float lootRadius

	bool functionref( vector, vector, AILootSpawnParams ) InRangeForLootFunc
	//TODO: iholstead write this
	//array<string> functionref( entity, entity, AILootSpawnParams ) GetAdditionalLootItems

	table<int, TeamLootTracker> lootTrackers
}


array<string> function AI_Loot_SpawnReward( entity npc, AILootSpawnParams params, var damageInfo )
{
	array<string> lootRewards = []

	string playlistVarPrefix = params.playlistVarPrefix

	entity attacker = DamageInfo_GetAttacker( damageInfo )

	                    
		if ( attacker.IsNPC() )
		{
			if ( CanNPCDoDamageOnBehalfOfPlayer( attacker ) )
			{
				entity boss = attacker.GetBossPlayer()
				if ( IsValid( boss ) && boss.IsPlayer() )
					attacker = boss
				else //can't get loadout from a nonvalid boss
					return lootRewards
			}
		}
       

	if ( !IsValid( attacker ) || !attacker.IsPlayer() )
	{
		return lootRewards
	}

	int ammoCount = 0
	int teamId = attacker.GetTeam()
	TeamLootTracker lootTracker

	if ( !(teamId in params.lootTrackers) )
	{
		lootTracker.epicLootChance = GetCurrentPlaylistVarFloat( playlistVarPrefix + "_epicitem_lootdrop_percent", 0.05 )
		params.lootTrackers[teamId] <- lootTracker
	}
	else
	{
		lootTracker = params.lootTrackers[teamId]
	}

	vector npcOrigin = npc.GetOrigin()
	array<entity> teammates = GetPlayerArrayOfTeam_Alive( teamId )
	array<entity> players

	// make sure the attacker gets smartloot at the very least
	players.push( attacker )
	foreach (entity teammate in teammates )
	{
		if ( teammate == attacker )
		{
			continue
		}

		if( !params.InRangeForLootFunc( npcOrigin, teammate.GetOrigin(), params ) )
		{
			continue
		}

		players.push( teammate )
	}

	if ( RandomFloat( 1.0 ) < lootTracker.epicLootChance )
	{
		GetEpicAttachmentLootDrops( players, playlistVarPrefix, params.lootTrackers[teamId].droppedLoot, lootRewards )

		if ( RandomFloat( 1.0 ) < params.consumableChance )
		{
			string healthItem = SURVIVAL_GetWeightedItemFromGroup( "Health_High" )
			lootRewards.push( healthItem )
		}

		ammoCount = 2
		lootTracker.epicLootChance = GetCurrentPlaylistVarFloat( playlistVarPrefix + "_epicitem_lootdrop_percent", 0.05 )
	}
	else
	{
		if ( lootTracker.epicLootChance < GetCurrentPlaylistVarFloat( playlistVarPrefix + "_epicitem_bonus_limit", 0.2 ) )
		{
			lootTracker.epicLootChance += GetCurrentPlaylistVarFloat( playlistVarPrefix + "_epicitem_kill_increment", 0.015 )
		}

		int scopeMinTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_lootdrop_scope_mintier", 1 )
		int scopeMaxTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_lootdrop_scope_maxtier", 2 )
		int attachmentMinTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_lootdrop_attachment_mintier", 1 )
		int attachmentMaxTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_lootdrop_attachment_maxtier", 3 )

		if ( RandomFloat( 1.0 ) < params.attachmentDropChance )
		{
			GetSmartAttachmentLootDrops( players, params.lootTrackers[teamId].droppedLoot, [eWeaponAttachmentType.BARREL, eWeaponAttachmentType.STOCK, eWeaponAttachmentType.MAG], attachmentMinTier, attachmentMaxTier, scopeMinTier, scopeMaxTier, lootRewards )
		}

		if ( RandomFloat( 1.0 ) < params.epicConsumableChance )
		{
			string healthItem = SURVIVAL_GetWeightedItemFromGroup( "Health_High" )
			lootRewards.push( healthItem )
		}
		else if ( RandomFloat( 1.0 ) < params.consumableChance )
		{
			// We are just doing a coin flip between getting a syringe or shield cell, using a loot group so modes that override loot can override these items
			lootRewards.push( SURVIVAL_GetWeightedItemFromGroup( "ai_loot_drop_healing_small" ) )
		}

		if ( RandomFloat( 1.0 ) < params.ordnanceChance )
		{
			string ordnance = SURVIVAL_GetWeightedItemFromGroup( "ordnance" )
			lootRewards.push( ordnance )
			ammoCount = 1
		}
		else if ( RandomFloat( 1.0 ) < params.helmetChance )
		{
			GetSmartLootDrops( players, params.lootTrackers[teamId].droppedLoot, [eLootType.HELMET], 1, 3, lootRewards )
			ammoCount = 1
		}
		else
		{
			ammoCount = ( RandomFloat( 1.0 ) < params.ammoRatio ) ? 1 : 2
		}
	}

	if ( params.ammoDropEnabled )
	{
		table<int, string> ammos = LootHelper_GetTeamAmmoTypes_Weighted( attacker.GetTeam(), npc.GetOrigin(), params.ammoRadius )
		if ( ammos.len() == 0 )
		{
			// ammo
			int index = 0
			foreach ( entity weapon in SURVIVAL_GetPrimaryWeapons( attacker ) )
			{
				// skip ammo for crated weapons that have fixed ammo
				// these return weaponData.ammoType as "" which isn't helpful

				if( weapon.GetActiveAmmoSource() != AMMOSOURCE_POOL )
				{
					continue
				}

				LootData weaponData = SURVIVAL_GetLootDataFromWeapon( weapon )

				// primary ammo
				ammos[index] <- weaponData.ammoType
				index += 1

				// secondary ammo
				if( weaponData.secondaryAmmoType == "" )
				{
					continue
				}

				// primary ammo
				ammos[index] <- weaponData.secondaryAmmoType
				index += 1
			}
		}
		for ( int i = 0; i < ammoCount; ++i )
		{
			if ( ammos.len() > 0 )
			{
				int idx = RandomInt(ammos.len())
				lootRewards.push( ammos[idx] )
			} else {
				lootRewards.push( SURVIVAL_Loot_GetRandomLootOfSpecifiedTierAndType( 1, eLootType.AMMO ) )
			}
		}
	}

	lootRewards.fastremovebyvalue( "blank" )
	if ( lootRewards.len() > 0 )
	{
		SpawnAndThrowItemFromNPC( npc, lootRewards )
	}

                        
                                                                                         
   
                                              
                               
                         
    
          
    
         
                       
    
                            
    
                           
    
                            
           
                            
    

                                                                                                 
   
       

	return lootRewards
}

void function GetSmartLootDrops( array<entity> players, array<string> droppedLoot, array<int> nonequipmentList, int minEquipmentTier, int maxEquipmentTier, array<string> lootRewards )
{
	array<string> lootOptions
	array<string> equipmentOptions

	for ( int i = 0; i < players.len(); ++i )
	{
		array<string> equipments = SmartLoot_GetLoot( players[i], false, false, nonequipmentList, [] )

		equipmentOptions.extend( equipments )
	}

	for ( int i = 0; i < equipmentOptions.len(); ++i )
	{
		int lootTier = LootHelper_GetLootTier( equipmentOptions[i] )
		if ( lootTier >= minEquipmentTier && lootTier <= maxEquipmentTier )
		{
			lootOptions.push( equipmentOptions[i] )
		}
	}

	for ( int i = 0; i < droppedLoot.len(); ++i )
	{
		int idx = lootOptions.find( droppedLoot[i] )
		if ( idx > -1 )
		{
			lootOptions.remove(idx)
		}
	}

	if ( lootOptions.len() > 0 )
	{
		int randIdx = RandomInt( lootOptions.len() )
		string lootRef = lootOptions[randIdx]
		droppedLoot.append( lootRef )
		lootRewards.push( lootRef )
	}
}

void function GetEpicAttachmentLootDrops( array<entity> players, string playlistVarPrefix, array<string> droppedLoot, array<string> lootRewards )
{
	array<string> lootOptions
	array<string> scopeOptions
	array<string> attachmentOptions

	int epicLootDropMinTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_epicitem_lootdrop_mintier", 3 )
	int epicLootDropMaxTier = GetCurrentPlaylistVarInt( playlistVarPrefix + "_epicitem_lootdrop_maxtier", 4 )

	for ( int i = 0; i < players.len(); ++i )
	{
		array<string> attachments = LootHelper_GetAllCompatibleAttachments( players[i], [eWeaponAttachmentType.HOPUP, eWeaponAttachmentType.BARREL, eWeaponAttachmentType.STOCK, eWeaponAttachmentType.MAG] )
		attachmentOptions.extend( attachments )

		array<string> scopes = LootHelper_GetCompatibleScopes( players[i] )
		scopeOptions.extend( scopes )
	}

	for ( int i = 0; i < attachmentOptions.len(); ++i )
	{
		int lootTier = LootHelper_GetLootTier( attachmentOptions[i] )
		if ( lootTier >= epicLootDropMinTier && lootTier <= epicLootDropMaxTier )
		{
			lootOptions.push( attachmentOptions[i] )
		}
	}

	for ( int i = 0; i < droppedLoot.len(); ++i )
	{
		int idx = lootOptions.find( droppedLoot[i] )
		if ( idx > -1 )
		{
			lootOptions.remove(idx)
		}
	}

	if ( lootOptions.len() > 0 || CoinFlip() )
	{
		// chances are a lot more 'possible' optics will drop than attachment upgrades so reduce their spawn chance by limiting the total considered for drop selection to just 1
		scopeOptions.randomize()
		for ( int i = 0; i < scopeOptions.len(); ++i )
		{
			int lootTier = LootHelper_GetLootTier( scopeOptions[i] )
			if ( lootTier >= epicLootDropMinTier && lootTier <= epicLootDropMaxTier )
			{
				int idx = droppedLoot.find( scopeOptions[i] )
				if ( idx == -1 )
				{
					lootOptions.push( scopeOptions[i] )
					break
				}
			}
		}
	}

	if ( lootOptions.len() > 0 )
	{
		int randIdx = RandomInt( lootOptions.len() )
		string lootRef = lootOptions[randIdx]
		droppedLoot.append( lootRef )
		lootRewards.push( lootRef )
	}
}

void function GetSmartAttachmentLootDrops( array<entity> players, array<string> droppedLoot, array<int> nonScopeAttachmentList, int minAttachmentTier, int maxAttachmentTier, int minScopeTier, int maxScopeTier, array<string> lootRewards )
{
	array<string> lootOptions
	array<string> scopeOptions
	array<string> attachmentOptions

	for ( int i = 0; i < players.len(); ++i )
	{
		array<string> attachments = SmartLoot_GetLoot( players[i], false, false, [], nonScopeAttachmentList )
		attachmentOptions.extend( attachments )

		array<string> scopes = LootHelper_GetCompatibleScopes( players[i] )
		scopeOptions.extend( scopes )
	}

	for ( int i = 0; i < attachmentOptions.len(); ++i )
	{
		int lootTier = LootHelper_GetLootTier( attachmentOptions[i] )
		if ( lootTier >= minAttachmentTier && lootTier <= maxAttachmentTier )
		{
			lootOptions.push( attachmentOptions[i] )
		}
	}

	for ( int i = 0; i < droppedLoot.len(); ++i )
	{
		int idx = lootOptions.find( droppedLoot[i] )
		if ( idx > -1 )
		{
			lootOptions.remove(idx)
		}
	}

	if ( lootOptions.len() > 0 || CoinFlip() )
	{
		// chances are a lot more 'possible' optics will drop than attachment upgrades so reduce their spawn chance by limiting the total considered for drop selection to just 1
		scopeOptions.randomize()
		for ( int i = 0; i < scopeOptions.len(); ++i )
		{
			int lootTier = LootHelper_GetLootTier( scopeOptions[i] )
			if ( lootTier >= minScopeTier && lootTier <= maxScopeTier )
			{
				int idx = droppedLoot.find( scopeOptions[i] )
				if ( idx == -1 )
				{
					lootOptions.push( scopeOptions[i] )
					break
				}
			}
		}
	}

	if ( lootOptions.len() > 0 )
	{
		int randIdx = RandomInt( lootOptions.len() )
		string lootRef = lootOptions[randIdx]
		droppedLoot.append( lootRef )
		lootRewards.push( lootRef )
	}
}

void function SpawnAndThrowItemFromNPC( entity npc, array<string> lootToSpawn )
{
	LootThrowData throwData
	throwData.throwAngle = RandomFloatRange( 0.0, 360.0 )
	throwData.throwScale = 1
	vector throwOrigin = npc.GetOrigin()

	for ( int i = 0; i < lootToSpawn.len(); i++ )
	{
		LootData itemToDrop = SURVIVAL_Loot_GetLootDataByRef( lootToSpawn[i] )
		entity itemEnt = SpawnGenericLoot( lootToSpawn[i], throwOrigin, < -1, -1, -1 >, itemToDrop.countPerDrop )

		SetItemSpawnSource( itemEnt, eSpawnSource.NPC_DEATH, npc )
		vector throwDir = <sin( throwData.throwAngle ), cos( throwData.throwAngle ), 0>
		float speed     = throwData.throwScale * sqrt( RandomFloatRange( 0.75, 1.0 ) ) * 150
		vector vel      = throwDir * speed
		thread FakePhysicsThrow_Retail( npc, itemEnt, <vel.x, vel.y, 200>, true )
		throwData = SURVIVAL_DropLoot_IncrementThrowAngle( throwData )
	}
}
#endif //SERVER